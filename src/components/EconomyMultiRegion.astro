---
/**
 * EconomyMultiRegion — GTA VI multi-region currency union diagram.
 *
 * Simplified conceptual diagram: what makes GTA VI's economy structurally
 * different from GTA Online — multiple regions, one shared GTA$.
 *
 * Pure CSS/HTML. No JS, no D3. Always renders.
 * Sits above EconomyCircle on the GTA VI hub page.
 *
 * Currently renders Vice City + Leonida as the two confirmed primary regions.
 * Additional regions (Port Gellhorn, Grassrivers, Ambrosia, etc.) will be
 * added as distinct economic zones post-launch.
 *
 * Palette:
 *   Vice City  → var(--c-title-vi)   pink-coral
 *   Leonida    → var(--c-growth)     green
 *   GTA$       → var(--c-brand)      gold
 *   Injection  → var(--c-title-vi)   pink-coral (Shark Cards from Rockstar)
 */
import ShareDropdown from "./ShareDropdown.astro";

interface Props {
  fullEconomyHref?: string;
}
const { fullEconomyHref = "/gta-vi/economy" } = Astro.props;
---

<div class="vi-eco-card" style="background:var(--c-card);border:1px solid var(--c-border-1);border-radius:12px;overflow:hidden;font-family:var(--font-mono,monospace)">

  <!-- ── Injection row ──────────────────────────────────────────────── -->
  <div class="vi-inject" style="background:color-mix(in srgb,var(--c-title-vi) 8%,var(--c-bg-deep));border-bottom:1px solid var(--c-border-1);padding:12px 20px;position:relative">
    <div style="display:flex;align-items:center;justify-content:center;gap:40px;flex-wrap:wrap">
      <div style="display:flex;flex-direction:column;align-items:center;gap:4px">
        <div style="width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--c-title-vi) 20%,transparent);border:1.5px solid color-mix(in srgb,var(--c-title-vi) 45%,transparent)">
          <span style="font-size:18px">🦈</span>
        </div>
        <span style="font-size:9px;color:var(--c-title-vi);text-transform:uppercase;letter-spacing:.12em">Shark Card</span>
      </div>

      <div style="display:flex;flex-direction:column;align-items:center;gap:2px;text-align:center">
        <span style="font-size:8px;color:color-mix(in srgb,var(--c-title-vi) 60%,transparent);text-transform:uppercase;letter-spacing:.25em">Rockstar</span>
        <span style="font-size:clamp(1.1rem,2.5vw,1.5rem);font-weight:900;line-height:1;color:var(--c-title-vi)">INJECTION</span>
        <span style="font-size:1rem;font-weight:700;color:var(--c-title-vi)">J ↓</span>
      </div>

      <div style="display:flex;flex-direction:column;align-items:center;gap:4px">
        <div style="width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--c-title-vi) 20%,transparent);border:1.5px solid color-mix(in srgb,var(--c-title-vi) 45%,transparent)">
          <span style="font-size:14px;font-weight:900;color:var(--c-title-vi)">G+</span>
        </div>
        <span style="font-size:9px;color:var(--c-title-vi);text-transform:uppercase;letter-spacing:.12em">GTA+</span>
      </div>
    </div>
    <div style="position:absolute;top:8px;right:12px;font-size:8px;color:var(--c-text-5);opacity:0.5">* unified GTA$ across all regions</div>
  </div>

  <!-- ── Territory grid ────────────────────────────────────────────── -->
  <div class="vi-territories" style="display:grid;grid-template-columns:1fr auto 1fr;border-bottom:1px solid var(--c-border-1)">

    <!-- Vice City -->
    <div style="padding:20px 18px;border-right:1px solid var(--c-border-1);background:color-mix(in srgb,var(--c-title-vi) 4%,transparent)">
      <div style="margin-bottom:12px">
        <div style="font-size:clamp(.85rem,2vw,1.15rem);font-weight:900;color:var(--c-title-vi);letter-spacing:-.01em;line-height:1;margin-bottom:2px">Vice City</div>
        <div style="font-size:8px;color:color-mix(in srgb,var(--c-title-vi) 55%,transparent);text-transform:uppercase;letter-spacing:.12em">Urban core · high-wage</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px">
        {[
          { letter: "Y", label: "Income",      color: "var(--c-income)",       sub: "Missions · Heists · Passive" },
          { letter: "C", label: "Consumption", color: "var(--c-flow-spending)", sub: "Vehicles · Clothing · Ammo"  },
          { letter: "I", label: "Investment",  color: "var(--c-economy)",       sub: "Properties · Businesses"    },
        ].map(f => (
          <div style="display:flex;align-items:flex-start;gap:10px">
            <div style={`width:22px;height:22px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:${f.color};background:color-mix(in srgb,${f.color} 15%,transparent);border:1px solid color-mix(in srgb,${f.color} 35%,transparent);flex-shrink:0;margin-top:1px`}>{f.letter}</div>
            <div>
              <div style={`font-size:11px;font-weight:700;color:${f.color};line-height:1.2`}>{f.label}</div>
              <div style="font-size:9px;color:var(--c-text-5);margin-top:1px">{f.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Centre connector — GTA$ hub + player movement -->
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:20px 14px;min-width:100px;background:color-mix(in srgb,var(--c-brand) 3%,var(--c-bg-deep))">
      <!-- GTA$ circle -->
      <div style="width:64px;height:64px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;background:color-mix(in srgb,var(--c-bg-deep) 90%,transparent);border:2px solid color-mix(in srgb,var(--c-brand) 40%,transparent)">
        <span style="font-size:9px;font-weight:900;color:var(--c-brand);letter-spacing:-.01em">GTA$</span>
        <span style="font-size:7px;color:var(--c-text-5);text-transform:uppercase;letter-spacing:.08em">shared</span>
      </div>

      <!-- Bidirectional arrow -->
      <div style="display:flex;flex-direction:column;align-items:center;gap:2px">
        <div style="display:flex;align-items:center;gap:4px">
          <span style="color:var(--c-title-vi);font-size:14px;line-height:1">←</span>
          <span style="font-size:7px;color:var(--c-text-5);text-transform:uppercase;letter-spacing:.1em;white-space:nowrap">Player</span>
          <span style="color:var(--c-growth);font-size:14px;line-height:1">→</span>
        </div>
        <span style="font-size:7px;color:var(--c-text-5);text-transform:uppercase;letter-spacing:.08em">Movement</span>
      </div>

      <!-- RPP badge -->
      <div style="border:1px solid color-mix(in srgb,var(--c-brand) 30%,transparent);border-radius:4px;padding:3px 7px;text-align:center;background:color-mix(in srgb,var(--c-brand) 8%,transparent)">
        <div style="font-size:8px;font-weight:900;color:var(--c-brand);letter-spacing:.05em">GTA-RPP</div>
        <div style="font-size:7px;color:var(--c-text-5)">parity index</div>
      </div>
    </div>

    <!-- Leonida -->
    <div style="padding:20px 18px;border-left:1px solid var(--c-border-1);background:color-mix(in srgb,var(--c-growth) 4%,transparent)">
      <div style="margin-bottom:12px">
        <div style="font-size:clamp(.85rem,2vw,1.15rem);font-weight:900;color:var(--c-growth);letter-spacing:-.01em;line-height:1;margin-bottom:2px">Leonida</div>
        <div style="font-size:8px;color:color-mix(in srgb,var(--c-growth) 55%,transparent);text-transform:uppercase;letter-spacing:.12em">Rural region · lower baseline</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px">
        {[
          { letter: "Y", label: "Income",      color: "var(--c-income)",       sub: "Missions · Passive Stack"   },
          { letter: "C", label: "Consumption", color: "var(--c-flow-spending)", sub: "Vehicles · Properties"     },
          { letter: "I", label: "Investment",  color: "var(--c-economy)",       sub: "Businesses · Land"         },
        ].map(f => (
          <div style="display:flex;align-items:flex-start;gap:10px">
            <div style={`width:22px;height:22px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:${f.color};background:color-mix(in srgb,${f.color} 15%,transparent);border:1px solid color-mix(in srgb,${f.color} 35%,transparent);flex-shrink:0;margin-top:1px`}>{f.letter}</div>
            <div>
              <div style={`font-size:11px;font-weight:700;color:${f.color};line-height:1.2`}>{f.label}</div>
              <div style="font-size:9px;color:var(--c-text-5);margin-top:1px">{f.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>

  <!-- ── Equation strip ─────────────────────────────────────────────── -->
  <div style="padding:10px 20px;border-bottom:1px solid var(--c-border-1);display:flex;align-items:center;gap:16px;flex-wrap:wrap;background:var(--c-bg-deep)">
    <span style="font-size:11px;font-weight:900;color:var(--c-brand);letter-spacing:.03em">Y = C + I</span>
    <span style="font-size:8px;color:var(--c-text-5)">·</span>
    <span style="font-size:9px;color:var(--c-text-5);text-transform:uppercase;letter-spacing:.1em">per region</span>
    <span style="font-size:8px;color:var(--c-text-5)">·</span>
    <span style="font-size:9px;color:var(--c-text-5);text-transform:uppercase;letter-spacing:.1em">one shared GTA$</span>
    <span style="flex:1"></span>
    <span style="font-size:8px;color:color-mix(in srgb,var(--c-title-vi) 60%,transparent);text-transform:uppercase;letter-spacing:.12em;border:1px solid color-mix(in srgb,var(--c-title-vi) 25%,transparent);padding:2px 6px;border-radius:3px">Projected</span>
  </div>

  <!-- ── Footer ─────────────────────────────────────────────────────── -->
  <div style="padding:8px 16px;display:flex;align-items:center;gap:12px;background:var(--c-card)">
    <div style="display:flex;align-items:center;gap:16px;font-size:9px;color:var(--c-text-5)">
      <span style="display:flex;align-items:center;gap:5px">
        <span style="display:inline-block;width:10px;height:2px;border-radius:1px;background:var(--c-title-vi)"></span>
        Vice City
      </span>
      <span style="display:flex;align-items:center;gap:5px">
        <span style="display:inline-block;width:10px;height:2px;border-radius:1px;background:var(--c-growth)"></span>
        Leonida
      </span>
      <span style="display:flex;align-items:center;gap:5px">
        <span style="display:inline-block;width:10px;height:2px;border-radius:1px;background:var(--c-brand)"></span>
        GTA$
      </span>
    </div>
    <span style="flex:1"></span>
    {fullEconomyHref && (
      <a href={fullEconomyHref} style="font-size:9px;color:var(--c-text-5);text-transform:uppercase;letter-spacing:.12em;text-decoration:none" class="hover:text-zinc-200 transition-colors">Full model →</a>
    )}
    <span style="font-size:9px;color:var(--c-text-5);text-transform:uppercase;letter-spacing:.12em">GTAVI.AI</span>
    <ShareDropdown
      anchorId="economy-multi-region"
      shareText="GTA VI's economy is a multi-region currency union — Vice City, Leonida and more all share one GTA$. The GTA-RPP index tracks purchasing power gaps between regions. GTAVI.AI"
      size="sm"
    />
  </div>

</div>

<!-- Mobile: stack territories vertically -->
<style>
  @media (max-width: 640px) {
    .vi-territories {
      grid-template-columns: 1fr !important;
    }
  }
</style>
