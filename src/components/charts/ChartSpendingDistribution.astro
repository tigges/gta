---
/**
 * ChartSpendingDistribution
 * Extracted from charts.astro.
 */
import spendingDistData from "../../../data/gta-5/economy/spending-distribution.json";
import CardFooter from "../CardFooter.astro";
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5">GTA$ Spending Distribution — How Player Money Flows Over the Years</div>
            <div class="text-[11px] text-zinc-500 font-mono">Community-modelled. Vehicles dominated launch era. Properties peaked 2016–17 (Bunker/MC era). Weapons spending rose in 2021 as Cayo income made consumables trivial.</div>
          </div>
          <div class="flex flex-wrap gap-3 text-[10px] font-mono text-zinc-500">
            {[
              {label:"Vehicles",    color:"#f59e0b"},
              {label:"Properties",  color:"#0d9488"},
              {label:"Weapons/Mods",color:"#ef4444"},
              {label:"Shark equiv.",color:"#818cf8"},
            ].map(l => (
              <span class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-sm inline-block" style={`background:${l.color};opacity:var(--o-secondary)`}></span>
                {l.label}
              </span>
            ))}
          </div>
        </div>
        <div id="spending-distribution-chart" class="w-full" style="height:300px"
          data-eras={JSON.stringify((spendingDistData as any).eras)}
        ></div>
        <CardFooter chartId="spending-distribution-chart" sources="Source: community surveys · GTAForums spending analysis · modelled estimates · confidence: medium" shareText="How GTA Online players spend their money across eras: vehicles dominated 2013–14, properties peaked 2016–17 (Bunker era), then Oppressor drove vehicles back up." />
      </div>

<script>
  import { cc, op } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart, triggerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("spending-distribution-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }
    const eras: any[] = JSON.parse(el.dataset.eras || "[]");
    if (!eras.length) return;

    const CATS = [
      { key: "vehicles_pct",     color: cc.bar, label: "Vehicles" },
      { key: "properties_pct",   color: cc.teal, label: "Properties" },
      { key: "weapons_pct",      color: cc.red, label: "Weapons" },
      { key: "shark_equiv_pct",  color: cc.indigo, label: "Shark equiv." },
    ];

    const margin = { top: 20, right: 16, bottom: 56, left: 40 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg").attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform", `translate(${margin.left},${margin.top})`);

    const x = d3.scaleBand().domain(eras.map((e: any) => e.label)).range([0, W]).padding(0.18);
    const y = d3.scaleLinear().domain([0, 100]).range([H, 0]);

    // Grid
    [25, 50, 75, 100].forEach(v => {
      svg.append("line").attr("x1", 0).attr("x2", W).attr("y1", y(v)).attr("y2", y(v))
        .attr("stroke", cc.grid).attr("stroke-dasharray", "3,3");
    });

    // 100% stacked bars per era
    eras.forEach((era: any) => {
      let bottom = 0;
      CATS.forEach(cat => {
        const pct = era[cat.key] || 0;
        const xv = x(era.label) ?? 0;
        svg.append("rect").attr("x", xv).attr("y", y(bottom + pct))
          .attr("width", x.bandwidth()).attr("height", Math.max(0, y(bottom) - y(bottom + pct)))
          .attr("fill", cat.color).attr("opacity",op.secondary);
        // Label inside bar if big enough
        if (pct >= 8) {
          svg.append("text").attr("x", xv + x.bandwidth() / 2).attr("y", y(bottom + pct / 2) + 4)
            .attr("text-anchor", "middle").attr("fill", cc.text0).attr("font-size", "8.5").attr("font-family", "monospace")
            .attr("opacity",op.primary).text(`${pct}%`);
        }
        bottom += pct;
      });
    });

    // X axis
    svg.append("g").attr("transform", `translate(0,${H})`)
      .call(d3.axisBottom(x).tickFormat((d: any) => (d as string).split(" ")[0]))
      .call(g => g.select(".domain").attr("stroke", cc.border2))
      .call(g => g.selectAll(".tick line").attr("stroke", cc.border2))
      .call(g => g.selectAll("text").attr("fill", cc.text6).attr("font-size", "8.5").attr("font-family", "monospace")
        .attr("transform", "rotate(-30)").attr("text-anchor", "end").attr("dy", "0.3em").attr("dx", "-0.4em"));
    // Y axis
    svg.append("g").call(d3.axisLeft(y).ticks(4).tickFormat((d: any) => `${d}%`))
      .call(g => g.select(".domain").remove()).call(g => g.selectAll(".tick line").remove())
      .call(g => g.selectAll("text").attr("fill", cc.text6).attr("font-size", "9").attr("font-family", "monospace"));  }

  registerChart("spending-distribution-chart", init);
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("spending-distribution-chart");
    if (obsEl) {
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) { triggerChart("spending-distribution-chart"); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
