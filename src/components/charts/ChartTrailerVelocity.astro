---
/**
 * ChartTrailerVelocity
 * GTA VI trailer view counts — live stats from YouTube Data API.
 * Pure data display (no D3) — renders server-side.
 */
import velocityData from "../../../data/gta-6/trailer-velocity.json";
import ShareButton  from "../ShareButton.astro";
---

<div class="flex items-center gap-3 mb-5">
        <span class="text-[9px] font-mono bg-amber-900/30 text-amber-600 border border-amber-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Franchise</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI Trailer View Velocity</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <!-- Trailer thumbnail strip -->
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-2.5 overflow-x-auto">
          <a href="https://www.youtube.com/watch?v=QdBZY2fkU-0" target="_blank" rel="noopener noreferrer" class="shrink-0 relative group overflow-hidden rounded border border-[#2a2a31] hover:border-gta-gold/30 transition-all">
            <img src="https://img.youtube.com/vi/QdBZY2fkU-0/mqdefault.jpg" alt="GTA VI Trailer 1" class="w-20 h-12 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <span class="absolute bottom-1 left-1.5 text-[7px] font-mono text-gta-gold">T1</span>
          </a>
          <a href="https://www.youtube.com/watch?v=VQRLujxTm3c" target="_blank" rel="noopener noreferrer" class="shrink-0 relative group overflow-hidden rounded border border-gta-gold/30 hover:border-gta-gold/60 transition-all">
            <img src="https://img.youtube.com/vi/VQRLujxTm3c/mqdefault.jpg" alt="GTA VI Trailer 2" class="w-20 h-12 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <span class="absolute bottom-1 left-1.5 text-[7px] font-mono text-gta-gold">T2</span>
          </a>
        </div>
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm mb-0.5" style="font-family:'Inter',sans-serif">
            GTA VI Trailer View Counts — Live
          </div>
          <div class="text-[11px] text-zinc-500 font-mono">Polled via YouTube Data API · snapshots accumulate over time to build velocity curve</div>
        </div>
        <!-- Trailer thumbnail + stat cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-[#1e1e23]">
          {(velocityData.trailers as any[]).map((t, i) => {
            const latest = t.snapshots?.at(-1);
            const views = latest?.views ?? 0;
            const likes = latest?.likes ?? 0;
            return (
              <div class="flex items-stretch">
                <!-- YouTube thumbnail -->
                <a href={`https://www.youtube.com/watch?v=${t.youtube_id}`} target="_blank" rel="noopener noreferrer"
                  class="relative shrink-0 w-36 overflow-hidden group">
                  <img
                    src={`https://img.youtube.com/vi/${t.youtube_id}/hqdefault.jpg`}
                    alt={t.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0" style="background:linear-gradient(to right, transparent 60%, #131316 100%)"></div>
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                    <div class="w-8 h-8 rounded-full bg-black/60 border border-gta-gold/30 flex items-center justify-center">
                      <span class="text-white text-sm ml-0.5">▶</span>
                    </div>
                  </div>
                </a>
                <!-- Stats -->
                <div class="px-5 py-5 flex-1">
                  <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-2">
                    {i === 0 ? "Trailer 1 · Dec 4 2023" : "Trailer 2 · May 6 2025"}
                  </div>
                  <div class="text-3xl font-bold font-mono text-gta-bright mb-0.5">
                    {(views / 1_000_000).toFixed(1)}M
                  </div>
                  <div class="text-[11px] text-zinc-500 font-mono mb-3">views</div>
                  <div class="flex items-center gap-4 text-[10px] font-mono text-zinc-600">
                    <span>👍 {(likes / 1_000_000).toFixed(2)}M</span>
                    {i === 0 && <span class="text-gta-teal">24h record</span>}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Source: YouTube Data API · polled {new Date(velocityData.last_updated).toLocaleDateString("en-GB",{month:"short",year:"numeric",hour:"2-digit",minute:"2-digit"})}</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA VI Trailer 1 holds the 24-hour YouTube record. 279M views, 161M for Trailer 2. The hype is unlike anything in gaming." url="https://gtavi.ai/charts#trailer-velocity" size="sm" label="Share" /></div>
        </div>
      </div>
