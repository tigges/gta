---
/**
 * ChartBonusHeatmap
 * Chart component extracted from charts.astro.
 * Can be embedded on any page; D3 init deferred via IntersectionObserver.
 */
import bonusHistoryData  from "../../../data/gta-5/economy/bonus-history.json";
import revenueTiersData  from "../../../data/gta-5/economy/revenue-tiers.json";
import saleFreqData       from "../../../data/gta-5/economy/sale-frequency.json";
import ChartFooter from "../ChartFooter.astro";
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5">
              Which Activities Get Bonus Events — and How Often
            </div>
            <div class="text-[11px] text-zinc-500 font-mono">Each cell = one Thursday weekly update. Gold = 2× bonus, bright = 3×. Patterns reveal Rockstar's promotional calendar.</div>
          </div>
          <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-500 flex-wrap">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-gta-gold/80 inline-block"></span>2× event</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-gta-gold inline-block"></span>3× event</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-[#1e1e23] border border-[#2a2a31] inline-block"></span>No bonus</span>
          </div>
        </div>
        <div id="bonus-heatmap" class="w-full overflow-x-auto px-2 py-4"
          data-history={JSON.stringify((bonusHistoryData as any).weeks)}
          data-freq={JSON.stringify((saleFreqData as any).activity_bonuses)}
          style="min-height:280px"
        ></div>
        <ChartFooter chartId="bonus-heatmap" sources="Source: Rockstar Newswire · community archives · curated seed back to 2020 · live capture every Thursday" shareText="GTA Online bonus calendar — which activities Rockstar has promoted and how often. The promotional pattern is more predictable than you" />
      </div>

<script>
  import { cc } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("bonus-heatmap") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }


    const weeks: any[]  = JSON.parse(el.dataset.history || "[]");
    const freq: any[]   = JSON.parse(el.dataset.freq    || "[]");
    if (!weeks.length || !freq.length) return;

    // Build activity list: top activities by bonus_count, max 12
    const activities = freq.slice(0, 12).map((a: any) => a.activity_id);

    // Pretty labels
    const LABELS: Record<string,string> = {
      "cayo-perico":          "Cayo Perico Heist",
      "contact-missions":     "Contact Missions",
      "acid-lab":             "Acid Lab",
      "nightclub":            "Nightclub",
      "diamond-casino-heist": "Casino Heist",
      "bunker":               "Bunker",
      "mc-cocaine":           "MC Businesses",
      "auto-shop":            "Auto Shop",
      "agency-vip-contract":  "Agency",
      "salvage-yard":         "Salvage Yard",
      "payphone-hits":        "Payphone Hits",
      "garment-factory":      "Garment Factory",
      "special-cargo":        "Special Cargo",
      "vehicle-warehouse":    "Vehicle Cargo",
      "kno-way-out":          "KnoWay Out",
      "mr-faber-work":        "Mr. Faber Work",
      "cluckin-bell-farm-raid":"Cluckin' Bell Raid",
      "hands-on-car-wash":    "Car Wash (Front)",
    };

    // Build lookup: week_start → {activity_id → multiplier}
    const weekMap: Record<string, Record<string,number>> = {};
    weeks.forEach((w: any) => {
      const key = w.week_start;
      weekMap[key] = {};
      (w.bonuses || []).forEach((b: any) => {
        weekMap[key][b.activity_id] = b.multiplier ?? 2;
      });
    });

    const weekStarts = weeks.map((w: any) => w.week_start).sort();

    const cellW  = 18;
    const cellH  = 22;
    const labelW = 160;
    const margin = { top: 32, right: 16, bottom: 16, left: labelW };
    const W      = weekStarts.length * cellW;
    const H      = activities.length * cellH;
    const svgW   = W + margin.left + margin.right;
    const svgH   = H + margin.top + margin.bottom;

    const svg = d3.select(el).append("svg")
      .attr("width", svgW).attr("height", svgH)
      .append("g").attr("transform", `translate(${margin.left},${margin.top})`);

    // Year labels on x axis
    let lastYear = "";
    weekStarts.forEach((ws: string, i: number) => {
      const yr = ws.slice(0, 4);
      if (yr !== lastYear) {
        svg.append("text")
          .attr("x", i * cellW + cellW / 2).attr("y", -6)
          .attr("text-anchor", "middle").attr("fill", cc.text6)
          .attr("font-size", "9").attr("font-family", "monospace")
          .text(yr);
        lastYear = yr;
      }
    });

    // Activity labels on y axis
    activities.forEach((aid: string, j: number) => {
      svg.append("text")
        .attr("x", -8).attr("y", j * cellH + cellH / 2 + 4)
        .attr("text-anchor", "end").attr("fill", cc.text4)
        .attr("font-size", "10").attr("font-family", "monospace")
        .text((LABELS[aid] || aid).slice(0, 22));
    });

    // Cells
    activities.forEach((aid: string, j: number) => {
      weekStarts.forEach((ws: string, i: number) => {
        const mult = weekMap[ws]?.[aid];
        const fill = !mult ? "#111114"
                   : mult >= 3 ? cc.bar
                   : "#f59e0b60";
        const border = !mult ? cc.grid : mult >= 3 ? cc.bar : "#f59e0b80";
        svg.append("rect")
          .attr("x", i * cellW + 1).attr("y", j * cellH + 1)
          .attr("width", cellW - 2).attr("height", cellH - 2)
          .attr("rx", 2).attr("fill", fill)
          .attr("stroke", border).attr("stroke-width", mult ? 1 : 0.5);
        if (mult && mult >= 3) {
          svg.append("text")
            .attr("x", i * cellW + cellW / 2).attr("y", j * cellH + cellH / 2 + 3.5)
            .attr("text-anchor", "middle").attr("dominant-baseline", "middle")
            .attr("fill", cc.bgDeep).attr("font-size", "7").attr("font-family", "monospace")
            .attr("font-weight", "bold").text("3×");
        }
      });
    });
    }

  // Register with chartInit so ChartPreviewCard can force-init on expand
  registerChart("bonus-heatmap", init);

  // Also lazy-init via IntersectionObserver for directly-visible charts
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("bonus-heatmap");
    if (obsEl) {
      const obs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { init(); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
