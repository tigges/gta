---
/**
 * ChartIeTiers
 * Extracted from charts.astro.
 */
import vehicleCargoData from "../../../data/gta-5/economy/vehicle-cargo.json";
import ChartFooter from "../ChartFooter.astro";
import { C_BRAND, C_GROWTH } from "../../config/colors";
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5">Import/Export Net Sell Price by Tier and Delivery Type</div>
            <div class="text-[11px] text-zinc-500 font-mono">Standard private sale = $15k. Top-range specialist = $80k — a 5.3× difference. Sourcing cheap standard-range vehicles is never worth it.</div>
          </div>
          <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm inline-block" style="background:#3f3f46;opacity:0.9"></span>Private</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm inline-block" style={`background:${C_BRAND};opacity:0.9`}></span>Showroom</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm inline-block" style={`background:${C_GROWTH};opacity:0.9`}></span>Specialist</span>
          </div>
        </div>
        <div id="ie-tiers-chart" class="w-full"
          data-sell={JSON.stringify((vehicleCargoData as any).sell_prices_net)}
          style="min-height:240px"
        ></div>
        <ChartFooter chartId="ie-tiers-chart" sources="Source: GTABase.com · GTA Wiki · community records · no-damage assumption · net of setup mods" shareText="GTA Online Import/Export sell prices: top-range specialist delivers 5× more than standard private. Always prioritise top-range sources." />
      </div>

<script>
  import { cc } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart, triggerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("ie-tiers-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }
    const sellData: any = JSON.parse(el.dataset.sell || "{}");
    if (!sellData.top) return;

    const tiers = [
      { key: "top",      label: "Top Range" },
      { key: "mid",      label: "Mid Range" },
      { key: "standard", label: "Standard" },
    ];
    const deliveries = [
      { key: "private",    label: "Private Sell",    color: cc.text7 },
      { key: "showroom",   label: "Showroom",        color: cc.bar },
      { key: "specialist", label: "Specialist Dealer", color: cc.green },
    ];

    const rowH = 52, labelW = 106;
    const margin = { top: 16, right: 100, bottom: 24, left: labelW };
    const W = el.clientWidth - margin.left - margin.right;
    const H = tiers.length * rowH + margin.top + margin.bottom;

    const svg = d3.select(el).append("svg").attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${H}`)
      .append("g").attr("transform", `translate(${margin.left},${margin.top})`);

    const maxVal = (d3.max(tiers.flatMap(t =>
      deliveries.map(d => sellData[t.key]?.[d.key] || 0)
    )) ?? 1) as number;
    const x = d3.scaleLinear().domain([0, maxVal * 1.05]).range([0, W]);

    tiers.forEach((tier: any, ti: number) => {
      const groupY = ti * rowH;
      // Tier label
      svg.append("text").attr("x", -8).attr("y", groupY + rowH / 2 + 4).attr("text-anchor", "end")
        .attr("fill", cc.text2).attr("font-size", "10.5").attr("font-family", "monospace").text(tier.label);

      deliveries.forEach((del: any, di: number) => {
        const val = sellData[tier.key]?.[del.key] || 0;
        const y = groupY + di * 14 + 2;
        const bh = 11;
        svg.append("rect").attr("x", 0).attr("y", y).attr("width", x(val)).attr("height", bh)
          .attr("rx", 2).attr("fill", del.color).attr("opacity", di === 2 ? 0.85 : 0.65);
        svg.append("text").attr("x", x(val) + 5).attr("y", y + bh - 1)
          .attr("fill", cc.text4).attr("font-size", "8.5").attr("font-family", "monospace")
          .text(`$${val.toLocaleString()}`);
      });
    });

    // Delivery type legend at bottom
    deliveries.forEach((del: any, i: number) => {
      const lx = i * (W / 3);
      svg.append("rect").attr("x", lx).attr("y", H - margin.bottom).attr("width", 10).attr("height", 10)
        .attr("rx", 1).attr("fill", del.color).attr("opacity", 0.75);
      svg.append("text").attr("x", lx + 13).attr("y", H - margin.bottom + 9)
        .attr("fill", cc.text4).attr("font-size", "8.5").attr("font-family", "monospace").text(del.label);
    });  }

  registerChart("ie-tiers-chart", init);
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("ie-tiers-chart");
    if (obsEl) {
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) { triggerChart("ie-tiers-chart"); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
