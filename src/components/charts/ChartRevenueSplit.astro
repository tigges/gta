---
/**
 * ChartRevenueSplit
 * Extracted from charts.astro.
 */
import revenueSplit from "../../../data/franchise/revenue-split.json";
import ChartFooter from "../ChartFooter.astro";
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <!-- Thumbnail cover strip -->
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-2.5 overflow-x-auto">
          <img src="/assets/covers/gta-5.jpg" alt="GTA V" class="rounded border object-cover border-[#2a2a31] w-8 h-11" loading="lazy" />
              <img src="/assets/covers/gta-6.jpg" alt="GTA VI" class="rounded border object-cover border-[#2a2a31] w-8 h-11 border-gta-gold/40 shadow shadow-gta-gold/10" loading="lazy" />
        </div>
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5">
              GTA V: From Box Sales to Shark Cards — 13-Year Revenue Evolution
            </div>
            <div class="text-[11px] text-zinc-500 font-mono">By FY2022, 90% of GTA revenue was recurrent (Online). This is why GTA VI Online will matter more than its $80 price tag.</div>
          </div>
          <div class="flex items-center gap-4 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-gta-gold/80 inline-block"></span>Base game sales</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-gta-teal/80 inline-block"></span>Recurrent (Online/Shark Cards)</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm border border-gta-gold/30 bg-gta-gold/10 inline-block"></span>GTA VI projected</span>
          </div>
        </div>
        <div id="revenue-split-chart" class="w-full" style="height:320px"
          data-years={JSON.stringify(revenueSplit.years)}
        ></div>
        <ChartFooter chartId="revenue-split-chart" sources="Sources: Take-Two IR quarterly earnings · Wedbush Securities analyst estimates · DFC Intelligence (GTA VI)" shareText="Shark Cards have generated billions for Take-Two. The revenue shift that fundamentally changed how Rockstar makes games." />
      </div>

<script>
  import { cc } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("revenue-split-chart") as HTMLElement | null;
    if (!el) return;
    if (el.querySelector('svg')) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }
    const years: any[] = JSON.parse(el.dataset.years || "[]");

    const margin = { top: 16, right: 80, bottom: 48, left: 48 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;
    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);

    const x = d3.scaleBand().domain(years.map(y=>y.fy)).range([0,W]).padding(0.1);
    const maxTotal = d3.max(years, y => y.total_bn) ?? 1;
    const y = d3.scaleLinear().domain([0, maxTotal * 1.1]).range([H,0]);
    const y2 = d3.scaleLinear().domain([0,100]).range([H,0]);

    // Grid
    svg.append("g").call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(()=>""))
      .call(g=>g.select(".domain").remove())
      .call(g=>g.selectAll(".tick line").attr("stroke",cc.grid).attr("stroke-dasharray","3,3"));

    years.forEach(yr => {
      const bx = x(yr.fy) ?? 0, bw = x.bandwidth();
      const isPred = yr.is_prediction;

      // Game sales (bottom, gold)
      svg.append("rect").attr("x",bx).attr("y",y(yr.game_sales_bn))
        .attr("width",bw).attr("height",H-y(yr.game_sales_bn)).attr("rx",isPred?2:0)
        .attr("fill",cc.bar).attr("opacity",isPred?0.3:0.85)
        .attr("stroke",isPred?cc.bar:"none").attr("stroke-dasharray",isPred?"5,3":"0").attr("stroke-width",1);

      // Recurrent (top, teal)
      svg.append("rect").attr("x",bx).attr("y",y(yr.total_bn))
        .attr("width",bw).attr("height",y(yr.game_sales_bn)-y(yr.total_bn)).attr("rx",isPred?2:0)
        .attr("fill",cc.teal).attr("opacity",isPred?0.3:0.8)
        .attr("stroke",isPred?cc.teal:"none").attr("stroke-dasharray",isPred?"5,3":"0").attr("stroke-width",1);

      // % recurrent line dot
      svg.append("circle").attr("cx",bx+bw/2).attr("cy",y2(yr.pct_recurrent)).attr("r",2.5)
        .attr("fill",isPred?"none":cc.red).attr("stroke",cc.red).attr("stroke-width",isPred?1:0);
    });

    // % recurrent line
    const lineData = years.filter(y => !y.is_prediction);
    svg.append("path").datum(lineData)
      .attr("fill","none").attr("stroke",cc.red).attr("stroke-width",1.5).attr("opacity",0.6)
      .attr("d",d3.line<any>().x(d=>(x(d.fy)??0)+x.bandwidth()/2).y(d=>y2(d.pct_recurrent)).curve(d3.curveMonotoneX) as any);

    // Right axis for % recurrent
    svg.append("g").attr("transform",`translate(${W},0)`)
      .call(d3.axisRight(y2).ticks(5).tickFormat(d=>`${d}%`))
      .call(g=>g.select(".domain").attr("stroke",cc.border2))
      .call(g=>g.selectAll(".tick line").attr("stroke",cc.border2))
      .call(g=>g.selectAll("text").attr("fill",cc.red).attr("font-size","9").attr("font-family","monospace").attr("dx","4"));

    svg.append("g").attr("transform",`translate(0,${H})`)
      .call(d3.axisBottom(x).tickValues(years.filter((_,i)=>i%2===0).map(y=>y.fy)))
      .call(g=>g.select(".domain").attr("stroke",cc.border2))
      .call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace")
        .attr("transform","rotate(-30)").attr("text-anchor","end").attr("dy","0.5em"));

    svg.append("g").call(d3.axisLeft(y).ticks(5).tickFormat(d=>`$${d}B`))
      .call(g=>g.select(".domain").attr("stroke",cc.border2))
      .call(g=>g.selectAll(".tick line").attr("stroke",cc.border2))
      .call(g=>g.selectAll("text").attr("fill",cc.text6).attr("font-size","10").attr("font-family","monospace"));  }

  registerChart("revenue-split-chart", init);
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("revenue-split-chart");
    if (obsEl) {
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) { init(); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
