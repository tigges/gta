---
/**
 * ChartEntertainmentComp
 * Chart component extracted from charts.astro.
 * Can be embedded on any page; D3 init deferred via IntersectionObserver.
 */
import entertainData     from "../../../data/franchise/entertainment-comps.json";
import salesData         from "../../../data/franchise/sales.json";
import ShareButton from "../ShareButton.astro";
---

    <section class="chart-block" data-category="Economy-RL">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[9px] font-mono bg-blue-900/30 text-blue-400 border border-blue-800/40 px-2 py-0.5 rounded uppercase tracking-widest">RL Economy</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI vs Global Entertainment</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">revenue billions USD</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <!-- Thumbnail cover strip -->
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-2.5 overflow-x-auto">
          <img src="/assets/covers/gta-6.jpg" alt="GTA VI" class="rounded border object-cover border-[#2a2a31] w-8 h-11 border-gta-gold/40 shadow shadow-gta-gold/10" loading="lazy" />
        </div>
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">GTA VI Projected Revenue vs Global Entertainment</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Films · games · concerts · platforms · all in USD billions. GTA VI year 1 = ~$3.2B projected.</div>
          </div>
        </div>
        <div id="entertainment-chart" class="w-full" style="height:420px"
          data-entries={JSON.stringify(entertainData.entries.slice(0, 14))}></div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Sources: Box Office Mojo (worldwide lifetime) · Take-Two IR · Spotify IR · DFC Intelligence · *projected</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA VI is projected to outgross the biggest movie openings in history. The entertainment revenue comparison is staggering." url="https://gtavi.ai/charts" size="sm" label="Share" /></div>
        </div>
      </div>

<script>
  import * as d3 from "d3";
  import { registerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("entertainment-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }

    const entries: {name:string;revenue_bn:number;type:string;is_prediction?:boolean}[] =
      JSON.parse(el.dataset.entries || "[]");

    const TYPE_COLORS: Record<string,string> = {
      film: "#60a5fa", game: "#f59e0b", concert: "#a78bfa",
      platform: "#22c55e", other: "#71717a",
    };

    const margin = { top: 8, right: 80, bottom: 32, left: 220 };
    const barH = 26, gap = 4;
    const H = entries.length * (barH + gap);
    const W = el.clientWidth - margin.left - margin.right;

    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${H + margin.top + margin.bottom}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);

    const maxRev = d3.max(entries, d => d.revenue_bn) ?? 1;
    const x = d3.scaleLinear().domain([0, maxRev * 1.05]).range([0, W]);

    entries.forEach((e, i) => {
      const y = i * (barH + gap);
      const color = TYPE_COLORS[e.type] ?? "#71717a";
      const isPred = e.is_prediction;

      svg.append("rect").attr("x", 0).attr("y", y)
        .attr("width", x(e.revenue_bn)).attr("height", barH).attr("rx", 3)
        .attr("fill", isPred ? "none" : color).attr("fill-opacity", isPred ? 0 : 0.75)
        .attr("stroke", isPred ? color : "none").attr("stroke-width", isPred ? 1.5 : 0)
        .attr("stroke-dasharray", isPred ? "6,3" : "0");

      // Name label (left)
      svg.append("text").attr("x", -8).attr("y", y + barH/2)
        .attr("text-anchor","end").attr("dominant-baseline","middle")
        .attr("fill", isPred ? color : "#d4d4d8").attr("font-size","11").attr("font-family","monospace")
        .text(e.name.length > 28 ? e.name.slice(0,27)+"…" : e.name);

      // Value label (right)
      svg.append("text").attr("x", x(e.revenue_bn) + 6).attr("y", y + barH/2)
        .attr("dominant-baseline","middle")
        .attr("fill", color).attr("font-size","11").attr("font-family","monospace")
        .text(`$${e.revenue_bn.toFixed(2)}B${isPred?"*":""}`);

      // Type badge
      svg.append("text").attr("x", 6).attr("y", y + barH/2)
        .attr("dominant-baseline","middle")
        .attr("fill","#09090b").attr("font-size","8").attr("font-family","monospace").attr("font-weight","700")
        .text(e.type.toUpperCase());
    });

    svg.append("g").attr("transform",`translate(0,${H+4})`)
      .call(d3.axisBottom(x).ticks(5).tickFormat(d => `$${d}B`))
      .call(g=>g.select(".domain").attr("stroke","#2a2a31"))
      .call(g=>g.selectAll(".tick line").attr("stroke","#2a2a31"))
      .call(g=>g.selectAll("text").attr("fill","#52525b").attr("font-size","10").attr("font-family","monospace"));
    }

  // Register with chartInit so ChartPreviewCard can force-init on expand
  registerChart("entertainment-chart", init);

  // Also lazy-init via IntersectionObserver for directly-visible charts
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("entertainment-chart");
    if (obsEl) {
      const obs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { init(); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
