---
/**
 * ChartTeaserRevenueSplit — static CSS teaser for GTA V/VI revenue model.
 * Shows the box-sales-to-Shark-Cards shift. No D3, always renders.
 */
import ShareDropdown from "../ShareDropdown.astro";
import revenueSplit from "../../../data/franchise/revenue-split.json";

const KEY_YEARS = ["FY2014", "FY2018", "FY2020", "FY2022"];
const years = (revenueSplit as any).years
  .filter((y: any) => KEY_YEARS.includes(y.fy)) as any[];
---

<div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
  <!-- Header -->
  <div class="px-5 py-4 border-b border-border-dim">
    <div class="font-semibold text-zinc-200 text-sm mb-0.5">
      GTA V: From Box Sales to Shark Cards — 13-Year Revenue Shift
    </div>
    <div class="text-[11px] text-zinc-500 font-mono">
      By FY2022, 90% of GTA revenue was recurrent (Online). This is why GTA VI Online matters more than its $80 price tag.
    </div>
  </div>

  <!-- Legend -->
  <div class="px-5 pt-3 pb-1 flex items-center gap-4 text-[10px] font-mono text-zinc-500">
    <span class="flex items-center gap-1.5">
      <span class="w-3 h-3 rounded-sm inline-block" style="background:var(--c-brand);opacity:0.8"></span>
      Box sales
    </span>
    <span class="flex items-center gap-1.5">
      <span class="w-3 h-3 rounded-sm inline-block" style="background:var(--c-live);opacity:0.8"></span>
      Online / Shark Cards
    </span>
  </div>

  <!-- Stacked bars -->
  <div class="px-5 py-3 flex flex-col gap-3">
    {years.map((y: any) => {
      const gamePct  = Math.round((y.game_sales_bn  / y.total_bn) * 100);
      const onlinePct = Math.round((y.recurrent_bn   / y.total_bn) * 100);
      const isLatest = y.fy === "FY2022";
      return (
        <div class="flex items-center gap-3">
          <!-- Year label -->
          <span class={`text-[10px] font-mono w-12 shrink-0 text-right ${isLatest ? "text-gta-teal" : "text-zinc-600"}`}>
            {y.fy}
          </span>

          <!-- Stacked bar -->
          <div class="flex-1 h-5 rounded overflow-hidden flex gap-px" style="background:var(--c-bg)">
            <div style={`width:${gamePct}%;background:var(--c-brand);opacity:${isLatest ? "0.4" : "0.75"}`} class="h-full transition-all duration-700"></div>
            <div style={`width:${onlinePct}%;background:var(--c-live);opacity:${isLatest ? "1" : "0.6"}`} class="h-full transition-all duration-700"></div>
          </div>

          <!-- Recurrent % -->
          <span class={`text-[10px] font-mono w-10 shrink-0 ${isLatest ? "text-gta-teal font-bold" : "text-zinc-600"}`}>
            {y.pct_recurrent}%
            {isLatest && <span class="ml-0.5 text-[9px]">●</span>}
          </span>
        </div>
      );
    })}
  </div>

  <!-- Key stat -->
  <div class="px-5 pb-4">
    <div class="rounded-lg border border-gta-teal/20 px-4 py-2.5 flex items-center justify-between gap-4" style="background:rgba(13,148,136,0.04)">
      <span class="text-[11px] font-mono text-zinc-400">
        Online revenue grew from <span class="text-zinc-200 font-semibold">16% → 90%</span> in 9 years. GTA VI starts there.
      </span>
      <a href="/charts?title=gta-vi#section-revenue-split-chart"
         class="shrink-0 text-[10px] font-mono text-zinc-500 hover:text-gta-teal transition-colors uppercase tracking-widest whitespace-nowrap">
        Full chart →
      </a>
    </div>
  </div>

  <div class="px-5 pb-3 flex items-center justify-between border-t border-border-dim pt-2.5">
    <span class="text-[10px] text-zinc-600 font-mono">Sources: Take-Two IR quarterly earnings · Wedbush Securities · DFC Intelligence</span>
    <div class="flex items-center gap-2 shrink-0">
      <span class="text-[10px] font-mono text-zinc-500 tracking-widest">GTAVI.AI</span>
      <ShareDropdown anchorId="section-revenue-split-chart" shareText="GTA Online revenue grew from 16% to 90% of Take-Two income in 9 years. GTA VI starts from that baseline. GTAVI.AI" size="sm" />
    </div>
  </div>
</div>
