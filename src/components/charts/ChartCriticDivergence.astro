---
/**
 * ChartCriticDivergence
 * Extracted from charts.astro.
 */
import metacriticData from "../../../data/franchise/metacritic.json";
import ShareButton from "../ShareButton.astro";
const metacriticScores = (metacriticData as any).titles as any[];
---

<section class="chart-block" data-title="franchise" data-category="History">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono bg-zinc-800 text-zinc-500 border border-zinc-700 px-2 py-0.5 rounded uppercase tracking-widest">History</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Critic vs User Score Divergence — The Monetisation Story</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-500">Metacritic · critic /100 · user ×10</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5">
              The Moment Critics and Players Stopped Agreeing
            </div>
            <div class="text-[11px] text-zinc-500 font-mono">GTA SA = perfect alignment. GTA IV = gap opens (+22). Gap tracks directly with online monetisation.</div>
          </div>
          <div class="flex items-center gap-4 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-gta-gold inline-block"></span>Critic score</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-purple-400 inline-block"></span>User score ×10</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-0.5 bg-gta-red inline-block"></span>Gap (divergence)</span>
          </div>
        </div>
        <!-- Metacritic cover + score row -->
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-4 overflow-x-auto">
          {metacriticScores.map((t: any) => (
            <div class="flex items-center gap-2.5 shrink-0">
              <img src={`/assets/covers/${t.id}.jpg`} alt={t.short}
                class={`rounded object-cover border w-8 h-11 ${t.id === "gta-6" ? "border-gta-gold/40" : "border-[#2a2a31]"}`} loading="lazy" />
              <div>
                <div class={`text-[10px] font-mono font-bold ${t.id === "gta-6" ? "text-gta-gold" : "text-zinc-300"}`}>{t.short}</div>
                <div class="text-[11px] font-mono text-zinc-600">{t.critic_score} critic · {t.user_score}×10 user</div>
              </div>
            </div>
          ))}
        </div>
        <div id="divergence-chart" class="w-full" style="height:300px"
          data-scores={JSON.stringify(metacriticScores)}
        ></div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-500 font-mono">Source: Metacritic.com · GTA VI prediction based on franchise trajectory</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA SA had perfect critic/user alignment. GTA IV opened a 22-point gap. Will GTA VI close it? The historical pattern." url="https://gtavi.ai/charts#divergence-chart" size="sm" label="Share" /></div>
        </div>
      </div>

<script>
  import { cc } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("divergence-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }
    const scores: any[] = JSON.parse(el.dataset.scores || "[]");

    // Add GTA VI prediction
    const withPred = [...scores, {
      id:"gta-6", short:"GTA VI*", year:2026,
      critic_score:96, user_score:7.0,
      critic_user_delta:26, note:"Prediction based on franchise monetisation trajectory",
      is_prediction:true,
    }];

    const margin = { top: 24, right: 48, bottom: 56, left: 52 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;
    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);

    const x = d3.scaleBand().domain(withPred.map(t=>t.short)).range([0,W]).padding(0.3);
    const y = d3.scaleLinear().domain([65, 102]).range([H,0]);

    svg.append("g").call(d3.axisLeft(y).ticks(7).tickSize(-W).tickFormat(()=>""))
      .call(g=>g.select(".domain").remove())
      .call(g=>g.selectAll(".tick line").attr("stroke",cc.grid).attr("stroke-dasharray","3,3"));
    svg.append("g").call(d3.axisLeft(y).ticks(7))
      .call(g=>g.select(".domain").remove())
      .call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill",cc.text6).attr("font-size","10").attr("font-family","monospace"));

    withPred.forEach(s => {
      const cx = (x(s.short) ?? 0) + x.bandwidth() / 2;
      const cy = y(s.critic_score);
      const uy = y(s.user_score * 10);
      const isPred = s.is_prediction;

      // Connecting line
      svg.append("line").attr("x1",cx).attr("x2",cx).attr("y1",cy).attr("y2",uy)
        .attr("stroke", isPred?cc.red:cc.text6)
        .attr("stroke-width", isPred?2:1.5)
        .attr("stroke-dasharray", isPred?"5,3":"0")
        .attr("opacity",0.7);

      // Critic dot (gold)
      svg.append("circle").attr("cx",cx).attr("cy",cy).attr("r",isPred?7:6)
        .attr("fill",isPred?"none":cc.bar).attr("stroke",cc.bar).attr("stroke-width",isPred?1.5:0);
      svg.append("text").attr("x",cx).attr("y",cy-10).attr("text-anchor","middle")
        .attr("fill",cc.bar).attr("font-size","10").attr("font-family","monospace").attr("font-weight","600")
        .text(s.critic_score);

      // User dot (purple)
      svg.append("circle").attr("cx",cx).attr("cy",uy).attr("r",isPred?7:6)
        .attr("fill",isPred?"none":cc.purple).attr("stroke",cc.purple).attr("stroke-width",isPred?1.5:0);
      svg.append("text").attr("x",cx).attr("y",uy+18).attr("text-anchor","middle")
        .attr("fill",cc.purple).attr("font-size","10").attr("font-family","monospace")
        .text((s.user_score * 10).toFixed(0));

      // Delta label
      const delta = s.critic_user_delta;
      svg.append("text").attr("x",cx+x.bandwidth()/2+2).attr("y",(cy+uy)/2+4)
        .attr("fill",delta>15?cc.red:cc.text6).attr("font-size","9").attr("font-family","monospace")
        .text(`+${delta}`);
    });

    // "Monetisation opens here" annotation
    const gta4x = (x("GTA IV") ?? 0) + x.bandwidth() / 2;
    svg.append("text").attr("x",gta4x).attr("y",H+36).attr("text-anchor","middle")
      .attr("fill",cc.red).attr("font-size","8").attr("font-family","monospace").text("← gap opens here");

    svg.append("g").attr("transform",`translate(0,${H})`)
      .call(d3.axisBottom(x))
      .call(g=>g.select(".domain").attr("stroke",cc.border2))
      .call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill",cc.text4).attr("font-size","11").attr("font-family","monospace").attr("dy","1.2em"));  }

  registerChart("divergence-chart", init);
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("divergence-chart");
    if (obsEl) {
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) { init(); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
