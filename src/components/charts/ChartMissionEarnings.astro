---
/**
 * ChartMissionEarnings
 * GTA V story mission earnings arc — $250 Repossession to $41.6M Big Score.
 * Extracted from gta-v.astro.
 */
import missionsData from "../../../data/gta-5/missions/story-missions.json";
import CardFooter from "../CardFooter.astro";
import { registerChart, triggerChart } from "../../assets/chartInit";
const storyMissions  = (missionsData as any).missions as any[];
const payingMissions = storyMissions.filter((m: any) => m.payout > 0);
const stockMissions  = storyMissions.filter((m: any) => m.stock_mission);
---

<div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <div class="px-5 py-4 border-b border-border-dim flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm">Earnings Curve — $250 Repossession to $41.6M Big Score</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Each mission plotted by chapter. Gold diamonds = Lester stock missions. The Big Score is the only real money event.</div>
          </div>
          <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-gta-gold/80 inline-block"></span>Stock mission</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-zinc-500 inline-block"></span>Standard mission</span>
          </div>
        </div>
        <div id="mission-earnings-chart" class="w-full" style="height:280px"
          data-missions={JSON.stringify(storyMissions.filter((m: any) => m.payout >= 0))}
        ></div>
        <CardFooter chartId="mission-earnings-chart" sources="Source: GTA Wiki (Fandom) · community records · updated by fetch_missions.py" shareText="GTA V story mission earnings from start to finish. $250 at Repossession to $41.6M at The Big Score. The earning curve tells the whole story." />
      </div>

<script>
  import { cc, op } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart, triggerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("mission-earnings-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }

    const missions: any[] = JSON.parse(el.dataset.missions || "[]");

    const margin = { top: 16, right: 24, bottom: 40, left: 72 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);

    // Use mission index as x-axis, payout as y-axis
    const paying = missions.filter(m => m.payout >= 0);
    const x = d3.scaleLinear().domain([0, paying.length - 1]).range([0, W]);
    const y = d3.scaleLog().domain([100, Math.max(...paying.map(m => m.payout || 100))]).range([H, 0]).clamp(true);

    // Gridlines
    svg.append("g").call(d3.axisLeft(y).ticks(4).tickSize(-W).tickFormat(() => ""))
      .call(g => g.select(".domain").remove())
      .call(g => g.selectAll(".tick line").attr("stroke",cc.grid).attr("stroke-dasharray","3,3"));

    // Area under line
    const defs = svg.append("defs");
    const grad = defs.append("linearGradient").attr("id","me-grad").attr("gradientUnits","userSpaceOnUse").attr("x1",0).attr("y1",0).attr("x2",0).attr("y2",H);
    grad.append("stop").attr("offset","0%").attr("stop-color",cc.bar).attr("stop-opacity",0.15);
    grad.append("stop").attr("offset","100%").attr("stop-color",cc.bar).attr("stop-opacity",0.01);

    const line = d3.line<any>()
      .x((d, i) => x(i))
      .y(d => y(Math.max(d.payout || 0, 100)))
      .curve(d3.curveMonotoneX);

    svg.append("path").datum(paying).attr("fill","url(#me-grad)")
      .attr("d", d3.area<any>().x((d,i) => x(i)).y0(H).y1(d => y(Math.max(d.payout||0,100))).curve(d3.curveMonotoneX));
    svg.append("path").datum(paying).attr("fill","none").attr("stroke",cc.bar).attr("stroke-width",1.5)
      .attr("d", line);

    // Stock mission diamonds
    paying.forEach((m, i) => {
      if (m.stock_mission) {
        svg.append("polygon")
          .attr("points", `0,-6 6,0 0,6 -6,0`)
          .attr("transform", `translate(${x(i)},${y(Math.max(m.payout,100))})`)
          .attr("fill",cc.bar).attr("opacity",op.primary);
      }
    });

    // The Big Score annotation
    const bigScore = paying.find(m => m.id === "the-big-score");
    if (bigScore) {
      const bi = paying.indexOf(bigScore);
      const bx = x(bi), by = y(bigScore.payout);
      svg.append("line").attr("x1",bx).attr("x2",bx).attr("y1",by+8).attr("y2",H)
        .attr("stroke",cc.bar).attr("stroke-width",1).attr("stroke-dasharray","4,3").attr("opacity",op.muted);
      svg.append("text").attr("x",bx+4).attr("y",by-4).attr("fill",cc.bar)
        .attr("font-size","9").attr("font-family","monospace").text("The Big Score");
    }

    // Axes
    svg.append("g").attr("transform",`translate(0,${H})`)
      .call(d3.axisBottom(x).ticks(5).tickFormat(d => `Mission ${d}`))
      .call(g => g.select(".domain").attr("stroke",cc.border2))
      .call(g => g.selectAll(".tick line").attr("stroke",cc.border2))
      .call(g => g.selectAll("text").attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace"));

    svg.append("g").call(d3.axisLeft(y).ticks(4).tickFormat(d => `$${Number(d)>=1000000?`${(Number(d)/1000000).toFixed(0)}M`:Number(d)>=1000?`${(Number(d)/1000).toFixed(0)}k`:String(d)}`))
      .call(g => g.select(".domain").remove())
      .call(g => g.selectAll(".tick line").remove())
      .call(g => g.selectAll("text").attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace"));

    // GTAVI.AI watermark
    svg.append("text").attr("x",W-4).attr("y",H-6)
      .attr("text-anchor","end").attr("fill",cc.text7).attr("font-size","8").attr("font-family","monospace")
      .text("GTAVI.AI");  }

  registerChart("mission-earnings-chart", init);

  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("mission-earnings-chart");
    if (obsEl) {
      const obs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { triggerChart("mission-earnings-chart"); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
