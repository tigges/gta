---
/**
 * ChartCpiPricing
 * Extracted from charts.astro.
 */
import cpiData from "../../../data/franchise/cpi.json";
import ChartFooter from "../ChartFooter.astro";
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm mb-0.5">
            Is $80 Too Much? — The Inflation-Adjusted Answer
          </div>
          <div class="text-[11px] text-zinc-500 font-mono">GTA III's $49.99 in 2001 = $90.38 in 2026 dollars. GTA VI at $79.99 is cheaper in real terms than every PS2-era title.</div>
        </div>
        <!-- Cover + price row -->
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-4 overflow-x-auto">
          {cpiData.titles.map((t: any) => {
            const adjusted = t.price_nominal && t.cpi_year
              ? (t.price_nominal * (cpiData.base_cpi / t.cpi_year)).toFixed(2)
              : null;
            return (
              <div class="flex items-center gap-2 shrink-0">
                <img src={`/assets/covers/${t.id}.jpg`} alt={t.short}
                  class={`rounded object-cover border w-8 h-11 ${t.id === "gta-6" ? "border-gta-gold/40" : "border-[#2a2a31]"}`} loading="lazy" />
                <div>
                  <div class={`text-[10px] font-mono font-bold ${t.id === "gta-6" ? "text-gta-gold" : "text-zinc-300"}`}>{t.short}</div>
                  <div class="text-[11px] font-mono text-zinc-600">${t.price_nominal} → <span class="text-zinc-400">${adjusted}</span></div>
                </div>
              </div>
            );
          })}
        </div>
        <div id="cpi-chart" class="w-full" style="height:280px"
          data-titles={JSON.stringify(cpiData.titles)}
          data-base-cpi={cpiData.base_cpi}
        ></div>
        <ChartFooter chartId="cpi-chart" sources="Source: US Bureau of Labor Statistics CPI-U · Nominal prices from Rockstar/Take-Two" shareText="GTA VI at $79.99 is actually cheaper than GTA III in 2001, in real inflation-adjusted dollars. The data says it" />
      </div>

<script>
  import { cc } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart, triggerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("cpi-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }
    const titles: any[] = JSON.parse(el.dataset.titles || "[]");
    const baseCpi = parseFloat(el.dataset.baseCpi || "321.5");

    const withReal = titles.map(t => ({
      ...t,
      price_real: Math.round((t.price_nominal * baseCpi / t.cpi_year) * 100) / 100,
    }));

    const margin = { top: 24, right: 24, bottom: 56, left: 56 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;
    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);

    const x = d3.scaleBand().domain(withReal.map(t=>t.short)).range([0,W]).padding(0.25);
    const y = d3.scaleLinear().domain([0, 105]).range([H,0]);

    svg.append("g").call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(d=>`$${d}`))
      .call(g=>g.select(".domain").remove())
      .call(g=>g.selectAll(".tick line").attr("stroke",cc.grid).attr("stroke-dasharray","3,3"))
      .call(g=>g.selectAll("text").attr("fill",cc.text6).attr("font-size","10").attr("font-family","monospace"));

    // $80 reference line
    svg.append("line").attr("x1",0).attr("x2",W).attr("y1",y(80)).attr("y2",y(80))
      .attr("stroke",cc.bar).attr("stroke-width",1).attr("stroke-dasharray","4,3").attr("opacity",0.4);
    svg.append("text").attr("x",4).attr("y",y(80)-4).attr("fill",cc.bar)
      .attr("font-size","9").attr("font-family","monospace").text("$80 GTA VI price");

    withReal.forEach(t => {
      const bx = x(t.short) ?? 0, bw = x.bandwidth(), isVI = t.id === "gta-6";

      // Real price bar (behind, lighter)
      svg.append("rect").attr("x",bx).attr("y",y(t.price_real))
        .attr("width",bw).attr("height",H-y(t.price_real)).attr("rx",3)
        .attr("fill",isVI?cc.bar:cc.text6).attr("opacity",isVI?0.15:0.25);

      // Nominal price bar (front, solid)
      svg.append("rect").attr("x",bx+bw*0.15).attr("y",y(t.price_nominal))
        .attr("width",bw*0.7).attr("height",H-y(t.price_nominal)).attr("rx",2)
        .attr("fill",isVI?cc.bar:cc.text7).attr("opacity",isVI?0.9:0.85);

      // Real price label
      svg.append("text").attr("x",bx+bw/2).attr("y",y(t.price_real)-5)
        .attr("text-anchor","middle").attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace")
        .text(`$${t.price_real}`);

      // Nominal price label
      svg.append("text").attr("x",bx+bw/2).attr("y",y(t.price_nominal)-5)
        .attr("text-anchor","middle").attr("fill",isVI?cc.bar:cc.text4).attr("font-size","10").attr("font-family","monospace").attr("font-weight","600")
        .text(`$${t.price_nominal}`);
    });

    svg.append("g").attr("transform",`translate(0,${H})`)
      .call(d3.axisBottom(x))
      .call(g=>g.select(".domain").attr("stroke",cc.border2))
      .call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill",cc.text4).attr("font-size","12").attr("font-family","monospace").attr("dy","1.2em"));

    // Legend
    svg.append("rect").attr("x",W-130).attr("y",-18).attr("width",10).attr("height",10).attr("fill",cc.text7).attr("opacity",0.9);
    svg.append("text").attr("x",W-116).attr("y",-10).attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace").text("Nominal price");
    svg.append("rect").attr("x",W-130).attr("y",-4).attr("width",10).attr("height",10).attr("fill",cc.text6).attr("opacity",0.25);
    svg.append("text").attr("x",W-116).attr("y",4).attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace").text("2026 real price");  }

  registerChart("cpi-chart", init);
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("cpi-chart");
    if (obsEl) {
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) { triggerChart("cpi-chart"); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
