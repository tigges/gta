---
/**
 * ChartTeaserOnlineSharkCard — static CSS step chart teaser.
 * Shows endgame cost in real USD at each major DLC, 2013–2026.
 * Data from shark-cards.json endgame_cost_history.
 * No D3, no JS — always renders.
 */
import sharkData from "../../../data/gta-5/economy/shark-cards.json";

const history = (sharkData as any).endgame_cost_history as {
  era: string; date: string; megalodon_usd_equivalent: number;
}[];

const max = Math.max(...history.map(h => h.megalodon_usd_equivalent));
const first = history[0]?.megalodon_usd_equivalent ?? 19;
const last  = history.at(-1)?.megalodon_usd_equivalent ?? 438;
const multiplier = (last / first).toFixed(1);
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden flex flex-col" style="background:var(--c-card)">
  <!-- Header -->
  <div class="flex items-start justify-between gap-3 px-5 pt-4 pb-3 border-b border-[#1e1e23]">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-[9px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest"
              style="color:var(--c-title-online);border-color:color-mix(in srgb,var(--c-title-online) 40%,transparent);background:color-mix(in srgb,var(--c-title-online) 10%,transparent)">GTA Online</span>
        <span class="text-[9px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest"
              style="color:var(--c-text-4);border-color:var(--c-border-2)">RL Economy</span>
      </div>
      <div class="text-sm font-semibold text-zinc-200">Shark Card Inflation — 12 Years</div>
      <div class="text-[10px] font-mono text-zinc-500 mt-0.5">Endgame cost in real USD · card prices never changed — the game got more expensive</div>
    </div>
    <a href="/charts?title=gta-online#section-shark-card-chart"
       class="shrink-0 text-[10px] font-mono text-zinc-600 hover:text-zinc-300 transition-colors uppercase tracking-widest whitespace-nowrap">
      Full →
    </a>
  </div>

  <!-- Key stats -->
  <div class="grid grid-cols-3 divide-x divide-[#1e1e23] border-b border-[#1e1e23]">
    <div class="px-4 py-3">
      <div class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Endgame 2013</div>
      <div class="text-base font-mono font-bold text-zinc-400">${first} USD</div>
      <div class="text-[9px] font-mono text-zinc-700 mt-0.5">via Shark Cards</div>
    </div>
    <div class="px-4 py-3">
      <div class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Endgame 2026</div>
      <div class="text-base font-mono font-bold" style="color:var(--c-alert)">${last} USD</div>
      <div class="text-[9px] font-mono text-zinc-700 mt-0.5">via Shark Cards</div>
    </div>
    <div class="px-4 py-3">
      <div class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Real-money inflation</div>
      <div class="text-base font-mono font-bold" style="color:var(--c-alert)">{multiplier}×</div>
      <div class="text-[9px] font-mono text-zinc-700 mt-0.5">12-year multiplier</div>
    </div>
  </div>

  <!-- Step bars (one per era) -->
  <div class="px-5 py-4 flex flex-col gap-2 flex-1">
    {history.map((h, i) => {
      const pct = Math.round((h.megalodon_usd_equivalent / max) * 100);
      const isLast = i === history.length - 1;
      const shortEra = h.era.replace(" Update", "").replace("Los Santos Drug Wars ", "").replace(" Heist", "").split("(")[0].trim();
      return (
        <div class="flex items-center gap-2.5">
          <span class="text-[9px] font-mono text-zinc-600 w-10 shrink-0">{h.date.slice(0,4)}</span>
          <div class="flex-1 h-4 rounded overflow-hidden" style="background:var(--c-bg)">
            <div class="h-full rounded"
                 style={`width:${pct}%;background:var(--c-alert);opacity:${isLast ? "0.9" : Math.min(0.3 + pct / 140, 0.75)}`}>
            </div>
          </div>
          <span class={`text-[9px] font-mono w-12 shrink-0 text-right ${isLast ? "" : "text-zinc-600"}`}
                style={isLast ? "color:var(--c-alert)" : ""}>
            ${h.megalodon_usd_equivalent}
          </span>
        </div>
      );
    })}
  </div>

  <div class="px-5 pb-3 border-t border-[#1e1e23] pt-2.5">
    <span class="text-[9px] font-mono text-zinc-700">Shark Card prices unchanged since 2013 · endgame GTA$ ÷ $80k/USD rate</span>
  </div>
</div>
