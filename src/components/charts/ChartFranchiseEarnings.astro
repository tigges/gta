---
/**
 * ChartFranchiseEarnings
 * Chart component extracted from charts.astro.
 * Can be embedded on any page; D3 init deferred via IntersectionObserver.
 */
import franchiseEconData from "../../../data/franchise/economic-history.json";
import ChartFooter from "../ChartFooter.astro";
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm mb-0.5">
            The "Big Mac Index" for GTA — Hours of Play to Reach the Aspirational Purchase
          </div>
          <div class="text-[11px] text-zinc-500 font-mono">Left bars = max achievable $/hr. Right dots = hours to buy the era's most desirable item. GTA Online's endgame has grown 23× in real-money terms.</div>
        </div>
        <div id="franchise-earnings-chart" class="w-full" style="height:360px"
          data-effort={JSON.stringify((franchiseEconData as any).effort_chart_data)}
        ></div>
        <ChartFooter chartId="franchise-earnings-chart" sources="hours_to_aspirational = aspirational_price ÷ best_hourly_rate per title · Sources: community records · GTA Fandom Wiki" shareText="GTA franchise earnings compared across titles: how many hours does it take to buy the era" />
      </div>

<script>
  import { cc } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("franchise-earnings-chart") as HTMLElement | null;
    if (!el) return;
    if (el.querySelector('svg')) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }

    const effort: any[] = JSON.parse(el.dataset.effort || "[]");
    if (!effort.length) return;

    const margin = {top:24, right:100, bottom:40, left:160};
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);

    const maxHr = d3.max(effort, (d:any) => d.best_gta_per_hr) ?? 2000000;
    const maxHrs = d3.max(effort, (d:any) => d.hours_to_aspirational) ?? 25;

    const xHr  = d3.scaleLinear().domain([0, maxHr]).range([0, W * 0.65]);
    const xHrs = d3.scaleLinear().domain([0, maxHrs]).range([0, W * 0.65]);
    const y    = d3.scaleBand().domain(effort.map((d:any) => d.short)).range([0, H]).padding(0.25);

    // Left panel header
    svg.append("text").attr("x",W * 0.3).attr("y",-8).attr("text-anchor","middle")
      .attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace").text("Max GTA$/hr →");
    svg.append("text").attr("x",W * 0.825).attr("y",-8).attr("text-anchor","middle")
      .attr("fill",cc.text4).attr("font-size","9").attr("font-family","monospace").text("Hours to endgame →");

    // Divider
    svg.append("line").attr("x1",W*0.7).attr("x2",W*0.7).attr("y1",-16).attr("y2",H)
      .attr("stroke",cc.grid).attr("stroke-dasharray","4,3");

    effort.forEach((d:any) => {
      const barY = y(d.short) ?? 0;
      const bh   = y.bandwidth();
      const isPeak = d.id === "gta-online";
      const color  = isPeak ? cc.bar : d.complexity_score >= 7 ? cc.teal : cc.text6;

      // $/hr bar (left panel)
      const bw = xHr(d.best_gta_per_hr);
      svg.append("rect").attr("x",0).attr("y",barY).attr("width",bw).attr("height",bh)
        .attr("rx",2).attr("fill",color).attr("opacity",0.75);
      svg.append("text").attr("x",bw+4).attr("y",barY+bh/2+4)
        .attr("fill",color).attr("font-size","9").attr("font-family","monospace")
        .text(`$${(d.best_gta_per_hr/1000).toFixed(0)}k/hr`);

      // Hours to aspirational dot (right panel)
      const dotX = W * 0.7 + xHrs(d.hours_to_aspirational);
      const dotColor = d.hours_to_aspirational > 15 ? cc.red : d.hours_to_aspirational > 5 ? cc.bar : cc.green;
      svg.append("circle").attr("cx",dotX).attr("cy",barY+bh/2).attr("r",6)
        .attr("fill",dotColor).attr("opacity",0.85);
      svg.append("text").attr("x",dotX+9).attr("y",barY+bh/2+4)
        .attr("fill",dotColor).attr("font-size","9").attr("font-family","monospace")
        .text(`${d.hours_to_aspirational}h`);

      // Title label
      svg.append("text").attr("x",-8).attr("y",barY+bh/2+4).attr("text-anchor","end")
        .attr("fill", isPeak ? cc.bar : cc.text4).attr("font-size","10").attr("font-family","monospace")
        .text(d.short);
    });

    // Axis ticks
    svg.append("g").attr("transform",`translate(0,${H})`).call(d3.axisBottom(xHr).ticks(4).tickFormat((d:any)=>`$${Math.round(+d/1000)}k`))
      .call(g=>g.select(".domain").attr("stroke",cc.border2))
      .call(g=>g.selectAll(".tick line").attr("stroke",cc.border2))
      .call(g=>g.selectAll("text").attr("fill",cc.text6).attr("font-size","8").attr("font-family","monospace"));
    }

  // Register with chartInit so ChartPreviewCard can force-init on expand
  registerChart("franchise-earnings-chart", init);

  // Also lazy-init via IntersectionObserver for directly-visible charts
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("franchise-earnings-chart");
    if (obsEl) {
      const obs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { init(); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
