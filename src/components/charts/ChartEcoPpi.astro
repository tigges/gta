---
/**
 * ChartEcoPpi
 * Economy chart extracted from gta-online/economy.astro.
 * Self-contained; D3 init deferred via IntersectionObserver.
 */
import ppiData     from "../../../data/gta-5/economy/gta-ppi.json";
import metaHistory from "../../../data/gta-5/economy/meta-history.json";
import ChartFooter from "../ChartFooter.astro";

const ppiSeries  = (ppiData as any).series as any[];
const metaSeries = (metaHistory as any).meta_history as any[];
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
  <div class="px-5 py-3 border-b border-[#1e1e23]">
    <div class="font-semibold text-zinc-200 text-sm">GTA-PPI — Purchasing Power Index 2013–2026</div>
    <div class="text-[10px] font-mono text-zinc-600 mt-0.5">GTA$ real value vs real-world inflation · updated nightly</div>
  </div>
  <div id="chart-ppi" class="w-full" style="height:280px"
    data-ppi={JSON.stringify(ppiSeries)} data-yields={JSON.stringify(metaSeries)}
  ></div>
  <ChartFooter chartId="chart-ppi" sources="Source: community data · updated nightly" shareText="GTA Online economy chart: GTA-PPI — Purchasing Power Index 2013–2026" />
</div>

<script>
  import * as d3 from "d3";
  import { cc } from "../../assets/chartColors";
  import { registerChart, triggerChart } from "../../assets/chartInit";

  const CHART_H: Record<string, number> = {
    "chart-wages": 220, "chart-spending": 220, "chart-savings": 220,
    "chart-sharkcards": 220, "chart-investment": 200, "chart-ppi": 280, "chart-health": 280,
  };
  function getDims(id: string, ml:number, mr:number, mt:number, mb:number) {
    const el = document.getElementById(id) as HTMLElement;
    const totalH = CHART_H[id] ?? 220;
    const totalW = el?.clientWidth || 600;
    const W = totalW - ml - mr;
    const H = totalH - mt - mb;
    return { el, W: Math.max(W,10), H: Math.max(H,10), totalW, totalH };
  }

  function init() {
    const {el,W,H,totalW,totalH}=getDims("chart-ppi",56,60,16,48);
    if(!el) return;
    const series:any[]=JSON.parse(el.dataset.series||"[]");
    const ml=56,mr=60,mt=16,mb=48;
    const svg=d3.select(el).append("svg").attr("width","100%").attr("viewBox",`0 0 ${totalW} ${totalH}`).append("g").attr("transform",`translate(${ml},${mt})`);
    const x=d3.scaleTime().domain([new Date("2013-01-01"),new Date("2026-01-01")]).range([0,W]);
    const y=d3.scaleLinear().domain([0,(d3.max(series,(s:any)=>s.ppi)??200)*1.2]).range([H,0]);
    svg.append("g").call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(()=>""))
      .call(g=>g.select(".domain").remove()).call(g=>g.selectAll(".tick line").attr("stroke",cc.grid).attr("stroke-dasharray","3,3"));
    svg.append("line").attr("x1",0).attr("x2",W).attr("y1",y(100)).attr("y2",y(100)).attr("stroke",cc.text6).attr("stroke-width",1).attr("stroke-dasharray","4,2");
    svg.append("text").attr("x",W+4).attr("y",y(100)+4).attr("fill",cc.text6).attr("font-size","8").attr("font-family","monospace").text("100");
    const defs=svg.append("defs");
    const grad=defs.append("linearGradient").attr("id","ppi-grad2").attr("x1","0").attr("y1","0").attr("x2","0").attr("y2","1");
    grad.append("stop").attr("offset","0%").attr("stop-color",cc.red).attr("stop-opacity",0.2);
    grad.append("stop").attr("offset","100%").attr("stop-color",cc.red).attr("stop-opacity",0.01);
    const areaFn=d3.area<any>().x(d=>x(new Date(d.date))).y0(H).y1(d=>y(d.ppi)).curve(d3.curveMonotoneX);
    svg.append("path").datum(series).attr("fill","url(#ppi-grad2)").attr("d",areaFn as any);
    const lineFn=d3.line<any>().x(d=>x(new Date(d.date))).y(d=>y(d.ppi)).curve(d3.curveMonotoneX);
    svg.append("path").datum(series).attr("fill","none").attr("stroke",cc.red).attr("stroke-width",2).attr("d",lineFn as any);
    series.forEach((s:any,i:number)=>{
      const cx=x(new Date(s.date)),cy=y(s.ppi),isLast=i===series.length-1;
      const dotColor=s.event==="nerf"?cc.red:s.event==="buff"?cc.green:s.event==="basket_expansion"?cc.purple:cc.bar;
      svg.append("circle").attr("cx",cx).attr("cy",cy).attr("r",isLast?5:3.5).attr("fill",isLast?cc.red:cc.bg).attr("stroke",dotColor).attr("stroke-width",1.5);
      if(isLast) svg.append("text").attr("x",cx+7).attr("y",cy+4).attr("fill",cc.red).attr("font-size","11").attr("font-family","monospace").attr("font-weight","bold").text(`PPI ${s.ppi}`);
    });
    [{date:"2018-07-24",label:"Oppressor +153%",color:cc.purple},{date:"2020-12-15",label:"Cayo all-time low",color:cc.green},{date:"2022-01-20",label:"Cayo nerf",color:cc.red}].forEach(a=>{
      const xp=x(new Date(a.date));
      svg.append("line").attr("x1",xp).attr("x2",xp).attr("y1",0).attr("y2",H).attr("stroke",a.color).attr("stroke-width",1).attr("stroke-dasharray","3,3").attr("opacity",0.5);
      svg.append("text").attr("x",xp+3).attr("y",16).attr("fill",a.color).attr("font-size","7.5").attr("font-family","monospace").text(a.label);
    });
    svg.append("g").attr("transform",`translate(0,${H})`).call(d3.axisBottom(x).ticks(6).tickFormat((d:any)=>`${new Date(d).getFullYear()}`))
      .call(g=>g.select(".domain").attr("stroke",cc.border2)).call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace"));
    svg.append("g").call(d3.axisLeft(y).ticks(5))
      .call(g=>g.select(".domain").remove()).call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace"));  }

  // Register with chartInit so ChartPreviewCard can force-init on expand
  registerChart("chart-ppi", init);

  // Also lazy-init via IntersectionObserver for directly-visible charts
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("chart-ppi");
    if (obsEl) {
      const obs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { triggerChart("chart-ppi"); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
