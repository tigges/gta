---
/**
 * ChartTrailerDiscovery
 * Chart component extracted from charts.astro.
 * Can be embedded on any page; D3 init deferred via IntersectionObserver.
 */
import trailerAnalysis   from "../../../data/gta-6/trailer-analysis.json";
import CardFooter from "../CardFooter.astro";
---

<div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <div class="px-5 py-4 border-b border-border-dim flex items-center gap-5 flex-wrap">
          <div class="flex-1">
            <div class="font-semibold text-zinc-200 text-sm mb-0.5">
              Frame-by-Frame: Information Density Across All Official Releases
            </div>
            <div class="text-[11px] text-zinc-500 font-mono">Each marker = a new entity confirmed. Colour = entity type. Extended Look (EL) reveals 52 entities across 27 minutes.</div>
          </div>
          <!-- Trailer thumbnails -->
          <div class="flex items-center gap-3 shrink-0">
            {(trailerAnalysis.trailers as any[]).map((t: any, i: number) => (
              <a href={`https://www.youtube.com/watch?v=${t.youtube_id}`} target="_blank" rel="noopener noreferrer"
                class="group relative overflow-hidden rounded-lg border border-border-mid hover:border-gta-gold/30 transition-all">
                <img src={`https://img.youtube.com/vi/${t.youtube_id}/mqdefault.jpg`}
                  alt={t.title} class="w-28 h-16 object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                <div class="absolute inset-0" style="background:linear-gradient(to top,var(--c-bg) 0%,transparent 50%)"></div>
                <div class="absolute bottom-1 left-2">
                  <span class="text-[10px] font-mono text-gta-gold">{i < 2 ? `T${i + 1}` : 'EL'}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
        <div id="trailer-discovery-chart" class="w-full px-5 py-4"
          data-trailers={JSON.stringify(trailerAnalysis.trailers)}
        ></div>
        <CardFooter chartId="trailer-discovery-chart" sources="Source: GTA VI.AI frame-by-frame analysis · official Rockstar trailers + Extended Look" shareText="GTA VI Extended Look confirms 52 entities in 27 minutes — more than T1 and T2 combined. Frame-by-frame entity density analysis on GTAVI.AI" />
      </div>

<script>
  import { cc, op } from "../../assets/chartColors";
  import { EL_LAYOUT, layoutBilateralLabels } from "../../assets/elTimelineLayout";

  import * as d3 from "d3";
  import { registerChart, triggerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("trailer-discovery-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }

    const trailers: any[] = JSON.parse(el.dataset.trailers || "[]");

    const TYPE_COLORS: Record<string,string> = {
      vehicle:   cc.bar,
      character: cc.live,
      location:  cc.online,
      wildlife:  cc.green,
      weapon:    cc.red,
      audio:     cc.purple,
      reveal:    cc.text1,
    };

    trailers.forEach((trailer) => {
      const labeled = trailer.events.filter((ev: any, i: number) =>
        ev.type === "reveal" || ev.type === "character" || i < 3 || ev.confidence === "confirmed"
      );
      const W = el.clientWidth - 20;
      const packed = layoutBilateralLabels(labeled, W, trailer.duration_sec);
      const rowH = EL_LAYOUT.rowH;
      const stripH = 40;
      const aboveH = packed.aboveRows * rowH + 8;
      const belowH = packed.belowRows * rowH + 8;
      const axisH = 18;
      const totalH = aboveH + stripH + belowH + axisH;
      const stripY = aboveH;

      const div = document.createElement("div");
      div.className = "mb-6";
      el.appendChild(div);

      const titleEl = document.createElement("div");
      titleEl.className = "text-[10px] font-mono text-zinc-500 mb-2 uppercase tracking-widest";
      titleEl.textContent = `${trailer.title} · ${trailer.duration_sec}s runtime · ${trailer.events.length} entities`;
      div.appendChild(titleEl);

      const svg = d3.select(div).append("svg").attr("width","100%")
        .attr("viewBox",`0 0 ${el.clientWidth} ${totalH}`)
        .append("g").attr("transform","translate(10,0)");

      const dur = trailer.duration_sec;
      const x = d3.scaleLinear().domain([0, dur]).range([0, W]);

      // Background strip
      svg.append("rect").attr("x",0).attr("y",stripY).attr("width",W).attr("height",stripH).attr("rx",4)
        .attr("fill",cc.cardRaised);

      // Density heatmap (count events per 8-second bucket)
      const buckets = Math.ceil(dur / 8);
      const counts = new Array(buckets).fill(0);
      trailer.events.forEach((ev: any) => { counts[Math.floor(ev.t / 8)]++; });
      const maxCount = Math.max(...counts);
      counts.forEach((c, i) => {
        if (c === 0) return;
        const bx = x(i * 8);
        const bw = x(8) - x(0);
        svg.append("rect").attr("x",bx).attr("y",stripY).attr("width",bw).attr("height",stripH).attr("rx",2)
          .attr("fill",cc.bar).attr("opacity", 0.05 + (c / maxCount) * 0.25);
      });

      const byKey = new Map(packed.placements.map((p) => [`${p.t}|${p.entity}`, p]));

      trailer.events.forEach((ev: any) => {
        const ex = x(ev.t);
        const color = TYPE_COLORS[ev.type] ?? cc.text4;
        const place = byKey.get(`${ev.t}|${ev.entity}`);
        const above = place ? place.side === "above" : ev.t % 2 === 0;
        const markerY = above ? stripY + 6 : stripY + stripH - 6;

        const stemY = place
          ? (place.side === "above"
              ? stripY - 2 - place.row * rowH
              : stripY + stripH + 2 + place.row * rowH)
          : (above ? stripY : stripY + stripH);

        svg.append("line").attr("x1",ex).attr("x2",ex)
          .attr("y1", above ? stemY : stripY)
          .attr("y2", above ? stripY + stripH : stemY)
          .attr("stroke",color).attr("stroke-width",1).attr("opacity",op.tertiary);

        svg.append("circle").attr("cx",ex).attr("cy",markerY).attr("r",4)
          .attr("fill",color).attr("stroke",cc.bg).attr("stroke-width",1);

        if (place) {
          const labelY = place.side === "above"
            ? stripY - 6 - place.row * rowH
            : stripY + stripH + 14 + place.row * rowH;
          svg.append("text")
            .attr("x", place.labelX + place.labelW / 2)
            .attr("y", labelY)
            .attr("text-anchor","middle").attr("fill",color)
            .attr("font-size","9").attr("font-family","monospace").text(place.text);
        }
      });

      // Time axis
      [0, 0.25, 0.5, 0.75, 1.0].forEach(pct => {
        const tx = pct * W;
        const tSec = Math.round(pct * dur);
        svg.append("text").attr("x",tx).attr("y",totalH - 4)
          .attr("text-anchor","middle").attr("fill",cc.text5).attr("font-size","9").attr("font-family","monospace")
          .text(`${Math.floor(tSec/60)}:${String(tSec%60).padStart(2,"0")}`);
      });
    });

    // Legend
    const legendDiv = document.createElement("div");
    legendDiv.className = "flex flex-wrap gap-x-4 gap-y-1 mt-2";
    Object.entries(TYPE_COLORS).forEach(([type, color]) => {
      const span = document.createElement("span");
      span.className = "text-[10px] font-mono text-zinc-500 flex items-center gap-1";
      span.innerHTML = `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${color}"></span>${type}`;
      legendDiv.appendChild(span);
    });
    el.appendChild(legendDiv);
    }

  // Register with chartInit so ChartPreviewCard can force-init on expand
  registerChart("trailer-discovery-chart", init);

  // Also lazy-init via IntersectionObserver for directly-visible charts
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("trailer-discovery-chart");
    if (obsEl) {
      const obs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { triggerChart("trailer-discovery-chart"); obs.disconnect(); }
      }, { rootMargin: "10000px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
