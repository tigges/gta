---
/**
 * ChartEcoSharkCards
 * Economy chart extracted from gta-online/economy.astro.
 * Self-contained; D3 init deferred via IntersectionObserver.
 */
import revenueData from "../../../data/franchise/revenue-split.json";
import passiveData from "../../../data/gta-5/economy/passive-stack.json";
import CardFooter from "../CardFooter.astro";

const revYears      = (revenueData as any).years as any[];
const passiveSeries = (passiveData as any).series as any[];
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
  <div class="px-5 py-3 border-b border-[#1e1e23]">
    <div class="font-semibold text-zinc-200 text-sm">GTA Online Endgame Cost — Real USD 2013–2026</div>
    <div class="text-[10px] font-mono text-zinc-600 mt-0.5">Shark Card inflation · passive stack cost · purchasing power erosion</div>
  </div>
  <div id="chart-sharkcards" class="w-full" style="height:220px"
    data-years={JSON.stringify(revYears.filter((y:any) => y.calendar_year >= 2014))} data-series={JSON.stringify(passiveSeries)}
  ></div>
  <CardFooter chartId="chart-sharkcards" sources="Source: community data · updated nightly" shareText="GTA Online economy chart: GTA Online Endgame Cost — Real USD 2013–2026" />
</div>

<script>
  import * as d3 from "d3";
  import { cc, op } from "../../assets/chartColors";
  import { registerChart, triggerChart } from "../../assets/chartInit";

  const CHART_H: Record<string, number> = {
    "chart-wages": 220, "chart-spending": 220, "chart-savings": 220,
    "chart-sharkcards": 220, "chart-investment": 200, "chart-ppi": 280, "chart-health": 280,
  };
  function getDims(id: string, ml:number, mr:number, mt:number, mb:number) {
    const el = document.getElementById(id) as HTMLElement;
    const totalH = CHART_H[id] ?? 220;
    const totalW = el?.clientWidth || 600;
    const W = totalW - ml - mr;
    const H = totalH - mt - mb;
    return { el, W: Math.max(W,10), H: Math.max(H,10), totalW, totalH };
  }

  function init() {
    const {el,W,H,totalW,totalH}=getDims("chart-sharkcards",48,24,16,36);
    if(!el) return;
    const years:any[]=JSON.parse(el.dataset.years||"[]");
    const ml=48,mr=24,mt=16,mb=36;
    const svg=d3.select(el).append("svg").attr("width","100%").attr("viewBox",`0 0 ${totalW} ${totalH}`).append("g").attr("transform",`translate(${ml},${mt})`);
    const x=d3.scaleBand().domain(years.map(y=>String(y.calendar_year))).range([0,W]).padding(0.2);
    const yMax=(d3.max(years,(y:any)=>y.recurrent_bn)??2)*1.2;
    const y=d3.scaleLinear().domain([0,yMax]).range([H,0]);
    svg.append("g").call(d3.axisLeft(y).ticks(4).tickSize(-W).tickFormat(()=>""))
      .call(g=>g.select(".domain").remove()).call(g=>g.selectAll(".tick line").attr("stroke",cc.grid).attr("stroke-dasharray","3,3"));
    years.forEach((yr:any)=>{ const bx=x(String(yr.calendar_year))??0,bh=Math.max(0,H-y(yr.recurrent_bn)); svg.append("rect").attr("x",bx).attr("y",y(yr.recurrent_bn)).attr("width",x.bandwidth()).attr("height",bh).attr("rx",2).attr("fill",cc.indigo).attr("opacity",op.secondary); });
    const peak=years.reduce((a:any,b:any)=>b.recurrent_bn>a.recurrent_bn?b:a);
    const px=(x(String(peak.calendar_year))??0)+x.bandwidth()/2;
    svg.append("text").attr("x",px).attr("y",y(peak.recurrent_bn)-5).attr("text-anchor","middle").attr("fill",cc.indigo).attr("font-size","9").attr("font-family","monospace").attr("font-weight","bold").text(`$${peak.recurrent_bn}B`);
    svg.append("g").attr("transform",`translate(0,${H})`).call(d3.axisBottom(x).tickValues(years.filter((_:any,i:number)=>i%3===0).map((y:any)=>String(y.calendar_year))))
      .call(g=>g.select(".domain").attr("stroke",cc.border2)).call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace"));
    svg.append("g").call(d3.axisLeft(y).ticks(4).tickFormat((d:any)=>`$${+d}B`))
      .call(g=>g.select(".domain").remove()).call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill",cc.text6).attr("font-size","9").attr("font-family","monospace"));  }

  // Register with chartInit so ChartPreviewCard can force-init on expand
  registerChart("chart-sharkcards", init);

  // Also lazy-init via IntersectionObserver for directly-visible charts
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("chart-sharkcards");
    if (obsEl) {
      const obs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { triggerChart("chart-sharkcards"); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
