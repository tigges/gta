---
/**
 * ChartTeaserCpi — static CSS bar chart teaser for the GTA VI hub page.
 * Shows real-terms launch prices across franchise. No D3, no JS, always renders.
 */
import ShareDropdown from "../ShareDropdown.astro";
import ChartBadgeRow from "../ChartBadgeRow.astro";
import ReadItBlock   from "../ReadItBlock.astro";
import cpiData from "../../../data/franchise/cpi.json";

const base = (cpiData as any).base_cpi as number;
const titles = (cpiData as any).titles as any[];

// Compute real prices; skip GTA 1/2 (no price data)
const rows = titles
  .filter((t: any) => t.price_nominal && t.cpi_year && !["gta-1","gta-2"].includes(t.id))
  .map((t: any) => ({
    short:       t.short,
    id:          t.id,
    nominal:     t.price_nominal,
    real:        Math.round(t.price_nominal * base / t.cpi_year * 100) / 100,
    is_vi:       t.id === "gta-6",
  }));

const maxReal = Math.max(...rows.map((r: any) => r.real));
---

<div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
  <!-- Header -->
  <div class="px-5 py-4 border-b border-border-dim">
    <ChartBadgeRow game="franchise" category="CPI · Pricing" fullHref="/charts?title=gta-vi#section-cpi-chart" fullLabel="Full chart →" />
    <div class="font-semibold text-zinc-200 text-sm mb-0.5">
      GTA VI at $79.99 Is the Cheapest GTA at Launch — In Real Terms
    </div>
    <div class="text-[11px] text-zinc-500 font-mono">
      Adjusted for inflation via US CPI-U · all prices in {new Date().getFullYear()} dollars
    </div>
  </div>

  <!-- Bar chart -->
  <div class="px-5 py-4 flex flex-col gap-2.5">
    {rows.map((r: any) => {
      const pct = Math.round((r.real / maxReal) * 100);
      return (
        <div class="flex items-center gap-3">
          <!-- Label -->
          <span class={`text-[10px] font-mono w-14 shrink-0 text-right ${r.is_vi ? "text-gta-gold font-bold" : "text-zinc-500"}`}>
            {r.short}
          </span>

          <!-- Bar track -->
          <div class="flex-1 h-5 rounded overflow-hidden relative" style="background:var(--c-bg)">
            <!-- Real price bar -->
            <div
              class={`h-full rounded transition-all duration-700 ${r.is_vi ? "" : ""}`}
              style={`width:${pct}%;background:${r.is_vi ? "var(--c-brand)" : "var(--c-text-6)"};opacity:${r.is_vi ? "1" : "0.55"}`}
            ></div>
            <!-- Nominal price marker -->
            <div
              class="absolute top-0 bottom-0 w-0.5"
              style={`left:${Math.round((r.nominal / maxReal) * 100)}%;background:${r.is_vi ? "var(--c-brand)" : "var(--c-text-4)"};opacity:0.4`}
            ></div>
          </div>

          <!-- Real price value -->
          <span class={`text-[10px] font-mono w-14 shrink-0 ${r.is_vi ? "text-gta-gold font-bold" : "text-zinc-500"}`}>
            ${r.real.toFixed(2)}
            {r.is_vi && <span class="text-[9px] ml-0.5">★</span>}
          </span>
        </div>
      );
    })}
  </div>

  <!-- Key stat -->
  <div class="px-5 pb-4">
    <ReadItBlock
      accentColor="var(--c-brand)"
      intent="positive"
      href="/charts?title=gta-vi#section-cpi-chart"
      showPrefix={false}
    >
      GTA VI is <span class="text-gta-gold font-semibold">{Math.round((maxReal - rows.at(-1)!.real) / maxReal * 100)}% cheaper</span> than {rows[0].short} in real terms
    </ReadItBlock>
  </div>

  <div class="px-5 pb-3 flex items-center justify-between border-t border-border-dim pt-2.5">
    <span class="text-[10px] text-zinc-600 font-mono">Source: US Bureau of Labor Statistics CPI-U · Rockstar/Take-Two pricing</span>
    <div class="flex items-center gap-2 shrink-0">
      <span class="text-[10px] font-mono text-zinc-500 tracking-widest">GTAVI.AI</span>
      <ShareDropdown anchorId="section-cpi-chart" shareText="GTA VI at $79.99 is the cheapest GTA launch in real terms — CPI-adjusted price chart across all titles. GTAVI.AI" size="sm" />
    </div>
  </div>
</div>
