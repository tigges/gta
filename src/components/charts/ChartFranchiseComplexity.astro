---
/**
 * ChartFranchiseComplexity
 * Chart component extracted from charts.astro.
 * Can be embedded on any page; D3 init deferred via IntersectionObserver.
 */
import franchiseEconData from "../../../data/franchise/economic-history.json";
import CardFooter from "../CardFooter.astro";
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5">
              How GTA's Economy Got More Complex — Title by Title
            </div>
            <div class="text-[11px] text-zinc-500 font-mono">Complexity score (1–10) based on active economic mechanics: missions, passive income, property market, investment, multiplayer, microtransactions.</div>
          </div>
        </div>
        <div id="franchise-complexity-chart" class="w-full px-5 py-4"
          data-titles={JSON.stringify((franchiseEconData as any).titles.filter((t: any) => t.complexity_score !== null))}
        ></div>
        <CardFooter chartId="franchise-complexity-chart" sources="Source: curated research · GTAForums · GTA Fandom Wiki · complexity score = count of active economic mechanics" shareText="GTA" />
      </div>

<script>
  import { cc } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart, triggerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("franchise-complexity-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }

    const titles: any[] = JSON.parse(el.dataset.titles || "[]");
    if (!titles.length) return;

    const FEATURE_ICONS: Record<string,string> = {
      "mission_income":"Missions","passive_income":"Passive","property_market":"Property",
      "businesses":"Business","investment":"Investment","multiplayer_economy":"Multiplayer",
      "microtransactions":"Microtx",
    };

    const rowH = 52, labelW = 140;
    const margin = {top:8, right:80, bottom:8, left:labelW};
    const W = el.clientWidth - margin.left - margin.right;
    const H = titles.length * rowH + margin.top + margin.bottom;

    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${H}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);

    const x = d3.scaleLinear().domain([0,10]).range([0,W]);
    const MAX_SCORE = 10;

    titles.forEach((t:any, i:number) => {
      const y = i * rowH + 4;
      const score = t.complexity_score || 0;
      const barW = x(score);
      const isPeak = score === MAX_SCORE;
      const color = score >= 8 ? cc.bar : score >= 5 ? cc.teal : cc.text7;

      // Bar
      svg.append("rect").attr("x",0).attr("y",y).attr("width",barW).attr("height",rowH-12)
        .attr("rx",3).attr("fill",color).attr("opacity",0.75);

      // Score label
      svg.append("text").attr("x",barW+6).attr("y",y+(rowH-12)/2+4)
        .attr("fill",color).attr("font-size","13").attr("font-family","monospace").attr("font-weight","bold")
        .text(`${score}/10`);

      // Title label
      svg.append("text").attr("x",-8).attr("y",y+(rowH-12)/2+4).attr("text-anchor","end")
        .attr("fill", isPeak ? cc.bar : cc.text4).attr("font-size","11").attr("font-family","monospace")
        .text(t.short);

      // Feature dots
      if (t.complexity_breakdown) {
        const features = Object.entries(t.complexity_breakdown as Record<string,boolean>).filter(([,v])=>v);
        features.forEach(([key], fi) => {
          const dotX = fi * 70;
          svg.append("rect").attr("x",dotX).attr("y",y+rowH-12).attr("width",64).attr("height",10).attr("rx",2)
            .attr("fill",color).attr("opacity",0.2);
          svg.append("text").attr("x",dotX+32).attr("y",y+rowH-3).attr("text-anchor","middle")
            .attr("fill",color).attr("font-size","7").attr("font-family","monospace")
            .text(FEATURE_ICONS[key] || key);
        });
      }
    });
    }

  // Register with chartInit so ChartPreviewCard can force-init on expand
  registerChart("franchise-complexity-chart", init);

  // Also lazy-init via IntersectionObserver for directly-visible charts
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("franchise-complexity-chart");
    if (obsEl) {
      const obs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { triggerChart("franchise-complexity-chart"); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
