---
/**
 * ChartFranchiseSales
 * Chart component extracted from charts.astro.
 * Can be embedded on any page; D3 init deferred via IntersectionObserver.
 */
import salesData         from "../../../data/franchise/sales.json";
import ShareButton from "../ShareButton.astro";
---

    <section class="chart-block" data-category="Economy-RL">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[9px] font-mono bg-blue-900/30 text-blue-400 border border-blue-800/40 px-2 py-0.5 rounded uppercase tracking-widest">RL Economy</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA Franchise Sales Velocity</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-4">
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5" style="font-family:'Inter',sans-serif">
              Franchise Sales Velocity — GTA III to GTA VI
            </div>
            <div class="text-[11px] text-zinc-500 font-mono">Total units sold per title · launch week · year 1 where known</div>
          </div>
          <div class="flex items-center gap-4 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-gta-gold/80 inline-block"></span>Total</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-gta-teal/80 inline-block"></span>Year 1</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm border border-gta-gold/40 bg-gta-gold/10 inline-block"></span>Projected</span>
          </div>
        </div>
        <!-- Game cover + stat row -->
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-4 overflow-x-auto">
          {salesData.titles.map((t: any) => (
            <div class="flex items-center gap-2.5 shrink-0">
              <img src={`/assets/covers/${t.id}.jpg`} alt={t.short}
                class={`rounded object-cover border ${t.is_prediction ? "border-gta-gold/40 w-8 h-11" : "border-[#2a2a31] w-8 h-11"}`} loading="lazy" />
              <div>
                <div class={`text-[10px] font-mono font-bold ${t.is_prediction ? "text-gta-gold" : "text-zinc-300"}`}>{t.short}</div>
                <div class="text-[9px] font-mono text-zinc-600">{t.total_units_m ? `${t.total_units_m}M` : "projected"} · {t.year}</div>
              </div>
            </div>
          ))}
        </div>
        <div id="sales-chart" class="w-full" style="height:320px"
          data-titles={JSON.stringify(salesData.titles)}></div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between">
          <span class="text-[10px] text-zinc-700 font-mono">Sources: Take-Two IR · DFC Intelligence (GTA VI projection)</span>
          <span class="text-[10px] text-zinc-700 font-mono">{salesData.last_updated.slice(0,10)}</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA V sold 225M copies. Here's how every GTA title stacks up — franchise sales velocity charted." url="https://gtavi.ai/charts" size="sm" label="Share" /></div>
        </div>
      </div>

<script>
  import * as d3 from "d3";

  function init() {
    const el = document.getElementById("sales-chart") as HTMLElement | null;
    if (!el) return;

    const titles: any[] = JSON.parse(el.dataset.titles || "[]");

    const margin = { top: 20, right: 30, bottom: 80, left: 60 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg")
      .attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform", `translate(${margin.left},${margin.top})`);

    const x = d3.scaleBand()
      .domain(titles.map(t => t.short))
      .range([0, W]).padding(0.25);

    const maxVal = d3.max(titles, t => t.total_units_m ?? t.year1_units_m ?? 0) ?? 1;
    const y = d3.scaleLinear().domain([0, maxVal * 1.15]).range([H, 0]);

    // Grid
    svg.append("g")
      .call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(d => `${d}M`))
      .call(g => g.select(".domain").remove())
      .call(g => g.selectAll(".tick line").attr("stroke", "#1e1e23").attr("stroke-dasharray", "3,3"))
      .call(g => g.selectAll("text").attr("fill", "#52525b").attr("font-size", "11").attr("font-family", "monospace"));

    // Bars — total (background)
    titles.forEach(t => {
      const totalH = H - y(t.total_units_m ?? 0);
      const isPred = t.is_prediction;
      const bx = x(t.short) ?? 0;
      const bw = x.bandwidth();

      if (t.total_units_m) {
        svg.append("rect")
          .attr("x", bx).attr("y", y(t.total_units_m))
          .attr("width", bw).attr("height", totalH)
          .attr("rx", 3)
          .attr("fill", isPred ? "none" : "#f59e0b")
          .attr("fill-opacity", isPred ? 0 : 0.75)
          .attr("stroke", isPred ? "#f59e0b" : "none")
          .attr("stroke-width", isPred ? 1.5 : 0)
          .attr("stroke-dasharray", isPred ? "5,3" : "0");
      }

      // Year 1 overlay
      if (t.year1_units_m) {
        svg.append("rect")
          .attr("x", bx + bw * 0.1).attr("y", y(t.year1_units_m))
          .attr("width", bw * 0.8).attr("height", H - y(t.year1_units_m))
          .attr("rx", 2)
          .attr("fill", "#0d9488").attr("fill-opacity", isPred ? 0.5 : 0.85);
      }

      // Value label
      const labelVal = t.total_units_m ?? t.year1_units_m;
      if (labelVal) {
        svg.append("text")
          .attr("x", bx + bw / 2)
          .attr("y", y(labelVal) - 5)
          .attr("text-anchor", "middle")
          .attr("fill", isPred ? "#f59e0b" : "#a1a1aa")
          .attr("font-size", "11").attr("font-family", "monospace")
          .text(isPred ? `~${labelVal}M*` : `${labelVal}M`);
      }
    });

    // X axis — cover images instead of text labels
    const COVER_URLS: Record<string,string> = {
      "GTA 1":  "/assets/covers/gta-1.jpg",
      "GTA 2":  "/assets/covers/gta-2.jpg",
      "GTA III": "/assets/covers/gta-3.jpg",
      "GTA VC":  "/assets/covers/gta-vc.jpg",
      "GTA SA":  "/assets/covers/gta-sa.jpg",
      "GTA IV":  "/assets/covers/gta-4.jpg",
      "GTA V":   "/assets/covers/gta-5.jpg",
      "GTA VI":  "/assets/covers/gta-6.jpg",
    };

    const xAxisG = svg.append("g").attr("transform", `translate(0,${H})`);
    xAxisG.call(d3.axisBottom(x))
      .call(g => g.select(".domain").attr("stroke", "#2a2a31"))
      .call(g => g.selectAll(".tick line").remove())
      .call(g => g.selectAll("text").remove());

    // Add cover art images as tick marks
    const imgW = Math.min(x.bandwidth() * 0.75, 48);
    const imgH = Math.round(imgW * 1.4);
    titles.forEach(t => {
      const cx = (x(t.short) ?? 0) + x.bandwidth() / 2;
      const src = COVER_URLS[t.short];
      if (!src) return;
      xAxisG.append("image")
        .attr("href", src)
        .attr("x", cx - imgW / 2)
        .attr("y", 8)
        .attr("width", imgW)
        .attr("height", imgH)
        .attr("clip-path", `inset(0 round 4px)`)
        .style("border-radius", "4px");
      xAxisG.append("text")
        .attr("x", cx).attr("y", imgH + 22)
        .attr("text-anchor", "middle")
        .attr("fill", t.is_prediction ? "#f59e0b" : "#71717a")
        .attr("font-size", "10").attr("font-family", "monospace")
        .text(t.short);
    });

    // Increase bottom margin by extending chart area
    svg.attr("transform", `translate(${margin.left},${margin.top})`);
    }

  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("sales-chart");
    if (obsEl) new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { init(); }
    }, { rootMargin: "200px" }).observe(obsEl);
  } else { init(); }
</script>
