---
/**
 * ChartFranchiseSales
 * Chart component extracted from charts.astro.
 * Can be embedded on any page; D3 init deferred via IntersectionObserver.
 */
import salesData         from "../../../data/franchise/sales.json";
import CardFooter from "../CardFooter.astro";
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-4">
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5">
              Franchise Sales Velocity — GTA III to GTA VI
            </div>
            <div class="text-[11px] text-zinc-500 font-mono">Total units sold per title · launch week · year 1 where known</div>
          </div>
          <div class="flex items-center gap-4 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm inline-block" style="background:var(--c-brand)"></span>Total</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm inline-block" style="background:var(--c-live)"></span>Year 1</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm inline-block" style="border:1px dashed var(--c-brand);opacity:var(--o-tertiary)"></span>Est. Total (3–5yr)</span>
          </div>
        </div>
        <!-- Game cover + stat row -->
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-4 overflow-x-auto">
          {salesData.titles.map((t: any) => (
            <div class="flex items-center gap-2.5 shrink-0">
              <img src={`/assets/covers/${t.id}.jpg`} alt={t.short}
                class={`rounded object-cover border ${t.is_prediction ? "border-gta-gold/40 w-8 h-11" : "border-[#2a2a31] w-8 h-11"}`} loading="lazy" />
              <div>
                <div class={`text-[10px] font-mono font-bold ${t.is_prediction ? "text-gta-gold" : "text-zinc-300"}`}>{t.short}</div>
                <div class="text-[11px] font-mono text-zinc-600">{t.total_units_m ? `${t.total_units_m}M` : "projected"} · {t.year}</div>
              </div>
            </div>
          ))}
        </div>
        <div id="sales-chart" class="w-full" style="height:320px"
          data-titles={JSON.stringify(salesData.titles)}></div>
        <CardFooter chartId="sales-chart" sources="Sources: Take-Two IR · DFC Intelligence (GTA VI projection) · *GTA VI 3–5yr estimate: ~2× Year 1 · not official" shareText="GTA V sold 225M copies. Here's how every GTA title stacks up — franchise sales velocity charted." />
      </div>

<script>
  import { cc, op } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart, triggerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("sales-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }

    const titles: any[] = JSON.parse(el.dataset.titles || "[]");

    const margin = { top: 20, right: 30, bottom: 36, left: 60 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg")
      .attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform", `translate(${margin.left},${margin.top})`);

    const x = d3.scaleBand()
      .domain(titles.map(t => t.short))
      .range([0, W]).padding(0.25);

    const maxVal = d3.max(titles, t => t.total_units_m ?? t.year1_units_m ?? 0) ?? 1;
    const y = d3.scaleLinear().domain([0, maxVal * 1.15]).range([H, 0]);

    // Grid
    svg.append("g")
      .call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(d => `${d}M`))
      .call(g => g.select(".domain").remove())
      .call(g => g.selectAll(".tick line").attr("stroke", cc.grid).attr("stroke-dasharray", "3,3"))
      .call(g => g.selectAll("text").attr("fill", cc.text6).attr("font-size", "11").attr("font-family", "monospace"));

    // Bars — total (background)
    titles.forEach(t => {
      const totalH = H - y(t.total_units_m ?? 0);
      const isPred = t.is_prediction;
      const bx = x(t.short) ?? 0;
      const bw = x.bandwidth();

      if (t.total_units_m) {
        svg.append("rect")
          .attr("x", bx).attr("y", y(t.total_units_m))
          .attr("width", bw).attr("height", totalH)
          .attr("rx", 3)
          .attr("fill", isPred ? "none" : cc.bar)
          .attr("fill-opacity", isPred ? 0 : 0.75)
          .attr("stroke", isPred ? cc.bar : "none")
          .attr("stroke-width", isPred ? 1.5 : 0)
          .attr("stroke-dasharray", isPred ? "5,3" : "0");
      }

      // Year 1 overlay
      if (t.year1_units_m) {
        svg.append("rect")
          .attr("x", bx + bw * 0.1).attr("y", y(t.year1_units_m))
          .attr("width", bw * 0.8).attr("height", H - y(t.year1_units_m))
          .attr("rx", 2)
          .attr("fill", cc.teal).attr("fill-opacity", isPred ? 0.5 : 0.85);
      }

      // Value labels — show total above main bar, year1 above year1 bar when both present
      if (t.total_units_m) {
        svg.append("text")
          .attr("x", bx + bw / 2)
          .attr("y", y(t.total_units_m) - 5)
          .attr("text-anchor", "middle")
          .attr("fill", isPred ? cc.bar : cc.text4)
          .attr("font-size", "11").attr("font-family", "monospace")
          .text(isPred ? `~${t.total_units_m}M*` : `${t.total_units_m}M`);
      }
      // Year 1 label (only when both values present, to avoid duplicating the main label)
      if (t.year1_units_m && t.total_units_m && isPred) {
        svg.append("text")
          .attr("x", bx + bw / 2)
          .attr("y", y(t.year1_units_m) - 5)
          .attr("text-anchor", "middle")
          .attr("fill", cc.teal)
          .attr("font-size", "10").attr("font-family", "monospace")
          .attr("opacity",op.secondary)
          .text(`~${t.year1_units_m}M Y1`);
      } else if (t.year1_units_m && !t.total_units_m) {
        svg.append("text")
          .attr("x", bx + bw / 2)
          .attr("y", y(t.year1_units_m) - 5)
          .attr("text-anchor", "middle")
          .attr("fill", isPred ? cc.bar : cc.text4)
          .attr("font-size", "11").attr("font-family", "monospace")
          .text(isPred ? `~${t.year1_units_m}M*` : `${t.year1_units_m}M`);
      }
    });

    // X axis — text labels
    const xAxisG = svg.append("g").attr("transform", `translate(0,${H})`);
    xAxisG.call(d3.axisBottom(x))
      .call(g => g.select(".domain").attr("stroke", cc.border2))
      .call(g => g.selectAll(".tick line").remove())
      .call(g => g.selectAll("text").remove());

    titles.forEach(t => {
      const cx = (x(t.short) ?? 0) + x.bandwidth() / 2;
      const imgW = 0, imgH = 0;  // no images — keep variable for compat
      xAxisG.append("text")
        .attr("x", cx).attr("y", imgH + 22)
        .attr("text-anchor", "middle")
        .attr("fill", t.is_prediction ? cc.bar : cc.text4)
        .attr("font-size", "10").attr("font-family", "monospace")
        .text(t.short);
    });

    // Increase bottom margin by extending chart area
    svg.attr("transform", `translate(${margin.left},${margin.top})`);
    }

  // Register with chartInit so ChartPreviewCard can force-init on expand
  registerChart("sales-chart", init);

  // Also lazy-init via IntersectionObserver for directly-visible charts
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("sales-chart");
    if (obsEl) {
      const obs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { triggerChart("sales-chart"); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
