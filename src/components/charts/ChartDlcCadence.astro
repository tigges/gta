---
/**
 * ChartDlcCadence
 * Extracted from charts.astro.
 */
import dlcData from "../../../data/gta-5/dlc/timeline.json";
import velocityData from "../../../data/gta-6/trailer-velocity.json";
import CardFooter from "../CardFooter.astro";
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">

        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm mb-0.5">
            How Long Between Each GTA Online Major Update — and What It Predicts for GTA VI
          </div>
          <div class="text-[11px] text-zinc-500 font-mono">Gap in months between each major GTA Online content drop, 2013–2024. Projected first VI Online updates based on pattern.</div>
        </div>
        <div id="dlc-cadence-chart" class="w-full" style="height:300px"
          data-dlc={JSON.stringify(dlcData.updates.filter((u: any) => u.category === "major" || u.category === "launch"))}
        ></div>
        <CardFooter chartId="dlc-cadence-chart" sources="Source: Rockstar Games official announcements · GTA Online update history 2013–2024" shareText="GTA Online had 38 major content drops over 11 years. Here" />
      </div>

<script>
  import { cc } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart, triggerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("dlc-cadence-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }
    const dlcs: any[] = JSON.parse(el.dataset.dlc || "[]");

    // Calculate gaps in months between consecutive major updates
    const gaps: {name:string;date:string;gap:number;isPred:boolean}[] = [];
    for (let i = 1; i < dlcs.length; i++) {
      const prev = new Date(dlcs[i-1].date);
      const curr = new Date(dlcs[i].date);
      const gapMonths = Math.round((curr.getTime() - prev.getTime()) / (1000*60*60*24*30.44));
      gaps.push({ name: dlcs[i].label, date: dlcs[i].date, gap: gapMonths, isPred: false });
    }

    // Add GTA VI Online prediction points based on avg pattern
    const avgGap = gaps.reduce((s,g) => s + g.gap, 0) / gaps.length;
    const launchDate = new Date("2026-11-19");
    [3, 7, 13].forEach((mo, i) => {
      const d = new Date(launchDate);
      d.setMonth(d.getMonth() + mo);
      gaps.push({ name: `VI DLC ${i+1}`, date: d.toISOString().slice(0,10), gap: mo === 3 ? Math.round(avgGap*0.8) : Math.round(avgGap), isPred: true });
    });

    const margin = { top: 16, right: 24, bottom: 64, left: 44 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;
    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);

    const x = d3.scaleBand().domain(gaps.map((_,i)=>String(i))).range([0,W]).padding(0.15);
    const maxGap = d3.max(gaps, d => d.gap) ?? 1;
    const y = d3.scaleLinear().domain([0, maxGap * 1.15]).range([H,0]);

    // Average line
    svg.append("line").attr("x1",0).attr("x2",W).attr("y1",y(avgGap)).attr("y2",y(avgGap))
      .attr("stroke",cc.text6).attr("stroke-width",1).attr("stroke-dasharray","4,3").attr("opacity",0.5);
    svg.append("text").attr("x",4).attr("y",y(avgGap)-4)
      .attr("fill",cc.text6).attr("font-size","8").attr("font-family","monospace")
      .text(`avg: ${avgGap.toFixed(1)}mo`);

    // GTA VI divider
    const viStartIdx = gaps.findIndex(g => g.isPred);
    if (viStartIdx > 0) {
      const divX = (x(String(viStartIdx)) ?? 0) - x.bandwidth()*0.3;
      svg.append("line").attr("x1",divX).attr("x2",divX).attr("y1",0).attr("y2",H)
        .attr("stroke",cc.bar).attr("stroke-width",1).attr("stroke-dasharray","3,3").attr("opacity",0.4);
      svg.append("text").attr("x",divX+4).attr("y",10)
        .attr("fill",cc.bar).attr("font-size","8").attr("font-family","monospace").text("GTA VI →");
    }

    gaps.forEach((g, i) => {
      const bx = x(String(i)) ?? 0, bw = x.bandwidth();
      svg.append("rect").attr("x",bx).attr("y",y(g.gap))
        .attr("width",bw).attr("height",H-y(g.gap)).attr("rx",2)
        .attr("fill", g.isPred?"none":cc.text7)
        .attr("stroke", g.isPred?cc.bar:"none").attr("stroke-width",1).attr("stroke-dasharray",g.isPred?"5,3":"0")
        .attr("opacity",0.8);
      svg.append("text").attr("x",bx+bw/2).attr("y",y(g.gap)-4)
        .attr("text-anchor","middle")
        .attr("fill",g.isPred?cc.bar:cc.text4)
        .attr("font-size","8").attr("font-family","monospace")
        .text(`${g.gap}mo`);
      // Label every 4th + VI ones
      if (i % 4 === 0 || g.isPred) {
        svg.append("text").attr("x",bx+bw/2).attr("y",H+14)
          .attr("text-anchor","middle").attr("transform",`rotate(-45,${bx+bw/2},${H+14})`)
          .attr("fill",g.isPred?cc.bar:cc.text6).attr("font-size","8").attr("font-family","monospace")
          .text(g.isPred?g.name:g.date.slice(0,7));
      }
    });

    svg.append("g").call(d3.axisLeft(y).ticks(5).tickFormat(d=>`${d}mo`))
      .call(g=>g.select(".domain").attr("stroke",cc.border2))
      .call(g=>g.selectAll(".tick line").attr("stroke",cc.border2))
      .call(g=>g.selectAll("text").attr("fill",cc.text6).attr("font-size","10").attr("font-family","monospace"));  }

  registerChart("dlc-cadence-chart", init);
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("dlc-cadence-chart");
    if (obsEl) {
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) { triggerChart("dlc-cadence-chart"); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
