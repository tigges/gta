---
/**
 * ChartHeistComparison
 * Extracted from charts.astro.
 */
import heistsData from "../../../data/gta-5/economy/online-heists.json";
import ShareButton from "../ShareButton.astro";
---

<section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono bg-gta-gold/30 text-gta-gold border border-gta-gold/40 px-2 py-0.5 rounded uppercase tracking-widest">IG Economy</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Heist Comparison — $/hr vs Setup Cost vs Run Time</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-500">{(heistsData as any).heists.length} heists</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5">GTA Online Heist Comparison — All Heists by $/hr and Setup Cost</div>
            <div class="text-[11px] text-zinc-500 font-mono">X = setup cost required · Y = GTA$/hr · bubble size = average run time. Top-right = expensive but fast. Gold = soloable.</div>
          </div>
          <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block bg-gta-gold opacity-80"></span>Solo</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block bg-gta-teal opacity-80"></span>Group</span>
            <span class="flex items-center gap-1.5"><span class="text-zinc-600">◉</span> = longer run</span>
          </div>
        </div>
        <div id="heist-comparison-chart" class="w-full" style="height:320px"
          data-heists={JSON.stringify((heistsData as any).heists)}
        ></div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-500 font-mono">Source: GTA Wiki · GTABase.com · community records · 2024 patches · Hard difficulty</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="All GTA Online heists compared: Cayo Perico wins on $/hr despite being solo. Casino Heist is the best group heist. Data-driven answer to which heist is worth doing." url="https://gtavi.ai/charts#heist-comparison-chart" size="sm" label="Share" /></div>
        </div>
      </div>

<script>
  import { cc } from "../../assets/chartColors";

  import * as d3 from "d3";
  import { registerChart } from "../../assets/chartInit";

  function init() {
    const el = document.getElementById("heist-comparison-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }
    const heists: any[] = JSON.parse(el.dataset.heists || "[]");
    if (!heists.length) return;

    const margin = { top: 24, right: 24, bottom: 52, left: 72 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg").attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform", `translate(${margin.left},${margin.top})`);

    const maxSetup = (d3.max(heists, (h: any) => h.setup_cost) ?? 1) as number;
    const maxGph = (d3.max(heists, (h: any) => h.gta_per_hr) ?? 1) as number;
    const x = d3.scaleLinear().domain([0, maxSetup * 1.1]).range([0, W]);
    const y = d3.scaleLinear().domain([0, maxGph * 1.15]).range([H, 0]);
    const rScale = d3.scaleSqrt().domain([0, (d3.max(heists, (h: any) => h.avg_run_time_min) ?? 1) as number]).range([8, 28]);

    // Grid
    svg.append("g").call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(() => ""))
      .call(g => g.select(".domain").remove())
      .call(g => g.selectAll(".tick line").attr("stroke", cc.grid).attr("stroke-dasharray", "3,3"));

    heists.forEach((h: any) => {
      const cx = x(h.setup_cost), cy = y(h.gta_per_hr);
      const r = rScale(h.avg_run_time_min || 30);
      const col = h.solo ? cc.bar : cc.teal;
      svg.append("circle").attr("cx", cx).attr("cy", cy).attr("r", r)
        .attr("fill", col).attr("opacity", 0.65).attr("stroke", col).attr("stroke-width", 1.5).attr("stroke-opacity", 0.9);
      const title = (h.title as string).replace("The ", "").replace(" Heist", "").slice(0, 16);
      svg.append("text").attr("x", cx).attr("y", cy - r - 4).attr("text-anchor", "middle")
        .attr("fill", cc.text3).attr("font-size", "8.5").attr("font-family", "monospace").text(title);
      // $/hr label inside bubble
      const gphLabel = `$${Math.round(h.gta_per_hr / 1000)}k`;
      svg.append("text").attr("x", cx).attr("y", cy + 4).attr("text-anchor", "middle")
        .attr("fill", cc.text0).attr("font-size", "9").attr("font-family", "monospace").attr("font-weight", "bold")
        .text(gphLabel);
    });

    // Axes
    svg.append("g").attr("transform", `translate(0,${H})`)
      .call(d3.axisBottom(x).ticks(5).tickFormat((d: any) => `$${(+d / 1e6).toFixed(1)}M`))
      .call(g => g.select(".domain").attr("stroke", cc.border2))
      .call(g => g.selectAll(".tick line").attr("stroke", cc.border2))
      .call(g => g.selectAll("text").attr("fill", cc.text6).attr("font-size", "9").attr("font-family", "monospace"));
    svg.append("g").call(d3.axisLeft(y).ticks(5).tickFormat((d: any) => `$${Math.round(+d / 1000)}k`))
      .call(g => g.select(".domain").remove()).call(g => g.selectAll(".tick line").remove())
      .call(g => g.selectAll("text").attr("fill", cc.text6).attr("font-size", "9").attr("font-family", "monospace"));
    svg.append("text").attr("x", W / 2).attr("y", H + 42).attr("text-anchor", "middle")
      .attr("fill", cc.text6).attr("font-size", "9").attr("font-family", "monospace").text("Setup Cost ($) · bubble size = avg run time");
    svg.append("text").attr("transform", "rotate(-90)").attr("x", -H / 2).attr("y", -58).attr("text-anchor", "middle")
      .attr("fill", cc.text6).attr("font-size", "9").attr("font-family", "monospace").text("GTA$/hr");  }

  registerChart("heist-comparison-chart", init);
  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("heist-comparison-chart");
    if (obsEl) {
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) { init(); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
