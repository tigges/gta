---
import releaseData from "../../data/shared/releases.json";

const games = releaseData.games;
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
  <div class="px-5 py-4 border-b border-[#1e1e23]">
    <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em]">// GTA Release History</div>
    <p class="text-[11px] text-zinc-600 mt-1" style="font-family:'Inter',sans-serif">Time between mainline entries — gap trend extrapolated to VI</p>
  </div>

  <div class="relative p-5">
    <!-- Vertical spine -->
    <div class="absolute left-[4.5rem] top-5 bottom-5 w-px bg-[#1e1e23]"></div>

    <div class="flex flex-col gap-0">
      {games.map((game, i) => {
        const isPred = game.is_prediction;
        const year = game.release_year ?? (game as any).release_date_estimate ?? "TBC";
        const gap = game.gap_years_from_prev ?? (game as any).gap_years_from_prev_estimate;
        const vehicles = game.vehicle_count ?? (game as any).vehicle_count_estimate;
        const mapSize = game.map_size_km2 ?? (game as any).map_size_km2_estimate;

        return (
          <div class="relative flex items-start gap-4 group pb-7 last:pb-0">
            <!-- Year label -->
            <div class="w-14 shrink-0 text-right pt-0.5">
              <span class={`text-[11px] font-mono font-bold ${isPred ? "text-gta-gold" : "text-zinc-500"}`}>
                {year}{isPred ? "?" : ""}
              </span>
            </div>

            <!-- Dot -->
            <div class="relative z-10 mt-1 shrink-0">
              <div class={`w-2.5 h-2.5 rounded-full border ${
                isPred
                  ? "border-gta-gold bg-gta-gold/20"
                  : "border-[#2a2a31] bg-[#131316] group-hover:border-gta-gold/50"
              } transition-colors`}></div>
            </div>

            <!-- Content -->
            <div class="flex-1 min-w-0">
              <div class="flex items-baseline gap-2 flex-wrap">
                <span class={`font-mono font-semibold text-sm ${isPred ? "text-gta-gold" : "text-zinc-200"}`}>
                  {game.short}
                </span>
                {isPred && (
                  <span class="text-[9px] font-mono bg-gta-gold/10 text-gta-gold/70 border border-gta-gold/15 px-1.5 py-0.5 rounded uppercase tracking-widest">
                    est
                  </span>
                )}
                {gap && (
                  <span class="text-[10px] font-mono text-zinc-600">+{gap}yr</span>
                )}
              </div>
              <div class="flex flex-wrap gap-x-3 gap-y-0.5 mt-0.5">
                {vehicles && (
                  <span class="text-[11px] text-zinc-600 font-mono">{vehicles}{isPred ? "~" : ""} vehicles</span>
                )}
                {mapSize && (
                  <span class="text-[11px] text-zinc-600 font-mono">{mapSize}{isPred ? "~" : ""} km²</span>
                )}
                {(game as any).trailer_youtube_id && (
                  <a href={`https://www.youtube.com/watch?v=${(game as any).trailer_youtube_id}`}
                    target="_blank" rel="noopener noreferrer"
                    class="text-[11px] font-mono text-zinc-700 hover:text-gta-gold transition-colors">▶ Trailer</a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Gap trend chart -->
  <div class="mt-4 pt-4 border-t border-[#1e1e23]">
    <p class="text-[10px] font-mono text-zinc-600 mb-3 uppercase tracking-[0.2em]">Release gap (years)</p>
    <div id="gap-chart" class="w-full h-24" data-games={JSON.stringify(
      games.filter((g) => (g.gap_years_from_prev ?? (g as any).gap_years_from_prev_estimate) != null)
        .map((g) => ({
          short: g.short,
          gap: g.gap_years_from_prev ?? (g as any).gap_years_from_prev_estimate,
          isPred: g.is_prediction,
        }))
    )}></div>
  </div>
  </div>
</div>

<script>
  import * as d3 from "d3";

  document.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById("gap-chart");
    if (!el) return;

    const data: { short: string; gap: number; isPred: boolean }[] = JSON.parse(el.dataset.games || "[]");

    const margin = { top: 4, right: 8, bottom: 24, left: 8 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg")
      .attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g")
      .attr("transform", `translate(${margin.left},${margin.top})`);

    const x = d3.scaleBand().domain(data.map((d) => d.short)).range([0, W]).padding(0.25);
    const y = d3.scaleLinear().domain([0, (d3.max(data, (d) => d.gap) ?? 15) * 1.15]).range([H, 0]);

    data.forEach((d) => {
      svg.append("rect")
        .attr("x", x(d.short) ?? 0)
        .attr("y", y(d.gap))
        .attr("width", x.bandwidth())
        .attr("height", H - y(d.gap))
        .attr("rx", 2)
        .attr("fill", d.isPred ? "#f59e0b" : "#27272a")
        .attr("opacity", d.isPred ? 0.85 : 0.7);

      svg.append("text")
        .attr("x", (x(d.short) ?? 0) + x.bandwidth() / 2)
        .attr("y", H + 14)
        .attr("text-anchor", "middle")
        .attr("fill", "#52525b")
        .attr("font-size", "9")
        .attr("font-family", "monospace")
        .text(d.short);

      svg.append("text")
        .attr("x", (x(d.short) ?? 0) + x.bandwidth() / 2)
        .attr("y", y(d.gap) - 3)
        .attr("text-anchor", "middle")
        .attr("fill", d.isPred ? "#f59e0b" : "#52525b")
        .attr("font-size", "9")
        .attr("font-family", "monospace")
        .text(`${d.gap}yr`);
    });
  });
</script>
