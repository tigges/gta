---
import releaseData from "../../data/history/releases.json";

const games = releaseData.games;
---

<div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
  <div class="mb-5">
    <h3 class="font-mono font-semibold text-zinc-50 text-sm uppercase tracking-wider">
      GTA Release History
    </h3>
    <p class="text-xs text-zinc-500 mt-0.5">Time between mainline entries — gap trend extrapolated to VI</p>
  </div>

  <div class="relative">
    <!-- Vertical spine -->
    <div class="absolute left-16 top-0 bottom-0 w-px bg-zinc-800"></div>

    <div class="flex flex-col gap-0">
      {games.map((game, i) => {
        const isPred = game.is_prediction;
        const year = game.release_year ?? (game as any).release_date_estimate ?? "TBC";
        const gap = game.gap_years_from_prev ?? (game as any).gap_years_from_prev_estimate;
        const vehicles = game.vehicle_count ?? (game as any).vehicle_count_estimate;
        const mapSize = game.map_size_km2 ?? (game as any).map_size_km2_estimate;

        return (
          <div class="relative flex items-start gap-4 group pb-8 last:pb-0">
            <!-- Year label -->
            <div class="w-14 shrink-0 text-right">
              <span class={`text-xs font-mono font-bold ${isPred ? "text-amber-500" : "text-zinc-400"}`}>
                {year}{isPred ? "?" : ""}
              </span>
            </div>

            <!-- Dot -->
            <div class="relative z-10 mt-0.5 shrink-0">
              <div
                class={`w-3 h-3 rounded-full border-2 ${
                  isPred
                    ? "border-amber-500 bg-amber-500/20"
                    : "border-zinc-600 bg-zinc-900 group-hover:border-amber-500"
                } transition-colors`}
              ></div>
            </div>

            <!-- Content -->
            <div class="flex-1 min-w-0 pt-0">
              <div class="flex items-baseline gap-2 flex-wrap">
                <span class={`font-mono font-semibold text-sm ${isPred ? "text-amber-400" : "text-zinc-200"}`}>
                  {game.short}
                </span>
                {isPred && (
                  <span class="text-xs font-mono bg-amber-500/10 text-amber-500 border border-amber-500/20 px-1.5 py-0.5 rounded">
                    prediction
                  </span>
                )}
                {gap && (
                  <span class="text-xs font-mono text-zinc-600">
                    +{gap}yr gap
                  </span>
                )}
              </div>

              <div class="flex flex-wrap gap-x-4 gap-y-0.5 mt-1">
                {vehicles && (
                  <span class="text-xs text-zinc-500 font-mono">
                    {vehicles}{isPred ? "~ " : " "}vehicles
                  </span>
                )}
                {mapSize && (
                  <span class="text-xs text-zinc-500 font-mono">
                    {mapSize}{isPred ? "~ " : ""}km²
                  </span>
                )}
                {(game as any).trailer_youtube_id && (
                  <a
                    href={`https://www.youtube.com/watch?v=${(game as any).trailer_youtube_id}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-mono text-zinc-600 hover:text-amber-500 transition-colors"
                  >
                    ▶ Trailer
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Gap trend chart -->
  <div class="mt-6 pt-5 border-t border-zinc-800">
    <p class="text-xs font-mono text-zinc-600 mb-3 uppercase tracking-wider">Gap between mainline releases</p>
    <div id="gap-chart" class="w-full h-24" data-games={JSON.stringify(
      games.filter((g) => (g.gap_years_from_prev ?? (g as any).gap_years_from_prev_estimate) != null)
        .map((g) => ({
          short: g.short,
          gap: g.gap_years_from_prev ?? (g as any).gap_years_from_prev_estimate,
          isPred: g.is_prediction,
        }))
    )}></div>
  </div>
</div>

<script>
  import * as d3 from "d3";

  document.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById("gap-chart");
    if (!el) return;

    const data: { short: string; gap: number; isPred: boolean }[] = JSON.parse(el.dataset.games || "[]");

    const margin = { top: 4, right: 8, bottom: 24, left: 8 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg")
      .attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g")
      .attr("transform", `translate(${margin.left},${margin.top})`);

    const x = d3.scaleBand().domain(data.map((d) => d.short)).range([0, W]).padding(0.25);
    const y = d3.scaleLinear().domain([0, (d3.max(data, (d) => d.gap) ?? 15) * 1.15]).range([H, 0]);

    data.forEach((d) => {
      svg.append("rect")
        .attr("x", x(d.short) ?? 0)
        .attr("y", y(d.gap))
        .attr("width", x.bandwidth())
        .attr("height", H - y(d.gap))
        .attr("rx", 2)
        .attr("fill", d.isPred ? "#f59e0b" : "#3f3f46")
        .attr("opacity", d.isPred ? 0.8 : 0.6);

      svg.append("text")
        .attr("x", (x(d.short) ?? 0) + x.bandwidth() / 2)
        .attr("y", H + 14)
        .attr("text-anchor", "middle")
        .attr("fill", "#71717a")
        .attr("font-size", "9")
        .attr("font-family", "monospace")
        .text(d.short);

      svg.append("text")
        .attr("x", (x(d.short) ?? 0) + x.bandwidth() / 2)
        .attr("y", y(d.gap) - 3)
        .attr("text-anchor", "middle")
        .attr("fill", d.isPred ? "#f59e0b" : "#71717a")
        .attr("font-size", "9")
        .attr("font-family", "monospace")
        .text(`${d.gap}yr`);
    });
  });
</script>
