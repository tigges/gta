---
/**
 * EconomyCircle.astro — GTA circular economy diagram v5.
 *
 * - INJECTION as big header, Rockstar as subtitle
 * - Y / INCOME same visual weight; C+I / EXPENDITURE same
 * - Icons: large 64px blip circles, 30px icons — immediately visible
 * - No left border on income box (cards below already carry green)
 * - C and I sections properly sized and vertically proportioned
 * - Formula tiny in footer
 */
import HudIcon from "./HudIcon.astro";
import GamePill from "./GamePill.astro";

interface Props {
  game?: "gta-vi" | "gta-online" | "gta-v" | "gta-sa" | "gta-vc" | "gta-iv" | "gta-iii" | "franchise";
  fullEconomyHref?: string;
}

const { game = "gta-online", fullEconomyHref } = Astro.props;
---

<div class="w-full rounded-xl border border-[#1e1e23] overflow-hidden" style="background:var(--c-card)">

  <!-- ── INJECTION — top section, centred ────────────────────────────── -->
  <div class="relative border-b border-[#1e1e23]" style="background:rgba(0,212,232,0.05)">
    <div class="flex flex-col items-center gap-2 py-4">
      <!-- Sub-label: Rockstar -->
      <span class="text-[10px] font-mono uppercase tracking-[0.3em]" style="color:var(--c-title-online);opacity:0.6">Rockstar</span>
      <!-- Main title: INJECTION -->
      <span class="text-3xl font-mono font-black leading-none" style="color:var(--c-title-online)">INJECTION</span>
      <!-- Icons + down arrow -->
      <div class="flex items-center gap-10 mt-1">
        <div class="flex flex-col items-center gap-1.5" style="opacity:0.45">
          <div class="blip-lg" style="--blip-col:var(--c-title-online,#00d4e8)">
            <HudIcon name="shark-card" size={28} style="color:#fff" />
          </div>
          <span class="text-[9px] font-mono" style="color:var(--c-title-online)">Shark Card</span>
        </div>

        <div class="flex flex-col items-center gap-1">
          <span class="text-2xl font-mono font-black" style="color:var(--c-title-online)">J</span>
          <span class="text-base font-bold" style="color:var(--c-title-online)">&#8595;</span>
        </div>

        <div class="flex flex-col items-center gap-1.5" style="opacity:0.45">
          <div class="blip-lg" style="--blip-col:var(--c-title-online,#00d4e8)">
            <HudIcon name="subscription" size={28} style="color:#fff" />
          </div>
          <span class="text-[9px] font-mono" style="color:var(--c-title-online)">GTA+</span>
        </div>
      </div>
    </div>
    <span class="absolute right-3 top-3 text-[8px] font-mono" style="color:var(--c-text-6)">&#42; GTA Online only</span>
  </div>

  <!-- ── Main three-column ───────────────────────────────────────────── -->
  <div class="main-grid">

    <!-- LEFT: Y — INCOME -->
    <div class="income-box p-5 flex flex-col gap-5">
      <!-- Header: Y + INCOME at same weight -->
      <div class="flex items-baseline gap-3">
        <span class="text-5xl font-mono font-black leading-none" style="color:var(--c-growth,#22c55e)">Y</span>
        <span class="text-3xl font-mono font-black leading-none" style="color:var(--c-growth,#22c55e)">INCOME</span>
      </div>

      <!-- Large icon blips -->
      <div class="flex items-center gap-4">
        <div class="flex flex-col items-center gap-1.5">
          <div class="blip-lg" style="--blip-col:var(--c-live,#0d9488)">
            <HudIcon name="mission" size={30} style="color:#fff" />
          </div>
          <span class="text-[9px] font-mono" style="color:var(--c-live);opacity:0.8">Missions</span>
        </div>
        <div class="flex flex-col items-center gap-1.5">
          <div class="blip-lg" style="--blip-col:var(--c-growth,#22c55e)">
            <HudIcon name="passive" size={30} style="color:#fff" />
          </div>
          <span class="text-[9px] font-mono" style="color:var(--c-growth);opacity:0.8">Passive</span>
        </div>
        <div class="flex flex-col items-center gap-1.5">
          <div class="blip-lg" style="--blip-col:var(--c-growth,#22c55e)">
            <HudIcon name="cycle" size={30} style="color:#fff" />
          </div>
          <span class="text-[9px] font-mono" style="color:var(--c-growth);opacity:0.8">Cycles</span>
        </div>
      </div>

      <!-- Caption -->
      <div class="mt-auto text-[9px] font-mono uppercase tracking-widest" style="color:var(--c-income,#0d9488)">
        Y grows &#8594; next cycle
      </div>
    </div>

    <!-- CENTRE: circle + arrows -->
    <div class="centre-col">
      <span class="arrow-green">&#8594;</span>

      <div class="relative circle-wrapper">
        <!-- Conic ring with aligned colours + directional arrows -->
        <div class="circle-ring"></div>

        <!-- Flow arrows at transition points on the ring -->
        <!-- Top-left: income → balance (green ▶) -->
        <span class="ring-arrow" style="top:14px;left:18px;color:#22c55e;transform:rotate(-35deg)">&#9658;</span>
        <!-- Top-right: injection → expenditure (blue ▶) -->
        <span class="ring-arrow" style="top:14px;right:18px;color:#00d4e8;transform:rotate(35deg)">&#9658;</span>
        <!-- Bottom-right: investment circling (purple ▶) -->
        <span class="ring-arrow" style="bottom:14px;right:18px;color:#818cf8;transform:rotate(145deg)">&#9658;</span>
        <!-- Bottom-left: return to income (purple→green ▶) -->
        <span class="ring-arrow" style="bottom:14px;left:18px;color:#818cf8;transform:rotate(-145deg)">&#9658;</span>

        <!-- Centre disc: Balance / Maze Bank -->
        <div class="circle-centre">
          <HudIcon name="bank" size={30} style="color:var(--c-title-online,#00d4e8)" />
          <span class="text-[11px] font-mono font-black leading-tight" style="color:var(--c-title-online,#00d4e8)">GTA$</span>
          <HudIcon name="dollar" size={14} style="color:var(--c-title-online,#00d4e8);opacity:0.45" />
        </div>

        <div class="circle-return">
          <span class="text-[8px] font-mono uppercase tracking-widest" style="color:var(--c-economy,#818cf8);opacity:0.7">I &#8594; Y</span>
        </div>
      </div>

      <span class="arrow-orange">&#8594;</span>
    </div>

    <!-- RIGHT: C+I — two vertical columns (C left | I right) -->
    <div class="expend-box flex flex-col">
      <!-- Shared header -->
      <div class="flex items-baseline gap-3 p-5 pb-3 border-b border-[#1e1e23]">
        <span class="text-5xl font-mono font-black leading-none" style="color:var(--c-flow-spending,#f97316)">C+I</span>
        <span class="text-xl font-mono font-black leading-none" style="color:var(--c-flow-spending,#f97316)">EXPEND.</span>
      </div>

      <!-- Two-column split: C | I -->
      <div class="flex flex-1">

        <!-- C — Consumption (left column, orange) -->
        <div class="flex flex-col gap-3 p-4 flex-1 ci-col-c">
          <span class="text-[11px] font-mono font-bold uppercase tracking-widest" style="color:var(--c-flow-spending,#f97316)">C</span>
          <span class="text-[9px] font-mono uppercase tracking-widest" style="color:var(--c-flow-spending);opacity:0.7">Consumption</span>
          <div class="flex flex-col gap-3">
            <div class="flex flex-col items-center gap-1.5">
              <div class="blip-lg" style="--blip-col:var(--c-flow-spending,#f97316)">
                <HudIcon name="clothing" size={28} style="color:#fff" />
              </div>
              <span class="text-[8px] font-mono" style="color:var(--c-flow-spending);opacity:0.8">Clothing</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <div class="blip-lg" style="--blip-col:var(--c-flow-spending,#f97316)">
                <HudIcon name="ammo" size={28} style="color:#fff" />
              </div>
              <span class="text-[8px] font-mono" style="color:var(--c-flow-spending);opacity:0.8">Ammo</span>
            </div>
          </div>
          <div class="mt-auto text-[8px] font-mono leading-snug" style="color:var(--c-flow-spending);opacity:0.5">
            Services<br/>Clothes
          </div>
        </div>

        <!-- Vertical divider -->
        <div class="w-px self-stretch" style="background:rgba(129,140,248,0.2)"></div>

        <!-- I — Investment (right column, purple) -->
        <div class="flex flex-col gap-3 p-4 flex-1 ci-col-i">
          <span class="text-[11px] font-mono font-bold uppercase tracking-widest" style="color:var(--c-economy,#818cf8)">I</span>
          <span class="text-[9px] font-mono uppercase tracking-widest" style="color:var(--c-economy);opacity:0.7">Investment</span>
          <div class="flex flex-col gap-3">
            <div class="flex flex-col items-center gap-1.5">
              <div class="blip-lg" style="--blip-col:var(--c-economy,#818cf8)">
                <HudIcon name="property" size={28} style="color:#fff" />
              </div>
              <span class="text-[8px] font-mono" style="color:var(--c-economy);opacity:0.8">Property</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <div class="blip-lg" style="--blip-col:var(--c-economy,#818cf8)">
                <HudIcon name="briefcase" size={28} style="color:#fff" />
              </div>
              <span class="text-[8px] font-mono" style="color:var(--c-economy);opacity:0.8">Business</span>
            </div>
          </div>
          <div class="mt-auto text-[8px] font-mono leading-snug" style="color:var(--c-economy);opacity:0.5">
            I returns<br/>to Y &#8594;
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- ── Footer ─────────────────────────────────────────────────────── -->
  <div class="flex items-center justify-between px-5 py-2.5 border-t border-[#1e1e23]">
    <div class="flex items-center gap-3">
      <GamePill {game} size="xs" />
      <span class="text-[8px] font-mono opacity-40" style="color:var(--c-text-4)">(Y + J) = C + I</span>
    </div>
    {fullEconomyHref && (
      <a href={fullEconomyHref}
         class="text-[10px] font-mono uppercase tracking-widest transition-colors"
         style="color:var(--c-brand);opacity:var(--o-secondary)"
         onmouseover="this.style.opacity='1'" onmouseout={`this.style.opacity='var(--o-secondary)'`}>
        Full model &#8594;
      </a>
    )}
  </div>

</div>

<style>
  /* ── Grid ──────────────────────────────────────────────────────────── */
  .main-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 260px;
  }

  /* ── Surfaces ──────────────────────────────────────────────────────── */
  .income-box {
    background: rgba(34, 197, 94, 0.18);
    /* No left border — cards below already carry the green identity */
  }
  .expend-box {
    background: rgba(249, 115, 22, 0.16);
    /* No right border here either — cards below carry orange/purple */
  }

  /* ── Centre column ─────────────────────────────────────────────────── */
  .centre-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 12px;
    border-left: 1px solid #1e1e23;
    border-right: 1px solid #1e1e23;
    padding-bottom: 28px; /* space for I→Y label */
  }
  .arrow-green { font-size: 1.25rem; font-weight: 700; color: #22c55e; }
  .arrow-orange { font-size: 1.25rem; font-weight: 700; color: #f97316; }

  /* ── GTA blip badges (large) ────────────────────────────────────────── */
  .blip-lg {
    width:  64px;
    height: 64px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--blip-col) 20%, transparent);
    border: 2.5px solid color-mix(in srgb, var(--blip-col) 50%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* ── Circle ────────────────────────────────────────────────────────── */
  .circle-wrapper {
    width: 140px;
    height: 140px;
    position: relative;
    flex-shrink: 0;
  }
  .circle-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 120deg,
      #22c55e  0deg   90deg,
      #00d4e8  90deg  125deg,
      #f97316  125deg 220deg,
      #818cf8  220deg 330deg,
      #22c55e  330deg 360deg
    );
    -webkit-mask: radial-gradient(circle, transparent 52px, black 54px);
    mask:         radial-gradient(circle, transparent 52px, black 54px);
    opacity: 0.9;
  }
  .circle-centre {
    position: absolute;
    inset: 18px;
    border-radius: 50%;
    background: rgba(0, 212, 232, 0.08);
    border: 1.5px solid rgba(0, 212, 232, 0.3);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
  }
  .ci-col-c { background: rgba(249,115,22,0.10); }
  .ci-col-i { background: rgba(129,140,248,0.10); }
  .circle-return {
    position: absolute;
    bottom: -22px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }
</style>
