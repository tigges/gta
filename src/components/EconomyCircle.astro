---
/**
 * EconomyCircle.astro — GTA circular economy diagram.
 *
 * A true circle: the border itself changes colour per section (conic-gradient).
 * Income left (green), Injection top (blue), Expenditure right (orange/purple),
 * Investment return bottom (purple). Icons at each cardinal point.
 * Pure HTML/CSS — no JS, no D3.
 */
import HudIcon from "./HudIcon.astro";
import GamePill from "./GamePill.astro";

interface Props {
  game?: "gta-vi" | "gta-online" | "gta-v" | "gta-sa" | "gta-vc" | "gta-iv" | "gta-iii" | "franchise";
  fullEconomyHref?: string;
}

const { game = "gta-online", fullEconomyHref } = Astro.props;
---

<div class="w-full rounded-xl border border-[#1e1e23] overflow-hidden" style="background:var(--c-card)">

  <!-- ── J Injection header — Rockstar above the circle ────────────────── -->
  <div class="flex items-center justify-center gap-8 px-6 py-3 border-b border-[#1e1e23]"
       style="background:rgba(0,212,232,0.06)">
    <div class="flex flex-col items-center gap-1 opacity-50">
      <HudIcon name="shark-card" size={20} style="color:var(--c-title-online)" />
      <span class="text-[8px] font-mono" style="color:var(--c-title-online)">Shark Card</span>
    </div>
    <div class="flex flex-col items-center gap-0.5">
      <span class="text-[9px] font-mono uppercase tracking-[0.2em]" style="color:var(--c-title-online);opacity:0.7">Rockstar</span>
      <span class="text-xl font-mono font-black" style="color:var(--c-title-online)">J</span>
      <span class="text-[9px] font-mono" style="color:var(--c-title-online);opacity:0.7">injection</span>
      <span class="text-xs" style="color:var(--c-title-online)">↓</span>
    </div>
    <div class="flex flex-col items-center gap-1 opacity-50">
      <HudIcon name="subscription" size={20} style="color:var(--c-title-online)" />
      <span class="text-[8px] font-mono" style="color:var(--c-title-online)">GTA+</span>
    </div>
    <span class="absolute right-4 text-[8px] font-mono" style="color:var(--c-text-6)">* GTA Online only</span>
  </div>

  <!-- ── Main diagram ──────────────────────────────────────────────────── -->
  <div class="flex items-center justify-center px-4 py-6 relative">

    <!-- Left: Y Income label block -->
    <div class="flex flex-col items-center gap-3 w-32 shrink-0">
      <div class="text-5xl font-mono font-black leading-none" style="color:var(--c-growth)">Y</div>
      <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-center" style="color:var(--c-growth)">Income</div>
      <div class="flex items-center gap-2">
        <HudIcon name="mission" size={22} style="color:var(--c-live)" />
        <HudIcon name="passive" size={22} style="color:var(--c-growth)" />
        <HudIcon name="cycle"   size={22} style="color:var(--c-growth);opacity:0.75" />
      </div>
      <div class="text-[9px] font-mono text-center leading-relaxed" style="color:var(--c-growth);opacity:0.65">
        Active · Passive<br/>Businesses
      </div>
    </div>

    <!-- ── The Circle ─────────────────────────────────────────────────── -->
    <!-- Flow arrow: Y → circle -->
    <div class="flex items-center shrink-0 px-1">
      <span class="text-lg font-bold" style="color:var(--c-growth)">→</span>
    </div>

    <!-- The circle itself — conic-gradient border shows flow color -->
    <div class="relative shrink-0 circle-wrapper">
      <!-- Conic-gradient ring -->
      <div class="circle-ring"></div>

      <!-- Centre: Balance -->
      <div class="circle-centre">
        <HudIcon name="bank" size={28} style="color:var(--c-title-online)" />
        <div class="text-[11px] font-mono font-bold mt-1" style="color:var(--c-title-online)">GTA$</div>
        <HudIcon name="dollar" size={16} style="color:var(--c-title-online);opacity:0.5" />
      </div>

      <!-- Return arc label at bottom of circle -->
      <div class="circle-return-label">
        <span class="text-[8px] font-mono uppercase tracking-widest" style="color:var(--c-economy);opacity:0.75">I → Y</span>
      </div>
    </div>

    <!-- Flow arrow: circle → C+I -->
    <div class="flex items-center shrink-0 px-1">
      <span class="text-lg font-bold" style="color:var(--c-flow-spending)">→</span>
    </div>

    <!-- Right: C+I Expenditure label block -->
    <div class="flex flex-col items-center gap-3 w-32 shrink-0">
      <div class="text-5xl font-mono font-black leading-none" style="color:var(--c-flow-spending)">C+I</div>
      <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-center" style="color:var(--c-flow-spending)">Expenditure</div>
      <!-- C Consumption -->
      <div class="flex flex-col gap-2 w-full">
        <div class="flex items-center justify-center gap-2">
          <span class="text-[9px] font-mono font-bold" style="color:var(--c-flow-spending)">C</span>
          <HudIcon name="clothing" size={20} style="color:var(--c-flow-spending)" />
          <HudIcon name="ammo"     size={20} style="color:var(--c-flow-spending);opacity:0.8" />
        </div>
        <!-- I Investment -->
        <div class="flex items-center justify-center gap-2">
          <span class="text-[9px] font-mono font-bold" style="color:var(--c-economy)">I</span>
          <HudIcon name="property"  size={20} style="color:var(--c-economy)" />
          <HudIcon name="briefcase" size={20} style="color:var(--c-economy);opacity:0.8" />
        </div>
      </div>
      <div class="text-[9px] font-mono text-center leading-relaxed" style="color:var(--c-flow-spending);opacity:0.65">
        Consume · Invest<br/>in businesses
      </div>
    </div>

  </div>

  <!-- ── Footer: formula + pill + link ─────────────────────────────────── -->
  <div class="flex items-center justify-between px-5 py-3 border-t border-[#1e1e23]">
    <div class="flex items-center gap-3">
      <GamePill {game} size="xs" />
      <span class="text-[10px] font-mono" style="color:var(--c-text-4)">(Y + J) = C + I</span>
    </div>
    {fullEconomyHref && (
      <a href={fullEconomyHref}
         class="text-[10px] font-mono uppercase tracking-widest transition-colors"
         style="color:var(--c-brand);opacity:var(--o-secondary)"
         onmouseover="this.style.opacity='1'" onmouseout={`this.style.opacity='var(--o-secondary)'`}>
        Full model →
      </a>
    )}
  </div>

</div>

<style>
  /* ── Circle wrapper ──────────────────────────────────────────────────── */
  .circle-wrapper {
    width:  160px;
    height: 160px;
    position: relative;
  }

  /* The conic-gradient ring — 16px thick, colors per section:
     Left (Y income)  = green  → top-left corner
     Top  (J inject)  = blue   → already shown above circle, just a hint
     Right (C+I)      = orange → right side
     Bottom (I→Y)     = purple → return arc */
  .circle-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 135deg,
      #22c55e  0deg   90deg,   /* Y income — green, left side  */
      #00d4e8  90deg  120deg,  /* J inject — blue, top         */
      #f97316  120deg 200deg,  /* C consume — orange, right    */
      #818cf8  200deg 300deg,  /* I invest — purple, bottom    */
      #22c55e  300deg 360deg   /* back to green, close loop    */
    );
    /* Mask to ring only */
    -webkit-mask: radial-gradient(circle, transparent 60px, black 62px);
    mask: radial-gradient(circle, transparent 60px, black 62px);
    opacity: 0.85;
  }

  /* Directional arrows overlaid on the ring at compass points */
  .circle-ring::before,
  .circle-ring::after {
    content: "";
  }

  /* Centre disc for Balance */
  .circle-centre {
    position: absolute;
    inset: 20px;
    border-radius: 50%;
    background: rgba(0,212,232,0.08);
    border: 1.5px solid rgba(0,212,232,0.3);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }

  /* I → Y return label at bottom of circle */
  .circle-return-label {
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }
</style>
