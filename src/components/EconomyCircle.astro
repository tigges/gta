---
/**
 * EconomyCircle.astro — GTA circular economy diagram v8 (Option A).
 *
 * Layout:
 *   Row 1 (full): INJECTION — Shark Card | ROCKSTAR INJECTION J↓ | GTA+
 *   Row 2 (mid):  Circle centred, EXPENDITURE spanning right half
 *   Row 3 (bot):  INCOME (left, 40%) | CONSUMPTION (centre, 30%) | INVESTMENT (right, 30%)
 *
 * Equation reads left-to-right: INCOME $ [=] CONSUMPTION [+] INVESTMENT
 * Y, C, I letters appear on TOP BORDERS of each box (connecting from circle).
 * EXPENDITURE spans both C and I as a super-header.
 */
import HudIcon from "./HudIcon.astro";
import GamePill from "./GamePill.astro";

interface Props {
  game?: "gta-vi" | "gta-online" | "gta-v" | "gta-sa" | "gta-vc" | "gta-iv" | "gta-iii" | "franchise";
  fullEconomyHref?: string;
}
const { game = "gta-online", fullEconomyHref } = Astro.props;
---

<div class="eco-wrap">

  <!-- ── ROW 1: INJECTION (full width) ──────────────────────────────── -->
  <div class="inject-row">
    <div class="inject-inner">
      <div class="inject-item" style="opacity:var(--o-tertiary)">
        <div class="blip" style="--bc:var(--c-title-online)"><HudIcon name="shark-card" size={28} style="color:#fff"/></div>
        <span class="item-label" style="color:var(--c-title-online)">Shark Card</span>
      </div>

      <div class="inject-centre">
        <span class="rockstar-label">Rockstar</span>
        <span class="inject-title">INJECTION</span>
        <span class="j-arrow">J &#8595;</span>
      </div>

      <div class="inject-item" style="opacity:var(--o-tertiary)">
        <div class="blip" style="--bc:var(--c-title-online)"><HudIcon name="subscription" size={28} style="color:#fff"/></div>
        <span class="item-label" style="color:var(--c-title-online)">GTA+</span>
      </div>
    </div>
    <span class="online-note">&#42; GTA Online only</span>
  </div>

  <!-- ── ROW 2: Circle (centred) + EXPENDITURE super-header (right) ── -->
  <div class="mid-row">

    <!-- Left spacer (aligns with INCOME column) -->
    <div class="mid-left-space"></div>

    <!-- Circle hub -->
    <div class="circle-hub">
      <!-- Y label on left edge of circle -->
      <span class="hub-letter hub-y">Y</span>
      <!-- C label on bottom-left -->
      <span class="hub-letter hub-c">C</span>
      <!-- I label on bottom-right -->
      <span class="hub-letter hub-i">I</span>

      <!-- Income arrow in (green, pointing right into circle) -->
      <div class="tri-in"></div>

      <!-- Circle ring -->
      <div class="ring-wrap">
        <div class="ring"></div>
        <div class="ring-centre">
          <HudIcon name="bank" size={28} style="color:#00d4e8"/>
          <span class="gta-label">GTA$</span>
        </div>
      </div>

      <!-- Expenditure arrow out (orange, pointing right out of circle) -->
      <div class="tri-out"></div>
    </div>

    <!-- EXPENDITURE super-header — spans right half -->
    <div class="expend-super">
      <div class="expend-super-inner">
        <HudIcon name="buy" size={26} style="color:var(--c-flow-spending,#f97316)"/>
        <span class="expend-title">EXPENDITURE</span>
      </div>
    </div>

  </div>

  <!-- ── ROW 3: Three boxes with Y/C/I top border labels ───────────── -->
  <div class="box-row">

    <!-- INCOME box -->
    <div class="box income-box">
      <div class="box-top-label" style="color:var(--c-growth,#22c55e)">Y</div>
      <div class="box-inner">
        <div class="box-header">
          <span class="box-title" style="color:var(--c-growth,#22c55e)">INCOME</span>
          <div class="blip-sm" style="--bc:var(--c-growth,#22c55e)">
            <HudIcon name="dollar" size={16} style="color:#fff"/>
          </div>
        </div>
        <div class="icon-row">
          <div class="icon-item">
            <div class="blip-lg" style="--bc:var(--c-live,#0d9488)"><HudIcon name="mission" size={30} style="color:#fff"/></div>
            <span class="icon-label">Missions</span>
          </div>
          <div class="icon-item">
            <div class="blip-lg" style="--bc:var(--c-growth,#22c55e)"><HudIcon name="passive" size={30} style="color:#fff"/></div>
            <span class="icon-label">Passive</span>
          </div>
        </div>
        <div class="box-footer" style="color:var(--c-growth)">Y grows &#8594; next cycle</div>
      </div>
    </div>

    <!-- = divider -->
    <div class="divider-eq">
      <span class="eq-sign">=</span>
    </div>

    <!-- CONSUMPTION box -->
    <div class="box consump-box">
      <div class="box-top-label" style="color:var(--c-flow-spending,#f97316)">C</div>
      <div class="box-inner">
        <div class="box-header">
          <span class="box-title" style="color:var(--c-flow-spending,#f97316)">CONSUMPTION</span>
        </div>
        <div class="icon-row">
          <div class="icon-item">
            <div class="blip-lg" style="--bc:var(--c-flow-spending,#f97316)"><HudIcon name="clothing" size={30} style="color:#fff"/></div>
            <span class="icon-label">Clothing</span>
          </div>
          <div class="icon-item">
            <div class="blip-lg" style="--bc:var(--c-flow-spending,#f97316)"><HudIcon name="ammo" size={30} style="color:#fff"/></div>
            <span class="icon-label">Ammo</span>
          </div>
        </div>
        <div class="box-footer" style="color:var(--c-flow-spending);opacity:0.5">Ammo &#183; clothes &#183; services</div>
      </div>
    </div>

    <!-- + divider -->
    <div class="divider-plus">
      <span class="plus-sign">+</span>
    </div>

    <!-- INVESTMENT box -->
    <div class="box invest-box">
      <div class="box-top-label" style="color:var(--c-economy,#818cf8)">I</div>
      <div class="box-inner">
        <div class="box-header">
          <span class="box-title" style="color:var(--c-economy,#818cf8)">INVESTMENT</span>
        </div>
        <div class="icon-row">
          <div class="icon-item">
            <div class="blip-lg" style="--bc:var(--c-economy,#818cf8)"><HudIcon name="property" size={30} style="color:#fff"/></div>
            <span class="icon-label">Property</span>
          </div>
          <div class="icon-item">
            <div class="blip-lg" style="--bc:var(--c-economy,#818cf8)"><HudIcon name="briefcase" size={30} style="color:#fff"/></div>
            <span class="icon-label">Business</span>
          </div>
        </div>
        <div class="box-footer" style="color:var(--c-economy)">I returns to Y &#8594;</div>
      </div>
    </div>

  </div>

  <!-- ── Footer ─────────────────────────────────────────────────────── -->
  <div class="eco-footer">
    <div class="footer-left">
      <GamePill {game} size="xs"/>
      <span class="formula">(Y + J) = C + I</span>
    </div>
    {fullEconomyHref && (
      <a href={fullEconomyHref} class="full-link"
         onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
        Full model &#8594;
      </a>
    )}
  </div>

</div>

<style>
/* ── Root ─────────────────────────────────────────────────────────── */
.eco-wrap {
  width: 100%;
  border-radius: 12px;
  border: 1px solid var(--c-border-1);
  overflow: hidden;
  background: var(--c-card);
  font-family: var(--font-mono,monospace);
}

/* ── Row 1: Injection ──────────────────────────────────────────────── */
.inject-row {
  position: relative;
  border-bottom: 1px solid var(--c-border-1);
  background: color-mix(in srgb, var(--c-title-online) 5%, transparent);
  padding: 12px 16px;
}
.inject-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48px;
}
.inject-item { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.item-label  { font-size: 9px; text-transform: uppercase; letter-spacing: .1em; }
.inject-centre { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.rockstar-label { font-size: 9px; color: var(--c-title-online); opacity: var(--o-tertiary); letter-spacing: .25em; text-transform: uppercase; }
.inject-title { font-size: 2rem; font-weight: 900; line-height: 1; color: var(--c-title-online); }
.j-arrow { font-size: 1.1rem; font-weight: 700; color: var(--c-title-online); }
.online-note { position: absolute; top: 8px; right: 12px; font-size: 8px; color: var(--c-text-6,#52525b); }

/* ── Row 2: Circle + EXPENDITURE super-header ──────────────────────── */
.mid-row {
  display: grid;
  grid-template-columns: 40% auto 1fr;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid var(--c-border-1);
  background: rgba(0,0,0,0.2);
}
.mid-left-space { } /* empty spacer matching income column width */

.circle-hub {
  display: flex;
  align-items: center;
  position: relative;
  gap: 0;
  justify-content: center;
}
.ring-wrap {
  position: relative;
  width: 120px; height: 120px;
  flex-shrink: 0;
  z-index: 5;
}
.ring {
  position: absolute; inset: 0;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    var(--c-economy)        0deg  75deg,
    var(--c-growth)        75deg 200deg,
    var(--c-title-online) 200deg 245deg,
    var(--c-flow-spending) 245deg 325deg,
    var(--c-economy)      325deg 360deg
  );
  -webkit-mask: radial-gradient(circle, transparent 42px, black 44px);
  mask:         radial-gradient(circle, transparent 42px, black 44px);
  opacity: .95;
}
.ring-centre {
  position: absolute; inset: 14px;
  border-radius: 50%;
  background: color-mix(in srgb, var(--c-bg-deep) 90%, transparent);
  border: 1.5px solid color-mix(in srgb, var(--c-title-online) 30%, transparent);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 2px;
}
.gta-label { font-size: 11px; font-weight: 900; color: var(--c-title-online); }

/* Hub letter labels on circle edges */
.hub-letter {
  position: absolute;
  font-size: 13px; font-weight: 900;
  z-index: 6;
}
.hub-y { left: -4px; top: 50%; transform: translateY(-50%); color: var(--c-growth); }
.hub-c { bottom: 2px; left: 18px; color: var(--c-flow-spending); }
.hub-i { bottom: 2px; right: 18px; color: var(--c-economy); }

/* CSS triangle arrows */
.tri-in {
  width: 0; height: 0;
  border-top: 22px solid transparent;
  border-bottom: 22px solid transparent;
  border-left: 28px solid color-mix(in srgb, var(--c-growth) 80%, transparent);
  flex-shrink: 0;
  filter: drop-shadow(0 0 4px color-mix(in srgb, var(--c-growth) 40%, transparent));
}
.tri-out {
  width: 0; height: 0;
  border-top: 22px solid transparent;
  border-bottom: 22px solid transparent;
  border-left: 28px solid color-mix(in srgb, var(--c-flow-spending) 80%, transparent);
  flex-shrink: 0;
  filter: drop-shadow(0 0 4px color-mix(in srgb, var(--c-flow-spending) 40%, transparent));
}

/* EXPENDITURE super-header */
.expend-super {
  display: flex;
  align-items: center;
  padding-left: 12px;
}
.expend-super-inner {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 16px;
  border: 1.5px solid color-mix(in srgb, var(--c-flow-spending) 35%, transparent);
  border-radius: 8px;
  background: color-mix(in srgb, var(--c-flow-spending) 7%, transparent);
}
.expend-title {
  font-size: clamp(1rem,2.5vw,1.6rem);
  font-weight: 900;
  color: var(--c-flow-spending,#f97316);
  letter-spacing: -.01em;
}

/* ── Row 3: Three boxes ────────────────────────────────────────────── */
.box-row {
  display: flex;
  align-items: stretch;
}
.box {
  flex: 1;
  min-width: 0;
  position: relative;
}
.income-box  { background: rgba(15,55,20,.9);  }
.consump-box { background: rgba(50,18,4,.85);  }
.invest-box  { background: rgba(22,18,50,.85); }

/* Y / C / I on the top border */
.box-top-label {
  position: absolute;
  top: -11px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 13px;
  font-weight: 900;
  background: var(--c-card);
  padding: 0 4px;
  z-index: 10;
  line-height: 1;
}

.box-inner { padding: 16px 14px; display: flex; flex-direction: column; gap: 10px; min-height: 160px; }
.box-header { display: flex; align-items: center; gap: 8px; }
.box-title { font-size: clamp(.8rem,2vw,1.1rem); font-weight: 900; line-height: 1; }
.icon-row { display: flex; gap: 12px; }
.icon-item { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.icon-label { font-size: 8px; color: rgba(255,255,255,.65); text-align: center; }
.box-footer { margin-top: auto; font-size: 8px; text-transform: uppercase; letter-spacing: .1em; opacity: .65; }

/* = and + dividers */
.divider-eq, .divider-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  flex-shrink: 0;
  background: rgba(0,0,0,.3);
  border-left: 1px solid var(--c-border-1);
  border-right: 1px solid var(--c-border-1);
}
.eq-sign   { font-size: 1.4rem; font-weight: 900; color: var(--c-flow-spending,#f97316); }
.plus-sign { font-size: 1.4rem; font-weight: 900; color: var(--c-economy,#818cf8); }

/* ── Blip sizes ────────────────────────────────────────────────────── */
.blip, .blip-sm, .blip-lg {
  border-radius: 50%;
  background: color-mix(in srgb, var(--bc) 25%, transparent);
  border: 2px solid color-mix(in srgb, var(--bc) 55%, transparent);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.blip    { width: 52px; height: 52px; }
.blip-sm { width: 36px; height: 36px; border-width: 1.5px; }
.blip-lg { width: 68px; height: 68px; border-width: 2.5px; }

/* ── Footer ────────────────────────────────────────────────────────── */
.eco-footer {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8px 16px;
  border-top: 1px solid var(--c-border-1);
  background: var(--c-card);
}
.footer-left { display: flex; align-items: center; gap: 10px; }
.formula { font-size: 8px; color: var(--c-text-4,#9898b8); opacity: .4; }
.full-link {
  font-size: 10px; text-transform: uppercase; letter-spacing: .12em;
  color: var(--c-brand,#f59e0b); opacity: .6; text-decoration: none; transition: opacity .2s;
}
</style>
