---
/**
 * CircularEconomy.astro
 * Renders the circular economy diagram for any GTA franchise title.
 * Data-driven from data/franchise/economy-models.json.
 * Decision 1: CSS Grid + absolute SVG overlay (Option B)
 */
import type { EconomyModel } from "../types/gta";
import economyData from "../../data/franchise/economy-models.json";

interface Props {
  titleId: string;
  mode?: "full" | "compact";
}

const { titleId, mode = "full" } = Astro.props;
const allEconomies = (economyData as any).economies as EconomyModel[];
const economy = allEconomies.find((e: any) => e.title_id === titleId);
if (!economy) throw new Error(`CircularEconomy: unknown titleId "${titleId}"`);

const isCompact = mode === "compact";

// ── Color token → Tailwind class maps ────────────────────────────────────────
const BORDER: Record<string, string> = {
  indigo: "border-indigo-500/30", amber:  "border-amber-700/40",
  orange: "border-orange-700/40", teal:   "border-teal-600/40",
  green:  "border-green-700/40",  purple: "border-purple-700/40",
  blue:   "border-blue-600/40",   zinc:   "border-[#2a2a31]",
  gold:   "border-gta-gold/40",   yellow: "border-yellow-600/40",
  red:    "border-red-600/40",
};
const TEXT: Record<string, string> = {
  indigo: "text-indigo-400", amber:  "text-amber-400",
  orange: "text-orange-400", teal:   "text-teal-400",
  green:  "text-green-400",  purple: "text-purple-400",
  blue:   "text-blue-400",   zinc:   "text-zinc-300",
  gold:   "text-gta-gold",   yellow: "text-yellow-400",
  red:    "text-red-400",
};

// ── Node lookup ───────────────────────────────────────────────────────────────
const nodeMap: Record<string, any> = {};
for (const n of economy.nodes as any[]) nodeMap[n.id] = n;
const sovereignNode = (economy.nodes as any[]).find((n: any) => n.type === "sovereign");
const gridNodes     = (economy.nodes as any[]).filter((n: any) => n.type !== "sovereign");

// ── Layout templates: node positions as % of container ───────────────────────
const LAYOUTS: Record<string, Record<string, { top: number; left: number; width: number }>> = {
  "one-way": {
    "player":          { top: 18, left:  4, width: 40 },
    "world":           { top: 18, left: 56, width: 40 },
    "world-shops":     { top: 18, left: 56, width: 40 },
  },
  "proto": {
    "missions-jobs":   { top: 10, left:  1, width: 26 },
    "missions-hits":   { top: 10, left:  1, width: 26 },
    "player":          { top: 10, left: 33, width: 34 },
    "businesses":      { top: 10, left: 70, width: 28 },
    "world":           { top: 10, left: 70, width: 28 },
    "world-shops":     { top: 68, left: 33, width: 34 },
    "tbogt-bridge":    { top: 70, left: 22, width: 56 },
  },
  "loop": {
    "heists-missions": { top:  8, left:  1, width: 26 },
    "player":          { top:  8, left: 32, width: 36 },
    "properties":      { top:  8, left: 71, width: 27 },
    "bawsaq-lcn":      { top: 65, left: 26, width: 48 },
  },
  "multi-stream": {
    "missions-jobs":   { top:  3, left: 33, width: 34 },
    "player":          { top: 36, left: 33, width: 34 },
    "properties":      { top:  3, left: 70, width: 28 },
    "gang-territory":  { top: 72, left:  1, width: 30 },
    "gambling":        { top: 72, left: 35, width: 30 },
    "stock-market":    { top: 72, left: 69, width: 30 },
  },
  "full-mmt": {
    "businesses":      { top: 18, left:  1, width: 30 },
    "players":         { top: 18, left: 35, width: 30 },
    "maze-bank":       { top: 18, left: 69, width: 29 },
    "shark-cards":     { top: 72, left: 26, width: 48 },
  },
  "dual-territory": {
    "businesses-vc":      { top: 32, left:  2, width: 22 },
    "players-vc":         { top: 32, left: 26, width: 22 },
    "businesses-leonida": { top: 32, left: 54, width: 22 },
    "players-leonida":    { top: 32, left: 78, width: 20 },
    "shark-cards":        { top: 78, left: 26, width: 48 },
  },
};
const nodePositions = LAYOUTS[economy.layout_template as string] ?? {};

const CONTAINER_H: Record<string, number> = {
  "one-way":       160,  "proto":         300,
  "loop":          300,  "multi-stream":  360,
  "full-mmt":      300,  "dual-territory":380,
};
const containerH = isCompact
  ? Math.round((CONTAINER_H[economy.layout_template as string] ?? 300) * 0.8)
  : (CONTAINER_H[economy.layout_template as string] ?? 300);

// ── Era badge styling ─────────────────────────────────────────────────────────
const ERA_BADGE: Record<string, string> = {
  zinc:  "bg-zinc-800 border-zinc-700/50 text-zinc-400",
  amber: "bg-amber-900/30 border-amber-700/40 text-amber-400",
  green: "bg-green-900/30 border-green-700/40 text-green-400",
  red:   "bg-red-900/30 border-red-600/40 text-red-400",
  teal:  "bg-teal-900/30 border-teal-700/40 text-teal-400",
  gold:  "bg-gta-gold/10 border-gta-gold/30 text-gta-gold",
};
const eraBadge = ERA_BADGE[economy.era_badge_color as string] ?? ERA_BADGE.zinc;

// Unique component ID for SVG marker namespacing
const uid = `ce-${economy.title_id}-${Math.random().toString(36).slice(2,7)}`;
---

<div class="circular-economy-wrapper" data-ce-uid={uid}>

  {/* ── Era badge row ──────────────────────────────────────────────────── */}
  <div class="flex items-center gap-2 mb-3 flex-wrap">
    <span class={`text-[9px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest ${eraBadge}`}>
      {economy.era_label}
    </span>
    {(economy ).regression_era && (
      <span class="text-[9px] font-mono bg-red-900/30 border border-red-600/40 text-red-400 px-2 py-0.5 rounded uppercase tracking-widest">
        Deliberate Regression
      </span>
    )}
    {(economy ).projected && (
      <span class="text-[9px] font-mono bg-amber-900/20 border border-amber-700/30 text-amber-500 px-2 py-0.5 rounded uppercase tracking-widest">
        Projected
      </span>
    )}
  </div>

  {/* ── Sovereign box ─────────────────────────────────────────────────── */}
  {sovereignNode && (
    <div class={`rounded-xl border px-4 py-3 mb-2 ${(economy ).projected ? "border-dashed border-indigo-500/20" : "border-indigo-500/25"}`}
         style="background:rgba(49,46,129,0.12)">
      <div class="text-center mb-0.5">
        <span class="text-[8px] font-mono text-indigo-400/50 uppercase tracking-[0.2em]">SOVEREIGN</span>
      </div>
      <div class="text-center font-semibold text-indigo-300 text-sm mb-1" style="font-family:'Inter',sans-serif">
        {sovereignNode.label}
      </div>
      <div class="text-center text-[10px] font-mono text-indigo-400/50 leading-snug">
        {sovereignNode.detail}
      </div>
      {/* Sovereign lever pills (GTA Online / GTA VI) */}
      {!isCompact && (economy ).sovereign_levers.length > 0 && (
        <div class="flex flex-wrap justify-center gap-1.5 mt-2.5">
          {(economy ).sovereign_levers.map((lever: string) => (
            <span class={`text-[8px] font-mono border px-2 py-0.5 rounded-full ${(economy ).projected ? "border-indigo-700/25 text-indigo-500/60" : "border-indigo-700/40 text-indigo-400/70"}`}>
              {lever}
            </span>
          ))}
        </div>
      )}
    </div>
  )}

  {/* Sovereign dashed arrow down */}
  <div class="flex justify-center my-1">
    <svg width="16" height="18" viewBox="0 0 16 18">
      <line x1="8" y1="0" x2="8" y2="12" stroke="#4338ca" stroke-width="1.5"
            stroke-dasharray={(economy ).projected ? "3,2" : "none"} stroke-opacity="0.35" />
      <polygon points="3,10 8,18 13,10" fill="#4338ca" opacity="0.25" />
    </svg>
  </div>

  {/* ── Layout: dual-territory ────────────────────────────────────────── */}
  {economy.layout_template === "dual-territory" && (() => {
    const proj = (economy ).projected;
    const r1 = nodeMap["region-1"];
    const r2 = nodeMap["region-2"];
    const bvc = nodeMap["businesses-vc"];
    const pvc = nodeMap["players-vc"];
    const ble = nodeMap["businesses-leonida"];
    const ple = nodeMap["players-leonida"];
    const sc  = nodeMap["shark-cards"];
    return (
    <div class="w-full space-y-3">
      <div class="grid grid-cols-2 gap-3">
        <div class={proj ? "rounded-xl border-2 border-dashed border-gta-gold/20 p-3" : "rounded-xl border-2 border-gta-gold/20 p-3"}
             style="background:rgba(245,158,11,0.04)">
          <div class="text-[9px] font-mono text-gta-gold/40 uppercase tracking-widest text-center mb-1">{r1?.label}</div>
          <div class="text-[8px] font-mono text-zinc-700 text-center mb-3 leading-snug">{r1?.detail}</div>
          <div class="grid grid-cols-2 gap-2">
            {bvc && <div class={proj ? "rounded-lg border border-dashed px-2 py-2 text-center border-amber-700/30" : "rounded-lg border px-2 py-2 text-center border-amber-700/40"}
                        style="background:rgba(0,0,0,0.2)" data-node-id="businesses-vc">
              <div class="text-[10px] font-semibold text-amber-400" style="font-family:'Inter',sans-serif">{bvc.label}</div>
              <div class="text-[8px] font-mono text-zinc-600 mt-0.5 leading-snug">{bvc.detail}</div>
            </div>}
            {pvc && <div class="rounded-lg border px-2 py-2 text-center border-[#2a2a31]"
                        style="background:rgba(0,0,0,0.2)" data-node-id="players-vc">
              <div class="text-[10px] font-semibold text-zinc-300" style="font-family:'Inter',sans-serif">{pvc.label}</div>
              <div class="text-[8px] font-mono text-zinc-600 mt-0.5">{pvc.detail}</div>
            </div>}
          </div>
        </div>
        <div class={proj ? "rounded-xl border-2 border-dashed border-teal-600/20 p-3" : "rounded-xl border-2 border-teal-600/20 p-3"}
             style="background:rgba(13,148,136,0.04)">
          <div class="text-[9px] font-mono text-teal-400/40 uppercase tracking-widest text-center mb-1">{r2?.label}</div>
          <div class="text-[8px] font-mono text-zinc-700 text-center mb-3 leading-snug">{r2?.detail}</div>
          <div class="grid grid-cols-2 gap-2">
            {ble && <div class={proj ? "rounded-lg border border-dashed px-2 py-2 text-center border-teal-700/30" : "rounded-lg border px-2 py-2 text-center border-teal-600/40"}
                        style="background:rgba(0,0,0,0.2)" data-node-id="businesses-leonida">
              <div class="text-[10px] font-semibold text-teal-400" style="font-family:'Inter',sans-serif">{ble.label}</div>
              <div class="text-[8px] font-mono text-zinc-600 mt-0.5 leading-snug">{ble.detail}</div>
            </div>}
            {ple && <div class="rounded-lg border px-2 py-2 text-center border-[#2a2a31]"
                        style="background:rgba(0,0,0,0.2)" data-node-id="players-leonida">
              <div class="text-[10px] font-semibold text-zinc-300" style="font-family:'Inter',sans-serif">{ple.label}</div>
              <div class="text-[8px] font-mono text-zinc-600 mt-0.5">{ple.detail}</div>
            </div>}
          </div>
        </div>
      </div>
      <div class="flex items-center justify-center gap-3 text-[9px] font-mono text-zinc-700">
        <div class="flex-1 h-px border-t border-dashed border-[#2a2a31]"></div>
        <span>← player movement →</span>
        <div class="flex-1 h-px border-t border-dashed border-[#2a2a31]"></div>
      </div>
      {sc && <div class={proj ? "rounded-xl border border-dashed border-blue-600/30 px-4 py-3 text-center" : "rounded-xl border border-blue-600/30 px-4 py-3 text-center"}
                  style="background:rgba(37,99,235,0.05)">
        <div class="text-sm font-semibold text-blue-400 mb-0.5" style="font-family:'Inter',sans-serif">{sc.label}</div>
        <div class="text-[9px] font-mono text-blue-400/50 leading-snug">{sc.detail}</div>
      </div>}
    </div>
    );
  })()}

  {/* ── Layout: full-mmt ─────────────────────────────────────────────── */}
  {economy.layout_template === "full-mmt" && (
    <div class="w-full space-y-3">
      <div class="rounded-xl border border-dashed border-[#2a2a31] p-4" style="background:rgba(0,0,0,0.08)">
        <div class="text-[8px] font-mono text-zinc-700 uppercase tracking-[0.2em] text-center mb-3">
          In-Game Circular Economy
        </div>
        <div class="grid grid-cols-3 gap-3 mb-4">
          {["businesses","players","maze-bank"].map(nid => {
            const n = nodeMap[nid]; if (!n) return null;
            return (
              <div class={`rounded-xl border px-3 py-3 text-center ${BORDER[n.color_token] ?? BORDER.zinc}`}
                   style="background:rgba(0,0,0,0.25)" data-node-id={nid}>
                <div class={`text-[11px] font-semibold mb-1 ${TEXT[n.color_token] ?? TEXT.zinc}`} style="font-family:'Inter',sans-serif">
                  {n.label}
                </div>
                <div class="text-[8px] font-mono text-zinc-600 leading-snug">{n.detail}</div>
              </div>
            );
          })}
        </div>
        {/* Flow labels */}
        {!isCompact && (
          <div class="grid grid-cols-2 gap-1.5">
            {(economy.flows).filter((f: any) => f.type !== "injection").map((flow: any) => {
              const colorHex = { amber:"#f59e0b", orange:"#f97316", teal:"#0d9488", green:"#22c55e", purple:"#a78bfa", blue:"#60a5fa", zinc:"#71717a", gold:"#f59e0b" };
              const hex = colorHex[flow.color_token] ?? "#71717a";
              return (
                <div class="flex items-center gap-1.5 text-[9px] font-mono">
                  <div class="w-5 h-px flex-shrink-0" style={`background:${hex};opacity:0.7`}></div>
                  <span class="text-zinc-600 leading-snug truncate">{flow.label}</span>
                </div>
              );
            })}
          </div>
        )}
      </div>
      {/* Shark Cards */}
      {nodeMap["shark-cards"] && (
        <div class="rounded-xl border border-blue-600/30 px-4 py-3 text-center" style="background:rgba(37,99,235,0.05)" data-node-id="shark-cards">
          <div class="text-sm font-semibold text-blue-400 mb-0.5" style="font-family:'Inter',sans-serif">
            {nodeMap["shark-cards"].label}
          </div>
          <div class="text-[9px] font-mono text-blue-400/50 leading-snug">
            {nodeMap["shark-cards"].detail}
          </div>
        </div>
      )}
    </div>
  )}

  {/* ── All other layouts: positioned grid + SVG arrows ──────────────── */}
  {economy.layout_template !== "dual-territory" && economy.layout_template !== "full-mmt" && (
    <div class="ce-node-grid relative w-full"
         style={`height:${containerH}px`}
         data-flows={JSON.stringify(economy.flows)}
         data-uid={uid}>

      {/* No-circular-return annotation */}
      {(economy ).dimensions.circular_flow === "none" && (
        <div class="absolute bottom-3 left-0 right-0 text-center pointer-events-none">
          <span class="text-[9px] font-mono text-zinc-700">✕ no circular return · money = score only</span>
        </div>
      )}

      {/* Nodes */}
      {gridNodes.filter((n: any) => n.type !== "region").map((node: any) => {
        const pos = nodePositions[node.id];
        if (!pos) return null;
        return (
          <div data-node-id={node.id}
               class={[
                 "absolute rounded-xl border px-3 py-2.5 text-center",
                 node.projected ? "border-dashed" : "",
                 BORDER[node.color_token] ?? BORDER.zinc,
               ].join(" ")}
               style={`top:${pos.top}%;left:${pos.left}%;width:${pos.width}%;background:rgba(0,0,0,0.28)`}>
            <div class={`text-[11px] font-semibold leading-snug ${TEXT[node.color_token] ?? TEXT.zinc}`}
                 style="font-family:'Inter',sans-serif">
              {node.label}
            </div>
            {!isCompact && (
              <div class="text-[8px] font-mono text-zinc-600 mt-0.5 leading-snug">{node.detail}</div>
            )}
            {node.projected && (
              <div class="text-[7px] font-mono text-amber-500/50 mt-1 uppercase tracking-widest">projected</div>
            )}
          </div>
        );
      })}

      {/* SVG arrow overlay */}
      <svg class="ce-flow-svg absolute inset-0 w-full h-full pointer-events-none" style="overflow:visible;z-index:10">
        <defs>
          {(["amber","orange","teal","green","purple","blue","zinc","gold","red"] as const).map(color => {
            const HEX = {
              amber:"#f59e0b",orange:"#f97316",teal:"#0d9488",green:"#22c55e",
              purple:"#a78bfa",blue:"#60a5fa",zinc:"#71717a",gold:"#f59e0b",red:"#ef4444"
            };
            return (
              <marker id={`${uid}-arr-${color}`} markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto" markerUnits="strokeWidth">
                <path d="M0,0 L0,6 L8,3 z" fill={HEX[color]} opacity="0.75" />
              </marker>
            );
          })}
        </defs>
      </svg>
    </div>
  )}

  {/* ── Flow legend (full mode only, non-full-mmt) ────────────────────── */}
  {!isCompact && economy.layout_template !== "full-mmt" && economy.layout_template !== "dual-territory" && (economy.flows).length > 0 && (
    <div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-4 pt-3 border-t border-[#1e1e23]">
      {(economy.flows).map((flow: any) => {
        const HEX = { amber:"#f59e0b",orange:"#f97316",teal:"#0d9488",green:"#22c55e",purple:"#a78bfa",blue:"#60a5fa",zinc:"#71717a",gold:"#f59e0b",red:"#ef4444" };
        const hex = HEX[flow.color_token] ?? "#71717a";
        const label = flow.label.replace(/[←→①②③④⑤★]/g,"").trim();
        return (
          <div class="flex items-center gap-1.5">
            <div class="w-5 h-px" style={`background:${hex};opacity:0.7`}></div>
            <div class="w-0 h-0 border-t-[3px] border-b-[3px] border-l-[5px] border-transparent" style={`border-left-color:${hex};opacity:0.7`}></div>
            <span class="text-[9px] font-mono text-zinc-600">{label}</span>
          </div>
        );
      })}
    </div>
  )}

  {/* ── Economy metadata (full mode) ─────────────────────────────────── */}
  {!isCompact && (
    <div class="grid grid-cols-2 gap-3 mt-4">
      <div class="rounded-lg border border-[#1e1e23] px-3 py-2.5" style="background:#131316">
        <div class="text-[8px] font-mono text-zinc-700 uppercase tracking-widest mb-1">Economy Type</div>
        <div class="text-[11px] font-semibold text-zinc-200" style="font-family:'Inter',sans-serif">{economy.economy_type}</div>
      </div>
      <div class="rounded-lg border border-[#1e1e23] px-3 py-2.5" style="background:#131316">
        <div class="text-[8px] font-mono text-zinc-700 uppercase tracking-widest mb-1">Real-World Analogue</div>
        <div class="text-[11px] font-semibold text-zinc-200" style="font-family:'Inter',sans-serif">{economy.real_world_analogue}</div>
      </div>
      {economy.key_innovation && (
        <div class="col-span-2 rounded-lg border border-[#1e1e23] px-3 py-2.5" style="background:#131316">
          <div class="text-[8px] font-mono text-zinc-700 uppercase tracking-widest mb-1">
            Key Innovation {economy.innovation_stars > 0 ? "★".repeat(economy.innovation_stars as number) : ""}
          </div>
          <div class="text-[11px] font-semibold text-zinc-200 mb-1" style="font-family:'Inter',sans-serif">{economy.key_innovation}</div>
          <div class="text-[10px] font-mono text-zinc-600 leading-snug">{economy.key_innovation_note}</div>
        </div>
      )}
      {(economy ).inflation_channels?.length > 0 && (
        <div class="col-span-2 rounded-lg border border-red-900/20 px-3 py-2.5" style="background:rgba(127,29,29,0.07)">
          <div class="text-[8px] font-mono text-red-700 uppercase tracking-widest mb-1.5">Inflation Channels</div>
          <div class="flex flex-col gap-1">
            {(economy ).inflation_channels.map((ch: string) => (
              <div class="flex items-start gap-1.5">
                <span class="text-red-500 shrink-0 text-[10px] mt-0.5">↑</span>
                <span class="text-[10px] font-mono text-zinc-500 leading-snug">{ch}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  )}

  {/* ── GTA VI lineage ────────────────────────────────────────────────── */}
  {!isCompact && economy.gta_vi_lineage && (
    <div class="mt-3 rounded-lg border border-gta-gold/15 px-3 py-2.5" style="background:rgba(245,158,11,0.03)">
      <div class="text-[8px] font-mono text-gta-gold/40 uppercase tracking-widest mb-1">GTA VI Lineage</div>
      <p class="text-[10px] font-mono text-zinc-600 leading-relaxed">{economy.gta_vi_lineage}</p>
    </div>
  )}

</div>

<script>
  // ── Draw SVG flow arrows for positioned layouts ───────────────────────────
  document.querySelectorAll<HTMLElement>(".ce-node-grid").forEach(grid => {
    const flows = JSON.parse(grid.dataset.flows || "[]") as any[];
    const uid   = grid.dataset.uid ?? "";
    const svg   = grid.querySelector<SVGSVGElement>(".ce-flow-svg");
    if (!svg || !flows.length) return;

    const HEX = {
      amber:"#f59e0b", orange:"#f97316", teal:"#0d9488", green:"#22c55e",
      purple:"#a78bfa", blue:"#60a5fa", zinc:"#71717a", gold:"#f59e0b", red:"#ef4444",
    };

    function getEdgePt(el: HTMLElement, gridRect: DOMRect, dir: string, offset = 0) {
      const r = el.getBoundingClientRect();
      const x = r.left - gridRect.left, y = r.top - gridRect.top;
      const w = r.width, h = r.height;
      if (dir === "top")    return { x: x + w/2 + offset, y };
      if (dir === "bottom") return { x: x + w/2 + offset, y: y + h };
      if (dir === "left")   return { x, y: y + h/2 + offset };
      if (dir === "right")  return { x: x + w, y: y + h/2 + offset };
      return { x: x + w/2, y: y + h/2 };
    }

    function bestEdges(fromEl: HTMLElement, toEl: HTMLElement, gridRect: DOMRect, offset = 0) {
      const fr = fromEl.getBoundingClientRect(), tr = toEl.getBoundingClientRect();
      const fCx = fr.left + fr.width/2, fCy = fr.top + fr.height/2;
      const tCx = tr.left + tr.width/2, tCy = tr.top  + tr.height/2;
      const dx = tCx - fCx, dy = tCy - fCy;
      if (Math.abs(dx) >= Math.abs(dy)) {
        const fd = dx > 0 ? "right" : "left", td = dx > 0 ? "left" : "right";
        return { from: getEdgePt(fromEl, gridRect, fd, 0), to: getEdgePt(toEl, gridRect, td, offset) };
      }
      const fd = dy > 0 ? "bottom" : "top", td = dy > 0 ? "top" : "bottom";
      return { from: getEdgePt(fromEl, gridRect, fd, offset), to: getEdgePt(toEl, gridRect, td, 0) };
    }

    function addArrow(flow: any, gridRect: DOMRect, passOffset: number) {
      const fromEl = grid.querySelector<HTMLElement>(`[data-node-id="${flow.from}"]`);
      const toEl   = grid.querySelector<HTMLElement>(`[data-node-id="${flow.to}"]`);
      if (!fromEl || !toEl) return;

      const edges = bestEdges(fromEl, toEl, gridRect, passOffset * 7);
      const p1 = edges.from, p2 = edges.to;
      const hex = HEX[flow.color_token] ?? "#71717a";
      const isDashed = flow.projected || !flow.active;

      // Quadratic bezier with mild curve
      const midX = (p1.x + p2.x) / 2, midY = (p1.y + p2.y) / 2;
      const dx = p2.x - p1.x, dy = p2.y - p1.y;
      const curvature = flow.bidirectional ? 0.18 : 0.1;
      const cx = midX - dy * curvature, cy = midY + dx * curvature;

      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", `M${p1.x},${p1.y} Q${cx},${cy} ${p2.x},${p2.y}`);
      path.setAttribute("fill", "none");
      path.setAttribute("stroke", hex);
      path.setAttribute("stroke-width", "1.5");
      path.setAttribute("stroke-opacity", "0.65");
      if (isDashed) path.setAttribute("stroke-dasharray", "4,3");
      path.setAttribute("marker-end", `url(#${uid}-arr-${flow.color_token})`);
      svg.appendChild(path);

      // Label at bezier midpoint
      if (flow.label && flow.label.trim()) {
        const bx = 0.25*p1.x + 0.5*cx + 0.25*p2.x;
        const by = 0.25*p1.y + 0.5*cy + 0.25*p2.y;
        const t = document.createElementNS("http://www.w3.org/2000/svg", "text");
        t.setAttribute("x", String(Math.round(bx)));
        t.setAttribute("y", String(Math.round(by) - 5));
        t.setAttribute("text-anchor", "middle");
        t.setAttribute("fill", hex);
        t.setAttribute("font-size", "8");
        t.setAttribute("font-family", "monospace");
        t.setAttribute("opacity", "0.65");
        const label = flow.label.replace(/[①②③④⑤★←→]/g, "").trim().slice(0, 24);
        t.textContent = label;
        svg.appendChild(t);
      }
    }

    // Draw arrows after layout (rAF ensures elements are positioned)
    requestAnimationFrame(() => {
      const gridRect = grid.getBoundingClientRect();
      // Track pair usage to offset parallel/bidirectional flows
      const pairCount = {};
      for (const flow of flows) {
        const key = [flow.from, flow.to].sort().join("|");
        const pass = pairCount[key] ?? 0;
        pairCount[key] = pass + 1;
        addArrow(flow, gridRect, pass);
      }
    });
  });
</script>
