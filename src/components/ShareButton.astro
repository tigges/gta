---
/**
 * ShareButton — pre-filled social share for charts and predictions.
 * Generates Twitter/X intent URL with branded text + gtavi.ai URL.
 * Also provides a copy-link fallback.
 */

interface Props {
  text: string;           // Tweet copy (keep under 240 chars before URL)
  url?: string;           // Page URL to append — defaults to gtavi.ai
  label?: string;         // Button label
  size?: "sm" | "md";
}

const {
  text,
  url = "https://gtavi.ai",
  label = "Share",
  size = "sm",
} = Astro.props;

const tweetText = encodeURIComponent(`${text}\n\n`);
const tweetUrl  = encodeURIComponent(url);
const tweetHref = `https://twitter.com/intent/tweet?text=${tweetText}&url=${tweetUrl}`;

const redditHref = `https://www.reddit.com/submit?url=${tweetUrl}&title=${encodeURIComponent(text)}`;

const sizeClass = size === "md"
  ? "px-3 py-1.5 text-[11px] gap-2"
  : "px-2 py-1 text-[10px] gap-1.5";
---

<div class="share-btn-group flex items-center gap-1.5">
  <!-- X / Twitter -->
  <a
    href={tweetHref}
    target="_blank"
    rel="noopener noreferrer"
    title="Share on X"
    class={`inline-flex items-center font-mono border border-[#2a2a31] text-zinc-500 hover:text-zinc-200 hover:border-zinc-500 rounded transition-all ${sizeClass}`}
    aria-label="Share on X"
  >
    <svg width="12" height="12" viewBox="0 0 1200 1227" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
      <path d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z"/>
    </svg>
    <span>{label}</span>
  </a>

  <!-- Reddit -->
  <a
    href={redditHref}
    target="_blank"
    rel="noopener noreferrer"
    title="Share on Reddit"
    class={`inline-flex items-center font-mono border border-[#2a2a31] text-zinc-500 hover:text-orange-400 hover:border-orange-500/30 rounded transition-all ${sizeClass}`}
    aria-label="Share on Reddit"
  >
    <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
      <path d="M10 0C4.478 0 0 4.478 0 10c0 5.523 4.478 10 10 10 5.523 0 10-4.477 10-10 0-5.522-4.477-10-10-10zm5.4 10.187a1.5 1.5 0 00-2.534-1.006c-.747-.481-1.752-.787-2.85-.838l.549-2.574 1.773.375a1.065 1.065 0 102.128-.124 1.065 1.065 0 00-2.066.405l-1.978-.419a.213.213 0 00-.251.16l-.612 2.868c-1.134.038-2.162.342-2.921.831a1.5 1.5 0 10-1.644 2.434 2.75 2.75 0 000 .356c0 1.812 2.108 3.28 4.706 3.28 2.598 0 4.706-1.468 4.706-3.28 0-.121-.013-.24-.036-.358A1.503 1.503 0 0015.4 10.187zm-7.9 1.063a.75.75 0 111.5 0 .75.75 0 01-1.5 0zm4.194 1.987a2.6 2.6 0 01-1.694.534 2.6 2.6 0 01-1.694-.534.213.213 0 01.3-.303c.376.333.87.518 1.394.518.524 0 1.018-.185 1.394-.518a.213.213 0 01.3.303zm-.194-1.237a.75.75 0 110-1.5.75.75 0 010 1.5z"/>
    </svg>
    <span>Post</span>
  </a>

  <!-- Copy link -->
  <button
    class={`copy-link-btn inline-flex items-center font-mono border border-[#2a2a31] text-zinc-500 hover:text-zinc-200 hover:border-zinc-500 rounded transition-all ${sizeClass}`}
    data-url={url}
    title="Copy link"
    aria-label="Copy link"
  >
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <span class="copy-label">Copy</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-link-btn").forEach(btn => {
    btn.addEventListener("click", async () => {
      // Base URL from the prop (server-rendered). If it has no fragment yet,
      // try to auto-append the id of the nearest chart container inside the
      // same section — so "Copy" from a chart footer lands on that exact chart.
      let url = btn.dataset.url ?? window.location.href;
      if (!url.includes("#")) {
        const section = btn.closest("section");
        const chartEl = section?.querySelector<HTMLElement>("[id]");
        if (chartEl?.id) url = url + "#" + chartEl.id;
      }
      try {
        await navigator.clipboard.writeText(url);
        const label = btn.querySelector<HTMLElement>(".copy-label");
        if (label) {
          label.textContent = "Copied!";
          setTimeout(() => { label.textContent = "Copy"; }, 2000);
        }
      } catch {
        // fallback: select text
      }
    });
  });
</script>
