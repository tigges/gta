---
import trendsData from "../../data/gta-5/trends/search-interest.json";
---

<div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
  <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
    <div>
      <div class="font-semibold text-zinc-200 text-sm">Search Interest Over Time</div>
      <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Google Trends — all GTA keywords, worldwide (0–100)</div>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      {trendsData.keywords.map((kw) => (
        <button
          class="trend-toggle flex items-center gap-1.5 text-[11px] font-mono text-zinc-400 hover:text-zinc-200 transition-colors"
          data-keyword={kw.keyword}
          data-active="true"
        >
          <span class="w-2.5 h-0.5 rounded inline-block" style={`background:${kw.color}`}></span>
          {kw.keyword}
        </button>
      ))}
    </div>
  </div>
  <div id="trends-chart" class="w-full h-64 px-4 py-2" data-keywords={JSON.stringify(trendsData.keywords)}></div>
  <div class="px-5 py-3 border-t border-[#1e1e23]">
    <span class="text-[10px] text-zinc-500 font-mono">Source: Google Trends via pytrends · Updated {new Date(trendsData.last_updated).toLocaleDateString("en-GB", { month: "short", year: "numeric" })}</span>
  </div>
</div>

<script>
  import * as d3 from "d3";
  import { registerChart } from "../assets/chartInit";

  document.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById("trends-chart");
    if (!el) return;

    const keywords: { keyword: string; color: string; data: { date: string; value: number }[] }[] =
      JSON.parse(el.dataset.keywords || "[]");

    // Parse dates
    const allSeries = keywords.map((kw) => ({
      ...kw,
      data: kw.data.map((d) => ({ date: new Date(d.date), value: d.value })),
    }));

    const margin = { top: 10, right: 16, bottom: 32, left: 40 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg")
      .attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g")
      .attr("transform", `translate(${margin.left},${margin.top})`);

    const allDates = allSeries.flatMap((s) => s.data.map((d) => d.date));
    const x = d3.scaleTime().domain(d3.extent(allDates) as [Date, Date]).range([0, W]);
    const y = d3.scaleLinear().domain([0, 100]).range([H, 0]);

    // Grid
    svg.append("g")
      .call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(() => ""))
      .call((g) => g.select(".domain").remove())
      .call((g) => g.selectAll(".tick line").attr("stroke", "#1e1e23").attr("stroke-dasharray", "3,3"));

    // Lines
    const lineGen = d3.line<{ date: Date; value: number }>()
      .x((d) => x(d.date))
      .y((d) => y(d.value))
      .curve(d3.curveMonotoneX);

    const paths: Record<string, d3.Selection<SVGPathElement, unknown, null, undefined>> = {};

    allSeries.forEach((kw) => {
      paths[kw.keyword] = svg.append("path")
        .datum(kw.data)
        .attr("fill", "none")
        .attr("stroke", kw.color)
        .attr("stroke-width", 2)
        .attr("opacity", 0.9)
        .attr("d", lineGen as any);
    });

    // VI trailer annotation
    const trailerDate = new Date("2023-12-05");
    svg.append("line")
      .attr("x1", x(trailerDate)).attr("x2", x(trailerDate))
      .attr("y1", 0).attr("y2", H)
      .attr("stroke", "#ef4444").attr("stroke-width", 1).attr("stroke-dasharray", "4,3").attr("opacity", 0.5);
    svg.append("text")
      .attr("x", x(trailerDate) - 44).attr("y", 12)
      .attr("fill", "#ef4444").attr("font-size", "9").attr("font-family", "monospace")
      .text("VI Trailer");

    // Axes
    svg.append("g")
      .attr("transform", `translate(0,${H})`)
      .call(d3.axisBottom(x).ticks(6).tickFormat(d3.timeFormat("%Y") as any))
      .call((g) => g.select(".domain").attr("stroke", "#3f3f46"))
      .call((g) => g.selectAll(".tick line").attr("stroke", "#3f3f46"))
      .call((g) => g.selectAll("text").attr("fill", "#71717a").attr("font-size", "11").attr("font-family", "monospace"));

    svg.append("g")
      .call(d3.axisLeft(y).ticks(5))
      .call((g) => g.select(".domain").attr("stroke", "#3f3f46"))
      .call((g) => g.selectAll(".tick line").attr("stroke", "#3f3f46"))
      .call((g) => g.selectAll("text").attr("fill", "#71717a").attr("font-size", "11").attr("font-family", "monospace"));

    // Toggle buttons
    document.querySelectorAll<HTMLButtonElement>(".trend-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const kw = btn.dataset.keyword!;
        const active = btn.dataset.active === "true";
        btn.dataset.active = active ? "false" : "true";
        btn.style.opacity = active ? "0.35" : "1";
        paths[kw]?.attr("opacity", active ? 0 : 0.9);
      });
    });
  });

  registerChart("trends-chart", init);
</script>
