---
/**
 * EconomyCircleSEDVI.astro — GTA VI per-title SED variant.
 *
 * Extends the base SED (EconomyCircleSED.astro) for GTA VI:
 *   - Formula unchanged: (J) + Y = C + I
 *   - Color tokens unchanged: all from SED token palette
 *   - GTA VI-specific content: regional income streams, fuel (predicted),
 *     cross-region investment, multi-region GTA$ unity strip
 *   - Marked "Projected" throughout — pre-launch, model-derived
 *
 * Rules:
 *   - No game-identity colours (no --c-title-vi, no pink-coral)
 *   - All colours from SED semantic tokens only
 *   - CSS class names mirror EconomyCircleSED for consistency
 */
import HudIcon   from "./HudIcon.astro";
import GamePill  from "./GamePill.astro";
import ShareDropdown from "./ShareDropdown.astro";

interface Props {
  fullEconomyHref?: string;
  id?: string;
}
const { fullEconomyHref, id: anchorId = "eco-model-vi" } = Astro.props;
const shareText = "GTA VI projected economy: (J) + Y = C + I across multiple regions — Vice City, Leonida, Port Gellhorn and more all share one GTA$. Multi-region currency union. GTAVI.AI";
---

<div class="vi-eco-card">

<div class="vi-eco-wrap">

  <!-- ── ROW 0: Projected badge strip ───────────────────────────────── -->
  <div class="vi-proj-strip">
    <GamePill game="gta-vi" size="xs" />
    <span class="vi-proj-badge">Projected · Pre-Launch</span>
    <span class="vi-proj-note">Model-derived from GTA Online precedent + trailer analysis</span>
  </div>

  <!-- ── SOVEREIGN BAR ────────────────────────────────────────────── -->
  <div class="vi-sovereign">
    <div class="vi-sov-header">
      <span class="vi-sov-eyebrow">Sovereign</span>
      <span class="vi-sov-name">Rockstar / Take-Two</span>
      <span class="vi-sov-detail">Currency issuer · Price setter · Legislature (patch law) · Weekly policy events</span>
    </div>
    <div class="vi-lever-row">
      {[
        "Regional price floors",
        "Shark Card cross-region rates",
        "Mission payout floors per territory",
        "Weekly events — regional bonus rotations",
        "Mobile-linked persistence",
      ].map(l => (
        <span class="vi-lever">{l}</span>
      ))}
    </div>
  </div>

  <!-- ── ROW 1: INJECTION (full width) ─────────────────────────────── -->
  <div class="vi-inject-row">
    <div class="vi-inject-inner">
      <div class="vi-inject-item">
        <div class="vi-blip" style="--bc:var(--c-flow-injection)">
          <HudIcon name="shark-card" size={28} style="color:#fff"/>
        </div>
        <span class="vi-item-label" style="color:var(--c-flow-injection)">Shark Card</span>
      </div>

      <div class="vi-inject-centre">
        <span class="vi-rockstar-label">Rockstar / Take-Two</span>
        <span class="vi-inject-title-row">
          <a class="vi-flow-badge" href="#flow-shark-inject" style="--fb:var(--c-flow-injection)" aria-label="Injection — money flow 4">&#9315;</a>
          <span class="vi-inject-title">INJECTION</span>
        </span>
        <span class="vi-j-flow-note">J &middot; REAL MONEY &#8594; GTA$</span>
      </div>

      <div class="vi-inject-item">
        <div class="vi-blip" style="--bc:var(--c-flow-injection)">
          <HudIcon name="subscription" size={28} style="color:#fff"/>
        </div>
        <span class="vi-item-label" style="color:var(--c-flow-injection)">GTA+</span>
      </div>
    </div>
    <div class="vi-inject-j-bottom">J &#8595;</div>
    <span class="vi-online-note">&#42; GTA VI projected — Shark Cards confirmed at launch</span>
  </div>

  <!-- ── ROW 2: INCOME · Circle hub · EXPENSE ──────────────────────── -->
  <div class="vi-mid-row">

    <div class="vi-income-super">
      <div class="vi-income-super-inner">
        <HudIcon name="dollar" size={26} style="color:var(--c-gta-dollar)"/>
        <span class="vi-income-title">INCOME</span>
      </div>
    </div>

    <div class="vi-circle-hub">
      <div class="vi-tri-in"></div>
      <div class="vi-ring-wrap">
        <div class="vi-ring"></div>
        <div class="vi-ring-centre">
          <HudIcon name="bank" size={28} style="color:var(--c-flow-injection)"/>
          <span class="vi-gta-label">GTA$</span>
          <span class="vi-gta-sub">all regions</span>
        </div>
      </div>
      <div class="vi-tri-out"></div>
    </div>

    <div class="vi-expend-super">
      <div class="vi-expend-super-inner">
        <HudIcon name="buy" size={26} style="color:var(--c-flow-spending)"/>
        <span class="vi-expend-title">EXPENSE</span>
      </div>
    </div>

  </div>

  <!-- ── ROW 3: Y = C + I boxes ────────────────────────────────────── -->
  <div class="vi-box-row">

    <!-- Y — Income -->
    <div class="vi-box vi-income-box">
      <div class="vi-box-top-label" style="color:var(--c-growth)">Y</div>
      <div class="vi-box-inner">
        <div class="vi-box-header">
          <span class="vi-box-title" style="color:var(--c-growth)">INCOME</span>
          <span class="vi-cycle-note" style="color:var(--c-growth)">Y grows &#8594; next cycle</span>
        </div>
        <!-- Two regional income streams — one shared GTA$, two wage levels -->
        <div class="vi-yreg-stack">
          <a class="vi-yreg" href="#flow-vc-income" aria-label="Y1 Vice City income — money flow 1">
            <span class="vi-flow-badge" style="--fb:var(--c-growth)">&#9312;</span>
            <span class="vi-yreg-text">
              <span class="vi-yreg-name" style="color:var(--c-growth)">Y1 &middot; Vice City</span>
              <span class="vi-yreg-sub">High-wage urban territory</span>
            </span>
            <span class="vi-wage" aria-hidden="true"><span class="vi-wage-fill" style="width:90%"></span></span>
          </a>
          <div class="vi-yreg-hr"></div>
          <a class="vi-yreg" href="#flow-leonida-income" aria-label="Y2 Leonida income — money flow 2">
            <span class="vi-flow-badge" style="--fb:var(--c-growth)">&#9313;</span>
            <span class="vi-yreg-text">
              <span class="vi-yreg-name" style="color:var(--c-growth)">Y2 &middot; Leonida</span>
              <span class="vi-yreg-sub">Lower-wage rural territory</span>
            </span>
            <span class="vi-wage" aria-hidden="true"><span class="vi-wage-fill vi-wage-dim" style="width:55%"></span></span>
          </a>
        </div>
        <div class="vi-region-tag" style="border-color:color-mix(in srgb,var(--c-growth) 30%,transparent);color:var(--c-growth)">
          &#9656; Earned via missions &middot; passive &middot; heists — RPP tracks the VC&#8596;Leonida gap
        </div>
      </div>
    </div>

    <!-- = -->
    <div class="vi-divider-eq"><span class="vi-eq-sign">=</span></div>

    <!-- C — Consumption -->
    <div class="vi-box vi-consump-box">
      <div class="vi-box-top-label" style="color:var(--c-flow-spending)">C</div>
      <div class="vi-box-inner">
        <div class="vi-box-header">
          <span class="vi-box-title" style="color:var(--c-flow-spending)">CONSUMPTION</span>
          <span class="vi-cycle-note" style="color:var(--c-flow-spending)">C spent &#8594; lost after use</span>
        </div>
        <div class="vi-icon-row">
          <div class="vi-icon-item">
            <div class="vi-blip-lg" style="--bc:var(--c-flow-spending)">
              <HudIcon name="clothing" size={30} style="color:#fff"/>
            </div>
            <span class="vi-icon-label">Clothing</span>
            <span class="vi-icon-sub">ammo · gear</span>
          </div>
          <div class="vi-icon-item">
            <div class="vi-blip-lg" style="--bc:var(--c-flow-spending)">
              <HudIcon name="car" size={30} style="color:#fff"/>
            </div>
            <span class="vi-icon-label">Fuel ★</span>
            <span class="vi-icon-sub">predicted</span>
          </div>
        </div>
        <div class="vi-region-tag" style="border-color:color-mix(in srgb,var(--c-flow-spending) 30%,transparent);color:var(--c-flow-spending)">
          ★ Fuel mechanic predicted — price varies by region
        </div>
      </div>
    </div>

    <!-- + -->
    <div class="vi-divider-plus"><span class="vi-plus-sign">+</span></div>

    <!-- I — Investment -->
    <div class="vi-box vi-invest-box">
      <div class="vi-box-top-label" style="color:var(--c-economy)">I</div>
      <div class="vi-box-inner">
        <div class="vi-box-header">
          <span class="vi-box-title" style="color:var(--c-economy)">INVESTMENT</span>
          <span class="vi-cycle-note" style="color:var(--c-economy)">I returns to Y &#8594;</span>
        </div>
        <div class="vi-icon-row">
          <div class="vi-icon-item">
            <div class="vi-blip-lg" style="--bc:var(--c-economy)">
              <HudIcon name="property" size={30} style="color:#fff"/>
            </div>
            <span class="vi-icon-label">Property</span>
            <span class="vi-icon-sub">multi-region</span>
          </div>
          <div class="vi-icon-item">
            <div class="vi-blip-lg" style="--bc:var(--c-economy)">
              <HudIcon name="briefcase" size={30} style="color:#fff"/>
            </div>
            <span class="vi-icon-label">Business</span>
            <span class="vi-icon-sub">enterprises</span>
          </div>
        </div>
        <div class="vi-region-tag" style="border-color:color-mix(in srgb,var(--c-economy) 30%,transparent);color:var(--c-economy)">
          &#9656; VC premium ROI · Leonida lower cost · cross-region arbitrage
        </div>
      </div>
    </div>

  </div>

  <!-- ── ROW 4: Multi-region unity strip ───────────────────────────── -->
  <div class="vi-region-strip">
    <a class="vi-flow-badge" href="#flow-cross-territory" style="--fb:var(--c-economy)" aria-label="Cross-territory carry — money flow 3">&#9314;</a>
    <span class="vi-region-title">Free Cross-Territory Player Movement</span>
    <div class="vi-region-dots">
      {["Vice City", "Leonida Keys", "Port Gellhorn", "Grassrivers"].map(r => (
        <span class="vi-region-dot">
          <span class="vi-dot"></span>
          {r}
        </span>
      ))}
    </div>
    <span class="vi-region-eq">— one GTA$ across all regions</span>
  </div>

  <!-- ── INNOVATION + INFLATION BAR ───────────────────────────────── -->
  <div class="vi-meta">
    <div class="vi-innovation">
      <div class="vi-innov-header">
        <span class="vi-innov-star">★★★★</span>
        <span class="vi-innov-label">Key GTA VI Economy Innovation</span>
      </div>
      <div class="vi-innov-title">Regional purchasing parity — two structural economies, one currency</div>
      <div class="vi-innov-note">One monetary authority (Rockstar as ECB), two structurally different regional economies. If price divergence is real, GTA-RPP differs by region — a research axis unique to this site.</div>
      <a class="vi-ppi-chip" href="#flow-vi-ppi" aria-label="Regional purchasing-power index — money flow 5">
        <span class="vi-flow-badge" style="--fb:var(--c-brand)">&#9316;</span>
        <span class="vi-ppi-chip-text">Measured by <strong>GTA-PPI</strong> (VC) + <strong>GTA-RPP</strong> (VC&#247;Leonida) — purchasing-power index, not a money flow</span>
      </a>
    </div>
    <div class="vi-inflation">
      <div class="vi-inf-header">↑ Inflation Channels</div>
      <div class="vi-inf-list">
        {[
          { label: "Regional price divergence",       detail: "Vice City vs Leonida purchasing power gap" },
          { label: "Shark Card ratio degradation",    detail: "Structural — inherits from GTA Online" },
          { label: "Payout nerfs",                    detail: "Expected to continue as live-service mechanic" },
        ].map(ch => (
          <div class="vi-inf-row">
            <span class="vi-inf-arrow">↑</span>
            <div>
              <span class="vi-inf-name">{ch.label}</span>
              <span class="vi-inf-detail"> — {ch.detail}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

</div>

<!-- ── Footer ──────────────────────────────────────────────────────── -->
<div id={anchorId} class="vi-eco-footer" style="scroll-margin-top:72px">
  <span class="vi-footer-formula">GTA VI Projected · (J) + Y = C + I · Multi-Region Currency Union</span>
  <div style="flex:1"></div>
  {fullEconomyHref && (
    <a href={fullEconomyHref} class="text-[10px] font-mono text-zinc-400 hover:text-zinc-200 transition-colors uppercase tracking-widest shrink-0">Full model →</a>
  )}
  <span class="vi-footer-brand">GTAVI.AI</span>
  <ShareDropdown anchorId={anchorId} shareText={shareText} size="sm" />
</div>

</div>

<style>
/* ── Root card ────────────────────────────────────────────────────── */
.vi-eco-card {
  width: 100%;
  border-radius: 12px;
  border: 1px solid var(--c-border-1);
  background: var(--c-card);
  font-family: var(--font-mono, monospace);
}
.vi-eco-wrap {
  overflow: hidden;
  border-radius: 12px 12px 0 0;
}

/* ── Row 0: Projected badge ───────────────────────────────────────── */
.vi-proj-strip {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 6px 16px;
  background: color-mix(in srgb, var(--c-brand) 6%, var(--c-bg-deep));
  border-bottom: 1px solid var(--c-border-1);
}
.vi-proj-badge {
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .12em;
  color: var(--c-brand);
  border: 1px solid color-mix(in srgb, var(--c-brand) 35%, transparent);
  background: color-mix(in srgb, var(--c-brand) 12%, transparent);
  border-radius: 4px;
  padding: 2px 7px;
  white-space: nowrap;
}
.vi-proj-note {
  font-size: 9px;
  color: var(--c-text-5);
  letter-spacing: .04em;
}

/* ── Row 1: Injection ─────────────────────────────────────────────── */
.vi-inject-row {
  position: relative;
  border-bottom: 1px solid var(--c-border-1);
  border-left: 3px solid color-mix(in srgb, var(--c-flow-injection) 55%, transparent);
  background: color-mix(in srgb, var(--c-flow-injection) 5%, transparent);
  padding: 12px 16px 28px;
}
.vi-inject-title-row { display: flex; align-items: center; gap: 8px; }
.vi-inject-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48px;
}
.vi-inject-item { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.vi-item-label  { font-size: 9px; text-transform: uppercase; letter-spacing: .1em; }
.vi-inject-centre { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.vi-rockstar-label { font-size: 9px; color: var(--c-flow-injection); opacity: var(--o-secondary); letter-spacing: .25em; text-transform: uppercase; }
.vi-inject-title { font-size: clamp(0.85rem, 2.5vw, 1.3rem); font-weight: 900; line-height: 1; color: var(--c-flow-injection); }
.vi-j-flow-note {
  font-size: 9px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .1em; color: var(--c-flow-injection);
  opacity: var(--o-secondary); text-align: center; margin-top: 4px;
}
.vi-inject-j-bottom {
  position: absolute; bottom: -7px; left: 50%; transform: translateX(-50%);
  font-size: 1.1rem; font-weight: 900; line-height: 1;
  color: var(--c-flow-injection); background: var(--c-card);
  padding: 2px 8px; border-radius: 4px; z-index: 10; white-space: nowrap;
}
.vi-online-note {
  position: absolute; top: 8px; right: 12px;
  font-size: 9px; color: var(--c-text-5);
}

/* ── Row 2: INCOME · Circle · EXPENSE ────────────────────────────── */
.vi-mid-row {
  display: grid;
  grid-template-columns: 40% auto 1fr;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid var(--c-border-1);
  background: rgba(0, 0, 0, .2);
}
.vi-income-super {
  display: flex; align-items: center; justify-content: flex-end; padding-right: 12px;
}
.vi-income-super-inner {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 16px;
  border: 1.5px solid color-mix(in srgb, var(--c-gta-dollar) 35%, transparent);
  border-radius: 8px;
  background: color-mix(in srgb, var(--c-gta-dollar) 7%, transparent);
}
.vi-income-title { font-size: clamp(1rem, 2.5vw, 1.6rem); font-weight: 900; color: var(--c-gta-dollar); letter-spacing: -.01em; }

.vi-circle-hub { display: flex; align-items: center; gap: 0; justify-content: center; }
.vi-ring-wrap { position: relative; width: 120px; height: 120px; flex-shrink: 0; z-index: 5; }
.vi-ring {
  position: absolute; inset: 0; border-radius: 50%;
  background: conic-gradient(
    from 137.5deg,
    var(--c-economy)         0deg  75deg,
    var(--c-growth)         75deg 200deg,
    var(--c-flow-injection) 200deg 245deg,
    var(--c-flow-spending)  245deg 325deg,
    var(--c-economy)        325deg 360deg
  );
  -webkit-mask: radial-gradient(circle, transparent 42px, black 44px);
  mask:         radial-gradient(circle, transparent 42px, black 44px);
  opacity: .95;
}
.vi-ring-centre {
  position: absolute; inset: 14px; border-radius: 50%;
  background: color-mix(in srgb, var(--c-bg-deep) 90%, transparent);
  border: 1.5px solid color-mix(in srgb, var(--c-gta-dollar) 35%, transparent);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px;
}
.vi-gta-label { font-size: 14px; font-weight: 900; color: var(--c-gta-dollar); }
.vi-gta-sub   { font-size: 9px; color: var(--c-text-5); text-transform: uppercase; letter-spacing: .08em; }

.vi-tri-in {
  width: 0; height: 0;
  border-top: 22px solid transparent; border-bottom: 22px solid transparent;
  border-left: 28px solid color-mix(in srgb, var(--c-growth) 80%, transparent);
  flex-shrink: 0;
  filter: drop-shadow(0 0 4px color-mix(in srgb, var(--c-growth) 40%, transparent));
}
.vi-tri-out {
  width: 0; height: 0;
  border-top: 22px solid transparent; border-bottom: 22px solid transparent;
  border-left: 28px solid color-mix(in srgb, var(--c-flow-spending) 80%, transparent);
  flex-shrink: 0;
  filter: drop-shadow(0 0 4px color-mix(in srgb, var(--c-flow-spending) 40%, transparent));
}
.vi-expend-super { display: flex; align-items: center; padding-left: 12px; }
.vi-expend-super-inner {
  display: flex; align-items: center; gap: 10px; padding: 8px 16px;
  border: 1.5px solid color-mix(in srgb, var(--c-flow-spending) 35%, transparent);
  border-radius: 8px;
  background: color-mix(in srgb, var(--c-flow-spending) 7%, transparent);
}
.vi-expend-title { font-size: clamp(1rem, 2.5vw, 1.6rem); font-weight: 900; color: var(--c-flow-spending); letter-spacing: -.01em; }

/* ── Row 3: Y = C + I boxes ──────────────────────────────────────── */
.vi-box-row { display: flex; align-items: stretch; }
.vi-box { flex: 1; min-width: 0; position: relative; display: flex; flex-direction: column; }
.vi-income-box  { background: color-mix(in srgb, var(--c-growth) 22%, var(--c-bg-deep)); border-left: 3px solid color-mix(in srgb, var(--c-growth) 55%, transparent); }
.vi-consump-box { background: color-mix(in srgb, var(--c-flow-spending) 20%, var(--c-bg-deep)); border-left: 3px solid color-mix(in srgb, var(--c-flow-spending) 55%, transparent); }
.vi-invest-box  { background: color-mix(in srgb, var(--c-economy) 18%, var(--c-bg-deep)); border-left: 3px solid color-mix(in srgb, var(--c-economy) 55%, transparent); }

.vi-box-top-label {
  position: absolute; top: -11px; left: 50%; transform: translateX(-50%);
  font-size: 1.1rem; font-weight: 900; background: var(--c-card);
  padding: 0 4px; z-index: 10; line-height: 1;
}
.vi-box-inner { flex: 1; padding: 18px 14px; display: flex; flex-direction: column; gap: 10px; }
.vi-box-header { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.vi-box-title { font-size: clamp(0.75rem, 2vw, 1.1rem); font-weight: 900; line-height: 1; }
.vi-icon-row { display: flex; gap: 12px; }
.vi-icon-item { display: flex; flex-direction: column; align-items: center; gap: 3px; }
.vi-icon-label { font-size: 9px; color: var(--c-text-3); text-align: center; font-weight: 600; }
.vi-icon-sub   { font-size: 9px; color: var(--c-text-5); text-align: center; }
.vi-cycle-note { font-size: 9px; text-transform: uppercase; letter-spacing: .1em; opacity: var(--o-secondary); margin-left: auto; text-align: right; }

/* Regional finding tag inside each box — first-class, pinned to box bottom */
.vi-region-tag {
  margin-top: auto;
  font-size: 11px; font-family: var(--font-mono, monospace);
  border: 1px solid; border-radius: 5px;
  padding: 5px 9px; line-height: 1.45;
}

/* ── Regional income streams (Y1 / Y2) inside the single Y box ─────── */
.vi-yreg-stack { display: flex; flex-direction: column; }
.vi-yreg {
  display: flex; align-items: center; gap: 10px;
  padding: 7px 5px; border-radius: 6px;
  text-decoration: none; transition: background .15s ease;
}
.vi-yreg:hover { background: color-mix(in srgb, var(--c-growth) 9%, transparent); }
.vi-yreg-hr {
  height: 1px; margin: 1px 5px;
  background: color-mix(in srgb, var(--c-growth) 18%, var(--c-border-1));
}
.vi-yreg-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
.vi-yreg-name { font-size: 12px; font-weight: 800; line-height: 1.1; }
.vi-yreg-sub  { font-size: 10px; color: var(--c-text-4); line-height: 1.2; }
.vi-wage {
  width: 48px; height: 6px; border-radius: 3px; flex-shrink: 0; overflow: hidden;
  background: color-mix(in srgb, var(--c-growth) 12%, var(--c-bg-deep));
}
.vi-wage-fill { display: block; height: 100%; border-radius: 3px; background: var(--c-growth); }
.vi-wage-dim  { background: color-mix(in srgb, var(--c-growth) 55%, var(--c-bg-deep)); }

/* ── Flow wayfinding badge — links diagram element → numbered flow ─── */
.vi-flow-badge {
  font-family: var(--font-mono, monospace); font-size: 18px; font-weight: 900;
  line-height: 1; color: var(--fb, var(--c-text-4)); text-decoration: none; flex-shrink: 0;
}
.vi-flow-badge:hover { filter: brightness(1.2); }

/* Flow ③ title on the multi-region strip */
.vi-region-title {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
