---
import vehicleData from "../../data/gta-5/vehicles/performance.json";
import ShareDropdown from "./ShareDropdown.astro";

// Collapse the "(NR)" suffix variants for the filter buttons so the list stays short
const rawClasses = [...new Set(vehicleData.vehicles.map((v) => v.class))].sort();
const baseClasses = [...new Set(rawClasses.map((c) => c.replace(/ \(NR\)$/, "")))].sort();
---

<div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
  <div class="px-5 py-4 border-b border-border-dim flex items-start justify-between flex-wrap gap-3">
    <div>
      <div class="font-semibold text-zinc-200 text-sm">GTA V — Vehicle Performance (Lap Times)</div>
      <div class="text-[11px] text-zinc-500 font-mono mt-0.5">
        Broughy1322 test track · {vehicleData.vehicles.length} vehicles · lower lap time = faster
      </div>
    </div>
    <div class="flex flex-wrap gap-1.5">
      <button
        class="class-filter px-2.5 py-1 rounded text-[10px] font-mono border border-gta-gold/40 text-gta-gold bg-gta-gold/8 transition-all"
        data-class="All"
        data-active="true"
      >All</button>
      {baseClasses.map((cls) => (
        <button
          class="class-filter px-2.5 py-1 rounded text-[10px] font-mono border border-border-mid text-zinc-500 hover:border-zinc-600 hover:text-zinc-300 transition-all"
          data-class={cls}
          data-active="false"
        >{cls}</button>
      ))}
    </div>
  </div>
  <div
    id="vehicle-chart"
    class="w-full overflow-hidden"
    data-vehicles={JSON.stringify(vehicleData.vehicles)}
  ></div>
  <div class="px-5 py-3 border-t border-border-dim flex items-center justify-between gap-3">
    <span class="text-[10px] text-zinc-600 font-mono">Source: Broughy1322 · Updated {new Date(vehicleData.last_updated).toLocaleDateString("en-GB", { month: "short", year: "numeric" })}</span>
    <div class="flex items-center gap-2 shrink-0">
      <span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span>
      <ShareDropdown anchorId="vehicle-chart" shareText="GTA V vehicle performance: 737 vehicles benchmarked by Broughy1322 on his standard test track. Lap times, top speeds, and tier ratings." size="sm" />
    </div>
  </div>
</div>

<script>
  import * as d3 from "d3";
  import { cc, op } from "../assets/chartColors";
  import { registerChart, triggerChart } from "../assets/chartInit";

  interface Vehicle {
    name: string;
    class: string;
    tier: string | null;
    lap_time: string | null;
    lap_seconds: number | null;
    top_speed_mph: number | null;
  }

  // Colour per broad class (NR variants share the same colour as their base).
  // Token-mapped where a category colour exists; the remaining classes keep
  // their distinct hues (no token yet) — mirrors ChartVehiclePerformance.
  const CLASS_COLORS: Record<string, string> = {
    Supers:          cc.bar,
    Sports:          cc.green,
    "Sports Classics": "#86efac",
    Muscle:          cc.red,
    Coupes:          cc.purple,
    Sedans:          "#38bdf8",
    SUVs:            cc.orange,
    "Open Wheel":    "#f472b6",
    "Off-Road":      "#a3e635",
    Military:        "#6b7280",
    Emergency:       "#60a5fa",
    Commercial:      "#78716c",
  };

  function classColor(cls: string): string {
    const base = cls.replace(/ \(NR\)$/, "");
    return CLASS_COLORS[base] ?? cc.text4;
  }

  let allVehicles: Vehicle[] = [];
  let activeClass = "All";

  function render(vehicles: Vehicle[]) {
    const el = document.getElementById("vehicle-chart")!;
    el.innerHTML = ""; // clears previous render before redraw (filter-triggered rerenders are intentional)

    const filtered = vehicles
      .filter((v) => v.lap_seconds !== null)
      .filter((v) => {
        if (activeClass === "All") return true;
        const base = v.class.replace(/ \(NR\)$/, "");
        return base === activeClass;
      })
      .sort((a, b) => (a.lap_seconds ?? 999) - (b.lap_seconds ?? 999))
      .slice(0, 25);

    if (filtered.length === 0) {
      el.innerHTML = `<p class="text-xs text-zinc-600 font-mono py-4">No vehicles with lap data in this class.</p>`;
      return;
    }

    const barH = 26;
    const gap = 4;
    const margin = { top: 4, right: 80, bottom: 4, left: 150 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = filtered.length * (barH + gap);

    const svg = d3
      .select(el)
      .append("svg")
      .attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${H + margin.top + margin.bottom}`)
      .append("g")
      .attr("transform", `translate(${margin.left},${margin.top})`);

    const minLap = d3.min(filtered, (d) => d.lap_seconds) ?? 50;
    const maxLap = d3.max(filtered, (d) => d.lap_seconds) ?? 70;

    // Invert scale: shorter lap = longer bar
    const x = d3.scaleLinear().domain([minLap - 0.5, maxLap + 0.5]).range([W, 0]);

    filtered.forEach((v, i) => {
      const y = i * (barH + gap);
      const barW = x(minLap - 0.5) - x(v.lap_seconds ?? maxLap);
      const color = classColor(v.class);

      svg.append("rect")
        .attr("x", x(v.lap_seconds ?? maxLap))
        .attr("y", y)
        .attr("width", Math.max(barW, 2))
        .attr("height", barH)
        .attr("rx", 3)
        .attr("fill", color)
        .attr("opacity", op.secondary);

      // Vehicle name label (left)
      svg.append("text")
        .attr("x", -8)
        .attr("y", y + barH / 2 + 1)
        .attr("text-anchor", "end")
        .attr("dominant-baseline", "middle")
        .attr("fill", cc.text2)
        .attr("font-size", "12")
        .attr("font-family", "monospace")
        .text(v.name.length > 18 ? v.name.slice(0, 17) + "…" : v.name);

      // Lap time + speed (right)
      const label = v.top_speed_mph
        ? `${v.lap_time}  ${v.top_speed_mph}mph`
        : (v.lap_time ?? "");
      svg.append("text")
        .attr("x", W + 6)
        .attr("y", y + barH / 2 + 1)
        .attr("dominant-baseline", "middle")
        .attr("fill", color)
        .attr("font-size", "10")
        .attr("font-family", "monospace")
        .attr("font-weight", "500")
        .text(label);

      // Top-3 rank badge
      if (i < 3) {
        svg.append("rect")
          .attr("x", x(v.lap_seconds ?? maxLap) + 6)
          .attr("y", y + 5)
          .attr("width", 18)
          .attr("height", 16)
          .attr("rx", 2)
          .attr("fill", cc.bgDeep)
          .attr("opacity", op.secondary);
        svg.append("text")
          .attr("x", x(v.lap_seconds ?? maxLap) + 15)
          .attr("y", y + barH / 2 + 1)
          .attr("text-anchor", "middle")
          .attr("dominant-baseline", "middle")
          .attr("fill", color)
          .attr("font-size", "10")
          .attr("font-family", "monospace")
          .attr("font-weight", "700")
          .text(`#${i + 1}`);
      }

      // Tier badge (if set)
      if (v.tier) {
        svg.append("text")
          .attr("x", x(v.lap_seconds ?? maxLap) + (i < 3 ? 30 : 6))
          .attr("y", y + barH / 2 + 1)
          .attr("dominant-baseline", "middle")
          .attr("fill", color)
          .attr("font-size", "9")
          .attr("font-family", "monospace")
          .attr("opacity", op.tertiary)
          .text(`T${v.tier}`);
      }
    });
  }

  function init() {
    const el = document.getElementById("vehicle-chart") as HTMLElement | null;
    if (!el) return;
    if (el.clientWidth === 0) { requestAnimationFrame(init); return; }

    allVehicles = JSON.parse(el.dataset.vehicles || "[]");
    render(allVehicles);

    document.querySelectorAll<HTMLButtonElement>(".class-filter").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLButtonElement>(".class-filter").forEach((b) => {
          b.dataset.active = "false";
          b.classList.remove("border-gta-gold", "text-gta-gold", "bg-gta-gold/10");
          b.classList.add("border-zinc-700", "text-zinc-500");
        });
        btn.dataset.active = "true";
        btn.classList.add("border-gta-gold", "text-gta-gold", "bg-gta-gold/10");
        btn.classList.remove("border-zinc-700", "text-zinc-500");
        activeClass = btn.dataset.class!;
        render(allVehicles);
      });
    });
  }

  registerChart("vehicle-chart", init);

  if ("IntersectionObserver" in window) {
    const obsEl = document.getElementById("vehicle-chart");
    if (obsEl) {
      const obs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { triggerChart("vehicle-chart"); obs.disconnect(); }
      }, { rootMargin: "200px" });
      obs.observe(obsEl);
    }
  } else { init(); }
</script>
