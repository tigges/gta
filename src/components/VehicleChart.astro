---
import vehicleData from "../../data/gta-5/vehicles/performance.json";

// Collapse the "(NR)" suffix variants for the filter buttons so the list stays short
const rawClasses = [...new Set(vehicleData.vehicles.map((v) => v.class))].sort();
const baseClasses = [...new Set(rawClasses.map((c) => c.replace(/ \(NR\)$/, "")))].sort();
---

<div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
  <div class="flex items-start justify-between flex-wrap gap-3 mb-4">
    <div>
      <h3 class="font-mono font-semibold text-zinc-50 text-sm uppercase tracking-wider">
        GTA V — Vehicle Performance (Lap Times)
      </h3>
      <p class="text-xs text-zinc-500 mt-0.5">
        Broughy1322 test track · {vehicleData.vehicles.length} vehicles tested · lower is faster
      </p>
    </div>
    <div class="flex flex-wrap gap-1.5">
      <button
        class="class-filter px-2.5 py-1 rounded text-xs font-mono border border-amber-500 text-amber-400 bg-amber-500/10 transition-colors"
        data-class="All"
        data-active="true"
      >All</button>
      {baseClasses.map((cls) => (
        <button
          class="class-filter px-2.5 py-1 rounded text-xs font-mono border border-zinc-700 text-zinc-500 hover:border-amber-500 hover:text-amber-400 transition-colors"
          data-class={cls}
          data-active="false"
        >{cls}</button>
      ))}
    </div>
  </div>
  <div
    id="vehicle-chart"
    class="w-full overflow-hidden"
    data-vehicles={JSON.stringify(vehicleData.vehicles)}
  ></div>
  <p class="text-xs text-zinc-700 font-mono mt-3">
    Source: Broughy1322 · Updated {new Date(vehicleData.last_updated).toLocaleDateString("en-GB", { month: "short", year: "numeric" })}
  </p>
</div>

<script>
  import * as d3 from "d3";

  interface Vehicle {
    name: string;
    class: string;
    tier: string | null;
    lap_time: string | null;
    lap_seconds: number | null;
    top_speed_mph: number | null;
  }

  // Colour per broad class (NR variants share the same colour as their base)
  const CLASS_COLORS: Record<string, string> = {
    Supers:          "#f59e0b",
    Sports:          "#22c55e",
    "Sports Classics": "#86efac",
    Muscle:          "#ef4444",
    Coupes:          "#a78bfa",
    Sedans:          "#38bdf8",
    SUVs:            "#fb923c",
    "Open Wheel":    "#f472b6",
    "Off-Road":      "#a3e635",
    Military:        "#6b7280",
    Emergency:       "#60a5fa",
    Commercial:      "#78716c",
  };

  function classColor(cls: string): string {
    const base = cls.replace(/ \(NR\)$/, "");
    return CLASS_COLORS[base] ?? "#71717a";
  }

  let allVehicles: Vehicle[] = [];
  let activeClass = "All";

  function render(vehicles: Vehicle[]) {
    const el = document.getElementById("vehicle-chart")!;
    el.innerHTML = "";

    const filtered = vehicles
      .filter((v) => v.lap_seconds !== null)
      .filter((v) => {
        if (activeClass === "All") return true;
        const base = v.class.replace(/ \(NR\)$/, "");
        return base === activeClass;
      })
      .sort((a, b) => (a.lap_seconds ?? 999) - (b.lap_seconds ?? 999))
      .slice(0, 25);

    if (filtered.length === 0) {
      el.innerHTML = `<p class="text-xs text-zinc-600 font-mono py-4">No vehicles with lap data in this class.</p>`;
      return;
    }

    const barH = 26;
    const gap = 4;
    const margin = { top: 4, right: 80, bottom: 4, left: 150 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = filtered.length * (barH + gap);

    const svg = d3
      .select(el)
      .append("svg")
      .attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${H + margin.top + margin.bottom}`)
      .append("g")
      .attr("transform", `translate(${margin.left},${margin.top})`);

    const minLap = d3.min(filtered, (d) => d.lap_seconds) ?? 50;
    const maxLap = d3.max(filtered, (d) => d.lap_seconds) ?? 70;

    // Invert scale: shorter lap = longer bar
    const x = d3.scaleLinear().domain([minLap - 0.5, maxLap + 0.5]).range([W, 0]);

    filtered.forEach((v, i) => {
      const y = i * (barH + gap);
      const barW = x(minLap - 0.5) - x(v.lap_seconds ?? maxLap);
      const color = classColor(v.class);

      svg.append("rect")
        .attr("x", x(v.lap_seconds ?? maxLap))
        .attr("y", y)
        .attr("width", Math.max(barW, 2))
        .attr("height", barH)
        .attr("rx", 3)
        .attr("fill", color)
        .attr("opacity", 0.85);

      // Vehicle name label (left)
      svg.append("text")
        .attr("x", -8)
        .attr("y", y + barH / 2 + 1)
        .attr("text-anchor", "end")
        .attr("dominant-baseline", "middle")
        .attr("fill", "#d4d4d8")
        .attr("font-size", "12")
        .attr("font-family", "monospace")
        .text(v.name.length > 18 ? v.name.slice(0, 17) + "…" : v.name);

      // Lap time + speed (right)
      const label = v.top_speed_mph
        ? `${v.lap_time}  ${v.top_speed_mph}mph`
        : (v.lap_time ?? "");
      svg.append("text")
        .attr("x", W + 6)
        .attr("y", y + barH / 2 + 1)
        .attr("dominant-baseline", "middle")
        .attr("fill", color)
        .attr("font-size", "10")
        .attr("font-family", "monospace")
        .attr("font-weight", "500")
        .text(label);

      // Top-3 rank badge
      if (i < 3) {
        svg.append("rect")
          .attr("x", x(v.lap_seconds ?? maxLap) + 6)
          .attr("y", y + 5)
          .attr("width", 18)
          .attr("height", 16)
          .attr("rx", 2)
          .attr("fill", "#09090b")
          .attr("opacity", 0.7);
        svg.append("text")
          .attr("x", x(v.lap_seconds ?? maxLap) + 15)
          .attr("y", y + barH / 2 + 1)
          .attr("text-anchor", "middle")
          .attr("dominant-baseline", "middle")
          .attr("fill", color)
          .attr("font-size", "10")
          .attr("font-family", "monospace")
          .attr("font-weight", "700")
          .text(`#${i + 1}`);
      }

      // Tier badge (if set)
      if (v.tier) {
        svg.append("text")
          .attr("x", x(v.lap_seconds ?? maxLap) + (i < 3 ? 30 : 6))
          .attr("y", y + barH / 2 + 1)
          .attr("dominant-baseline", "middle")
          .attr("fill", color)
          .attr("font-size", "9")
          .attr("font-family", "monospace")
          .attr("opacity", 0.6)
          .text(`T${v.tier}`);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById("vehicle-chart");
    if (!el) return;
    allVehicles = JSON.parse(el.dataset.vehicles || "[]");
    render(allVehicles);

    document.querySelectorAll<HTMLButtonElement>(".class-filter").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLButtonElement>(".class-filter").forEach((b) => {
          b.dataset.active = "false";
          b.classList.remove("border-amber-500", "text-amber-400", "bg-amber-500/10");
          b.classList.add("border-zinc-700", "text-zinc-500");
        });
        btn.dataset.active = "true";
        btn.classList.add("border-amber-500", "text-amber-400", "bg-amber-500/10");
        btn.classList.remove("border-zinc-700", "text-zinc-500");
        activeClass = btn.dataset.class!;
        render(allVehicles);
      });
    });
  });
</script>
