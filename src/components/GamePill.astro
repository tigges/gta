---
/**
 * GamePill — GTA title version identifier pill.
 *
 * Renders a small pill with the game's identity colour from --c-identity
 * resolved via the game prop. Used top-left on every card across the site.
 *
 * Usage:
 *   <GamePill game="gta-vi" />
 *   <GamePill game="gta-online" size="xs" />
 */

interface Props {
  game:
    | "gta-vi"
    | "gta-online"
    | "gta-v"
    | "gta-sa"
    | "gta-vc"
    | "gta-iv"
    | "gta-iii"
    | "franchise";
  size?: "xs" | "sm";
  class?: string;
}

const { game, size = "sm", class: cls = "" } = Astro.props;

const GAME_LABEL: Record<string, string> = {
  "gta-vi":     "GTA VI",
  "gta-online": "GTA Online",
  "gta-v":      "GTA V",
  "gta-sa":     "GTA SA",
  "gta-vc":     "GTA VC",
  "gta-iv":     "GTA IV",
  "gta-iii":    "GTA III",
  "franchise":  "Franchise",
};

// Identity — reads from --c-title-* tokens defined in tokens.css
// CSS var() with hardcoded fallback for runtime safety
const GAME_COLOUR: Record<string, string> = {
  "gta-vi":     "var(--c-title-vi,#ff6b9d)",
  "gta-online": "var(--c-title-online,#00d4e8)",
  "gta-v":      "var(--c-title-v,#f59e0b)",
  "gta-sa":     "var(--c-title-sa,#c0392b)",
  "gta-vc":     "var(--c-title-vc,#ff2d78)",
  "gta-iv":     "var(--c-title-iv,#6b6b7e)",
  "gta-iii":    "var(--c-title-iii,#9898b8)",
  "franchise":  "#f59e0b",
};

const label  = GAME_LABEL[game]  ?? game.toUpperCase();
const colour = GAME_COLOUR[game] ?? "#9898b8";

const sizeClass = size === "xs"
  ? "text-[10px] px-1.5 py-0.5"
  : "text-[11px] px-2 py-0.5";

// Dark opaque backing ensures legibility on any surface — card, image, overlay.
// Identity colour used for text and border ring only; background is near-black.
const bgStyle = `color:${colour};border-color:${colour}55;background:rgba(10,10,13,0.88)`;
---

<span
  class={`inline-flex self-start items-center font-mono uppercase tracking-widest rounded border shrink-0 whitespace-nowrap ${sizeClass} ${cls}`}
  style={bgStyle}
>
  {label}
</span>
