---
/**
 * GamePill — thin wrapper around Badge with surface="opaque".
 *
 * @deprecated — use <Badge variant={game} surface="opaque" /> directly.
 * This wrapper exists to keep all existing call sites working during migration.
 * Remove once all pages have been updated.
 *
 * Usage:
 *   <GamePill game="gta-vi" />         → Badge variant="gta-vi" surface="opaque"
 *   <GamePill game="gta-online" />     → Badge variant="gta-online" surface="opaque"
 */
import Badge from "./Badge.astro";

interface Props {
  game:
    | "gta-vi"
    | "gta-online"
    | "gta-v"
    | "gta-sa"
    | "gta-vc"
    | "gta-iv"
    | "gta-iii"
    | "franchise";
  /** @deprecated — one canonical size only. Accepted but ignored. */
  size?: string;
  class?: string;
}

const { game, class: cls = "" } = Astro.props;
---

<Badge variant={game as any} surface="opaque" class={`self-start shrink-0 whitespace-nowrap ${cls}`} />
