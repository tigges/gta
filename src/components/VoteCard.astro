---
/**
 * VoteCard.astro — Community prediction poll card.
 *
 * Renders a vote card for a prediction question. Two modes:
 *
 * 1. PREDICTION MODE (predictionId): reads question + options from
 *    predictions.json (poll_question + poll_options fields).
 *
 * 2. STANDALONE MODE (question + options): manually specified question
 *    for polls not tied to a specific prediction.
 *
 * Voting:
 *   - POSTs to /api/poll/vote with { pollId, option }
 *   - Uses localStorage to track voted state client-side
 *   - Cloudflare KV stores cumulative vote counts (requires POLL_VOTES KV binding)
 *   - Falls back gracefully if KV is unavailable (shows vote UI, counts from 0)
 *
 * Usage:
 *   <VoteCard predictionId="pred-rdr2-wanted-stars" />
 *   <VoteCard
 *     pollId="custom-poll"
 *     question="Will GTA VI launch on PC day one?"
 *     options={["Yes", "No", "Delayed"]}
 *   />
 */

import type { PredictionsData } from "../types/gta";
import ShareDropdown from "./ShareDropdown.astro";
import GamePill from "./GamePill.astro";
import predRaw from "../../data/gta-6/predictions.json";

interface Props {
  predictionId?: string;
  pollId?:       string;
  question?:     string;
  options?:      string[];
  game?:         "gta-vi" | "gta-online" | "franchise";
  /**
   * Embed mode — suppresses ShareDropdown, replaces footer with
   * a homepage link so external embeds drive traffic back to GTAVI.AI.
   */
  embedMode?: boolean;
}

const {
  predictionId,
  pollId: manualPollId,
  question: manualQuestion,
  options:  manualOptions,
  game = "gta-vi",
  embedMode = false,
} = Astro.props;

const predData = predRaw as unknown as PredictionsData;

// Resolve question and options
let question  = manualQuestion ?? "";
let options:   string[] = manualOptions ?? ["Yes", "No"];
let pollId     = manualPollId ?? predictionId ?? "";
let basis      = "";
let confidence: number | null = null;
let thumbnail: string | null = null;

if (predictionId) {
  const pred = predData.predictions.find((p: any) => p.id === predictionId);
  if (pred) {
    question   = (pred as any).poll_question ?? pred.title;
    options    = (pred as any).poll_options  ?? ["Yes", "No"];
    pollId     = predictionId;
    basis      = pred.basis ?? "";
    confidence = pred.confidence ?? null;
    thumbnail  = (pred as any).thumbnail ?? null;
  }
}

if (!question) throw new Error(`VoteCard: no question resolved for pollId="${pollId}"`);

const anchorId  = `vote-${pollId}`;
const shareText = `${question} — Vote on GTAVI.AI and see what the community thinks.`;
const cardClass = `vc-card ${thumbnail ? "vc-card--with-thumb" : "vc-card--no-thumb"}`;
const cardStyle = embedMode ? "border-radius:0;border-left:none;border-right:none;border-top:none" : "scroll-margin-top:80px";
---

<div class={cardClass} id={anchorId} style={cardStyle}>

  <!-- ── Thumbnail ─────────────────────────────────────────────────────── -->
  {thumbnail && (
    <div class="vc-thumb">
      <img src={thumbnail} alt="" width="400" height="200" loading="lazy" decoding="async" />
      <div class="vc-thumb-overlay"></div>
      <div class="vc-thumb-meta">
        <GamePill game={game} size="xs" />
        <span class="vc-badge">Community Vote</span>
        {confidence !== null && (
          <span class="vc-confidence">{confidence}% confidence</span>
        )}
      </div>
    </div>
  )}

  <!-- ── Header ──────────────────────────────────────────────────────── -->
  {!thumbnail && (
    <div class="vc-header">
      <div class="flex items-center gap-2 flex-wrap">
        <GamePill game={game} size="xs" />
        <span class="vc-badge">Community Vote</span>
        {confidence !== null && (
          <span class="vc-confidence">{confidence}% confidence</span>
        )}
      </div>
    </div>
  )}

  <!-- ── Question ────────────────────────────────────────────────────── -->
  <div class="vc-body">
    <div class="vc-question">{question}</div>

    {basis && <div class="vc-basis">{basis}</div>}

    <!-- Vote options — shown before voting -->
    <div class="vc-options" data-poll-id={pollId} data-options={JSON.stringify(options)} data-question={question}>
      {options.map((opt, i) => (
        <button
          class="vc-option"
          data-option={opt}
          data-index={i}
        >
          {opt}
        </button>
      ))}
    </div>

    <!-- Results — shown after voting (hidden until vote cast) -->
    <div class="vc-results hidden" data-poll-id={pollId}>
      <div class="vc-voted-note hidden">✓ You voted</div>
      {options.map(opt => (
        <div class="vc-result-row" data-option={opt}>
          <div class="vc-result-label">{opt}</div>
          <div class="vc-result-track">
            <div class="vc-result-bar" data-option={opt} style="width:0%"></div>
          </div>
          <div class="vc-result-pct" data-option={opt}>—</div>
        </div>
      ))}
      <div class="vc-vote-count"></div>

    </div>
  </div>

  <!-- ── Footer ──────────────────────────────────────────────────────── -->
  <div class="vc-footer">
    {embedMode ? (
      <a href="https://gtavi.ai" target="_blank" rel="noopener noreferrer" class="vc-home-link">Visit GTAVI.AI →</a>
    ) : (
      <>
        <a href="/" class="vc-footer-label">GTAVI.AI · Community</a>
        <ShareDropdown anchorId={anchorId} shareText={shareText} size="sm" />
      </>
    )}
  </div>

</div>

<style>
.vc-card {
  border-radius: 12px;
  border: 1px solid var(--c-border-1);
  background: var(--c-card);
  font-family: var(--font-mono, monospace);
  overflow: hidden;
}

.vc-header {
  padding: 10px 16px;
  border-bottom: 1px solid var(--c-border-1);
  background: var(--c-bg-deep);
}

/* ── Thumbnail ── */
.vc-thumb {
  position: relative;
  aspect-ratio: 16 / 5;
  overflow: hidden;
  margin-bottom: -22px;
}
.vc-thumb img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .4s ease;
}
.vc-card:hover .vc-thumb img { transform: scale(1.03); }
.vc-thumb-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(
    to bottom,
    transparent 18%,
    color-mix(in srgb, var(--c-card) 96%, transparent) 100%
  );
  pointer-events: none;
}
.vc-thumb-meta {
  position: absolute;
  left: 14px;
  right: 14px;
  top: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  z-index: 2;
}

.vc-badge {
  font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em;
  color: var(--c-brand);
  border: 1px solid color-mix(in srgb, var(--c-brand) 35%, transparent);
  background: color-mix(in srgb, var(--c-brand) 10%, transparent);
  border-radius: 4px; padding: 2px 7px;
}

.vc-confidence {
  font-size: 9px; color: var(--c-text-5); letter-spacing: .06em;
  border: 1px solid color-mix(in srgb, var(--c-text-5) 18%, transparent);
  background: color-mix(in srgb, var(--c-bg-deep) 72%, transparent);
  border-radius: 4px;
  padding: 2px 7px;
}

.vc-body {
  position: relative;
  z-index: 1;
  padding: 28px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.vc-card--no-thumb .vc-body { padding-top: 16px; }

.vc-question {
  font-size: clamp(1rem, 2vw, 1.15rem); font-weight: 700; color: var(--c-text-2); line-height: 1.35;
  font-family: var(--font-sans, sans-serif);
}

.vc-basis {
  font-size: 10px; color: var(--c-text-5); line-height: 1.55;
}

/* ── Options ── */
.vc-options { display: flex; flex-direction: column; gap: 8px; }

.vc-option {
  width: 100%; padding: 10px 14px; border-radius: 8px; cursor: pointer;
  font-size: 11px; font-weight: 700; text-align: left; letter-spacing: .04em;
  font-family: var(--font-mono, monospace);
  color: var(--c-text-3);
  border: 1px solid var(--c-border-1);
  background: var(--c-bg-deep);
  transition: border-color .15s, background .15s, color .15s;
}
.vc-option:hover {
  border-color: color-mix(in srgb, var(--c-brand) 50%, transparent);
  background: color-mix(in srgb, var(--c-brand) 8%, transparent);
  color: var(--c-brand);
}
.vc-option:active { transform: scale(0.99); }

/* ── Results ── */
.vc-results { display: flex; flex-direction: column; gap: 10px; }

.vc-result-row { display: flex; align-items: center; gap: 10px; }

.vc-result-label {
  font-size: 11px; font-weight: 700; color: var(--c-text-3);
  flex: 1; min-width: 0;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.vc-result-track {
  width: 140px; flex-shrink: 0; height: 20px; border-radius: 4px; overflow: hidden;
  background: color-mix(in srgb, var(--c-border-1) 80%, var(--c-bg-deep));
}

.vc-result-bar {
  height: 100%; border-radius: 4px;
  background: var(--c-brand);
  opacity: .8;
  transition: width .6s cubic-bezier(.4,0,.2,1);
}

/* Different colours per option index */
.vc-result-row:nth-child(2) .vc-result-bar { background: var(--c-live); }
.vc-result-row:nth-child(3) .vc-result-bar { background: var(--c-alert); }
.vc-result-row:nth-child(4) .vc-result-bar { background: var(--c-economy); }

.vc-result-pct {
  font-size: 11px; font-weight: 900; color: var(--c-text-3);
  width: 38px; text-align: right; flex-shrink: 0;
}

.vc-vote-count {
  font-size: 9px; color: var(--c-text-5); text-align: right; margin-top: 4px;
}

.vc-voted-note {
  font-size: 9px; color: var(--c-growth); letter-spacing: .06em;
  margin-bottom: 4px;
}

.hidden { display: none !important; }

/* ── Footer ── */
.vc-footer {
  padding: 8px 16px;
  border-top: 1px solid var(--c-border-1);
  background: var(--c-card);
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
}
.vc-footer-label {
  font-size: 9px; font-weight: 700; color: var(--c-text-3); text-transform: uppercase; letter-spacing: .12em;
  transition: color .15s;
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
}
.vc-footer-label:hover { color: var(--c-brand); }

.vc-home-link {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
  font-family: var(--font-mono, monospace);
  color: var(--c-brand); text-decoration: none;
  border: 1px solid color-mix(in srgb, var(--c-brand) 35%, transparent);
  border-radius: 4px; padding: 3px 8px;
  transition: background .15s;
}
.vc-home-link:hover { background: color-mix(in srgb, var(--c-brand) 10%, transparent); }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".vc-options").forEach(container => {
    const pollId   = container.dataset.pollId!;
    const options  = JSON.parse(container.dataset.options || "[]") as string[];
    const question = container.dataset.question || "";
    const card       = container.closest<HTMLElement>(".vc-card")!;
    const results    = card.querySelector<HTMLElement>(".vc-results")!;
    const votedNote  = results.querySelector<HTMLElement>(".vc-voted-note")!;

    // Build the deep-link URL for this specific poll card
    const pollAnchor = `vote-${pollId}`;
    const pollUrl    = `${window.location.origin}${window.location.pathname}#${pollAnchor}`;

    // Update share links to use deep-link anchor from the start
    card.querySelectorAll<HTMLElement>(".share-copy-item").forEach(el => {
      el.dataset.anchor = pollAnchor;
    });
    card.querySelectorAll<HTMLElement>(".share-native-btn").forEach(el => {
      el.dataset.anchor = pollAnchor;
    });

    // Helper: build personalised share text after voting
    function buildShareText(chosenOption: string, votes: Record<string, number>): string {
      const total = Object.values(votes).reduce((s, v) => s + v, 0);
      const myPct = total > 0 ? Math.round(((votes[chosenOption] ?? 1) / total) * 100) : 100;
      const agree = myPct >= 50 ? `${myPct}% agree` : `only ${myPct}% agree`;
      return `I voted "${chosenOption}" — ${agree} (${total} vote${total !== 1 ? "s" : ""}). ${question} → ${pollUrl}`;
    }

    // Helper: update share dropdown links with personalised text
    function updateShareLinks(chosenOption: string, votes: Record<string, number>) {
      const shareText = buildShareText(chosenOption, votes);
      const tweetUrl  = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText + "\n\n")}&url=${encodeURIComponent(pollUrl)}`;
      const redditUrl = `https://www.reddit.com/submit?url=${encodeURIComponent(pollUrl)}&title=${encodeURIComponent(shareText)}`;
      card.querySelectorAll<HTMLAnchorElement>(".share-x-link").forEach(el => { el.href = tweetUrl; });
      card.querySelectorAll<HTMLAnchorElement>(".share-reddit-link").forEach(el => { el.href = redditUrl; });
      card.querySelectorAll<HTMLButtonElement>(".share-native-btn").forEach(el => { el.dataset.text = shareText; });
    }

    const storageKey = `vote:${pollId}`;

    // Helper: animate result bars from fetched data
    function showResults(votes: Record<string, number>) {
      const total = Object.values(votes).reduce((s, v) => s + v, 0);
      options.forEach(opt => {
        const count = votes[opt] ?? 0;
        const pct   = total > 0 ? Math.round((count / total) * 100) : 0;
        const bar   = results.querySelector<HTMLElement>(`.vc-result-bar[data-option="${opt}"]`);
        const pctEl = results.querySelector<HTMLElement>(`.vc-result-pct[data-option="${opt}"]`);
        if (bar)   bar.style.width   = `${pct}%`;
        if (pctEl) pctEl.textContent = `${pct}%`;
      });
      const countEl = results.querySelector<HTMLElement>(".vc-vote-count");
      if (countEl) countEl.textContent = `${total.toLocaleString()} vote${total !== 1 ? "s" : ""}`;
    }

    // If already voted (localStorage), show results immediately
    const storedVote = localStorage.getItem(storageKey);
    if (storedVote) {
      container.classList.add("hidden");
      votedNote.classList.remove("hidden");
      // Show placeholder immediately, then replace with real counts
      const placeholder: Record<string, number> = {};
      options.forEach(o => { placeholder[o] = o === storedVote ? 1 : 0; });
      showResults(placeholder);
      results.classList.remove("hidden");
      updateShareLinks(storedVote, placeholder);
      // Fetch live counts — only replace placeholder if server has real data (total > 0)
      fetch(`/api/poll/${encodeURIComponent(pollId)}/results`)
        .then(r => r.ok ? r.json() : null)
        .then(data => {
          if (data?.votes) {
            const liveTotal = Object.values(data.votes as Record<string, number>).reduce((s: number, v) => s + (v as number), 0);
            if (liveTotal > 0) {
              showResults(data.votes);
              updateShareLinks(storedVote, data.votes);
            }
            // If total === 0 (KV broken/empty), keep the local placeholder — never show all-zero bars
          }
        })
        .catch(() => {});
      return;
    }

    // Fallback: always render placeholder if API unavailable
    function showPlaceholder(chosenOption: string) {
      const placeholder: Record<string, number> = {};
      options.forEach(o => { placeholder[o] = o === chosenOption ? 1 : 0; });
      showResults(placeholder);
      results.classList.remove("hidden");
    }

    // Vote button click
    container.querySelectorAll<HTMLButtonElement>(".vc-option").forEach(btn => {
      btn.addEventListener("click", async () => {
        const option = btn.dataset.option!;

        // Optimistic UI — mark as voted, hide options, show note immediately
        localStorage.setItem(storageKey, option);
        container.classList.add("hidden");
        votedNote.classList.remove("hidden");

        // Show placeholder immediately so the user always sees something
        showPlaceholder(option);
        results.classList.remove("hidden");
        updateShareLinks(option, { [option]: 1 });

        // Then try to get real counts from the API
        try {
          const resp = await fetch(`/api/poll/${encodeURIComponent(pollId)}/vote`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ option }),
          });

          if (resp.ok || resp.status === 409) {
            const data = await resp.json().catch(() => null);
            const liveVotes = data?.votes ?? null;
            const liveTotal = liveVotes
              ? Object.values(liveVotes as Record<string, number>).reduce((s: number, v) => s + (v as number), 0)
              : 0;
            if (liveVotes && liveTotal > 0) {
              showResults(liveVotes);
              updateShareLinks(option, liveVotes);
            } else {
              // No real data yet — try results endpoint as fallback
              const r2 = await fetch(`/api/poll/${encodeURIComponent(pollId)}/results`);
              if (r2.ok) {
                const d2 = await r2.json().catch(() => null);
                const t2 = d2?.votes
                  ? Object.values(d2.votes as Record<string, number>).reduce((s: number, v) => s + (v as number), 0)
                  : 0;
                if (d2?.votes && t2 > 0) { showResults(d2.votes); updateShareLinks(option, d2.votes); }
                // If still 0, placeholder remains — never show all-zero bars to the voter
              }
            }
          }
          // Any other status: placeholder already showing — leave it
        } catch {
          // Network error or KV unavailable — placeholder already showing
        }

        // Plausible event
        if (typeof (window as any).plausible === "function") {
          (window as any).plausible("PollVote", { props: { pollId, option } });
        }
      });
    });
  });
</script>
