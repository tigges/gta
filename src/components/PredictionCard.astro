---
interface Props {
  title: string;
  value: string;
  confidence: number; // 0–100
  basis: string;
  unit?: string;
  trailerTimestamp?: string;
}

const { title, value, confidence, basis, unit, trailerTimestamp } = Astro.props;

const barColor =
  confidence >= 70 ? "bg-amber-500" :
  confidence >= 45 ? "bg-amber-600" :
  "bg-zinc-600";
---

<div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5 flex flex-col gap-3">
  <div class="text-xs font-mono text-zinc-500 uppercase tracking-widest">{title}</div>

  <div class="flex items-baseline gap-1.5">
    <span class="text-3xl font-bold font-mono text-zinc-50">{value}</span>
    {unit && <span class="text-sm text-zinc-500 font-mono">{unit}</span>}
  </div>

  <div>
    <div class="flex justify-between text-xs font-mono text-zinc-600 mb-1">
      <span>Confidence</span>
      <span class={confidence >= 70 ? "text-amber-500" : confidence >= 45 ? "text-amber-600" : "text-zinc-500"}>
        {confidence}%
      </span>
    </div>
    <div class="h-1 bg-zinc-800 rounded-full overflow-hidden">
      <div class={`h-full rounded-full ${barColor}`} style={`width: ${confidence}%`}></div>
    </div>
  </div>

  <p class="text-xs text-zinc-500 leading-relaxed">{basis}</p>

  {trailerTimestamp && (
    <div class="text-xs font-mono text-zinc-600">
      Evidence: VI Trailer @ {trailerTimestamp}
    </div>
  )}
</div>
