---
interface Props {
  title: string;
  value: string;
  confidence: number; // 0–100
  basis: string;
  unit?: string;
  trailerTimestamp?: string;
}

const { title, value, confidence, basis, unit, trailerTimestamp } = Astro.props;

const tier =
  confidence >= 70 ? { label: "HIGH",   color: "text-gta-gold",  bar: "bg-gta-gold",  border: "border-l-gta-gold",  bg: "bg-gta-gold/5"  } :
  confidence >= 45 ? { label: "MID",    color: "text-amber-600", bar: "bg-amber-600", border: "border-l-amber-600", bg: "bg-amber-600/5" } :
                     { label: "LOW",    color: "text-zinc-500",  bar: "bg-zinc-600",  border: "border-l-zinc-600",  bg: "bg-zinc-600/5"  };
---

<div class={`relative flex flex-col rounded-xl border border-[#1e1e23] border-l-2 ${tier.border} overflow-hidden transition-all duration-200 hover:border-[#2a2a31] hover:border-l-current`} style="background:#131316">

  <!-- Top: title + confidence tier label -->
  <div class="flex items-start justify-between px-4 pt-4 pb-2">
    <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.18em] leading-snug">{title}</span>
    <span class={`text-[9px] font-mono ${tier.color} border border-current/20 px-1.5 py-0.5 rounded uppercase tracking-widest shrink-0 ml-2`}>
      {tier.label}
    </span>
  </div>

  <!-- Value -->
  <div class="px-4 pb-3 flex items-baseline gap-1.5">
    <span class="text-3xl font-bold font-mono text-white leading-none">{value}</span>
    {unit && <span class="text-sm font-mono text-zinc-500">{unit}</span>}
  </div>

  <!-- Confidence bar -->
  <div class="px-4 pb-3">
    <div class="flex items-center justify-between mb-1.5">
      <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest">Confidence</span>
      <span class={`text-[11px] font-mono font-semibold ${tier.color}`}>{confidence}%</span>
    </div>
    <div class="h-0.5 rounded-full" style="background:#1e1e23">
      <div class={`h-full rounded-full ${tier.bar} transition-all duration-700`} style={`width:${confidence}%`}></div>
    </div>
  </div>

  <!-- Basis text -->
  <div class="px-4 pb-4 flex-1">
    <p class="text-[11px] text-zinc-500 leading-relaxed" style="font-family:'Inter',sans-serif">{basis}</p>
  </div>

  <!-- Evidence link if present -->
  {trailerTimestamp && (
    <div class="px-4 pb-3 border-t border-[#1e1e23] pt-2.5">
      <span class="text-[10px] font-mono text-zinc-600">
        ▶ Trailer evidence @ <span class="text-zinc-500">{trailerTimestamp}</span>
      </span>
    </div>
  )}

  <!-- Estimated badge bottom-right -->
  <div class="absolute bottom-3 right-3 opacity-20">
    <span class="text-[9px] font-mono text-zinc-400 uppercase tracking-widest">est.</span>
  </div>
</div>
