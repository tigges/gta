---
interface PredictionRange {
  low: string;
  high: string;
}

interface Props {
  title: string;
  value: string;
  confidence: number;
  confidence_tier: "confirmed" | "reported" | "predicted";
  basis: string;
  unit?: string | null;
  trailer_timestamp?: string | null;
  prediction_method?: string | null;
  prediction_range?: PredictionRange | null;
  source?: string | null;
  source_type?: "official" | "reported" | "predicted" | null;
  outcome_verified?: boolean;
  outcome_actual?: string | null;
  thumbnail?: string | null;
}

const {
  title,
  value,
  confidence,
  confidence_tier,
  basis,
  unit,
  trailer_timestamp,
  prediction_method,
  prediction_range,
  source,
  source_type,
  outcome_verified,
  outcome_actual,
  thumbnail,
} = Astro.props;

// Tier styling driven by schema field, not computed from confidence number
const TIER_STYLES = {
  confirmed: {
    label: "CONFIRMED",
    color: "text-emerald-400",
    bar: "bg-emerald-500",
    border: "border-l-emerald-500",
    bg: "bg-emerald-500/5",
    badgeBg: "bg-emerald-900/30 border-emerald-800/40 text-emerald-400",
  },
  reported: {
    label: "REPORTED",
    color: "text-gta-gold",
    bar: "bg-gta-gold",
    border: "border-l-gta-gold",
    bg: "bg-gta-gold/5",
    badgeBg: "bg-amber-900/30 border-amber-800/40 text-amber-400",
  },
  predicted: {
    label: "PREDICTED",
    color: "text-zinc-400",
    bar: "bg-zinc-500",
    border: "border-l-zinc-600",
    bg: "bg-zinc-600/5",
    badgeBg: "bg-zinc-800/50 border-zinc-700/40 text-zinc-400",
  },
};

const tier = TIER_STYLES[confidence_tier] ?? TIER_STYLES.predicted;

const showRange = prediction_range && prediction_range.low !== prediction_range.high;
---

<div
  class={`relative flex flex-col rounded-xl border border-[#1e1e23] border-l-2 ${tier.border} overflow-hidden transition-all duration-200 hover:border-[#2a2a31] hover:border-l-current group`}
  style="background:#131316"
>
  <!-- Thumbnail (if provided) -->
  {thumbnail && (
    <div class="relative h-28 overflow-hidden">
      <img src={thumbnail} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" aria-hidden="true" />
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,transparent 20%,#131316 100%)"></div>
      <div class="absolute inset-0" style={`background:linear-gradient(to bottom, ${confidence_tier === 'confirmed' ? '#10b98108' : confidence_tier === 'reported' ? '#f59e0b08' : '#52525b08'} 0%, transparent 100%)`}></div>
    </div>
  )}

  <!-- Top: title + tier badge -->
  <div class={`flex items-start justify-between px-4 pb-2 ${thumbnail ? "pt-2" : "pt-4"}`}>
    <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.18em] leading-snug">{title}</span>
    <span class={`text-[9px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest shrink-0 ml-2 ${tier.badgeBg}`}>
      {tier.label}
    </span>
  </div>

  <!-- Value + unit -->
  <div class="px-4 pb-3 flex items-baseline gap-1.5">
    <span class="text-3xl font-bold font-mono text-white leading-none">{value}</span>
    {unit && <span class="text-sm font-mono text-zinc-500">{unit}</span>}
  </div>

  <!-- Confidence bar -->
  <div class="px-4 pb-3">
    <div class="flex items-center justify-between mb-1.5">
      <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest">Confidence</span>
      <span class={`text-[11px] font-mono font-semibold ${tier.color}`}>{confidence}%</span>
    </div>
    <div class="h-0.5 rounded-full" style="background:#1e1e23">
      <div class={`h-full rounded-full ${tier.bar} transition-all duration-700`} style={`width:${confidence}%`}></div>
    </div>
  </div>

  <!-- Range (if low ≠ high) -->
  {showRange && (
    <div class="px-4 pb-2">
      <span class="text-[10px] font-mono text-zinc-600">
        Range: <span class="text-zinc-500">{prediction_range!.low}</span>
        <span class="text-zinc-700"> – </span>
        <span class="text-zinc-500">{prediction_range!.high}</span>
      </span>
    </div>
  )}

  <!-- Basis text -->
  <div class="px-4 pb-3 flex-1">
    <p class="text-[11px] text-zinc-500 leading-relaxed" style="font-family:'Inter',sans-serif">{basis}</p>
  </div>

  <!-- Method (if present) -->
  {prediction_method && (
    <div class="px-4 pb-3 border-t border-[#1e1e23] pt-2.5">
      <div class="text-[9px] font-mono text-zinc-700 uppercase tracking-widest mb-0.5">Method</div>
      <p class="text-[10px] font-mono text-zinc-600 leading-snug">{prediction_method}</p>
    </div>
  )}

  <!-- Footer row: source + trailer timestamp -->
  {(source || trailer_timestamp) && (
    <div class="px-4 pb-3 border-t border-[#1e1e23] pt-2.5 flex items-start justify-between gap-2">
      {source && (
        <span class="text-[10px] font-mono text-zinc-700 truncate">
          {source_type === "official" && <span class="text-emerald-600">● </span>}
          {source_type === "reported" && <span class="text-amber-700">● </span>}
          {source_type === "predicted" && <span class="text-zinc-600">● </span>}
          {source}
        </span>
      )}
      {trailer_timestamp && (
        <span class="text-[10px] font-mono text-zinc-700 shrink-0">▶ {trailer_timestamp}</span>
      )}
    </div>
  )}

  <!-- Outcome banner (post-launch) -->
  {outcome_verified && outcome_actual && (
    <div class="px-4 py-2 border-t border-emerald-900/30" style="background:#0a1a0e">
      <div class="text-[9px] font-mono text-emerald-600 uppercase tracking-widest mb-0.5">Actual</div>
      <p class="text-[11px] font-mono text-emerald-400 font-semibold">{outcome_actual}</p>
    </div>
  )}
</div>
