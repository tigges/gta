---
/**
 * StatBox — single key-metric display card.
 *
 * Used in hero stat strips, Health Monitor headline row, database summaries.
 *
 * Usage:
 *   <StatBox value="207.1" label="All-time worst PPI" sub="After Hours · 22.2h" color="var(--c-alert)" />
 *   <StatBox value="20" label="Complexity score" sub="/ 20 max" />
 */

interface Props {
  value: string | number;
  label: string;
  sub?: string;
  /** CSS variable for the value colour. Defaults to var(--c-brand). */
  color?: string;
}

const { value, label, sub, color = "var(--c-brand)" } = Astro.props;
---

<div class="rounded-xl border border-border-dim px-4 py-3" style="background:var(--c-card)">
  <div class="text-xl font-mono font-black" style={`color:${color}`}>{value}</div>
  <div class="text-[11px] text-zinc-400 mt-0.5">{label}</div>
  {sub && <div class="text-[10px] font-mono text-zinc-600 mt-0.5">{sub}</div>}
</div>
