---
/**
 * HeistCard.astro — GTA V story mode heist breakdown card.
 *
 * Shows: heist title · approach options · optimal crew · player cut · total take.
 * Data source: data/gta-5/missions/heists.json
 *
 * Card contract:
 *   TOP-LEFT  GamePill game="gta-v"
 *   Body      approach tabs · crew · take breakdown
 *   Footer    GTAVI.AI + Share
 */
import GamePill from "./GamePill.astro";
import ShareDropdown from "./ShareDropdown.astro";

interface Approach {
  name: string;
  total_take: number;
  player_max_cut: number;
  crew_cost_pct?: number;
  optimal_crew?: Record<string, string>;
  notes?: string;
}

interface Props {
  id: string;
  title: string;
  chapter: number;
  protagonists: string[];
  approaches: Approach[];
  difficulty?: string;
  replay_value?: string;
  notes?: string;
  thumbnail?: string | null;
}

const { id, title, chapter, protagonists, approaches, difficulty, replay_value, notes, thumbnail } = Astro.props;

// Best approach by player_max_cut
const bestApproach = approaches.reduce((best, a) =>
  (a.player_max_cut ?? 0) > (best.player_max_cut ?? 0) ? a : best, approaches[0]);

const hasPayout = bestApproach?.player_max_cut > 0;
const maxCut    = bestApproach?.player_max_cut ?? 0;
const totalTake = bestApproach?.total_take ?? 0;

function fmt(n: number) {
  if (n >= 1_000_000) return `$${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000)     return `$${(n / 1_000).toFixed(0)}K`;
  return `$${n}`;
}

const anchorId  = `heist-${id}`;
const shareText = hasPayout
  ? `GTA V ${title}: ${fmt(maxCut)} player cut (optimal crew). ${fmt(totalTake)} total take. Then invest in Lester's assassination missions for $2B+.`
  : `GTA V ${title}: $0 payout — story required, not for money.`;

const DIFFICULTY_COLOR: Record<string, string> = {
  Low: "text-emerald-300",
  Medium: "text-amber-300",
  Hard: "text-red-400",
};
---

<div
  id={anchorId}
  class="relative flex flex-col rounded-xl border border-[#1e1e23] border-l-2 border-l-gta-gold/50 overflow-hidden transition-all duration-200 hover:border-[#2a2a31] group"
  style="background:#131316;scroll-margin-top:72px"
>
  <!-- Image strip -->
  {thumbnail && (
    <div class="relative h-24 overflow-hidden">
      <img src={thumbnail} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" aria-hidden="true" />
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(0,0,0,0.3) 0%,transparent 30%,#131316 100%)"></div>
    </div>
  )}

  <!-- Pills bar -->
  <div class={thumbnail
    ? "absolute top-0 left-0 right-0 flex items-center justify-between px-3 pt-2.5 z-10"
    : "flex items-center justify-between px-4 pt-3 pb-2"
  }>
    <GamePill game="gta-v" size="xs" />
    <div class="flex items-center gap-2 shrink-0">
      {difficulty && (
        <span class={`text-[10px] font-mono uppercase tracking-widest ${DIFFICULTY_COLOR[difficulty] ?? "text-zinc-400"}`}>
          {difficulty}
        </span>
      )}
      <span class="text-[10px] font-mono border border-zinc-600/40 bg-zinc-800/30 text-zinc-300 px-1.5 py-0.5 rounded uppercase tracking-widest">
        Ch. {chapter}
      </span>
    </div>
  </div>

  <!-- Title -->
  <div class={`px-4 pb-2 ${thumbnail ? "pt-2" : ""}`}>
    <h3 class="text-lg font-bold text-white leading-tight">{title}</h3>
    <div class="text-[10px] font-mono text-zinc-600 mt-0.5">{protagonists.join(" · ")}</div>
  </div>

  {hasPayout ? (
    <>
      <!-- Take breakdown -->
      <div class="px-4 pb-3 grid grid-cols-2 gap-3">
        <div>
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Player cut</div>
          <div class="text-xl font-mono font-bold text-gta-gold">{fmt(maxCut)}</div>
          <div class="text-[10px] font-mono text-zinc-600">{bestApproach?.name}</div>
        </div>
        <div>
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Total take</div>
          <div class="text-xl font-mono font-bold text-zinc-300">{fmt(totalTake)}</div>
          <div class="text-[10px] font-mono text-zinc-600">{bestApproach?.crew_cost_pct}% crew cost</div>
        </div>
      </div>

      <!-- Approach options -->
      {approaches.length > 1 && (
        <div class="px-4 pb-3 border-t border-[#1e1e23] pt-2.5">
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-2">Approaches</div>
          <div class="flex flex-col gap-1.5">
            {approaches.map(a => (
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-mono text-zinc-400">{a.name}</span>
                <span class={`text-[11px] font-mono font-bold ${a === bestApproach ? "text-gta-gold" : "text-zinc-500"}`}>
                  {a.player_max_cut > 0 ? fmt(a.player_max_cut) : "$0"}
                  {a === bestApproach && <span class="text-[9px] text-gta-gold/60 ml-1">optimal</span>}
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Optimal crew (if available) -->
      {bestApproach?.optimal_crew && (
        <div class="px-4 pb-3 border-t border-[#1e1e23] pt-2.5">
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-2">Optimal crew — {bestApproach.name}</div>
          <div class="grid grid-cols-1 gap-1">
            {Object.entries(bestApproach.optimal_crew).map(([role, person]) => (
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono text-zinc-600 capitalize">{role.replace(/_/g, " ")}</span>
                <span class="text-[10px] font-mono text-zinc-400">{String(person)}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </>
  ) : (
    <!-- Zero-payout heist -->
    <div class="px-4 pb-3 flex-1">
      <div class="rounded-lg border border-[#1e1e23] px-3 py-2.5" style="background:#0e0e11">
        <div class="text-[11px] font-mono text-zinc-500 leading-snug">
          $0 payout — story-required mission. No financial return; advances the narrative.
        </div>
      </div>
    </div>
  )}

  <!-- Notes -->
  {notes && (
    <div class="px-4 pb-3 border-t border-[#1e1e23] pt-2.5">
      <p class="text-[11px] text-zinc-400 leading-relaxed">{notes}</p>
    </div>
  )}

  <!-- Footer -->
  <div class="px-4 pb-3 flex items-center justify-between border-t border-[#1e1e23] pt-2.5 mt-auto">
    <span class="text-[10px] font-mono text-zinc-600">GTA Wiki · community records · 2024 verified</span>
    <div class="flex items-center gap-2 shrink-0">
      <span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span>
      <ShareDropdown anchorId={anchorId} shareText={shareText} size="sm" />
    </div>
  </div>
</div>
