---
/**
 * ChartFooter.astro — backward-compatibility shim over CardFooter.
 *
 * All chart components currently import ChartFooter. This shim preserves
 * that interface unchanged while delegating to CardFooter.
 *
 * Phase 4 migration: chart components can be updated to import CardFooter
 * directly, after which this shim can be deleted.
 */
import CardFooter from "./CardFooter.astro";

interface Props {
  chartId:   string;
  sources:   string;
  shareText: string;
}

const { chartId, sources, shareText } = Astro.props;
---

<CardFooter chartId={chartId} sources={sources} shareText={shareText} />
