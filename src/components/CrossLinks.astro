const links: CrossLink[] = ALL_LINKS[context] ?? [];

// Standard: 2-col (4 tiles = 2×2). Allow 3-col only when tile count is exactly 3 or odd.
const isOdd     = links.length % 2 !== 0;
const gridClass = isOdd
  ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
  : "grid-cols-1 sm:grid-cols-2";
const gapClass  = isOdd ? "gap-3" : "gap-4";
