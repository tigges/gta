  // Franchise page
  "franchise": [
    { href: "/charts", icon: "📈", tier: "Charts", label: "Full chart suite",
      sub: "Sales velocity, CPI pricing, Metacritic, revenue model", color: "text-gta-gold", border: "border-gta-gold/25" },
    { href: "/gta-vi/intel", icon: "🎯", tier: "GTA VI", label: "GTA VI predictions",
      sub: "What 30 years of data says about VI", color: "text-gta-gold", border: "border-gta-gold/20" },
    { href: "/database", icon: "🗄", tier: "Database", label: "GTA V + VI entities",
      sub: `${gta5Vehicles} GTA V vehicles · ${gta6Entities.toLocaleString()} GTA VI entries`, color: "text-gta-teal", border: "border-gta-teal/20" },
  ],

  // Home page
  "home": [
    { href: "/gta-vi/intel", icon: "🎯", tier: "GTA VI", label: "GTA VI intelligence",
      sub: `${predCount} predictions · cast · locations · timelines`, color: "text-gta-gold", border: "border-gta-gold/20" },
    { href: "/charts", icon: "📈", tier: "Charts", label: "Data visualised",
      sub: "15+ live charts — franchise sales to search signal", color: "text-gta-gold", border: "border-gta-gold/25" },
    { href: "/database", icon: "🗄", tier: "Database", label: "Entity database",
      sub: `${gta6Entities.toLocaleString()} GTA VI · ${gta5Vehicles} GTA V`, color: "text-gta-teal", border: "border-gta-teal/20" },
    { href: "/news", icon: "📰", tier: "News", label: "Live intelligence feed",
      sub: `${newsItems} articles · updated nightly`, color: "text-zinc-400", border: "border-zinc-700" },
    { href: "/gta-vi/buy", icon: "🛒", tier: "Buy", label: "Pre-order tracker",
      sub: "Editions, platforms, retailer watch", color: "text-zinc-300", border: "border-zinc-600" },
  ],

  // Buy page
  "buy": [
    { href: "/gta-vi/intel", icon: "🎯", tier: "GTA VI", label: "Intelligence backing these prices",
      sub: `${predCount} predictions · ${trailerCount} trailers analysed`, color: "text-gta-gold", border: "border-gta-gold/20" },
    { href: "/charts", icon: "📈", tier: "Charts", label: "CPI-adjusted pricing history",
      sub: "Is $79.99 cheap vs every prior GTA at launch?", color: "text-gta-gold", border: "border-gta-gold/25" },
    { href: "/news", icon: "📰", tier: "News", label: "Pre-order news",
      sub: `Latest from ${newsItems} tracked sources`, color: "text-zinc-400", border: "border-zinc-700" },
  ],

  // GTA Online hub
  "gta-online": [
    { href: "/database?game=gta-online", icon: "💰", tier: "GTA Online", label: "Income database",
      sub: `S→D tier · ${gta5Vehicles > 0 ? "56" : "50"}+ methods profiled · full profiles`, color: "text-gta-teal", border: "border-gta-teal/30" },
    { href: "/gta-online/bonuses", icon: "🏷", tier: "GTA Online", label: "Bonuses & promos",
      sub: "Weekly calendar · 42 weeks of history · sale intelligence", color: "text-gta-teal", border: "border-gta-teal/20" },
    { href: "/gta-online/economy", icon: "📊", tier: "GTA Online", label: "Economy model",
      sub: "GTA-PPI · inflation · passive stack tracker", color: "text-gta-gold", border: "border-gta-gold/25" },
    { href: "/gta-vi/intel", icon: "🎯", tier: "GTA VI", label: "GTA VI — what comes next",
      sub: `${predCount} predictions · economy preview · pre-order`, color: "text-gta-gold", border: "border-gta-gold/20" },
  ],

  // GTA Online economy page
  "gta-online-economy": [
    { href: "/database?game=gta-online", icon: "💰", tier: "GTA Online", label: "Income database",
      sub: "All 56 methods · S→D tier · weekly bonus tracker", color: "text-gta-teal", border: "border-gta-teal/30" },
    { href: "/gta-online/bonuses", icon: "🏷", tier: "GTA Online", label: "Bonuses & promos",
      sub: "Weekly calendar · sale intelligence · leaderboard", color: "text-gta-teal", border: "border-gta-teal/20" },
    { href: "/franchise/charts", icon: "📈", tier: "Franchise", label: "Franchise charts",
      sub: "Cross-title complexity · earnings · inflation", color: "text-gta-gold", border: "border-gta-gold/25" },
  ],

  // GTA Online income (Adviser page)
  "gta-online-income": [
    { href: "/gta-online/economy", icon: "📊", tier: "GTA Online", label: "Economy model",
      sub: "GTA-PPI · inflation · passive stack", color: "text-gta-gold", border: "border-gta-gold/25" },
    { href: "/database?game=gta-online", icon: "💰", tier: "Database", label: "Income database",
      sub: `${gta5Vehicles} vehicles · S→D tier · full profiles`, color: "text-gta-teal", border: "border-gta-teal/20" },
    { href: "/gta-online/bonuses", icon: "🏷", tier: "GTA Online", label: "Bonuses & promos",
      sub: "Weekly calendar · sale intelligence · leaderboard", color: "text-zinc-400", border: "border-zinc-700" },
  ],

  // GTA Online bonuses page
  "gta-online-bonuses": [
    { href: "/database?game=gta-online", icon: "💰", tier: "GTA Online", label: "Income database",
      sub: "Find out which active bonus is worth your time", color: "text-gta-teal", border: "border-gta-teal/30" },
    { href: "/gta-online/economy", icon: "📊", tier: "GTA Online", label: "Economy model",
      sub: "GTA-PPI · inflation history · meta evolution", color: "text-gta-gold", border: "border-gta-gold/25" },
    { href: "/franchise/charts", icon: "📈", tier: "Franchise", label: "Promotion analytics",
      sub: "Bonus cadence · sale frequency over time", color: "text-zinc-400", border: "border-zinc-700" },
  ],

  // SEO landings: cayo-perico, assassination-guide
  "gta-online-seo": [
    { href: "/database?game=gta-online", icon: "💰", tier: "GTA Online", label: "All income sources",
      sub: "56 methods · S→D tier · full profit profiles", color: "text-gta-teal", border: "border-gta-teal/30" },
    { href: "/gta-online/bonuses", icon: "🏷", tier: "GTA Online", label: "Weekly bonuses",
      sub: "Is this method on bonus this week?", color: "text-gta-teal", border: "border-gta-teal/20" },
    { href: "/gta-online/economy", icon: "📊", tier: "GTA Online", label: "Economy model",
      sub: "GTA-PPI · inflation · passive vs active", color: "text-gta-gold", border: "border-gta-gold/25" },
  ],
};

const links: CrossLink[] = ALL_LINKS[context] ?? [];
---

{links.length > 0 && (
  <div class={`rounded-xl border border-border-dim overflow-hidden ${extraClass}`} style="background:var(--c-bg)">
    <div class="px-5 py-3 border-b border-border-dim flex items-center gap-2">
      <span class="w-1 h-4 rounded-full bg-gta-gold/40 shrink-0"></span>
      <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em]">// Related Intelligence</span>
      <span class="text-[11px] font-mono text-zinc-800 ml-auto">auto-updated · builds nightly</span>
    </div>
    <div class={`grid gap-0 divide-border-dim ${links.length <= 2 ? "grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x" : links.length === 3 ? "grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x" : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x"}`}>
      {links.map(link => (
        <a href={link.href}
          class={`group flex items-start gap-3 px-5 py-4 hover:bg-white/2 transition-all border-border-dim`}>
          <span class="text-lg shrink-0 mt-0.5">{link.icon}</span>
          <div class="min-w-0">
            <div class="flex items-center gap-2 mb-0.5">
              <span class={`text-[10px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest bg-transparent ${link.color} ${link.border}`}>
                {link.tier}
              </span>
            </div>
            <div class={`text-[12px] font-semibold group-hover:text-white transition-colors leading-snug mb-0.5 ${link.color}`}>
              {link.label}
            </div>
            <div class="text-[10px] font-mono text-zinc-600 leading-snug">{link.sub}</div>
          </div>
          <span class="text-zinc-500 group-hover:text-zinc-500 font-mono text-xs ml-auto shrink-0 mt-1 transition-colors">→</span>
        </a>
      ))}
    </div>
  </div>
)}
