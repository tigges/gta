---
/**
 * CrossLinks — contextual "Related Intelligence" bridge strips.
 *
 * Rendered at build time from live data counts, so labels stay accurate
 * automatically as scrapers update JSON files nightly.
 *
 * Usage:
 *   <CrossLinks context="vi-intel-predictions" />
 *   <CrossLinks context="database" />
 *   etc.
 */

import HudIcon from "./HudIcon.astro";
import type {
  EntityIndex, LeonidaData, NewswireData, RedditData,
  VehiclesData, TrailersData, PredictionsData, FeaturesData, FranchiseSalesData,
} from "../../types/gta";

import entityIndexRaw  from "../../data/gta-6/entities/index.json";
import leonidaRaw      from "../../data/gta-6/entities/leonida-intel.json";
import newswireRaw     from "../../data/feeds/newswire.json";
import redditRaw       from "../../data/community/reddit.json";
import vehicleRaw      from "../../data/gta-5/vehicles/performance.json";
import trailerRaw      from "../../data/gta-6/trailers.json";
import predRaw         from "../../data/gta-6/predictions.json";
import featuresRaw     from "../../data/gta-6/features.json";
import salesRaw        from "../../data/franchise/sales.json";

const entityIndex  = entityIndexRaw as unknown as EntityIndex;
const leonidaData  = leonidaRaw     as unknown as LeonidaData;
const newswireData = newswireRaw    as unknown as NewswireData;
const redditData   = redditRaw      as unknown as RedditData;
const vehicleData  = vehicleRaw     as unknown as VehiclesData;
const trailerData  = trailerRaw     as unknown as TrailersData;
const predData     = predRaw        as unknown as PredictionsData;
const featuresData = featuresRaw    as unknown as FeaturesData;
const salesData    = salesRaw       as unknown as FranchiseSalesData;

interface Props {
  context: string;
  class?: string;
}
const { context, class: extraClass = "" } = Astro.props;

// ── Live counts — updated every build from nightly scraper output ──────────
const gta6Entities   = entityIndex.total + (leonidaData.entity_stats?.total ?? 0);
const newsItems      = newswireData.items.length + (redditData.recent_posts?.length ?? 0);
const gta5Vehicles   = vehicleData.vehicles.length;
const trailerCount   = trailerData.trailers.length;
const predCount      = predData.predictions.length;
const featuresTotal  = featuresData.categories.reduce(
  (s: number, c) => s + c.confirmed + c.reported, 0
);
const franchiseTitles = salesData.titles.length;

// ── Link definitions per context ──────────────────────────────────────────
interface CrossLink {
  href: string;
  label: string;
  sub: string;
  tier: string;
  icon: string;
  color: string;
  border: string;
}

const ALL_LINKS: Record<string, CrossLink[]> = {

  // After Signal Predictions on VI Intel
  "vi-intel-predictions": [
    { href: "/charts", icon: "📈", tier: "Charts", label: "Signal charts",
      sub: `${predCount} predictions backed by live data`, color: "text-gta-gold", border: "border-gta-gold/25" },
    { href: "/database", icon: "🗄", tier: "Database", label: "Entity database",
      sub: `${gta6Entities.toLocaleString()} GTA VI entities indexed`, color: "text-gta-teal", border: "border-gta-teal/20" },
    { href: "/franchise", icon: "📊", tier: "Franchise", label: "Historical context",
      sub: `${franchiseTitles} titles · 30 years of data`, color: "text-zinc-400", border: "border-zinc-700" },
    { href: "/gta-vi/buy", icon: "🛒", tier: "Buy", label: "Pre-order tracker",
      sub: "Platforms, editions, retailers", color: "text-gta-gold", border: "border-gta-gold/20" },
  ],

  // After Cast strip (VI Intel + Home)
  "vi-intel-cast": [
    { href: "/database?type=character", icon: "👤", tier: "Database", label: "All characters",
      sub: `${(leonidaData.by_category?.["Characters"] ?? 0) + (entityIndex.by_type?.["character"] ?? 0)} indexed across both sources`,
      color: "text-gta-teal", border: "border-gta-teal/20" },
    { href: "/news", icon: "📰", tier: "News", label: "Character intel",
      sub: `${newsItems} articles tracked nightly`, color: "text-zinc-400", border: "border-zinc-700" },
    { href: "/gta-vi/intel", icon: "🎬", tier: "GTA VI", label: "Trailer analysis",
      sub: `${trailerCount} official trailers analysed`, color: "text-gta-gold", border: "border-gta-gold/20" },
  ],

  // After Location gallery (VI Intel)
  "vi-intel-locations": [
    { href: "/database?type=location", icon: "📍", tier: "Database", label: "All locations",
      sub: `${leonidaData.by_category?.["Locations"] ?? 0} Leonida Intel locations`,
      color: "text-gta-teal", border: "border-gta-teal/20" },
    { href: "/charts", icon: "🗺", tier: "Charts", label: "Region evidence heatmap",
      sub: "Confidence density per location per source", color: "text-gta-gold", border: "border-gta-gold/25" },
    { href: "/news", icon: "📰", tier: "News", label: "Location coverage",
