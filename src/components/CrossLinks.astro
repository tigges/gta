      <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em]">// Related Intelligence</span>
      <div class="flex-1 h-px bg-border-dim"></div>
      <span class="text-[10px] font-mono text-zinc-700">auto-updated · builds nightly</span>
    </div>
    <div class={`grid w-full ${gapClass} ${gridClass}`}>
      {links.map(link => (
        <a href={link.href}
           class="group relative overflow-hidden rounded-xl border border-border-dim hover:border-border-mid transition-all crosslink-tile"
           data-crosslink-from={context}
           data-crosslink-to={link.href}
           data-crosslink-label={link.label}
           style="background:var(--c-card)">
          <div class="h-px w-full" style={`background:linear-gradient(90deg,${link.accent},transparent 60%)`}></div>
          <div class="flex items-center gap-4 p-4 sm:p-5">
            <div class="shrink-0 w-20 h-12 rounded-lg overflow-hidden border border-border-mid">
              <img src={link.thumb} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" aria-hidden="true" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-[10px] font-mono text-zinc-500 mb-0.5 uppercase tracking-widest">{link.badge}</div>
              <div class="text-sm font-semibold text-zinc-100 group-hover:text-white transition-colors truncate">{link.label}</div>
              <div class="text-[11px] font-mono text-zinc-500 leading-snug mt-0.5 line-clamp-1">{link.sub}</div>
            </div>
            <svg class="shrink-0 w-4 h-4 text-zinc-600 group-hover:text-zinc-400 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 16 16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
)}

<script>
  document.querySelectorAll<HTMLAnchorElement>(".crosslink-tile").forEach(tile => {
    tile.addEventListener("click", () => {
      if (typeof (window as any).plausible !== "function") return;
      (window as any).plausible("CrossLink", {
        props: {
          from:  tile.dataset.crosslinkFrom  ?? "",
          to:    tile.dataset.crosslinkTo    ?? "",
          label: tile.dataset.crosslinkLabel ?? "",
        },
      });
    });
  });
</script>
