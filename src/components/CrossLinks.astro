    { href: "/franchise", icon: "📊", tier: "Franchise", label: "30-year franchise history",
      sub: `${franchiseTitles} titles · sales · scores · map growth`, color: "text-zinc-400", border: "border-zinc-700" },
    { href: "/database", icon: "🚗", tier: "Database", label: "GTA V vehicle benchmarks",
      sub: `${gta5Vehicles} vehicles · lap times · top speeds`, color: "text-gta-teal", border: "border-gta-teal/20" },
