---
/**
 * IncomePredictionCard.astro
 *
 * Displays a GTA VI predicted income source — heist, business, passive, or mission.
 * Based on data/gta-6/income-predictions.json schema.
 *
 * Card contract:
 *   TOP-LEFT   GamePill game="gta-vi"
 *   TOP-RIGHT  confidence tier badge (CONFIRMED / REPORTED / PREDICTED)
 *   Image      thumbnail (contextual GTA VI asset)
 *   Body       name · category · region · payout · $/hr · analogous method
 *   Footer     GTAVI.AI + Share
 */
import GamePill from "./GamePill.astro";
import ShareDropdown from "./ShareDropdown.astro";
import { TIER_STYLES } from "../config/tierStyles";
import { C_CARD } from "../config/colors";
import { getRegionType } from "../config/semanticTypes";

interface Props {
  id: string;
  name: string;
  category: "heist" | "business" | "passive" | "mission";
  region: "vice-city" | "leonida" | "both";
  confidence_tier: "confirmed" | "reported" | "predicted";
  confidence_score: number;
  thumbnail?: string | null;
  trailer_evidence?: string | null;
  predicted_payout_per_run?: string | null;
  predicted_gta_per_hr?: string | null;
  analogous_gta_online?: string | null;
  basis: string;
  prediction_range?: { low: string; high: string } | null;
  /** When provided: renders "Full analysis →" link in footer */
  detailHref?: string;
}

const {
  id, name, category, region, confidence_tier, confidence_score,
  thumbnail, trailer_evidence, predicted_payout_per_run,
  predicted_gta_per_hr, analogous_gta_online, basis, prediction_range,
  detailHref,
} = Astro.props;

const tier = TIER_STYLES[confidence_tier] ?? TIER_STYLES.predicted;

const CATEGORY_ICONS: Record<string, string> = {
  heist:    "💎",
  business: "🏢",
  passive:  "💤",
  mission:  "📋",
};
const regionType  = getRegionType(region);
const regionLabel = regionType.label;
const anchorId = `income-pred-${id}`;
const shareText = `GTA VI predicted income: ${name} — ${predicted_gta_per_hr ? predicted_gta_per_hr + "/hr" : predicted_payout_per_run ?? "TBC"} · ${confidence_score}% confidence · GTAVI.AI`;
---

<div
  id={anchorId}
  class={`relative flex flex-col rounded-xl border border-[#1e1e23] border-l-2 ${tier.border} overflow-hidden transition-all duration-200 hover:border-[#2a2a31] group`}
  style="background:var(--c-card);scroll-margin-top:72px"
>
  <!-- Image strip — pills float over it -->
  {thumbnail && (
    <div class="relative h-28 overflow-hidden">
      <img src={thumbnail} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" aria-hidden="true" />
      <div class="absolute inset-0" style={`background:linear-gradient(to bottom,rgba(0,0,0,0.35) 0%,transparent 35%,${C_CARD} 100%)`}></div>
    </div>
  )}

  <!-- Pills bar — same baseline regardless of thumbnail -->
  <div class={thumbnail
    ? "absolute top-0 left-0 right-0 flex items-center justify-between px-3 pt-2.5 z-10"
    : "flex items-center justify-between px-4 pt-3 pb-2"
  }>
    <GamePill game="gta-vi" size="xs" />
    <span class={`text-[10px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest shrink-0 ${tier.badgeBg}`}>
      {tier.label}
    </span>
  </div>

  <!-- Category + region row -->
  <div class={`flex items-center gap-2 px-4 pb-1.5 ${thumbnail ? "pt-2" : ""}`}>
    <span class="text-sm">{CATEGORY_ICONS[category]}</span>
    <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">{category}</span>
    <span class="text-zinc-700">·</span>
    <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest">{regionLabel}</span>
    {trailer_evidence && (
      <>
        <span class="text-zinc-700">·</span>
        <span class="text-[10px] font-mono text-zinc-600">▶ {trailer_evidence}</span>
      </>
    )}
  </div>

  <!-- Name -->
  <div class="px-4 pb-3">
    <h3 class="text-xl font-bold text-white leading-snug">{name}</h3>
  </div>

  <!-- Payout stats -->
  <div class="px-4 pb-3 grid grid-cols-2 gap-3">
    <div>
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Per Run</div>
      <div class={`text-base font-mono font-bold ${tier.color}`}>
        {predicted_payout_per_run ?? "N/A — pre-launch"}
      </div>
    </div>
    <div>
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-1">GTA$/hr</div>
      <div class={`text-base font-mono font-bold ${tier.color}`}>
        {predicted_gta_per_hr ?? "N/A — pre-launch"}
      </div>
    </div>
  </div>

  <!-- Confidence bar -->
  <div class="px-4 pb-3">
    <div class="flex items-center justify-between mb-1.5">
      <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">Confidence</span>
      <span class={`text-[10px] font-mono font-semibold ${tier.color}`}>{confidence_score}%</span>
    </div>
    <div class="h-0.5 rounded-full" style="background:var(--c-border-1)">
      <div class={`h-full rounded-full ${tier.bar} transition-all duration-700`} style={`width:${confidence_score}%`}></div>
    </div>
  </div>

  <!-- Range -->
  {prediction_range && (
    <div class="px-4 pb-2">
      <span class="text-[10px] font-mono text-zinc-600">
        Range: <span class="text-zinc-500">{prediction_range.low}</span>
        <span class="text-zinc-600"> — </span>
        <span class="text-zinc-500">{prediction_range.high}</span>
      </span>
    </div>
  )}

  <!-- Basis -->
  <div class="px-4 pb-3 flex-1">
    <p class="text-[11px] text-zinc-400 leading-relaxed">{basis}</p>
  </div>

  <!-- Analogous GTA Online method -->
  {analogous_gta_online && (
    <div class="px-4 pb-3 border-t border-[#1e1e23] pt-2.5">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-0.5">GTA Online analogue</div>
      <a href={`/database?id=${analogous_gta_online}`}
         class="text-[11px] font-mono text-zinc-500 hover:text-gta-teal transition-colors capitalize">
        {analogous_gta_online.replace(/-/g, " ")} →
      </a>
    </div>
  )}

  <!-- Footer -->
  <div class="px-4 pb-3 mt-auto flex items-center justify-between border-t border-[#1e1e23] pt-2.5">
    <span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span>
    <div class="flex items-center gap-2.5">
      {detailHref && (
        <a href={detailHref}
           class="text-[10px] font-mono text-zinc-400 hover:text-gta-gold transition-colors uppercase tracking-widest whitespace-nowrap">
          Full analysis →
        </a>
      )}
      <ShareDropdown anchorId={anchorId} shareText={shareText} size="sm" />
    </div>
  </div>
</div>
