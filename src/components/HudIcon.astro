  link:      `<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>`,
  "share-x": `<path d="M4 4l16 16M4 20L20 4" stroke-linecap="round"/>`,
  "share-reddit": `<circle cx="12" cy="12" r="9"/><circle cx="9" cy="13" r="1.2" fill="currentColor"/><circle cx="15" cy="13" r="1.2" fill="currentColor"/><path d="M9.5 16a4 4 0 0 0 5 0"/><path d="M15.5 7.5a2 2 0 1 1 2 2" stroke-linecap="round"/><circle cx="17.5" cy="9.5" r="0.8" fill="currentColor"/><path d="M12 9.5c1.1 0 2.2.3 3 .8M12 9.5c-1.1 0-2.2.3-3 .8"/>`,
  "share-branch": `<path d="M12 3v10M12 3l-4 4M12 3l4 4M6 17l-3 3M18 17l3 3M12 13l-6 4M12 13l6 4" stroke-linecap="round" stroke-linejoin="round"/>`,

  // ── Economy diagram icons ──────────────────────────────────────────────────
  bank:         `<rect x="2" y="8" width="20" height="13" rx="1"/><path d="M2 8l10-6 10 6"/><line x1="6" y1="11" x2="6" y2="21"/><line x1="10" y1="11" x2="10" y2="21"/><line x1="14" y1="11" x2="14" y2="21"/><line x1="18" y1="11" x2="18" y2="21"/>`,
  dollar:       `<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>`,
  "shark-card": `<rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/><path d="M7 15h2"/><path d="M11 15h4"/><path d="M17 8.5c0 2-2 3-2 4.5"/>`,
  mobile:       `<rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18" stroke-width="2.5"/>`,
  ammo:         `<path d="M9 3l1-1h4l1 1v5l1 1v9a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-9l1-1V3z"/><line x1="12" y1="8" x2="12" y2="15"/>`,
  clothing:     `<path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.57a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.57a2 2 0 0 0-1.34-2.23z"/>`,
  property:     `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  investment:   `<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/><circle cx="4" cy="20" r="2"/>`,
  injection:    `<circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/>`,
  nightclub:    `<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>`,
  bunker:       `<path d="M2 18h20"/><path d="M4 18V9l8-5 8 5v9"/><rect x="9" y="12" width="6" height="6"/>`,
  vault:        `<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="4"/><path d="M12 8v-3M16 12h3M12 16v3M8 12H5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/>`,
  casino:       `<path d="M6 2l6 4 6-4v14l-6 4-6-4V2z"/><line x1="12" y1="6" x2="12" y2="20"/>`,
  subscription: `<path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z"/><path d="M9 12l2 2 4-4"/>`,
