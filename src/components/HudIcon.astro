---
/**
 * HudIcon — GTA HUD-style SVG icon set.
 *
 * Thin-stroke monochrome pictograms rendered at 16×16 (default).
 * Inherits currentColor so they adapt to parent text colour.
 *
 * Usage:
 *   <HudIcon name="money" class="text-gta-teal" />
 *   <HudIcon name="intel" size={20} />
 */
interface Props {
  name:
    | "money"        // income / GTA$
    | "briefcase"    // CEO / businesses
    | "heist"        // heist / crossed tools
    | "chart"        // economy / charts
    | "trending"     // trending analytics
    | "tag"          // bonuses / sale
    | "car"          // vehicles
    | "database"     // data browser
    | "news"         // news / feed
    | "intel"        // predictions / targeting
    | "trailer"      // trailers / film
    | "map-pin"      // locations
    | "users"        // characters / cast
    | "buy"          // pre-order / cart
    | "history"      // franchise history
    | "economy"      // economy circular
    | "passive"      // passive income / stack
    | "shark"        // shark cards
    | "star"         // weekly event / bonus star
    | "link"         // copy link / chain
    | "share-x"      // X (Twitter) platform
    | "share-reddit" // Reddit / Snoo silhouette
    | "share-branch" // share broadcast / more apps
    // ── Economy diagram ───────────────────────────────────────
    | "bank"         // Maze Bank / financial institution
    | "dollar"       // dollar sign / GTA$ raw
    | "shark-card"   // Shark Card / premium currency
    | "mobile"       // mobile phone / iFruit / persistence
    | "ammo"         // ammunition / weapon purchase
    | "clothing"     // clothing store / Consumption
    | "property"     // property / real estate asset
    | "investment"   // investment / return-to-Y
    | "injection"    // J-injection / external money input
    | "nightclub"    // nightclub business
    | "bunker"       // bunker / gunrunning
    | "vault"        // heist vault / casino safe
    | "casino"       // diamond casino / gambling
    | "subscription" // GTA+ subscription
    | "region"       // dual territory / regional economy
    | "mission"      // mission giver / active earn
    | "cycle"        // recurring / business cycle arrow
    | "hub";         // hub page / overview
  size?: number;
  class?: string;
}

const { name, size = 16, class: cls = "" } = Astro.props;

const PATHS: Record<string, string> = {
  money:     `<path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 5v1m0 8v1m-3.5-6.5h5a1.5 1.5 0 0 1 0 3h-3a1.5 1.5 0 0 0 0 3H15" stroke-linecap="round" stroke-linejoin="round"/>`,
  briefcase: `<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/>`,
  heist:     `<path d="M14.5 2.5c0 1.5-1.5 3-3 4.5-1.5-1.5-3-3-3-4.5a3 3 0 0 1 6 0z"/><path d="M3 22l4.5-9L12 17l4.5-9L21 22"/><line x1="3" y1="22" x2="21" y2="22"/>`,
  chart:     `<rect x="3" y="13" width="4" height="8"/><rect x="9.5" y="8" width="4" height="13"/><rect x="16" y="3" width="4" height="18"/><line x1="1" y1="21" x2="23" y2="21"/>`,
  trending:  `<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>`,
  tag:       `<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>`,
  car:       `<path d="M5 17H3a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-2"/><rect x="7" y="15" width="4" height="4" rx="2"/><rect x="13" y="15" width="4" height="4" rx="2"/><path d="M5 9l2-4h10l2 4"/>`,
  database:  `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>`,
  news:      `<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6z"/>`,
  intel:     `<circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8" stroke-dasharray="3 2"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/>`,
  trailer:   `<rect x="2" y="4" width="20" height="16" rx="2"/><polygon points="10 9 16 12 10 15 10 9"/>`,
  "map-pin": `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>`,
  users:     `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  buy:       `<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>`,
  history:   `<path d="M12 22C6.48 22 2 17.52 2 12S6.48 2 12 2s10 4.48 10 10"/><polyline points="12 6 12 12 16 14"/><path d="M22 22l-3-3m0 0a5 5 0 1 0-7.07-7.07A5 5 0 0 0 19 19z"/>`,
  economy:   `<circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20"/><path d="M2 12h20"/><path d="M12 2c-2.76 3.63-4 7.27-4 10s1.24 6.37 4 10"/><path d="M12 2c2.76 3.63 4 7.27 4 10s-1.24 6.37-4 10"/>`,
  passive:   `<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>`,
  shark:     `<path d="M2 12h4l2-5 4 10 2-5h8"/><path d="M18 7c0 4-6 6-6 11"/>`,
