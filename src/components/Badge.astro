---
/**
 * Badge.astro — canonical badge/pill component.
 *
 * SINGLE SOURCE OF TRUTH for all pill labels on the site.
 * Reads color from semanticTypes.ts — no raw hex, no ad-hoc Tailwind color names.
 *
 * Usage:
 *   <Badge variant="confirmed" />
 *   <Badge variant="gta-vi" label="GTA VI" />
 *   <Badge variant="s-tier" />
 *   <Badge variant="active" />
 */
import { pillStyle } from "../config/semanticTypes";

interface Props {
  variant:
    // Cluster A — game titles
    | "gta-vi" | "gta-online" | "gta-v" | "franchise"
    | "gta-sa" | "gta-vc" | "gta-iv" | "gta-iii"
    // Cluster B — confidence / intelligence tiers
    | "confirmed" | "reported" | "predicted" | "indexed"
    // Cluster C — play types
    | "active" | "passive" | "semi-passive" | "hybrid" | "heist" | "mission"
    // Expenditure variants
    | "investment" | "injection" | "consumption"
    // Chart category (neutral)
    | "economy-ig" | "economy-rl" | "community" | "performance" | "history" | "promotions"
    // Income tier
    | "s-plus" | "s-tier" | "a-tier" | "b-tier" | "c-tier" | "d-tier"
    // Status
    | "official" | "alert" | "projected" | "regression";
  label?: string;
  size?: "xs" | "sm";
  class?: string;
}

const { variant, label, size = "sm", class: extraClass = "" } = Astro.props;

// ── Canonical variant → color token + default label ──────────────────────────
const VARIANTS: Record<string, { token: string; defaultLabel: string }> = {
  // Cluster A — game titles
  "gta-vi":        { token: "var(--c-title-vi)",      defaultLabel: "GTA VI"       },
  "gta-online":    { token: "var(--c-title-online)",  defaultLabel: "GTA Online"   },
  "gta-v":         { token: "var(--c-title-v)",       defaultLabel: "GTA V"        },
  "franchise":     { token: "var(--c-brand)",         defaultLabel: "Franchise"    },
  "gta-sa":        { token: "var(--c-title-sa)",      defaultLabel: "GTA SA"       },
  "gta-vc":        { token: "var(--c-title-vc)",      defaultLabel: "GTA VC"       },
  "gta-iv":        { token: "var(--c-text-6)",        defaultLabel: "GTA IV"       },
  "gta-iii":       { token: "var(--c-text-6)",        defaultLabel: "GTA III"      },
  // Cluster B — confidence tiers
  "confirmed":     { token: "var(--c-live)",          defaultLabel: "Confirmed"    },
  "reported":      { token: "var(--c-brand)",         defaultLabel: "Reported"     },
  "predicted":     { token: "var(--c-text-4)",        defaultLabel: "Predicted"    },
  "indexed":       { token: "var(--c-text-5)",        defaultLabel: "Indexed"      },
  // Cluster C — play types
  "active":        { token: "var(--c-play-active)",   defaultLabel: "Active"       },
  "passive":       { token: "var(--c-play-passive)",  defaultLabel: "Passive"      },
  "semi-passive":  { token: "var(--c-play-semi)",     defaultLabel: "Semi-passive" },
  "hybrid":        { token: "var(--c-play-semi)",     defaultLabel: "Hybrid"       },
  "heist":         { token: "var(--c-play-heist)",    defaultLabel: "Heist"        },
  "mission":       { token: "var(--c-play-mission)",  defaultLabel: "Mission"      },
  // Expenditure variants
  "investment":    { token: "var(--c-brand)",         defaultLabel: "Investment"   },
  "injection":     { token: "var(--c-economy)",       defaultLabel: "Injection"    },
  "consumption":   { token: "var(--c-flow-spending)", defaultLabel: "Consumption"  },
  // Chart categories (neutral zinc)
  "economy-ig":    { token: "var(--c-text-4)",        defaultLabel: "IG Economy"   },
  "economy-rl":    { token: "var(--c-text-4)",        defaultLabel: "RL Economy"   },
  "community":     { token: "var(--c-text-4)",        defaultLabel: "Community"    },
  "performance":   { token: "var(--c-text-4)",        defaultLabel: "Performance"  },
  "history":       { token: "var(--c-text-4)",        defaultLabel: "History"      },
  "promotions":    { token: "var(--c-text-4)",        defaultLabel: "Promotions"   },
  // Income tier S→D
  "s-plus":        { token: "var(--c-growth)",        defaultLabel: "S+"           },
  "s-tier":        { token: "var(--c-brand)",         defaultLabel: "S"            },
  "a-tier":        { token: "var(--c-live)",          defaultLabel: "A"            },
  "b-tier":        { token: "var(--c-economy)",       defaultLabel: "B"            },
  "c-tier":        { token: "var(--c-text-4)",        defaultLabel: "C"            },
  "d-tier":        { token: "var(--c-text-6)",        defaultLabel: "D"            },
  // Status
  "official":      { token: "var(--c-brand)",         defaultLabel: "Official"     },
  "alert":         { token: "var(--c-alert)",         defaultLabel: "Alert"        },
  "projected":     { token: "var(--c-brand)",         defaultLabel: "Projected"    },
  "regression":    { token: "var(--c-alert)",         defaultLabel: "Regression"   },
};

const config   = VARIANTS[variant] ?? VARIANTS["predicted"]!;
const text     = label ?? config.defaultLabel;
const sizeCls  = size === "xs" ? "text-[9px] px-1.5 py-0.5" : "text-[10px] px-2 py-0.5";
---

<span
  class={`inline-flex items-center border rounded font-mono uppercase tracking-widest ${sizeCls} ${extraClass}`}
  style={pillStyle(config.token)}
>
  {text}
</span>
