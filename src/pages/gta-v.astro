---
import Base from "../layouts/Base.astro";
import PlayerChart from "../components/PlayerChart.astro";
import TrendsChart from "../components/TrendsChart.astro";
import VehicleChart from "../components/VehicleChart.astro";
import ShareButton from "../components/ShareButton.astro";

import steamData       from "../../data/gta-5/meta/steam-players.json";
import trendsData      from "../../data/gta-5/trends/search-interest.json";
import vehicleData     from "../../data/gta-5/vehicles/performance.json";
import missionsData    from "../../data/gta-5/missions/story-missions.json";
import heistsData      from "../../data/gta-5/missions/heists.json";
import stocksData      from "../../data/gta-5/economy/assassination-stocks.json";
import onlineMissions  from "../../data/gta-5/missions/online-top.json";

const totalMonths   = steamData.data.length;
const totalVehicles = vehicleData.vehicles.length;
const trendsSince   = trendsData.keywords[0]?.data[0]?.date?.slice(0, 4) ?? "2013";
const trendsUntil   = trendsData.keywords[0]?.data.at(-1)?.date?.slice(0, 4) ?? "2026";
const totalTrendPts = trendsData.keywords.reduce((s, k) => s + k.data.length, 0);
const latestSteam   = steamData.data.at(-1);
const peakSteam     = steamData.data.reduce((a, b) => a.avg_players > b.avg_players ? a : b);

// Economy stats
const storyMissions  = (missionsData as any).missions as any[];
const payingMissions = storyMissions.filter(m => m.payout > 0);
const totalEarnings  = storyMissions.reduce((s: number, m: any) => s + (m.payout ?? 0), 0);
const maxEarnings    = Math.max(...storyMissions.map((m: any) => m.payout ?? 0));
const stockMissions  = storyMissions.filter((m: any) => m.stock_mission);
const heists         = (heistsData as any).heists as any[];
const bigScore       = heists.find((h: any) => h.id === "the-big-score");
const topOnline      = (onlineMissions as any).missions as any[];

// TIER_COLORS for stock steps
const RETURN_COLOR = (pct: number) =>
  pct >= 200 ? "#22c55e" : pct >= 80 ? "#f59e0b" : "#0d9488";
---

<Base
  title="GTA V Data"
  description="GTA V complete intelligence — Steam players, vehicle benchmarks, story mission earnings, assassination stock guide, heist payouts, and GTA Online economics."
  ogPage="gta-v"
>

  <!-- Page header -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden">
    <div class="absolute inset-0">
      <img src="/assets/covers/gta-5.jpg" alt="" class="absolute right-0 top-0 h-full w-auto object-cover opacity-12" aria-hidden="true" style="filter:saturate(0.5);max-width:50%" />
      <div class="absolute inset-0" style="background:linear-gradient(to right,#0a0a0d 40%,transparent 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,transparent 0%,#0a0a0d 100%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center gap-2 mb-5">
        <span class="text-[10px] font-mono text-zinc-600 border border-[#2a2a31] rounded px-2 py-0.5 uppercase tracking-widest">Grand Theft Auto V</span>
        <span class="text-[10px] font-mono text-zinc-700">2013 · Rockstar Games</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3" style="font-family:'Inter',sans-serif">
        GTA V — Live Intelligence
      </h1>
      <p class="text-zinc-400 text-sm leading-relaxed mb-8 max-w-lg" style="font-family:'Inter',sans-serif">
        11 years of live signals: Steam players, vehicle benchmarks, story mission earnings,
        assassination stock guide, heist payouts, and GTA Online economics. The complete data blueprint for GTA VI.
      </p>

      <!-- Stat strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl">
        {[
          { value: String(totalMonths), label: "months of player data", sub: `${steamData.data[0].year}–${latestSteam?.year}` },
          { value: String(totalVehicles), label: "vehicles benchmarked", sub: "25 classes · Broughy1322" },
          { value: `$${(totalEarnings / 1_000_000).toFixed(1)}M`, label: "max story earnings", sub: "incl. The Big Score" },
          { value: `$2B+`, label: "with stock strategy", sub: "assassination missions" },
        ].map(s => (
          <div class="rounded-xl border border-[#1e1e23] px-4 py-3" style="background:#131316">
            <div class="text-xl font-mono font-bold text-gta-bright">{s.value}</div>
            <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug" style="font-family:'Inter',sans-serif">{s.label}</div>
            <div class="text-[10px] font-mono text-zinc-700 mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">

    <!-- Steam players -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-gta-teal shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Steam — Player History</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">PC concurrent · monthly</span>
      </div>
      <PlayerChart />
    </section>

    <!-- Google Trends -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Google Trends — Search Interest</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{totalTrendPts} data points · worldwide</span>
      </div>
      <TrendsChart />
    </section>

    <!-- Vehicle benchmarks -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-gta-red shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Broughy1322 — Vehicle Benchmarks</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{totalVehicles} vehicles · 25 classes</span>
      </div>
      <VehicleChart />
    </section>

    <!-- ═══════════════════════════════════════════════════════
         ASSASSINATION STOCK GUIDE
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[9px] font-mono bg-amber-900/30 text-amber-500 border border-amber-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Economy</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Lester's Assassination Stock Guide</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-gta-gold/70">$2B+ theoretical maximum</span>
      </div>

      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <!-- Header -->
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">The $2 Billion Strategy — 5 Missions, Maximum Profit</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Complete Hotel Assassination early (forced). Do all others AFTER The Big Score. Reinvest between each.</div>
          </div>
          <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-gta-gold/80 inline-block"></span>Buy before</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-gta-teal/80 inline-block"></span>Sell / recovery</span>
          </div>
        </div>

        <!-- Step cards -->
        <div class="divide-y divide-[#1e1e23]">
          {(stocksData as any).guide_order.map((step: any, i: number) => (
            <div class="px-5 py-4 flex flex-col sm:flex-row gap-4">
              <!-- Step number + mission -->
              <div class="shrink-0 sm:w-64">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-[9px] font-mono bg-gta-gold/10 text-gta-gold border border-gta-gold/20 px-1.5 py-0.5 rounded uppercase tracking-widest">Step {step.step}</span>
                  {i === 0 && <span class="text-[8px] font-mono bg-gta-teal/10 text-gta-teal border border-gta-teal/20 px-1.5 py-0.5 rounded uppercase tracking-widest">Do FIRST</span>}
                </div>
                <div class="text-sm font-semibold text-zinc-200" style="font-family:'Inter',sans-serif">{step.title}</div>
                <div class="text-[10px] font-mono text-zinc-600 mt-0.5">{step.when}</div>
                <div class="text-[10px] font-mono text-zinc-700 mt-1">Mission payout: <span class="text-zinc-500">${(step.payout_direct ?? 0).toLocaleString()}</span></div>
              </div>

              <!-- Stock steps -->
              <div class="flex-1 flex flex-col gap-2">
                {step.strategy.map((s: any) => (
                  <div class="flex items-start gap-3 rounded-lg px-3 py-2.5" style={`background:${s.action === 'buy' ? 'rgba(245,158,11,0.06)' : 'rgba(13,148,136,0.06)'}`}>
                    <div class="shrink-0 mt-0.5">
                      <span class={`text-[8px] font-mono font-bold px-1.5 py-0.5 rounded uppercase tracking-widest ${s.action === 'buy' ? 'bg-gta-gold/20 text-gta-gold' : 'bg-gta-teal/20 text-gta-teal'}`}>
                        {s.action === 'buy' ? '▲ BUY' : '▼ SELL'}
                      </span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-baseline gap-2 flex-wrap">
                        <span class="text-sm font-mono font-bold text-zinc-200">{s.ticker}</span>
                        <span class="text-[10px] text-zinc-400" style="font-family:'Inter',sans-serif">{s.stock}</span>
                        <span class="text-[9px] font-mono text-zinc-600">{s.exchange}</span>
                        {s.expected_return_pct && (
                          <span class="text-[10px] font-mono font-bold ml-auto" style={`color:${RETURN_COLOR(s.expected_return_pct)}`}>+{s.expected_return_pct}%</span>
                        )}
                      </div>
                      <div class="text-[10px] text-zinc-500 mt-0.5 leading-snug" style="font-family:'Inter',sans-serif">{s.timing}</div>
                      {s.note && <div class="text-[9px] font-mono text-zinc-700 mt-0.5">{s.note}</div>}
                    </div>
                  </div>
                ))}
              </div>

              <!-- Combined return -->
              <div class="sm:w-24 flex sm:flex-col items-center sm:items-end justify-between sm:justify-center gap-1">
                <div class="text-right">
                  <div class="text-xl font-mono font-bold" style={`color:${RETURN_COLOR(step.combined_return_pct)}`}>+{step.combined_return_pct}%</div>
                  <div class="text-[9px] font-mono text-zinc-600">total return</div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Footer -->
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3" style="background:#0e0e11">
          <span class="text-[10px] text-zinc-700 font-mono">Sources: GTA Wiki · community guides · optimal sequence = ~$2B across all 3 characters</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="The GTA V assassination stock guide. 5 missions, optimal order, $2B+ theoretical maximum. Multi-Target + Redwood Cigarettes is the best single play in the game." url="https://gtavi.ai/gta-v" size="sm" label="Share" /></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         STORY MISSION EARNINGS CHART
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[9px] font-mono bg-amber-900/30 text-amber-500 border border-amber-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Economy</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Story Mission Earnings — Full Arc</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{payingMissions.length} paying missions · {stockMissions.length} stock missions</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">Earnings Curve — $250 Repossession to $41.6M Big Score</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Each mission plotted by chapter. Gold diamonds = Lester stock missions. The Big Score is the only real money event.</div>
          </div>
          <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-gta-gold/80 inline-block"></span>Stock mission</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-zinc-500 inline-block"></span>Standard mission</span>
          </div>
        </div>
        <div id="mission-earnings-chart" class="w-full" style="height:280px"
          data-missions={JSON.stringify(storyMissions.filter((m: any) => m.payout >= 0))}
        ></div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Source: GTA Wiki (Fandom) · community records · updated by fetch_missions.py</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA V story mission earnings from start to finish. $250 at Repossession to $41.6M at The Big Score. The earning curve tells the whole story." url="https://gtavi.ai/gta-v" size="sm" label="Share" /></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         HEIST EARNINGS
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[9px] font-mono bg-amber-900/30 text-amber-500 border border-amber-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Economy</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Heist Earnings — Take Breakdown</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{heists.length} heists · max ${((bigScore?.approaches?.[0]?.player_max_cut ?? 0) / 1_000_000).toFixed(1)}M player cut</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">Story Heists — Total Take vs Player Cut</div>
          <div class="text-[11px] text-zinc-500 font-mono mt-0.5">3 of 5 heists pay $0 (lore reasons). The Big Score is the only heist that changes your financial trajectory.</div>
        </div>
        <div class="divide-y divide-[#1e1e23]">
          {heists.map((h: any) => {
            const bestApproach = h.approaches.reduce((best: any, a: any) =>
              (a.player_max_cut ?? 0) > (best.player_max_cut ?? 0) ? a : best, h.approaches[0]);
            const cut = bestApproach?.player_max_cut ?? 0;
            const total = bestApproach?.total_take ?? 0;
            const maxCut = bigScore?.approaches?.[0]?.player_max_cut ?? 1;
            const barPct = cut > 0 ? Math.round((cut / maxCut) * 100) : 0;
            return (
              <div class="px-5 py-4 flex items-center gap-4">
                <div class="w-36 shrink-0">
                  <div class="text-xs font-semibold text-zinc-200" style="font-family:'Inter',sans-serif">{h.title}</div>
                  <div class="text-[9px] font-mono text-zinc-600 mt-0.5">Ch.{h.chapter} · {h.difficulty}</div>
                </div>
                <div class="flex-1">
                  {cut > 0 ? (
                    <div>
                      <div class="h-2 rounded-full bg-[#1e1e23] overflow-hidden">
                        <div class="h-full rounded-full bg-gta-gold/80" style={`width:${barPct}%`}></div>
                      </div>
                      <div class="flex items-center justify-between mt-1">
                        <span class="text-[10px] font-mono text-zinc-500">Player cut: <span class="text-gta-gold font-bold">${(cut / 1_000_000).toFixed(1)}M</span></span>
                        <span class="text-[9px] font-mono text-zinc-700">Total take: ${(total / 1_000_000).toFixed(1)}M</span>
                      </div>
                    </div>
                  ) : (
                    <div class="flex items-center gap-2">
                      <div class="h-2 flex-1 rounded-full bg-[#1e1e23]"></div>
                      <span class="text-[10px] font-mono text-zinc-700">$0 — {h.notes}</span>
                    </div>
                  )}
                </div>
                {h.approaches.length > 1 && (
                  <div class="shrink-0 text-[9px] font-mono text-zinc-700">
                    {h.approaches.length} approaches
                  </div>
                )}
              </div>
            );
          })}
        </div>
        <!-- Big Score crew guide -->
        {bigScore && (
          <div class="px-5 py-4 border-t border-[#1e1e23]" style="background:#0e0e11">
            <div class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest mb-2">The Big Score — Optimal Crew (Subtle Approach)</div>
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
              {Object.entries(bigScore.approaches[0].optimal_crew ?? {}).map(([role, assignment]) => (
                <div class="rounded border border-[#1e1e23] px-2.5 py-2">
                  <div class="text-[8px] font-mono text-zinc-600 uppercase tracking-widest mb-0.5">{role.replace(/_/g,' ')}</div>
                  <div class="text-[10px] font-mono text-zinc-300">{String(assignment)}</div>
                </div>
              ))}
            </div>
          </div>
        )}
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Source: GTA Wiki (Fandom) · optimal crew minimises cut to maximise protagonist take</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA V heist earnings: 3 of 5 heists pay $0 (lore). The Big Score with optimal crew = $41.6M player cut. Then invest in Lester's assassination missions for $2B+." url="https://gtavi.ai/gta-v" size="sm" label="Share" /></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         GTA ONLINE TOP MISSIONS $/HR
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[9px] font-mono bg-green-900/30 text-green-500 border border-green-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA Online — Top Contact Missions by GTA$/hr</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{topOnline.length} missions ranked · solo optimal</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">Best GTA Online Contact Missions — Solo Farming Guide</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Solo, fully levelled, 2024 patches. Excludes heists, adversary modes, businesses.</div>
          </div>
          <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-gta-gold/80 inline-block"></span>Easy</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-amber-500/80 inline-block"></span>Medium</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-gta-red/80 inline-block"></span>Hard</span>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-xs font-mono">
            <thead>
              <tr class="border-b border-[#1e1e23]">
                <th class="text-left px-5 py-2.5 text-zinc-600 font-normal w-6">#</th>
                <th class="text-left px-3 py-2.5 text-zinc-600 font-normal">Mission</th>
                <th class="text-left px-3 py-2.5 text-zinc-600 font-normal">Contact</th>
                <th class="text-right px-3 py-2.5 text-zinc-600 font-normal">GTA$/hr</th>
                <th class="text-right px-3 py-2.5 text-zinc-600 font-normal">Payout</th>
                <th class="text-right px-3 py-2.5 text-zinc-600 font-normal">Avg time</th>
                <th class="text-right px-5 py-2.5 text-zinc-600 font-normal">Difficulty</th>
              </tr>
            </thead>
            <tbody>
              {topOnline.slice(0, 15).map((m: any, i: number) => {
                const diffColor = m.difficulty === "Hard" ? "text-gta-red" : m.difficulty === "Medium" ? "text-amber-400" : "text-gta-teal";
                return (
                  <tr class="border-b border-[#1e1e23]/50 hover:bg-white/2 transition-colors">
                    <td class="px-5 py-2.5 text-zinc-700">{i+1}</td>
                    <td class="px-3 py-2.5 text-zinc-200 font-semibold">{m.title}</td>
                    <td class="px-3 py-2.5 text-zinc-500">{m.contact}</td>
                    <td class="px-3 py-2.5 text-right text-gta-gold font-bold">${(m.gta_per_hr / 1000).toFixed(0)}k</td>
                    <td class="px-3 py-2.5 text-right text-zinc-400">${m.payout.toLocaleString()}</td>
                    <td class="px-3 py-2.5 text-right text-zinc-600">{m.avg_completion_min}min</td>
                    <td class={`px-5 py-2.5 text-right ${diffColor}`}>{m.difficulty}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Sources: GTABase.com · GTA Fandom Wiki · community benchmarks · 2024 patches</span>
