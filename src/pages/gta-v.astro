---
import Base from "../layouts/Base.astro";
import PlayerChart from "../components/PlayerChart.astro";
import TrendsChart from "../components/TrendsChart.astro";
import VehicleChart from "../components/VehicleChart.astro";
import ShareDropdown from "../components/ShareDropdown.astro";
import StockCalculator from "../components/StockCalculator.astro";
import SocialClubConnector from "../components/SocialClubConnector.astro";
import GamePill from "../components/GamePill.astro";
import { Image } from "astro:assets";
import heroGtaV from "../assets/images/hero-gta-v.webp";
import ChartAssassinationReturns from "../components/charts/ChartAssassinationReturns.astro";
import ChartDlcPlayerHistory     from "../components/charts/ChartDlcPlayerHistory.astro";
import ChartMissionEarnings      from "../components/charts/ChartMissionEarnings.astro";
import ChartPrelaunchComparison  from "../components/charts/ChartPrelaunchComparison.astro";
import ChartPreviewCard          from "../components/charts/ChartPreviewCard.astro";
import HeistCard                 from "../components/HeistCard.astro";
import { CATEGORY_BADGE_CLASSES } from "../config/categoryColors";
import { getChart } from "../config/allCharts";

const rAssassination = getChart("assassination-returns-chart")!;
const rDlcPlayer     = getChart("dlc-player-chart")!;
const rPrelaunch     = getChart("prelaunch-comparison-chart")!;

import steamData     from "../../data/gta-5/meta/steam-players.json";
import trendsData    from "../../data/gta-5/trends/search-interest.json";
import vehicleData   from "../../data/gta-5/vehicles/performance.json";
import missionsData  from "../../data/gta-5/missions/story-missions.json";
import heistsData    from "../../data/gta-5/missions/heists.json";
import stocksData    from "../../data/gta-5/economy/assassination-stocks.json";

const totalMonths   = steamData.data.length;
const totalVehicles = vehicleData.vehicles.length;
const trendsSince   = trendsData.keywords[0]?.data[0]?.date?.slice(0, 4) ?? "2013";
const trendsUntil   = trendsData.keywords[0]?.data.at(-1)?.date?.slice(0, 4) ?? "2026";
const totalTrendPts = trendsData.keywords.reduce((s, k) => s + k.data.length, 0);
const latestSteam   = steamData.data.at(-1);
const peakSteam     = steamData.data.reduce((a, b) => a.avg_players > b.avg_players ? a : b);

const storyMissions  = (missionsData as any).missions as any[];
const payingMissions = storyMissions.filter(m => m.payout > 0);
const totalEarnings  = storyMissions.reduce((s: number, m: any) => s + (m.payout ?? 0), 0);
const maxEarnings    = Math.max(...storyMissions.map((m: any) => m.payout ?? 0));
const stockMissions  = storyMissions.filter((m: any) => m.stock_mission);
const heists         = (heistsData as any).heists as any[];
const bigScore       = heists.find((h: any) => h.id === "the-big-score");

---

<Base
  titleContext="gta-v"
  title="GTA V Story Mode"
  description="GTA V story mode data — mission earnings, heist payouts, assassination stock guide, vehicle benchmarks, and the complete $2B money strategy."
  ogPage="gta-v"
  crossLinksContext="gta-v"
>

  <!-- Page header -->
  <section class="relative border-b border-border-dim overflow-hidden" style="min-height:360px">
    <div class="absolute inset-0">
      <Image src={heroGtaV} alt="" class="absolute inset-0 w-full h-full object-cover" style="object-position:center 35%" aria-hidden="true"
           widths={[1280, 1920, 2560]} sizes="100vw" format="webp" loading="eager" />
      <div class="absolute inset-0" style="background:linear-gradient(to right,#0a0a0d 0%,#0a0a0dcc 35%,#0a0a0d33 75%,transparent 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,transparent 55%,#0a0a0d 100%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center gap-2 mb-5">
        <GamePill game="gta-v" size="xs" />
        <span class="text-[10px] font-mono text-zinc-500">2013 · Rockstar Games</span>
      </div>
      <h1 class="sr-only">Grand Theft Auto V</h1>
      <p class="text-zinc-400 text-sm leading-relaxed mb-8 max-w-lg">
        11 years of live signals: Steam players, vehicle benchmarks, story mission earnings,
        assassination stock guide, heist payouts, and GTA Online economics. The complete data blueprint for GTA VI.
      </p>

      <!-- Stat strip — economics-first -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl">
        {[
          { value: "$41.6M",   label: "Big Score player cut",  sub: "optimal crew · subtle" },
          { value: "$2B+",     label: "assassination strategy", sub: "stock market guide →" },
          { value: `${heists.length}`, label: "story heists",  sub: "full take breakdown" },
          { value: String(totalMonths), label: "months live data", sub: `Steam ${steamData.data[0].year}–${latestSteam?.year}` },
        ].map(s => (
          <div class="rounded-xl border border-border-dim px-4 py-3" style="background:var(--c-card)">
            <div class="text-xl font-mono font-bold text-gta-bright">{s.value}</div>
            <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug">{s.label}</div>
            <div class="text-[10px] font-mono text-zinc-500 mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">

    <!-- Steam players -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <GamePill game="gta-v" size="xs" />
        <span class={CATEGORY_BADGE_CLASSES}>Community</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Steam — Player History</span>
        <div class="flex-1 h-px bg-border-dim"></div>
        <span class="text-[10px] font-mono text-zinc-500 shrink-0">PC concurrent · monthly</span>
      </div>
      <PlayerChart />
    </section>

    <!-- Google Trends -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <GamePill game="gta-v" size="xs" />
        <span class={CATEGORY_BADGE_CLASSES}>Community</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Google Trends — Search Interest</span>
        <div class="flex-1 h-px bg-border-dim"></div>
        <span class="text-[10px] font-mono text-zinc-500 shrink-0">{totalTrendPts} data points · worldwide</span>
      </div>
      <TrendsChart />
    </section>

    <!-- Vehicle benchmarks -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <GamePill game="gta-v" size="xs" />
        <span class={CATEGORY_BADGE_CLASSES}>Performance</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Broughy1322 — Vehicle Benchmarks</span>
        <div class="flex-1 h-px bg-border-dim"></div>
        <span class="text-[10px] font-mono text-zinc-500 shrink-0">{totalVehicles} vehicles · 25 classes</span>
      </div>
      <VehicleChart />
    </section>

    <!-- ═══════════════════════════════════════════════════════
         STOCK MARKET CALCULATOR
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <GamePill game="gta-v" size="xs" />
        <span class={CATEGORY_BADGE_CLASSES}>Economy-IG</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Story Mode Stock Market Calculator</span>
        <div class="flex-1 h-px bg-border-dim"></div>
        <span class="text-[10px] font-mono text-zinc-500 shrink-0">$2B+ visual playthrough</span>
      </div>
      <StockCalculator steps={(stocksData as any).guide_order} />
    </section>

    <!-- ═══════════════════════════════════════════════════════
         STORY MISSION EARNINGS CHART
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <GamePill game="gta-v" size="xs" />
        <span class={CATEGORY_BADGE_CLASSES}>Economy-IG</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Story Mission Earnings — Full Arc</span>
        <div class="flex-1 h-px bg-border-dim"></div>
        <span class="text-[10px] font-mono text-zinc-500 shrink-0">{payingMissions.length} paying missions · {stockMissions.length} stock missions</span>
      </div>
      <ChartMissionEarnings />
    </section>

    <!-- ═══════════════════════════════════════════════════════
         HEIST CARDS — Story Heists
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <GamePill game="gta-v" size="xs" />
        <span class={CATEGORY_BADGE_CLASSES}>Economy-IG</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Story Heists — Take Breakdown</span>
        <div class="flex-1 h-px bg-border-dim"></div>
        <span class="text-[10px] font-mono text-zinc-500 shrink-0">{heists.length} heists · max ${((bigScore?.approaches?.[0]?.player_max_cut ?? 0) / 1_000_000).toFixed(1)}M player cut</span>
      </div>
      <div class="text-[11px] text-zinc-500 font-mono mb-4">3 of 5 heists pay $0 — story-required. Only The Jewel Store Job and The Big Score pay out. Invest Big Score proceeds into Lester's assassination missions for $2B+.</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-3">
        {heists.map((h: any) => (
          <HeistCard
            id={h.id}
            title={h.title}
            chapter={h.chapter}
            protagonists={h.protagonists}
            approaches={h.approaches}
            difficulty={h.difficulty}
            replay_value={h.replay_value}
            notes={h.notes}
            thumbnail={h.thumbnail ?? null}
          />
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         SOCIAL CLUB CONNECTOR
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <GamePill game="gta-v" size="xs" />
        <span class={CATEGORY_BADGE_CLASSES}>Community</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Your Stats vs Community</span>
        <div class="flex-1 h-px bg-border-dim"></div>
        <span class="text-[10px] font-mono text-zinc-500 shrink-0">Rockstar Social Club · Phase 1</span>
      </div>
      <SocialClubConnector />
    </section>

    <!-- Crosslinks to GTA Online -->
    <div class="rounded-xl border border-gta-teal/20 overflow-hidden" style="background:#0e1a0e">
      <div class="px-5 py-4 flex items-start gap-4">
        <div class="text-2xl shrink-0">🎮</div>
        <div class="flex-1">
          <div class="font-semibold text-zinc-200 text-sm mb-1">GTA Online Economy → Separate Section</div>
          <p class="text-[11px] text-zinc-500 font-mono leading-relaxed mb-3">
            GTA Online income sources, economy model, weekly bonuses, and income adviser have moved to the dedicated GTA Online section.
          </p>
          <a href="/gta-online/income" class="text-[10px] font-mono text-gta-teal hover:text-gta-teal transition-colors tracking-widest uppercase border border-gta-teal/30 px-3 py-1.5 rounded hover:bg-gta-teal/20">
            GTA Online Income Sources →
          </a>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         MORE GTA V CHARTS — preview cards
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-4">
        <GamePill game="gta-v" size="xs" />
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// More GTA V Charts</span>
        <div class="flex-1 h-px bg-border-dim"></div>
        <a href="/charts?title=gta-v" class="text-[10px] font-mono text-zinc-500 hover:text-zinc-400 transition-colors tracking-widest uppercase shrink-0">All charts →</a>
      </div>
      <div class="flex flex-col gap-2">

        <ChartPreviewCard
          cardId="preview-assassination"
          title={rAssassination.label}
          description={rAssassination.shareText}
          category={rAssassination.badge}
          deepLink={`/charts#section-${rAssassination.id}`}
          thumbUrl="/assets/covers/gta-5.jpg"
        >
          <ChartAssassinationReturns />
        </ChartPreviewCard>

        <ChartPreviewCard
          cardId="preview-dlc-players"
          title={rDlcPlayer.label}
          description={rDlcPlayer.shareText}
          category={rDlcPlayer.badge}
          deepLink={`/charts#section-${rDlcPlayer.id}`}
          thumbUrl="/assets/covers/gta-5.jpg"
        >
          <ChartDlcPlayerHistory />
        </ChartPreviewCard>

        <ChartPreviewCard
          cardId="preview-prelaunch-v"
          title={rPrelaunch.label}
          description={rPrelaunch.shareText}
          category={rPrelaunch.badge}
          deepLink={`/charts#section-${rPrelaunch.id}`}
          thumbUrl="/assets/covers/gta-5.jpg"
        >
          <ChartPrelaunchComparison />
        </ChartPreviewCard>
      </div>
    </section>


  </div>
</Base>

