---
import Base from "../../layouts/Base.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import CircularEconomy from "../../components/CircularEconomy.astro";
import ChartComplexityRadar from "../../components/ChartComplexityRadar.astro";
import GamePill from "../../components/GamePill.astro";
import CardFooter from "../../components/CardFooter.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getEconomyModel } from "../../config/economyModels";
import economyData from "../../../data/franchise/economy-models.json";

const economy = (economyData as any).economies.find((e: any) => e.title_id === "gta-4");
const ecoModel = getEconomyModel("gta-4")!;
const dims = economy.dimension_scores as Record<string, number>;
const activeDims = Object.entries(dims).filter(([, v]) => (v as number) > 0);
---

<Base
  titleContext="gta-iv"
  ogPage="gta-iv-eco"
  title={`${economy.title_name} — Economy`}
  description={`${economy.economy_type} · ${economy.real_world_analogue} · GTAVI.AI franchise economic analysis.`}
>
  <!-- Hero -->
  <section class="relative border-b border-border-dim overflow-hidden" style="min-height:200px">
    <div class="absolute inset-0" style="background:var(--c-hero-bloom),var(--c-bg-deep)"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-center gap-2 mb-3 flex-wrap">
        <GamePill game="gta-iv" size="xs" />
        <span class="text-[10px] font-mono border border-border-mid text-zinc-500 px-2 py-0.5 rounded uppercase tracking-widest">{economy.era_label}</span>
        <span class="text-[10px] font-mono text-zinc-600 border border-border-dim px-2 py-0.5 rounded uppercase tracking-widest">Complexity {economy.complexity_score}/17</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">{economy.title_name} — Economy</h1>
      <p class="text-zinc-400 text-sm leading-relaxed max-w-xl">{economy.summary}</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">

    <!-- Economy diagram + radar -->
    <section>
      <SectionHeader label="// Circular Economy Model" pillHref="/franchise/economics" pillLabel="← Ten Economies" />
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-bg)">
          <div class="p-5">
            <CircularEconomy titleId="gta-4" mode="full" />
          </div>
          <CardFooter anchorId={ecoModel.anchorId} sources="Source: curated · GTA Fandom Wiki · franchise economic analysis" shareText={ecoModel.shareText} />
        </div>
        <ChartComplexityRadar titleId="gta-4" size={260} />
      </div>
    </section>

    <!-- Regression Callout — the unique story of GTA IV -->
    <section>
      <SectionHeader label="// A Deliberate Step Backward" dotColor="var(--c-alert)" />
      <div class="rounded-xl border overflow-hidden" style="background:color-mix(in srgb,var(--c-alert) 5%,var(--c-card));border-color:color-mix(in srgb,var(--c-alert) 20%,transparent)">
        <div class="px-6 py-5">
          <div class="text-[10px] font-mono uppercase tracking-widest mb-2" style="color:var(--c-alert)">Economic Regression — By Design</div>
          <div class="text-base font-semibold text-zinc-200 mb-3">{economy.key_innovation}</div>
          <p class="text-[11px] font-mono text-zinc-500 leading-relaxed mb-5">
            Rockstar explicitly stripped property, territory, gambling, and the stock market from San Andreas. GTA IV is economically simpler than Vice City (2002) — narrative realism took precedence over economic depth.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="rounded-lg border border-border-dim px-4 py-3" style="background:var(--c-card)">
              <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-1.5">Why Rockstar Regressed</div>
              <p class="text-[10px] font-mono text-zinc-500 leading-snug">Niko Bellic earns to survive, not to accumulate. Money barely accrues meaningfully — narrative drives spending, not capital formation. Realism over system depth.</p>
            </div>
            <div class="rounded-lg border overflow-hidden px-4 py-3" style="background:color-mix(in srgb,var(--c-economy) 5%,var(--c-card));border-color:color-mix(in srgb,var(--c-economy) 20%,transparent)">
              <div class="text-[10px] font-mono uppercase tracking-widest mb-1.5" style="color:var(--c-economy)">TBOGT Bridge Mechanic</div>
              <p class="text-[10px] font-mono text-zinc-500 leading-snug">TBOGT's nightclub management is proto-passive income — the direct conceptual ancestor of GTA Online's entire business stack. Without it, there may have been no Acid Lab.</p>
            </div>
          </div>
          {activeDims.length === 0 && (
            <div class="mt-4 flex gap-2">
              <span class="text-[10px] font-mono border border-border-mid text-zinc-600 px-2 py-0.5 rounded">All economic dimensions at zero — intentional regression</span>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- GTA VI Lineage -->
    <section class="rounded-xl border border-gta-gold/15 px-6 py-5" style="background:var(--c-hero-bloom)">
      <div class="text-[10px] font-mono text-gta-gold/50 uppercase tracking-widest mb-2">GTA VI Lineage</div>
      <p class="text-[11px] font-mono text-zinc-400 leading-relaxed">{economy.gta_vi_lineage}</p>
    </section>

    <!-- Nav CTAs -->
    <div class="flex items-center gap-3 flex-wrap">
      <a href="/gta-sa/economy" class="px-4 py-2 rounded border border-border-mid text-zinc-400 text-[11px] font-mono hover:border-zinc-600 hover:text-zinc-200 transition-all">← GTA SA: Peak Complexity</a>
      <a href="/gta-v/economy" class="px-4 py-2 rounded border border-gta-gold/30 text-gta-gold text-[11px] font-mono hover:bg-gta-gold/10 transition-all">GTA V: Capital Market Recovery →</a>
    </div>

    <CrossLinks context="franchise" />
  </div>
</Base>
