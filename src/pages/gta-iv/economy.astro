---
import Base from "../../layouts/Base.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import ShareButton from "../../components/ShareButton.astro";
import CircularEconomy from "../../components/CircularEconomy.astro";
import ChartComplexityRadar from "../../components/ChartComplexityRadar.astro";
import economyData from "../../../data/franchise/economy-models.json";
const economy = (economyData as any).economies.find((e: any) => e.title_id === "gta-4");
---
<Base
  titleContext="gta-iv"
  title={economy.title_name + " — Economy"} description={economy.economy_type + " · " + economy.real_world_analogue + " · GTAVI.AI franchise economic analysis."} ogPage="gta-v">
  <section class="relative border-b border-[#1e1e23] overflow-hidden" style="min-height:200px">
    <div class="absolute inset-0" style="background:#0a0a0d"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-center gap-2 mb-4 flex-wrap">
        <span class="bg-red-900/30 border-red-600/40 text-red-400 text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest">{economy.era_label}</span>
        <span class="text-[11px] font-mono bg-red-900/30 border border-red-600/40 text-red-400 px-2 py-0.5 rounded uppercase tracking-widest">Deliberate Regression</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">{economy.title_name} — Economy</h1>
      <p class="text-zinc-300 text-sm leading-relaxed max-w-xl">The franchise's economic low point — and its most important turning point. Six years of innovation stripped for narrative realism. But TBOGT's nightclub mechanic planted the seed that became GTA Online's entire business empire.</p>
    </div>
  </section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="identity-dot"></span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Circular Economy Model</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 rounded-xl border border-[#1e1e23] p-5" style="background:#0e0e11">
          <CircularEconomy titleId="gta-4" mode="full" />
        </div>
        <ChartComplexityRadar titleId="gta-4" size={260} />
      </div>
    </section>
    <!-- Regression Callout -->
    <section>
      <div class="rounded-xl border border-red-900/30 overflow-hidden" style="background:rgba(127,29,29,0.07)">
        <div class="px-6 py-5">
          <div class="font-semibold text-red-300 text-sm mb-2">A 6-Year Step Backward — By Design</div>
          <p class="text-[11px] font-mono text-zinc-500 leading-relaxed mb-4">
            Rockstar explicitly stripped property, territory, gambling, and stocks from San Andreas. GTA IV is economically simpler than Vice City (2002) — narrative realism over economic depth.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="rounded-lg border border-[#2a2a31] px-4 py-3" style="background:#131316">
              <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-1">Why Rockstar regressed</div>
              <p class="text-[10px] font-mono text-zinc-400 leading-snug">Niko Bellic earns to survive, not to accumulate. Money barely accrues meaningfully — narrative drives spending, not capital formation.</p>
            </div>
            <div class="rounded-lg border border-purple-900/30 px-4 py-3" style="background:rgba(88,28,135,0.06)">
              <div class="text-[10px] font-mono text-purple-700 uppercase tracking-widest mb-1">TBOGT Bridge Mechanic</div>
              <p class="text-[10px] font-mono text-zinc-400 leading-snug">TBOGT nightclub management = proto-passive income. The direct conceptual ancestor of GTA Online's entire business stack. Without TBOGT, there may have been no Acid Lab.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="rounded-xl border border-gta-gold/15 px-6 py-5" style="background:var(--c-hero-bloom)">
      <div class="text-[11px] font-mono text-gta-gold/40 uppercase tracking-widest mb-2">GTA VI Lineage</div>
      <p class="text-[11px] font-mono text-zinc-300 leading-relaxed">{economy.gta_vi_lineage}</p>
    </section>
    <div class="flex items-center gap-3 flex-wrap">
      <a href="/franchise/economics" class="px-4 py-2 rounded border border-[#2a2a31] text-zinc-400 text-[11px] font-mono hover:border-zinc-600 hover:text-zinc-200 transition-all">← Ten Economies</a>
      <a href="/gta-v/economy" class="px-4 py-2 rounded border border-gta-gold/30 text-gta-gold text-[11px] font-mono hover:bg-gta-gold/20 transition-all">GTA V: Capital Market Recovery →</a>
    </div>
    <CrossLinks context="franchise" />
  </div>
</Base>
