---
/**
 * /community/polls/embed/[pollId] — Embeddable poll iframe endpoint.
 *
 * Renders a single VoteCard as a standalone minimal HTML page,
 * suitable for embedding via <iframe> on external sites (GTAForums, Reddit, etc.).
 *
 * Usage:
 *   <iframe
 *     src="https://gtavi.ai/community/polls/embed/pred-launch-price"
 *     width="420" height="340" frameborder="0"
 *     style="border-radius:12px;overflow:hidden"
 *   ></iframe>
 *
 * The iframe autosizes to its content; recommended minimum width is 320px.
 * The page sets X-Frame-Options: ALLOWALL and CSP frame-ancestors: * to permit
 * embedding from any origin.
 *
 * Static export — all valid pollIds are pre-rendered at build time.
 */

import "../../../../styles/tokens.css";
import type { GetStaticPaths } from "astro";
import predRaw from "../../../../../data/gta-6/predictions.json";

export const getStaticPaths: GetStaticPaths = () => {
  const polls = (predRaw as any).predictions.filter((p: any) => p.poll_question);
  return polls.map((p: any) => ({ params: { pollId: p.id } }));
};

const { pollId } = Astro.params;
const pred = (predRaw as any).predictions.find((p: any) => p.id === pollId);

if (!pred) {
  return Astro.redirect("/404");
}

const question  = pred.poll_question ?? pred.title;
const options: string[] = pred.poll_options ?? ["Yes", "No"];
const basis     = pred.basis ?? "";
const confidence: number | null = pred.confidence ?? null;

const SITE_BASE  = import.meta.env.SITE ?? "https://gtavi.ai";
const pollUrl    = `${SITE_BASE}/community/polls#vote-${pollId}`;
const shareText  = `${question} — Vote on GTAVI.AI`;
---

<!doctype html>
<html lang="en" style="color-scheme:dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{question} — GTAVI.AI Poll</title>

  <!-- Allow embedding from any origin -->
  <meta http-equiv="X-Frame-Options" content="ALLOWALL" />

  <!-- Google Fonts — match site typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=JetBrains+Mono:wght@400;700&display=swap"
    rel="stylesheet"
  />

  <style>
    /* ── Token system (subset for embed) ─────────────────────────── */
    :root {
      --c-bg:            #0e0e11;
      --c-bg-deep:       #0a0a0d;
      --c-card:          #131316;
      --c-border-1:      #1e1e23;
      --c-border-2:      #2a2a31;
      --c-brand:         #f59e0b;
      --c-live:          #22c55e;
      --c-alert:         #f97316;
      --c-economy:       #6366f1;
      --c-growth:        #22c55e;
      --c-text-1:        #ebebef;
      --c-text-2:        #d4d4d8;
      --c-text-3:        #b8b8c4;
      --c-text-4:        #9898b8;
      --c-text-5:        #b4b4cc;
      --font-sans:       "Inter", system-ui, sans-serif;
      --font-mono:       "JetBrains Mono", "Fira Mono", monospace;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--c-bg);
      font-family: var(--font-sans);
      color: var(--c-text-3);
      min-height: 100%;
    }

    body {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 0;
    }

    /* ── Vote card ─────────────────────────────────────────────── */
    .ec-card {
      width: 100%;
      max-width: 420px;
      border-radius: 0;
      border: none;
      background: var(--c-card);
      font-family: var(--font-mono);
      overflow: hidden;
    }

    .ec-header {
      padding: 10px 16px;
      border-bottom: 1px solid var(--c-border-1);
      background: var(--c-bg-deep);
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .ec-game-pill {
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--c-brand);
      border: 1px solid color-mix(in srgb, var(--c-brand) 35%, transparent);
      background: color-mix(in srgb, var(--c-brand) 10%, transparent);
      border-radius: 4px;
      padding: 2px 7px;
      font-family: var(--font-mono);
    }

    .ec-badge {
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: var(--c-brand);
      border: 1px solid color-mix(in srgb, var(--c-brand) 35%, transparent);
      background: color-mix(in srgb, var(--c-brand) 10%, transparent);
      border-radius: 4px;
      padding: 2px 7px;
    }

    .ec-confidence {
      font-size: 9px;
      color: var(--c-text-5);
      letter-spacing: .06em;
    }

    .ec-body {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .ec-question {
      font-size: 1rem;
      font-weight: 700;
      color: var(--c-text-2);
      line-height: 1.4;
      font-family: var(--font-sans);
    }

    .ec-basis {
      font-size: 9px;
      color: var(--c-text-5);
      line-height: 1.5;
    }

    /* ── Options ── */
    .ec-options {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .ec-option {
      width: 100%;
      padding: 10px 14px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 11px;
      font-weight: 700;
      text-align: left;
      letter-spacing: .04em;
      font-family: var(--font-mono);
      color: var(--c-text-3);
      border: 1px solid var(--c-border-1);
      background: var(--c-bg-deep);
      transition: border-color .15s, background .15s, color .15s;
    }
    .ec-option:hover {
      border-color: color-mix(in srgb, var(--c-brand) 50%, transparent);
      background: color-mix(in srgb, var(--c-brand) 8%, transparent);
      color: var(--c-brand);
    }
    .ec-option:active { transform: scale(0.99); }

    /* ── Results ── */
    .ec-results {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .ec-result-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .ec-result-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--c-text-3);
      flex: 1;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .ec-result-track {
      width: 120px;
      flex-shrink: 0;
      height: 20px;
      border-radius: 4px;
      overflow: hidden;
      background: color-mix(in srgb, var(--c-border-1) 80%, var(--c-bg-deep));
    }

    .ec-result-bar {
      height: 100%;
      border-radius: 4px;
      background: var(--c-brand);
      opacity: .8;
      transition: width .6s cubic-bezier(.4,0,.2,1);
    }

    .ec-result-row:nth-child(2) .ec-result-bar { background: var(--c-live); }
    .ec-result-row:nth-child(3) .ec-result-bar { background: var(--c-alert); }
    .ec-result-row:nth-child(4) .ec-result-bar { background: var(--c-economy); }

    .ec-result-pct {
      font-size: 11px;
      font-weight: 900;
      color: var(--c-text-3);
      width: 38px;
      text-align: right;
      flex-shrink: 0;
    }

    .ec-vote-count {
      font-size: 9px;
      color: var(--c-text-5);
      text-align: right;
      margin-top: 4px;
    }

    .ec-voted-note {
      font-size: 9px;
      color: var(--c-live);
      letter-spacing: .06em;
      margin-bottom: 4px;
    }

    /* ── Footer ── */
    .ec-footer {
      padding: 8px 16px;
      border-top: 1px solid var(--c-border-1);
      background: var(--c-card);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .ec-footer-label {
      font-size: 9px;
      color: var(--c-text-5);
      text-transform: uppercase;
      letter-spacing: .12em;
      transition: color .15s;
    }
    .ec-footer-label:hover { color: #f59e0b; }

    .ec-full-link {
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--c-brand);
      text-decoration: none;
      border: 1px solid color-mix(in srgb, var(--c-brand) 35%, transparent);
      border-radius: 4px;
      padding: 3px 8px;
      transition: background .15s;
    }
    .ec-full-link:hover {
      background: color-mix(in srgb, var(--c-brand) 12%, transparent);
    }

    .hidden { display: none !important; }
  </style>
</head>
<body>

<div class="ec-card">

  <!-- Header -->
  <div class="ec-header">
    <span class="ec-game-pill">GTA VI</span>
    <span class="ec-badge">Community Vote</span>
    {confidence !== null && (
      <span class="ec-confidence">{confidence}% confidence</span>
    )}
  </div>

  <!-- Body -->
  <div class="ec-body">
    <div class="ec-question">{question}</div>

    {basis && (
      <div class="ec-basis">{basis.length > 160 ? basis.slice(0, 160) + "…" : basis}</div>
    )}

    <!-- Vote options -->
    <div
      class="ec-options"
      data-poll-id={pollId}
      data-options={JSON.stringify(options)}
      data-poll-url={pollUrl}
    >
      {options.map((opt, i) => (
        <button class="ec-option" data-option={opt} data-index={i}>
          {opt}
        </button>
      ))}
    </div>

    <!-- Results (hidden until vote) -->
    <div class="ec-results hidden" data-poll-id={pollId}>
      <div class="ec-voted-note hidden">✓ You voted</div>
      {options.map(opt => (
        <div class="ec-result-row" data-option={opt}>
          <div class="ec-result-label">{opt}</div>
          <div class="ec-result-track">
            <div class="ec-result-bar" data-option={opt} style="width:0%"></div>
          </div>
          <div class="ec-result-pct" data-option={opt}>—</div>
        </div>
      ))}
      <div class="ec-vote-count"></div>
    </div>
  </div>

  <!-- Footer -->
  <div class="ec-footer">
    <a href="https://gtavi.ai" target="_blank" rel="noopener noreferrer" class="ec-footer-label" style="text-decoration:none">GTAVI.AI · Community</a>
    <a
      href={pollUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="ec-full-link"
    >Full poll →</a>
  </div>

</div>

<script is:inline define:vars={{ pollId, options }}>
  (function () {
    var optionsData  = options;
    var container    = document.querySelector(".ec-options");
    var results      = document.querySelector(".ec-results");
    var votedNote    = results ? results.querySelector(".ec-voted-note") : null;
    var storageKey   = "vote:" + pollId;

    function showResults(votes) {
      var total = Object.values(votes).reduce(function(s, v) { return s + v; }, 0);
      optionsData.forEach(function(opt) {
        var count = votes[opt] || 0;
        var pct   = total > 0 ? Math.round((count / total) * 100) : 0;
        var bar   = results.querySelector('.ec-result-bar[data-option="' + opt + '"]');
        var pctEl = results.querySelector('.ec-result-pct[data-option="' + opt + '"]');
        if (bar)   bar.style.width   = pct + "%";
        if (pctEl) pctEl.textContent = pct + "%";
      });
      var countEl = results.querySelector(".ec-vote-count");
      if (countEl) countEl.textContent = total.toLocaleString() + " vote" + (total !== 1 ? "s" : "");
    }

    function showPlaceholder(chosen) {
      var ph = {};
      optionsData.forEach(function(o) { ph[o] = o === chosen ? 1 : 0; });
      showResults(ph);
    }

    // Restore state if already voted
    var storedVote = null;
    try { storedVote = localStorage.getItem(storageKey); } catch(e) {}

    if (storedVote) {
      if (container) container.classList.add("hidden");
      if (votedNote) votedNote.classList.remove("hidden");
      showPlaceholder(storedVote);
      if (results) results.classList.remove("hidden");
      // Load live counts
      fetch("/api/poll/" + encodeURIComponent(pollId) + "/results")
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(data) { if (data && data.votes) showResults(data.votes); })
        .catch(function() {});
      return;
    }

    // Vote button handlers
    if (container) {
      container.querySelectorAll(".ec-option").forEach(function(btn) {
        btn.addEventListener("click", function() {
          var option = btn.dataset.option;
          try { localStorage.setItem(storageKey, option); } catch(e) {}

          if (container) container.classList.add("hidden");
          if (votedNote) votedNote.classList.remove("hidden");
          showPlaceholder(option);
          if (results) results.classList.remove("hidden");

          fetch("/api/poll/" + encodeURIComponent(pollId) + "/vote", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ option: option }),
          })
          .then(function(r) { return (r.ok || r.status === 409) ? r.json() : null; })
          .then(function(data) { if (data && data.votes) showResults(data.votes); })
          .catch(function() {});

          // Plausible analytics (noop if not loaded in embed context)
          try {
            if (typeof window.plausible === "function") {
              window.plausible("EmbedPollVote", { props: { pollId: pollId, option: option } });
            }
          } catch(e) {}
        });
      });
    }
  })();
</script>

</body>
</html>
