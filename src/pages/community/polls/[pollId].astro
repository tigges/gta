---
/**
 * /community/polls/[pollId] — Individual poll landing page.
 *
 * Every poll gets its own shareable URL:
 *   gtavi.ai/community/polls/pred-launch-price
 *
 * OG image: /og/poll/[pollId].png  (1200×630, generated by satori)
 * Twitter card: summary_large_image
 * Canonical: this URL
 *
 * Used as the "share" destination for VoteCard ShareDropdown links,
 * and as the link-back target from embed iframes.
 */

import Base from "../../../layouts/Base.astro";
import VoteCard from "../../../components/VoteCard.astro";
import GamePill from "../../../components/GamePill.astro";
import type { GetStaticPaths } from "astro";
import type { PredictionsData } from "../../../types/gta";
import predRaw from "../../../../data/gta-6/predictions.json";

export const getStaticPaths: GetStaticPaths = () => {
  const polls = (predRaw as any).predictions.filter((p: any) => p.poll_question);
  return polls.map((p: any) => ({ params: { pollId: p.id } }));
};

const { pollId } = Astro.params;
const predData   = predRaw as unknown as PredictionsData;
const pred       = predData.predictions.find((p: any) => p.id === pollId) as any;

if (!pred) return Astro.redirect("/404");

const SITE_BASE  = import.meta.env.SITE ?? "https://gtavi.ai";
const question   = pred.poll_question as string;
const basis      = pred.basis as string;
const confidence = pred.confidence as number;
const tier       = pred.confidence_tier as string;
const options    = (pred.poll_options ?? ["Yes", "No"]) as string[];
const thumb      = pred.thumbnail as string | undefined;

const ogImageUrl  = `${SITE_BASE}/og/poll/${pollId}.png`;
const embedUrl    = `${SITE_BASE}/community/polls/embed/${pollId}`;
const pollsUrl    = `${SITE_BASE}/community/polls`;
const canonicalUrl = `${SITE_BASE}/community/polls/${pollId}`;

// Pre-built social copy for this poll
const xShareText   = `${question}\n\nVote on GTAVI.AI 👇\n${canonicalUrl}`;
const redditTitle  = `${question} — Community Poll`;
const xIntentUrl   = `https://twitter.com/intent/tweet?text=${encodeURIComponent(xShareText)}`;
const redditUrl    = `https://www.reddit.com/submit?url=${encodeURIComponent(canonicalUrl)}&title=${encodeURIComponent(redditTitle)}`;

const TIER_LABEL: Record<string, string> = {
  confirmed: "Confirmed",
  reported:  "Reported",
  predicted: "Predicted",
};
const TIER_COLOR: Record<string, string> = {
  confirmed: "var(--c-live)",
  reported:  "var(--c-brand)",
  predicted: "var(--c-text-4)",
};
---

<Base
  title={`${question} — Community Poll`}
  description={`Vote: ${options.join(" · ")}. ${basis.slice(0, 120)}…`}
  ogImage={ogImageUrl}
  titleContext="gta-vi"
>
  <!-- ── Breadcrumb ──────────────────────────────────────────────────────── -->
  <div class="border-b border-border-dim" style="background:var(--c-bg-deep)">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-3 flex items-center gap-2 text-[10px] font-mono text-zinc-600">
      <a href="/community/polls" class="hover:text-zinc-300 transition-colors">Community Polls</a>
      <span>/</span>
      <span class="text-zinc-400 truncate">{question}</span>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 flex flex-col gap-8">

    <!-- ── Hero thumbnail ─────────────────────────────────────────────────── -->
    {thumb && (
      <div class="rounded-xl overflow-hidden border border-border-dim relative aspect-[16/6]">
        <img
          src={thumb}
          alt=""
          width="900"
          height="337"
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0" style="background:linear-gradient(to bottom,transparent 50%,var(--c-bg) 100%)"></div>
        <!-- Badge overlay -->
        <div class="absolute bottom-4 left-4 flex items-center gap-2">
          <GamePill game="gta-vi" size="xs" />
          <span class="text-[9px] font-mono px-2 py-0.5 rounded border uppercase tracking-widest font-bold"
            style={`color:${TIER_COLOR[tier]};border-color:color-mix(in srgb,${TIER_COLOR[tier]} 35%,transparent);background:color-mix(in srgb,${TIER_COLOR[tier]} 10%,transparent)`}>
            {TIER_LABEL[tier]} · {confidence}%
          </span>
        </div>
      </div>
    )}

    <!-- ── Vote card ─────────────────────────────────────────────────────── -->
    <VoteCard predictionId={pollId} />

    <!-- ── Share bar ─────────────────────────────────────────────────────── -->
    <div class="rounded-xl border border-border-dim p-4 flex flex-col gap-3" style="background:var(--c-card)">
      <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">Share this poll</div>
      <div class="flex flex-wrap gap-2">
        <a
          href={xIntentUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-[11px] font-mono font-bold px-3 py-1.5 rounded-lg border transition-all"
          style="border-color:color-mix(in srgb,var(--c-text-4) 25%,transparent);color:var(--c-text-3)"
          onmouseover="this.style.borderColor='color-mix(in srgb,var(--c-brand) 40%,transparent)';this.style.color='var(--c-brand)'"
          onmouseout="this.style.borderColor='color-mix(in srgb,var(--c-text-4) 25%,transparent)';this.style.color='var(--c-text-3)'"
        >
          <span>𝕏</span> Tweet
        </a>
        <a
          href={redditUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-[11px] font-mono font-bold px-3 py-1.5 rounded-lg border transition-all"
          style="border-color:color-mix(in srgb,var(--c-text-4) 25%,transparent);color:var(--c-text-3)"
          onmouseover="this.style.borderColor='color-mix(in srgb,var(--c-reddit) 40%,transparent)';this.style.color='var(--c-reddit)'"
          onmouseout="this.style.borderColor='color-mix(in srgb,var(--c-text-4) 25%,transparent)';this.style.color='var(--c-text-3)'"
        >
          Reddit
        </a>
        <button
          id="copy-link-btn"
          data-url={canonicalUrl}
          class="flex items-center gap-1.5 text-[11px] font-mono font-bold px-3 py-1.5 rounded-lg border transition-all"
          style="border-color:color-mix(in srgb,var(--c-text-4) 25%,transparent);color:var(--c-text-3);cursor:pointer;background:transparent"
        >
          Copy link
        </button>
      </div>
      <!-- Embed snippet -->
      <details class="group">
        <summary class="text-[10px] font-mono text-zinc-600 hover:text-zinc-400 cursor-pointer transition-colors select-none">
          Embed this poll on your site ▸
        </summary>
        <pre class="mt-2 rounded-lg px-3 py-2.5 text-[10px] font-mono text-zinc-400 overflow-x-auto leading-relaxed" style="background:var(--c-bg-deep);border:1px solid var(--c-border-1)">&lt;iframe
  src="{embedUrl}"
  width="420" height="380"
  style="border:none;border-radius:12px;overflow:hidden"
  title="GTA VI Poll"
  loading="lazy"
&gt;&lt;/iframe&gt;</pre>
      </details>
    </div>

    <!-- ── Prediction basis ──────────────────────────────────────────────── -->
    <div class="rounded-xl border border-border-dim p-5" style="background:var(--c-card)">
      <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-3">Why this poll</div>
      <p class="text-[13px] text-zinc-400 leading-relaxed">{basis}</p>
      {pred.prediction_range && (
        <div class="mt-4 flex gap-6 flex-wrap">
          <div>
            <div class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Low scenario</div>
            <div class="text-[11px] font-mono text-zinc-300">{pred.prediction_range.low}</div>
          </div>
          <div>
            <div class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest mb-1">High scenario</div>
            <div class="text-[11px] font-mono text-zinc-300">{pred.prediction_range.high}</div>
          </div>
        </div>
      )}
    </div>

    <!-- ── Back nav ──────────────────────────────────────────────────────── -->
    <div class="flex items-center justify-between text-[11px] font-mono text-zinc-600">
      <a href="/community/polls" class="hover:text-zinc-200 transition-colors">← All polls</a>
      <a href="/gta-vi/intel" class="hover:text-zinc-200 transition-colors">Full predictions →</a>
    </div>
  </div>
</Base>

<script>
  const btn = document.getElementById("copy-link-btn");
  btn?.addEventListener("click", async () => {
    const url = (btn as HTMLElement).dataset.url!;
    try {
      await navigator.clipboard.writeText(url);
      btn.textContent = "Copied ✓";
      setTimeout(() => { btn.textContent = "Copy link"; }, 2000);
    } catch {
      btn.textContent = url;
    }
  });
</script>
