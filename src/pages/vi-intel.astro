---
import Base from "../layouts/Base.astro";
import PredictionCard from "../components/PredictionCard.astro";
import ReleaseTimeline from "../components/ReleaseTimeline.astro";
import Countdown from "../components/Countdown.astro";

import type { TrailersData, Prediction } from "../types/gta";

import predictionsData from "../../data/gta-6/predictions.json";
import trailersDataRaw from "../../data/gta-6/trailers.json";
import releaseData     from "../../data/shared/releases.json";
import gta6Trends      from "../../data/gta-6/trends/search-interest.json";
import featuresData    from "../../data/gta-6/features.json";
import delayData       from "../../data/gta-6/delay-timeline.json";
import trailerAnalysis from "../../data/gta-6/trailer-analysis.json";

const predictions    = predictionsData.predictions as Prediction[];
const trailersData   = trailersDataRaw as TrailersData;
const trailers       = trailersData.trailers;
const heroTrailer    = trailers[1] ?? trailers[0]; // prefer Trailer 2 for hero
const trendsSince    = gta6Trends.keywords[0]?.data[0]?.date?.slice(0, 4) ?? "2020";
const trendsUntil    = gta6Trends.keywords[0]?.data.at(-1)?.date?.slice(0, 4) ?? "2026";
const totalTrendPts  = gta6Trends.keywords.reduce((s: number, k: any) => s + k.data.length, 0);
const analysisTrailers = ((trailerAnalysis as any).trailers as any[]).map((trailer: any) => {
  const byType: Record<string,number> = {};
  for (const e of trailer.events) byType[e.type] = (byType[e.type] ?? 0) + 1;
  const confirmedCount: number = trailer.events.filter((e: any) => e.confidence === "confirmed").length;
  return { ...trailer, byType, confirmedCount };
});
---

<Base
  title="GTA VI"
  description="Data-extrapolated predictions for GTA VI — release window, pricing, map size and vehicle count based on 30 years of GTA history."
  ogImage={heroTrailer ? `https://img.youtube.com/vi/${heroTrailer.youtube_id}/maxresdefault.jpg` : undefined}
>

  <!-- ═══════════════════════════════════════════════════════
       HERO — Trailer 1 thumbnail (wider Leonida landscape)
  ═══════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden border-b border-[#1e1e23]" style="min-height:400px;display:flex;align-items:flex-end">
    <div class="absolute inset-0">
      <img
        src="https://img.youtube.com/vi/QdBZY2fkU-0/maxresdefault.jpg"
        alt="Grand Theft Auto VI — Trailer 1"
        class="w-full h-full object-cover"
        style="object-position:center 30%"
        loading="eager"
      />
      <div class="absolute inset-0" style="background:linear-gradient(to top, #0e0e11 0%, #0e0e1190 45%, transparent 80%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to right, #0e0e11 0%, #0e0e1150 40%, transparent 70%)"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pb-12 pt-20 w-full">
      <div class="flex items-start justify-between flex-wrap gap-6">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[9px] font-mono bg-gta-gold/10 text-gta-gold border border-gta-gold/20 px-2 py-0.5 rounded uppercase tracking-widest">Community estimates · not official</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2" style="font-family:'Inter',sans-serif">
            Grand Theft Auto VI
          </h1>
          <p class="text-zinc-400 text-sm max-w-md leading-relaxed" style="font-family:'Inter',sans-serif">
            30 years of GTA data, distilled into confidence-scored predictions.
            Every number is derived from signal evidence — not speculation.
          </p>
        </div>
        <!-- Compact countdown -->
        <div class="self-end pb-1">
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-2">Time to launch</div>
          <Countdown variant="hero" />
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-14">

    <!-- ═══════════════════════════════════════════════════════
         SIGNAL PREDICTIONS
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Signal Predictions</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">confidence-scored · data-derived</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {predictions.map((p) => (
          <PredictionCard
            title={p.title}
            value={p.value}
            confidence={p.confidence}
            confidence_tier={p.confidence_tier}
            basis={p.basis}
            unit={p.unit}
            trailer_timestamp={p.trailer_timestamp}
            prediction_method={p.prediction_method}
            prediction_range={p.prediction_range}
            source={p.source}
            source_type={p.source_type}
            outcome_verified={p.outcome_verified}
            outcome_actual={p.outcome_actual}
          />
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         OFFICIAL TRAILERS
    ═══════════════════════════════════════════════════════ -->
    {trailers.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-7">
          <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Official Trailers</span>
          <div class="flex-1 h-px bg-[#1e1e23]"></div>
          <span class="text-[10px] font-mono text-zinc-700">{trailers.length} released · Rockstar Games</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {trailers.map((t: any, i: number) => (
            <a
              href={`https://www.youtube.com/watch?v=${t.youtube_id}`}
              target="_blank" rel="noopener noreferrer"
              class="group relative overflow-hidden rounded-xl border border-[#1e1e23] hover:border-gta-gold/30 transition-all duration-200"
            >
              <div class="relative aspect-video overflow-hidden">
                <img
                  src={`https://img.youtube.com/vi/${t.youtube_id}/maxresdefault.jpg`}
                  alt={t.title ?? `GTA VI Trailer ${i + 1}`}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0" style="background:linear-gradient(to top, #0e0e11 0%, transparent 55%)"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-12 h-12 rounded-full bg-black/60 border border-white/20 flex items-center justify-center group-hover:bg-gta-gold/20 group-hover:border-gta-gold/40 transition-all">
                    <span class="text-white ml-0.5">▶</span>
                  </div>
                </div>
                <div class="absolute top-3 left-3">
                  <span class="text-[9px] font-mono bg-black/60 text-gta-gold border border-gta-gold/20 px-2 py-0.5 rounded uppercase tracking-widest">Official</span>
                </div>
              </div>
              <div class="px-4 py-3 flex items-center justify-between" style="background:#131316">
                <div>
                  <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">{t.title ?? `Grand Theft Auto VI — Trailer ${i + 1}`}</div>
                  {t.published_at && (
                    <div class="text-[11px] text-zinc-600 font-mono mt-0.5">{t.published_at}</div>
                  )}
                </div>
                <span class="text-zinc-600 group-hover:text-gta-gold transition-colors font-mono text-xs">↗</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ═══════════════════════════════════════════════════════
         TRAILER ANALYSIS
    ═══════════════════════════════════════════════════════ -->
    {analysisTrailers.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-7">
          <span class="w-2 h-2 rounded-full bg-gta-gold shrink-0"></span>
          <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Trailer Entity Analysis</span>
          <div class="flex-1 h-px bg-[#1e1e23]"></div>
          <span class="text-[10px] font-mono text-zinc-700">Frame-by-frame · {analysisTrailers.reduce((s: number, t: any) => s + t.total_entities, 0)} reveals across {analysisTrailers.length} trailers</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {analysisTrailers.map((trailer: any) => {
            const { byType, confirmedCount } = trailer;
            return (
              <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
                <!-- Trailer header -->
                <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between gap-3 flex-wrap">
                  <div>
                    <div class="text-sm font-semibold text-zinc-200 mb-0.5" style="font-family:'Inter',sans-serif">{trailer.title}</div>
                    <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-600">
                      <span>{trailer.published_at}</span>
                      <span class="text-zinc-800">·</span>
                      <span>{Math.floor(trailer.duration_sec / 60)}:{String(trailer.duration_sec % 60).padStart(2,"0")} runtime</span>
                      <span class="text-zinc-800">·</span>
                      <span>{trailer.total_entities} entities</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="text-[8px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest bg-gta-gold/10 border-gta-gold/20 text-gta-gold">
                      {confirmedCount} confirmed
                    </span>
                    <a
                      href={`https://www.youtube.com/watch?v=${trailer.youtube_id}`}
                      target="_blank" rel="noopener noreferrer"
                      class="text-[10px] font-mono text-zinc-600 hover:text-gta-gold transition-colors"
                    >↗ Watch</a>
                  </div>
                </div>

                <!-- Type breakdown -->
                <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-4 flex-wrap">
                  {Object.entries(byType).map(([type, count]: [string, any]) => (
                    <div class="flex items-center gap-1.5">
                      <span class="text-[10px]">
                        {type === "vehicle" ? "🚗" : type === "character" ? "👤" : type === "location" ? "📍" : type === "weapon" ? "🔫" : type === "wildlife" ? "🐊" : type === "audio" ? "🎵" : type === "reveal" ? "⭐" : "•"}
                      </span>
                      <span class="text-[10px] font-mono text-zinc-500">{count} {type}</span>
                    </div>
                  ))}
                </div>

                <!-- Event timeline -->
                <div class="divide-y divide-[#1e1e23]">
                  {(trailer.events as any[]).map((event: any) => {
                    const confColor = event.confidence === "confirmed"
                      ? "text-gta-gold border-gta-gold/20 bg-gta-gold/10"
                      : "text-zinc-500 border-zinc-800 bg-zinc-900/50";
                    const typeIcon = event.type === "vehicle" ? "🚗"
                      : event.type === "character" ? "👤"
                      : event.type === "location" ? "📍"
                      : event.type === "weapon" ? "🔫"
                      : event.type === "wildlife" ? "🐊"
                      : event.type === "audio" ? "🎵"
                      : event.type === "reveal" ? "⭐" : "•";
                    const mins = Math.floor(event.t / 60);
                    const secs = String(event.t % 60).padStart(2, "0");
                    return (
                      <div class="px-5 py-2.5 flex items-start gap-3">
                        <span class="text-[10px] font-mono text-zinc-700 shrink-0 w-10">{mins}:{secs}</span>
                        <span class="text-base shrink-0">{typeIcon}</span>
                        <div class="flex-1 min-w-0">
                          <div class="text-[11px] font-semibold text-zinc-300 leading-snug" style="font-family:'Inter',sans-serif">{event.entity}</div>
                          {event.note && (
                            <div class="text-[10px] text-zinc-600 mt-0.5 leading-relaxed">{event.note}</div>
                          )}
                        </div>
                        <span class={`shrink-0 text-[8px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${confColor}`}>
                          {event.confidence}
                        </span>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- ═══════════════════════════════════════════════════════
         CONFIRMED FEATURE TRACKER
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="w-2 h-2 rounded-full bg-gta-teal shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI Confirmed Feature Tracker</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">Rockstar official + community tracking</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">
              What's confirmed, reported and indexed so far
            </div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Progress toward estimated full-game totals · {featuresData.categories.reduce((s, c) => s + c.confirmed + c.reported, 0)} entries tracked</div>
          </div>
          <div class="flex items-center gap-4 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-gta-gold inline-block"></span>Confirmed</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-zinc-500 inline-block"></span>Reported</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-zinc-800 border border-zinc-700 inline-block"></span>Target</span>
          </div>
        </div>
        <div class="divide-y divide-[#1e1e23]">
          {featuresData.categories.map((cat) => {
            const total = cat.confirmed + cat.reported + cat.indexed;
            const confirmedPct = Math.round((cat.confirmed / cat.target) * 100);
            const reportedPct  = Math.round((cat.reported / cat.target) * 100);
            const indexedPct   = Math.round((cat.indexed / cat.target) * 100);
            return (
              <div class="px-5 py-4">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <span class="text-base">{cat.icon}</span>
                    <span class="text-sm font-semibold text-zinc-200" style="font-family:'Inter',sans-serif">{cat.label}</span>
                  </div>
                  <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-600">
                    <span class="text-gta-gold">{cat.confirmed} confirmed</span>
                    <span>{cat.reported} reported</span>
                    <span class="text-zinc-700">/ {cat.target} target</span>
                  </div>
                </div>
                <!-- Stacked progress bar -->
                <div class="h-2 rounded-full overflow-hidden flex gap-0.5" style="background:#1e1e23">
                  {confirmedPct > 0 && (
                    <div class="h-full rounded-l bg-gta-gold" style={`width:${confirmedPct}%`} title={`${cat.confirmed} confirmed`}></div>
                  )}
                  {reportedPct > 0 && (
                    <div class="h-full bg-zinc-500" style={`width:${reportedPct}%`} title={`${cat.reported} reported`}></div>
                  )}
                  {indexedPct > 0 && (
                    <div class="h-full bg-zinc-700" style={`width:${indexedPct}%`} title={`${cat.indexed} indexed`}></div>
                  )}
                </div>
                {cat.notes && (
                  <p class="text-[10px] text-zinc-700 mt-1.5 leading-snug" style="font-family:'Inter',sans-serif">{cat.notes}</p>
                )}
              </div>
            );
          })}
        </div>
        <div class="px-5 py-3 border-t border-[#1e1e23]">
          <span class="text-[10px] text-zinc-700 font-mono">Sources: {featuresData.source}</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         DELAY TIMELINE
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="w-2 h-2 rounded-full bg-gta-red shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Development + Delay Timeline</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{delayData.total_delays} delay · {delayData.timeline.length} events · SEC EDGAR sourced</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="relative p-5">
          <div class="absolute left-[120px] top-5 bottom-5 w-px bg-[#1e1e23]"></div>
          <div class="flex flex-col gap-0">
            {(() => {
              const typeColors: {[k:string]:string} = {
                milestone: "text-zinc-500", development: "text-zinc-400",
                leak: "text-gta-red", trailer: "text-gta-gold",
                date_set: "text-gta-teal", delay: "text-gta-red",
                date_confirmed: "text-gta-teal",
              };
              const dotColors: {[k:string]:string} = {
                trailer: "bg-gta-gold border-gta-gold",
                delay: "bg-gta-red/20 border-gta-red",
                date_confirmed: "bg-gta-teal/20 border-gta-teal",
                date_set: "bg-gta-teal/10 border-gta-teal/50",
                default: "bg-[#131316] border-[#2a2a31]",
              };
              return (delayData.timeline as any[]).map((event) => {
              const dotClass = dotColors[event.type] ?? dotColors["default"];
              const textClass = typeColors[event.type] ?? "text-zinc-400";
              return (
                <div class="relative flex items-start gap-4 pb-6 last:pb-0">
                  <div class="w-24 shrink-0 text-right pt-0.5">
                    <span class="text-[10px] font-mono text-zinc-600">{event.date.slice(0,7)}</span>
                  </div>
                  <div class={`relative z-10 mt-1 shrink-0 w-2.5 h-2.5 rounded-full border ${dotClass}`}></div>
                  <div class="flex-1 min-w-0">
                    <p class={`text-[12px] font-medium leading-snug ${textClass}`} style="font-family:'Inter',sans-serif">{event.event}</p>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-[9px] font-mono text-zinc-700 uppercase tracking-widest">{event.type.replace("_"," ")}</span>
                      <span class="text-zinc-800">·</span>
                      <span class="text-[9px] font-mono text-zinc-700">{event.source}</span>
                    </div>
                  </div>
                </div>
              );
            });
            })()}
          </div>
        </div>
        <div class="px-5 py-3 border-t border-[#1e1e23]">
          <span class="text-[10px] text-zinc-700 font-mono">Sources: SEC EDGAR Take-Two 8-K filings + official announcements</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         GTA VI SEARCH TRENDS
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI Search Signal</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{totalTrendPts} pts · {trendsSince}–{trendsUntil} · worldwide</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">GTA VI Search Interest Over Time</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Google Trends · worldwide · 0–100 scale</div>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            {gta6Trends.keywords.map((kw) => (
              <button
                class="gta6-trend-toggle flex items-center gap-1.5 text-[11px] font-mono text-zinc-400 hover:text-zinc-200 transition-colors"
                data-keyword={kw.keyword}
                data-active="true"
              >
                <span class="w-2.5 h-0.5 rounded inline-block" style={`background:${kw.color}`}></span>
                {kw.keyword}
              </button>
            ))}
          </div>
        </div>
        <div id="gta6-trends-chart" class="w-full h-64 px-4 py-2" data-keywords={JSON.stringify(gta6Trends.keywords)}></div>
        <div class="px-5 py-3 border-t border-[#1e1e23]">
          <span class="text-[10px] text-zinc-700 font-mono">Source: Google Trends via pytrends · updated {new Date(gta6Trends.last_updated).toLocaleDateString("en-GB", { month: "short", year: "numeric" })}</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         HISTORICAL CONTEXT
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Historical Context</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">gap trend extrapolated to VI</span>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <ReleaseTimeline />
        <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
          <div class="px-5 py-4 border-b border-[#1e1e23]">
            <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em]">// Cross-Generation Growth</div>
          </div>
          <table class="w-full text-xs font-mono">
            <thead>
              <tr class="border-b border-[#1e1e23]">
                <th class="text-left px-5 py-2.5 text-zinc-600 font-normal">Title</th>
                <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">Price</th>
                <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">Map km²</th>
                <th class="text-right px-5 py-2.5 text-zinc-600 font-normal">Vehicles</th>
              </tr>
            </thead>
            <tbody>
              {releaseData.games.map((g) => {
                const isPred = g.is_prediction;
                const price    = g.price_usd_launch ?? (g as any).price_usd_estimate;
                const map      = g.map_size_km2 ?? (g as any).map_size_km2_estimate;
                const vehicles = g.vehicle_count ?? (g as any).vehicle_count_estimate;
                return (
                  <tr class={`border-b border-[#1e1e23]/50 hover:bg-white/2 transition-colors ${isPred ? "text-gta-gold" : "text-zinc-300"}`}>
                    <td class="px-5 py-2.5 font-semibold">
                      {g.short}
                      {isPred && <span class="ml-1.5 text-[9px] bg-gta-gold/10 text-gta-gold/70 border border-gta-gold/15 px-1 py-0.5 rounded uppercase tracking-widest align-middle">est</span>}
                    </td>
                    <td class="px-4 py-2.5 text-right">{price ? `$${price.toFixed(0)}` : <span class="text-zinc-700">—</span>}</td>
                    <td class="px-4 py-2.5 text-right">{map ?? <span class="text-zinc-700">—</span>}</td>
                    <td class="px-5 py-2.5 text-right">{vehicles ?? <span class="text-zinc-700">—</span>}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <div class="px-5 py-3 border-t border-[#1e1e23]">
            <span class="text-[10px] text-zinc-700 font-mono">est = estimated · Rockstar, Broughy1322, community records</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         METHODOLOGY
    ═══════════════════════════════════════════════════════ -->
    <section class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
      <div class="px-5 py-4 border-b border-[#1e1e23]">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em]">// Methodology & Signal Standards</div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-[#1e1e23]">
        {[
          {
            label: "Confidence scoring",
            body: "Confidence reflects how many independent signals agree. 80%+ = multiple corroborating data sources. Below 50% = trailer evidence only or high-variance extrapolation.",
          },
          {
            label: "Data sources",
            body: "Release dates from Rockstar announcements. Pricing from CPI-adjusted history. Map and vehicle estimates from trailer analysis and community research.",
            link: { href: "/gta-v", text: "GTA V signal data →" },
          },
          {
            label: "Not official",
            body: "All predictions are community-derived. GTA VI.AI has no affiliation with Rockstar Games or Take-Two Interactive. Treat every prediction as informed speculation.",
          },
        ].map(m => (
          <div class="px-5 py-5">
            <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-2">{m.label}</div>
            <p class="text-xs text-zinc-500 leading-relaxed" style="font-family:'Inter',sans-serif">{m.body}</p>
            {m.link && (
              <a href={m.link.href} class="mt-2 inline-block text-[10px] font-mono text-gta-gold/60 hover:text-gta-gold transition-colors tracking-widest">{m.link.text}</a>
            )}
          </div>
        ))}
      </div>
    </section>

  </div>
</Base>

<script>
  import * as d3 from "d3";

  document.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById("gta6-trends-chart");
    if (!el) return;

    const keywords: { keyword: string; color: string; data: { date: string; value: number }[] }[] =
      JSON.parse(el.dataset.keywords || "[]");

    const allSeries = keywords.map((kw) => ({
      ...kw,
      data: kw.data.map((d) => ({ date: new Date(d.date), value: d.value })),
    }));

    const margin = { top: 10, right: 16, bottom: 28, left: 36 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg")
      .attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g")
      .attr("transform", `translate(${margin.left},${margin.top})`);

    const allDates = allSeries.flatMap((s) => s.data.map((d) => d.date));
    const x = d3.scaleTime().domain(d3.extent(allDates) as [Date, Date]).range([0, W]);
    const y = d3.scaleLinear().domain([0, 100]).range([H, 0]);

    svg.append("g")
      .call(d3.axisLeft(y).ticks(4).tickSize(-W).tickFormat(() => ""))
      .call((g) => g.select(".domain").remove())
      .call((g) => g.selectAll(".tick line").attr("stroke", "#1e1e23").attr("stroke-dasharray", "3,3"));

    const lineGen = d3.line<{ date: Date; value: number }>()
      .x((d) => x(d.date)).y((d) => y(d.value)).curve(d3.curveMonotoneX);

    const paths: Record<string, any> = {};
    allSeries.forEach((kw) => {
      paths[kw.keyword] = svg.append("path")
        .datum(kw.data).attr("fill", "none").attr("stroke", kw.color)
        .attr("stroke-width", 1.5).attr("opacity", 0.9).attr("d", lineGen as any);
    });

    // Trailer annotations
    [
      { date: new Date("2023-12-04"), label: "T1" },
      { date: new Date("2025-05-06"), label: "T2" },
    ].forEach(({ date, label }) => {
      svg.append("line")
        .attr("x1", x(date)).attr("x2", x(date)).attr("y1", 0).attr("y2", H)
        .attr("stroke", "#ef4444").attr("stroke-width", 1).attr("stroke-dasharray", "3,3").attr("opacity", 0.4);
      svg.append("text")
        .attr("x", x(date) + 4).attr("y", 10)
        .attr("fill", "#ef4444").attr("font-size", "9").attr("font-family", "monospace").text(label);
    });

    svg.append("g").attr("transform", `translate(0,${H})`)
      .call(d3.axisBottom(x).ticks(5).tickFormat(d3.timeFormat("%Y") as any))
      .call((g) => g.select(".domain").attr("stroke", "#2a2a31"))
      .call((g) => g.selectAll(".tick line").attr("stroke", "#2a2a31"))
      .call((g) => g.selectAll("text").attr("fill", "#52525b").attr("font-size", "10").attr("font-family", "monospace"));

    svg.append("g").call(d3.axisLeft(y).ticks(4))
      .call((g) => g.select(".domain").attr("stroke", "#2a2a31"))
      .call((g) => g.selectAll(".tick line").attr("stroke", "#2a2a31"))
      .call((g) => g.selectAll("text").attr("fill", "#52525b").attr("font-size", "10").attr("font-family", "monospace"));

    document.querySelectorAll<HTMLButtonElement>(".gta6-trend-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const kw = btn.dataset.keyword!;
        const active = btn.dataset.active === "true";
        btn.dataset.active = active ? "false" : "true";
        btn.style.opacity = active ? "0.3" : "1";
        paths[kw]?.attr("opacity", active ? 0 : 0.9);
      });
    });
  });
</script>
