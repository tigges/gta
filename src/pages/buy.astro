---
import Base from "../layouts/Base.astro";
import Countdown from "../components/Countdown.astro";

const LAUNCH_DATE = "2026-11-19";
const LAUNCH_DISPLAY = "November 19, 2026";

// ── Platforms ─────────────────────────────────────────────────────────────
const PLATFORMS = [
  {
    id:        "ps5",
    name:      "PlayStation 5",
    short:     "PS5",
    confirmed: true,
    official_url: "https://www.playstation.com/en-us/games/grand-theft-auto-vi/",
    store:     "PlayStation Store",
    color:     "text-blue-400",
    border:    "border-blue-500/30",
    bg:        "bg-blue-500/5",
    dot:       "bg-blue-400",
  },
  {
    id:        "xbox",
    name:      "Xbox Series X|S",
    short:     "Xbox",
    confirmed: true,
    official_url: "https://www.xbox.com/en-US/games/store/grand-theft-auto-vi/9nl3wwnzlzzn",
    store:     "Xbox Store",
    color:     "text-green-400",
    border:    "border-green-500/30",
    bg:        "bg-green-500/5",
    dot:       "bg-green-400",
  },
  {
    id:        "pc",
    name:      "PC (Steam / Epic)",
    short:     "PC",
    confirmed: false,
    official_url: null,
    store:     "Steam · Epic Games",
    color:     "text-zinc-500",
    border:    "border-zinc-700/40",
    bg:        "bg-zinc-800/20",
    dot:       "bg-zinc-600",
  },
] as const;

// ── Editions ──────────────────────────────────────────────────────────────
const EDITIONS = [
  {
    id:         "standard",
    name:       "Standard Edition",
    price_usd:  79.99,
    confirmed:  false,
    tier:       "SPECULATIVE",
    tier_color: "text-zinc-400",
    tier_bg:    "bg-zinc-800/60 border-zinc-700",
    platforms:  ["PS5","Xbox"],
    highlight:  false,
    includes: [
      "Base game — Grand Theft Auto VI",
      "Access to GTA Online successor at launch",
    ],
    preorder_bonus: [
      "Speculated: small GTA Online cash bonus (GTA V precedent)",
    ],
    basis: "Industry standard entry-point. Consistent with GTA V at $59.99 adjusted for 2026 pricing.",
  },
  {
    id:         "special",
    name:       "Special Edition",
    price_usd:  89.99,
    confirmed:  false,
    tier:       "SPECULATIVE",
    tier_color: "text-zinc-400",
    tier_bg:    "bg-zinc-800/60 border-zinc-700",
    platforms:  ["PS5","Xbox"],
    highlight:  false,
    includes: [
      "Base game",
      "Speculated: Story Mode cash bonus",
      "Speculated: exclusive weapon skin set",
      "Speculated: exclusive outfit for Lucia or Jason",
    ],
    preorder_bonus: [
      "Speculated: early-access cosmetic weapon or vehicle",
    ],
    basis: "Mirrors RDR2 Special Edition. Standard premium $10 step.",
  },
  {
    id:         "digital-deluxe",
    name:       "Digital Deluxe",
    price_usd:  99.99,
    confirmed:  false,
    tier:       "SPECULATIVE",
    tier_color: "text-amber-400",
    tier_bg:    "bg-amber-900/20 border-amber-700/30",
    platforms:  ["PS5","Xbox","PC"],
    highlight:  true,
    includes: [
      "Base game",
      "Speculated: Story Mode bonus cash + weapons package",
      "Speculated: GTA Online successor starter pack",
      "Speculated: digital soundtrack sampler",
      "Speculated: digital artbook",
    ],
    preorder_bonus: [
      "Speculated: early access to one GTA Online activity",
    ],
    basis: "Digital-only premium tier. $20 step over Standard, mirrors RDR2 Digital Deluxe.",
  },
  {
    id:         "ultimate",
    name:       "Ultimate Edition",
    price_usd:  109.99,
    confirmed:  false,
    tier:       "SPECULATIVE",
    tier_color: "text-amber-400",
    tier_bg:    "bg-amber-900/20 border-amber-700/30",
    platforms:  ["PS5","Xbox","PC"],
    highlight:  false,
    includes: [
      "Base game",
      "Speculated: full Story Mode bonus package",
      "Speculated: GTA Online successor premium starter pack",
      "Speculated: exclusive vehicle set (2–3 cars)",
      "Speculated: outfit set — both protagonists",
    ],
    preorder_bonus: [
      "Speculated: top-tier pre-order bundle",
    ],
    basis: "Top digital tier. Mirrors RDR2 Ultimate. Primarily for Online launch-week players.",
  },
  {
    id:         "collectors",
    name:       "Collector's Box",
    price_usd:  149.99,
    confirmed:  false,
    tier:       "SPECULATIVE",
    tier_color: "text-zinc-400",
    tier_bg:    "bg-zinc-800/60 border-zinc-700",
    platforms:  ["PS5","Xbox"],
    highlight:  false,
    physical:   true,
    includes: [
      "Physical collector's box (no game disc — per RDR2 precedent)",
      "Game purchased separately or redeemed via code",
      "Speculated: Leonida state map (physical print)",
      "Speculated: Vice City challenge coin",
      "Speculated: enamel pin set",
      "Speculated: lithograph art print set",
      "Speculated: sticker / patch pack",
    ],
    preorder_bonus: [
      "Limited allocation — early pre-order recommended",
    ],
    basis: "Follows exact RDR2 Collector's Box format. Physical-only, limited run.",
  },
] as const;

// ── Retailers ─────────────────────────────────────────────────────────────
const RETAILERS = [
  {
    name:       "PlayStation Store",
    platform:   "PS5",
    type:       "Digital · Official",
    status:     "Wishlist live",
    url:        "https://www.playstation.com/en-us/games/grand-theft-auto-vi/",
    affiliate:  false,
    color:      "text-blue-400",
    border:     "border-blue-500/20",
  },
  {
    name:       "Xbox Store",
    platform:   "Xbox",
    type:       "Digital · Official",
    status:     "Wishlist live",
    url:        "https://www.xbox.com/en-US/games/store/grand-theft-auto-vi/9nl3wwnzlzzn",
    affiliate:  false,
    color:      "text-green-400",
    border:     "border-green-500/20",
  },
  {
    name:       "Amazon",
    platform:   "PS5 · Xbox",
    type:       "Physical · Retailer",
    status:     "Pre-orders imminent",
    url:        "https://www.amazon.com/s?k=Grand+Theft+Auto+VI",
    affiliate:  true,
    color:      "text-amber-400",
    border:     "border-amber-500/20",
  },
  {
    name:       "Best Buy",
    platform:   "PS5 · Xbox",
    type:       "Physical · Retailer",
    status:     "Pre-orders imminent",
    url:        "https://www.bestbuy.com/site/searchpage.jsp?st=grand+theft+auto+vi",
    affiliate:  true,
    color:      "text-yellow-400",
    border:     "border-yellow-500/20",
  },
  {
    name:       "GameStop",
    platform:   "PS5 · Xbox",
    type:       "Physical · Retailer",
    status:     "Check for listings",
    url:        "https://www.gamestop.com/search/#q=grand%20theft%20auto%20vi&t=productType%3Agame",
    affiliate:  true,
    color:      "text-red-400",
    border:     "border-red-500/20",
  },
  {
    name:       "Walmart",
    platform:   "PS5 · Xbox",
    type:       "Physical · Retailer",
    status:     "Check for listings",
    url:        "https://www.walmart.com/search?q=grand+theft+auto+vi",
    affiliate:  true,
    color:      "text-blue-300",
    border:     "border-blue-400/20",
  },
] as const;
---

<Base
  title="Buy"
  description="GTA VI launch editions, platform availability, and where to pre-order — PS5, Xbox Series X, and PC. Confirmed platforms, speculative edition breakdown based on Rockstar precedent."
  ogImage="/assets/gta6/characters/Lucia_Caminos_01.jpg"
>

  <!-- ══════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden border-b border-[#1e1e23]" style="min-height:420px;display:flex;align-items:flex-end">

    <!-- Character backdrop: Lucia left, Jason right -->
    <div class="absolute inset-0 flex">
      <div class="flex-1 relative overflow-hidden">
        <img src="/assets/gta6/characters/Lucia_Caminos_04.jpg" alt="Lucia Caminos"
          class="w-full h-full object-cover object-top" loading="eager" />
        <div class="absolute inset-0" style="background:linear-gradient(to right,#0e0e11 0%,transparent 40%,transparent 60%,#0e0e11 100%)"></div>
      </div>
      <div class="flex-1 relative overflow-hidden">
        <img src="/assets/gta6/characters/Jason_Duval_05.jpg" alt="Jason Duval"
          class="w-full h-full object-cover object-top" loading="eager" />
        <div class="absolute inset-0" style="background:linear-gradient(to left,#0e0e11 0%,transparent 40%,transparent 60%,#0e0e11 100%)"></div>
      </div>
    </div>
    <!-- Top + bottom fades -->
    <div class="absolute inset-0" style="background:linear-gradient(to bottom, #0e0e11 0%, transparent 25%, transparent 65%, #0e0e11 100%)"></div>

    <!-- Hero content -->
    <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 pb-14 pt-28 text-center">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.25em] mb-3">// Launch Intelligence</div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-3 leading-tight" style="font-family:'Inter',sans-serif">
        Grand Theft Auto VI
      </h1>
      <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
        <span class="text-[10px] font-mono bg-gta-teal/10 text-gta-teal border border-gta-teal/20 px-2.5 py-1 rounded uppercase tracking-widest">Confirmed · Nov 19 2026</span>
        <span class="text-[10px] font-mono bg-blue-500/10 text-blue-400 border border-blue-500/20 px-2.5 py-1 rounded uppercase tracking-widest">PS5 · Xbox Series X|S</span>
        <span class="text-[10px] font-mono bg-zinc-800/60 text-zinc-500 border border-zinc-700 px-2.5 py-1 rounded uppercase tracking-widest">PC · TBC</span>
      </div>
      <Countdown variant="hero" />
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-14">

    <!-- ══════════════════════════════════════════════════════
         PLATFORM STATUS
    ══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-2 h-2 rounded-full bg-gta-teal shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Confirmed Platforms</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">Source: Rockstar Games</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {PLATFORMS.map(p => (
          <div class={`rounded-xl border p-5 ${p.border} ${p.bg}`} style="background:#131316">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class={`w-2 h-2 rounded-full ${p.dot} ${!p.confirmed ? "opacity-40" : ""}`}></span>
                <span class={`text-xs font-mono font-bold ${p.color}`}>{p.short}</span>
              </div>
              <span class={`text-[8px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${p.confirmed ? "bg-gta-teal/10 text-gta-teal border-gta-teal/20" : "bg-zinc-800/60 text-zinc-600 border-zinc-700"}`}>
                {p.confirmed ? "Confirmed" : "Not Confirmed"}
              </span>
            </div>
            <div class="text-sm font-semibold text-zinc-200 mb-1" style="font-family:'Inter',sans-serif">{p.name}</div>
            <div class="text-[11px] font-mono text-zinc-600 mb-4">{p.store}</div>
            {p.official_url ? (
              <a href={p.official_url} target="_blank" rel="noopener noreferrer"
                class={`inline-flex items-center gap-2 text-[10px] font-mono border px-3 py-1.5 rounded uppercase tracking-widest transition-all hover:bg-white/5 ${p.color} ${p.border}`}>
                Official page ↗
              </a>
            ) : (
              <span class="text-[10px] font-mono text-zinc-700">No page available yet</span>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         WHERE TO BUY
    ══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-2 h-2 rounded-full bg-gta-gold shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Where to Buy</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">Digital + Physical · Pre-orders imminent</span>
      </div>

      <!-- Status alert -->
      <div class="rounded-xl border border-gta-teal/20 bg-gta-teal/5 px-5 py-4 mb-5 flex items-start gap-3">
        <span class="w-1.5 h-1.5 rounded-full bg-gta-teal mt-1.5 shrink-0 animate-pulse"></span>
        <div>
          <div class="text-[11px] font-semibold text-gta-teal mb-0.5" style="font-family:'Inter',sans-serif">Pre-orders imminent</div>
          <p class="text-[11px] text-zinc-500 leading-relaxed" style="font-family:'Inter',sans-serif">
            Tom Henderson confirmed Best Buy pre-orders starting imminently (May 2026). Official PS Store and Xbox Store wishlist links are live. Physical retailer pre-orders expected to open in lockstep.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {RETAILERS.map(r => (
          <a href={r.url} target="_blank" rel="noopener noreferrer"
            class={`group rounded-xl border p-4 hover:bg-white/3 transition-all flex items-start gap-4 ${r.border}`}
            style="background:#131316">
            <!-- Icon placeholder -->
            <div class={`shrink-0 w-9 h-9 rounded-lg border ${r.border} flex items-center justify-center`} style="background:#0e0e11">
              <span class={`text-[11px] font-mono font-bold ${r.color}`}>{r.name.slice(0,2).toUpperCase()}</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-0.5">
                <span class={`text-sm font-semibold group-hover:text-white transition-colors ${r.color}`} style="font-family:'Inter',sans-serif">{r.name}</span>
                <span class="text-zinc-800 group-hover:text-zinc-600 font-mono text-xs transition-colors">↗</span>
              </div>
              <div class="text-[10px] font-mono text-zinc-600 mb-1">{r.type}</div>
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-gta-teal/60 shrink-0"></span>
                <span class="text-[10px] font-mono text-zinc-500">{r.status}</span>
              </div>
              <div class="text-[9px] font-mono text-zinc-700 mt-1">{r.platform}</div>
            </div>
          </a>
        ))}
      </div>

      <p class="text-[10px] font-mono text-zinc-700 mt-4">
        * Some retailer links may be affiliate links. GTA VI.AI may earn a commission on qualifying purchases at no extra cost to you.
      </p>
    </section>

    <!-- ══════════════════════════════════════════════════════
         EDITION BREAKDOWN
    ══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-3">
        <span class="w-2 h-2 rounded-full bg-zinc-600 shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Edition Breakdown</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">All prices USD · All editions speculative</span>
      </div>
      <!-- Speculative notice -->
      <div class="rounded-xl border border-zinc-700/40 bg-zinc-800/20 px-5 py-3 mb-6 flex items-start gap-3">
        <span class="text-zinc-500 font-mono text-xs mt-0.5 shrink-0">⚠</span>
        <p class="text-[11px] text-zinc-500 leading-relaxed" style="font-family:'Inter',sans-serif">
          Rockstar has not announced editions, prices, or pre-order bonuses. The breakdown below is modelled on <strong class="text-zinc-400">RDR2 (2018)</strong> and <strong class="text-zinc-400">GTA V</strong> release precedent.
          Every edition is labelled <span class="text-zinc-400 font-mono uppercase tracking-widest text-[9px]">Speculative</span> until Rockstar confirms.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {EDITIONS.map((ed) => (
          <div class={`rounded-xl border overflow-hidden flex flex-col transition-all ${ed.highlight ? "border-gta-gold/30 shadow-lg shadow-gta-gold/5" : "border-[#1e1e23]"}`}
            style="background:#131316">

            <!-- Edition header -->
            {ed.highlight && (
              <div class="px-5 py-2 border-b border-gta-gold/20 bg-gta-gold/5 flex items-center justify-between">
                <span class="text-[9px] font-mono text-gta-gold uppercase tracking-widest">Most likely full-content tier</span>
              </div>
            )}

            <div class="px-5 pt-5 pb-4 flex-1">
              <div class="flex items-start justify-between gap-2 mb-1">
                <div class="text-sm font-bold text-zinc-200 leading-snug" style="font-family:'Inter',sans-serif">{ed.name}</div>
                <span class={`shrink-0 text-[8px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${ed.tier_bg} ${ed.tier_color}`}>{ed.tier}</span>
              </div>

              <!-- Price -->
              <div class={`text-2xl font-mono font-bold mb-1 ${ed.highlight ? "text-gta-gold" : "text-gta-bright"}`}>
                ${ed.price_usd.toFixed(2)}
              </div>
              <div class="text-[10px] font-mono text-zinc-700 mb-4">USD · not announced</div>

              <!-- Platforms -->
              <div class="flex items-center gap-1.5 mb-4 flex-wrap">
                {ed.platforms.map((pl: string) => (
                  <span class={`text-[8px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${pl === "PS5" ? "text-blue-400 border-blue-500/20 bg-blue-500/5" : pl === "Xbox" ? "text-green-400 border-green-500/20 bg-green-500/5" : "text-zinc-500 border-zinc-700 bg-zinc-800/40"}`}>
                    {pl}
                  </span>
                ))}
                {"physical" in ed && (ed as any).physical && (
                  <span class="text-[8px] font-mono border border-amber-500/20 text-amber-400 bg-amber-900/10 px-1.5 py-0.5 rounded uppercase tracking-widest">Physical only</span>
                )}
              </div>

              <!-- Includes -->
              <div class="mb-3">
                <div class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest mb-2">Includes</div>
                <ul class="flex flex-col gap-1.5">
                  {ed.includes.map((item: string) => (
                    <li class="flex items-start gap-2">
                      <span class={`shrink-0 mt-0.5 text-[8px] ${ed.highlight ? "text-gta-gold" : "text-zinc-600"}`}>◆</span>
                      <span class="text-[11px] text-zinc-400 leading-snug" style="font-family:'Inter',sans-serif">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Pre-order bonus -->
              {ed.preorder_bonus.length > 0 && (
                <div>
                  <div class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest mb-1.5">Pre-order bonus</div>
                  <ul class="flex flex-col gap-1">
                    {ed.preorder_bonus.map((b: string) => (
                      <li class="flex items-start gap-2">
                        <span class="shrink-0 mt-0.5 text-[8px] text-gta-teal">+</span>
                        <span class="text-[11px] text-zinc-500 leading-snug" style="font-family:'Inter',sans-serif">{b}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <!-- Basis -->
            <div class="px-5 py-3 border-t border-[#1e1e23]">
              <p class="text-[10px] text-zinc-700 font-mono leading-relaxed">{ed.basis}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         CHARACTERS — visual anchor
    ══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-2 h-2 rounded-full bg-gta-teal shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Confirmed Protagonists</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/vi-intel" class="text-[10px] font-mono text-gta-gold/60 hover:text-gta-gold transition-colors tracking-widest uppercase">Full intel →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {([
          { name: "Lucia Caminos", role: "Protagonist", img: "Lucia_Caminos_06.jpg", desc: "Confirmed via official Trailer 1. First female lead in the mainline GTA series." },
          { name: "Jason Duval",   role: "Protagonist", img: "Jason_Duval_06.jpg",   desc: "Confirmed via official Trailer 1 and Trailer 2. Co-protagonist alongside Lucia." },
        ] as const).map(c => (
          <div class="group relative overflow-hidden rounded-xl border border-[#1e1e23] hover:border-gta-gold/20 transition-all">
            <div class="aspect-[16/7] overflow-hidden">
              <img
                src={`/assets/gta6/characters/${c.img}`}
                alt={c.name}
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0" style="background:linear-gradient(to right,#131316 0%,#131316aa 30%,transparent 65%)"></div>
            </div>
            <div class="absolute inset-0 flex items-center px-6">
              <div>
                <div class="text-[9px] font-mono text-gta-gold uppercase tracking-widest mb-1">Confirmed · Official Trailers</div>
                <div class="text-xl font-bold text-white mb-1" style="font-family:'Inter',sans-serif">{c.name}</div>
                <div class="text-[10px] font-mono text-zinc-500 mb-3">{c.role}</div>
                <p class="text-[11px] text-zinc-400 max-w-xs leading-relaxed" style="font-family:'Inter',sans-serif">{c.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         INTELLIGENCE NOTE
    ══════════════════════════════════════════════════════ -->
    <section class="rounded-xl border border-[#1e1e23] p-6" style="background:#131316">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">// Intelligence Standard</div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[
          { label: "Confirmed", color: "text-gta-teal", border: "border-gta-teal/20", desc: "Rockstar Games official material — trailers, press releases, Take-Two IR." },
          { label: "Reported",  color: "text-amber-400", border: "border-amber-500/20", desc: "Credible industry sources with a track record — Tom Henderson, IGN, Kotaku." },
