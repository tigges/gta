---
import Base from "../../layouts/Base.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import ShareButton from "../../components/ShareButton.astro";
import CircularEconomy from "../../components/CircularEconomy.astro";
import ChartComplexityRadar from "../../components/ChartComplexityRadar.astro";
import economyData from "../../../data/franchise/economy-models.json";
const economy = (economyData as any).economies.find((e: any) => e.title_id === "gta-3");
---
<Base title={economy.title_name + " — Economy"} description={economy.economy_type + " · " + economy.real_world_analogue + " · GTAVI.AI franchise economic analysis."} ogPage="gta-v">
  <section class="relative border-b border-[#1e1e23] overflow-hidden" style="min-height:200px">
    <div class="absolute inset-0" style="background:#0a0a0d"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-center gap-2 mb-4 flex-wrap">
        <span class="bg-zinc-800 border-zinc-700/50 text-zinc-400 text-[9px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest">{economy.era_label}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2" style="font-family:'Inter',sans-serif">{economy.title_name} — Economy</h1>
      <p class="text-zinc-400 text-sm leading-relaxed max-w-xl" style="font-family:'Inter',sans-serif">The franchise's economic baseline. Money flows in one direction only — earn, spend, gone. No property, no investment, no compound. The world does not respond to player wealth.</p>
    </div>
  </section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-zinc-600 shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Circular Economy Model</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 rounded-xl border border-[#1e1e23] p-5" style="background:#0e0e11">
          <CircularEconomy titleId="gta-3" mode="full" />
        </div>
        <ChartComplexityRadar titleId="gta-3" size={260} />
      </div>
    </section>

    <section class="rounded-xl border border-gta-gold/15 px-6 py-5" style="background:rgba(245,158,11,0.03)">
      <div class="text-[9px] font-mono text-gta-gold/40 uppercase tracking-widest mb-2">GTA VI Lineage</div>
      <p class="text-[11px] font-mono text-zinc-500 leading-relaxed">{economy.gta_vi_lineage}</p>
    </section>
    <div class="flex items-center gap-3 flex-wrap">
      <a href="/franchise/economics" class="px-4 py-2 rounded border border-[#2a2a31] text-zinc-400 text-[11px] font-mono hover:border-zinc-600 hover:text-zinc-200 transition-all">← Ten Economies</a>
      <a href="/gta-vc/economy" class="px-4 py-2 rounded border border-amber-700/30 text-amber-400 text-[11px] font-mono hover:bg-amber-900/20 transition-all">Vice City: First Asset Loop →</a>
    </div>
    <CrossLinks context="franchise" />
  </div>
</Base>
