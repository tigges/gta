---
import Base from "../layouts/Base.astro";
import CrossLinks from "../components/CrossLinks.astro";
import ChartMetaEvolution    from "../components/charts/ChartMetaEvolution.astro";
import ChartIncomeLeaderboard from "../components/charts/ChartIncomeLeaderboard.astro";
import ChartGtaPpi           from "../components/charts/ChartGtaPpi.astro";
import ChartBonusHeatmap     from "../components/charts/ChartBonusHeatmap.astro";
import ChartRoiScatter       from "../components/charts/ChartRoiScatter.astro";
import ChartPassiveStack     from "../components/charts/ChartPassiveStack.astro";
import ChartSharkCard        from "../components/charts/ChartSharkCard.astro";
import ChartEcoWages         from "../components/charts/ChartEcoWages.astro";
import ChartEcoPpi           from "../components/charts/ChartEcoPpi.astro";
import ChartEcoHealth        from "../components/charts/ChartEcoHealth.astro";
import ChartPreviewCard      from "../components/charts/ChartPreviewCard.astro";
import chartConfig from "../../data/config/chart-config.json";
import { CHART_REGISTRY } from "../config/chartRegistry";

const goConfig   = chartConfig.gta_online;
const Featured0  = CHART_REGISTRY[goConfig.featured[0]];
const Featured1  = CHART_REGISTRY[goConfig.featured[1]];
const Featured2  = CHART_REGISTRY[goConfig.featured[2]];
const Preview0   = CHART_REGISTRY[goConfig.preview[0]];
const Preview1   = CHART_REGISTRY[goConfig.preview[1]];
const Preview2   = CHART_REGISTRY[goConfig.preview[2]];
const Preview3   = CHART_REGISTRY[goConfig.preview[3]];

import weeklyBonuses    from "../../data/gta-5/economy/weekly-bonuses.json";
import revenueTiers     from "../../data/gta-5/economy/revenue-tiers.json";
import bonusHistory     from "../../data/gta-5/economy/bonus-history.json";
import businessProfiles from "../../data/gta-5/economy/business-profiles.json";

const bonuses    = ((weeklyBonuses as any).bonuses  ?? []) as any[];
const sales      = ((weeklyBonuses as any).sales    ?? []) as any[];
const weekStart  = (weeklyBonuses  as any).week_start as string ?? "";
const hasBonuses = bonuses.length > 0 || sales.length > 0;

// Top income method (S-tier first source)
const tiers        = ((revenueTiers as any).tiers ?? []) as any[];
const sTier        = tiers.find((t: any) => t.tier === "S");
const topSource    = sTier?.sources?.[0];
const topGph       = topSource?.gta_per_hr ?? 0;
const topName      = topSource?.name ?? "Cayo + Passive Stack";

const historyCount  = (bonusHistory     as any).entry_count  as number ?? 0;
const profileCount  = (businessProfiles as any).businesses?.length      ?? 0;
---

<Base
  title="GTA Online"
  description="GTA Online economy intelligence — income methods ranked, economy modelled, weekly bonuses tracked. Everything you need to earn smarter in GTA Online."
  ogPage="charts"
>
  <!-- Hero -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden" style="min-height:320px">
    <div class="absolute inset-0"
         style="background:radial-gradient(ellipse at 30% 50%, rgba(13,148,136,0.12) 0%, transparent 60%), linear-gradient(135deg, #0a0a0d 0%, #0e1a0e 40%, #0a0a0d 100%)">
    </div>
    <!-- Subtle grid texture -->
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,#fff 39px,#fff 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,#fff 39px,#fff 40px)">
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-14 sm:py-16">
      <div class="max-w-lg">
        <div class="text-[10px] font-mono text-gta-teal/60 uppercase tracking-[0.25em] mb-3">
          // GTA Online · Live Economic Intelligence
        </div>
        <img src="/assets/logos/gta-online.svg" alt="Grand Theft Auto Online"
             class="h-14 sm:h-18 w-auto mb-5 drop-shadow-lg" loading="eager" />
        <p class="text-sm text-zinc-400 mb-8 leading-relaxed">
          Income methods ranked, inflation modelled, weekly bonuses tracked.
          {profileCount} income sources profiled. Updated nightly.
        </p>
        <!-- Live snapshot -->
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono text-zinc-600">
          <span>
            <span class="font-bold text-sm" style="color:#0d9488">${Math.round(topGph / 1000)}k/hr</span>
            <span class="ml-1">top method</span>
          </span>
          {hasBonuses && bonuses[0] && (
            <span>
              <span class="font-bold text-sm" style="color:#22c55e">{bonuses[0].multiplier}×</span>
              <span class="ml-1 capitalize">{(bonuses[0].activity_id as string).replace(/-/g, " ")} this week</span>
            </span>
          )}
          <span>
            <span class="font-bold text-sm text-zinc-400">{historyCount}</span>
            <span class="ml-1">weeks of bonus history</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">

    <!-- Section cards (4-up grid) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">

      <!-- Economy -->
      <a href="/gta-online/economy"
         class="group rounded-xl border border-[#1e1e23] hover:border-gta-teal/50 p-5 flex flex-col gap-3 transition-all hover:bg-gta-teal/[0.06]"
         style="background:#131316">
        <div class="text-xl">📊</div>
        <div>
          <div class="font-semibold text-zinc-200 text-sm mb-1">Economy Model</div>
          <div class="text-[10px] font-mono text-zinc-600 leading-relaxed">GTA-PPI · inflation · passive income stack · shark card analysis</div>
        </div>
        <div class="mt-auto text-[10px] font-mono transition-colors" style="color:#0d9488">
          <span class="group-hover:text-gta-teal transition-colors">Explore model →</span>
        </div>
      </a>

      <!-- Income Sources -->
      <a href="/database?game=gta-online"
         class="group rounded-xl border border-[#1e1e23] hover:border-gta-gold/50 p-5 flex flex-col gap-3 transition-all hover:bg-gta-gold/[0.04]"
         style="background:#131316">
        <div class="text-xl">💰</div>
        <div>
          <div class="font-semibold text-zinc-200 text-sm mb-1">Income Sources</div>
          <div class="text-[10px] font-mono text-zinc-600 leading-relaxed">{profileCount} methods · S→D tier ranking · daily fee · bonus cadence</div>
        </div>
        <div class="mt-auto text-[10px] font-mono text-gta-gold group-hover:text-gta-gold transition-colors">Browse sources →</div>
      </a>

      <!-- Bonuses & Promos -->
      <a href="/gta-online/bonuses"
         class="group rounded-xl border border-[#1e1e23] hover:border-gta-green/50 p-5 flex flex-col gap-3 transition-all hover:bg-gta-green/[0.05]"
         style="background:#131316">
        <div class="text-xl">🏷</div>
        <div>
          <div class="font-semibold text-zinc-200 text-sm mb-1">Bonuses & Promos</div>
          <div class="text-[10px] font-mono text-zinc-600 leading-relaxed">
            {weekStart ? `Week of ${weekStart} · ` : ""}
            {bonuses.length + sales.length} events · {historyCount} weeks tracked
          </div>
        </div>
        <div class="mt-auto text-[10px] font-mono text-gta-green group-hover:text-gta-green transition-colors">See this week →</div>
      </a>
    </div>

    <!-- This week live strip -->
    {hasBonuses && (
      <div class="mb-12 rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse shrink-0"></span>
            <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em]">// This week{weekStart ? ` · w/c ${weekStart}` : ""}</span>
          </div>
          <a href="/gta-online/bonuses" class="text-[10px] font-mono text-zinc-500 hover:text-zinc-400 transition-colors tracking-widest uppercase">Full calendar →</a>
        </div>
        <div class="divide-y divide-[#1e1e23]">
          {bonuses.slice(0, 4).map((b: any) => (
            <div class="px-5 py-3 flex items-center gap-3">
              <span class="text-[11px] font-mono font-bold w-5 shrink-0" style="color:#0d9488">{b.multiplier}×</span>
              <span class="text-xs font-mono text-zinc-300 capitalize flex-1">
                {(b.activity_id as string).replace(/-/g, " ")}
              </span>
              <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest">bonus</span>
            </div>
          ))}
          {sales.slice(0, 3).map((s: any) => (
            <div class="px-5 py-3 flex items-center gap-3">
              <span class="text-[11px] font-mono font-bold w-5 shrink-0" style="color:#22c55e">{s.discount_pct}%</span>
              <span class="text-xs font-mono text-zinc-300 flex-1">{s.item_description}</span>
              <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest">off</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Top income method callout -->
    <div class="mb-12 rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
      <div class="px-5 py-3 border-b border-[#1e1e23]">
        <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em]">// Current meta ceiling</span>
      </div>
      <div class="px-5 py-5 flex items-center gap-5 flex-wrap">
        <div>
          <div class="text-[11px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Top method</div>
          <div class="text-xl font-semibold text-zinc-200">{topName}</div>
        </div>
        <div class="ml-auto text-right">
          <div class="text-[11px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Net $/hr</div>
          <div class="text-3xl font-mono font-black" style="color:#0d9488">${Math.round(topGph / 1000)}k</div>
        </div>
        <a href="/database?game=gta-online"
           class="w-full sm:w-auto px-4 py-2 rounded border border-gta-teal/30 text-gta-teal text-xs font-mono hover:bg-gta-teal/20 transition-all text-center">
          Browse all income sources →
        </a>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         FEATURED CHARTS — GTA Online
    ═══════════════════════════════════════════════════════ -->
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-gta-teal shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Economy Intelligence — Key Charts</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/charts?title=gta-online" class="text-[10px] font-mono text-zinc-500 hover:text-zinc-400 transition-colors tracking-widest uppercase">All charts →</a>
      </div>

      <!-- Featured charts — order from data/config/chart-config.json gta_online.featured -->
      {Featured0 && <div class="mb-6"><Featured0 /></div>}
      {Featured1 && Featured2 && (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <Featured1 />
          <Featured2 />
        </div>
      )}
    </section>

    <!-- ═══════════════════════════════════════════════════════
         MORE CHARTS — expandable preview cards
    ═══════════════════════════════════════════════════════ -->
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// More GTA Online Charts</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="flex flex-col gap-2">

        <!-- Preview cards — order from data/config/chart-config.json gta_online.preview -->
        {[Preview0, Preview1, Preview2, Preview3].filter(Boolean).map((Comp, i) => (
          Comp && <ChartPreviewCard
            cardId={`preview-online-${i}`}
            title={goConfig.preview[i]}
            description="GTA Online economy chart"
            category="Economy · GTA Online"
            deepLink={`/charts#${goConfig.preview[i]}`}
          >
            <Comp />
          </ChartPreviewCard>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         ECONOMY DEEP DIVE
    ═══════════════════════════════════════════════════════ -->
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[11px] font-mono bg-gta-teal/30 text-gta-teal border border-gta-teal/40 px-2 py-0.5 rounded uppercase tracking-widest">Economy</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Economic Flow Analysis</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/gta-online/economy" class="text-[10px] font-mono text-gta-teal/70 hover:text-gta-teal transition-colors tracking-widest uppercase">Full model →</a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <ChartEcoWages />
        <ChartEcoPpi />
      </div>
      <ChartEcoHealth />

      <div class="mt-5 rounded-xl border border-gta-teal/20 px-5 py-4 flex items-center justify-between flex-wrap gap-3" style="background:#0e1a0e">
        <div>
          <div class="font-semibold text-gta-teal text-sm mb-0.5">Complete Economy Model</div>
          <div class="text-[10px] font-mono text-gta-teal leading-snug">Circular flow · Shark Card spend · savings profile · investment analysis · all 7 economy charts</div>
        </div>
        <a href="/gta-online/economy" class="shrink-0 px-4 py-2 rounded border border-gta-teal/30 text-gta-teal text-[10px] font-mono hover:bg-gta-teal/20 transition-all">
          Open Economy Model →
        </a>
      </div>
    </section>

    <CrossLinks context="gta-online" />
  </div>
</Base>
