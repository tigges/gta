---
import Base from "../layouts/Base.astro";
import entityIndex from "../../data/gta-6/entities/index.json";

const { total, by_type, by_confidence, entities } = entityIndex as any;

const TYPES = ["vehicle","character","weapon","business","animal","location"] as const;
const CONFIDENCE_TIERS = ["confirmed","reported","indexed"] as const;

const TIER_META = {
  confirmed: { label: "Confirmed", color: "text-gta-gold",  badge: "bg-gta-gold/10 border-gta-gold/25",  dot: "bg-gta-gold"  },
  reported:  { label: "Reported",  color: "text-zinc-300",  badge: "bg-zinc-800 border-zinc-700",         dot: "bg-zinc-400"  },
  indexed:   { label: "Indexed",   color: "text-zinc-600",  badge: "bg-zinc-900 border-zinc-800",         dot: "bg-zinc-700"  },
};

const TYPE_META: Record<string,{icon:string;label:string}> = {
  vehicle:   { icon: "🚗", label: "Vehicles"   },
  character: { icon: "👤", label: "Characters" },
  weapon:    { icon: "🔫", label: "Weapons"    },
  business:  { icon: "🏢", label: "Businesses" },
  animal:    { icon: "🐊", label: "Animals"    },
  location:  { icon: "📍", label: "Locations"  },
};
---

<Base
  title="Database"
  description="GTA VI entity database — 546 vehicles, characters, weapons, businesses and more. Filterable by type and confidence tier."
>

  <!-- Header -->
  <section class="border-b border-[#1e1e23]" style="background:#0a0a0d">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// Entity Intelligence</div>
          <h1 class="text-3xl font-bold text-white mb-2" style="font-family:'Inter',sans-serif">Database</h1>
          <p class="text-sm text-zinc-400 max-w-lg mb-1" style="font-family:'Inter',sans-serif">
            {total} GTA VI entities indexed from Fandom Wiki + official sources.
            GTA VI shown by default. Filter by type and confidence tier.
          </p>
          <p class="text-[11px] text-zinc-600 font-mono">
            {by_confidence.confirmed} confirmed · {by_confidence.reported} reported · {by_confidence.indexed} indexed
          </p>
        </div>
        <!-- Type breakdown -->
        <div class="grid grid-cols-3 gap-2 self-end">
          {TYPES.map(type => (
            <div class="rounded-lg border border-[#1e1e23] px-3 py-2 text-center" style="background:#131316">
              <div class="text-base mb-0.5">{TYPE_META[type].icon}</div>
              <div class="text-xs font-mono font-bold text-gta-bright">{(by_type as any)[type] ?? 0}</div>
              <div class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest">{type}s</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Filter bar -->
  <div class="sticky top-12 z-40 border-b border-[#1e1e23]" style="background:rgba(14,14,17,0.97);backdrop-filter:blur(12px)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center gap-4 flex-wrap">
      <!-- Type filters -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-[9px] font-mono text-zinc-700 uppercase tracking-widest mr-1">Type</span>
        <button class="db-type-filter px-2.5 py-1 rounded text-[10px] font-mono border border-gta-gold/40 text-gta-gold bg-gta-gold/8 transition-all" data-type="all">All</button>
        {TYPES.map(t => (
          <button class="db-type-filter px-2.5 py-1 rounded text-[10px] font-mono border border-[#2a2a31] text-zinc-500 hover:text-zinc-300 hover:border-zinc-600 transition-all" data-type={t}>
            {TYPE_META[t].icon} {TYPE_META[t].label}
          </button>
        ))}
      </div>
      <!-- Tier filters -->
      <div class="flex items-center gap-1.5 ml-auto flex-wrap">
        <span class="text-[9px] font-mono text-zinc-700 uppercase tracking-widest mr-1">Tier</span>
        {CONFIDENCE_TIERS.map(tier => {
          const meta = TIER_META[tier];
          return (
            <button class={`db-tier-filter px-2.5 py-1 rounded text-[9px] font-mono border uppercase tracking-widest transition-all ${meta.badge} ${meta.color}`} data-tier={tier} data-active="true">
              {meta.label}
            </button>
          );
        })}
      </div>
      <!-- Search -->
      <input
        id="db-search"
        type="text"
        placeholder="Search entities..."
        class="px-3 py-1.5 rounded border border-[#2a2a31] bg-[#1a1a1e] text-zinc-300 text-[11px] font-mono placeholder-zinc-700 focus:outline-none focus:border-gta-gold/40 w-40"
      />
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">

    <!-- Stats row -->
    <div class="flex items-center gap-3 mb-5">
      <span id="db-count" class="text-[10px] font-mono text-zinc-600">{total} entities</span>
      <div class="flex-1 h-px bg-[#1e1e23]"></div>
      <span class="text-[10px] font-mono text-zinc-700">GTA VI · via GTA Fandom Wiki</span>
    </div>

    <!-- Entity grid -->
    <div id="db-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2"
      data-entities={JSON.stringify(entities)}>
      <!-- Rendered by JS below for filtering performance -->
    </div>

    <!-- No results -->
    <div id="db-empty" class="hidden py-16 text-center">
      <div class="text-zinc-600 font-mono text-sm">No entities match the current filters.</div>
    </div>

    <!-- Source note -->
    <div class="mt-8 border border-[#1e1e23] rounded-xl p-4" style="background:#131316">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// Source Standard</div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {Object.entries(TIER_META).map(([key, meta]) => (
          <div class="flex items-start gap-2">
            <span class={`shrink-0 text-[8px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest mt-0.5 ${meta.badge} ${meta.color}`}>{meta.label}</span>
            <p class="text-[11px] text-zinc-600 leading-relaxed" style="font-family:'Inter',sans-serif">
              {key === "confirmed" && "Rockstar official material — trailers, press kit, official statements."}
              {key === "reported" && "Credible community sources — trailer analysis, GTA Fandom Wiki entries with citations."}
              {key === "indexed" && "Listed on wiki or community databases — confidence not yet individually assessed."}
            </p>
          </div>
        ))}
      </div>
      <p class="text-[10px] text-zinc-700 font-mono mt-3">
        Database powered by GTA Fandom Wiki (gta.fandom.com) · Not affiliated with Rockstar Games.
        Franchise lineage + confidence scoring being expanded in v3.0.
      </p>
    </div>
  </div>
</Base>

<script>
  const TIER_META: Record<string,{badge:string;color:string;label:string}> = {
    confirmed: { label:"Confirmed", color:"text-gta-gold",  badge:"bg-gta-gold/10 border-gta-gold/25"  },
    reported:  { label:"Reported",  color:"text-zinc-300",  badge:"bg-zinc-800 border-zinc-700"        },
    indexed:   { label:"Indexed",   color:"text-zinc-600",  badge:"bg-zinc-900 border-zinc-800"        },
  };

  const TYPE_META: Record<string,{icon:string}> = {
    vehicle:"🚗", character:"👤", weapon:"🔫",
    business:"🏢", animal:"🐊", location:"📍",
  } as any;

  interface Entity {
    id: string; name: string; type: string;
    confidence_tier: string; confidence_score: number;
    franchise_debut: string; franchise_lineage: string[];
    game_version: string;
  }

  const grid    = document.getElementById("db-grid")!;
  const countEl = document.getElementById("db-count")!;
  const emptyEl = document.getElementById("db-empty")!;
  const searchEl = document.getElementById("db-search") as HTMLInputElement;

  let allEntities: Entity[] = JSON.parse(grid.dataset.entities || "[]");
  let activeType = "all";
  let activeTiers = new Set(["confirmed","reported","indexed"]);
  let searchQuery = "";
  let currentPage = 0;
  const PAGE_SIZE = 100;

  function buildCard(e: Entity): string {
    const meta = TIER_META[e.confidence_tier] ?? TIER_META.indexed;
    const icon = (TYPE_META as any)[e.type] ?? "•";
    const debut = e.franchise_debut !== "gta-6" ? `<span class="text-[9px] font-mono text-zinc-700">debut ${e.franchise_debut}</span>` : "";
    return `
      <div class="rounded-lg border border-[#1e1e23] p-3 hover:border-[#2a2a31] transition-colors group" style="background:#131316">
        <div class="flex items-start justify-between gap-2 mb-1.5">
          <span class="text-xs font-semibold text-zinc-200 leading-snug group-hover:text-white transition-colors" style="font-family:'Inter',sans-serif">${e.name}</span>
          <span class="shrink-0 text-[8px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${meta.badge} ${meta.color}">${meta.label}</span>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-[10px] font-mono text-zinc-600">${(icon as any)[e.type] ?? icon} ${e.type}</span>
          ${debut}
        </div>
      </div>`;
  }

  function renderPage() {
    const filtered = allEntities.filter(e => {
      if (activeType !== "all" && e.type !== activeType) return false;
      if (!activeTiers.has(e.confidence_tier)) return false;
      if (searchQuery && !e.name.toLowerCase().includes(searchQuery)) return false;
      return true;
    });

    const page = filtered.slice(currentPage * PAGE_SIZE, (currentPage + 1) * PAGE_SIZE);
    grid.innerHTML = page.map(buildCard).join("");
    countEl.textContent = `${filtered.length} entities`;
    emptyEl.classList.toggle("hidden", filtered.length > 0);

    // Pagination if needed
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
    const existingPager = document.getElementById("db-pager");
    if (existingPager) existingPager.remove();
    if (totalPages > 1) {
      const pager = document.createElement("div");
      pager.id = "db-pager";
      pager.className = "flex justify-center gap-2 mt-6";
      for (let i = 0; i < totalPages; i++) {
        const btn = document.createElement("button");
        btn.textContent = String(i + 1);
        btn.className = `px-3 py-1.5 rounded text-[10px] font-mono border transition-all ${i === currentPage ? "border-gta-gold/40 text-gta-gold bg-gta-gold/8" : "border-[#2a2a31] text-zinc-500 hover:text-zinc-300"}`;
        btn.onclick = () => { currentPage = i; renderPage(); window.scrollTo(0, 300); };
        pager.appendChild(btn);
      }
      grid.after(pager);
    }
  }

  // Type filter
  document.querySelectorAll<HTMLButtonElement>(".db-type-filter").forEach(btn => {
    btn.addEventListener("click", () => {
      activeType = btn.dataset.type!;
      currentPage = 0;
      document.querySelectorAll<HTMLButtonElement>(".db-type-filter").forEach(b => {
        const active = b.dataset.type === activeType;
        b.className = b.className.replace(/border-gta-gold\/40|text-gta-gold|bg-gta-gold\/8/g, "").replace(/border-\[#2a2a31\]|text-zinc-500/g, "").trim();
        b.classList.add(...(active ? ["border-gta-gold/40","text-gta-gold","bg-gta-gold/8"] : ["border-[#2a2a31]","text-zinc-500"]));
      });
      renderPage();
    });
  });

  // Tier filter (toggle)
  document.querySelectorAll<HTMLButtonElement>(".db-tier-filter").forEach(btn => {
    btn.addEventListener("click", () => {
      const tier = btn.dataset.tier!;
      const active = btn.dataset.active === "true";
      btn.dataset.active = active ? "false" : "true";
      btn.style.opacity = active ? "0.35" : "1";
      if (active) activeTiers.delete(tier);
      else activeTiers.add(tier);
      currentPage = 0;
      renderPage();
    });
  });

  // Search
  searchEl?.addEventListener("input", () => {
    searchQuery = searchEl.value.toLowerCase().trim();
    currentPage = 0;
    renderPage();
  });

  // Initial render
  renderPage();
</script>
