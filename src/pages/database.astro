---
import Base from "../layouts/Base.astro";
import CrossLinks from "../components/CrossLinks.astro";
import ProfitCard from "../components/ProfitCard.astro";
import entityIndex    from "../../data/gta-6/entities/index.json";
import leonidaRaw     from "../../data/gta-6/entities/leonida-intel.json";
import vehiclesRaw    from "../../data/gta-5/vehicles/performance.json";
import businessProfiles from "../../data/gta-5/economy/business-profiles.json";
import onlineHeists     from "../../data/gta-5/economy/online-heists.json";
import revenueTiers     from "../../data/gta-5/economy/revenue-tiers.json";
import storyMissions    from "../../data/gta-5/missions/story-missions.json";
import onlineMissions   from "../../data/gta-5/missions/online-top.json";
import stocksData       from "../../data/gta-5/economy/assassination-stocks.json";
import heistsData        from "../../data/gta-5/missions/heists.json";

// ── GTA VI entities ────────────────────────────────────────────────────────
const fandomEntities = (entityIndex as any).entities as any[];

const LEONIDA_WORLD_CATS = new Set([
  "Vehicles","Characters","Weapons","Locations","Animals",
  "Businesses","Missions","Activities","Properties","Radio",
]);

const LEONIDA_TYPE_MAP: Record<string,string> = {
  Vehicles:"vehicle", Characters:"character", Weapons:"weapon",
  Locations:"location", Animals:"animal", Businesses:"business",
  Missions:"mission", Activities:"activity", Properties:"property", Radio:"radio",
};

const leonidaEntities = (leonidaRaw as any).entities
  .filter((e: any) => LEONIDA_WORLD_CATS.has(e.category))
  .map((e: any) => ({
    name:             e.name,
    type:             LEONIDA_TYPE_MAP[e.category] ?? e.category.toLowerCase(),
    confidence_tier:  e.confirmed ? "confirmed" : "indexed",
    source_id:        "leonida",
    source_label:     "Leonida Intel",
    url:              e.url,
  }));

// Normalise fandom entities to the same shape
const fandomNorm = fandomEntities.map((e: any) => ({
  name:             e.name,
  type:             e.type,
  confidence_tier:  e.confidence_tier,
  franchise_debut:  e.franchise_debut,
  source_id:        "fandom",
  source_label:     "Fandom Wiki",
  url:              undefined,
  image_url:        e.image_url ?? null,
}));

// Combined GTA VI entity array (fandom first, leonida appended)
const gta6Entities = [...fandomNorm, ...leonidaEntities];

// ── GTA V vehicles ─────────────────────────────────────────────────────────
const gta5Vehicles  = (vehiclesRaw as any).vehicles as any[];
const gta5UpdatedAt = (vehiclesRaw as any).last_updated as string;
const gta5Classes   = [...new Set(
  gta5Vehicles.map((v: any) => (v.class as string).replace(/ \(NR\)$/, ""))
)].sort() as string[];

// ── Stats ──────────────────────────────────────────────────────────────────
const fandByType  = (entityIndex as any).by_type as Record<string,number>;
const fandByConf  = (entityIndex as any).by_confidence as Record<string,number>;
const leonidaStats = (leonidaRaw as any).entity_stats as {total:number;confirmed:number;indexed:number};

const GTA6_TYPES = ["vehicle","character","weapon","location","business","animal","mission","activity","property"] as const;
const GTA5_TIER_LABELS: Record<string,string> = {
  S:"S — Tier",A:"A — Tier",B:"B — Tier",C:"C — Tier",
  D:"D — Tier",E:"E — Tier",F:"F — Tier",G:"G — Tier",
  H:"H — Tier",I:"I — Tier",J:"J — Tier",K:"K — Tier",
  L:"L — Tier",M:"M — Tier",N:"N — Tier",O:"O — Tier",
};

const CONFIDENCE_TIERS = ["confirmed","reported","indexed"] as const;

const TIER_META = {
  confirmed: { label:"Confirmed", color:"text-gta-gold",  badge:"bg-gta-gold/10 border-gta-gold/25"  },
  reported:  { label:"Reported",  color:"text-zinc-300",  badge:"bg-zinc-800 border-zinc-700"        },
  indexed:   { label:"Indexed",   color:"text-zinc-600",  badge:"bg-zinc-900 border-zinc-800"        },
};

const TYPE_META: Record<string,{icon:string;label:string}> = {
  vehicle:   { icon:"🚗", label:"Vehicles"   },
  character: { icon:"👤", label:"Characters" },
  weapon:    { icon:"🔫", label:"Weapons"    },
  business:  { icon:"🏢", label:"Businesses" },
  animal:    { icon:"🐊", label:"Animals"    },
  location:  { icon:"📍", label:"Locations"  },
  mission:   { icon:"🎯", label:"Missions"   },
  activity:  { icon:"🎮", label:"Activities" },
  property:  { icon:"🏠", label:"Properties" },
};

// ── Economy data ────────────────────────────────────────────────────────────
const bizProfiles    = (businessProfiles as any).businesses as any[];
const heistList      = (onlineHeists as any).heists as any[];
const tiers          = (revenueTiers as any).tiers as any[];
const storyMissionList = (storyMissions as any).missions as any[];
const onlineMissionList = (onlineMissions as any).missions as any[];
const assassinGuide  = (stocksData as any).guide_order as any[];
const maxProfitHr    = 340000; // Cayo Perico — S-tier ceiling

// Tier assignment from revenue tiers data
const TIER_MAP: Record<string, "S"|"A"|"B"|"C"|"D"> = {};
tiers.forEach((t: any) => t.sources.forEach((s: any) => { TIER_MAP[s.id] = t.tier; }));

// Business thumbnail map
const BIZ_THUMBS: Record<string, string> = {
  "cayo-perico":         "/assets/gta6/locations/Leonida_Keys_01.jpg",
  "acid-lab":            "/assets/gta6/locations/Grassrivers_01.jpg",
  "nightclub":           "/assets/gta6/locations/Ambrosia_02.jpg",
  "bunker":              "/assets/gta6/locations/Grassrivers_02.jpg",
  "vehicle-warehouse":   "/assets/gta6/locations/Port_Gellhorn_01.jpg",
  "diamond-casino-heist":"/assets/gta6/locations/Vice_City_01.jpg",
  "auto-shop":           "/assets/gta6/locations/Port_Gellhorn_03.jpg",
  "hangar":              "/assets/gta6/locations/Mount_Kalaga_National_Park_01.jpg",
  "cocaine-lockup":      "/assets/gta6/locations/Ambrosia_01.jpg",
  "ceo-crates":          "/assets/gta6/locations/Vice_City_03.jpg",
  "vip-work":            "/assets/gta6/locations/Vice_City_04.jpg",
};

// Difficulty mapping
const DIFF_MAP: Record<string, number> = {
  "cayo-perico":1, "acid-lab":1, "nightclub":1, "bunker":2, "vehicle-warehouse":2,
  "diamond-casino-heist":3, "auto-shop":2, "hangar":2, "cocaine-lockup":2,
  "ceo-crates":4, "vip-work":2, "methamphetamine-lab":2, "weed-farm":1,
  "counterfeit-cash":1, "document-forgery":1,
};

// Online heist thumbnails
const HEIST_THUMBS: Record<string, string> = {
  "cayo-perico":           "/assets/gta6/locations/Leonida_Keys_01.jpg",
  "diamond-casino-heist":  "/assets/gta6/locations/Vice_City_01.jpg",
  "doomsday-act-3":        "/assets/gta6/locations/Mount_Kalaga_National_Park_01.jpg",
  "pacific-standard":      "/assets/gta6/locations/Port_Gellhorn_02.jpg",
  "fleeca-job":            "/assets/gta6/locations/Leonida_Keys_02.jpg",
};
---

<Base
  title="Database"
  description={`GTA franchise entity database — ${gta6Entities.length.toLocaleString()} GTA VI entities (Fandom Wiki + Leonida Intel) and ${gta5Vehicles.length} GTA V vehicles with Broughy performance benchmarks.`}
  ogPage="database"
>

  <!-- Header -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden">
    <div class="absolute inset-0">
      <img src="/assets/gta6/locations/Vice_City_05.jpg" alt="" class="w-full h-full object-cover" style="object-position:center 60%" aria-hidden="true" />
      <div class="absolute inset-0" style="background:linear-gradient(to right, #0a0a0d 0%, #0a0a0dcc 55%, #0a0a0d88 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom, transparent 0%, #0a0a0d 100%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// Entity Intelligence</div>
      <h1 class="text-3xl font-bold text-white mb-4" style="font-family:'Inter',sans-serif">Database</h1>

      <!-- Game version tabs -->
      <div class="flex items-center gap-2 mb-6 flex-wrap">
        <button id="tab-gta6" class="db-game-tab px-4 py-2 rounded-lg text-sm font-mono border border-gta-gold/40 text-gta-gold bg-gta-gold/8 transition-all" data-game="gta-6">
          GTA VI
        </button>
        <button id="tab-online" class="db-game-tab px-4 py-2 rounded-lg text-sm font-mono border border-[#2a2a31] text-zinc-500 hover:text-zinc-300 hover:border-zinc-600 transition-all" data-game="gta-online">
          GTA Online
        </button>
        <button id="tab-gta5" class="db-game-tab px-4 py-2 rounded-lg text-sm font-mono border border-[#2a2a31] text-zinc-500 hover:text-zinc-300 hover:border-zinc-600 transition-all" data-game="gta-5">
          GTA V
        </button>
        <button id="tab-franchise" class="db-game-tab px-4 py-2 rounded-lg text-sm font-mono border border-[#2a2a31] text-zinc-500 hover:text-zinc-300 hover:border-zinc-600 transition-all" data-game="franchise">
          Franchise
        </button>
      </div>

      <!-- GTA VI stats -->
      <div id="header-gta6">
        <p class="text-sm text-zinc-400 max-w-xl mb-2" style="font-family:'Inter',sans-serif">
          {gta6Entities.length.toLocaleString()} GTA VI entities from GTA Fandom Wiki + Leonida Intel.
          Filter by type, confidence tier and source.
        </p>
        <div class="flex items-center gap-4 flex-wrap text-[11px] font-mono text-zinc-600">
          <span>{fandByConf.confirmed ?? 0} confirmed (Wiki)</span>
          <span class="text-zinc-800">·</span>
          <span>{leonidaStats.confirmed} confirmed (Leonida)</span>
          <span class="text-zinc-800">·</span>
          <span>{fandomEntities.length} Fandom Wiki</span>
          <span class="text-zinc-800">·</span>
          <span>{leonidaEntities.length} Leonida Intel</span>
        </div>
      </div>

      <!-- GTA V stats -->
      <div id="header-gta5" class="hidden">
        <p class="text-sm text-zinc-400 max-w-xl mb-2" style="font-family:'Inter',sans-serif">
          {gta5Vehicles.length} GTA V vehicles with Broughy1322 performance benchmarks.
          Lap times and top speeds from the Broughy1322 Comprehensive Vehicle List.
        </p>
        <div class="flex items-center gap-4 flex-wrap text-[11px] font-mono text-zinc-600">
          <span>{gta5Classes.length} vehicle classes</span>
          <span class="text-zinc-800">·</span>
          <span>Source: Broughy1322 Google Sheet</span>
          <span class="text-zinc-800">·</span>
          <span>Updated: {new Date(gta5UpdatedAt).toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric"})}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter bar -->
  <div class="sticky top-12 z-40 border-b border-[#1e1e23]" style="background:rgba(14,14,17,0.97);backdrop-filter:blur(12px)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center gap-3 flex-wrap">

      <!-- GTA VI filters -->
      <div id="filters-gta6" class="flex items-center gap-3 flex-wrap w-full">
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="text-[9px] font-mono text-zinc-700 uppercase tracking-widest mr-1">Type</span>
          <button class="db-type-filter px-2.5 py-1 rounded text-[10px] font-mono border border-gta-gold/40 text-gta-gold bg-gta-gold/8 transition-all" data-type="all">All</button>
          {GTA6_TYPES.map(t => (
            <button class="db-type-filter px-2.5 py-1 rounded text-[10px] font-mono border border-[#2a2a31] text-zinc-500 hover:text-zinc-300 hover:border-zinc-600 transition-all" data-type={t}>
              {TYPE_META[t].icon} {TYPE_META[t].label}
            </button>
          ))}
        </div>
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="text-[9px] font-mono text-zinc-700 uppercase tracking-widest mr-1">Tier</span>
          {CONFIDENCE_TIERS.map(tier => {
            const meta = TIER_META[tier];
            return (
              <button class={`db-tier-filter px-2.5 py-1 rounded text-[9px] font-mono border uppercase tracking-widest transition-all ${meta.badge} ${meta.color}`} data-tier={tier} data-active="true">
                {meta.label}
              </button>
            );
          })}
        </div>
        <div class="flex items-center gap-1.5 ml-auto">
          <span class="text-[9px] font-mono text-zinc-700 uppercase tracking-widest mr-1">Source</span>
          <button class="db-source-filter px-2.5 py-1 rounded text-[9px] font-mono border border-[#2a2a31] text-zinc-500 hover:border-zinc-500 transition-all" data-source="all" data-active="true">All</button>
          <button class="db-source-filter px-2.5 py-1 rounded text-[9px] font-mono border border-[#2a2a31] text-zinc-500 hover:border-zinc-500 transition-all" data-source="fandom" data-active="true">Fandom Wiki</button>
          <button class="db-source-filter px-2.5 py-1 rounded text-[9px] font-mono border border-[#2a2a31] text-zinc-500 hover:border-zinc-500 transition-all" data-source="leonida" data-active="true">Leonida Intel</button>
        </div>
        <input
          id="db-search-gta6"
          type="text"
          placeholder="Search GTA VI..."
          class="px-3 py-1.5 rounded border border-[#2a2a31] bg-[#1a1a1e] text-zinc-300 text-[11px] font-mono placeholder-zinc-700 focus:outline-none focus:border-gta-gold/40 w-36"
        />
      </div>

      <!-- GTA V filters -->
      <div id="filters-gta5" class="hidden flex items-center gap-3 flex-wrap w-full">
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="text-[9px] font-mono text-zinc-700 uppercase tracking-widest mr-1">Class</span>
          <button class="v5-class-filter px-2.5 py-1 rounded text-[10px] font-mono border border-gta-gold/40 text-gta-gold bg-gta-gold/8 transition-all" data-class="all">All</button>
          {gta5Classes.map(c => (
            <button class="v5-class-filter px-2.5 py-1 rounded text-[10px] font-mono border border-[#2a2a31] text-zinc-500 hover:text-zinc-300 hover:border-zinc-600 transition-all" data-class={c}>
              {c}
            </button>
          ))}
        </div>
        <div class="flex items-center gap-1.5 ml-auto">
          <span class="text-[9px] font-mono text-zinc-700 uppercase tracking-widest mr-1">Sort</span>
          <button class="v5-sort-btn px-2.5 py-1 rounded text-[9px] font-mono border border-gta-gold/40 text-gta-gold bg-gta-gold/8 transition-all" data-sort="lap">Lap Time</button>
          <button class="v5-sort-btn px-2.5 py-1 rounded text-[9px] font-mono border border-[#2a2a31] text-zinc-500 hover:border-zinc-500 transition-all" data-sort="speed">Top Speed</button>
        </div>
        <input
          id="db-search-gta5"
          type="text"
          placeholder="Search GTA V vehicles..."
          class="px-3 py-1.5 rounded border border-[#2a2a31] bg-[#1a1a1e] text-zinc-300 text-[11px] font-mono placeholder-zinc-700 focus:outline-none focus:border-gta-gold/40 w-44"
        />
      </div>

    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">

    <!-- Stats row -->
    <div class="flex items-center gap-3 mb-5">
      <span id="db-count" class="text-[10px] font-mono text-zinc-600">{gta6Entities.length} entities</span>
      <div class="flex-1 h-px bg-[#1e1e23]"></div>
      <span id="db-source-label" class="text-[10px] font-mono text-zinc-700">GTA VI · Fandom Wiki + Leonida Intel</span>
    </div>

    <!-- GTA VI entity grid -->
    <div id="db-grid-gta6" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2"
      data-entities={JSON.stringify(gta6Entities)}>
    </div>

    <!-- GTA V vehicle grid -->
    <div id="db-grid-gta5" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2"
      data-vehicles={JSON.stringify(gta5Vehicles)}>
    </div>

    <!-- GTA Online economy section -->
    <div id="db-section-online" class="hidden">
      <!-- Category filters -->
      <div class="flex items-center gap-2 mb-5 flex-wrap">
        <span class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest mr-1">Category</span>
        {[
          { id: "all",      label: "All" },
          { id: "heist",    label: "🏦 Heists" },
          { id: "business", label: "🏢 Businesses" },
          { id: "mc",       label: "🏍 MC Businesses" },
          { id: "active",   label: "⚡ Active" },
          { id: "passive",  label: "💤 Passive" },
        ].map(f => (
          <button class="online-cat-filter px-2.5 py-1 rounded text-[10px] font-mono border transition-all"
            class:list={[f.id === "all" ? "border-gta-gold/40 text-gta-gold bg-gta-gold/8" : "border-[#2a2a31] text-zinc-500 hover:text-zinc-300 hover:border-zinc-600"]}
            data-cat={f.id}>{f.label}</button>
        ))}
        <div class="flex-1"></div>
        <span class="text-[9px] font-mono text-zinc-700">Sort by $/hr · fully upgraded · 2024 patches</span>
      </div>

      <!-- Tier sections -->
      {tiers.map((tier: any) => (
        <div class="mb-8 online-tier-section" data-tier={tier.tier}>
          <div class="flex items-center gap-3 mb-4">
            <span class="font-mono font-black text-xl leading-none" style={`color:${tier.color}`}>{tier.tier}</span>
            <span class="text-[10px] font-mono text-zinc-500">{tier.label}</span>
            <div class="flex-1 h-px bg-[#1e1e23]"></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            {tier.sources.map((src: any) => {
              const biz = bizProfiles.find((b: any) => b.id === src.id)
                       || heistList.find((h: any) => h.id === src.id);
              if (!biz) return null;
              const isHeist = heistList.some((h: any) => h.id === src.id);
              return (
                <div class="online-card" data-category={biz.category ?? (isHeist ? "heist" : "business")}>
                  <ProfitCard
                    id={biz.id ?? src.id}
                    name={biz.name ?? biz.title}
                    game="gta-online"
                    category={biz.category ?? (isHeist ? "heist" : "business")}
                    tier={tier.tier as "S"|"A"|"B"|"C"|"D"}
                    net_profit_per_hr={src.gta_per_hr}
                    max_profit_per_hr={maxProfitHr}
                    setup_cost_full={biz.setup_cost_full ?? undefined}
                    break_even_hrs={biz.break_even_hrs ?? (biz.setup_cost_full ? Math.round(biz.setup_cost_full / src.gta_per_hr) : undefined)}
                    play_type={biz.play_type ?? (isHeist ? "heist" : "active")}
                    difficulty={DIFF_MAP[src.id] ?? 3}
                    min_players={biz.min_players ?? 1}
                    max_players={biz.max_players ?? 4}
                    solo={biz.solo ?? true}
                    dlc={biz.dlc ?? undefined}
                    prerequisite={biz.prerequisite ?? undefined}
                    payout_per_run_min={biz.payout_per_run_min ?? undefined}
                    payout_per_run_max={biz.payout_per_run_max ?? undefined}
                    avg_run_time_min={biz.avg_run_time_min ?? undefined}
                    loot_tiers={biz.loot_tiers ?? undefined}
                    tips={biz.tips ?? undefined}
                    notes={biz.notes ?? undefined}
                    thumbnail={BIZ_THUMBS[src.id] ?? HEIST_THUMBS[src.id] ?? undefined}
                    share_url="https://gtavi.ai/database"
                  />
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- GTA V Economy section -->
    <div id="db-section-gta5eco" class="hidden">
      <div class="flex items-center gap-2 mb-5 flex-wrap">
        <span class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest mr-1">Category</span>
        {[
          { id: "all",     label: "All" },
          { id: "mission", label: "🎯 Story Missions" },
          { id: "heist",   label: "🏦 Heists" },
          { id: "stocks",  label: "📈 Stock Guide" },
        ].map(f => (
          <button class="gta5eco-cat-filter px-2.5 py-1 rounded text-[10px] font-mono border transition-all"
            class:list={[f.id === "all" ? "border-gta-gold/40 text-gta-gold bg-gta-gold/8" : "border-[#2a2a31] text-zinc-500 hover:text-zinc-300 hover:border-zinc-600"]}
            data-cat={f.id}>{f.label}</button>
        ))}
      </div>

      <!-- Story Heists -->
      <div class="mb-6 gta5eco-section" data-category="heist">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-4 flex items-center gap-3">
          <span>// Story Heists</span><div class="flex-1 h-px bg-[#1e1e23]"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {(heistsData as any).heists.filter((h: any) => h.approaches?.[0]?.player_max_cut > 0).map((h: any) => (
            <div class="gta5eco-card" data-category="heist">
              <ProfitCard
                id={h.id}
                name={h.title}
                game="gta-5"
                category="heist"
                tier={h.id === "the-big-score" ? "S" : "C"}
                net_profit_per_hr={Math.round((h.approaches?.[0]?.player_max_cut ?? 0) / ((h as any).avg_time_hr ?? 2))}
                max_profit_per_hr={42000000}
                setup_cost_full={0}
                play_type="heist"
                difficulty={h.difficulty === "Hard" ? 4 : h.difficulty === "Medium" ? 3 : 2}
                min_players={h.min_players ?? 2}
                max_players={h.max_players ?? 4}
                solo={h.min_players === 1}
                payout_per_run_max={h.approaches?.[0]?.player_max_cut}
                notes={h.notes ?? undefined}
                share_url="https://gtavi.ai/database"
              />
            </div>
          ))}
        </div>
      </div>

      <!-- Assassination Stock Guide -->
      <div class="mb-6 gta5eco-section" data-category="stocks">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-4 flex items-center gap-3">
          <span>// Assassination Stock Guide — LCN / BAWSAQ</span><div class="flex-1 h-px bg-[#1e1e23]"></div>
          <span class="text-zinc-700">$2B+ theoretical maximum</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {assassinGuide.map((step: any) => (
            <div class="gta5eco-card" data-category="stocks">
              <ProfitCard
                id={step.mission_id}
                name={step.title}
                game="gta-5"
                category="mission"
                tier={step.combined_return_pct >= 300 ? "S" : step.combined_return_pct >= 100 ? "A" : "B"}
                net_profit_per_hr={Math.round(step.combined_return_pct * 1000000 / 100)}
                max_profit_per_hr={380 * 1000000 / 100}
                play_type="mission"
                difficulty={2}
                min_players={1}
                max_players={1}
                solo={true}
                payout_per_run_max={Math.round(step.combined_return_pct * 2000000 / 100)}
                notes={`Combined return: +${step.combined_return_pct}%. ${step.max_profit_note ?? ""}`}
                tips={step.strategy?.slice(0,2).map((s: any) => `${s.action.toUpperCase()} ${s.ticker} (${s.exchange})${s.expected_return_pct ? ` → +${s.expected_return_pct}%` : ''}`)}
                share_url="https://gtavi.ai/database"
              />
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Franchise placeholder -->
    <div id="db-section-franchise" class="hidden">
      <div class="rounded-xl border border-[#1e1e23] p-8 text-center" style="background:#131316">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">// Franchise Database</div>
        <div class="font-semibold text-zinc-300 mb-2" style="font-family:'Inter',sans-serif">GTA III · Vice City · San Andreas · GTA IV</div>
        <p class="text-[11px] text-zinc-600 max-w-md mx-auto" style="font-family:'Inter',sans-serif">
          Historical franchise economic data coming soon. GTA V and Online are the reference model — franchise titles will follow the same profile card schema.
        </p>
      </div>
    </div>

    <!-- No results -->
    <div id="db-empty" class="hidden py-16 text-center">
      <div class="text-zinc-600 font-mono text-sm">No results match the current filters.</div>
    </div>

    <!-- Source note -->
    <div class="mt-8 border border-[#1e1e23] rounded-xl p-4" style="background:#131316">
      <div id="source-note-gta6">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// Source Standard — GTA VI</div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-3">
          {(Object.entries(TIER_META) as [string, typeof TIER_META[keyof typeof TIER_META]][]).map(([key, meta]) => (
            <div class="flex items-start gap-2">
              <span class={`shrink-0 text-[8px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest mt-0.5 ${meta.badge} ${meta.color}`}>{meta.label}</span>
              <p class="text-[11px] text-zinc-600 leading-relaxed" style="font-family:'Inter',sans-serif">
                {key === "confirmed" && "Rockstar official material — trailers, press kit, official statements."}
                {key === "reported" && "Credible community sources — trailer analysis, GTA Fandom Wiki entries with citations."}
                {key === "indexed" && "Listed on wiki or community databases — confidence not individually assessed."}
              </p>
            </div>
          ))}
        </div>
        <p class="text-[10px] text-zinc-700 font-mono">
          GTA VI entities from GTA Fandom Wiki (gta.fandom.com) + Leonida Intel (leonida-intel.com). Not affiliated with Rockstar Games.
        </p>
      </div>
      <div id="source-note-gta5" class="hidden">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// Source Standard — GTA V</div>
        <p class="text-[11px] text-zinc-600 leading-relaxed mb-2" style="font-family:'Inter',sans-serif">
          Vehicle lap times and top speed data from <strong class="text-zinc-400">Broughy1322's Comprehensive Vehicle List</strong> — the definitive community performance benchmark for GTA V Online vehicles. Lap times recorded on the Broughy Test Track, a standard oval circuit. HSW = Hao's Special Works upgrades.
        </p>
        <p class="text-[10px] text-zinc-700 font-mono">
          Source: Broughy1322 Google Sheet (sheet ID via BROUGHY_SHEET_ID). Updated nightly. Not affiliated with Broughy1322 or Rockstar Games.
        </p>
      </div>
    </div>

    <CrossLinks context="database" class="mt-8" />
  </div>
</Base>

<script>
  // ── Shared types ──────────────────────────────────────────────────────────
  interface Gta6Entity {
    name: string; type: string; confidence_tier: string;
    source_id: string; source_label: string;
    franchise_debut?: string; url?: string; image_url?: string | null;
  }
  interface Gta5Vehicle {
    name: string; class: string; tier: string | null;
    lap_time: string | null; lap_seconds: number | null; top_speed_mph: number | null;
  }

  // ── Constants ─────────────────────────────────────────────────────────────
  const TIER_META: Record<string,{badge:string;color:string;label:string}> = {
    confirmed: { label:"Confirmed", color:"text-gta-gold",  badge:"bg-gta-gold/10 border-gta-gold/25"  },
    reported:  { label:"Reported",  color:"text-zinc-300",  badge:"bg-zinc-800 border-zinc-700"        },
    indexed:   { label:"Indexed",   color:"text-zinc-600",  badge:"bg-zinc-900 border-zinc-800"        },
  };
  const TYPE_ICON: Record<string,string> = {
    vehicle:"🚗", character:"👤", weapon:"🔫", business:"🏢",
    animal:"🐊", location:"📍", mission:"🎯", activity:"🎮", property:"🏠", radio:"📻",
  };
  const SOURCE_STYLE: Record<string,string> = {
    fandom:  "text-zinc-500 border-zinc-800 bg-zinc-900/50",
    leonida: "text-gta-teal border-gta-teal/20 bg-gta-teal/5",
  };

  const PAGE_SIZE = 100;

  // ── Elements ──────────────────────────────────────────────────────────────
  const gridGta6   = document.getElementById("db-grid-gta6")!;
  const gridGta5   = document.getElementById("db-grid-gta5")!;
  const countEl    = document.getElementById("db-count")!;
  const emptyEl    = document.getElementById("db-empty")!;
  const srcLabel   = document.getElementById("db-source-label")!;
  const filtersGta6 = document.getElementById("filters-gta6")!;
  const filtersGta5 = document.getElementById("filters-gta5")!;
  const headerGta6  = document.getElementById("header-gta6")!;
  const headerGta5  = document.getElementById("header-gta5")!;
  const noteGta6    = document.getElementById("source-note-gta6")!;
  const noteGta5    = document.getElementById("source-note-gta5")!;
  const searchGta6  = document.getElementById("db-search-gta6") as HTMLInputElement;
  const searchGta5  = document.getElementById("db-search-gta5") as HTMLInputElement;

  // ── State ─────────────────────────────────────────────────────────────────
  let activeGame    = "gta-6";
  let activeType    = "all";
  let activeTiers   = new Set(["confirmed","reported","indexed"]);
  let activeSource  = "all";
  let gta6Search    = "";
  let activeClass   = "all";
  let activeSort    = "lap";
  let gta5Search    = "";
  let currentPage   = 0;

  const allGta6: Gta6Entity[] = JSON.parse(gridGta6.dataset.entities || "[]");
  const allGta5: Gta5Vehicle[] = JSON.parse(gridGta5.dataset.vehicles || "[]");

  // ── Press screenshot mapping ──────────────────────────────────────────────
  const PRESS_CHARS: Record<string,string> = {
    "Lucia Caminos":  "/assets/gta6/characters/Lucia_Caminos_01.jpg",
    "Jason Duval":    "/assets/gta6/characters/Jason_Duval_01.jpg",
    "Raul Bautista":  "/assets/gta6/characters/Raul_Bautista_01.jpg",
    "Boobie Ike":     "/assets/gta6/characters/Boobie_Ike_01.jpg",
    "Brian Heder":    "/assets/gta6/characters/Brian_Heder_01.jpg",
    "Cal Hampton":    "/assets/gta6/characters/Cal_Hampton_01.jpg",
    "DreQuan Priest": "/assets/gta6/characters/DreQuan_Priest_01.jpg",
    "Real Dimez":     "/assets/gta6/characters/Real_Dimez_01.jpg",
  };
  const PRESS_LOCS: Record<string,string> = {
    "Vice City":      "/assets/gta6/locations/Vice_City_01.jpg",
    "Ambrosia":       "/assets/gta6/locations/Ambrosia_01.jpg",
    "Grassrivers":    "/assets/gta6/locations/Grassrivers_01.jpg",
    "Leonida Keys":   "/assets/gta6/locations/Leonida_Keys_01.jpg",
    "Port Gellhorn":  "/assets/gta6/locations/Port_Gellhorn_01.jpg",
    "Mount Kalaga National Park": "/assets/gta6/locations/Mount_Kalaga_National_Park_01.jpg",
  };

  // ── Card builders ─────────────────────────────────────────────────────────
  function buildGta6Card(e: Gta6Entity): string {
    const meta = TIER_META[e.confidence_tier] ?? TIER_META.indexed;
    const icon = TYPE_ICON[e.type] ?? "•";
    const srcStyle = SOURCE_STYLE[e.source_id] ?? "text-zinc-600 border-zinc-800";
    const debut = (e.franchise_debut && e.franchise_debut !== "gta-6")
      ? `<span class="text-[9px] font-mono text-zinc-700">debut ${e.franchise_debut}</span>`
      : "";
    const link = e.url
      ? `href="${e.url}" target="_blank" rel="noopener noreferrer"`
      : "";
    const tag = e.url ? "a" : "div";

    // Press screenshots take priority; fall back to wiki thumbnails for vehicles/weapons/characters
    const pressImg = e.type === "character" ? PRESS_CHARS[e.name]
                   : e.type === "location"  ? PRESS_LOCS[e.name]
                   : null;
    const wikiImg  = !pressImg && e.image_url ? e.image_url : null;
    const thumbImg = pressImg ?? wikiImg;

    if (thumbImg) {
      const isPress = !!pressImg;
      const aspectClass = e.type === "character" && isPress ? "aspect-[3/4]" : "aspect-video";
      const imgPos = e.type === "character" && isPress ? "object-top" : "object-center";
      const hoverBorder = isPress ? "hover:border-gta-gold/30" : "hover:border-[#2a2a31]";
      return `
        <${tag} ${link} class="rounded-lg border border-[#1e1e23] ${hoverBorder} transition-all duration-300 group overflow-hidden" style="background:#131316">
          <div class="relative ${aspectClass} overflow-hidden bg-[#0a0a0d]">
            <img src="${thumbImg}" alt="${e.name}" class="w-full h-full object-cover ${imgPos} transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0" style="background:linear-gradient(to top,#0e0e11 0%,#0e0e1170 35%,transparent 60%)"></div>
            <div class="absolute top-2 right-2">
              <span class="text-[7px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${meta.badge} ${meta.color}">${meta.label}</span>
            </div>
          </div>
          <div class="px-3 py-2.5">
            <div class="text-xs font-semibold text-zinc-200 leading-snug group-hover:text-white transition-colors mb-1" style="font-family:'Inter',sans-serif">${e.name}</div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-[10px] font-mono text-zinc-600">${icon} ${e.type}</span>
              <span class="text-[8px] font-mono border px-1 py-0.5 rounded ${srcStyle}">${e.source_label}</span>
            </div>
          </div>
        </${tag}>`;
    }

    return `
      <${tag} ${link} class="rounded-lg border border-[#1e1e23] p-3 hover:border-[#2a2a31] transition-colors group" style="background:#131316">
        <div class="flex items-start justify-between gap-2 mb-1.5">
          <span class="text-xs font-semibold text-zinc-200 leading-snug group-hover:text-white transition-colors" style="font-family:'Inter',sans-serif">${e.name}</span>
          <span class="shrink-0 text-[8px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${meta.badge} ${meta.color}">${meta.label}</span>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-[10px] font-mono text-zinc-600">${icon} ${e.type}</span>
          ${debut}
          <span class="text-[8px] font-mono border px-1 py-0.5 rounded ${srcStyle}">${e.source_label}</span>
        </div>
      </${tag}>`;
  }

  function buildGta5Card(v: Gta5Vehicle, rank: number): string {
    const speedBar = v.top_speed_mph
      ? `<div class="h-1 rounded-full bg-gta-gold/20 mt-1.5"><div class="h-1 rounded-full bg-gta-gold/50" style="width:${Math.min(100, Math.round(v.top_speed_mph / 180 * 100))}%"></div></div>`
      : "";
    const tierBadge = v.tier
      ? `<span class="text-[9px] font-mono text-zinc-600 border border-zinc-800 px-1.5 py-0.5 rounded">${v.tier}</span>`
      : "";
    return `
      <div class="rounded-lg border border-[#1e1e23] p-3 hover:border-[#2a2a31] transition-colors group" style="background:#131316">
        <div class="flex items-start justify-between gap-2 mb-1.5">
          <span class="text-xs font-semibold text-zinc-200 leading-snug group-hover:text-white transition-colors" style="font-family:'Inter',sans-serif">${v.name}</span>
          ${tierBadge}
        </div>
        <div class="flex items-center gap-2 flex-wrap mb-1.5">
          <span class="text-[10px] font-mono text-zinc-600">🚗 ${v.class}</span>
        </div>
        <div class="flex items-center gap-3 text-[10px] font-mono">
          ${v.lap_time ? `<span class="text-zinc-400">⏱ ${v.lap_time}</span>` : ""}
          ${v.top_speed_mph ? `<span class="text-gta-gold">${v.top_speed_mph} mph</span>` : ""}
        </div>
        ${speedBar}
      </div>`;
  }

  // ── Pagination helper ─────────────────────────────────────────────────────
  function renderPager(total: number, targetGrid: HTMLElement) {
    const existing = document.getElementById("db-pager");
    if (existing) existing.remove();
    const totalPages = Math.ceil(total / PAGE_SIZE);
    if (totalPages <= 1) return;
    const pager = document.createElement("div");
    pager.id = "db-pager";
    pager.className = "flex justify-center gap-2 mt-6";
    for (let i = 0; i < totalPages; i++) {
      const btn = document.createElement("button");
      btn.textContent = String(i + 1);
      btn.className = `px-3 py-1.5 rounded text-[10px] font-mono border transition-all ${i === currentPage ? "border-gta-gold/40 text-gta-gold bg-gta-gold/8" : "border-[#2a2a31] text-zinc-500 hover:text-zinc-300"}`;
      btn.onclick = () => { currentPage = i; renderActive(); window.scrollTo(0, 300); };
      pager.appendChild(btn);
    }
    targetGrid.after(pager);
  }

  // ── GTA VI render ─────────────────────────────────────────────────────────
  function renderGta6() {
    const filtered = allGta6.filter(e => {
      if (activeType !== "all" && e.type !== activeType) return false;
      if (!activeTiers.has(e.confidence_tier)) return false;
      if (activeSource !== "all" && e.source_id !== activeSource) return false;
      if (gta6Search && !e.name.toLowerCase().includes(gta6Search)) return false;
      return true;
    });
    const page = filtered.slice(currentPage * PAGE_SIZE, (currentPage + 1) * PAGE_SIZE);
    gridGta6.innerHTML = page.map(buildGta6Card).join("");
    countEl.textContent = `${filtered.length} entities`;
    emptyEl.classList.toggle("hidden", filtered.length > 0);
    renderPager(filtered.length, gridGta6);
  }

  // ── GTA V render ──────────────────────────────────────────────────────────
  function renderGta5() {
    let filtered = allGta5.filter(v => {
      const baseClass = v.class.replace(/ \(NR\)$/, "");
      if (activeClass !== "all" && baseClass !== activeClass) return false;
      if (gta5Search && !v.name.toLowerCase().includes(gta5Search)) return false;
      return true;
    });
    if (activeSort === "lap") {
      filtered = filtered.sort((a, b) => (a.lap_seconds ?? 999) - (b.lap_seconds ?? 999));
    } else {
      filtered = filtered.sort((a, b) => (b.top_speed_mph ?? 0) - (a.top_speed_mph ?? 0));
    }
    const page = filtered.slice(currentPage * PAGE_SIZE, (currentPage + 1) * PAGE_SIZE);
    gridGta5.innerHTML = page.map((v, i) => buildGta5Card(v, currentPage * PAGE_SIZE + i + 1)).join("");
    countEl.textContent = `${filtered.length} vehicles`;
    emptyEl.classList.toggle("hidden", filtered.length > 0);
    renderPager(filtered.length, gridGta5);
  }

  function renderActive() {
    if (activeGame === "gta-6") renderGta6();
    else renderGta5();
  }

  // ── Game tab toggle ───────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".db-game-tab").forEach(btn => {
    btn.addEventListener("click", () => {
      activeGame = btn.dataset.game!;
      currentPage = 0;

      const isGta6    = activeGame === "gta-6";
      const isOnline  = activeGame === "gta-online";
      const isGta5Eco = activeGame === "gta-5";
      const isFranchise = activeGame === "franchise";

      // Grid / pane visibility
      gridGta6.classList.toggle("hidden", !isGta6);
      gridGta5.classList.toggle("hidden",  !isGta5Eco || isOnline || isFranchise);
      document.getElementById("db-section-online")?.classList.toggle("hidden", !isOnline);
      document.getElementById("db-section-gta5eco")?.classList.toggle("hidden", !isGta5Eco);
      document.getElementById("db-section-franchise")?.classList.toggle("hidden", !isFranchise);

      // GTA V vehicles grid: show only when gta-5 tab is active (vehicles sub-tab)
      // For gta-5 tab we show the economy section, not vehicles grid
      gridGta5.classList.add("hidden");

      // Filter bars
      filtersGta6.classList.toggle("hidden", !isGta6);
      filtersGta5.classList.toggle("hidden", true); // always hide vehicle filters — economy section has own filters

      // Headers
      headerGta6.classList.toggle("hidden", !isGta6);
      headerGta5.classList.toggle("hidden", isGta6 || isOnline || isFranchise);

      // Source notes
      noteGta6.classList.toggle("hidden", !isGta6);
      noteGta5.classList.toggle("hidden", isGta6);

      // Count label
      const labels: Record<string,string> = {
        "gta-6": "GTA VI · Fandom Wiki + Leonida Intel",
        "gta-online": "GTA Online · Economic Intelligence",
        "gta-5": "GTA V · Story + Heists + Stocks",
        "franchise": "Franchise · Historical data",
      };
      srcLabel.textContent = labels[activeGame] ?? "";

      // Tab button styles
      document.querySelectorAll<HTMLButtonElement>(".db-game-tab").forEach(b => {
        const active = b.dataset.game === activeGame;
        b.className = active
          ? "db-game-tab px-4 py-2 rounded-lg text-sm font-mono border border-gta-gold/40 text-gta-gold bg-gta-gold/8 transition-all"
          : "db-game-tab px-4 py-2 rounded-lg text-sm font-mono border border-[#2a2a31] text-zinc-500 hover:text-zinc-300 hover:border-zinc-600 transition-all";
      });

      document.getElementById("db-pager")?.remove();
      if (isGta6) renderActive();
    });
  });

  // ── GTA VI type filter ────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".db-type-filter").forEach(btn => {
    btn.addEventListener("click", () => {
      activeType = btn.dataset.type!;
      currentPage = 0;
      document.querySelectorAll<HTMLButtonElement>(".db-type-filter").forEach(b => {
        const active = b.dataset.type === activeType;
        b.className = b.className
          .replace(/border-gta-gold\/40|text-gta-gold|bg-gta-gold\/8/g, "")
          .replace(/border-\[#2a2a31\]|text-zinc-500/g, "").trim();
        b.classList.add(...(active
          ? ["border-gta-gold/40","text-gta-gold","bg-gta-gold/8"]
          : ["border-[#2a2a31]","text-zinc-500"]));
      });
      renderGta6();
    });
  });

  // ── GTA VI tier filter ────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".db-tier-filter").forEach(btn => {
    btn.addEventListener("click", () => {
      const tier = btn.dataset.tier!;
      const active = btn.dataset.active === "true";
      btn.dataset.active = active ? "false" : "true";
      btn.style.opacity = active ? "0.35" : "1";
      if (active) activeTiers.delete(tier); else activeTiers.add(tier);
      currentPage = 0;
      renderGta6();
    });
  });

  // ── GTA VI source filter ──────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".db-source-filter").forEach(btn => {
    btn.addEventListener("click", () => {
      activeSource = btn.dataset.source!;
      currentPage = 0;
      document.querySelectorAll<HTMLButtonElement>(".db-source-filter").forEach(b => {
        const active = b.dataset.source === activeSource;
        b.className = b.className
          .replace(/border-gta-gold\/40|text-gta-gold|bg-gta-gold\/8/g, "")
          .replace(/border-\[#2a2a31\]|text-zinc-500/g, "").trim();
        b.classList.add(...(active
          ? ["border-gta-gold/40","text-gta-gold","bg-gta-gold/8"]
          : ["border-[#2a2a31]","text-zinc-500"]));
      });
      renderGta6();
    });
  });

  // ── GTA VI search ─────────────────────────────────────────────────────────
  searchGta6?.addEventListener("input", () => {
    gta6Search = searchGta6.value.toLowerCase().trim();
    currentPage = 0;
    renderGta6();
  });

  // ── GTA V class filter ────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".v5-class-filter").forEach(btn => {
    btn.addEventListener("click", () => {
      activeClass = btn.dataset.class!;
      currentPage = 0;
      document.querySelectorAll<HTMLButtonElement>(".v5-class-filter").forEach(b => {
        const active = b.dataset.class === activeClass;
        b.className = b.className
          .replace(/border-gta-gold\/40|text-gta-gold|bg-gta-gold\/8/g, "")
          .replace(/border-\[#2a2a31\]|text-zinc-500/g, "").trim();
        b.classList.add(...(active
          ? ["border-gta-gold/40","text-gta-gold","bg-gta-gold/8"]
          : ["border-[#2a2a31]","text-zinc-500"]));
      });
      renderGta5();
    });
  });

  // ── GTA V sort ────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".v5-sort-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      activeSort = btn.dataset.sort!;
      currentPage = 0;
      document.querySelectorAll<HTMLButtonElement>(".v5-sort-btn").forEach(b => {
        const active = b.dataset.sort === activeSort;
        b.className = b.className
          .replace(/border-gta-gold\/40|text-gta-gold|bg-gta-gold\/8/g, "")
          .replace(/border-\[#2a2a31\]|text-zinc-500/g, "").trim();
        b.classList.add(...(active
          ? ["border-gta-gold/40","text-gta-gold","bg-gta-gold/8"]
          : ["border-[#2a2a31]","text-zinc-500"]));
      });
      renderGta5();
    });
  });

  // ── GTA V search ──────────────────────────────────────────────────────────
  searchGta5?.addEventListener("input", () => {
    gta5Search = searchGta5.value.toLowerCase().trim();
    currentPage = 0;
    renderGta5();
  });

  // ── Initial render ────────────────────────────────────────────────────────
  renderGta6();
</script>
