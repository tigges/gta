---
import Base from "../layouts/Base.astro";
import PredictionCard from "../components/PredictionCard.astro";
import ReleaseTimeline from "../components/ReleaseTimeline.astro";

import predictionsData from "../../data/gta-6/predictions.json";
import trailersData    from "../../data/gta-6/trailers.json";
import releaseData     from "../../data/shared/releases.json";
import gta6Trends      from "../../data/gta-6/trends/search-interest.json";

const predictions  = predictionsData.predictions;
const trailers     = (trailersData as any).trailers ?? [];
const latestTrailer = trailers[0] ?? null;
const trendsSince  = gta6Trends.keywords[0]?.data[0]?.date?.slice(0, 4) ?? "2020";
const trendsUntil  = gta6Trends.keywords[0]?.data.at(-1)?.date?.slice(0, 4) ?? "2026";
const totalTrendPts = gta6Trends.keywords.reduce((s: number, k: any) => s + k.data.length, 0);
---

<Base
  title="GTA VI"
  description="Data-extrapolated predictions for GTA VI — release window, pricing, map size and vehicle count based on 30 years of GTA history."
>

  <!-- Page header -->
  <section class="border-b border-zinc-800 bg-zinc-950/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center gap-3 mb-5">
        <span class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 rounded-full px-3 py-1">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
          <span class="text-xs font-mono text-amber-500 uppercase tracking-wider">Community estimates · not official</span>
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold font-mono text-zinc-50 mb-3">
        Grand Theft Auto VI
      </h1>
      <p class="text-zinc-400 max-w-xl leading-relaxed text-sm mb-6">
        Extrapolated from 30 years of GTA data. Every prediction has a confidence score
        derived from data signal strength — not wishful thinking.
      </p>
      {latestTrailer && (
        <a
          href={`https://www.youtube.com/watch?v=${latestTrailer.youtube_id}`}
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-zinc-700 hover:border-zinc-500 text-zinc-300 font-mono text-sm px-5 py-2.5 rounded-lg transition-colors"
        >
          ▶ {latestTrailer.title ?? "Watch latest trailer"}
        </a>
      )}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">

    <!-- Predictions -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
        <span class="text-xs font-mono text-zinc-600 uppercase tracking-widest">Key Predictions</span>
        <div class="flex-1 h-px bg-zinc-800"></div>
        <span class="text-xs font-mono text-zinc-700">confidence-scored · not official</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {predictions.map((p) => (
          <PredictionCard
            title={p.title}
            value={p.value}
            confidence={p.confidence}
            basis={p.basis}
            unit={p.unit ?? undefined}
            trailerTimestamp={p.trailer_timestamp ?? undefined}
          />
        ))}
      </div>
    </section>

    <!-- Trailers -->
    {trailers.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-6">
          <span class="w-2 h-2 rounded-full bg-red-500 shrink-0"></span>
          <span class="text-xs font-mono text-zinc-600 uppercase tracking-widest">Official Trailers</span>
          <div class="flex-1 h-px bg-zinc-800"></div>
          <span class="text-xs font-mono text-zinc-700">{trailers.length} released</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {trailers.map((t: any, i: number) => (
            <a
              href={`https://www.youtube.com/watch?v=${t.youtube_id}`}
              target="_blank" rel="noopener noreferrer"
              class="group bg-zinc-900 border border-zinc-800 hover:border-zinc-600 rounded-xl p-5 flex items-start gap-4 transition-colors"
            >
              <div class="shrink-0 w-10 h-10 rounded-lg bg-zinc-800 border border-zinc-700 flex items-center justify-center text-zinc-400 group-hover:text-amber-400 group-hover:border-amber-500/40 transition-colors">
                ▶
              </div>
              <div class="min-w-0">
                <div class="font-mono font-semibold text-zinc-200 text-sm group-hover:text-amber-400 transition-colors">
                  {t.title ?? `Trailer ${i + 1}`}
                </div>
                {t.published_at && (
                  <div class="text-xs font-mono text-zinc-600 mt-1">{t.published_at}</div>
                )}
                <div class="text-xs font-mono text-zinc-700 mt-0.5 truncate">{t.youtube_id}</div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Search trends (GTA VI specific) -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
        <span class="text-xs font-mono text-zinc-600 uppercase tracking-widest">GTA VI Search Trends</span>
        <div class="flex-1 h-px bg-zinc-800"></div>
        <span class="text-xs font-mono text-zinc-700">{totalTrendPts} pts · {trendsSince}–{trendsUntil} · worldwide</span>
      </div>
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
        <div class="flex items-start justify-between flex-wrap gap-3 mb-4">
          <div>
            <h3 class="font-mono font-semibold text-zinc-50 text-sm uppercase tracking-wider">
              GTA VI — Search Interest Over Time
            </h3>
            <p class="text-xs text-zinc-500 mt-0.5">Google Trends · worldwide (0–100 scale)</p>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            {gta6Trends.keywords.map((kw) => (
              <button
                class="gta6-trend-toggle flex items-center gap-1.5 text-xs font-mono text-zinc-400 hover:text-zinc-200 transition-colors"
                data-keyword={kw.keyword}
                data-active="true"
              >
                <span class="w-3 h-0.5 rounded inline-block" style={`background:${kw.color}`}></span>
                {kw.keyword}
              </button>
            ))}
          </div>
        </div>
        <div
          id="gta6-trends-chart"
          class="w-full h-64"
          data-keywords={JSON.stringify(gta6Trends.keywords)}
        ></div>
        <p class="text-xs text-zinc-700 font-mono mt-3">
          Source: Google Trends via pytrends · Updated {new Date(gta6Trends.last_updated).toLocaleDateString("en-GB", { month: "short", year: "numeric" })}
        </p>
      </div>
    </section>

    <!-- Release context -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-2 h-2 rounded-full bg-zinc-500 shrink-0"></span>
        <span class="text-xs font-mono text-zinc-600 uppercase tracking-widest">Historical Context</span>
        <div class="flex-1 h-px bg-zinc-800"></div>
        <span class="text-xs font-mono text-zinc-700">gap trend extrapolated to VI</span>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <ReleaseTimeline />

        <!-- Cross-gen table -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
          <h3 class="font-mono font-semibold text-zinc-50 text-sm uppercase tracking-wider mb-4">
            Cross-Generation Growth
          </h3>
          <table class="w-full text-xs font-mono">
            <thead>
              <tr class="border-b border-zinc-800">
                <th class="text-left pb-2 text-zinc-600 font-normal">Title</th>
                <th class="text-right pb-2 text-zinc-600 font-normal">Price</th>
                <th class="text-right pb-2 text-zinc-600 font-normal">Map km²</th>
                <th class="text-right pb-2 text-zinc-600 font-normal">Vehicles</th>
              </tr>
            </thead>
            <tbody>
              {releaseData.games.map((g) => {
                const isPred = g.is_prediction;
                const price    = g.price_usd_launch    ?? (g as any).price_usd_estimate;
                const map      = g.map_size_km2        ?? (g as any).map_size_km2_estimate;
                const vehicles = g.vehicle_count       ?? (g as any).vehicle_count_estimate;
                return (
                  <tr class={`border-b border-zinc-800/50 ${isPred ? "text-amber-400" : "text-zinc-300"}`}>
                    <td class="py-2.5">
                      {g.short}{isPred && <span class="ml-1 text-amber-600">*</span>}
                    </td>
                    <td class="text-right py-2.5">
                      {price ? `$${price.toFixed(2)}` : <span class="text-zinc-700">—</span>}
                    </td>
                    <td class="text-right py-2.5">
                      {map ? `${map}${isPred ? "~" : ""}` : <span class="text-zinc-700">—</span>}
                    </td>
                    <td class="text-right py-2.5">
                      {vehicles ? `${vehicles}${isPred ? "~" : ""}` : <span class="text-zinc-700">—</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <p class="text-xs text-zinc-700 mt-4">* estimated · sources: Rockstar, Broughy1322, community records</p>
        </div>
      </div>
    </section>

    <!-- Methodology -->
    <section class="border border-zinc-800 rounded-xl p-6 bg-zinc-900/50">
      <h3 class="font-mono font-semibold text-zinc-300 text-sm mb-3 uppercase tracking-wider">Methodology</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs text-zinc-500 font-mono leading-relaxed">
        <div>
          <div class="text-zinc-400 mb-1">Confidence scoring</div>
          Confidence reflects how many independent signals agree. 80%+ = multiple corroborating
          data sources. Below 50% = trailer evidence only or high-variance extrapolation.
        </div>
        <div>
          <div class="text-zinc-400 mb-1">Data sources</div>
          Release dates from Rockstar official announcements. Pricing from CPI-adjusted history.
          Map/vehicle estimates from trailer analysis and community research.
          <a href="/gta-v" class="text-amber-600 hover:text-amber-500 transition-colors">GTA V signal data →</a>
        </div>
        <div>
          <div class="text-zinc-400 mb-1">Not official</div>
          All predictions are community-derived. This site has no affiliation with Rockstar Games
          or Take-Two Interactive. Treat every prediction as informed speculation.
        </div>
      </div>
    </section>

  </div>
</Base>

<script>
  import * as d3 from "d3";

  document.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById("gta6-trends-chart");
    if (!el) return;

    const keywords: { keyword: string; color: string; data: { date: string; value: number }[] }[] =
      JSON.parse(el.dataset.keywords || "[]");

    const allSeries = keywords.map((kw) => ({
      ...kw,
      data: kw.data.map((d) => ({ date: new Date(d.date), value: d.value })),
    }));

    const margin = { top: 10, right: 16, bottom: 32, left: 40 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg")
      .attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g")
      .attr("transform", `translate(${margin.left},${margin.top})`);

    const allDates = allSeries.flatMap((s) => s.data.map((d) => d.date));
    const x = d3.scaleTime().domain(d3.extent(allDates) as [Date, Date]).range([0, W]);
    const y = d3.scaleLinear().domain([0, 100]).range([H, 0]);

    svg.append("g")
      .call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(() => ""))
      .call((g) => g.select(".domain").remove())
      .call((g) => g.selectAll(".tick line").attr("stroke", "#27272a").attr("stroke-dasharray", "3,3"));

    const lineGen = d3.line<{ date: Date; value: number }>()
      .x((d) => x(d.date))
      .y((d) => y(d.value))
      .curve(d3.curveMonotoneX);

    const paths: Record<string, any> = {};
    allSeries.forEach((kw) => {
      paths[kw.keyword] = svg.append("path")
        .datum(kw.data)
        .attr("fill", "none")
        .attr("stroke", kw.color)
        .attr("stroke-width", 2)
        .attr("opacity", 0.9)
        .attr("d", lineGen as any);
    });

    // Trailer 1 annotation
    const t1Date = new Date("2023-12-04");
    svg.append("line")
      .attr("x1", x(t1Date)).attr("x2", x(t1Date))
      .attr("y1", 0).attr("y2", H)
      .attr("stroke", "#ef4444").attr("stroke-width", 1).attr("stroke-dasharray", "4,3").attr("opacity", 0.5);
    svg.append("text")
      .attr("x", x(t1Date) + 4).attr("y", 12)
      .attr("fill", "#ef4444").attr("font-size", "9").attr("font-family", "monospace")
      .text("T1");

    // Trailer 2 annotation
    const t2Date = new Date("2025-05-06");
    svg.append("line")
      .attr("x1", x(t2Date)).attr("x2", x(t2Date))
      .attr("y1", 0).attr("y2", H)
      .attr("stroke", "#ef4444").attr("stroke-width", 1).attr("stroke-dasharray", "4,3").attr("opacity", 0.5);
    svg.append("text")
      .attr("x", x(t2Date) + 4).attr("y", 12)
      .attr("fill", "#ef4444").attr("font-size", "9").attr("font-family", "monospace")
      .text("T2");

    svg.append("g")
      .attr("transform", `translate(0,${H})`)
      .call(d3.axisBottom(x).ticks(6).tickFormat(d3.timeFormat("%Y") as any))
      .call((g) => g.select(".domain").attr("stroke", "#3f3f46"))
      .call((g) => g.selectAll(".tick line").attr("stroke", "#3f3f46"))
      .call((g) => g.selectAll("text").attr("fill", "#71717a").attr("font-size", "11").attr("font-family", "monospace"));

    svg.append("g")
      .call(d3.axisLeft(y).ticks(5))
      .call((g) => g.select(".domain").attr("stroke", "#3f3f46"))
      .call((g) => g.selectAll(".tick line").attr("stroke", "#3f3f46"))
      .call((g) => g.selectAll("text").attr("fill", "#71717a").attr("font-size", "11").attr("font-family", "monospace"));

    document.querySelectorAll<HTMLButtonElement>(".gta6-trend-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const kw = btn.dataset.keyword!;
        const active = btn.dataset.active === "true";
        btn.dataset.active = active ? "false" : "true";
        btn.style.opacity = active ? "0.35" : "1";
        paths[kw]?.attr("opacity", active ? 0 : 0.9);
      });
    });
  });
</script>
