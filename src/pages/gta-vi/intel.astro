                            <div class="text-[10px] text-zinc-600 mt-0.5 leading-relaxed">{event.note}</div>
                          )}
                        </div>
                        <span class={`shrink-0 text-[10px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${confColor}`}>
                          {event.confidence}
                        </span>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

