---
import Base from "../../layouts/Base.astro";
import PredictionCard from "../../components/PredictionCard.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import Countdown from "../../components/Countdown.astro";
import ShareDropdown from "../../components/ShareDropdown.astro";

import type { TrailersData, Prediction } from "../../types/gta";
import IncomeCard from "../../components/IncomeCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CastCard from "../../components/CastCard.astro";

import ChartTeaserSearchSignal from "../../components/charts/ChartTeaserSearchSignal.astro";
import predictionsData from "../../../data/gta-6/predictions.json";
import incomeData from "../../../data/gta-6/income-predictions.json";
import trailersDataRaw from "../../../data/gta-6/trailers.json";
import featuresData    from "../../../data/gta-6/features.json";
import spotifyData     from "../../../data/franchise/spotify.json";

const predictions    = (predictionsData.predictions as Prediction[])
  .slice()
  .sort((a, b) => (a.display_order ?? 99) - (b.display_order ?? 99));
const trailersData   = trailersDataRaw as TrailersData;
const trailers       = trailersData.trailers;
const heroTrailer    = trailers[1] ?? trailers[0]; // prefer Trailer 2 for hero
const confirmedSongs = (spotifyData as any).confirmed_songs as { title: string; artist: string; trailer: string; year: number }[];

const PRED_THUMBS: Record<string,string> = {
  "pred-release-window":  "/assets/gta6/characters/Lucia_Caminos_05.jpg",
  "pred-launch-price":    "/assets/gta6/locations/Ambrosia_01.jpg",
  "pred-map-size":        "/assets/gta6/locations/Leonida_Keys_02.jpg",
  "pred-vehicles-launch": "/assets/gta6/locations/Port_Gellhorn_04.jpg",
};

const CAT_THUMBS: Record<string,string> = {
  regions:    "/assets/gta6/locations/Vice_City_06.jpg",
  vehicles:   "/assets/gta6/locations/Port_Gellhorn_03.jpg",
  characters: "/assets/gta6/characters/Lucia_Caminos_01.jpg",
  weapons:    "/assets/gta6/locations/Grassrivers_03.jpg",
  businesses: "/assets/gta6/locations/Ambrosia_02.jpg",
  activities: "/assets/gta6/locations/Leonida_Keys_01.jpg",
  wildlife:   "/assets/gta6/locations/Grassrivers_01.jpg",
  online:     "/assets/gta6/locations/Vice_City_03.jpg",
};

---

<Base
  title="Predictions"
  description="GTA VI predictions — confidence-scored from 30 years of GTA data. Launch price, income yields, Shark Card mechanics, and what the franchise numbers say about GTA VI's economy."
  ogPage="vi-intel"
>

  <!-- ═══════════════════════════════════════════════════════
       HERO — Split character backdrop + trailer anchor
  ═══════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden border-b border-border-dim" style="min-height:420px;display:flex;align-items:flex-end">
    <!-- Split character backgrounds -->
    <div class="absolute inset-0 flex">
      <div class="flex-1 relative overflow-hidden">
        <img src="/assets/gta6/characters/Lucia_Caminos_03.jpg" alt="Lucia Caminos"
          class="w-full h-full object-cover object-top" loading="eager" />
        <div class="absolute inset-0" style="background:linear-gradient(to right,#0e0e11 0%,transparent 35%,transparent 50%,#0e0e11 100%)"></div>
      </div>
      <div class="flex-1 relative overflow-hidden">
        <img src="/assets/gta6/characters/Jason_Duval_02.jpg" alt="Jason Duval"
          class="w-full h-full object-cover object-top" loading="eager" />
        <div class="absolute inset-0" style="background:linear-gradient(to left,#0e0e11 0%,transparent 35%,transparent 50%,#0e0e11 100%)"></div>
      </div>
    </div>
    <!-- Top/bottom fades -->
    <div class="absolute inset-0" style="background:linear-gradient(to bottom,#0e0e11 0%,transparent 20%,transparent 60%,#0e0e11 100%)"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pb-12 pt-20 w-full">
      <div class="flex items-end justify-between flex-wrap gap-6">
        <div class="max-w-lg">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[11px] font-mono bg-gta-gold/10 text-gta-gold border border-gta-gold/20 px-2 py-0.5 rounded uppercase tracking-widest">Community estimates · not official</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">
            Predictions & Insights
          </h1>
          <p class="text-zinc-400 text-sm max-w-sm leading-relaxed mb-5">
            Confidence-scored signals, not speculation.
            30 years of GTA data tracked and applied to what GTA VI's economy will look like.
          </p>
          <Countdown variant="hero" />
        </div>
        <!-- Latest trailer thumbnail card -->
        {heroTrailer && (
          <a href={`https://www.youtube.com/watch?v=${heroTrailer.youtube_id}`}
            target="_blank" rel="noopener noreferrer"
            class="group relative overflow-hidden rounded-xl border border-border-mid hover:border-gta-gold/40 transition-all shrink-0 hidden sm:block"
            style="width:240px">
            <img src={`https://img.youtube.com/vi/${heroTrailer.youtube_id}/mqdefault.jpg`}
              alt={heroTrailer.title}
              class="w-full object-cover transition-transform duration-500 group-hover:scale-105"
              style="height:135px" loading="eager" />
            <div class="absolute inset-0" style="background:linear-gradient(to top,#0e0e11 0%,transparent 55%)"></div>
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
              <div class="w-10 h-10 rounded-full bg-black/60 border border-gta-gold/30 flex items-center justify-center">
                <span class="text-white ml-0.5">▶</span>
              </div>
            </div>
            <div class="absolute top-2 left-2">
              <span class="text-[10px] font-mono bg-gta-gold/15 text-gta-gold border border-gta-gold/20 px-1.5 py-0.5 rounded uppercase tracking-widest">Official</span>
            </div>
            <div class="absolute bottom-0 left-0 right-0 px-3 pb-2.5">
              <div class="text-[10px] font-semibold text-white leading-tight">{heroTrailer.title}</div>
              {heroTrailer.published_at && <div class="text-[11px] font-mono text-zinc-500 mt-0.5">{heroTrailer.published_at}</div>}
            </div>
          </a>
        )}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-14">

    <!-- ═══════════════════════════════════════════════════════
         SIGNAL PREDICTIONS
    ═══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader label="// Economic Predictions" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {predictions.map((p) => {
          return (
            <PredictionCard
              id={p.id}
              title={p.title}
              value={p.value}
              confidence={p.confidence}
              confidence_tier={p.confidence_tier}
              basis={p.basis}
              unit={p.unit}
              trailer_timestamp={p.trailer_timestamp}
              prediction_method={p.prediction_method}
              prediction_range={p.prediction_range}
              source={p.source}
              source_type={p.source_type}
              outcome_verified={p.outcome_verified}
              outcome_actual={p.outcome_actual}
              thumbnail={(p as any).thumbnail ?? PRED_THUMBS[p.id] ?? null}
            />
          );
        })}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         INCOME PREDICTIONS — GTA VI Online
    ═══════════════════════════════════════════════════════ -->
    <section id="section-income-predictions" class="mt-16" style="scroll-margin-top:80px">
      <SectionHeader label="// GTA VI Online — Predicted Income Sources" dotColor="var(--c-title-vi)" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {(incomeData as any).income_predictions.map((p: any) => (
          <IncomeCard
            id={p.id}
            name={p.name}
            game="gta-vi"
            category={p.category}
            region={p.region}
            confidence_tier={p.confidence_tier}
            confidence_score={p.confidence_score}
            thumbnail={p.thumbnail}
            trailer_evidence={p.trailer_evidence}
            predicted_payout_per_run={p.predicted_payout_per_run}
            predicted_gta_per_hr={p.predicted_gta_per_hr}
            analogous_gta_online={p.analogous_gta_online}
            basis={p.basis}
            prediction_range={p.prediction_range}
          />
        ))}
      </div>
    </section>

    <CrossLinks context="vi-intel-predictions" />

    <!-- ═══════════════════════════════════════════════════════
         OFFICIAL TRAILERS
    ═══════════════════════════════════════════════════════ -->
    {trailers.length > 0 && (
      <section id="section-trailers">
        <SectionHeader label="// Official Trailers" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {trailers.map((t: any, i: number) => (
            <a
              href={`https://www.youtube.com/watch?v=${t.youtube_id}`}
              target="_blank" rel="noopener noreferrer"
              class="group relative overflow-hidden rounded-xl border border-border-dim hover:border-gta-gold/30 transition-all duration-200"
            >
              <div class="relative aspect-video overflow-hidden">
                <img
                  src={`https://img.youtube.com/vi/${t.youtube_id}/maxresdefault.jpg`}
                  alt={t.title ?? `GTA VI Trailer ${i + 1}`}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0" style="background:linear-gradient(to top, #0e0e11 0%, transparent 55%)"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-12 h-12 rounded-full bg-black/60 border border-white/20 flex items-center justify-center group-hover:bg-gta-gold/20 group-hover:border-gta-gold/40 transition-all">
                    <span class="text-white ml-0.5">▶</span>
                  </div>
                </div>
                <div class="absolute top-3 left-3">
                  <span class="text-[11px] font-mono bg-black/60 text-gta-gold border border-gta-gold/20 px-2 py-0.5 rounded uppercase tracking-widest">Official</span>
                </div>
              </div>
              <div class="px-4 py-3 flex items-center justify-between" style="background:var(--c-card)">
                <div>
                  <div class="font-semibold text-zinc-200 text-sm">{t.title ?? `Grand Theft Auto VI — Trailer ${i + 1}`}</div>
                  {t.published_at && (
                    <div class="text-[11px] text-zinc-600 font-mono mt-0.5">{t.published_at}</div>
                  )}
                </div>
                <span class="text-zinc-600 group-hover:text-gta-gold transition-colors font-mono text-xs">↗</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ═══════════════════════════════════════════════════════
         CONFIRMED CAST
    ═══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader label="// Confirmed Cast" />
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <CastCard name="Lucia Caminos"  role="Protagonist" img="Lucia_Caminos_01.jpg"  video="Lucia_Caminos_Video_Clip.mp4"  />
        <CastCard name="Jason Duval"    role="Protagonist" img="Jason_Duval_01.jpg"    video="Jason_Duval_Video_Clip.mp4"    />
        <CastCard name="Raul Bautista"  role="Supporting"  img="Raul_Bautista_01.jpg"  video="Raul_Bautista_Video_Clip.mp4"  />
        <CastCard name="Boobie Ike"     role="Supporting"  img="Boobie_Ike_01.jpg"     video="Boobie_Ike_Video_Clip.mp4"     />
        <CastCard name="Brian Heder"    role="Supporting"  img="Brian_Heder_01.jpg"    video="Brian_Heder_Video_Clip.mp4"    />
        <CastCard name="Cal Hampton"    role="Supporting"  img="Cal_Hampton_01.jpg"    video="Cal_Hampton_Video_Clip.mp4"    />
        <CastCard name="DreQuan Priest" role="Supporting"  img="DreQuan_Priest_01.jpg" video="DreQuan_Priest_Video_Clip.mp4" />
        <CastCard name="Real Dimez"     role="Supporting"  img="Real_Dimez_01.jpg"     video="Real_Dimez_Video_Clip.mp4"     />
      </div>
    </section>

    <CrossLinks context="vi-intel-cast" />

    <!-- ═══════════════════════════════════════════════════════
         LEONIDA — LOCATIONS
    ═══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader label="// Leonida — Confirmed Locations" dotColor="var(--c-live)" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {([
          { name: "Vice City",      desc: "Urban hub — streets, nightlife, coast",   img: "Vice_City_04.jpg",                  shots: 9  },
          { name: "Ambrosia",       desc: "Affluent waterfront district",             img: "Ambrosia_02.jpg",                   shots: 5  },
          { name: "Grassrivers",    desc: "Wetlands — Leonida Everglades analog",    img: "Grassrivers_02.jpg",                shots: 4  },
          { name: "Leonida Keys",   desc: "Island chain south of Vice City",          img: "Leonida_Keys_03.jpg",               shots: 5  },
          { name: "Port Gellhorn",  desc: "Industrial port district",                 img: "Port_Gellhorn_02.jpg",              shots: 5  },
          { name: "Mount Kalaga",   desc: "National park — mountainous interior",     img: "Mount_Kalaga_National_Park_03.jpg", shots: 6  },
        ] as const).map(loc => (
          <div class="group relative overflow-hidden rounded-xl border border-border-dim hover:border-gta-teal/30 transition-all duration-300 cursor-default">
            <div class="aspect-video overflow-hidden">
              <img
                src={`/assets/gta6/locations/${loc.img}`}
                alt={loc.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0" style="background:linear-gradient(to top, #0e0e11 0%, #0e0e1170 40%, transparent 70%)"></div>
            </div>
            <div class="absolute bottom-0 left-0 right-0 px-4 pb-4">
              <div class="flex items-center gap-2 mb-0.5">
                <span class="text-[10px] font-mono text-gta-teal border border-gta-teal/20 bg-gta-teal/10 px-1.5 py-0.5 rounded uppercase tracking-widest">Confirmed</span>
                <span class="text-[10px] font-mono text-zinc-500">{loc.shots} official shots</span>
              </div>
              <div class="text-sm font-bold text-white leading-tight">{loc.name}</div>
              <div class="text-[11px] text-zinc-400 mt-0.5">{loc.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <CrossLinks context="vi-intel-locations" />


    <!-- ═══════════════════════════════════════════════════════
         CONFIRMED FEATURE TRACKER
    ═══════════════════════════════════════════════════════ -->
    <section id="section-feature-tracker" style="scroll-margin-top:80px">
      <SectionHeader label="// GTA VI Confirmed Feature Tracker" dotColor="var(--c-live)" />
      <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <div class="px-5 py-4 border-b border-border-dim flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm">
              What's confirmed, reported and indexed so far
            </div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Progress toward estimated full-game totals · {featuresData.categories.reduce((s, c) => s + c.confirmed + c.reported, 0)} entries tracked</div>
          </div>
          <div class="flex items-center gap-4 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-gta-gold inline-block"></span>Confirmed</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-zinc-500 inline-block"></span>Reported</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-zinc-800 border border-zinc-700 inline-block"></span>Target</span>
          </div>
        </div>
        <!-- Visual category cards grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-0 divide-y lg:divide-y-0 lg:divide-x divide-border-dim">
          {featuresData.categories.map((cat) => {
            const confirmedPct = Math.round((cat.confirmed / cat.target) * 100);
            const reportedPct  = Math.round((cat.reported  / cat.target) * 100);
            const indexedPct   = Math.round((cat.indexed   / cat.target) * 100);
            const thumb = CAT_THUMBS[cat.id];
            return (
              <div class="relative group overflow-hidden">
                <!-- Background thumbnail -->
                {thumb && (
                  <div class="absolute inset-0">
                    <img src={thumb} alt="" class="w-full h-full object-cover opacity-20 group-hover:opacity-30 transition-opacity duration-500 group-hover:scale-105" loading="lazy" aria-hidden="true" />
                    <div class="absolute inset-0" style="background:linear-gradient(to bottom,#131316 0%,transparent 40%,#131316 100%)"></div>
                  </div>
                )}
                <div class="relative px-5 py-5">
                  <!-- Icon + label -->
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-xl">{cat.icon}</span>
                    <span class="text-sm font-bold text-zinc-200">{cat.label}</span>
                  </div>
                  <!-- Stats -->
                  <div class="flex items-baseline gap-1.5 mb-3">
                    <span class="text-2xl font-mono font-bold text-gta-gold">{cat.confirmed}</span>
                    <span class="text-[10px] font-mono text-zinc-600">confirmed</span>
                    <span class="text-zinc-500 mx-1">·</span>
                    <span class="text-base font-mono text-zinc-400">{cat.reported}</span>
                    <span class="text-[10px] font-mono text-zinc-600">reported</span>
                  </div>
                  <!-- Progress bar -->
                  <div class="h-1.5 rounded-full overflow-hidden flex" style="background:#1e1e23">
                    {confirmedPct > 0 && <div class="h-full bg-gta-gold" style={`width:${confirmedPct}%`}></div>}
                    {reportedPct  > 0 && <div class="h-full bg-zinc-500 ml-px" style={`width:${reportedPct}%`}></div>}
                    {indexedPct   > 0 && <div class="h-full bg-zinc-700 ml-px" style={`width:${indexedPct}%`}></div>}
                  </div>
                  <div class="flex items-center justify-between mt-1">
                    <span class="text-[11px] font-mono text-zinc-500">{confirmedPct}% of target</span>
                    <span class="text-[11px] font-mono text-zinc-500">/ {cat.target}</span>
                  </div>
                  {cat.notes && (
                    <p class="text-[10px] text-zinc-600 mt-2 leading-snug">{cat.notes}</p>
                  )}
                </div>
              </div>
            );
          })}
        </div>
        <div class="px-5 py-3 border-t border-border-dim flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-500 font-mono">Sources: {featuresData.source}</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareDropdown anchorId="feature-tracker" shareText={`GTA VI Feature Tracker: ${featuresData.categories.reduce((s, c) => s + c.confirmed + c.reported, 0)} entries tracked — vehicles, characters, locations, weapons and more confirmed so far.`} size="sm" /></div>
        </div>
      </div>
    </section>

    <CrossLinks context="vi-intel-features" />


    <!-- ═══════════════════════════════════════════════════════
         GTA VI CONFIRMED SOUNDTRACK — Trailer Songs
    ═══════════════════════════════════════════════════════ -->
    {confirmedSongs.length > 0 && (
    <section>
      <SectionHeader label="// Confirmed Soundtrack — Trailer Songs" dotColor="var(--c-growth)" />
      <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <div class="divide-y divide-border-dim">
          {confirmedSongs.map((song, i) => (
            <div class="px-5 py-4 flex items-center gap-4">
              <div class="w-7 h-7 rounded bg-[#1DB954]/10 border border-[#1DB954]/20 flex items-center justify-center shrink-0">
                <span class="text-[#1DB954] text-xs">♪</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-semibold text-zinc-200 leading-tight">{song.title}</div>
                <div class="text-[11px] font-mono text-zinc-500 mt-0.5">{song.artist} · {song.year}</div>
              </div>
              <div class="shrink-0 text-right">
                <span class="text-[11px] font-mono bg-gta-gold/10 text-gta-gold border border-gta-gold/20 px-2 py-0.5 rounded uppercase tracking-widest">{song.trailer}</span>
              </div>
            </div>
          ))}
        </div>
        <div class="px-5 py-3 border-t border-border-dim flex items-center justify-between">
          <span class="text-[10px] text-zinc-500 font-mono">Source: Spotify Web API · confirmed from official GTA VI trailers</span>
          <span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span>
        </div>
      </div>
    </section>
    )}

    <!-- ═══════════════════════════════════════════════════════
         GTA VI SEARCH TRENDS
    ═══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader label="// GTA VI Search Signal" dotColor="var(--c-title-vi)" />
      <ChartTeaserSearchSignal />
    </section>



  </div>
</Base>

