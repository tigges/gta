<script>
  import * as d3 from "d3";

  {
    const el = document.getElementById("gta6-trends-chart");
    if (!el) throw new Error("gta6-trends-chart element not found");

    const keywords: { keyword: string; color: string; data: { date: string; value: number }[] }[] =
      JSON.parse(el.dataset.keywords || "[]");

    const allSeries = keywords.map((kw) => ({
      ...kw,
      data: kw.data.map((d) => ({ date: new Date(d.date), value: d.value })),
    }));

    const margin = { top: 10, right: 16, bottom: 28, left: 36 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;

    const svg = d3.select(el).append("svg")
      .attr("width", "100%")
      .attr("viewBox", `0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g")
      .attr("transform", `translate(${margin.left},${margin.top})`);

    const allDates = allSeries.flatMap((s) => s.data.map((d) => d.date));
    const x = d3.scaleTime().domain(d3.extent(allDates) as [Date, Date]).range([0, W]);
    const y = d3.scaleLinear().domain([0, 100]).range([H, 0]);

    svg.append("g")
      .call(d3.axisLeft(y).ticks(4).tickSize(-W).tickFormat(() => ""))
      .call((g) => g.select(".domain").remove())
      .call((g) => g.selectAll(".tick line").attr("stroke", "#1e1e23").attr("stroke-dasharray", "3,3"));

    const lineGen = d3.line<{ date: Date; value: number }>()
      .x((d) => x(d.date)).y((d) => y(d.value)).curve(d3.curveMonotoneX);

    const paths: Record<string, any> = {};
    allSeries.forEach((kw) => {
      paths[kw.keyword] = svg.append("path")
        .datum(kw.data).attr("fill", "none").attr("stroke", kw.color)
        .attr("stroke-width", 1.5).attr("opacity", 0.9).attr("d", lineGen as any);
    });

    // Trailer annotations
    [
      { date: new Date("2023-12-04"), label: "T1" },
      { date: new Date("2025-05-06"), label: "T2" },
    ].forEach(({ date, label }) => {
      svg.append("line")
        .attr("x1", x(date)).attr("x2", x(date)).attr("y1", 0).attr("y2", H)
        .attr("stroke", "#ef4444").attr("stroke-width", 1).attr("stroke-dasharray", "3,3").attr("opacity", 0.4);
      svg.append("text")
        .attr("x", x(date) + 4).attr("y", 10)
        .attr("fill", "#ef4444").attr("font-size", "9").attr("font-family", "monospace").text(label);
    });

    svg.append("g").attr("transform", `translate(0,${H})`)
      .call(d3.axisBottom(x).ticks(5).tickFormat(d3.timeFormat("%Y") as any))
      .call((g) => g.select(".domain").attr("stroke", "#2a2a31"))
      .call((g) => g.selectAll(".tick line").attr("stroke", "#2a2a31"))
      .call((g) => g.selectAll("text").attr("fill", "#52525b").attr("font-size", "10").attr("font-family", "monospace"));

    svg.append("g").call(d3.axisLeft(y).ticks(4))
      .call((g) => g.select(".domain").attr("stroke", "#2a2a31"))
      .call((g) => g.selectAll(".tick line").attr("stroke", "#2a2a31"))
      .call((g) => g.selectAll("text").attr("fill", "#52525b").attr("font-size", "10").attr("font-family", "monospace"));

    document.querySelectorAll<HTMLButtonElement>(".gta6-trend-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const kw = btn.dataset.keyword!;
        const active = btn.dataset.active === "true";
        btn.dataset.active = active ? "false" : "true";
        btn.style.opacity = active ? "0.3" : "1";
        paths[kw]?.attr("opacity", active ? 0 : 0.9);
      });
    });
  }

  // ── Character card video hover ────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>(".char-card").forEach(card => {
    const video = card.querySelector<HTMLVideoElement>(".char-video");
    const still = card.querySelector<HTMLImageElement>(".char-still");
    if (!video) return;

    card.addEventListener("mouseenter", () => {
      video.src = card.dataset.video ?? "";
      video.load();
      video.play().catch(() => {});
      video.style.opacity = "1";
      if (still) still.style.opacity = "0";
    });
    card.addEventListener("mouseleave", () => {
      video.pause();
      video.style.opacity = "0";
      if (still) still.style.opacity = "1";
    });
  });
</script>
