---
/**
 * /gta-vi/intel/embed/[predId] — Embeddable prediction card iframe endpoint.
 *
 * Renders a single prediction card as a standalone minimal HTML page,
 * suitable for embedding via <iframe> on external sites (GTAForums, Reddit,
 * Discord announcements, partner sites, etc.).
 *
 * Usage:
 *   <iframe
 *     src="https://gtavi.ai/gta-vi/intel/embed/pred-launch-price"
 *     width="420" height="380" frameborder="0"
 *     style="border-radius:12px;overflow:hidden"
 *   ></iframe>
 *
 * Recommended width: 320px minimum, 480px maximum.
 * Height varies by content — 320px (no thumbnail) to 440px (with thumbnail + method).
 *
 * Static export — all 23 predictions are pre-rendered at build time.
 */

import "../../../../styles/tokens.css";
import type { GetStaticPaths } from "astro";
import predRaw from "../../../../../data/gta-6/predictions.json";

export const getStaticPaths: GetStaticPaths = () => {
  return (predRaw as any).predictions.map((p: any) => ({
    params: { predId: p.id },
  }));
};

const { predId } = Astro.params;
const pred = (predRaw as any).predictions.find((p: any) => p.id === predId);

if (!pred) return Astro.redirect("/404");

const SITE_BASE = import.meta.env.SITE ?? "https://gtavi.ai";
const fullUrl   = `${SITE_BASE}/gta-vi/intel#${pred.id}`;

const tier = pred.confidence_tier ?? "predicted";
const showRange =
  pred.prediction_range &&
  pred.prediction_range.low !== pred.prediction_range.high;

const valueFontSize =
  (pred.value ?? "").length > 36 ? "1rem"
  : (pred.value ?? "").length > 22 ? "1.25rem"
  : "1.75rem";

// Tier tokens (inline — no Tailwind in isolated iframe context)
const TIER: Record<string, { label: string; accent: string; barColor: string; badgeBg: string; badgeBorder: string }> = {
  confirmed: {
    label:       "CONFIRMED",
    accent:      "#22c55e",
    barColor:    "#22c55e",
    badgeBg:     "rgba(34,197,94,0.10)",
    badgeBorder: "rgba(34,197,94,0.40)",
  },
  reported: {
    label:       "REPORTED",
    accent:      "#f59e0b",
    barColor:    "#f59e0b",
    badgeBg:     "rgba(245,158,11,0.10)",
    badgeBorder: "rgba(245,158,11,0.40)",
  },
  predicted: {
    label:       "PREDICTED",
    accent:      "#b4b4cc",
    barColor:    "#71717a",
    badgeBg:     "rgba(113,113,122,0.15)",
    badgeBorder: "rgba(113,113,122,0.30)",
  },
};

const t = TIER[tier] ?? TIER.predicted;

const sourceColor =
  pred.source_type === "official"  ? "#22c55e"
  : pred.source_type === "reported"  ? "#f59e0b"
  : "#71717a";
---

<!doctype html>
<html lang="en" style="color-scheme:dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{pred.title} — GTAVI.AI Prediction</title>
  <meta http-equiv="X-Frame-Options" content="ALLOWALL" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

  <style>
    :root {
      --c-bg:        #0e0e11;
      --c-bg-deep:   #0a0a0d;
      --c-card:      #131316;
      --c-border-1:  #1e1e23;
      --c-border-2:  #2a2a31;
      --c-text-1:    #ebebef;
      --c-text-2:    #d4d4d8;
      --c-text-3:    #b8b8c4;
      --c-text-4:    #9898b8;
      --c-text-5:    #b4b4cc;
      --font-sans:   "Inter", system-ui, sans-serif;
      --font-mono:   "JetBrains Mono", "Fira Mono", monospace;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--c-bg);
      font-family: var(--font-sans);
      color: var(--c-text-3);
      min-height: 100%;
    }

    body { display: flex; align-items: flex-start; justify-content: center; }

    .pc-card {
      width: 100%;
      max-width: 480px;
      display: flex;
      flex-direction: column;
      background: var(--c-card);
      overflow: hidden;
    }

    /* ── Thumbnail ── */
    .pc-thumb {
      position: relative;
      height: 120px;
      overflow: hidden;
      flex-shrink: 0;
    }
    .pc-thumb img {
      width: 100%; height: 100%;
      object-fit: cover;
    }
    .pc-thumb-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 40%, #131316 100%);
    }
    .pc-thumb-pills {
      position: absolute; top: 0; left: 0; right: 0;
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 14px 0;
      z-index: 10;
    }

    /* ── Pill ── */
    .pc-game-pill {
      font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
      color: #f59e0b;
      border: 1px solid rgba(245,158,11,0.35);
      background: rgba(245,158,11,0.10);
      border-radius: 4px; padding: 2px 7px;
      font-family: var(--font-mono);
    }

    .pc-tier-badge {
      font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
      border-radius: 4px; padding: 2px 7px;
      font-family: var(--font-mono);
      white-space: nowrap;
    }

    /* ── Header row (no thumbnail) ── */
    .pc-header-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px 8px;
    }

    /* ── Body ── */
    .pc-body { padding: 8px 16px 12px; display: flex; flex-direction: column; gap: 10px; }

    .pc-title {
      font-size: 10px; font-weight: 700; text-transform: uppercase;
      letter-spacing: .18em; line-height: 1.4;
      color: var(--c-text-1);
      font-family: var(--font-mono);
    }

    .pc-value {
      font-weight: 700; font-family: var(--font-mono);
      color: #ffffff; line-height: 1.2;
    }

    .pc-unit {
      font-size: 10px; font-family: var(--font-mono);
      color: var(--c-text-4); line-height: 1.4;
      margin-top: -6px;
    }

    /* ── Confidence bar ── */
    .pc-conf-row {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 5px;
    }
    .pc-conf-label { font-size: 10px; font-family: var(--font-mono); color: var(--c-text-4); text-transform: uppercase; letter-spacing: .1em; }
    .pc-conf-value { font-size: 11px; font-weight: 700; font-family: var(--font-mono); }
    .pc-bar-track { height: 2px; border-radius: 2px; background: var(--c-border-1); }
    .pc-bar-fill  { height: 100%; border-radius: 2px; transition: width .7s ease; }

    /* ── Basis ── */
    .pc-basis { font-size: 11px; color: var(--c-text-4); line-height: 1.55; }

    /* ── Range ── */
    .pc-range { font-size: 10px; font-family: var(--font-mono); color: var(--c-text-4); }
    .pc-range span { color: var(--c-text-3); }

    /* ── Divider sections ── */
    .pc-section {
      border-top: 1px solid var(--c-border-1);
      padding: 10px 16px;
    }
    .pc-section-label {
      font-size: 10px; font-family: var(--font-mono); color: var(--c-text-4);
      text-transform: uppercase; letter-spacing: .1em; margin-bottom: 3px;
    }
    .pc-section-value { font-size: 10px; font-family: var(--font-mono); color: var(--c-text-5); line-height: 1.4; }

    /* ── Source row ── */
    .pc-source-row {
      border-top: 1px solid var(--c-border-1);
      padding: 8px 16px;
      display: flex; align-items: center; gap: 6px;
    }
    .pc-source-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .pc-source-text { font-size: 10px; font-family: var(--font-mono); color: var(--c-text-4); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ── Outcome strip ── */
    .pc-outcome {
      border-top: 1px solid rgba(34,197,94,0.3);
      padding: 8px 16px;
      background: rgba(34,197,94,0.06);
    }
    .pc-outcome-label { font-size: 10px; font-family: var(--font-mono); color: #22c55e; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 2px; }
    .pc-outcome-value { font-size: 11px; font-family: var(--font-mono); color: #22c55e; font-weight: 700; }

    /* ── Footer ── */
    .pc-footer {
      border-top: 1px solid var(--c-border-1);
      padding: 8px 16px;
      display: flex; align-items: center; justify-content: space-between;
      background: var(--c-card);
    }
    .pc-footer-label { font-size: 9px; font-family: var(--font-mono); color: var(--c-text-4); text-transform: uppercase; letter-spacing: .12em; transition: color .15s; }
    .pc-footer-label:hover { color: #f59e0b; }
    .pc-full-link {
      font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
      color: #f59e0b;
      text-decoration: none;
      border: 1px solid rgba(245,158,11,0.35);
      border-radius: 4px; padding: 3px 8px;
      font-family: var(--font-mono);
      transition: background .15s;
    }
    .pc-full-link:hover { background: rgba(245,158,11,0.10); }
  </style>
</head>
<body>

<div class="pc-card">

  <!-- Thumbnail (always present — all 23 predictions have one) -->
  {pred.thumbnail ? (
    <div class="pc-thumb">
      <img src={pred.thumbnail} alt="" loading="eager" />
      <div class="pc-thumb-overlay"></div>
      <div class="pc-thumb-pills">
        <span class="pc-game-pill">GTA VI</span>
        <span
          class="pc-tier-badge"
          style={`color:${t.accent};background:${t.badgeBg};border:1px solid ${t.badgeBorder}`}
        >{t.label}</span>
      </div>
    </div>
  ) : (
    <div class="pc-header-row">
      <span class="pc-game-pill">GTA VI</span>
      <span
        class="pc-tier-badge"
        style={`color:${t.accent};background:${t.badgeBg};border:1px solid ${t.badgeBorder}`}
      >{t.label}</span>
    </div>
  )}

  <!-- Body -->
  <div class="pc-body">

    <!-- Title -->
    <div class="pc-title">{pred.title}</div>

    <!-- Value -->
    <div class="pc-value" style={`font-size:${valueFontSize}`}>{pred.value}</div>

    <!-- Unit -->
    {pred.unit && <div class="pc-unit">{pred.unit}</div>}

    <!-- Confidence bar -->
    <div>
      <div class="pc-conf-row">
        <span class="pc-conf-label">Confidence</span>
        <span class="pc-conf-value" style={`color:${t.accent}`}>{pred.confidence}%</span>
      </div>
      <div class="pc-bar-track">
        <div class="pc-bar-fill" style={`width:${pred.confidence}%;background:${t.barColor}`}></div>
      </div>
    </div>

    <!-- Range -->
    {showRange && (
      <div class="pc-range">
        Range: <span>{pred.prediction_range.low}</span> – <span>{pred.prediction_range.high}</span>
      </div>
    )}

    <!-- Basis -->
    <div class="pc-basis">
      {pred.basis.length > 220 ? pred.basis.slice(0, 220) + "…" : pred.basis}
    </div>

  </div>

  <!-- Method -->
  {pred.prediction_method && (
    <div class="pc-section">
      <div class="pc-section-label">Method</div>
      <div class="pc-section-value">{pred.prediction_method}</div>
    </div>
  )}

  <!-- Trailer timestamp -->
  {pred.trailer_timestamp && (
    <div class="pc-section" style="padding-top:6px;padding-bottom:6px">
      <span class="pc-section-value">▶ {pred.trailer_timestamp}</span>
    </div>
  )}

  <!-- Source -->
  {pred.source && (
    <div class="pc-source-row">
      <div class="pc-source-dot" style={`background:${sourceColor}`}></div>
      <span class="pc-source-text">{pred.source}</span>
    </div>
  )}

  <!-- Outcome (if verified) -->
  {pred.outcome_verified && pred.outcome_actual && (
    <div class="pc-outcome">
      <div class="pc-outcome-label">Actual outcome</div>
      <div class="pc-outcome-value">{pred.outcome_actual}</div>
    </div>
  )}

  <!-- Footer -->
  <div class="pc-footer">
    <a href="https://gtavi.ai" target="_blank" rel="noopener noreferrer" class="pc-footer-label" style="text-decoration:none">GTAVI.AI</a>
    <a href={fullUrl} target="_blank" rel="noopener noreferrer" class="pc-full-link">
      Full analysis →
    </a>
  </div>

</div>

</body>
</html>
