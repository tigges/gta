<script define:vars={{ COUNTRIES }}>
(function() {
  // ── Detect locale and match to a country ──────────────────────────────
  const lang = (navigator.language || navigator.languages?.[0] || 'en-US').toLowerCase();

  function matchLocale(lang) {
    const prefixes = [
      { test: s => s.startsWith('en-us') || s === 'en', key: 'en-US' },
      { test: s => s.startsWith('en-gb') || s.startsWith('en-au') || s.startsWith('en-nz') || s.startsWith('en-ie'), key: s => s.startsWith('en-au') ? 'en-AU' : 'en-GB' },
      { test: s => s.startsWith('de'),   key: 'de' },
      { test: s => s.startsWith('fr'),   key: 'fr' },
      { test: s => s.startsWith('pt'),   key: 'pt' },
      { test: s => s.startsWith('ja'),   key: 'ja' },
      { test: s => s.startsWith('zh'),   key: 'zh' },
      { test: s => s.startsWith('en-au'),key: 'en-AU' },
    ];
    for (const p of prefixes) {
      if (p.test(lang)) return typeof p.key === 'function' ? p.key(lang) : p.key;
    }
    return 'en-US';
  }

  const detectedLocale = matchLocale(lang);

  // ── Activate correct country ───────────────────────────────────────────
  function setCountry(localePrefix) {
    // Store grids
    document.querySelectorAll('.country-stores').forEach(el => {
      el.classList.toggle('hidden', el.dataset.locale !== localePrefix);
    });
    // Buttons
    document.querySelectorAll('.country-btn').forEach(btn => {
      const active = btn.dataset.locale === localePrefix;
      btn.classList.toggle('border-gta-gold/40', active);
      btn.classList.toggle('bg-gta-gold/8', active);
      btn.classList.toggle('text-gta-gold', active);
      btn.classList.toggle('border-[#2a2a31]', !active);
      btn.classList.toggle('text-zinc-500', !active);
    });
    // Country label
    const country = COUNTRIES.find(c => c.localePrefix === localePrefix);
    const label = document.getElementById('country-label');
    if (country && label) {
      label.innerHTML = `${country.flag} Showing stores for <strong style="color:#a1a1aa">${country.name}</strong> · Prices in <strong style="color:#a1a1aa">${country.currency}</strong> · <span style="color:#3f3f46">Detected via browser locale · <button id="change-region" style="color:#f59e0b;cursor:pointer;background:none;border:none;font:inherit">Change</button></span>`;
      document.getElementById('change-region')?.addEventListener('click', () => {
        document.querySelector('.country-btn')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }
    // Edition prices: show local currency estimate
    const rate = country?.rate ?? 1;
    const symbol = country?.symbol ?? '$';
    document.querySelectorAll('[data-price-usd]').forEach(card => {
      const usd = parseFloat(card.dataset.priceUsd ?? '0');
      const local = (usd * rate).toFixed(0);
      const priceEl = card.querySelector('.edition-price-local');
      const noteEl = card.querySelector('.edition-price-note');
      if (priceEl && rate !== 1) {
        priceEl.textContent = `~${symbol}${local} ${country?.currency}`;
        priceEl.classList.remove('hidden');
      }
      if (noteEl && rate !== 1) noteEl.textContent = 'not announced · converted estimate';
    });
  }

  setCountry(detectedLocale);

  // ── Manual country buttons ─────────────────────────────────────────────
  document.querySelectorAll('.country-btn').forEach(btn => {
    btn.addEventListener('click', () => setCountry(btn.dataset.locale));
  });
})();
</script>
