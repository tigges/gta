      { name: "PlayStation Store", initials: "PS", logoBg: "#003087", type: "Digital · Official", platform: "PS5", url: "https://www.playstation.com/en-za/games/grand-theft-auto-vi/", color: "text-blue-400", border: "border-blue-500/20", status: "Pre-orders live" },
      { name: "Xbox Store",        initials: "XB", logoBg: "#107C10", type: "Digital · Official", platform: "Xbox", url: "https://www.xbox.com/en-ZA/games/store/grand-theft-auto-vi/9nl3wwnzlzzn", color: "text-green-400", border: "border-green-500/20", status: "Pre-orders live" },
      { name: "Takealot",          initials: "Tk", logoBg: "#0AA1DD", type: "Physical · Retailer", platform: "PS5 · Xbox", url: "https://www.takealot.com/all?qsearch=grand+theft+auto+vi", color: "text-blue-300", border: "border-blue-400/20", status: "Check for listings" },
      { name: "Amazon.co.za",      initials: "a",  logoBg: "#131921", type: "Physical · Retailer", platform: "PS5 · Xbox", url: "https://www.amazon.co.za/s?k=Grand+Theft+Auto+VI", color: "text-orange-400", border: "border-orange-500/20", status: "Pre-orders live" },
    ],
  },
  {
    locale: "zh-TW", localePrefix: "zh-TW", flag: "🇹🇼", short: "TW", name: "Taiwan",
    currency: "TWD", symbol: "NT$", rate: 32,
    stores: [
      { name: "PlayStation Store", initials: "PS", logoBg: "#003087", type: "Digital · Official", platform: "PS5", url: "https://www.playstation.com/zh-hant-tw/games/grand-theft-auto-vi/", color: "text-blue-400", border: "border-blue-500/20", status: "Pre-orders live" },
      { name: "Xbox Store",        initials: "XB", logoBg: "#107C10", type: "Digital · Official", platform: "Xbox", url: "https://www.xbox.com/zh-TW/games/store/grand-theft-auto-vi/9nl3wwnzlzzn", color: "text-green-400", border: "border-green-500/20", status: "Pre-orders live" },
      { name: "PChome",            initials: "PC", logoBg: "#E60012", type: "Physical · Retailer", platform: "PS5 · Xbox", url: "https://ecshweb.pchome.com.tw/search/v3.3/?q=grand+theft+auto+vi", color: "text-red-400", border: "border-red-500/20", status: "Check for listings" },
      { name: "momo",              initials: "mo", logoBg: "#E5007D", type: "Physical · Retailer", platform: "PS5 · Xbox", url: "https://www.momoshop.com.tw/search/searchShop.jsp?keyword=grand+theft+auto+vi", color: "text-purple-400", border: "border-purple-500/20", status: "Check for listings" },
    ],
  },
];
---

<Base
  titleContext="gta-vi"
  title="Buy"
  description="GTA VI pre-orders are LIVE — confirmed Standard ($79.99) and Ultimate ($99.99) Editions, Vintage Vice City Pack pre-order bonus, regional pricing, and where to buy across PS5 and Xbox Series X|S."
  ogPage="buy"
  crossLinksContext="buy"
>

  <!-- ══════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden border-b border-border-dim" style="min-height:420px;display:flex;align-items:flex-end">

    <!-- Character backdrop: Lucia left, Jason right -->
    <div class="absolute inset-0 flex">
      <div class="flex-1 relative overflow-hidden">
        <img src="/assets/gta6/characters/Lucia_Caminos_04.jpg" alt="Lucia Caminos"
          class="w-full h-full object-cover object-top" loading="eager" />
        <div class="absolute inset-0" style="background:linear-gradient(to right,var(--c-bg) 0%,transparent 40%,transparent 60%,var(--c-bg) 100%)"></div>
      </div>
      <div class="flex-1 relative overflow-hidden">
        <img src="/assets/gta6/characters/Jason_Duval_05.jpg" alt="Jason Duval"
          class="w-full h-full object-cover object-top" loading="eager" />
        <div class="absolute inset-0" style="background:linear-gradient(to left,var(--c-bg) 0%,transparent 40%,transparent 60%,var(--c-bg) 100%)"></div>
      </div>
    </div>
    <!-- Top + bottom fades -->
    <div class="absolute inset-0" style="background:linear-gradient(to bottom, var(--c-bg) 0%, transparent 25%, transparent 65%, var(--c-bg) 100%)"></div>

    <!-- Hero content -->
    <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 pb-14 pt-28 text-center">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.25em] mb-3">// Launch Intelligence</div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-3 leading-tight">
        Grand Theft Auto VI
      </h1>
      <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
        <span class="text-[10px] font-mono bg-gta-gold/10 text-gta-gold border border-gta-gold/30 px-2.5 py-1 rounded uppercase tracking-widest animate-pulse">🟢 Pre-orders LIVE</span>
        <span class="text-[10px] font-mono bg-gta-teal/10 text-gta-teal border border-gta-teal/20 px-2.5 py-1 rounded uppercase tracking-widest">Launch · Nov 19 2026</span>
        <span class="text-[10px] font-mono bg-blue-500/10 text-blue-400 border border-blue-500/20 px-2.5 py-1 rounded uppercase tracking-widest">PS5 · Xbox Series X|S</span>
        <span class="text-[10px] font-mono bg-zinc-800/60 text-zinc-500 border border-zinc-700 px-2.5 py-1 rounded uppercase tracking-widest">PC · TBC</span>
      </div>
      <Countdown variant="hero" />
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-14">

    <!-- ══════════════════════════════════════════════════════
         EDITION BREAKDOWN — primary buy section, locale-aware
         per-edition pre-order CTAs (PS Store / Xbox Store /
         Rockstar Store / Amazon).
    ══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader bright label="// Edition Breakdown" class="mb-3" />
      <!-- Confirmed notice — Rockstar shipped only Standard + Ultimate -->
      <div class="rounded-xl border border-gta-teal/25 px-5 py-3 mb-6 flex items-start gap-3" style="background:color-mix(in srgb,var(--c-live) 6%,transparent)">
        <span class="text-gta-teal font-mono text-xs mt-0.5 shrink-0">✓</span>
        <p class="text-[11px] text-zinc-400 leading-relaxed">
          Confirmed by <strong class="text-zinc-200">Rockstar Newswire</strong> on June 25, 2026.
          Rockstar shipped just <strong class="text-zinc-200">two editions</strong> — no Special, Digital Deluxe, or Collector's Box. Both editions are PS5 and Xbox Series X|S only; physical copies are a code in a box (no disc).
          <a href="https://www.rockstargames.com/newswire/article/517oa135328155/grand-theft-auto-vi-pre-orders-begin-on-june-25"
             target="_blank" rel="noopener noreferrer"
             class="text-gta-teal hover:underline">Source ↗</a>
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        {EDITIONS.map((ed) => (
          <div class={`rounded-xl border overflow-hidden flex flex-col transition-all ${ed.highlight ? "border-gta-gold/30 shadow-lg shadow-gta-gold/5" : "border-border-dim"}`}
            style="background:var(--c-card-raised)"
            data-price-usd={ed.price_usd}>

            <!-- Edition header -->
            {ed.highlight && (
              <div class="px-5 py-2 border-b border-gta-gold/20 bg-gta-gold/5 flex items-center justify-between">
                <span class="text-[11px] font-mono text-gta-gold uppercase tracking-widest">Most likely full-content tier</span>
              </div>
            )}

            <div class="px-5 pt-5 pb-4 flex-1">
              <div class="flex items-start justify-between gap-2 mb-1">
                <div class="text-sm font-bold text-zinc-200 leading-snug">{ed.name}</div>
                <span class={`shrink-0 text-[10px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${ed.tier_bg} ${ed.tier_color}`}>{ed.tier}</span>
              </div>

              <!-- Price -->
              <div class={`text-2xl font-mono font-bold mb-0.5 ${ed.highlight ? "text-gta-gold" : "text-gta-bright"}`}>
                <span class="edition-price-usd">${ed.price_usd.toFixed(2)}</span>
              </div>
              <div class="edition-price-local hidden text-sm font-mono text-zinc-500 mb-0.5"></div>
              <div class="text-[10px] font-mono text-zinc-500 mb-4">USD · <span class="edition-price-note">confirmed by Rockstar</span></div>

              <!-- Platforms -->
              <div class="flex items-center gap-1.5 mb-4 flex-wrap">
                {ed.platforms.map((pl: string) => (
                  <span class={`text-[10px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${pl === "PS5" ? "text-blue-400 border-blue-500/20 bg-blue-500/5" : pl === "Xbox" ? "text-gta-green border-gta-green/20 bg-gta-green/5" : "text-zinc-500 border-zinc-700 bg-zinc-800/40"}`}>
                    {pl}
                  </span>
                ))}
                {"physical" in ed && (ed as any).physical && (
                  <span class="text-[10px] font-mono border border-gta-gold/20 text-gta-gold bg-gta-gold/10 px-1.5 py-0.5 rounded uppercase tracking-widest">Physical only</span>
                )}
              </div>

              <!-- Includes -->
              <div class="mb-3">
                <div class="text-[11px] font-mono text-zinc-600 uppercase tracking-widest mb-2">Includes</div>
                <ul class="flex flex-col gap-1.5">
                  {ed.includes.map((item: string) => (
                    <li class="flex items-start gap-2">
                      <span class={`shrink-0 mt-0.5 text-[10px] ${ed.highlight ? "text-gta-gold" : "text-zinc-600"}`}>◆</span>
                      <span class="text-[11px] text-zinc-400 leading-snug">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Pre-order CTAs — locale-aware. Client JS rewrites hrefs on country change. -->
              <div class="mb-4">
                <div class="text-[11px] font-mono text-zinc-600 uppercase tracking-widest mb-2">Pre-order now</div>
                <div class="grid grid-cols-2 gap-1.5">
                  <a href={defaultPS5}
                     target="_blank" rel="noopener noreferrer sponsored"
                     data-buy-ps5
                     class={`text-[11px] font-mono px-3 py-2 rounded border text-center transition-colors text-blue-400 border-blue-500/30 ${ed.highlight ? "hover:bg-blue-500/15 hover:border-blue-400/60" : "hover:bg-blue-500/10"}`}
                     style="background:color-mix(in srgb,#4687FF 6%,transparent)">
                    PlayStation Store →
                  </a>
                  <a href={defaultXbox}
                     target="_blank" rel="noopener noreferrer sponsored"
                     data-buy-xbox
                     class={`text-[11px] font-mono px-3 py-2 rounded border text-center transition-colors text-gta-green border-gta-green/30 ${ed.highlight ? "hover:bg-gta-green/15 hover:border-gta-green/60" : "hover:bg-gta-green/10"}`}
                     style="background:color-mix(in srgb,#22c55e 6%,transparent)">
                    Xbox Store →
                  </a>
                  <a href={ROCKSTAR_STORE_URL}
                     target="_blank" rel="noopener noreferrer sponsored"
                     data-buy-rockstar
                     class={`text-[11px] font-mono px-3 py-2 rounded border text-center transition-colors text-gta-gold border-gta-gold/30 ${ed.highlight ? "hover:bg-gta-gold/15 hover:border-gta-gold/60" : "hover:bg-gta-gold/10"}`}
                     style="background:color-mix(in srgb,var(--c-brand) 6%,transparent)">
                    Rockstar Store →
                  </a>
                  <a href={defaultAmazonUrl}
                     target="_blank" rel="noopener noreferrer sponsored"
                     data-buy-amazon
                     class={`text-[11px] font-mono px-3 py-2 rounded border text-center transition-colors text-orange-400 border-orange-500/30 ${ed.highlight ? "hover:bg-orange-500/15 hover:border-orange-400/60" : "hover:bg-orange-500/10"}`}
                     style="background:color-mix(in srgb,#f97316 6%,transparent)">
                    Amazon →
                  </a>
                </div>
                <div class="text-[9px] font-mono text-zinc-700 mt-1.5 leading-snug">
                  Affiliate links · we may earn a small commission at no cost to you.
                </div>
              </div>

              <!-- Pre-order bonus -->
              {ed.preorder_bonus.length > 0 && (
                <div>
                  <div class="text-[11px] font-mono text-zinc-600 uppercase tracking-widest mb-1.5">Pre-order bonus</div>
                  <ul class="flex flex-col gap-1">
                    {ed.preorder_bonus.map((b: string) => (
                      <li class="flex items-start gap-2">
                        <span class="shrink-0 mt-0.5 text-[10px] text-gta-teal">+</span>
                        <span class="text-[11px] text-zinc-500 leading-snug">{b}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <!-- Basis -->
            <div class="px-5 py-3 border-t border-border-dim">
              <p class="text-[10px] text-zinc-500 font-mono leading-relaxed">{ed.basis}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         WHERE TO BUY — locale-aware retailer grid
         Sits below Edition Breakdown so visitors who want to compare
         retailers get the country-aware list directly under the
         per-edition pre-order CTAs.
    ══════════════════════════════════════════════════════ -->
    <section id="where-to-buy">
      <SectionHeader bright label="// Where to Buy" />

      <!-- Country selector -->
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest">Country</span>
        <div class="relative">
          <select
            id="region-select"
            aria-label="Select your country"
            class="appearance-none text-[11px] font-mono text-zinc-200 border border-border-mid rounded pl-3 pr-9 py-1.5 cursor-pointer hover:border-zinc-500 focus:border-gta-gold/50 focus:outline-none transition-colors"
            style="background:var(--c-card-raised)"
          >
            {COUNTRIES.map((c) => (
              <option value={c.localePrefix} style="background:var(--c-card-raised);color:var(--c-text-2)">{c.flag} {c.name} · {c.currency}</option>
            ))}
          </select>
          <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-500 text-[9px]">▼</span>
        </div>
      </div>

      <!-- Active country label -->
      <div id="country-label" class="text-[10px] font-mono text-zinc-500 mb-4">
        🇺🇸 Showing stores for United States · Prices in USD · <span class="text-zinc-500">Detected via browser locale</span>
      </div>

      <!-- Per-country store grids (all rendered, JS shows the right one) -->
      {COUNTRIES.map((c, i) => (
        <div class={`country-stores${i === 0 ? "" : " hidden"}`} data-locale={c.localePrefix}>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {c.stores.map((r: StoreEntry) => (
              <a href={tagAmazonUrl(r.url)} target="_blank" rel="noopener noreferrer"
                class={`group rounded-xl border p-4 hover:bg-white/3 transition-all flex items-start gap-3 ${r.border}`}
                style="background:var(--c-card-raised)">
                <!-- Logo mark -->
                <div class="shrink-0 w-10 h-10 rounded-xl flex items-center justify-center font-mono font-black text-white text-[11px] border" style={`background:${r.logoBg};border-color:${r.logoBg}60`}>
                  {r.initials}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2 mb-0.5">
                    <span class={`text-sm font-semibold group-hover:text-white transition-colors truncate ${r.color}`}>{r.name}</span>
                    <span class="text-zinc-500 group-hover:text-zinc-400 font-mono text-xs transition-colors shrink-0">↗</span>
                  </div>
                  <div class="text-[10px] font-mono text-zinc-600">{r.type}</div>
                  <div class="flex items-center gap-1.5 mt-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-gta-teal/60 shrink-0"></span>
                    <span class="text-[10px] font-mono text-zinc-500">{r.status ?? "Check for listings"}</span>
                  </div>
                  <div class="text-[11px] font-mono text-zinc-500 mt-0.5">{r.platform}</div>
                  {r.note && <div class="text-[11px] font-mono text-gta-gold/70 mt-1">⚠ {r.note}</div>}
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}

      <!-- FTC / ASA affiliate disclosure — mandatory, must be near the links -->
      <div class="mt-5 rounded-lg border border-border-mid px-4 py-3 flex items-start gap-3" style="background:var(--c-bg)">
        <span class="text-zinc-600 font-mono text-[11px] shrink-0 mt-0.5">ⓘ</span>
        <p class="text-[10px] font-mono text-zinc-600 leading-relaxed">
          <strong class="text-zinc-500 font-semibold">Affiliate disclosure:</strong> Some links on this page are affiliate links.
          GTAVI.AI earns a small commission if you purchase through them — at no extra cost to you.
          This does not affect which stores are listed or how they are ranked. Currency conversions are estimates only.
        </p>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         PLATFORM AVAILABILITY — confirmed platforms reference
         Moved below the buy section: pre-order CTAs are the
         primary action; this is a reference card for which
         hardware can run GTA VI (PS5 + Xbox confirmed, PC TBC).
    ══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader bright label="// Confirmed Platforms" dotColor="var(--c-live)" />
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {PLATFORMS.map(p => (
          <div class={`rounded-xl border p-5 ${p.border} ${p.bg} relative overflow-hidden`} style="background:var(--c-card-raised)">
            <!-- Platform logo mark -->
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 font-mono font-black text-white text-sm" style={`background:${p.logoBg};border:1px solid ${p.logoBg}40`}>
                {p.logoText}
              </div>
              <div>
                <div class={`text-sm font-bold leading-tight ${p.color}`}>{p.name}</div>
                <div class="text-[10px] font-mono text-zinc-600 mt-0.5">{p.store}</div>
              </div>
              <div class="ml-auto shrink-0">
                <span class={`text-[10px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${p.confirmed ? "bg-gta-teal/10 text-gta-teal border-gta-teal/20" : "bg-zinc-800/60 text-zinc-600 border-zinc-700"}`}>
                  {p.confirmed ? "✓ Confirmed" : "TBC"}
                </span>
              </div>
            </div>
            <p class="text-[11px] text-zinc-500 leading-snug mb-4">{p.desc}</p>
            {p.official_url ? (
              <a href={p.official_url} target="_blank" rel="noopener noreferrer"
                class={`inline-flex items-center gap-2 text-[10px] font-mono border px-3 py-1.5 rounded uppercase tracking-widest transition-all hover:bg-white/5 ${p.color} ${p.border}`}>
                Official page ↗
              </a>
            ) : (
              <span class="text-[10px] font-mono text-zinc-500">No official page yet</span>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         PLAY NOW WHILE YOU WAIT — secondary GTA V upsell
         Demoted below GTA VI buy CTAs: pre-orders are live so
         GTA VI is the primary action. This stays as a low-friction
         option for visitors who want a Rockstar fix between now
         and the November launch.
    ══════════════════════════════════════════════════════ -->
    <section>
      <div class="rounded-xl border border-gta-gold/20 overflow-hidden relative"
           style="background:linear-gradient(135deg,color-mix(in srgb,var(--c-brand) 6%,var(--c-card)) 0%,var(--c-card) 60%)">
        <div class="absolute top-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,var(--c-brand),transparent 50%)"></div>
        <div class="px-6 py-5 flex items-center justify-between gap-6 flex-wrap sm:flex-nowrap">
          <div class="flex items-center gap-4 min-w-0">
            <div class="shrink-0 w-14 h-14 rounded-xl overflow-hidden border border-gta-gold/20">
              <img src="/assets/gta5/dlc/cayo-perico.jpg" alt="GTA V" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="min-w-0">
              <div class="text-[10px] font-mono text-gta-gold/70 uppercase tracking-widest mb-0.5">Play between now &amp; launch</div>
              <div class="text-base font-bold text-zinc-100 leading-tight">GTA V + GTA Online — PlayStation 5</div>
              <div class="text-[11px] font-mono text-zinc-500 mt-0.5">
                ~5 months until GTA VI launch · GTA V is on PS5 today · all DLC included
              </div>
            </div>
          </div>
          <a href={PRODUCT_LINKS.gta5_ps5_us}
             target="_blank" rel="noopener noreferrer sponsored"
             class="shrink-0 flex items-center gap-2 px-5 py-2.5 rounded-lg font-mono font-bold text-sm transition-all hover:brightness-110"
             style="background:var(--c-brand);color:var(--c-bg)">
            Buy on Amazon ↗
          </a>
        </div>
        <div class="px-6 pb-3 flex items-center gap-2">
          <span class="text-[9px] font-mono text-zinc-700">ⓘ Affiliate link · we earn a small commission at no cost to you · PS5 edition</span>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         CHARACTERS — visual anchor
    ══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader bright label="// Confirmed Protagonists" dotColor="var(--c-live)" pillHref="/gta-vi/intel" pillLabel="Full intel →" />
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {([
          { name: "Lucia Caminos", role: "Protagonist", img: "Lucia_Caminos_06.jpg", desc: "Confirmed via official Trailer 1. First female lead in the mainline GTA series." },
          { name: "Jason Duval",   role: "Protagonist", img: "Jason_Duval_06.jpg",   desc: "Confirmed via official Trailer 1 and Trailer 2. Co-protagonist alongside Lucia." },
        ] as const).map(c => (
          <div class="group relative overflow-hidden rounded-xl border border-border-dim hover:border-gta-gold/20 transition-all">
            <div class="aspect-[16/7] overflow-hidden">
              <img
                src={`/assets/gta6/characters/${c.img}`}
                alt={c.name}
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0" style="background:linear-gradient(to right,var(--c-card-raised) 0%,color-mix(in srgb,var(--c-card-raised) 67%,transparent) 30%,transparent 65%)"></div>
            </div>
            <div class="absolute inset-0 flex items-center px-6">
              <div>
                <div class="text-[11px] font-mono text-gta-gold uppercase tracking-widest mb-1">Confirmed · Official Trailers</div>
                <div class="text-xl font-bold text-white mb-1">{c.name}</div>
                <div class="text-[10px] font-mono text-zinc-500 mb-3">{c.role}</div>
                <p class="text-[11px] text-zinc-400 max-w-xs leading-relaxed">{c.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>


    <!-- ══════════════════════════════════════════════════════
         NORDVPN — protect your IP when GTA VI Online launches
    ══════════════════════════════════════════════════════ -->
    <section>
      <div class="rounded-xl border overflow-hidden" style="background:var(--c-card);border-color:var(--c-border-1)">
        <div class="px-5 py-4 flex items-start gap-4">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 text-lg" style="background:#0a1628">🛡️</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <span class="font-semibold text-zinc-100 text-sm">Protect Your IP When GTA VI Online Launches</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded border text-blue-400 border-blue-500/30" style="background:color-mix(in srgb,#4687FF 8%,transparent)">NordVPN</span>
            </div>
            <p class="text-[11px] text-zinc-500 font-mono leading-relaxed mb-3">
              GTA Online lobbies expose your real IP to other players — a known attack vector for DDoS and boot attacks. A VPN routes your traffic through a secure server, hiding your IP and keeping your session stable. NordVPN is the most-used VPN in gaming.
            </p>
            <div class="flex items-center gap-3 flex-wrap">
              <a href={nordLink()} target="_blank" rel="noopener noreferrer sponsored"
                class="text-[11px] font-mono px-4 py-2 rounded border border-blue-500/30 text-blue-400 hover:bg-blue-500/10 transition-colors uppercase tracking-widest">
                Get NordVPN →
              </a>
              <span class="text-[10px] font-mono text-zinc-600">Best deal on 2-year plan</span>
            </div>
          </div>
        </div>
        <div class="px-5 py-2 border-t flex items-center justify-between" style="background:var(--c-bg);border-color:var(--c-border-1)">
          <span class="text-[10px] font-mono text-zinc-600">Affiliate disclosure: we earn a commission if you subscribe via this link, at no extra cost to you.</span>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         INTELLIGENCE NOTE
    ══════════════════════════════════════════════════════ -->
    <section class="rounded-xl border border-border-dim p-6" style="background:var(--c-card-raised)">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">// Intelligence Standard</div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[
          { label: "Confirmed", color: "text-gta-teal", border: "border-gta-teal/20", desc: "Rockstar Games official material — trailers, press releases, Take-Two IR." },
          { label: "Reported",  color: "text-gta-gold", border: "border-gta-gold/25", desc: "Credible industry sources with a track record — Tom Henderson, IGN, Kotaku." },
          { label: "Speculative", color: "text-zinc-400", border: "border-zinc-700", desc: "Modelled from RDR2, GTA V precedent, and industry-standard release patterns. Not sourced." },
        ].map(t => (
          <div class="flex items-start gap-3">
            <span class={`shrink-0 text-[10px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest mt-0.5 bg-transparent ${t.color} ${t.border}`}>{t.label}</span>
            <p class="text-[11px] text-zinc-600 leading-relaxed">{t.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-[10px] text-zinc-500 font-mono mt-4">
        GTAVI.AI is an independent community data project. Not affiliated with Rockstar Games, Take-Two Interactive, or any retailer listed.
      </p>
    </section>

  </div>
</Base>

<script define:vars={{
  // Only the metadata fields used by the script — stripping `stores`
  // (which contains untagged Amazon URLs) keeps the wire HTML clean
  // and ensures every Amazon URL on the page is tagged at the source.
  COUNTRIES: COUNTRIES.map(({ localePrefix, flag, name, currency, rate, symbol }) =>
    ({ localePrefix, flag, name, currency, rate, symbol })),
  GTAVI_STOREFRONTS,
  GTAVI_AMAZON,
  AMAZON_TAG_MAP,
}}>
(function() {
  // ── Locale-aware buy CTAs on Edition cards ────────────────────────────
  // Apply the matching Amazon Associates tag if we have one for that store.
  function tagAmazon(url) {
    try {
      const u = new URL(url);
      const tag = AMAZON_TAG_MAP[u.hostname];
      if (tag) u.searchParams.set('tag', tag);
      return u.toString();
    } catch { return url; }
  }
  function updateEditionCTAs(localePrefix) {
    const stores = GTAVI_STOREFRONTS[localePrefix] ?? GTAVI_STOREFRONTS['en-US'];
    const amazon = GTAVI_AMAZON[localePrefix] ?? GTAVI_AMAZON['en-US'];
    document.querySelectorAll('[data-buy-ps5]').forEach(el => { el.href = stores.ps5; });
    document.querySelectorAll('[data-buy-xbox]').forEach(el => { el.href = stores.xbox; });
    document.querySelectorAll('[data-buy-amazon]').forEach(el => { el.href = tagAmazon(amazon); });
    // Rockstar Store URL is global — no rewrite needed.
  }
  // ── Detect locale and match to a country ──────────────────────────────
  const lang = (navigator.language || navigator.languages?.[0] || 'en-US').toLowerCase();

  function matchLocale(lang) {
    const prefixes = [
      { test: s => s.startsWith('en-ca'), key: 'en-CA' },
      { test: s => s.startsWith('en-in'), key: 'en-IN' },
      { test: s => s.startsWith('en-au') || s.startsWith('en-nz'), key: 'en-AU' },
      { test: s => s.startsWith('en-gb') || s.startsWith('en-ie'), key: 'en-GB' },
      { test: s => s.startsWith('en-za'), key: 'en-ZA' },
      { test: s => s.startsWith('en-ae'), key: 'ar-AE' },
      { test: s => s.startsWith('en-sa'), key: 'ar-SA' },
      { test: s => s.startsWith('en'),   key: 'en-US' },
      { test: s => s.startsWith('de-ch'), key: 'de-CH' },
      { test: s => s.startsWith('de-at'), key: 'de-AT' },
      { test: s => s.startsWith('de'),   key: 'de' },
      { test: s => s.startsWith('fr-be'), key: 'fr-BE' },
      { test: s => s.startsWith('fr-ch'), key: 'de-CH' },
      { test: s => s.startsWith('fr'),   key: 'fr' },
      { test: s => s.startsWith('it'),   key: 'it' },
      { test: s => s.startsWith('nl-be'), key: 'fr-BE' },
      { test: s => s.startsWith('nl'),   key: 'nl' },
      { test: s => s.startsWith('pt-pt'), key: 'pt-PT' },
      { test: s => s.startsWith('pt'),   key: 'pt' },
      { test: s => s.startsWith('ja'),   key: 'ja' },
      { test: s => s.startsWith('ko'),   key: 'ko' },
      { test: s => s.startsWith('pl'),   key: 'pl' },
      { test: s => s.startsWith('sv'),   key: 'sv' },
      { test: s => s.startsWith('tr'),   key: 'tr' },
      { test: s => s.startsWith('zh-tw') || s.startsWith('zh-hant') || s.startsWith('zh-hk'), key: 'zh-TW' },
      { test: s => s.startsWith('zh'),   key: 'zh' },
      { test: s => s.startsWith('hi'),   key: 'en-IN' },
      { test: s => s.startsWith('es-mx') || s.startsWith('es-419'), key: 'es-MX' },
      { test: s => s.startsWith('es-ar'), key: 'es-AR' },
      { test: s => s.startsWith('ar-sa'), key: 'ar-SA' },
      { test: s => s.startsWith('ar'),   key: 'ar-AE' },
      { test: s => s.startsWith('es'),   key: 'es' },
    ];
    for (const p of prefixes) {
      if (p.test(lang)) return typeof p.key === 'function' ? p.key(lang) : p.key;
    }
    return 'en-US';
  }

  const detectedLocale = matchLocale(lang);

  // ── Activate correct country ───────────────────────────────────────────
  function setCountry(localePrefix) {
    // Store grids
    document.querySelectorAll('.country-stores').forEach(el => {
      el.classList.toggle('hidden', el.dataset.locale !== localePrefix);
    });
    // Sync dropdown selection
    const sel = document.getElementById('region-select');
    if (sel && sel.value !== localePrefix) sel.value = localePrefix;
    // Country label
    const country = COUNTRIES.find(c => c.localePrefix === localePrefix);
    const label = document.getElementById('country-label');
    if (country && label) {
      label.innerHTML = `${country.flag} Showing stores for <strong style="color:var(--c-text-3)">${country.name}</strong> · Prices in <strong style="color:var(--c-text-3)">${country.currency}</strong> · <span style="color:var(--c-text-5)">auto-detected from your browser</span>`;
    }
    // Edition card CTAs: rewrite hrefs for locale
    updateEditionCTAs(localePrefix);
    // Edition prices: prefer Rockstar's confirmed regional pricing, fall back
    // to FX-converted estimate for regions Rockstar has not separately listed.
    const CONFIRMED = {
      'en-GB':   { 79.99: '£69.99 GBP',   99.99: '£89.99 GBP'   },
      'de':      { 79.99: '€79.99 EUR',   99.99: '€99.99 EUR'   },
      'fr':      { 79.99: '€79.99 EUR',   99.99: '€99.99 EUR'   },
      'it':      { 79.99: '€79.99 EUR',   99.99: '€99.99 EUR'   },
      'es':      { 79.99: '€79.99 EUR',   99.99: '€99.99 EUR'   },
      'nl':      { 79.99: '€79.99 EUR',   99.99: '€99.99 EUR'   },
      'pt-PT':   { 79.99: '€79.99 EUR',   99.99: '€99.99 EUR'   },
      'de-AT':   { 79.99: '€79.99 EUR',   99.99: '€99.99 EUR'   },
      'fr-BE':   { 79.99: '€79.99 EUR',   99.99: '€99.99 EUR'   },
      'ja':      { 79.99: '¥9,800 JPY',   99.99: '¥12,280 JPY'  },
    };
    const rate = country?.rate ?? 1;
    const symbol = country?.symbol ?? '$';
    document.querySelectorAll('[data-price-usd]').forEach(card => {
      const usd = parseFloat(card.dataset.priceUsd ?? '0');
      const priceEl = card.querySelector('.edition-price-local');
      const noteEl = card.querySelector('.edition-price-note');
      const confirmedLocal = CONFIRMED[localePrefix]?.[usd];
      if (confirmedLocal) {
        if (priceEl) {
          priceEl.textContent = confirmedLocal;
          priceEl.classList.remove('hidden');
        }
        if (noteEl) noteEl.textContent = 'confirmed regional price';
      } else if (rate !== 1) {
        const local = (usd * rate).toFixed(0);
        if (priceEl) {
          priceEl.textContent = `~${symbol}${local} ${country?.currency}`;
          priceEl.classList.remove('hidden');
        }
        if (noteEl) noteEl.textContent = 'converted estimate · check storefront';
      } else {
        if (noteEl) noteEl.textContent = 'confirmed by Rockstar';
      }
    });
  }

  setCountry(detectedLocale);

  // ── Manual region dropdown ─────────────────────────────────────────────
  document.getElementById('region-select')?.addEventListener('change', (e) => {
    setCountry(e.target.value);
  });
})();
</script>
