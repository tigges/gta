---
// gta-vi/trailers.astro — GTA VI Trailers & Analysis
// Content lives in /gta-vi/intel (which has the full trailer section).
// This route provides a direct link to that section for nav deep-linking.
import Base from "../../layouts/Base.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import ShareButton from "../../components/ShareButton.astro";

import trailersDataRaw from "../../../data/gta-6/trailers.json";
import velocityData    from "../../../data/gta-6/trailer-velocity.json";
import type { TrailersData } from "../../types/gta";

const td = trailersDataRaw as unknown as TrailersData;
const trailers = td.trailers ?? [];

const t1 = (velocityData as any).trailers?.find((t: any) => t.youtube_id === "QdBZY2fkU-0");
const t2 = (velocityData as any).trailers?.find((t: any) => t.youtube_id === "VQRLujxTm3c");
const t1Views = (t1?.snapshots?.at(-1)?.views ?? 0) as number;
const t2Views = (t2?.snapshots?.at(-1)?.views ?? 0) as number;
---

<Base
  title="GTA VI Trailers"
  description="GTA VI trailer analysis — view velocity, frame-by-frame entity index, cast reveals and location analysis across both official Rockstar trailers."
  ogPage="vi-intel"
>
  <!-- Hero -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden" style="min-height:280px">
    <div class="absolute inset-0">
      <img src="/assets/gta6/locations/Ambrosia_02.jpg" alt=""
           class="w-full h-full object-cover" style="object-position:center 20%" aria-hidden="true" />
      <div class="absolute inset-0" style="background:linear-gradient(to right, #0a0a0d 0%, #0a0a0dcc 60%, #0a0a0d55 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom, transparent 50%, #0a0a0d 100%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-14">
      <div class="max-w-lg">
        <div class="text-[10px] font-mono text-gta-gold/60 uppercase tracking-[0.25em] mb-3">// GTA VI · Official Trailers</div>
        <h1 class="text-4xl font-bold text-white mb-4" style="font-family:'Inter',sans-serif">Trailers &amp; Analysis</h1>
        <div class="flex flex-wrap gap-5 text-xs font-mono text-zinc-500">
          <span><span class="text-zinc-200 font-bold">{trailers.length}</span> official trailers</span>
          <span><span class="text-zinc-200 font-bold">{(t1Views / 1e6).toFixed(0)}M</span> Trailer 1 views</span>
          <span><span class="text-zinc-200 font-bold">{(t2Views / 1e6).toFixed(0)}M</span> Trailer 2 views</span>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">

    <!-- Trailer cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
      {trailers.map((t: any) => (
        <a href={`https://www.youtube.com/watch?v=${t.youtube_id}`}
           target="_blank" rel="noopener noreferrer"
           class="group relative overflow-hidden rounded-xl border border-[#1e1e23] hover:border-zinc-700 transition-all"
           style="background:#131316">
          <div class="relative overflow-hidden" style="height:180px">
            <img src={`https://img.youtube.com/vi/${t.youtube_id}/maxresdefault.jpg`}
                 alt={t.title}
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80"
                 loading="lazy" />
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-14 h-14 rounded-full flex items-center justify-center" style="background:rgba(0,0,0,0.7)">
                <svg class="w-6 h-6 text-white ml-1" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
          </div>
          <div class="px-4 py-3">
            <div class="font-semibold text-zinc-200 text-sm mb-1" style="font-family:'Inter',sans-serif">{t.title}</div>
            <div class="text-[10px] font-mono text-zinc-600">{t.published_date?.slice(0,10)} · YouTube ↗</div>
          </div>
        </a>
      ))}
    </div>

    <!-- Deep analysis link -->
    <div class="rounded-xl border border-[#1e1e23] p-5 flex items-center gap-4 mb-10" style="background:#131316">
      <div class="flex-1">
        <div class="font-semibold text-zinc-300 text-sm mb-1" style="font-family:'Inter',sans-serif">Full Frame-by-Frame Analysis</div>
        <div class="text-[10px] font-mono text-zinc-600">Entity index, location identification, cast reveals and view velocity tracking.</div>
      </div>
      <a href="/gta-vi/intel" class="shrink-0 px-3 py-2 rounded border border-gta-gold/25 text-gta-gold text-[10px] font-mono hover:bg-gta-gold/8 transition-all">
        Full Intel →
      </a>
    </div>

    <CrossLinks context="vi-intel-trailers" />
  </div>
</Base>
