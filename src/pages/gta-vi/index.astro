---
/**
 * /gta-vi — Grand Theft Auto VI hub page.
 * Layered architecture: Predictions → Charts (full) → Economy → Nav tiles.
 * Charts rendered full-size, not collapsed.
 */
import Base from "../../layouts/Base.astro";
import GamePill from "../../components/GamePill.astro";
import PredictionCard from "../../components/PredictionCard.astro";
import IncomePredictionCard from "../../components/IncomePredictionCard.astro";
import ExpenditureCard from "../../components/ExpenditureCard.astro";
import EconomyCircle from "../../components/EconomyCircle.astro";
import Countdown from "../../components/Countdown.astro";
import ChartTeaserCpi          from "../../components/charts/ChartTeaserCpi.astro";
import ChartTeaserRevenueSplit  from "../../components/charts/ChartTeaserRevenueSplit.astro";
import ChartTeaserSearchSignal  from "../../components/charts/ChartTeaserSearchSignal.astro";

import type { Prediction, TrailersData } from "../../types/gta";
import { getChart } from "../../config/allCharts";

import predictionsDataRaw  from "../../../data/gta-6/predictions.json";
import incomeDataRaw        from "../../../data/gta-6/income-predictions.json";
import trailersDataRaw      from "../../../data/gta-6/trailers.json";
import velocityDataRaw      from "../../../data/gta-6/trailer-velocity.json";
import delayDataRaw         from "../../../data/gta-6/delay-timeline.json";
import trailerAnalysisRaw   from "../../../data/gta-6/trailer-analysis.json";
import regionsDataRaw       from "../../../data/franchise/regions-evidence.json";

const predictions    = predictionsDataRaw.predictions as Prediction[];
const incomeList     = (incomeDataRaw as any).income_predictions as any[];
const trailersData   = trailersDataRaw as TrailersData;
const trailers       = trailersData.trailers;
const velocityData   = velocityDataRaw as any;
const delayData      = delayDataRaw as any;
const trailerAnalysis = trailerAnalysisRaw as any;
const regionsData    = regionsDataRaw as any;

// Hero stats
const t1 = velocityData.trailers?.find((t: any) => t.youtube_id === "QdBZY2fkU-0");
const t2 = velocityData.trailers?.find((t: any) => t.youtube_id === "VQRLujxTm3c");
const t1Views = (t1?.snapshots?.at(-1)?.views ?? 0) as number;
const t2Views = (t2?.snapshots?.at(-1)?.views ?? 0) as number;
const totalViews = t1Views + t2Views;
const confirmedRegions = regionsData.regions?.filter((r: any) => r.confirmed)?.length ?? 0;
const totalEntities = (trailerAnalysis.trailers?.[0]?.total_entities ?? 0) + (trailerAnalysis.trailers?.[1]?.total_entities ?? 0);
const heroTrailer = trailers[1] ?? trailers[0];

const formatViews = (n: number) =>
  n >= 1e9 ? `${(n / 1e9).toFixed(2)}B` : n >= 1e6 ? `${(n / 1e6).toFixed(0)}M` : n.toString();

// Predictions — tagged for "gta-vi", sorted by display_order
const hubPredictions = predictions
  .filter((p: Prediction) => (p.pages ?? []).includes("gta-vi"))
  .sort((a: Prediction, b: Prediction) => (a.display_order ?? 99) - (b.display_order ?? 99));

// Top 2 income cards (confirmed + reported first)
const featuredIncome = incomeList
  .sort((a: any, b: any) => {
    const t: Record<string, number> = { confirmed: 0, reported: 1, predicted: 2 };
    return (t[a.confidence_tier] ?? 2) - (t[b.confidence_tier] ?? 2);
  })
  .slice(0, 2);
---

<Base
  titleContext="gta-vi"
  title="GTA VI — Intelligence Hub"
  description="Follow the GTA VI economy — confidence-scored predictions, income yields, Shark Card projections and launch-day economic analysis."
  ogPage="vi-intel"
>

  <!-- ═══════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden border-b border-[#1e1e23]" style="min-height:380px;display:flex;align-items:flex-end">
    <div class="absolute inset-0 flex">
      <div class="flex-1 relative overflow-hidden">
        <img src="/assets/gta6/characters/Lucia_Caminos_03.jpg" alt="Lucia Caminos"
          class="w-full h-full object-cover object-top" loading="eager" />
        <div class="absolute inset-0" style="background:linear-gradient(to right,var(--c-bg) 0%,transparent 40%,transparent 50%,var(--c-bg) 100%)"></div>
      </div>
      <div class="flex-1 relative overflow-hidden">
        <img src="/assets/gta6/characters/Jason_Duval_02.jpg" alt="Jason Duval"
          class="w-full h-full object-cover object-top" loading="eager" />
        <div class="absolute inset-0" style="background:linear-gradient(to left,var(--c-bg) 0%,transparent 40%,transparent 50%,var(--c-bg) 100%)"></div>
      </div>
    </div>
    <div class="absolute inset-0" style="background:linear-gradient(to bottom,var(--c-bg) 0%,transparent 20%,transparent 55%,var(--c-bg) 100%)"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pb-10 pt-16 w-full">
      <div class="flex items-end justify-between flex-wrap gap-6">
        <div class="max-w-xl">
          <div class="flex items-center gap-2 mb-3">
            <GamePill game="gta-vi" size="sm" />
            <span class="text-[11px] font-mono bg-gta-gold/10 text-gta-gold border border-gta-gold/20 px-2 py-0.5 rounded uppercase tracking-widest">
              Intelligence Hub
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">Grand Theft Auto VI</h1>
          <p class="text-zinc-400 text-sm leading-relaxed mb-5 max-w-sm">
            30 years of franchise data, distilled into signal intelligence. Every prediction confidence-scored. Every number sourced.
          </p>
          <Countdown variant="hero" />
        </div>
        {heroTrailer && (
          <a href={`https://www.youtube.com/watch?v=${heroTrailer.youtube_id}`}
             target="_blank" rel="noopener noreferrer"
             class="group relative overflow-hidden rounded-xl border border-[#2a2a31] hover:border-gta-gold/40 transition-all shrink-0 hidden sm:block"
             style="width:240px">
            <img src={`https://img.youtube.com/vi/${heroTrailer.youtube_id}/mqdefault.jpg`} alt={heroTrailer.title}
              class="w-full object-cover transition-transform duration-500 group-hover:scale-105" style="height:135px" loading="eager" />
            <div class="absolute inset-0" style="background:linear-gradient(to top,var(--c-bg) 0%,transparent 55%)"></div>
            <div class="absolute top-2 left-2">
              <span class="text-[10px] font-mono bg-gta-gold/15 text-gta-gold border border-gta-gold/20 px-1.5 py-0.5 rounded uppercase tracking-widest">Official</span>
            </div>
            <div class="absolute bottom-0 left-0 right-0 px-3 pb-2.5">
              <div class="text-[10px] font-semibold text-white leading-tight">{heroTrailer.title}</div>
            </div>
          </a>
        )}
      </div>
      <!-- Key stats strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-8 max-w-2xl">
        {[
          { value: `${hubPredictions.length}`,                          label: "predictions",          sub: "confidence-scored" },
          { value: totalViews > 0 ? formatViews(totalViews) : "200M+",  label: "trailer views",        sub: "T1 + T2 combined" },
          { value: `${confirmedRegions}`,                               label: "confirmed regions",    sub: "Leonida map" },
          { value: `${totalEntities}`,                                  label: "entities discovered",  sub: "frame-by-frame" },
        ].map(s => (
          <div class="rounded-xl border border-[#1e1e23] px-4 py-3" style="background:var(--c-card)">
            <div class="text-xl font-mono font-black text-gta-gold">{s.value}</div>
            <div class="text-[11px] text-zinc-400 mt-0.5">{s.label}</div>
            <div class="text-[10px] font-mono text-zinc-600">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-14">

    <!-- ═══════════════════════════════════════════════════════
         LAYER 1: SIGNAL PREDICTIONS — 3-page carousel, 4 per page
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center justify-between gap-3 mb-6">
        <div class="flex items-center gap-3 min-w-0">
          <span class="w-1.5 h-1.5 rounded-full bg-gta-gold/60 shrink-0"></span>
          <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Signal Intelligence</span>
          <div class="flex-1 h-px bg-[#1e1e23]"></div>
        </div>
        <a href="/gta-vi/intel"
           class="shrink-0 text-[11px] font-mono text-zinc-500 hover:text-zinc-200 border border-[#2a2a31] hover:border-zinc-600 px-3 py-1 rounded transition-colors uppercase tracking-widest" aria-label="All predictions">
          All {predictions.length} predictions →
        </a>
      </div>

      <!-- Carousel viewport: overflow-hidden clips pages 2 and 3 -->
      <div id="pred-viewport" class="overflow-hidden">
        <!-- Track: 3 full-width panels side-by-side -->
        <div id="pred-track" class="flex" style="transition:transform 0.35s cubic-bezier(0.4,0,0.2,1)">
          {([0, 4, 8] as const).map((offset) => (
            <div class="w-full shrink-0 grid grid-cols-2 lg:grid-cols-4 gap-3">
              {hubPredictions.slice(offset, offset + 4).map((p: Prediction) => (
                <PredictionCard
                  id={p.id}
                  title={p.title}
                  value={p.value}
                  confidence={p.confidence}
                  confidence_tier={p.confidence_tier}
                  basis={p.basis}
                  unit={p.unit}
                  trailer_timestamp={p.trailer_timestamp}
                  prediction_method={p.prediction_method}
                  prediction_range={p.prediction_range}
                  source={p.source}
                  source_type={p.source_type}
                  outcome_verified={p.outcome_verified}
                  outcome_actual={p.outcome_actual}
                  thumbnail={(p as any).thumbnail}
                  compact={true}
                  game="gta-vi"
                  short_value={(p as any).short_value ?? null}
                  detailHref={`/gta-vi/intel#${p.id}`}
                />
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- Controls: prev · dots · next -->
      <div class="flex items-center justify-center gap-3 mt-4">
        <button id="pred-prev"
          class="w-8 h-8 rounded-full border border-[#2a2a31] flex items-center justify-center text-zinc-500 hover:text-zinc-200 hover:border-zinc-600 transition-all disabled:opacity-25 disabled:cursor-default"
          aria-label="Previous">
          <svg class="w-3.5 h-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 2L4 7l5 5"/>
          </svg>
        </button>
        <div class="flex items-center gap-1.5">
          {[0, 1, 2].map((i) => (
            <button class="pred-dot rounded-full transition-all duration-200" data-page={i}
              style="width:6px;height:6px;background:var(--c-border-2)" aria-label={`Page ${i + 1}`} />
          ))}
        </div>
        <button id="pred-next"
          class="w-8 h-8 rounded-full border border-[#2a2a31] flex items-center justify-center text-zinc-500 hover:text-zinc-200 hover:border-zinc-600 transition-all disabled:opacity-25 disabled:cursor-default"
          aria-label="Next">
          <svg class="w-3.5 h-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 2l5 5-5 5"/>
          </svg>
        </button>
        <span id="pred-page-label" class="text-[10px] font-mono text-zinc-600 ml-1">1 / 3</span>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         LAYER 2: CHARTS — static CSS teasers
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center justify-between gap-3 mb-6">
        <div class="flex items-center gap-3 min-w-0">
          <span class="w-1.5 h-1.5 rounded-full bg-gta-gold/60 shrink-0"></span>
          <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Data Charts</span>
          <div class="flex-1 h-px bg-[#1e1e23]"></div>
        </div>
        <a href="/charts?title=gta-vi"
           class="shrink-0 text-[11px] font-mono text-zinc-500 hover:text-zinc-200 border border-[#2a2a31] hover:border-zinc-600 px-3 py-1 rounded transition-colors uppercase tracking-widest">
          All GTA VI charts →
        </a>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <ChartTeaserCpi />
        <ChartTeaserRevenueSplit />
        <ChartTeaserSearchSignal />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         LAYER 3: ECONOMY — diagram + income + expenditure
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-gta-gold/60 shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// The GTA Economy</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>

      <!-- Circular economy diagram -->
      <div class="mb-6">
        <EconomyCircle fullEconomyHref="/gta-vi/economy" />
      </div>

      <!-- Income + Expenditure cards: 2-col split with teal/orange column borders -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Income side (Y) — teal left border matches economy circle income arc -->
        <div class="rounded-xl border border-[#1e1e23] px-4 pt-3 pb-4" style="background:rgba(13,148,136,0.03)">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[10px] font-mono uppercase tracking-widest" style="color:var(--c-income)">Y — Income</span>
            <div class="flex-1 h-px" style="background:rgba(13,148,136,0.2)"></div>
            <a href="/gta-vi/intel#section-income-predictions"
               class="text-[10px] font-mono uppercase tracking-widest transition-colors"
               style="color:var(--c-live);opacity:var(--o-tertiary)" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
              All {incomeList.length} →
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {featuredIncome.map((entry: any) => (
              <IncomePredictionCard
                id={entry.id}
                name={entry.name}
                category={entry.category}
                region={entry.region}
                confidence_tier={entry.confidence_tier}
                confidence_score={entry.confidence_score}
                thumbnail={entry.thumbnail}
                trailer_evidence={entry.trailer_evidence}
                predicted_payout_per_run={entry.predicted_payout_per_run}
                predicted_gta_per_hr={entry.predicted_gta_per_hr}
                analogous_gta_online={entry.analogous_gta_online}
                basis={entry.basis}
                prediction_range={entry.prediction_range}
                detailHref={`/gta-vi/intel#income-pred-${entry.id}`}
              />
            ))}
          </div>
        </div>

        <!-- Expenditure side (C+I) — orange border matches economy circle expenditure arc -->
        <div class="rounded-xl border border-[#1e1e23] px-4 pt-3 pb-4" style="border-right:3px solid var(--c-flow-spending);background:rgba(249,115,22,0.03)">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[10px] font-mono uppercase tracking-widest" style="color:var(--c-flow-spending)">C+I — Expenditure</span>
            <div class="flex-1 h-px" style="background:rgba(245,158,11,0.2)"></div>
            <a href="/gta-vi/economy"
               class="text-[10px] font-mono uppercase tracking-widest transition-colors shrink-0"
               style="color:var(--c-brand);opacity:var(--o-secondary)" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='var(--o-secondary)'">
              Full economy →
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <ExpenditureCard id="nightclub" />
            <ExpenditureCard id="megalodon" />
          </div>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         NAVIGATION TILES
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-zinc-700 shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-500 tracking-[0.2em] uppercase">// Explore GTA VI</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {[
          { href: "/gta-vi/intel",    label: "Intelligence & Predictions", sub: `${predictions.length} signals · confirmed · reported · predicted`, badge: "Intelligence", thumb: "/assets/gta6/characters/Lucia_Caminos_05.jpg" },
          { href: "/gta-vi/trailers", label: "Trailers & Analysis",        sub: "Trailer 1 & 2 · view velocity · entity index",                    badge: "Analysis",       thumb: `https://img.youtube.com/vi/VQRLujxTm3c/mqdefault.jpg` },
          { href: "/gta-vi/economy",  label: "Economy & Income",           sub: "Circular model · income sources · Shark Card mechanics",           badge: "Economy",        thumb: "/assets/gta6/locations/Vice_City_03.jpg" },
          { href: "/gta-vi/buy",      label: "Pre-order Guide",            sub: "PS5 · Xbox Series X|S · edition comparison · retailer watchlist",  badge: "Pre-order",      thumb: "/assets/gta6/locations/Ambrosia_02.jpg" },
        ].map(tile => (
          <a href={tile.href}
             class="group relative overflow-hidden rounded-xl border border-[#1e1e23] hover:border-[#2a2a31] transition-all"
             style="background:var(--c-card)">
            <div class="h-px w-full" style="background:linear-gradient(90deg,var(--c-identity),transparent 60%)"></div>
            <div class="flex items-center gap-4 p-4">
              <div class="shrink-0 w-20 h-12 rounded-lg overflow-hidden border border-[#2a2a31]">
                <img src={tile.thumb} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" aria-hidden="true" />
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-[10px] font-mono text-zinc-500 mb-0.5 uppercase tracking-widest">{tile.badge}</div>
                <div class="text-sm font-semibold text-zinc-100 group-hover:text-white transition-colors truncate">{tile.label}</div>
                <div class="text-[11px] font-mono text-zinc-500 leading-snug mt-0.5 line-clamp-1">{tile.sub}</div>
              </div>
              <svg class="shrink-0 w-4 h-4 text-zinc-600 group-hover:text-zinc-400 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 16 16">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>

</Base>

<script>
  // ── Prediction carousel ───────────────────────────────────────────────────
  const viewport   = document.getElementById("pred-viewport")!;
  const track      = document.getElementById("pred-track")!;
  const prevBtn    = document.getElementById("pred-prev") as HTMLButtonElement;
  const nextBtn    = document.getElementById("pred-next") as HTMLButtonElement;
  const dots       = document.querySelectorAll<HTMLButtonElement>(".pred-dot");
  const pageLabel  = document.getElementById("pred-page-label");
  const TOTAL      = 3;
  let   page       = 0;

  function goTo(p: number) {
    page = Math.max(0, Math.min(TOTAL - 1, p));
    track.style.transform = `translateX(-${page * viewport.clientWidth}px)`;
    dots.forEach((d, i) => {
      const active = i === page;
      d.style.width      = active ? "16px" : "6px";
      d.style.background = active ? "var(--c-brand)" : "var(--c-border-2)";
    });
    if (pageLabel) pageLabel.textContent = `${page + 1} / ${TOTAL}`;
    if (prevBtn) prevBtn.disabled = page === 0;
    if (nextBtn) nextBtn.disabled = page === TOTAL - 1;
  }

  prevBtn?.addEventListener("click", () => goTo(page - 1));
  nextBtn?.addEventListener("click", () => goTo(page + 1));
  dots.forEach((d) => d.addEventListener("click", () => goTo(Number(d.dataset.page))));
  window.addEventListener("resize", () => {
    track.style.transition = "none";
    goTo(page);
    requestAnimationFrame(() => { track.style.transition = "transform 0.35s cubic-bezier(0.4,0,0.2,1)"; });
  });
  goTo(0);

  // ── Chart trigger: poll window.__chartReg until hub charts register, then fire ──
  // Chart component scripts run in a separate bundle and may register after this
  // script executes. Poll rAF until all 3 hub charts are in the registry, then
  // trigger them. This guarantees execution regardless of bundle load order.
  const HUB_CHARTS = ["trailer-discovery-chart", "cpi-chart", "revenue-split-chart"];
  let pollAttempts = 0;

  function pollAndTriggerCharts() {
    const reg = (window as any).__chartReg as Map<string, () => void> | undefined;
    if (!reg) { if (pollAttempts++ < 60) requestAnimationFrame(pollAndTriggerCharts); return; }

    HUB_CHARTS.forEach(id => {
      const fn = reg.get(id);
      if (fn) { fn(); }
    });

    const remaining = HUB_CHARTS.filter(id => reg.has(id));
    if (remaining.length < HUB_CHARTS.length && pollAttempts++ < 60) {
      requestAnimationFrame(pollAndTriggerCharts);
    }
  }

  if (document.readyState === "complete") {
    requestAnimationFrame(pollAndTriggerCharts);
  } else {
    window.addEventListener("load", () => requestAnimationFrame(pollAndTriggerCharts), { once: true });
  }

</script>
