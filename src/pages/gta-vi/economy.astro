---
/**
 * /gta-vi/economy
 * GTA VI projected economy page — dual-territory currency union model.
 * Built on the CircularEconomy + ChartComplexityRadar components.
 * Predictions from economy-models analysis, populated Day-1 from scrapers.
 */
import Base from "../../layouts/Base.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import ShareDropdown from "../../components/ShareDropdown.astro";
import CircularEconomy from "../../components/CircularEconomy.astro";
import CardFooter from "../../components/CardFooter.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import ChartComplexityRadar from "../../components/ChartComplexityRadar.astro";
import GamePill from "../../components/GamePill.astro";
import ReadItBlock from "../../components/ReadItBlock.astro";

import type { EconomyModelsData, PredictionsData, TrailerVelocityData, RevenueSplitData } from "../../types/gta";

import economyDataRaw  from "../../../data/franchise/economy-models.json";
import predictionsRaw  from "../../../data/gta-6/predictions.json";
import velocityDataRaw from "../../../data/gta-6/trailer-velocity.json";
import gta6Rpp         from "../../../data/gta-6/economy/gta-rpp.json";
import revenueRaw      from "../../../data/franchise/revenue-split.json";

const economyData   = economyDataRaw  as unknown as EconomyModelsData;
const predictions   = predictionsRaw  as unknown as PredictionsData;
const velocityData  = velocityDataRaw as unknown as TrailerVelocityData;
const revenueData   = revenueRaw      as unknown as RevenueSplitData;

// GTA VI economy model entry
const economy = economyData.economies.find(e => e.title_id === "gta-6");

// Economic model predictions only
const econPreds = predictions.predictions.filter(
  p => p.prediction_method === "economic-model"
);

// Trailer view totals for context
const t1 = velocityData.trailers.find(t => t.youtube_id === "QdBZY2fkU-0");
const t2 = velocityData.trailers.find(t => t.youtube_id === "VQRLujxTm3c");
const totalViews = (t1?.snapshots?.at(-1)?.views ?? 0) + (t2?.snapshots?.at(-1)?.views ?? 0);

// GTA Online as predecessor reference
const onlineEconomy = economyData.economies.find(e => e.title_id === "gta-online");

// Revenue data for Shark Card injection card
const revYears   = revenueData.years;
const peakRevYear   = revYears.filter((y: any) => !y.is_prediction).reduce((a: any, b: any) => b.recurrent_bn > a.recurrent_bn ? b : a);
const latestRevYear = revYears.filter((y: any) => !y.is_prediction).at(-1);
const vi6Projection = revYears.find((y: any) => y.calendar_year === 2026);
---

<Base
  titleContext="gta-vi"
  title="GTA VI Economy — Dual-Territory Currency Union"
  description="GTA VI projected economy analysis: dual-territory currency union (Vice City + Leonida), regional purchasing parity, Shark Card mechanics, and the Eurozone analogue. Updated as intelligence confirms."
  ogPage="vi-intel"
>

  <!-- Hero header -->
  <section class="relative border-b border-border-dim overflow-hidden" style="min-height:260px">
    <div class="absolute inset-0" style="background:radial-gradient(ellipse at 70% 50%, var(--c-hero-bloom) 0%, transparent 65%), var(--c-bg-deep)"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center gap-2 mb-4">
        <GamePill game="gta-vi" size="xs" />
        <span class="text-[11px] font-mono bg-gta-gold/20 border border-gta-gold/30 text-gta-gold/80 px-2 py-0.5 rounded uppercase tracking-widest">Projected</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3">
        GTA VI Economy
      </h1>
      <p class="text-zinc-300 text-sm leading-relaxed mb-6 max-w-xl">
        The most structurally sophisticated virtual economy ever designed.
        Two territories, one currency — a <strong class="text-gta-gold">dual-territory currency union</strong>
        analogous to the Eurozone. Everything we know and predict, sourced from the franchise arc.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl">
        {[
          { value: "17",        label: "complexity score",        sub: "franchise maximum" },
          { value: "2",         label: "economic territories",    sub: "Vice City · Leonida" },
          { value: `${econPreds.length}`,  label: "economic predictions",   sub: "model-derived" },
          { value: `${Math.round(totalViews / 1e6)}M`, label: "trailer views · combined", sub: "live · YouTube API" },
        ].map(s => (
          <div class="rounded-xl border border-border-dim px-4 py-3" style="background:var(--c-card)">
            <div class="text-xl font-mono font-black text-gta-gold">{s.value}</div>
            <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug">{s.label}</div>
            <div class="text-[10px] font-mono text-zinc-400 mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">

    <!-- ═══════════════════════════════════════════════════════
         CIRCULAR ECONOMY DIAGRAM
    ═══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader label="// Projected Circular Economy" dotColor="var(--c-title-vi)" />
      <div class="rounded-xl border border-border-dim p-6" style="background:var(--c-bg)">
        <CircularEconomy titleId="gta-6" mode="full" />
        <CardFooter anchorId="eco-gta-vi" sources="Source: GTAVI.AI Economic Model — predicted pre-launch · GTA Online precedent · trailer analysis" shareText="GTA VI predicted economy: Full MMT sovereign with dual-territory model. Predicted to surpass GTA Online in complexity at launch. 10 active income predictions tracked." />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         COMPLEXITY RADAR
    ═══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader label="// Economic Complexity — Franchise Context" dotColor="var(--c-title-vi)" pillHref="/franchise/economics" pillLabel="All 10 economies →" />
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <ChartComplexityRadar titleId="gta-6" size={280} showAverage={true} />
        <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
          <div class="px-5 py-3 border-b border-border-dim">
            <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest">Franchise Arc — Complexity Trajectory</div>
            <div class="text-[10px] font-mono text-zinc-600 mt-0.5">Complexity score / 17 max per title</div>
          </div>
          <div class="px-5 py-4 flex flex-col gap-2">
            {economyData.economies.map((e) => {
              const pct = Math.round((e.complexity_score / 17) * 100);
              const isGtaVI = e.title_id === "gta-6";
              const isRegression = e.regression_era;
              const color = isGtaVI ? "var(--c-brand)" : isRegression ? "var(--c-alert)" : "var(--c-live)";
              return (
                <div class="flex items-center gap-3">
                  <div class="w-20 shrink-0 text-[11px] font-mono text-zinc-500 text-right">{e.short}</div>
                  <div class="flex-1 h-2 rounded-full overflow-hidden" style="background:var(--c-border-1)">
                    <div class="h-full rounded-full transition-all"
                         style={`width:${pct}%;background:${color};opacity:${isRegression ? 0.5 : 0.75}${e.projected ? ";border-right:2px dashed " + color : ""}`}></div>
                  </div>
                  <div class="w-6 text-right text-[11px] font-mono shrink-0" style={`color:${color}`}>{e.complexity_score}</div>
                </div>
              );
            })}
          </div>
          <div class="px-5 pb-3 pt-0 text-[11px] font-mono text-zinc-600 leading-relaxed border-t border-border-dim pt-3">
            {economyData.complexity_chart_note}
          </div>
          <div class="px-5 py-3 border-t border-border-dim flex items-center justify-between gap-3">
            <div class="flex items-center gap-4 text-[11px] font-mono text-zinc-500 flex-wrap">
              <span class="flex items-center gap-1.5">
                <div class="w-4 h-1.5 rounded-full shrink-0" style="background:var(--c-live);opacity:0.75"></div>
                Standard
              </span>
              <span class="flex items-center gap-1.5">
                <div class="w-4 h-1.5 rounded-full shrink-0" style="background:var(--c-alert);opacity:0.5"></div>
                Regression era
              </span>
              <span class="flex items-center gap-1.5">
                <div class="w-4 h-1.5 rounded-full shrink-0" style="background:var(--c-brand);opacity:0.75"></div>
                GTA VI
              </span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-[10px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span>
              <ShareDropdown anchorId="eco-complexity" shareText="GTA VI projected economic complexity: 17/17 — the franchise maximum. Every prior title mapped across 5 dimensions. GTAVI.AI" size="sm" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         THE EUROZONE ANALOGY
    ═══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader label="// The Eurozone Analogy" dotColor="var(--c-brand)" class="mb-6" />
      <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-border-dim">
          <div class="px-6 py-5">
            <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-3">GTA VI Model</div>
            <div class="space-y-2.5">
              {[
                { label: "Monetary authority", value: "Rockstar / Take-Two (as ECB)" },
                { label: "Currency", value: "GTA$ — single non-convertible currency" },
                { label: "Region 1 (core)", value: "Vice City — urban, dense, high-wage" },
                { label: "Region 2 (periphery)", value: "Leonida — rural, sparse, low-wage" },
                { label: "Real-money injection", value: "Shark Cards — cross-region float" },
                { label: "Inflation mechanism", value: "Nerf-driven + SC ratio + regional divergence" },
              ].map(r => (
                <div class="flex items-start gap-3">
                  <div class="text-[11px] font-mono text-zinc-500 w-36 shrink-0 pt-0.5">{r.label}</div>
                  <div class="text-[10px] font-mono text-zinc-200">{r.value}</div>
                </div>
              ))}
            </div>
          </div>
          <div class="px-6 py-5">
            <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-3">Eurozone Parallel</div>
            <div class="space-y-2.5">
              {[
                { label: "Monetary authority", value: "European Central Bank" },
                { label: "Currency", value: "Euro — single shared currency" },
                { label: "Core", value: "Germany / France — high productivity, high wages" },
                { label: "Periphery", value: "Greece / Portugal — lower wages, lower costs" },
                { label: "External capital", value: "Bond markets, Target2 balances" },
                { label: "Inflation mechanism", value: "ECB rate policy + structural divergence" },
              ].map(r => (
                <div class="flex items-start gap-3">
                  <div class="text-[11px] font-mono text-zinc-500 w-36 shrink-0 pt-0.5">{r.label}</div>
                  <div class="text-[10px] font-mono text-zinc-200">{r.value}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="px-6 py-4 border-t border-border-dim">
          <p class="text-[11px] font-mono text-zinc-300 leading-relaxed">
            GTA VI would be the first virtual economy structurally analogous to the Eurozone — one monetary authority,
            two structurally different regional economies, one currency. If price divergence is real,
            GTA-RPP (Regional Purchasing Parity) would differ by territory — a new research axis unique to this site.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         GTA-RPP — REGIONAL PURCHASING PARITY
    ═══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader label="// GTA-RPP — Regional Purchasing Parity" dotColor="var(--c-live)" pillLabel="Day-1 ready · awaiting launch data" class="mb-6" />
      <div class="rounded-xl border border-gta-teal/20 p-6" style="background:color-mix(in srgb,var(--c-growth) 4%,var(--c-bg))">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-5">
          {[
            { label: "Vice City RPP",  value: "—",     sub: "Populates at launch", color: "var(--c-brand)" },
            { label: "Leonida RPP",    value: "—",     sub: "Populates at launch", color: "var(--c-live)" },
            { label: "RPP Ratio",      value: "—",     sub: "VC ÷ Leonida", color: "var(--c-growth)" },
          ].map(s => (
            <div class="rounded-lg border border-border-mid px-4 py-3 text-center" style="background:var(--c-card)">
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-1">{s.label}</div>
              <div class="text-2xl font-mono font-black" style={`color:${s.color};opacity:var(--o-muted)`}>{s.value}</div>
              <div class="text-[11px] font-mono text-zinc-500 mt-1">{s.sub}</div>
            </div>
          ))}
        </div>
        <div class="text-[11px] font-mono text-gta-teal leading-relaxed">
          <strong class="text-gta-teal">Formula:</strong> GTA-RPP = regional basket cost ÷ regional top hourly yield.
          The GTA-PPI (currently tracking GTA Online) is the single-market predecessor.
          GTA-RPP extends this to measure cross-territory purchasing power divergence — if Vice City wages are
          higher but prices are higher by a larger factor, Leonida players have higher real purchasing power.
          Computed nightly from confirmed launch-day data. <span class="text-gta-teal">Status: {(gta6Rpp as { status?: string }).status}.</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         FIVE FLOWS — PROJECTED
    ═══════════════════════════════════════════════════════ -->
    <section id="five-flows" style="scroll-margin-top:80px">
      <SectionHeader label="// Money Flows — Dual-Territory Projection" dotColor="var(--c-title-vi)" pillHref="/gta-online/economy" pillLabel="GTA Online live model →" />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

        <!-- Flow ① — VC Income -->
        <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
          <div class="px-5 py-4">
            <div class="flex items-center justify-between mb-2">
              <div class="text-[11px] font-mono uppercase tracking-[0.2em] flex items-center gap-1.5" style="color:color-mix(in srgb,var(--c-title-vi) 60%,transparent)">
                <span class="font-mono font-black text-[18px] mr-1.5 leading-none" style="color:var(--c-income)">①</span>BUSINESSES (VC) → PLAYERS
              </div>
              <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest" style="border-color:color-mix(in srgb,var(--c-income) 40%,transparent);background:color-mix(in srgb,var(--c-income) 12%,transparent);color:var(--c-income)">Y · INCOME</span>
            </div>
            <div class="text-lg font-bold text-white">Vice City Hourly Yield</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Top-tier activity $/hr in Vice City. The in-game "real wage" — urban, high-density territory.</div>
          </div>
          <div class="px-5 py-2 border-t border-b border-border-dim" style="background:var(--c-bg)">
            <span class="text-[10px] font-mono text-zinc-600">Projected above GTA Online 2022 meta — Vice City is the premium territory</span>
          </div>
          <div class="px-5 py-3 border-t border-border-dim grid grid-cols-2 gap-4">
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">DAY-1 ESTIMATE</div>
              <div class="text-2xl font-black" style="color:var(--c-income)">—</div>
              <div class="text-[10px] font-mono text-zinc-500">awaiting launch data</div>
            </div>
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">GTA ONLINE BASELINE</div>
              <div class="text-2xl font-black text-zinc-400">{Math.round((onlineEconomy?.complexity_score ?? 0) > 0 ? 1700 : 0) > 0 ? "$1,700K/hr" : "—"}</div>
              <div class="text-[10px] font-mono text-zinc-500">current GTA Online meta</div>
            </div>
          </div>
          <div class="px-5 pb-3">
            <ReadItBlock accentColor="var(--c-income)">Vice City wages are projected to launch above the GTA Online 2022 Cayo Perico meta ($1.7M/hr) — Rockstar needs to hook new players immediately. Historical precedent: every new Online launch resets the wage ceiling upward. GTA-RPP will measure whether VC prices rise proportionally.</ReadItBlock>
          </div>
          <div class="px-4 pb-3 flex items-center justify-between border-t border-border-dim pt-2.5">
            <span class="text-[10px] font-mono text-zinc-600">Monitoring · populates at launch</span>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-[10px] font-mono text-zinc-500 tracking-widest">GTAVI.AI</span>
              <ShareDropdown anchorId="flow-vc-income" shareText="GTA VI Vice City income: projected to launch above GTA Online's $1.7M/hr meta. Dual-territory RPP model tracking on GTAVI.AI." size="sm" />
            </div>
          </div>
        </div>

        <!-- Flow ② — Leonida Income -->
        <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
          <div class="px-5 py-4">
            <div class="flex items-center justify-between mb-2">
              <div class="text-[11px] font-mono uppercase tracking-[0.2em] flex items-center gap-1.5" style="color:color-mix(in srgb,var(--c-growth) 60%,transparent)">
                <span class="font-mono font-black text-[18px] mr-1.5 leading-none" style="color:var(--c-growth)">②</span>BUSINESSES (LEONIDA) → PLAYERS
              </div>
              <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest" style="border-color:color-mix(in srgb,var(--c-growth) 40%,transparent);background:color-mix(in srgb,var(--c-growth) 12%,transparent);color:var(--c-growth)">Y · INCOME</span>
            </div>
            <div class="text-lg font-bold text-white">Leonida Hourly Yield</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Rural-territory wages — lower baseline predicted vs Vice City (Eurozone periphery model).</div>
          </div>
          <div class="px-5 py-2 border-t border-b border-border-dim" style="background:var(--c-bg)">
            <span class="text-[10px] font-mono text-zinc-600">RPP divergence predicted — Leonida costs lower; real purchasing power may exceed VC despite lower wages</span>
          </div>
          <div class="px-5 py-3 border-t border-border-dim grid grid-cols-2 gap-4">
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">DAY-1 ESTIMATE</div>
              <div class="text-2xl font-black" style="color:var(--c-growth)">—</div>
              <div class="text-[10px] font-mono text-zinc-500">awaiting launch data</div>
            </div>
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">GTA-RPP STATUS</div>
              <div class="text-2xl font-black text-zinc-400">{(gta6Rpp as any).status ?? "pending"}</div>
              <div class="text-[10px] font-mono text-zinc-500">regional parity index</div>
            </div>
          </div>
          <div class="px-5 pb-3">
            <ReadItBlock accentColor="var(--c-growth)">In the Eurozone model, peripheral economies (Greece, Portugal) have lower nominal wages but often better real purchasing power once prices are adjusted. Leonida is predicted to follow this pattern — lower $/hr, but lower costs for property and businesses. The GTA-RPP index will quantify the divergence from day one.</ReadItBlock>
          </div>
          <div class="px-4 pb-3 flex items-center justify-between border-t border-border-dim pt-2.5">
            <a href="/gta-vi/economy#eco-gta-vi" class="text-[10px] font-mono text-zinc-500 hover:text-zinc-200 transition-colors tracking-widest uppercase">Full model →</a>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-[10px] font-mono text-zinc-500 tracking-widest">GTAVI.AI</span>
              <ShareDropdown anchorId="flow-leonida-income" shareText="GTA VI Leonida income: lower wages than Vice City predicted, but higher real purchasing power. Eurozone model applied to GTA VI. GTAVI.AI" size="sm" />
            </div>
          </div>
        </div>

        <!-- Flow ③ — Cross-territory -->
        <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
          <div class="px-5 py-4">
            <div class="flex items-center justify-between mb-2">
              <div class="text-[11px] font-mono uppercase tracking-[0.2em] flex items-center gap-1.5" style="color:color-mix(in srgb,var(--c-economy) 60%,transparent)">
                <span class="font-mono font-black text-[18px] mr-1.5 leading-none" style="color:var(--c-economy)">③</span>PLAYERS (VC) → PLAYERS (LEONIDA)
              </div>
              <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest" style="border-color:color-mix(in srgb,var(--c-economy) 40%,transparent);background:color-mix(in srgb,var(--c-economy) 12%,transparent);color:var(--c-economy)">CROSS-TERRITORY</span>
            </div>
            <div class="text-lg font-bold text-white">Regional Currency Carry</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">GTA$ flow across the territorial boundary — a new flow unique to GTA VI's dual model.</div>
          </div>
          <div class="px-5 py-2 border-t border-b border-border-dim" style="background:var(--c-bg)">
            <span class="text-[10px] font-mono text-zinc-600">New flow — no GTA Online precedent · monitoring from launch · qualitative model only</span>
          </div>
          <div class="px-5 py-3 border-t border-border-dim grid grid-cols-2 gap-4">
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">FLOW TYPE</div>
              <div class="text-xl font-black" style="color:var(--c-economy)">Bidirectional</div>
              <div class="text-[10px] font-mono text-zinc-500">players spend across regions</div>
            </div>
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">PRECEDENT</div>
              <div class="text-xl font-black text-zinc-500">None</div>
              <div class="text-[10px] font-mono text-zinc-500">first dual-territory GTA</div>
            </div>
          </div>
          <div class="px-5 pb-3">
            <ReadItBlock accentColor="var(--c-economy)">Whether players can freely carry GTA$ between Vice City and Leonida — or face regional spending restrictions — determines whether this is a true currency union or two parallel economies. Trailer evidence shows travel between regions. GTAVI.AI will track cross-territory transaction patterns from day one.</ReadItBlock>
          </div>
          <div class="px-4 pb-3 flex items-center justify-between border-t border-border-dim pt-2.5">
            <span class="text-[10px] font-mono text-zinc-600">New metric — tracked from launch</span>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-[10px] font-mono text-zinc-500 tracking-widest">GTAVI.AI</span>
              <ShareDropdown anchorId="flow-cross-territory" shareText="GTA VI has no GTA Online precedent for cross-territory money flow. First dual-territory GTA — tracking from launch. GTAVI.AI" size="sm" />
            </div>
          </div>
        </div>

        <!-- Flow ④ — Shark Card Injection -->
        <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
          <div class="px-5 py-4">
            <div class="flex items-center justify-between mb-2">
