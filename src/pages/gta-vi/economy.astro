---
/**
 * /gta-vi/economy
 * GTA VI projected economy page — dual-territory currency union model.
 * Built on the CircularEconomy + ChartComplexityRadar components.
 * Predictions from economy-models analysis, populated Day-1 from scrapers.
 */
import Base from "../../layouts/Base.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import ShareDropdown from "../../components/ShareDropdown.astro";
import CircularEconomy from "../../components/CircularEconomy.astro";
import ChartComplexityRadar from "../../components/ChartComplexityRadar.astro";

import type { EconomyModelsData, PredictionsData, TrailerVelocityData } from "../../types/gta";

import economyDataRaw  from "../../../data/franchise/economy-models.json";
import predictionsRaw  from "../../../data/gta-6/predictions.json";
import velocityDataRaw from "../../../data/gta-6/trailer-velocity.json";
import gta6Rpp         from "../../../data/gta-6/economy/gta-rpp.json";

const economyData   = economyDataRaw  as unknown as EconomyModelsData;
const predictions   = predictionsRaw  as unknown as PredictionsData;
const velocityData  = velocityDataRaw as unknown as TrailerVelocityData;

// GTA VI economy model entry
const economy = economyData.economies.find(e => e.title_id === "gta-6");

// Economic model predictions only
const econPreds = predictions.predictions.filter(
  p => p.prediction_method === "economic-model"
);

// Trailer view totals for context
const t1 = velocityData.trailers.find(t => t.youtube_id === "QdBZY2fkU-0");
const t2 = velocityData.trailers.find(t => t.youtube_id === "VQRLujxTm3c");
const totalViews = (t1?.snapshots?.at(-1)?.views ?? 0) + (t2?.snapshots?.at(-1)?.views ?? 0);

// GTA Online as predecessor reference
const onlineEconomy = economyData.economies.find(e => e.title_id === "gta-online");
---

<Base
  titleContext="gta-vi"
  title="GTA VI Economy — Dual-Territory Currency Union"
  description="GTA VI projected economy analysis: dual-territory currency union (Vice City + Leonida), regional purchasing parity, Shark Card mechanics, and the Eurozone analogue. Updated as intelligence confirms."
  ogPage="vi-intel"
>

  <!-- Hero header -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden" style="min-height:260px">
    <div class="absolute inset-0" style="background:radial-gradient(ellipse at 70% 50%, var(--c-hero-bloom) 0%, transparent 65%), #0a0a0d"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[11px] font-mono bg-gta-gold/30 border border-gta-gold/40 text-gta-gold px-2 py-0.5 rounded uppercase tracking-widest">ERA 5 · 2025/26</span>
        <span class="text-[11px] font-mono bg-gta-gold/20 border border-gta-gold/30 text-gta-gold/80 px-2 py-0.5 rounded uppercase tracking-widest">Projected</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3">
        GTA VI Economy
      </h1>
      <p class="text-zinc-300 text-sm leading-relaxed mb-6 max-w-xl">
        The most structurally sophisticated virtual economy ever designed.
        Two territories, one currency — a <strong class="text-gta-gold">dual-territory currency union</strong>
        analogous to the Eurozone. Everything we know and predict, sourced from the franchise arc.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl">
        {[
          { value: "17",        label: "complexity score",        sub: "franchise maximum" },
          { value: "2",         label: "economic territories",    sub: "Vice City · Leonida" },
          { value: `${econPreds.length}`,  label: "economic predictions",   sub: "model-derived" },
          { value: `${Math.round(totalViews / 1e6)}M`, label: "trailer views · combined", sub: "live · YouTube API" },
        ].map(s => (
          <div class="rounded-xl border border-[#1e1e23] px-4 py-3" style="background:#131316">
            <div class="text-xl font-mono font-black text-gta-gold">{s.value}</div>
            <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug">{s.label}</div>
            <div class="text-[10px] font-mono text-zinc-400 mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">

    <!-- ═══════════════════════════════════════════════════════
         CIRCULAR ECONOMY DIAGRAM
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="identity-dot"></span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Projected Circular Economy</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-500">dual-territory · all nodes projected</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] p-6" style="background:#0e0e11">
        <CircularEconomy titleId="gta-6" mode="full" />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         COMPLEXITY RADAR
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="identity-dot"></span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Economic Complexity — Franchise Context</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/franchise/economics" class="text-[10px] font-mono text-zinc-500 hover:text-zinc-400 transition-colors tracking-widest uppercase">All 10 economies →</a>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <ChartComplexityRadar titleId="gta-6" size={280} showAverage={true} />
        <div class="rounded-xl border border-[#1e1e23] p-5" style="background:#131316">
          <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-4">Franchise Arc — Complexity Trajectory</div>
          <div class="flex flex-col gap-2">
            {economyData.economies.map((e) => {
              const pct = Math.round((e.complexity_score / 17) * 100);
              const isGtaVI = e.title_id === "gta-6";
              const isRegression = e.regression_era;
              const color = isGtaVI ? "#f59e0b" : isRegression ? "#ef4444" : "#0d9488";
              return (
                <div class="flex items-center gap-3">
                  <div class="w-20 shrink-0 text-[11px] font-mono text-zinc-500 text-right">{e.short}</div>
                  <div class="flex-1 h-2 rounded-full bg-[#1e1e23] overflow-hidden">
                    <div class="h-full rounded-full transition-all"
                         style={`width:${pct}%;background:${color};opacity:${isRegression ? 0.5 : 0.75}${e.projected ? ";border-right:2px dashed " + color : ""}`}></div>
                  </div>
                  <div class="w-6 text-right text-[11px] font-mono shrink-0" style={`color:${color}`}>{e.complexity_score}</div>
                </div>
              );
            })}
          </div>
          <div class="mt-3 pt-3 border-t border-[#1e1e23] text-[11px] font-mono text-zinc-500 leading-relaxed">
            {economyData.complexity_chart_note}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         THE EUROZONE ANALOGY
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[11px] font-mono bg-gta-gold/30 border border-gta-gold/40 text-gta-gold px-2 py-0.5 rounded uppercase tracking-widest">Analysis</span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// The Eurozone Analogy</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-[#1e1e23]">
          <div class="px-6 py-5">
            <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-3">GTA VI Model</div>
            <div class="space-y-2.5">
              {[
                { label: "Monetary authority", value: "Rockstar / Take-Two (as ECB)" },
                { label: "Currency", value: "GTA$ — single non-convertible currency" },
                { label: "Region 1 (core)", value: "Vice City — urban, dense, high-wage" },
                { label: "Region 2 (periphery)", value: "Leonida — rural, sparse, low-wage" },
                { label: "Real-money injection", value: "Shark Cards — cross-region float" },
                { label: "Inflation mechanism", value: "Nerf-driven + SC ratio + regional divergence" },
              ].map(r => (
                <div class="flex items-start gap-3">
                  <div class="text-[11px] font-mono text-zinc-500 w-36 shrink-0 pt-0.5">{r.label}</div>
                  <div class="text-[10px] font-mono text-zinc-200">{r.value}</div>
                </div>
              ))}
            </div>
          </div>
          <div class="px-6 py-5">
            <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-3">Eurozone Parallel</div>
            <div class="space-y-2.5">
              {[
                { label: "Monetary authority", value: "European Central Bank" },
                { label: "Currency", value: "Euro — single shared currency" },
                { label: "Core", value: "Germany / France — high productivity, high wages" },
                { label: "Periphery", value: "Greece / Portugal — lower wages, lower costs" },
                { label: "External capital", value: "Bond markets, Target2 balances" },
                { label: "Inflation mechanism", value: "ECB rate policy + structural divergence" },
              ].map(r => (
                <div class="flex items-start gap-3">
                  <div class="text-[11px] font-mono text-zinc-500 w-36 shrink-0 pt-0.5">{r.label}</div>
                  <div class="text-[10px] font-mono text-zinc-200">{r.value}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="px-6 py-4 border-t border-[#1e1e23]">
          <p class="text-[11px] font-mono text-zinc-300 leading-relaxed">
            GTA VI would be the first virtual economy structurally analogous to the Eurozone — one monetary authority,
            two structurally different regional economies, one currency. If price divergence is real,
            GTA-RPP (Regional Purchasing Parity) would differ by territory — a new research axis unique to this site.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         GTA-RPP — REGIONAL PURCHASING PARITY
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[11px] font-mono bg-gta-teal/30 border border-gta-teal/40 text-gta-teal px-2 py-0.5 rounded uppercase tracking-widest">New Metric</span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// GTA-RPP — Regional Purchasing Parity</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-500">Day-1 ready · awaiting launch data</span>
      </div>
      <div class="rounded-xl border border-gta-teal/20 p-6" style="background:#0e1a10">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-5">
          {[
            { label: "Vice City RPP",  value: "—",     sub: "Populates at launch", color: "#f59e0b" },
            { label: "Leonida RPP",    value: "—",     sub: "Populates at launch", color: "#0d9488" },
            { label: "RPP Ratio",      value: "—",     sub: "VC ÷ Leonida", color: "#22c55e" },
          ].map(s => (
            <div class="rounded-lg border border-[#2a2a31] px-4 py-3 text-center" style="background:#131316">
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-1">{s.label}</div>
              <div class="text-2xl font-mono font-black" style={`color:${s.color};opacity:0.4`}>{s.value}</div>
              <div class="text-[11px] font-mono text-zinc-500 mt-1">{s.sub}</div>
            </div>
          ))}
        </div>
        <div class="text-[11px] font-mono text-gta-teal leading-relaxed">
          <strong class="text-gta-teal">Formula:</strong> GTA-RPP = regional basket cost ÷ regional top hourly yield.
          The GTA-PPI (currently tracking GTA Online) is the single-market predecessor.
          GTA-RPP extends this to measure cross-territory purchasing power divergence — if Vice City wages are
          higher but prices are higher by a larger factor, Leonida players have higher real purchasing power.
          Computed nightly from confirmed launch-day data. <span class="text-gta-teal">Status: {(gta6Rpp as { status?: string }).status}.</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         ECONOMIC PREDICTIONS
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="identity-dot"></span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Economic Structure Predictions</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-500">{econPreds.length} model-derived</span>
      </div>
      <div class="flex flex-col gap-3">
        {econPreds.map((pred: any) => {
          const tierColor = pred.confidence_tier === "reported" ? "#22c55e" : pred.confidence_tier === "confirmed" ? "#0d9488" : "#f59e0b";
          const tierLabel = pred.confidence_tier === "reported" ? "Reported" : pred.confidence_tier === "confirmed" ? "Confirmed" : "Predicted";
          return (
            <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
              <div class="px-5 py-4 flex items-start gap-4">
                <div class="shrink-0 flex flex-col items-center gap-1 pt-0.5">
                  <div class="text-[10px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest"
                       style={`color:${tierColor};border-color:${tierColor}40`}>{tierLabel}</div>
                  <div class="text-lg font-mono font-black" style={`color:${tierColor}`}>{pred.confidence}%</div>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="font-semibold text-zinc-200 text-sm mb-1">
                    {pred.title}
                  </div>
                  <div class="text-[10px] font-mono text-zinc-400 leading-relaxed mb-2">
                    {pred.basis}
                  </div>
                  {pred.prediction_range && (
                    <div class="flex items-center gap-3 text-[11px] font-mono text-zinc-500">
                      <span>Low: {pred.prediction_range.low}</span>
                      <span>·</span>
                      <span>High: {pred.prediction_range.high}</span>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         GTA ONLINE → GTA VI LINEAGE
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Economic Lineage — The Arc Ends Here</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="rounded-xl border border-[#1e1e23] p-5" style="background:#131316">
        <p class="text-[11px] font-mono text-zinc-500 leading-relaxed mb-4">
          {economy?.summary}
        </p>
        <div class="rounded-lg border border-gta-gold/15 px-4 py-3" style="background:var(--c-hero-bloom)">
          <div class="text-[10px] font-mono text-gta-gold/40 uppercase tracking-widest mb-1">GTA Online → GTA VI</div>
          <p class="text-[11px] font-mono text-zinc-400 leading-relaxed">{economy?.gta_vi_lineage}</p>
        </div>
      </div>
    </section>

    <!-- Footer CTAs -->
    <div class="flex items-center gap-3 flex-wrap">
      <a href="/franchise/economics" class="px-4 py-2 rounded border border-[#2a2a31] text-zinc-400 text-[11px] font-mono hover:border-zinc-600 hover:text-zinc-200 transition-all">
        ← Ten Economies: Full Arc
      </a>
      <a href="/gta-online/economy" class="px-4 py-2 rounded border border-gta-teal/30 text-gta-teal text-[11px] font-mono hover:bg-gta-teal/20 transition-all">
        GTA Online Economy Model →
      </a>
      <a href="/gta-vi/intel" class="px-4 py-2 rounded border border-gta-gold/20 text-gta-gold text-[11px] font-mono hover:bg-gta-gold/8 transition-all">
        GTA VI Intel & Predictions →
      </a>
      <div class="ml-auto">
        <ShareDropdown anchorId="economy" shareText="GTA VI economy analysis: dual-territory currency union (Vice City + Leonida) — the Eurozone analogy applied to the most complex virtual economy ever designed." size="sm" />
      </div>
    </div>

    <CrossLinks context="gta-online-economy" />
  </div>
</Base>
