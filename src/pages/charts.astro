---
// ── Layout + registry ─────────────────────────────────────────────────────────
import Base from "../layouts/Base.astro";
import CrossLinks from "../components/CrossLinks.astro";
import ChartSection from "../components/ChartSection.astro";
import { CHARTS_PAGE_ORDER, getChart } from "../config/allCharts";

// ── Data imports (for dynamic meta strings + page header strip) ───────────────
import salesData         from "../../data/franchise/sales.json";
import steamData         from "../../data/gta-5/meta/steam-players.json";
import dlcData           from "../../data/gta-5/dlc/timeline.json";
import vehicleData       from "../../data/gta-5/vehicles/performance.json";
import velocityData      from "../../data/gta-6/trailer-velocity.json";
import trailerAnalysis   from "../../data/gta-6/trailer-analysis.json";
import delayData         from "../../data/gta-6/delay-timeline.json";
import regionsData       from "../../data/franchise/regions-evidence.json";
import competitorData    from "../../data/franchise/competitors.json";
import ttwoStock         from "../../data/franchise/ttwo-stock.json";
import franchiseEconData from "../../data/franchise/economic-history.json";
import bonusHistoryData  from "../../data/gta-5/economy/bonus-history.json";
import sharkCardData     from "../../data/gta-5/economy/shark-cards.json";
import propertiesData    from "../../data/gta-5/economy/properties.json";
import priceChangesData  from "../../data/gta-5/economy/price-changes.json";
import sourceHistoryData from "../../data/gta-5/economy/per-source-history.json";
import vehicleModsData   from "../../data/gta-5/economy/vehicle-mods.json";
import gtaPpiData        from "../../data/gta-5/economy/gta-ppi.json";
import passiveStackData  from "../../data/gta-5/economy/passive-stack.json";
import metaHistoryData   from "../../data/gta-5/economy/meta-history.json";
import heistsData        from "../../data/gta-5/economy/online-heists.json";
import spendingDistData  from "../../data/gta-5/economy/spending-distribution.json";

// ── Filter system constants ───────────────────────────────────────────────────
const CATEGORIES = ["All", "Economy-IG", "Economy-RL", "Promotions", "Performance", "Community", "History"] as const;
const CAT_LABELS: Record<string, string> = {
  "All":        "All",
  "Economy-IG": "⚡ Economy (In-Game)",
  "Economy-RL": "📊 Economy (Real-Life)",
  "Promotions": "🏷 Promotions",
  "Performance":"🏎 Performance",
  "Community":  "🌐 Community",
  "History":    "📖 Franchise History",
};

// ── Page header stats ─────────────────────────────────────────────────────────
const t1 = velocityData.trailers.find((t: any) => t.youtube_id === "QdBZY2fkU-0");
const t2 = velocityData.trailers.find((t: any) => t.youtube_id === "VQRLujxTm3c");
const t1Views = t1?.snapshots?.at(-1)?.views ?? 0;
const t2Views = t2?.snapshots?.at(-1)?.views ?? 0;

// ── Dynamic meta strings — chart IDs that need build-time data ────────────────
// Static metas live in allCharts.ts. Dynamic ones (computed from data files)
// are overridden here via the ChartSection meta prop.
const DYNAMIC_METAS: Record<string, string> = {
  "trailer-discovery-chart":    `${trailerAnalysis.trailers[0].total_entities + trailerAnalysis.trailers[1].total_entities} entities discovered`,
  "delay-timeline-chart":       `${delayData.total_delays} delay · ${delayData.timeline.length} events`,
  "region-heatmap":             `${regionsData.regions.filter((r: any) => r.confirmed).length} confirmed regions`,
  "competitors-chart":          `${competitorData.games.length} titles compared`,
  "meta-evolution-chart":       `${(metaHistoryData as any).meta_history.length} patches tracked`,
  "gta-ppi-chart":              `${(gtaPpiData as any).series.length} patches · base 100 = Oct 2013`,
  "passive-stack-chart":        `4 streams · $${((passiveStackData as any).setup_cost_total / 1e6).toFixed(1)}M GTA$ setup`,
  "shark-card-chart":           `${sharkCardData.analysis?.years_span} years · ${sharkCardData.analysis?.purchasing_power_ratio}× purchasing power`,
  "heist-comparison-chart":     `${(heistsData as any).heists.length} heists`,
  "income-history-chart":       `${(sourceHistoryData as any).source_count} sources · ${(sourceHistoryData as any).snapshot_count} patches`,
  "vehicle-tco-chart":          `${(vehicleModsData as any).vehicle_count} vehicles`,
  "property-cost-chart":        `${(propertiesData as any).property_count} properties`,
  "spending-distribution-chart":`${(spendingDistData as any).eras.length} eras`,
  "price-history-chart":        `${(priceChangesData as any).change_count} events · ${(priceChangesData as any).item_count} items`,
  "bonus-heatmap":              `${(bonusHistoryData as any).entry_count} weeks tracked`,
  "dlc-player-chart":           `${steamData.data.length} months · DLC annotated`,
  "perf-chart":                 `${vehicleData.vehicles.length} vehicles · Broughy1322`,
  "sales-chart":                salesData.last_updated.slice(0, 10),
  "dlc-cadence-chart":          `${dlcData.updates.filter((u: any) => u.category === "major").length} major updates`,
  "ttwo-stock-chart":           `${ttwoStock.prices.length} months · Yahoo Finance`,
  "franchise-complexity-chart": `${(franchiseEconData as any).title_count} titles · 1997 → 2026`,
};

// ── Link-type right-side elements (anchor instead of text span) ───────────────
const LINK_METAS: Record<string, { href: string; label: string }> = {
  "income-leaderboard-chart":    { href: "/database", label: "Full profiles →" },
  "roi-scatter-chart":           { href: "/database", label: "Full profiles →" },
  "assassination-returns-chart": { href: "/gta-v",    label: "Full stock guide →" },
};

// ── Build the ordered chart list ──────────────────────────────────────────────
const chartsInOrder = CHARTS_PAGE_ORDER.map(id => getChart(id)).filter(Boolean) as NonNullable<ReturnType<typeof getChart>>[];
---


<Base
  titleContext="franchise"
  title="Charts"
  description="GTA franchise data visualised — sales velocity, player history, search hype, vehicle performance and more."
  ogPage="charts"
>

  <!-- Page header -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden">
    <div class="absolute inset-0">
      <img src="/assets/gta6/locations/Ambrosia_02.jpg" alt="" class="w-full h-full object-cover" style="object-position:center 55%" aria-hidden="true" />
      <div class="absolute inset-0" style="background:linear-gradient(to right, #0a0a0d 0%, #0a0a0dcc 55%, #0a0a0d88 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom, transparent 0%, #0a0a0d 100%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// Data Intelligence</div>
          <h1 class="text-3xl font-bold text-white mb-2">Charts</h1>
          <p class="text-sm text-zinc-400 max-w-lg">
            The GTA franchise quantified. Every chart is filterable, sourced, and updated nightly.
          </p>
          <!-- Game cover strip -->
          <div class="flex items-center gap-2.5 mt-5">
            {([
              { id: "gta-1",  short: "GTA 1"  },
              { id: "gta-2",  short: "GTA 2"  },
              { id: "gta-3",  short: "GTA III" },
              { id: "gta-vc", short: "GTA VC"  },
              { id: "gta-sa", short: "GTA SA"  },
              { id: "gta-4",  short: "GTA IV"  },
              { id: "gta-5",  short: "GTA V"   },
              { id: "gta-6",  short: "GTA VI"  },
            ] as const).map(g => (
              <div class="flex flex-col items-center gap-1 group">
                <img
                  src={`/assets/covers/${g.id}.jpg`}
                  alt={g.short}
                  class={`rounded border object-cover transition-all duration-200 group-hover:scale-105 group-hover:border-gta-gold/40 ${g.id === "gta-6" ? "w-10 h-14 border-gta-gold/40 shadow-lg shadow-gta-gold/10" : "w-9 h-12 border-[#2a2a31]"}`}
                  loading="eager"
                />
                <span class={`text-[10px] font-mono tracking-widest ${g.id === "gta-6" ? "text-gta-gold" : "text-zinc-500"}`}>{g.short}</span>
              </div>
            ))}
          </div>
        </div>
        <!-- Title filters — logo-based, GTA VI first (most recent), backwards in time -->
        <div class="flex flex-wrap items-center gap-2 pb-4 border-b border-[#1e1e23] mb-3">

          {/* All Titles */}
          <button class="chart-title-filter flex items-center gap-1.5 px-3 py-1.5 rounded border transition-all border-[#2a2a31] text-zinc-500 hover:border-zinc-600 hover:text-zinc-300 text-[11px] font-mono"
                  data-title="All">
            <span class="text-[10px] font-mono">All</span>
          </button>

          {/* GTA VI */}
          <button class="chart-title-filter flex items-center gap-2 px-2.5 py-1.5 rounded border transition-all border-[#2a2a31] hover:border-gta-gold/40 group"
                  data-title="gta-vi" aria-label="GTA VI">
            <img src="/assets/logos/gta-vi.svg" alt="GTA VI"
                 class="h-5 w-auto opacity-60 group-hover:opacity-90 transition-opacity" />
          </button>

          {/* GTA Online */}
          <button class="chart-title-filter flex items-center gap-2 px-2.5 py-1.5 rounded border transition-all border-[#2a2a31] hover:border-gta-teal/40 group"
                  data-title="gta-online" aria-label="GTA Online">
            <img src="/assets/logos/gta-online.svg" alt="GTA Online"
                 class="h-5 w-auto opacity-60 group-hover:opacity-90 transition-opacity" />
          </button>

          {/* GTA V */}
          <button class="chart-title-filter flex items-center gap-2 px-2.5 py-1.5 rounded border transition-all border-[#2a2a31] hover:border-zinc-500 group"
                  data-title="gta-v" aria-label="GTA V">
            <img src="/assets/logos/gta-v.png" alt="GTA V"
                 class="h-5 w-auto opacity-60 group-hover:opacity-90 transition-opacity" />
          </button>

          {/* Franchise */}
          <button class="chart-title-filter flex items-center gap-1.5 px-3 py-1.5 rounded border transition-all border-[#2a2a31] text-zinc-500 hover:border-zinc-600 hover:text-zinc-300 text-[10px] font-mono uppercase tracking-widest"
                  data-title="franchise">
            Franchise
          </button>

        </div>
        <!-- Category filters -->
        <div class="flex flex-wrap gap-2 self-end pb-1">
          {CATEGORIES.map(cat => (
            <button
              class="chart-filter px-3 py-1.5 rounded text-[11px] font-mono border transition-all"
              class:list={[
                cat === "All"
                  ? "border-gta-gold/40 text-gta-gold bg-gta-gold/8"
                  : "border-[#2a2a31] text-zinc-500 hover:border-zinc-600 hover:text-zinc-300"
              ]}
              data-filter={cat}
            >{CAT_LABELS[cat] ?? cat}</button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 flex flex-col gap-10">

    {chartsInOrder.map((chart) => {
      const Comp = chart.component;
      const link = LINK_METAS[chart.id];
      return (
        <ChartSection
          chartId={chart.id}
          meta={DYNAMIC_METAS[chart.id]}
          metaHref={link?.href}
          metaLabel={link?.label}
          secondaryGames={({
            "prelaunch-comparison-chart":  ["gta-v"],
            "dlc-cadence-chart":           ["gta-online"],
            "revenue-split-chart":         ["gta-online", "gta-v"],
            "ttwo-stock-chart":            ["franchise"],
            "franchise-complexity-chart":  ["franchise"],
          } as Record<string, Array<"gta-vi"|"gta-online"|"gta-v"|"franchise">>)[chart.id]}
        >
          <Comp />
        </ChartSection>
      );
    })}

    <CrossLinks context="charts" />
  </div>
</Base>

<style>
  /* Per-title left border accent on chart sections */
  .chart-block[data-title="gta-vi"]     { border-left: 2px solid rgba(255,107,157,0.30); padding-left: 12px; }
  .chart-block[data-title="gta-online"] { border-left: 2px solid rgba(13,148,136,0.25); padding-left: 12px; }
  .chart-block[data-title="gta-v"]      { border-left: 2px solid rgba(113,113,122,0.20); padding-left: 12px; }
  .chart-block[data-title="franchise"]  { border-left: 2px solid rgba(113,113,122,0.15); padding-left: 12px; }

  /* Scroll offset — clears sticky nav (48px) + section header row (~24px) */
  .chart-block { scroll-margin-top: 72px; }
</style>

<script>
  // ── Category filter ─────────────────────────────────────────
  // ── Title filter ─────────────────────────────────────────────
  let activeTitle = "All";
  const titleParams = new URLSearchParams(window.location.search);
  if (titleParams.has("title")) {
    activeTitle = titleParams.get("title")!;
  }
  function applyTitleFilter() {
    document.querySelectorAll<HTMLElement>(".chart-block").forEach(block => {
      const blockTitle = block.dataset.title;
      const show = activeTitle === "All" || !blockTitle || blockTitle === activeTitle;
      block.style.display = show ? "" : "none";
    });
    const TITLE_ACCENT: Record<string, { border: string; bg: string; img: string }> = {
      "All":        { border: "#2a2a31",               bg: "transparent",              img: "1" },
      "gta-vi":     { border: "rgba(245,158,11,0.5)",  bg: "var(--c-hero-bloom)",      img: "1" },
      "gta-online": { border: "rgba(13,148,136,0.5)",  bg: "rgba(13,148,136,0.06)",    img: "1" },
      "gta-v":      { border: "rgba(113,113,122,0.5)", bg: "rgba(113,113,122,0.06)",   img: "1" },
      "franchise":  { border: "rgba(113,113,122,0.5)", bg: "rgba(113,113,122,0.06)",   img: "1" },
    };
    document.querySelectorAll<HTMLButtonElement>(".chart-title-filter").forEach(b => {
      const title    = b.dataset.title ?? "All";
      const isActive = title === activeTitle || (activeTitle === "All" && title === "All");
      const accent   = TITLE_ACCENT[title] ?? TITLE_ACCENT["All"];
      b.style.borderColor     = isActive ? accent.border : "rgba(42,42,49,1)";
      b.style.backgroundColor = isActive ? accent.bg     : "transparent";
      const img = b.querySelector<HTMLImageElement>("img");
      if (img) img.style.opacity = isActive ? "1" : "0.5";
      if (!img) b.style.color = isActive ? "#f59e0b" : "";
    });
  }
  document.querySelectorAll<HTMLButtonElement>(".chart-title-filter").forEach(btn => {
    btn.addEventListener("click", () => {
      activeTitle = btn.dataset.title!;
      applyTitleFilter();
      document.querySelector<HTMLButtonElement>('.chart-filter[data-filter="All"]')?.click();
    });
  });

  // Apply on page load (activates any ?title= URL param immediately)
  applyTitleFilter();

  document.querySelectorAll<HTMLButtonElement>(".chart-filter").forEach(btn => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter!;
      document.querySelectorAll<HTMLButtonElement>(".chart-filter").forEach(b => {
        const active = b.dataset.filter === filter;
        b.className = b.className
          .replace(/border-gta-gold\/40|text-gta-gold|bg-gta-gold\/8/g, "")
          .replace(/border-\[#2a2a31\]|text-zinc-500/g, "")
          .trim();
        b.classList.add(
          ...(active
            ? ["border-gta-gold/40", "text-gta-gold", "bg-gta-gold/8"]
            : ["border-[#2a2a31]", "text-zinc-500"])
        );
      });
      document.querySelectorAll<HTMLElement>(".chart-block").forEach(block => {
        const cat = block.dataset.category!;
        const show = filter === "All"
          || cat === filter
          || (filter === "Economy-IG" && cat === "Economy")
          || (filter === "Economy-RL" && cat === "Economy");
        block.style.display = show ? "" : "none";
      });
    });
  });

  // ── Watermark: stamped on all chart SVGs after D3 renders ────
  function stampChartWatermarks() {
    document.querySelectorAll<SVGSVGElement>("[id$='-chart'] svg, #trailer-discovery-chart svg, #region-heatmap svg").forEach(svg => {
      if (svg.querySelector(".gtavi-wm")) return;
      const vb = svg.getAttribute("viewBox")?.split(" ").map(Number);
      if (!vb || vb.length < 4) return;
      const [,, vw, vh] = vb;
      const txt = document.createElementNS("http://www.w3.org/2000/svg","text");
      txt.setAttribute("class","gtavi-wm");
      txt.setAttribute("x",String(vw - 6));
      txt.setAttribute("y",String(vh - 5));
      txt.setAttribute("text-anchor","end");
      txt.setAttribute("font-size","8");
      txt.setAttribute("font-family","monospace");
      txt.setAttribute("fill","#3f3f46");
      txt.setAttribute("letter-spacing","0.08em");
      txt.textContent = "GTAVI.AI";
      svg.appendChild(txt);
    });
  }
  requestAnimationFrame(() => requestAnimationFrame(stampChartWatermarks));

  // ── Resilient chart initialisation ─────────────────────────────────────────
  function runChart(id: string, fn: (el: HTMLElement) => void): void {
    const el = document.getElementById(id) as HTMLElement | null;
    if (!el) return;
    function tryRender(attempt: number) {
      if (el.clientWidth === 0 && attempt < 5) {
        requestAnimationFrame(() => tryRender(attempt + 1));
        return;
      }
      try {
        fn(el);
      } catch (err) {
        console.warn(`[GTAVI.AI] Chart "${id}" render error:`, err);
        if (!el.querySelector("svg")) {
          el.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#3f3f46;font-size:10px;font-family:monospace">Chart unavailable — data may be updating nightly</div>';
        }
      }
    }
    requestAnimationFrame(() => tryRender(0));
  }

  requestAnimationFrame(() => applyTitleFilter());

  // ── Hash navigation — filter activation only ─────────────────────────────
  (function handleChartHash() {
    const hash = window.location.hash;
    if (!hash || hash.length < 2) return;
    const targetId = hash.slice(1);
    setTimeout(() => {
      const el = document.getElementById(targetId);
      if (!el) return;
      const section = (el.closest<HTMLElement>("section.chart-block") ?? el) as HTMLElement;
      if (section.style.display === "none" || section.offsetParent === null) {
        document.querySelector<HTMLButtonElement>('.chart-filter[data-filter="All"]')?.click();
        document.querySelector<HTMLButtonElement>('.chart-title-filter[data-title="All"]')?.click();
        setTimeout(() => {
          section.scrollIntoView({ behavior: "instant", block: "start" });
        }, 50);
      }
    }, 100);
  })();
</script>
