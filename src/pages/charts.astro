---
import Base from "../layouts/Base.astro";
import CrossLinks from "../components/CrossLinks.astro";
import ShareButton from "../components/ShareButton.astro";

// ── Data imports (for header stat strip) ─────────────────────────────────
import Base from "../layouts/Base.astro";
import CrossLinks from "../components/CrossLinks.astro";
import ShareButton from "../components/ShareButton.astro";
import salesData   from "../../data/franchise/sales.json";
import steamData   from "../../data/gta-5/meta/steam-players.json";
import dlcData     from "../../data/gta-5/dlc/timeline.json";
import gta5Trends  from "../../data/gta-5/trends/search-interest.json";
import gta6Trends  from "../../data/gta-6/trends/search-interest.json";
import vehicleData from "../../data/gta-5/vehicles/performance.json";
import velocityData   from "../../data/gta-6/trailer-velocity.json";
import redditData     from "../../data/community/reddit.json";
import entertainData  from "../../data/franchise/entertainment-comps.json";
import delayData        from "../../data/gta-6/delay-timeline.json";
import cpiData          from "../../data/franchise/cpi.json";
import trailerAnalysis  from "../../data/gta-6/trailer-analysis.json";
import revenueSplit     from "../../data/franchise/revenue-split.json";
import regionsData      from "../../data/franchise/regions-evidence.json";
import stocksData       from "../../data/gta-5/economy/assassination-stocks.json";
import revenueTiersData from "../../data/gta-5/economy/revenue-tiers.json";
import releasesData     from "../../data/shared/releases.json";
import bizProfilesData  from "../../data/gta-5/economy/business-profiles.json";
import metacriticData   from "../../data/franchise/metacritic.json";
import ttwoStock        from "../../data/franchise/ttwo-stock.json";
import competitorData   from "../../data/franchise/competitors.json";
import bonusHistoryData from "../../data/gta-5/economy/bonus-history.json";
import saleFreqData     from "../../data/gta-5/economy/sale-frequency.json";
import sharkCardData    from "../../data/gta-5/economy/shark-cards.json";
import propertiesData   from "../../data/gta-5/economy/properties.json";
import franchiseEconData    from "../../data/franchise/economic-history.json";
import priceChangesData    from "../../data/gta-5/economy/price-changes.json";
import sourceHistoryData   from "../../data/gta-5/economy/per-source-history.json";
import vehicleModsData     from "../../data/gta-5/economy/vehicle-mods.json";
import gtaPpiData          from "../../data/gta-5/economy/gta-ppi.json";
import passiveStackData    from "../../data/gta-5/economy/passive-stack.json";
import metaHistoryData     from "../../data/gta-5/economy/meta-history.json";
import heistsData          from "../../data/gta-5/economy/online-heists.json";
import spendingDistData    from "../../data/gta-5/economy/spending-distribution.json";
import vehicleCargoData    from "../../data/gta-5/economy/vehicle-cargo.json";

// ── Chart components (all 37 — order driven by data/config/chart-config.json) ──
import ChartAssassinationReturns from "../components/charts/ChartAssassinationReturns.astro";
import ChartBonusHeatmap from "../components/charts/ChartBonusHeatmap.astro";
import ChartCommunity from "../components/charts/ChartCommunity.astro";
import ChartCompetitors from "../components/charts/ChartCompetitors.astro";
import ChartCpiPricing from "../components/charts/ChartCpiPricing.astro";
import ChartCriticDivergence from "../components/charts/ChartCriticDivergence.astro";
import ChartDelayTimeline from "../components/charts/ChartDelayTimeline.astro";
import ChartDlcCadence from "../components/charts/ChartDlcCadence.astro";
import ChartDlcPlayerHistory from "../components/charts/ChartDlcPlayerHistory.astro";
import ChartEntertainmentComp from "../components/charts/ChartEntertainmentComp.astro";
import ChartFranchiseComplexity from "../components/charts/ChartFranchiseComplexity.astro";
import ChartFranchiseEarnings from "../components/charts/ChartFranchiseEarnings.astro";
import ChartFranchiseSales from "../components/charts/ChartFranchiseSales.astro";
import ChartGtaPpi from "../components/charts/ChartGtaPpi.astro";
import ChartHeistComparison from "../components/charts/ChartHeistComparison.astro";
import ChartIeTiers from "../components/charts/ChartIeTiers.astro";
import ChartIncomeHistory from "../components/charts/ChartIncomeHistory.astro";
import ChartIncomeLeaderboard from "../components/charts/ChartIncomeLeaderboard.astro";
import ChartMetaEvolution from "../components/charts/ChartMetaEvolution.astro";
import ChartMissionEarnings from "../components/charts/ChartMissionEarnings.astro";
import ChartPassiveStack from "../components/charts/ChartPassiveStack.astro";
import ChartPrelaunchComparison from "../components/charts/ChartPrelaunchComparison.astro";
import ChartPriceHistory from "../components/charts/ChartPriceHistory.astro";
import ChartPropertyCost from "../components/charts/ChartPropertyCost.astro";
import ChartPropertyDailyFee from "../components/charts/ChartPropertyDailyFee.astro";
import ChartRegionHeatmap from "../components/charts/ChartRegionHeatmap.astro";
import ChartRevenueSplit from "../components/charts/ChartRevenueSplit.astro";
import ChartRoiScatter from "../components/charts/ChartRoiScatter.astro";
import ChartSharkCard from "../components/charts/ChartSharkCard.astro";
import ChartSpendingDistribution from "../components/charts/ChartSpendingDistribution.astro";
import ChartTrailerDiscovery from "../components/charts/ChartTrailerDiscovery.astro";
import ChartTrailerVelocity from "../components/charts/ChartTrailerVelocity.astro";
import ChartTtwoStock from "../components/charts/ChartTtwoStock.astro";
import ChartVehiclePerformance from "../components/charts/ChartVehiclePerformance.astro";
import ChartVehicleTco from "../components/charts/ChartVehicleTco.astro";
import PlayerChart from "../components/PlayerChart.astro";
import TrendsChart from "../components/TrendsChart.astro";

const metacriticScores = metacriticData.titles;
const CATEGORIES = ["All", "Economy-IG", "Economy-RL", "Promotions", "Performance", "Community", "History"] as const;
const CAT_LABELS: Record<string, string> = {
  "All":        "All",
  "Economy-IG": "⚡ Economy (In-Game)",
  "Economy-RL": "📊 Economy (Real-Life)",
  "Promotions": "🏷 Promotions",
  "Performance":"🏎 Performance",
  "Community":  "🌐 Community",
  "History":    "📖 Franchise History",
};
// Economy data
const assassinGuide  = (stocksData as any).guide_order as any[];
// Pre-compute stats for header strip
const gta5 = salesData.titles.find(t => t.id === "gta-5");
const gta6 = salesData.titles.find(t => t.id === "gta-6");
const t1 = velocityData.trailers.find((t: any) => t.youtube_id === "QdBZY2fkU-0");
const t2 = velocityData.trailers.find((t: any) => t.youtube_id === "VQRLujxTm3c");
const t1Views = t1?.snapshots?.at(-1)?.views ?? 0;
const t2Views = t2?.snapshots?.at(-1)?.views ?? 0;
---


<Base
  titleContext="franchise"
  title="Charts"
  description="GTA franchise data visualised — sales velocity, player history, search hype, vehicle performance and more."
  ogPage="charts"
>

  <!-- Page header -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden">
    <div class="absolute inset-0">
      <img src="/assets/gta6/locations/Ambrosia_02.jpg" alt="" class="w-full h-full object-cover" style="object-position:center 55%" aria-hidden="true" />
      <div class="absolute inset-0" style="background:linear-gradient(to right, #0a0a0d 0%, #0a0a0dcc 55%, #0a0a0d88 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom, transparent 0%, #0a0a0d 100%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// Data Intelligence</div>
          <h1 class="text-3xl font-bold text-white mb-2">Charts</h1>
          <p class="text-sm text-zinc-400 max-w-lg">
            The GTA franchise quantified. Every chart is filterable, sourced, and updated nightly.
          </p>
          <!-- Game cover strip -->
          <div class="flex items-center gap-2.5 mt-5">
            {([
              { id: "gta-1",  short: "GTA 1"  },
              { id: "gta-2",  short: "GTA 2"  },
              { id: "gta-3",  short: "GTA III" },
              { id: "gta-vc", short: "GTA VC"  },
              { id: "gta-sa", short: "GTA SA"  },
              { id: "gta-4",  short: "GTA IV"  },
              { id: "gta-5",  short: "GTA V"   },
              { id: "gta-6",  short: "GTA VI"  },
            ] as const).map(g => (
              <div class="flex flex-col items-center gap-1 group">
                <img
                  src={`/assets/covers/${g.id}.jpg`}
                  alt={g.short}
                  class={`rounded border object-cover transition-all duration-200 group-hover:scale-105 group-hover:border-gta-gold/40 ${g.id === "gta-6" ? "w-10 h-14 border-gta-gold/40 shadow-lg shadow-gta-gold/10" : "w-9 h-12 border-[#2a2a31]"}`}
                  loading="eager"
                />
                <span class={`text-[10px] font-mono tracking-widest ${g.id === "gta-6" ? "text-gta-gold" : "text-zinc-500"}`}>{g.short}</span>
              </div>
            ))}
          </div>
        </div>
        <!-- Title filters — logo-based, GTA VI first (most recent), backwards in time -->
        <div class="flex flex-wrap items-center gap-2 pb-4 border-b border-[#1e1e23] mb-3">

          {/* All Titles */}
          <button class="chart-title-filter flex items-center gap-1.5 px-3 py-1.5 rounded border transition-all border-[#2a2a31] text-zinc-500 hover:border-zinc-600 hover:text-zinc-300 text-[11px] font-mono"
                  data-title="All">
            <span class="text-[10px] font-mono">All</span>
          </button>

          {/* GTA VI */}
          <button class="chart-title-filter flex items-center gap-2 px-2.5 py-1.5 rounded border transition-all border-[#2a2a31] hover:border-gta-gold/40 group"
                  data-title="gta-vi" aria-label="GTA VI">
            <img src="/assets/logos/gta-vi.svg" alt="GTA VI"
                 class="h-5 w-auto opacity-60 group-hover:opacity-90 transition-opacity" />
          </button>

          {/* GTA Online */}
          <button class="chart-title-filter flex items-center gap-2 px-2.5 py-1.5 rounded border transition-all border-[#2a2a31] hover:border-gta-teal/40 group"
                  data-title="gta-online" aria-label="GTA Online">
            <img src="/assets/logos/gta-online.svg" alt="GTA Online"
                 class="h-5 w-auto opacity-60 group-hover:opacity-90 transition-opacity" />
          </button>

          {/* GTA V */}
          <button class="chart-title-filter flex items-center gap-2 px-2.5 py-1.5 rounded border transition-all border-[#2a2a31] hover:border-zinc-500 group"
                  data-title="gta-v" aria-label="GTA V">
            <img src="/assets/logos/gta-v.png" alt="GTA V"
                 class="h-5 w-auto opacity-60 group-hover:opacity-90 transition-opacity" />
          </button>

          {/* Franchise */}
          <button class="chart-title-filter flex items-center gap-1.5 px-3 py-1.5 rounded border transition-all border-[#2a2a31] text-zinc-500 hover:border-zinc-600 hover:text-zinc-300 text-[10px] font-mono uppercase tracking-widest"
                  data-title="franchise">
            Franchise
          </button>

        </div>
        <!-- Category filters -->
        <div class="flex flex-wrap gap-2 self-end pb-1">
          {CATEGORIES.map(cat => (
            <button
              class="chart-filter px-3 py-1.5 rounded text-[11px] font-mono border transition-all"
              class:list={[
                cat === "All"
                  ? "border-gta-gold/40 text-gta-gold bg-gta-gold/8"
                  : "border-[#2a2a31] text-zinc-500 hover:border-zinc-600 hover:text-zinc-300"
              ]}
              data-filter={cat}
            >{CAT_LABELS[cat] ?? cat}</button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 flex flex-col gap-10">

    <section class="chart-block" data-title="gta-vi" data-category="Community">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-gold/10 text-gta-gold border-gta-gold/30">GTA VI</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI Trailer View Velocity</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartTrailerVelocity />
    </section>
    <section class="chart-block" data-title="gta-vi" data-category="Community">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-gold/10 text-gta-gold border-gta-gold/30">GTA VI</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Trailer Discovery Density — What Every Second Revealed</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartTrailerDiscovery />
    </section>
    <section class="chart-block" data-title="gta-vi" data-category="History">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-gold/10 text-gta-gold border-gta-gold/30">GTA VI</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI Development & Delay Timeline</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartDelayTimeline />
    </section>
    <section class="chart-block" data-title="gta-vi" data-category="Community">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-gold/10 text-gta-gold border-gta-gold/30">GTA VI</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Leonida Region Evidence Heatmap</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartRegionHeatmap />
    </section>
    <section class="chart-block" data-title="gta-vi" data-category="Community">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-gold/10 text-gta-gold border-gta-gold/30">GTA VI</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Community Anticipation Curve</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartCommunity />
    </section>
    <section class="chart-block" data-title="gta-vi" data-category="History">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-gold/10 text-gta-gold border-gta-gold/30">GTA VI</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Pre-launch Hype — GTA V (2013) vs GTA VI (2026)</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartPrelaunchComparison />
    </section>
    <section class="chart-block" data-title="gta-vi" data-category="Economy-RL">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-gold/10 text-gta-gold border-gta-gold/30">GTA VI</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI vs Global Entertainment</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartEntertainmentComp />
    </section>
    <section class="chart-block" data-title="gta-vi" data-category="Economy-RL">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-gold/10 text-gta-gold border-gta-gold/30">GTA VI</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI vs Major Game Launches — Year 1 Sales & Pre-launch Hype</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartCompetitors />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA Online Income Leaderboard — All Sources Ranked</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartIncomeLeaderboard />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Meta Ceiling — Top $/hr Method at Each Major DLC (2013–2023)</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartMetaEvolution />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA-PPI — In-Game Inflation Index (hours to buy standard basket)</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartGtaPpi />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Passive Income Stack — How Idle GTA$/hr Grew From 0 to $1.24M</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartPassiveStack />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Setup Cost vs $/hr — What's Actually Worth Buying?</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartRoiScatter />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-RL">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Shark Card Purchasing Power — 12 Years of In-Game Inflation</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartSharkCard />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Heist Comparison — $/hr vs Setup Cost vs Run Time</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartHeistComparison />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Income Source Price History — Nerfs, Buffs, DLC Launches</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartIncomeHistory />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Meta Vehicle TCO — What Does Going Full Meta Actually Cost?</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartVehicleTco />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-RL">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA Online Property Costs — Full Expenditure Registry</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartPropertyCost />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Property Daily Fees — Ownership Has Ongoing Costs</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ChartPropertyDailyFee />
    </section>
    <section class="chart-block" data-title="gta-online" data-category="Economy-IG">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest bg-gta-teal/10 text-gta-teal border-gta-teal/30">GTA Online</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Spending Mix — Where GTA$ Goes Per Era</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
