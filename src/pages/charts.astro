<style>
  /* Per-title left border accent on chart sections */
  .chart-block[data-title="gta-vi"]     { border-left: 2px solid rgba(245,158,11,0.30); padding-left: 12px; }
  .chart-block[data-title="gta-online"] { border-left: 2px solid rgba(13,148,136,0.25); padding-left: 12px; }
  .chart-block[data-title="gta-v"]      { border-left: 2px solid rgba(113,113,122,0.20); padding-left: 12px; }
  .chart-block[data-title="franchise"]  { border-left: 2px solid rgba(113,113,122,0.15); padding-left: 12px; }
</style>

<script>


  // ── Category filter ─────────────────────────────────────────
  // ── Title filter ─────────────────────────────────────────────
  let activeTitle = "All";
  const titleParams = new URLSearchParams(window.location.search);
  if (titleParams.has("title")) {
    activeTitle = titleParams.get("title")!;
  }
  function applyTitleFilter() {
    document.querySelectorAll<HTMLElement>(".chart-block").forEach(block => {
      const blockTitle = block.dataset.title;
      const show = activeTitle === "All" || !blockTitle || blockTitle === activeTitle;
      // Always set display to ensure previously-hidden blocks are restored
      block.style.display = show ? "" : "none";
    });
    // Title filter active states — use data-active + per-title accent colour
    const TITLE_ACCENT: Record<string, { border: string; bg: string; img: string }> = {
      "All":        { border: "#2a2a31",          bg: "transparent",           img: "1" },
      "gta-vi":     { border: "rgba(245,158,11,0.5)", bg: "var(--c-hero-bloom)", img: "1" },
      "gta-online": { border: "rgba(13,148,136,0.5)", bg: "rgba(13,148,136,0.06)", img: "1" },
      "gta-v":      { border: "rgba(113,113,122,0.5)", bg: "rgba(113,113,122,0.06)", img: "1" },
      "franchise":  { border: "rgba(113,113,122,0.5)", bg: "rgba(113,113,122,0.06)", img: "1" },
    };
    document.querySelectorAll<HTMLButtonElement>(".chart-title-filter").forEach(b => {
      const title  = b.dataset.title ?? "All";
      const isActive = title === activeTitle || (activeTitle === "All" && title === "All");
      const accent = TITLE_ACCENT[title] ?? TITLE_ACCENT["All"];
      b.style.borderColor    = isActive ? accent.border : "rgba(42,42,49,1)";
      b.style.backgroundColor = isActive ? accent.bg   : "transparent";
      const img = b.querySelector<HTMLImageElement>("img");
      if (img) img.style.opacity = isActive ? "1" : "0.5";
      // Text buttons (All / Franchise)
      if (!img) {
        b.style.color = isActive ? "#f59e0b" : "";
      }
    });
  }
  // Apply title filter AFTER charts render (via rAF) to avoid hiding elements
  // before D3 reads their clientWidth
  document.querySelectorAll<HTMLButtonElement>(".chart-title-filter").forEach(btn => {
    btn.addEventListener("click", () => {
      activeTitle = btn.dataset.title!;
      applyTitleFilter();
      // Re-apply category filter too
      document.querySelector<HTMLButtonElement>('.chart-filter[data-filter="All"]')?.click();
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".chart-filter").forEach(btn => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter!;
      document.querySelectorAll<HTMLButtonElement>(".chart-filter").forEach(b => {
        const active = b.dataset.filter === filter;
        b.className = b.className
          .replace(/border-gta-gold\/40|text-gta-gold|bg-gta-gold\/8/g, "")
          .replace(/border-\[#2a2a31\]|text-zinc-500/g, "")
          .trim();
        b.classList.add(
          ...(active
            ? ["border-gta-gold/40", "text-gta-gold", "bg-gta-gold/8"]
            : ["border-[#2a2a31]", "text-zinc-500"])
        );
      });
      document.querySelectorAll<HTMLElement>(".chart-block").forEach(block => {
        const cat = block.dataset.category!;
        const show = filter === "All"
          || cat === filter
          // "Economy-IG" filter also shows plain "Economy" legacy blocks
          || (filter === "Economy-IG" && cat === "Economy")
          || (filter === "Economy-RL" && cat === "Economy");
        block.style.display = show ? "" : "none";
      });
    });
  });

  // ── Watermark: stamped on all chart SVGs after D3 renders ────
  // Runs once after all chart builders complete via requestAnimationFrame.
  function stampChartWatermarks() {
    document.querySelectorAll<SVGSVGElement>("[id$='-chart'] svg, #trailer-discovery-chart svg, #region-heatmap svg").forEach(svg => {
      if (svg.querySelector(".gtavi-wm")) return; // already stamped
      const vb = svg.getAttribute("viewBox")?.split(" ").map(Number);
      if (!vb || vb.length < 4) return;
      const [,, vw, vh] = vb;
      const txt = document.createElementNS("http://www.w3.org/2000/svg","text");
      txt.setAttribute("class","gtavi-wm");
      txt.setAttribute("x",String(vw - 6));
      txt.setAttribute("y",String(vh - 5));
      txt.setAttribute("text-anchor","end");
      txt.setAttribute("font-size","8");
      txt.setAttribute("font-family","monospace");
      txt.setAttribute("fill","#3f3f46");
      txt.setAttribute("letter-spacing","0.08em");
      txt.textContent = "GTAVI.AI";
      svg.appendChild(txt);
    });
  }
  requestAnimationFrame(() => requestAnimationFrame(stampChartWatermarks));

  // ── Resilient chart initialisation ─────────────────────────────────────────
  // Wraps each chart init in try/catch + clientWidth guard.
  // If el.clientWidth is 0 (element hidden or not laid out), retries after rAF.
  // If D3 throws, shows a "data updating" fallback instead of a broken chart.
  function runChart(id: string, fn: (el: HTMLElement) => void): void {
    const el = document.getElementById(id) as HTMLElement | null;
    if (!el) return;
    function tryRender(attempt: number) {
      if (el.clientWidth === 0 && attempt < 5) {
        requestAnimationFrame(() => tryRender(attempt + 1));
        return;
      }
      try {
        fn(el);
      } catch (err) {
        console.warn(`[GTAVI.AI] Chart "${id}" render error:`, err);
        if (!el.querySelector("svg")) {
          el.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#3f3f46;font-size:10px;font-family:monospace">Chart unavailable — data may be updating nightly</div>';
        }
      }
    }
    requestAnimationFrame(() => tryRender(0));
  }

  // Apply title filter AFTER chart init rAFs have queued
  requestAnimationFrame(() => applyTitleFilter());

  // ── Auto-inject title chips into all chart section headers ───────────────
  // Reads data-title from each .chart-block and prepends a mini title badge
  // before the existing category badge — zero per-chart HTML changes needed.
  (function injectTitleChips() {
    const TITLE_CONFIG: Record<string, { label: string; imgSrc: string | null; color: string; bg: string; border: string }> = {
      "gta-vi":     { label: "GTA VI",    imgSrc: "/assets/logos/gta-vi.svg",     color: "#f59e0b", bg: "rgba(245,158,11,0.08)", border: "rgba(245,158,11,0.30)" },
      "gta-online": { label: "GTA Online",imgSrc: "/assets/logos/gta-online.svg", color: "#0d9488", bg: "rgba(13,148,136,0.08)",  border: "rgba(13,148,136,0.30)"  },
      "gta-v":      { label: "GTA V",     imgSrc: "/assets/logos/gta-v.png",      color: "#a1a1aa", bg: "rgba(113,113,122,0.07)", border: "rgba(113,113,122,0.25)"  },
      "franchise":  { label: "Franchise", imgSrc: null,                           color: "#a1a1aa", bg: "rgba(113,113,122,0.07)", border: "rgba(113,113,122,0.25)"  },
    };

    document.querySelectorAll<HTMLElement>(".chart-block").forEach(section => {
      const titleKey = section.dataset.title;
      const cfg = titleKey ? TITLE_CONFIG[titleKey] : null;
      if (!cfg) return;

      // Find the header row (flex items-center gap-3 mb-5)
      const header = section.querySelector<HTMLElement>(".flex.items-center.gap-3.mb-5");
      if (!header || header.querySelector(".chart-auto-title")) return;

      // Build the title chip
      const chip = document.createElement("span");
      chip.className = "chart-auto-title inline-flex items-center gap-1.5 shrink-0";
      chip.style.cssText = `padding:2px 7px 2px 4px;border-radius:4px;border:1px solid ${cfg.border};background:${cfg.bg};font-size:9px;font-family:monospace;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:${cfg.color};white-space:nowrap`;

      if (cfg.imgSrc) {
        const img = document.createElement("img");
        img.src   = cfg.imgSrc;
        img.alt   = cfg.label;
        img.style.cssText = "height:14px;width:auto;object-fit:contain;opacity:0.9;flex-shrink:0";
        chip.appendChild(img);
      } else {
        chip.textContent = cfg.label;
      }

      // Insert before the first existing badge
      header.insertBefore(chip, header.firstChild);
    });
  })();

  (function handleChartHash() {
    const hash = window.location.hash;
    if (!hash || hash.length < 2) return;
    const targetId = hash.slice(1);

    // Poll briefly to let async D3 renders settle (max 600ms)
    let attempts = 0;
    const tryScroll = () => {
      const el = document.getElementById(targetId);
      if (!el && attempts++ < 6) { setTimeout(tryScroll, 100); return; }
      if (!el) return;

      // The section that contains this element
      const section = (el.closest("section.chart-block") ?? el) as HTMLElement;

      // If it's hidden by a category filter, reset to "All"
      if (section.style.display === "none" || section.offsetParent === null) {
        const allBtn = document.querySelector<HTMLButtonElement>('.chart-filter[data-filter="All"]');
        if (allBtn) allBtn.click();
      }

      requestAnimationFrame(() => {
        section.scrollIntoView({ behavior: "smooth", block: "start" });
        // Brief highlight pulse so the user knows which chart was linked
        section.style.transition = "box-shadow 0.3s";
        section.style.boxShadow = "0 0 0 2px rgba(245,158,11,0.5)";
        setTimeout(() => { section.style.boxShadow = ""; }, 1800);
      });
    };
    setTimeout(tryScroll, 200);
  });

</script>

</script>
