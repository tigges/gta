    <!-- ═══════════════════════════════════════════════════════
         RELEASE HISTORY
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Franchise Release History</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/franchise" class="text-[10px] font-mono text-gta-gold/70 hover:text-gta-gold transition-colors tracking-widest uppercase">Full franchise data →</a>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <ReleaseTimeline />

        <!-- Cross-gen stats table -->
        <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
          <div class="px-5 py-4 border-b border-[#1e1e23]">
            <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em]">// Cross-Generation Growth</div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="border-b border-[#1e1e23]">
                  <th class="text-left px-5 py-2.5 text-zinc-600 font-normal">Title</th>
                  <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">Year</th>
                  <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">Price</th>
                  <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">Map km²</th>
                  <th class="text-right px-5 py-2.5 text-zinc-600 font-normal">Vehicles</th>
                </tr>
              </thead>
              <tbody>
                {releasesData.games.map((g) => {
                  const isPred   = g.is_prediction;
                  const year     = g.release_year ?? (g as any).release_date_estimate;
                  const price    = g.price_usd_launch    ?? (g as any).price_usd_estimate;
                  const map      = g.map_size_km2        ?? (g as any).map_size_km2_estimate;
                  const vehicles = g.vehicle_count       ?? (g as any).vehicle_count_estimate;
                  const cover    = RELEASE_COVERS[g.short] ?? null;
                  return (
                    <tr class={`border-b border-[#1e1e23]/50 transition-colors hover:bg-white/2 ${isPred ? "text-gta-gold" : "text-zinc-300"}`}>
                      <td class="px-5 py-2 font-semibold">
                        <div class="flex items-center gap-2.5">
                          {cover ? (
                            <img src={cover} alt={g.short} class={`rounded object-cover shrink-0 ${isPred ? "w-7 h-9 border border-gta-gold/40" : "w-6 h-8 border border-[#2a2a31]"}`} loading="lazy" />
                          ) : (
                            <div class="w-6 h-8 rounded border border-[#1e1e23] shrink-0" style="background:#0a0a0d"></div>
                          )}
                          <span>
                            {g.short}
                            {isPred && <span class="ml-1 text-[11px] font-mono bg-gta-gold/10 text-gta-gold/70 border border-gta-gold/15 px-1 py-0.5 rounded uppercase tracking-widest align-middle">est</span>}
                          </span>
                        </div>
                      </td>
                      <td class="px-4 py-2.5 text-right text-zinc-600">{year ?? "—"}</td>
                      <td class="px-4 py-2.5 text-right">{price ? `$${price.toFixed(0)}` : <span class="text-zinc-500">—</span>}</td>
                      <td class="px-4 py-2.5 text-right">{map ?? <span class="text-zinc-500">—</span>}</td>
                      <td class="px-5 py-2.5 text-right">{vehicles ?? <span class="text-zinc-500">—</span>}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
            <span class="text-[10px] text-zinc-500 font-mono">est = estimated · sources: Rockstar, Broughy1322, community records</span>
            <div class="flex items-center gap-3 shrink-0"><span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareDropdown anchorId="share" shareText="GTA franchise history: GTA III in 2001 → GTA VI in 2026. 30 years of growth — vehicles, map size, price." size="sm" /></div>
          </div>
        </div>
      </div>
    </section>

