---
import Base from "../layouts/Base.astro";
import PlayerChart from "../components/PlayerChart.astro";
import TrendsChart from "../components/TrendsChart.astro";
import VehicleChart from "../components/VehicleChart.astro";

import vehicleData from "../../data/vehicles/performance.json";
import steamData from "../../data/meta/steam-players.json";

const latestSteam = steamData.data[steamData.data.length - 1];
const peakSteam = Math.max(...steamData.data.map((d) => d.peak_players));
---

<Base
  title="Dashboard"
  description="GTA Intelligence — data-driven insights across every GTA generation."
>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-zinc-800">
    <div class="absolute inset-0 bg-gradient-to-br from-zinc-900 via-zinc-950 to-zinc-950"></div>
    <!-- Subtle grid overlay -->
    <div class="absolute inset-0 opacity-10"
      style="background-image: linear-gradient(#f59e0b22 1px, transparent 1px), linear-gradient(90deg, #f59e0b22 1px, transparent 1px); background-size: 40px 40px;">
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 rounded-full px-3 py-1 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
          <span class="text-xs font-mono text-amber-500 uppercase tracking-wider">GTA VI Intelligence</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold font-mono text-zinc-50 leading-tight mb-4">
          The data behind<br />
          <span class="text-gta-gold">every GTA generation</span>
        </h1>
        <p class="text-zinc-400 text-base sm:text-lg leading-relaxed mb-8 max-w-xl">
          30 years of GTA data — player counts, vehicle performance, search trends —
          visualised and extrapolated to predict what GTA VI will look like.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/predictions"
            class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-mono font-bold text-sm px-5 py-2.5 rounded-lg transition-colors"
          >
            GTA VI Predictions →
          </a>
          <a
            href="#charts"
            class="inline-flex items-center gap-2 border border-zinc-700 hover:border-zinc-500 text-zinc-300 font-mono text-sm px-5 py-2.5 rounded-lg transition-colors"
          >
            Explore data ↓
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stat strip -->
  <section class="border-b border-zinc-800 bg-zinc-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-zinc-800">
        {[
          { label: "Vehicles tracked", value: vehicleData.vehicles.length.toString(), sub: "GTA V (Broughy)" },
          { label: "Steam peak (PC)", value: `${Math.round(peakSteam / 1000)}k`, sub: "concurrent players" },
          { label: "GTA generations", value: "7", sub: "1997 → 2026?" },
          { label: "Years in the making", value: "12+", sub: "V → VI gap" },
        ].map(({ label, value, sub }) => (
          <div class="px-6 py-5">
            <div class="text-2xl font-bold font-mono text-gta-gold">{value}</div>
            <div class="text-xs font-mono text-zinc-400 mt-0.5">{label}</div>
            <div class="text-xs font-mono text-zinc-600 mt-0.5">{sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Charts -->
  <section id="charts" class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-8">

    <!-- Section label -->
    <div class="flex items-center gap-3">
      <span class="text-xs font-mono text-zinc-600 uppercase tracking-widest">Community Signals</span>
      <div class="flex-1 h-px bg-zinc-800"></div>
    </div>

    <!-- Trends + Steam side by side on large screens -->
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <TrendsChart />
      <PlayerChart />
    </div>

    <!-- Vehicles full width -->
    <div class="flex items-center gap-3">
      <span class="text-xs font-mono text-zinc-600 uppercase tracking-widest">Vehicle Intelligence</span>
      <div class="flex-1 h-px bg-zinc-800"></div>
    </div>

    <VehicleChart />

    <!-- CTA to predictions -->
    <div class="mt-4 rounded-xl border border-amber-500/20 bg-amber-500/5 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h2 class="font-mono font-bold text-zinc-50 text-base">What does this mean for GTA VI?</h2>
        <p class="text-sm text-zinc-500 mt-1">
          See how 30 years of data points to vehicle counts, map size, pricing and release windows.
        </p>
      </div>
      <a
        href="/predictions"
        class="shrink-0 inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-mono font-bold text-sm px-5 py-2.5 rounded-lg transition-colors whitespace-nowrap"
      >
        View Predictions →
      </a>
    </div>

  </section>
</Base>
