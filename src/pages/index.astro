---
import Base from "../layouts/Base.astro";
import ReleaseTimeline from "../components/ReleaseTimeline.astro";
import PredictionCard from "../components/PredictionCard.astro";

import releasesData    from "../../data/shared/releases.json";
import predictionsData from "../../data/gta-6/predictions.json";
import trailersData    from "../../data/gta-6/trailers.json";

const latestTrailer = (trailersData as any).trailers?.[0] ?? null;
const publishedGames = [
  {
    id: "gta-v",
    short: "GTA V",
    title: "Grand Theft Auto V",
    year: 2013,
    href: "/gta-v",
    desc: "Steam players · Google Trends · 665 vehicle benchmarks",
    color: "border-amber-800/40 hover:border-amber-500/60",
    badge: "bg-amber-900/30 text-amber-600",
    dot: "bg-amber-700",
  },
  {
    id: "gta-vi",
    short: "GTA VI",
    title: "Grand Theft Auto VI",
    year: null,
    href: "/gta-vi",
    desc: "Predictions · Trailers · Search trends · Methodology",
    color: "border-amber-500/40 hover:border-amber-400/80",
    badge: "bg-amber-500/10 text-amber-400",
    dot: "bg-amber-500",
    pulse: true,
  },
];
---

<Base
  title="GTA Intelligence"
  description="Data-driven intelligence across every GTA generation — and what it predicts about GTA VI."
>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-zinc-800">
    <div class="absolute inset-0 bg-gradient-to-br from-zinc-900 via-zinc-950 to-zinc-950"></div>
    <div class="absolute inset-0 opacity-10"
      style="background-image: linear-gradient(#f59e0b22 1px, transparent 1px), linear-gradient(90deg, #f59e0b22 1px, transparent 1px); background-size: 40px 40px;">
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 rounded-full px-3 py-1 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
          <span class="text-xs font-mono text-amber-500 uppercase tracking-wider">30 years of GTA data · updated nightly</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold font-mono text-zinc-50 leading-tight mb-4">
          GTA Intelligence
        </h1>
        <p class="text-zinc-400 text-base sm:text-lg leading-relaxed mb-8 max-w-xl">
          Every mainline GTA game, clearly separated.
          Live data, confidence-scored predictions, and 30 years of release history
          distilled into one place.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/gta-vi"
            class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-mono font-bold text-sm px-5 py-2.5 rounded-lg transition-colors">
            GTA VI Predictions →
          </a>
          <a href="/gta-v"
            class="inline-flex items-center gap-2 border border-zinc-700 hover:border-zinc-500 text-zinc-300 font-mono text-sm px-5 py-2.5 rounded-lg transition-colors">
            GTA V Data →
          </a>
          {latestTrailer && (
            <a href={`https://www.youtube.com/watch?v=${latestTrailer.youtube_id}`}
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-zinc-700 hover:border-zinc-500 text-zinc-300 font-mono text-sm px-5 py-2.5 rounded-lg transition-colors">
              ▶ Latest trailer
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Published game cards -->
  <section class="border-b border-zinc-800 bg-zinc-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <p class="text-xs font-mono text-zinc-600 uppercase tracking-widest mb-6">Game pages with live data</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl">
        {publishedGames.map((g) => (
          <a
            href={g.href}
            class={`group bg-zinc-900 border ${g.color} rounded-xl p-5 flex items-start gap-4 transition-colors`}
          >
            <div class={`shrink-0 mt-0.5 w-2 h-2 rounded-full ${g.dot} ${g.pulse ? "animate-pulse" : ""}`}></div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono font-bold text-zinc-100 text-sm">{g.short}</span>
                <span class={`text-xs font-mono px-1.5 py-0.5 rounded ${g.badge}`}>
                  {g.year ?? "2026"}
                </span>
              </div>
              <div class="text-xs text-zinc-400 font-mono">{g.title}</div>
              <div class="text-xs text-zinc-600 font-mono mt-1">{g.desc}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">

    <!-- GTA VI prediction strip (teaser) -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse shrink-0"></span>
        <span class="text-xs font-mono text-zinc-600 uppercase tracking-widest">GTA VI — Key Predictions</span>
        <div class="flex-1 h-px bg-zinc-800"></div>
        <a href="/gta-vi" class="text-xs font-mono text-amber-600 hover:text-amber-500 transition-colors">
          Full analysis →
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {predictionsData.predictions.map((p) => (
          <PredictionCard
            title={p.title}
            value={p.value}
            confidence={p.confidence}
            basis={p.basis}
            unit={p.unit ?? undefined}
            trailerTimestamp={p.trailer_timestamp ?? undefined}
          />
        ))}
      </div>
    </section>

    <!-- Release history -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-2 h-2 rounded-full bg-zinc-500 shrink-0"></span>
        <span class="text-xs font-mono text-zinc-600 uppercase tracking-widest">Release History — All Games</span>
        <div class="flex-1 h-px bg-zinc-800"></div>
        <span class="text-xs font-mono text-zinc-700">GTA I → GTA VI</span>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <ReleaseTimeline />

        <!-- Cross-gen table -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
          <h3 class="font-mono font-semibold text-zinc-50 text-sm uppercase tracking-wider mb-4">
            Cross-Generation Growth
          </h3>
          <table class="w-full text-xs font-mono">
            <thead>
              <tr class="border-b border-zinc-800">
                <th class="text-left pb-2 text-zinc-600 font-normal">Title</th>
                <th class="text-right pb-2 text-zinc-600 font-normal">Year</th>
                <th class="text-right pb-2 text-zinc-600 font-normal">Price</th>
                <th class="text-right pb-2 text-zinc-600 font-normal">Map km²</th>
                <th class="text-right pb-2 text-zinc-600 font-normal">Vehicles</th>
              </tr>
            </thead>
            <tbody>
              {releasesData.games.map((g) => {
                const isPred   = g.is_prediction;
                const year     = g.release_year ?? (g as any).release_date_estimate;
                const price    = g.price_usd_launch    ?? (g as any).price_usd_estimate;
                const map      = g.map_size_km2        ?? (g as any).map_size_km2_estimate;
                const vehicles = g.vehicle_count       ?? (g as any).vehicle_count_estimate;
                return (
                  <tr class={`border-b border-zinc-800/50 ${isPred ? "text-amber-400" : "text-zinc-300"}`}>
                    <td class="py-2 font-semibold">
                      {g.short}{isPred && <span class="ml-1 text-amber-600 font-normal">*</span>}
                    </td>
                    <td class="text-right py-2 text-zinc-500">
                      {year ?? <span class="text-zinc-700">—</span>}
                    </td>
                    <td class="text-right py-2">
                      {price ? `$${price.toFixed(2)}` : <span class="text-zinc-700">—</span>}
                    </td>
                    <td class="text-right py-2">
                      {map ? `${map}${isPred ? "~" : ""}` : <span class="text-zinc-700">—</span>}
                    </td>
                    <td class="text-right py-2">
                      {vehicles ? `${vehicles}${isPred ? "~" : ""}` : <span class="text-zinc-700">—</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <p class="text-xs text-zinc-700 mt-4">* estimated · sources: Rockstar, Broughy1322, community records</p>
        </div>
      </div>
    </section>

    <!-- Footer links -->
    <section class="border border-zinc-800 rounded-xl p-6 bg-zinc-900/50">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <h3 class="font-mono font-semibold text-zinc-300 text-sm mb-1">GTA V — Live Data</h3>
          <p class="text-xs text-zinc-500 font-mono mb-3">
            133 months of Steam player history · 665 Broughy-tested vehicles ·
            Google Trends from 2013 to today.
          </p>
          <a href="/gta-v"
            class="text-xs font-mono text-amber-600 hover:text-amber-500 border border-amber-600/20 hover:border-amber-500/40 px-3 py-1.5 rounded transition-colors">
            Explore GTA V data →
          </a>
        </div>
        <div>
          <h3 class="font-mono font-semibold text-zinc-300 text-sm mb-1">GTA VI — Predictions</h3>
          <p class="text-xs text-zinc-500 font-mono mb-3">
            Release window, launch price, map size, and vehicle count —
            confidence-scored from 30 years of GTA history.
          </p>
          <a href="/gta-vi"
            class="text-xs font-mono text-amber-500 hover:text-amber-400 border border-amber-500/20 hover:border-amber-500/40 px-3 py-1.5 rounded transition-colors">
            View GTA VI predictions →
          </a>
        </div>
      </div>
    </section>

  </div>
</Base>
