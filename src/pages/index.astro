    <!-- ═══════════════════════════════════════════════════════
         FRAME-BY-FRAME TRAILER DISCOVERY TEASER
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Trailer 2 — Frame-by-Frame Entity Discovery</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-500">{t2Events.length} entities · {t2raw.duration_sec}s runtime</span>
        <a href="/charts" class="text-[10px] font-mono text-gta-gold/60 hover:text-gta-gold transition-colors tracking-widest uppercase">Full analysis →</a>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm">What Every Second of Trailer 2 Revealed</div>
          <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Each marker = a new entity confirmed. Colour = type. {t2Events.length} entities across {t2raw.duration_sec}s.</div>
        </div>

        <!-- Timeline strip -->
        <div class="px-5 py-6">
          <!-- Track -->
          <div class="relative h-8 rounded-full" style="background:#0e0e11;border:1px solid #1e1e23">
            <!-- Progress fill (amber gradient) -->
            <div class="absolute inset-y-0 left-0 right-0 rounded-full" style="background:linear-gradient(to right,#f59e0b18 0%,#f59e0b08 100%)"></div>
            <!-- Entity dots -->
            {t2Events.map((e: any) => (
              <div
                class="absolute top-1/2 w-3 h-3 rounded-full -translate-y-1/2 -translate-x-1/2 border-2 cursor-pointer transition-transform duration-150 hover:scale-175 hover:z-10"
                style={`left:${e.pct}%;background:${e.color};border-color:#131316`}
                title={`${e.entity} (${e.type}) @ ${e.ts}`}
              ></div>
            ))}
            <!-- Time label at end -->
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-mono text-zinc-500">
              {Math.floor(t2raw.duration_sec/60)}:{String(t2raw.duration_sec%60).padStart(2,"0")}
            </span>
          </div>

          <!-- Key entity labels below (most interesting ones) -->
          <div class="relative h-10 mt-1">
            {t2Events.filter((_: any, i: number) => i % 3 === 0).map((e: any) => (
              <div class="absolute text-[10px] font-mono whitespace-nowrap" style={`left:${e.pct}%;color:${e.color};opacity:0.7;transform:translateX(-50%)`}>
                {e.entity.split(" ")[0]}
              </div>
            ))}
          </div>
        </div>

        <!-- Legend -->
        <div class="px-5 py-3 border-t border-[#1e1e23] flex flex-wrap items-center gap-4 justify-between">
          <div class="flex flex-wrap gap-3">
            {Object.entries(t2TypeCounts).map(([type, count]) => (
              <span class="flex items-center gap-1.5 text-[10px] font-mono text-zinc-500">
                <span class="w-2 h-2 rounded-full inline-block shrink-0" style={`background:${TYPE_COLOR[type] ?? "#71717a"}`}></span>
                {type} <span class="text-zinc-500">({count as number})</span>
              </span>
            ))}
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span>
            <ShareDropdown anchorId="charts" shareText="GTA VI Trailer 2 is the most information-dense Rockstar trailer ever made. Frame-by-frame entity analysis: 24 confirmed discoveries in 167 seconds." size="sm" />
          </div>
        </div>
      </div>
    </section>

