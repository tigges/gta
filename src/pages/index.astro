---
import Base from "../layouts/Base.astro";
import CrossLinks from "../components/CrossLinks.astro";
import ReleaseTimeline from "../components/ReleaseTimeline.astro";
import PredictionCard from "../components/PredictionCard.astro";
import Countdown from "../components/Countdown.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import ShareDropdown from "../components/ShareDropdown.astro";

import type { TrailersData, Prediction, FeaturesData, TrailerVelocityData, TrailerAnalysisData, NewswireData } from "../types/gta";

import releasesData      from "../../data/shared/releases.json";
import predictionsData   from "../../data/gta-6/predictions.json";
import trailersDataRaw   from "../../data/gta-6/trailers.json";
import steamData         from "../../data/gta-5/meta/steam-players.json";
import featuresDataRaw   from "../../data/gta-6/features.json";
import trailerAnalysisRaw from "../../data/gta-6/trailer-analysis.json";
import newswireDataRaw   from "../../data/feeds/newswire.json";
import velocityDataRaw   from "../../data/gta-6/trailer-velocity.json";

const trailersData    = trailersDataRaw    as unknown as TrailersData;
const featuresData    = featuresDataRaw    as unknown as FeaturesData;
const trailerAnalysis = trailerAnalysisRaw as unknown as TrailerAnalysisData;
const newswireData    = newswireDataRaw    as unknown as NewswireData;
const velocityData    = velocityDataRaw    as unknown as TrailerVelocityData;

const latestTrailer  = trailersData.trailers[0] ?? null;
const trailer2Id     = "VQRLujxTm3c";
const trailer1Id     = "QdBZY2fkU-0";

// Derive live view counts from trailer-velocity.json (updated nightly)
const velTrailers = velocityData.trailers;
const vel1 = velTrailers.find(t => t.youtube_id === trailer1Id);
const vel2 = velTrailers.find(t => t.youtube_id === trailer2Id);
const t1Views = (vel1?.snapshots?.at(-1)?.views ?? 0) as number;
const t2Views = (vel2?.snapshots?.at(-1)?.views ?? 0) as number;
function fmtViews(n: number): string {
  if (n >= 1e9) return `${(n / 1e9).toFixed(1)}B+`;
  if (n >= 1e6) return `${Math.floor(n / 1e7) * 10}M+`;
  return `${Math.round(n / 1e3)}k+`;
}
const t1ViewsStr = fmtViews(t1Views);
const t2ViewsStr = fmtViews(t2Views);

const latestSteam    = steamData.data.at(-1);
const peakSteam      = steamData.data.reduce((a, b) => a.avg_players > b.avg_players ? a : b);

// Thumbnail art per prediction card
const predThumbnails: Record<string, string> = {
  "pred-release-window":  "/assets/gta6/characters/Lucia_Caminos_01.jpg",
  "pred-launch-price":    "/assets/gta6/characters/Jason_Duval_02.jpg",
  "pred-map-size":        "/assets/gta6/locations/Vice_City_01.jpg",
  "pred-vehicles-launch": "/assets/gta6/locations/Port_Gellhorn_01.jpg",
};

// Cover art map for release timeline table
const RELEASE_COVERS: Record<string, string> = {
  "GTA 1":  "/assets/covers/gta-1.jpg",
  "GTA 2":  "/assets/covers/gta-2.jpg",
  "GTA III": "/assets/covers/gta-3.jpg",
  "GTA VC":  "/assets/covers/gta-vc.jpg",
  "GTA SA":  "/assets/covers/gta-sa.jpg",
  "GTA IV":  "/assets/covers/gta-4.jpg",
  "GTA V":   "/assets/covers/gta-5.jpg",
  "GTA VI":  "/assets/covers/gta-6.jpg",
};

// ── Feature Tracker teaser ────────────────────────────────────────────────
const CAT_THUMBS_HOME: Record<string,string> = {
  regions:    "/assets/gta6/locations/Vice_City_06.jpg",
  vehicles:   "/assets/gta6/locations/Port_Gellhorn_03.jpg",
  characters: "/assets/gta6/characters/Lucia_Caminos_01.jpg",
  weapons:    "/assets/gta6/locations/Grassrivers_03.jpg",
  businesses: "/assets/gta6/locations/Ambrosia_02.jpg",
  activities: "/assets/gta6/locations/Leonida_Keys_01.jpg",
  wildlife:   "/assets/gta6/locations/Grassrivers_01.jpg",
  online:     "/assets/gta6/locations/Vice_City_03.jpg",
};
const TEASER_CATS = ["vehicles", "characters", "regions", "wildlife"];
const featCats    = featuresData.categories.filter(c => TEASER_CATS.includes(c.id));
const totalTracked = featuresData.categories.reduce((s: number, c) => s + c.confirmed + c.reported, 0);

// ── Frame-by-Frame teaser ─────────────────────────────────────────────────
const TYPE_COLOR: Record<string,string> = {
  vehicle:   "#f59e0b",
  character: "#0d9488",
  location:  "#3b82f6",
  weapon:    "#ef4444",
  audio:     "#8b5cf6",
  wildlife:  "#22c55e",
  reveal:    "#f1f5f9",
};
const t2raw = trailerAnalysis.trailers[1];
const t2Events = t2raw.events.map(e => ({
  ...e,
  pct: +((e.t / t2raw.duration_sec) * 100).toFixed(1),
  color: TYPE_COLOR[e.type] ?? "#71717a",
  ts: `${Math.floor(e.t/60)}:${String(e.t%60).padStart(2,"0")}`,
}));
// Count by type for legend
const t2TypeCounts = t2Events.reduce((acc: Record<string,number>, e: any) => {
  acc[e.type] = (acc[e.type] ?? 0) + 1;
  return acc;
}, {} as Record<string,number>);

// ── News digest ───────────────────────────────────────────────────────────
const recentNews = newswireData.items.slice(0, 3);
const TIER_COLOR: Record<string,string> = {
  press:     "text-gta-gold",
  official:  "text-gta-teal",
  community: "text-blue-400",
};
---

<Base
  titleContext="gta-vi"
  title="GTA VI.AI"
  description="Data-driven intelligence across every GTA generation — live signals, franchise analytics, and what the numbers say about GTA VI."
  ogPage="home"
>

  <!-- ═══════════════════════════════════════════════════════
       HERO — full-bleed behind nav, content bottom, compact trailer card
  ═══════════════════════════════════════════════════════ -->
  <section class="hero-bleed relative overflow-hidden" style="min-height:min(88vh,780px);display:flex;align-items:flex-end">

    <!-- Background: bleeds from top-0, behind the sticky nav -->
    <div class="absolute inset-0">
      <img
        src={`https://img.youtube.com/vi/${trailer2Id}/maxresdefault.jpg`}
        alt="Grand Theft Auto VI — official trailer"
        class="w-full h-full object-cover"
        style="object-position: center 18%"
        loading="eager"
      />
      <div class="absolute inset-0" style="background:linear-gradient(to top, #0e0e11 0%, #0e0e11cc 30%, #0e0e1155 60%, transparent 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to right, #0e0e11 0%, #0e0e1170 40%, transparent 70%)"></div>
      <!-- Top fade so nav text stays readable when transparent -->
      <div class="absolute inset-x-0 top-0 h-32" style="background:linear-gradient(to bottom, #0e0e1160 0%, transparent 100%)"></div>
      <div class="absolute inset-0 opacity-20" style="background-image:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22300%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/></filter><rect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22 opacity=%220.04%22/></svg>');background-size:300px"></div>
    </div>

    <!-- Hero content — sits at the bottom, like VI Intel page -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pb-10 sm:pb-14 w-full">
      <div class="flex items-end justify-between gap-6 flex-wrap sm:flex-nowrap">

        <!-- Left: text + countdown + CTAs -->
        <div class="max-w-lg">
          <div class="inline-flex items-center gap-2 mb-4 border border-gta-gold/20 bg-gta-gold/6 rounded px-2.5 py-1">
            <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse"></span>
            <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-[0.2em]">Live intelligence · updated nightly</span>
          </div>
          <div class="font-mono font-bold tracking-[0.25em] text-gta-gold mb-1 text-sm uppercase">GTA VI.AI</div>
          <h1 class="text-4xl sm:text-5xl font-bold text-white leading-[1.1] mb-3">
            Every signal.<br/>
            <span class="text-gta-bright">One source.</span>
          </h1>
          <p class="text-zinc-400 text-sm leading-relaxed mb-6 max-w-sm">
            30 years of GTA data, quantified. Live franchise analytics,
            confidence-scored predictions, and everything the numbers say about GTA VI.
          </p>
          <div class="mb-6">
            <Countdown variant="hero" />
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/gta-vi/intel"
              class="inline-flex items-center gap-2 bg-gta-gold hover:bg-gta-bright text-black font-mono font-bold text-xs px-5 py-2.5 rounded transition-colors tracking-wide uppercase">
              GTA VI Intel →
            </a>
            <a href="/gta-vi/buy"
              class="inline-flex items-center gap-2 border border-gta-gold/30 hover:border-gta-gold/60 text-gta-gold/80 hover:text-gta-gold font-mono text-xs px-5 py-2.5 rounded transition-colors tracking-wide uppercase">
              Buy GTA VI
            </a>
            {latestTrailer && (
              <a href={`https://www.youtube.com/watch?v=${latestTrailer.youtube_id}`}
                target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border border-[#2a2a31] hover:border-zinc-600 text-zinc-300 hover:text-white font-mono text-xs px-5 py-2.5 rounded transition-colors tracking-wide">
                ▶ Latest Trailer
              </a>
            )}
          </div>
        </div>

        <!-- Right: Trailer 2 thumbnail card (VI Intel style, bigger) -->
        <div class="hidden sm:block shrink-0 w-72 lg:w-80">
          <a href={`https://www.youtube.com/watch?v=${trailer2Id}`}
            target="_blank" rel="noopener noreferrer"
            class="group relative overflow-hidden rounded-xl border border-[#2a2a31] hover:border-gta-gold/30 shadow-2xl shadow-black/70 block transition-all duration-200">
            <div class="relative aspect-video overflow-hidden">
              <img
                src={`https://img.youtube.com/vi/${trailer2Id}/maxresdefault.jpg`}
                alt="Grand Theft Auto VI — Official Trailer 2"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="eager"
              />
              <div class="absolute inset-0" style="background:linear-gradient(to top,#0e0e11 0%,transparent 60%)"></div>
              <!-- Play button -->
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-black/50 border border-gta-gold/30 flex items-center justify-center group-hover:bg-gta-gold/20 group-hover:border-gta-gold/60 transition-all duration-300">
                  <span class="text-white text-lg ml-0.5">▶</span>
                </div>
              </div>
              <!-- Official badge -->
              <div class="absolute top-2.5 left-2.5">
                <span class="text-[10px] font-mono bg-gta-gold/15 text-gta-gold border border-gta-gold/20 px-1.5 py-0.5 rounded uppercase tracking-widest">Official · Trailer 2</span>
              </div>
              <!-- Title overlay -->
              <div class="absolute bottom-0 left-0 right-0 px-3 pb-3">
                <div class="text-xs font-semibold text-white leading-tight">Grand Theft Auto VI — Trailer 2</div>
                <div class="text-[11px] font-mono text-zinc-500 mt-0.5">May 6, 2025 · 159M+ views</div>
              </div>
            </div>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       FRANCHISE SIGNAL STRIP — live numbers
  ═══════════════════════════════════════════════════════ -->
  <section class="border-y border-[#1e1e23]" style="background:#0a0a0d">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-[#1e1e23]">
        {[
          { value: "475M+", label: "Trailer 1 views · 24h record", source: "YouTube" },
          { value: `${latestSteam?.avg_players?.toLocaleString() ?? "—"}`, label: "GTA V avg players · last month", source: "SteamCharts" },
          { value: "225M+", label: "GTA V copies sold · lifetime", source: "Take-Two IR" },
          { value: "Nov 19", label: "GTA VI launch date · confirmed", source: "Rockstar Games" },
        ].map(s => (
          <div class="px-5 py-4">
            <div class="text-xl font-mono font-bold text-gta-bright">{s.value}</div>
            <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug">{s.label}</div>
            <div class="text-[10px] font-mono text-zinc-500 mt-1">via {s.source}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 flex flex-col gap-16">

    <!-- ═══════════════════════════════════════════════════════
         GTA VI SIGNAL INTELLIGENCE
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI Signal Intelligence</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/gta-vi/intel" class="text-[10px] font-mono text-gta-gold/70 hover:text-gta-gold transition-colors tracking-widest uppercase">Full analysis →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {(predictionsData.predictions as Prediction[]).map((p) => (
          <PredictionCard
            id={(p as Prediction).id}
            title={p.title}
            value={p.value}
            confidence={p.confidence}
            confidence_tier={p.confidence_tier}
            basis={p.basis}
            unit={p.unit}
            trailer_timestamp={p.trailer_timestamp}
            prediction_method={p.prediction_method}
            prediction_range={p.prediction_range}
            source={p.source}
            source_type={p.source_type}
            outcome_verified={p.outcome_verified}
            outcome_actual={p.outcome_actual}
              thumbnail={(p as any).thumbnail ?? predThumbnails[(p as Prediction).id]}
            compact={true}
            detailHref={`/gta-vi/intel#${(p as Prediction).id}`}
          />
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         SECTION NAV — visual deep links to all major sections
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Explore</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {([
          { href: "/vi-intel",  label: "VI Intel",   sub: "Cast · locations · predictions", img: "/assets/gta6/characters/Jason_Duval_01.jpg",    accent: "border-gta-gold/30",   badge: "text-gta-gold",   pos: "center top" },
          { href: "/charts",    label: "Charts",     sub: "D3 analytics · live signals",    img: "/assets/gta6/locations/Vice_City_01.jpg",         accent: "border-indigo-500/30", badge: "text-indigo-300", pos: "center 30%" },
          { href: "/database",  label: "Database",   sub: "1,715 entities · 665 vehicles",  img: "/assets/gta6/characters/Raul_Bautista_01.jpg",   accent: "border-gta-teal/30",   badge: "text-gta-teal",   pos: "center top" },
          { href: "/franchise", label: "Franchise",  sub: "30yr history · DLC · sales",     img: "/assets/gta6/locations/Port_Gellhorn_03.jpg",    accent: "border-purple-500/30", badge: "text-purple-300", pos: "center 40%" },
          { href: "/news",      label: "News",       sub: "Rockstar · community · live",    img: "/assets/gta6/locations/Leonida_Keys_01.jpg",     accent: "border-green-500/30",  badge: "text-green-300",  pos: "center 50%" },
        ] as const).map(s => (
          <a href={s.href} class={`group relative overflow-hidden rounded-xl border ${s.accent} hover:brightness-110 transition-all duration-300`} style="min-height:120px;background:#131316">
            <img src={s.img} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-45 transition-opacity duration-500 scale-105 group-hover:scale-110 transition-transform duration-700" style={`object-position:${s.pos}`} loading="lazy" aria-hidden="true" />
            <div class="absolute inset-0" style="background:linear-gradient(to top,#131316 20%,transparent 80%)"></div>
            <div class="relative p-4 h-full flex flex-col justify-end">
              <div class={`text-[10px] font-mono font-bold ${s.badge} mb-0.5 uppercase tracking-widest`}>{s.label}</div>
              <div class="text-[10px] text-zinc-500 leading-snug">{s.sub}</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         FEATURE TRACKER TEASER
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="w-2 h-2 rounded-full bg-gta-teal shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI Confirmed Feature Tracker</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-500">{totalTracked} entries tracked</span>
        <a href="/gta-vi/intel" class="text-[10px] font-mono text-gta-gold/60 hover:text-gta-gold transition-colors tracking-widest uppercase">Full tracker →</a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        {featCats.map((cat: any) => {
          const thumb = CAT_THUMBS_HOME[cat.id];
          const confirmedPct = Math.min(100, Math.round((cat.confirmed / cat.target) * 100));
          const reportedPct  = Math.min(100 - confirmedPct, Math.round((cat.reported / cat.target) * 100));
          return (
            <a href="/gta-vi/intel" class="relative group overflow-hidden rounded-xl border border-[#1e1e23] hover:border-[#2a2a31] transition-all" style="background:#131316;min-height:160px">
              {thumb && (
                <div class="absolute inset-0">
                  <img src={thumb} alt="" class="w-full h-full object-cover opacity-20 group-hover:opacity-30 transition-opacity duration-500 group-hover:scale-105 transition-transform duration-700" loading="lazy" aria-hidden="true" />
                  <div class="absolute inset-0" style="background:linear-gradient(to bottom,#131316 0%,transparent 40%,#131316 100%)"></div>
                </div>
              )}
              <div class="relative px-4 py-4 flex flex-col h-full">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-lg">{cat.icon}</span>
                  <span class="text-xs font-bold text-zinc-200">{cat.label}</span>
                </div>
                <div class="flex items-baseline gap-1.5 mb-2.5">
                  <span class="text-2xl font-mono font-bold text-gta-gold">{cat.confirmed}</span>
                  <span class="text-[10px] font-mono text-zinc-600">confirmed</span>
                  <span class="text-zinc-500 mx-0.5">·</span>
                  <span class="text-sm font-mono text-zinc-400">{cat.reported}</span>
                  <span class="text-[10px] font-mono text-zinc-600">reported</span>
                </div>
                <div class="h-1 rounded-full overflow-hidden flex mt-auto" style="background:#1e1e23">
                  {confirmedPct > 0 && <div class="h-full bg-gta-gold" style={`width:${confirmedPct}%`}></div>}
                  {reportedPct  > 0 && <div class="h-full bg-zinc-500 ml-px" style={`width:${reportedPct}%`}></div>}
                </div>
                <div class="flex items-center justify-between mt-1">
                  <span class="text-[11px] font-mono text-zinc-500">{confirmedPct}% confirmed</span>
                  <span class="text-[11px] font-mono text-zinc-500">/ {cat.target} est.</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      <div class="mt-3 flex items-center justify-between">
        <span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span>
        <ShareDropdown anchorId="vi-intel" shareText={`GTA VI has ${totalTracked}+ entries tracked: ${featCats.map((c: any) => `${c.confirmed} ${c.label.toLowerCase()} confirmed`).join(', ')}. Full feature tracker.`} size="sm" />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         OFFICIAL TRAILERS
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Official Footage</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/gta-vi/intel" class="text-[10px] font-mono text-gta-gold/70 hover:text-gta-gold transition-colors tracking-widest uppercase">Full trailers →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { id: trailer1Id, title: "Trailer 1", date: "Dec 4, 2023", views: "475M+ views · 24h record", badge: "OFFICIAL" },
          { id: trailer2Id, title: "Trailer 2", date: "May 6, 2025", views: "159M+ views · 2:47 runtime", badge: "OFFICIAL" },
        ].map(t => (
          <a
            href={`https://www.youtube.com/watch?v=${t.id}`}
            target="_blank" rel="noopener noreferrer"
            class="group relative overflow-hidden rounded-xl border border-[#1e1e23] hover:border-gta-gold/30 transition-all duration-200"
          >
            <!-- Thumbnail -->
            <div class="relative aspect-video overflow-hidden">
              <img
                src={`https://img.youtube.com/vi/${t.id}/maxresdefault.jpg`}
                alt={`GTA VI ${t.title}`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0" style="background:linear-gradient(to top, #0e0e11 0%, transparent 60%)"></div>
              <!-- Play button -->
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-black/60 border border-white/20 flex items-center justify-center group-hover:bg-gta-gold/20 group-hover:border-gta-gold/40 transition-all duration-200">
                  <span class="text-white text-lg ml-0.5">▶</span>
                </div>
              </div>
              <!-- Badge -->
              <div class="absolute top-3 left-3">
                <span class="text-[11px] font-mono bg-gta-gold/15 text-gta-gold border border-gta-gold/20 px-2 py-0.5 rounded uppercase tracking-widest">{t.badge}</span>
              </div>
            </div>
            <!-- Info bar -->
            <div class="px-4 py-3 flex items-center justify-between">
              <div>
                <div class="font-semibold text-zinc-200 text-sm">Grand Theft Auto VI — {t.title}</div>
                <div class="text-[11px] text-zinc-600 font-mono mt-0.5">{t.date} · {t.views}</div>
              </div>
              <span class="text-zinc-600 group-hover:text-gta-gold transition-colors text-xs font-mono">↗</span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-3 flex items-center justify-between">
        <span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span>
        <ShareDropdown anchorId="share" shareText="GTA VI has two official trailers. Trailer 1: 475M+ views (YouTube 24h record). Trailer 2: 159M views. The hype is unlike anything in gaming." size="sm" />
      </div>
