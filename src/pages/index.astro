---
import Base from "../layouts/Base.astro";
import CrossLinks from "../components/CrossLinks.astro";
import ReleaseTimeline from "../components/ReleaseTimeline.astro";
import PredictionCard from "../components/PredictionCard.astro";
import Countdown from "../components/Countdown.astro";

import type { TrailersData, Prediction } from "../types/gta";

import releasesData    from "../../data/shared/releases.json";
import predictionsData from "../../data/gta-6/predictions.json";
import trailersDataRaw from "../../data/gta-6/trailers.json";
import steamData       from "../../data/gta-5/meta/steam-players.json";

const trailersData   = trailersDataRaw as TrailersData;
const latestTrailer  = trailersData.trailers[0] ?? null;
const trailer2Id     = "VQRLujxTm3c";
const trailer1Id     = "QdBZY2fkU-0";

const latestSteam    = steamData.data.at(-1);
const peakSteam      = steamData.data.reduce((a, b) => a.avg_players > b.avg_players ? a : b);
---

<Base
  title="GTA VI.AI"
  description="Data-driven intelligence across every GTA generation — live signals, franchise analytics, and what the numbers say about GTA VI."
  ogImage={`https://img.youtube.com/vi/${trailer2Id}/maxresdefault.jpg`}
>

  <!-- ═══════════════════════════════════════════════════════
       HERO — full-bleed Trailer 2 with gradient overlay
  ═══════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden" style="min-height:580px;display:flex;align-items:flex-end">

    <!-- Background: official YouTube thumbnail (Trailer 2) -->
    <div class="absolute inset-0">
      <img
        src={`https://img.youtube.com/vi/${trailer2Id}/maxresdefault.jpg`}
        alt="Grand Theft Auto VI — official trailer"
        class="w-full h-full object-cover"
        style="object-position: center 18%"
        loading="eager"
      />
      <!-- Gradient overlays: bottom-to-top dark fade + left vignette -->
      <div class="absolute inset-0" style="background:linear-gradient(to top, #0e0e11 0%, #0e0e1188 40%, transparent 75%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to right, #0e0e11 0%, #0e0e1160 35%, transparent 65%)"></div>
      <!-- Subtle noise texture -->
      <div class="absolute inset-0 opacity-30" style="background-image:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22300%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/></filter><rect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22 opacity=%220.04%22/></svg>');background-size:300px"></div>
    </div>

    <!-- Hero content -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pb-16 pt-24 w-full">
      <div class="max-w-xl">

        <!-- Signal badge -->
        <div class="inline-flex items-center gap-2 mb-5 border border-gta-gold/20 bg-gta-gold/6 rounded px-2.5 py-1">
          <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse"></span>
          <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-[0.2em]">Live intelligence · updated nightly</span>
        </div>

        <!-- Wordmark -->
        <div class="font-mono font-bold tracking-[0.25em] text-gta-gold mb-1 text-sm uppercase">GTA VI.AI</div>
        <h1 class="text-4xl sm:text-5xl font-bold text-white leading-[1.1] mb-4" style="font-family:'Inter',sans-serif">
          Every signal.<br/>
          <span class="text-gta-bright">One source.</span>
        </h1>
        <p class="text-zinc-400 text-sm leading-relaxed mb-7 max-w-sm" style="font-family:'Inter',sans-serif">
          30 years of GTA data, quantified. Live franchise analytics,
          confidence-scored predictions, and everything the numbers say about GTA VI.
        </p>

        <!-- Countdown -->
        <div class="mb-7">
          <Countdown variant="hero" />
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3">
          <a href="/vi-intel"
            class="inline-flex items-center gap-2 bg-gta-gold hover:bg-gta-bright text-black font-mono font-bold text-xs px-5 py-2.5 rounded transition-colors tracking-wide uppercase">
            GTA VI Intel →
          </a>
          <a href="/gta-v"
            class="inline-flex items-center gap-2 border border-[#2a2a31] hover:border-zinc-600 text-zinc-300 hover:text-white font-mono text-xs px-5 py-2.5 rounded transition-colors tracking-wide">
            GTA V Data
          </a>
          {latestTrailer && (
            <a href={`https://www.youtube.com/watch?v=${latestTrailer.youtube_id}`}
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-[#2a2a31] hover:border-zinc-600 text-zinc-300 hover:text-white font-mono text-xs px-5 py-2.5 rounded transition-colors tracking-wide">
              ▶ Latest Trailer
            </a>
          )}
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       FRANCHISE SIGNAL STRIP — live numbers
  ═══════════════════════════════════════════════════════ -->
  <section class="border-y border-[#1e1e23]" style="background:#0a0a0d">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-[#1e1e23]">
        {[
          { value: "475M+", label: "Trailer 1 views · 24h record", source: "YouTube" },
          { value: `${latestSteam?.avg_players?.toLocaleString() ?? "—"}`, label: "GTA V avg players · last month", source: "SteamCharts" },
          { value: "225M+", label: "GTA V copies sold · lifetime", source: "Take-Two IR" },
          { value: "Nov 19", label: "GTA VI launch date · confirmed", source: "Rockstar Games" },
        ].map(s => (
          <div class="px-5 py-4">
            <div class="text-xl font-mono font-bold text-gta-bright">{s.value}</div>
            <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug" style="font-family:'Inter',sans-serif">{s.label}</div>
            <div class="text-[10px] font-mono text-zinc-700 mt-1">via {s.source}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 flex flex-col gap-16">

    <!-- ═══════════════════════════════════════════════════════
         GTA VI SIGNAL INTELLIGENCE
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA VI Signal Intelligence</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/vi-intel" class="text-[10px] font-mono text-gta-gold/70 hover:text-gta-gold transition-colors tracking-widest uppercase">Full analysis →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {(predictionsData.predictions as Prediction[]).map((p) => (
          <PredictionCard
            title={p.title}
            value={p.value}
            confidence={p.confidence}
            confidence_tier={p.confidence_tier}
            basis={p.basis}
            unit={p.unit}
            trailer_timestamp={p.trailer_timestamp}
            prediction_method={p.prediction_method}
            prediction_range={p.prediction_range}
            source={p.source}
            source_type={p.source_type}
            outcome_verified={p.outcome_verified}
            outcome_actual={p.outcome_actual}
          />
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         OFFICIAL TRAILERS
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Official Footage</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">Rockstar Games · YouTube</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { id: trailer1Id, title: "Trailer 1", date: "Dec 4, 2023", views: "475M+ views · 24h record", badge: "OFFICIAL" },
          { id: trailer2Id, title: "Trailer 2", date: "May 6, 2025", views: "159M+ views · 2:47 runtime", badge: "OFFICIAL" },
        ].map(t => (
          <a
            href={`https://www.youtube.com/watch?v=${t.id}`}
            target="_blank" rel="noopener noreferrer"
            class="group relative overflow-hidden rounded-xl border border-[#1e1e23] hover:border-gta-gold/30 transition-all duration-200"
          >
            <!-- Thumbnail -->
            <div class="relative aspect-video overflow-hidden">
              <img
                src={`https://img.youtube.com/vi/${t.id}/maxresdefault.jpg`}
                alt={`GTA VI ${t.title}`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0" style="background:linear-gradient(to top, #0e0e11 0%, transparent 60%)"></div>
              <!-- Play button -->
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-black/60 border border-white/20 flex items-center justify-center group-hover:bg-gta-gold/20 group-hover:border-gta-gold/40 transition-all duration-200">
                  <span class="text-white text-lg ml-0.5">▶</span>
                </div>
              </div>
              <!-- Badge -->
              <div class="absolute top-3 left-3">
                <span class="text-[9px] font-mono bg-gta-gold/15 text-gta-gold border border-gta-gold/20 px-2 py-0.5 rounded uppercase tracking-widest">{t.badge}</span>
              </div>
            </div>
            <!-- Info bar -->
            <div class="px-4 py-3 flex items-center justify-between">
              <div>
                <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">Grand Theft Auto VI — {t.title}</div>
                <div class="text-[11px] text-zinc-600 font-mono mt-0.5">{t.date} · {t.views}</div>
              </div>
              <span class="text-zinc-600 group-hover:text-gta-gold transition-colors text-xs font-mono">↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         CONFIRMED CAST — preview strip
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Confirmed Cast</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/vi-intel" class="text-[10px] font-mono text-gta-gold/60 hover:text-gta-gold transition-colors tracking-widest uppercase">Full profiles →</a>
      </div>
      <div class="flex gap-3 overflow-x-auto pb-1">
        {([
          { name: "Lucia Caminos",  role: "Protagonist", img: "Lucia_Caminos_03.jpg"  },
          { name: "Jason Duval",    role: "Protagonist", img: "Jason_Duval_04.jpg"    },
          { name: "Raul Bautista",  role: "Supporting",  img: "Raul_Bautista_02.jpg"  },
          { name: "Boobie Ike",     role: "Supporting",  img: "Boobie_Ike_02.jpg"     },
          { name: "Brian Heder",    role: "Supporting",  img: "Brian_Heder_02.jpg"    },
          { name: "Cal Hampton",    role: "Supporting",  img: "Cal_Hampton_02.jpg"    },
          { name: "DreQuan Priest", role: "Supporting",  img: "DreQuan_Priest_02.jpg" },
          { name: "Real Dimez",     role: "Supporting",  img: "Real_Dimez_02.jpg"     },
        ] as const).map(c => (
          <a href="/vi-intel" class="shrink-0 w-24 sm:w-28 group">
            <div class="aspect-[3/4] rounded-xl overflow-hidden relative mb-1.5 border border-[#1e1e23] group-hover:border-gta-gold/30 transition-all duration-300">
              <img
                src={`/assets/gta6/characters/${c.img}`}
                alt={c.name}
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0" style="background:linear-gradient(to top,#0e0e11 0%,#0e0e1160 30%,transparent 55%)"></div>
              {c.role === "Protagonist" && (
                <div class="absolute top-1.5 right-1.5">
                  <span class="text-[7px] font-mono bg-gta-gold/15 text-gta-gold border border-gta-gold/20 px-1 py-0.5 rounded uppercase">Lead</span>
                </div>
              )}
              <div class="absolute bottom-1.5 left-2 right-2">
                <div class="text-[9px] font-mono text-white truncate leading-tight">{c.name.split(" ")[0]}</div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         RELEASE HISTORY
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-7">
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Franchise Release History</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">GTA I → GTA VI · 30 years</span>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <ReleaseTimeline />

        <!-- Cross-gen stats table -->
        <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
          <div class="px-5 py-4 border-b border-[#1e1e23]">
            <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em]">// Cross-Generation Growth</div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="border-b border-[#1e1e23]">
                  <th class="text-left px-5 py-2.5 text-zinc-600 font-normal">Title</th>
                  <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">Year</th>
                  <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">Price</th>
                  <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">Map km²</th>
                  <th class="text-right px-5 py-2.5 text-zinc-600 font-normal">Vehicles</th>
                </tr>
              </thead>
              <tbody>
                {releasesData.games.map((g) => {
                  const isPred   = g.is_prediction;
                  const year     = g.release_year ?? (g as any).release_date_estimate;
                  const price    = g.price_usd_launch    ?? (g as any).price_usd_estimate;
                  const map      = g.map_size_km2        ?? (g as any).map_size_km2_estimate;
                  const vehicles = g.vehicle_count       ?? (g as any).vehicle_count_estimate;
                  return (
                    <tr class={`border-b border-[#1e1e23]/50 transition-colors hover:bg-white/2 ${isPred ? "text-gta-gold" : "text-zinc-300"}`}>
                      <td class="px-5 py-2.5 font-semibold">
                        {g.short}
                        {isPred && <span class="ml-1.5 text-[9px] font-mono bg-gta-gold/10 text-gta-gold/70 border border-gta-gold/15 px-1 py-0.5 rounded uppercase tracking-widest align-middle">est</span>}
                      </td>
                      <td class="px-4 py-2.5 text-right text-zinc-600">{year ?? "—"}</td>
                      <td class="px-4 py-2.5 text-right">{price ? `$${price.toFixed(0)}` : <span class="text-zinc-700">—</span>}</td>
                      <td class="px-4 py-2.5 text-right">{map ?? <span class="text-zinc-700">—</span>}</td>
                      <td class="px-5 py-2.5 text-right">{vehicles ?? <span class="text-zinc-700">—</span>}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <div class="px-5 py-3 border-t border-[#1e1e23]">
            <span class="text-[10px] text-zinc-700 font-mono">est = estimated · sources: Rockstar, Broughy1322, community records</span>
          </div>
        </div>
      </div>
    </section>

    <CrossLinks context="home" />

    <!-- ═══════════════════════════════════════════════════════
         GAME PAGES FOOTER NAV
    ═══════════════════════════════════════════════════════ -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- GTA V card -->
      <a href="/gta-v" class="group relative overflow-hidden rounded-xl border border-[#1e1e23] hover:border-[#2a2a31] p-5 flex items-start gap-4 transition-all" style="min-height:140px;background:#131316">
        <div class="absolute inset-0 overflow-hidden">
          <img src="/assets/covers/gta-5.jpg" alt="" class="absolute right-0 top-0 h-full w-auto object-cover opacity-15 group-hover:opacity-25 transition-opacity duration-500" aria-hidden="true" style="filter:saturate(0.6)" />
          <div class="absolute inset-0" style="background:linear-gradient(to right,#131316 30%,transparent 100%)"></div>
        </div>
        <div class="relative shrink-0 w-1 self-stretch rounded-full bg-amber-700/50 group-hover:bg-gta-gold/50 transition-colors"></div>
        <div class="relative">
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-1">GTA V · 2013</div>
          <div class="font-semibold text-zinc-200 text-sm mb-1 group-hover:text-white transition-colors" style="font-family:'Inter',sans-serif">Grand Theft Auto V — Live Data</div>
          <div class="text-xs text-zinc-500" style="font-family:'Inter',sans-serif">133 months of Steam players · 665 Broughy-tested vehicles · Google Trends 2013–2026</div>
          <div class="mt-3 text-[10px] font-mono text-gta-gold/60 group-hover:text-gta-gold transition-colors tracking-widest uppercase">Explore data →</div>
        </div>
      </a>
      <!-- GTA VI card -->
      <a href="/vi-intel" class="group relative overflow-hidden rounded-xl border border-gta-gold/20 hover:border-gta-gold/40 p-5 flex items-start gap-4 transition-all" style="min-height:140px;background:#131316">
        <div class="absolute inset-0 overflow-hidden">
          <img src="/assets/gta6/locations/Vice_City_07.jpg" alt="" class="w-full h-full object-cover opacity-15 group-hover:opacity-25 transition-opacity duration-500" aria-hidden="true" style="object-position:center 40%" />
          <div class="absolute inset-0" style="background:linear-gradient(to right,#131316 20%,transparent 100%)"></div>
        </div>
        <div class="relative shrink-0 w-1 self-stretch rounded-full bg-gta-gold/50 group-hover:bg-gta-gold transition-colors"></div>
        <div class="relative">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest">GTA VI · 2026</span>
            <span class="text-[9px] font-mono bg-gta-teal/10 text-gta-teal border border-gta-teal/20 px-1.5 py-0.5 rounded uppercase tracking-widest">Live</span>
          </div>
          <div class="font-semibold text-zinc-200 text-sm mb-1 group-hover:text-white transition-colors" style="font-family:'Inter',sans-serif">Grand Theft Auto VI — Intelligence</div>
          <div class="text-xs text-zinc-500" style="font-family:'Inter',sans-serif">Predictions · Trailers · Search trends · Franchise economics · Methodology</div>
          <div class="mt-3 text-[10px] font-mono text-gta-gold/60 group-hover:text-gta-gold transition-colors tracking-widest uppercase">View intel →</div>
        </div>
      </a>
    </section>

  </div>
</Base>
