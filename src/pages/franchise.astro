---
import Base from "../layouts/Base.astro";
import CrossLinks from "../components/CrossLinks.astro";
import ShareButton from "../components/ShareButton.astro";

import salesData      from "../../data/franchise/sales.json";
import metacriticData from "../../data/franchise/metacritic.json";
import releasesData   from "../../data/shared/releases.json";
import steamData      from "../../data/gta-5/meta/steam-players.json";
import dlcData        from "../../data/gta-5/dlc/timeline.json";

const totalSales = salesData.titles.reduce((s: number, t: any) => s + (t.total_units_m ?? 0), 0);
const gta5 = salesData.titles.find((t: any) => t.id === "gta-5");

// Pre-group DLC updates by year for the timeline section
const dlcByYear: Array<{ year: string; updates: typeof dlcData.updates }> = [];
for (const u of dlcData.updates) {
  const y = u.date.slice(0, 4);
  const existing = dlcByYear.find(g => g.year === y);
  if (existing) {
    existing.updates.push(u);
  } else {
    dlcByYear.push({ year: y, updates: [u] });
  }
}
const dlcMajorCount   = dlcData.updates.filter((d: any) => d.category === "major").length;
const dlcContentCount = dlcData.updates.filter((d: any) => d.category === "content").length;
---

<Base
  title="Franchise"
  description="30 years of GTA franchise data — sales velocity, review scores, map progression, DLC history and the economics behind GTA VI."
  ogPage="franchise"
>

  <!-- Header -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden">
    <div class="absolute inset-0">
      <img src="/assets/gta6/locations/Port_Gellhorn_03.jpg" alt="" class="w-full h-full object-cover" style="object-position:center 50%" aria-hidden="true" />
      <div class="absolute inset-0" style="background:linear-gradient(to right, #0a0a0d 0%, #0a0a0dcc 55%, #0a0a0d88 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom, transparent 0%, #0a0a0d 100%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// Historical Context</div>
      <h1 class="text-3xl font-bold text-white mb-2" style="font-family:'Inter',sans-serif">Franchise</h1>
      <p class="text-sm text-zinc-400 max-w-xl mb-5" style="font-family:'Inter',sans-serif">
        30 years of GTA quantified. Sales, review scores, map growth and player history —
        the data that drives the GTA VI predictions.
      </p>
      <!-- Game cover strip -->
      <div class="flex items-center gap-2.5 mb-6">
        {([
          { id: "gta-1",  short: "GTA 1",  year: "1997" },
          { id: "gta-2",  short: "GTA 2",  year: "1999" },
          { id: "gta-3",  short: "GTA III", year: "2001" },
          { id: "gta-vc", short: "GTA VC",  year: "2002" },
          { id: "gta-sa", short: "GTA SA",  year: "2004" },
          { id: "gta-4",  short: "GTA IV",  year: "2008" },
          { id: "gta-5",  short: "GTA V",   year: "2013" },
          { id: "gta-6",  short: "GTA VI",  year: "2026" },
        ] as const).map(g => (
          <div class="flex flex-col items-center gap-1 group">
            <img
              src={`/assets/covers/${g.id}.jpg`} alt={g.short}
              class={`rounded border object-cover transition-all duration-200 group-hover:scale-105 group-hover:border-gta-gold/40 ${g.id === "gta-6" ? "w-10 h-14 border-gta-gold/40 shadow-lg shadow-gta-gold/10" : "w-8 h-11 border-[#2a2a31]"}`}
              loading="eager"
            />
            <span class={`text-[8px] font-mono tracking-widest ${g.id === "gta-6" ? "text-gta-gold" : "text-zinc-700"}`}>{g.year}</span>
          </div>
        ))}
      </div>

      <!-- Key numbers -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl">
        {[
          { v: `${totalSales.toFixed(0)}M+`, l: "total units sold · all titles", s: "Take-Two IR" },
          { v: "30 yrs",                     l: "franchise age · 1997→2026",     s: "Rockstar Games" },
          { v: "98/100",                     l: "GTA IV peak critic score",      s: "Metacritic" },
          { v: `${gta5?.total_units_m}M`,    l: "GTA V copies sold · lifetime",  s: "Take-Two (Feb 2026)" },
        ].map(s => (
          <div class="rounded-xl border border-[#1e1e23] px-4 py-3" style="background:#131316">
            <div class="text-xl font-mono font-bold text-gta-bright">{s.v}</div>
            <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug" style="font-family:'Inter',sans-serif">{s.l}</div>
            <div class="text-[10px] font-mono text-zinc-700 mt-0.5">via {s.s}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12" style="background:#0e0e11">

    <!-- ── SALES VELOCITY ──────────────────────────────────────── -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[9px] font-mono bg-amber-900/30 text-amber-600 border border-amber-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Sales</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Franchise Sales Velocity</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/charts" class="text-[10px] font-mono text-gta-gold/60 hover:text-gta-gold transition-colors tracking-widest">Full charts →</a>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">Units Sold per Title — GTA III to GTA VI</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Total lifetime · Year 1 overlay · GTA VI = projection</div>
          </div>
          <div class="flex items-center gap-4 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-gta-gold/80 inline-block"></span>Lifetime</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-gta-teal/70 inline-block"></span>Year 1</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm border border-gta-gold/40 bg-gta-gold/8 inline-block"></span>Projected</span>
          </div>
        </div>
        <div id="franchise-sales-chart" class="w-full" style="height:300px"
          data-titles={JSON.stringify(salesData.titles)}></div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Sources: Take-Two IR · NPD/ELSPA · DFC Intelligence (GTA VI projection)</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA V sold 225M copies. Here's how every GTA title stacks up — franchise sales velocity charted." url="https://gtavi.ai/franchise" size="sm" label="Share" /></div>
        </div>
      </div>
    </section>

    <!-- ── MAP SIZE PROGRESSION ────────────────────────────────── -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[9px] font-mono bg-blue-900/30 text-blue-400 border border-blue-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Scale</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Map Size Progression</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">Map Size km² per Title</div>
          <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Confirmed area · GTA VI ~150km² is estimated from trailer analysis</div>
        </div>
        <div class="px-5 py-5 flex flex-col gap-3">
          {releasesData.games.filter(g => g.map_size_km2 != null || (g as any).map_size_km2_estimate != null).map(g => {
            const km2    = g.map_size_km2 ?? (g as any).map_size_km2_estimate;
            const isPred = g.is_prediction;
            const maxKm2 = 150;
            const pct    = Math.round((km2 / maxKm2) * 100);
            const cover  = g.id === "gta-6" ? "/assets/covers/gta-6.jpg"
                         : g.id === "gta-5" ? "/assets/covers/gta-5.jpg"
                         : g.id === "gta-4" ? "/assets/covers/gta-4.jpg"
                         : g.id === "gta-sa"? "/assets/covers/gta-sa.jpg"
                         : g.id === "gta-vc"? "/assets/covers/gta-vc.jpg"
                         : g.id === "gta-3" ? "/assets/covers/gta-3.jpg"
                         : null;
            return (
              <div class="flex items-center gap-3">
                {cover && (
                  <img src={cover} alt={g.short} class="w-7 h-10 object-cover rounded border border-[#2a2a31] shrink-0" loading="lazy" />
                )}
                <span class={`text-[11px] font-mono w-10 shrink-0 ${isPred ? "text-gta-gold" : "text-zinc-500"}`}>{g.short}</span>
                <div class="flex-1 h-5 rounded bg-[#1e1e23] overflow-hidden relative">
                  <div
                    class={`h-full rounded transition-all ${isPred ? "bg-gta-gold/30 border border-gta-gold/30 border-dashed" : "bg-gta-gold/70"}`}
                    style={`width:${pct}%`}
                  ></div>
                </div>
                <span class={`text-[11px] font-mono w-20 shrink-0 text-right ${isPred ? "text-gta-gold" : "text-zinc-400"}`}>
                  {km2}{isPred ? "~" : ""} km²
                </span>
              </div>
            );
          })}
        </div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">~ = estimated · Sources: Rockstar, community analysis</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA VI's map is estimated at ~150km² — 2× GTA V. Here's every GTA map size progression since 2001." url="https://gtavi.ai/franchise" size="sm" label="Share" /></div>
      </div>
    </section>

    <!-- ── REVIEW SCORES ──────────────────────────────────────── -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[9px] font-mono bg-purple-900/30 text-purple-400 border border-purple-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Scores</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Metacritic Review Scores</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">critic vs user · the monetisation story</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <!-- Thumbnail cover strip -->
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-2.5 overflow-x-auto">
          <img src="/assets/covers/gta-1.jpg" alt="GTA 1" class="rounded border object-cover border-[#2a2a31] w-6 h-9" loading="lazy" />
          <img src="/assets/covers/gta-2.jpg" alt="GTA 2" class="rounded border object-cover border-[#2a2a31] w-6 h-9" loading="lazy" />
          <img src="/assets/covers/gta-3.jpg" alt="GTA III" class="rounded border object-cover border-[#2a2a31] w-6 h-9" loading="lazy" />
          <img src="/assets/covers/gta-vc.jpg" alt="GTA VC" class="rounded border object-cover border-[#2a2a31] w-6 h-9" loading="lazy" />
          <img src="/assets/covers/gta-sa.jpg" alt="GTA SA" class="rounded border object-cover border-[#2a2a31] w-6 h-9" loading="lazy" />
          <img src="/assets/covers/gta-4.jpg" alt="GTA IV" class="rounded border object-cover border-[#2a2a31] w-6 h-9" loading="lazy" />
          <img src="/assets/covers/gta-5.jpg" alt="GTA V" class="rounded border object-cover border-[#2a2a31] w-6 h-9" loading="lazy" />
          <img src="/assets/covers/gta-6.jpg" alt="GTA VI" class="rounded border object-cover border-[#2a2a31] w-7 h-10 border-gta-gold/40 shadow shadow-gta-gold/10" loading="lazy" />
        </div>
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">Critic vs User Score — All Mainline Titles</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">GTA IV gap (+22): first title with monetisation pressure. SA = closest community/critic alignment.</div>
          </div>
          <div class="flex items-center gap-4 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-3 h-0.5 bg-gta-gold inline-block rounded"></span>Critic /100</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-0.5 bg-purple-400 inline-block rounded"></span>User ×10</span>
          </div>
        </div>
        <div id="review-chart" class="w-full" style="height:260px"
          data-scores={JSON.stringify(metacriticData.titles)}></div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Source: Metacritic.com · scores are permanent historical records</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA SA had perfect critic/user alignment. GTA IV opened a 22-point gap that tracks directly with monetisation. Will GTA VI close it?" url="https://gtavi.ai/franchise" size="sm" label="Share" /></div>
      </div>
    </section>

    <!-- ── GTA V PLAYER HISTORY ───────────────────────────────── -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[9px] font-mono bg-green-900/30 text-green-500 border border-green-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Live</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA V Steam Player History</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/gta-v" class="text-[10px] font-mono text-gta-gold/60 hover:text-gta-gold transition-colors tracking-widest">Full GTA V data →</a>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <!-- Thumbnail cover strip -->
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-2.5 overflow-x-auto">
          <img src="/assets/covers/gta-5.jpg" alt="GTA V" class="rounded border object-cover border-[#2a2a31] w-7 h-10" loading="lazy" />
          <img src="/assets/covers/gta-6.jpg" alt="GTA VI" class="rounded border object-cover border-[#2a2a31] w-8 h-11 border-gta-gold/40 shadow shadow-gta-gold/10" loading="lazy" />
        </div>
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">GTA V Steam Concurrent Players — 11 Years</div>
          <div class="text-[11px] text-zinc-500 font-mono mt-0.5">{steamData.data.length} months · {steamData.data.at(-1)?.avg_players?.toLocaleString()} avg players last month · the audience GTA VI inherits</div>
        </div>
        <div id="franchise-player-chart" class="w-full" style="height:220px"
          data-players={JSON.stringify(steamData.data)}
          data-dlc={JSON.stringify(dlcData.updates.filter((d: any) => d.category === "major"))}
        ></div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Source: SteamCharts · updated {new Date(steamData.last_updated).toLocaleDateString("en-GB",{month:"short",year:"numeric"})}</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA V still pulls tens of thousands of Steam players daily, 11 years after launch. The audience GTA VI inherits." url="https://gtavi.ai/franchise" size="sm" label="Share" /></div>
        </div>
      </div>
    </section>

    <!-- ── GTA ONLINE DLC TIMELINE ──────────────────────────────── -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[9px] font-mono bg-teal-900/30 text-teal-400 border border-teal-800/40 px-2 py-0.5 rounded uppercase tracking-widest">DLC</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA Online Content Timeline</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{dlcData.updates.length} updates · 2013–2024</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <!-- Thumbnail cover strip -->
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-2.5 overflow-x-auto">
          <img src="/assets/covers/gta-5.jpg" alt="GTA V" class="rounded border object-cover border-[#2a2a31] w-7 h-10" loading="lazy" />
          <img src="/assets/covers/gta-6.jpg" alt="GTA VI" class="rounded border object-cover border-[#2a2a31] w-8 h-11 border-gta-gold/40 shadow shadow-gta-gold/10" loading="lazy" />
        </div>
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">GTA Online — 11 Years of Content Drops</div>
          <div class="text-[11px] text-zinc-500 font-mono mt-0.5">
            {dlcMajorCount} major updates · {dlcContentCount} content drops · benchmark for GTA VI post-launch support
          </div>
        </div>

        <!-- Year-grouped timeline -->
        <div class="px-5 py-5 flex flex-col gap-6">
          {dlcByYear.map(({ year, updates }) => (
            <div>
              <div class="flex items-center gap-2 mb-2.5">
                <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest w-10 shrink-0">{year}</span>
                <div class="flex-1 h-px bg-[#1e1e23]"></div>
              </div>
              <div class="flex flex-wrap gap-2 pl-12">
                {updates.map((u: any) => {
                  const isMajor     = u.category === "major";
                  const isLaunch    = u.category === "launch";
                  const isMilestone = u.category === "milestone";
                  return (
                    <div
                      title={`${u.title} — ${u.date}`}
                      class={[
                        "flex items-center gap-1.5 px-2.5 py-1 rounded text-[10px] font-mono border",
                        isLaunch    ? "bg-gta-gold/10 border-gta-gold/30 text-gta-gold" :
                        isMajor     ? "bg-teal-900/25 border-teal-700/30 text-teal-300" :
                        isMilestone ? "bg-purple-900/25 border-purple-700/30 text-purple-300" :
                                      "bg-[#1a1a1e] border-[#2a2a31] text-zinc-500",
                      ].join(" ")}
                    >
                      {isLaunch && <span class="w-1.5 h-1.5 rounded-full bg-gta-gold shrink-0 inline-block"></span>}
                      {isMajor  && <span class="w-1.5 h-1.5 rounded-full bg-teal-400 shrink-0 inline-block"></span>}
                      {u.label}
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        <!-- Legend + source -->
        <div class="px-5 py-3 border-t border-[#1e1e23] flex flex-wrap items-center gap-5">
          <div class="flex items-center gap-4 text-[10px] font-mono text-zinc-600">
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-gta-gold inline-block"></span>Launch</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-teal-400 inline-block"></span>Major update</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded border border-purple-500/60 inline-block"></span>Milestone</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-[#2a2a31] inline-block"></span>Content drop</span>
          </div>
          <div class="flex-1"></div>
          <span class="text-[10px] text-zinc-700 font-mono">Source: Rockstar Games · GTA Wiki</span>
        </div>
      </div>
    </section>

    <!-- ── RELEASE HISTORY TABLE ──────────────────────────────── -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[9px] font-mono bg-zinc-800 text-zinc-500 border border-zinc-700 px-2 py-0.5 rounded uppercase tracking-widest">History</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Complete Release History</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <table class="w-full text-xs font-mono">
          <thead>
            <tr class="border-b border-[#1e1e23]">
              {["Title","Year","Launch Price","Map km²","Vehicles","Gap"].map(h => (
                <th class="text-left px-5 py-3 text-zinc-600 font-normal first:pl-5 last:pr-5">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {releasesData.games.map((g) => {
              const isPred = g.is_prediction;
              const price    = g.price_usd_launch    ?? (g as any).price_usd_estimate;
              const map      = g.map_size_km2        ?? (g as any).map_size_km2_estimate;
              const vehicles = g.vehicle_count       ?? (g as any).vehicle_count_estimate;
              const gap      = g.gap_years_from_prev ?? (g as any).gap_years_from_prev_estimate;
              const year     = g.release_year        ?? (g as any).release_date_estimate;
              return (
                <tr class={`border-b border-[#1e1e23]/50 hover:bg-white/2 transition-colors ${isPred ? "text-gta-gold" : "text-zinc-300"}`}>
                  <td class="px-5 py-3 font-semibold">
                    {g.short}
                    {isPred && <span class="ml-1.5 text-[9px] bg-gta-gold/10 text-gta-gold/70 border border-gta-gold/15 px-1 py-0.5 rounded uppercase tracking-widest align-middle">est</span>}
                  </td>
                  <td class="px-5 py-3 text-zinc-600">{year ?? "—"}</td>
                  <td class="px-5 py-3">{price ? `$${price.toFixed(0)}` : <span class="text-zinc-700">—</span>}</td>
                  <td class="px-5 py-3">{map ? `${map}${isPred?"~":""}` : <span class="text-zinc-700">—</span>}</td>
                  <td class="px-5 py-3">{vehicles ? `${vehicles}${isPred?"~":""}` : <span class="text-zinc-700">—</span>}</td>
                  <td class="px-5 py-3 text-zinc-600">{gap ? `+${gap}yr` : "—"}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── GTA V DEEP DIVE LINK ───────────────────────────────── -->
    <section class="rounded-xl border border-[#1e1e23] p-5 flex items-start gap-4" style="background:#131316">
      <div class="shrink-0 w-1 self-stretch rounded-full bg-gta-gold/40"></div>
      <div class="flex-1">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-1">GTA V — Full Live Data</div>
        <div class="font-semibold text-zinc-200 text-sm mb-1" style="font-family:'Inter',sans-serif">665 Broughy-tested vehicles · 133 months of Steam data · Google Trends 2013–2026</div>
        <div class="text-xs text-zinc-500 mb-3" style="font-family:'Inter',sans-serif">GTA V's 11-year player trajectory is the primary signal input for GTA VI predictions.</div>
        <a href="/gta-v" class="text-[10px] font-mono text-gta-gold/70 hover:text-gta-gold border border-gta-gold/20 hover:border-gta-gold/40 px-3 py-1.5 rounded transition-colors uppercase tracking-widest">
          Explore GTA V data →
        </a>
      </div>
    </section>

    <CrossLinks context="franchise" />
  </div>
</Base>

<script>
  import * as d3 from "d3";

  // ── Sales chart ──────────────────────────────────────────────
  (function() {
    const el = document.getElementById("franchise-sales-chart");
    if (!el) return;
    const titles: any[] = JSON.parse(el.dataset.titles || "[]");
    const margin = { top: 20, right: 30, bottom: 44, left: 52 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;
    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);
    const x = d3.scaleBand().domain(titles.map(t=>t.short)).range([0,W]).padding(0.28);
    const maxVal = d3.max(titles, t => t.total_units_m ?? t.year1_units_m ?? 0) ?? 1;
    const y = d3.scaleLinear().domain([0, maxVal*1.12]).range([H,0]);
    svg.append("g").call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(d=>`${d}M`))
      .call(g=>g.select(".domain").remove())
      .call(g=>g.selectAll(".tick line").attr("stroke","#1e1e23").attr("stroke-dasharray","3,3"))
      .call(g=>g.selectAll("text").attr("fill","#52525b").attr("font-size","11").attr("font-family","monospace"));
    titles.forEach(t => {
      const bx = x(t.short)??0, bw = x.bandwidth(), isPred = t.is_prediction;
      if (t.total_units_m) {
        svg.append("rect").attr("x",bx).attr("y",y(t.total_units_m))
          .attr("width",bw).attr("height",H-y(t.total_units_m)).attr("rx",3)
          .attr("fill", isPred?"none":"#f59e0b").attr("fill-opacity", isPred?0:0.75)
          .attr("stroke", isPred?"#f59e0b":"none").attr("stroke-width",1.5)
          .attr("stroke-dasharray", isPred?"6,3":"0");
      }
      if (t.year1_units_m) {
        svg.append("rect").attr("x",bx+bw*0.1).attr("y",y(t.year1_units_m))
          .attr("width",bw*0.8).attr("height",H-y(t.year1_units_m)).attr("rx",2)
          .attr("fill","#0d9488").attr("fill-opacity", isPred?0.45:0.85);
      }
      const lv = t.total_units_m ?? t.year1_units_m;
      if (lv) svg.append("text").attr("x",bx+bw/2).attr("y",y(lv)-5)
        .attr("text-anchor","middle").attr("fill",isPred?"#f59e0b":"#a1a1aa")
        .attr("font-size","10").attr("font-family","monospace")
        .text(isPred?`~${lv}M*`:`${lv}M`);
    });
    svg.append("g").attr("transform",`translate(0,${H})`)
      .call(d3.axisBottom(x)).call(g=>g.select(".domain").attr("stroke","#2a2a31"))
      .call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill","#71717a").attr("font-size","12").attr("font-family","monospace").attr("dy","1.2em"));
  })();

  // ── Review scores chart ──────────────────────────────────────
  (function() {
    const el = document.getElementById("review-chart");
    if (!el) return;
    const scores: any[] = JSON.parse(el.dataset.scores || "[]");
    const margin = { top: 24, right: 40, bottom: 44, left: 52 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;
    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);
    const x = d3.scaleBand().domain(scores.map(s=>s.short)).range([0,W]).padding(0.3);
    const y = d3.scaleLinear().domain([70,100]).range([H,0]);
    svg.append("g").call(d3.axisLeft(y).ticks(6).tickSize(-W).tickFormat(()=>""))
      .call(g=>g.select(".domain").remove())
      .call(g=>g.selectAll(".tick line").attr("stroke","#1e1e23").attr("stroke-dasharray","3,3"));
    svg.append("g").call(d3.axisLeft(y).ticks(6))
      .call(g=>g.select(".domain").remove())
      .call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill","#52525b").attr("font-size","10").attr("font-family","monospace"));

    scores.forEach(s => {
      const bx = x(s.short)??0, bw = x.bandwidth();
      const half = bw/2 - 1;
      // Critic bar (left half)
      svg.append("rect").attr("x",bx).attr("y",y(s.critic_score))
        .attr("width",half).attr("height",H-y(s.critic_score)).attr("rx",2)
        .attr("fill","#f59e0b").attr("opacity",0.8);
      // User bar (right half) — user score is /10, scale to /100
      const userScaled = s.user_score * 10;
      svg.append("rect").attr("x",bx+half+2).attr("y",y(userScaled))
        .attr("width",half).attr("height",H-y(userScaled)).attr("rx",2)
        .attr("fill","#a78bfa").attr("opacity",0.8);
      // Critic label
      svg.append("text").attr("x",bx+half/2).attr("y",y(s.critic_score)-4)
        .attr("text-anchor","middle").attr("fill","#f59e0b").attr("font-size","9").attr("font-family","monospace")
        .text(s.critic_score);
      // User label
      svg.append("text").attr("x",bx+half+2+half/2).attr("y",y(userScaled)-4)
        .attr("text-anchor","middle").attr("fill","#a78bfa").attr("font-size","9").attr("font-family","monospace")
        .text(s.user_score);
      // Delta annotation for GTA IV
      if (s.id === "gta-4") {
        svg.append("text").attr("x",bx+bw/2).attr("y",H+28)
          .attr("text-anchor","middle").attr("fill","#ef4444").attr("font-size","8").attr("font-family","monospace")
          .text(`+${s.critic_user_delta}`);
      }
    });
    svg.append("g").attr("transform",`translate(0,${H})`)
      .call(d3.axisBottom(x)).call(g=>g.select(".domain").attr("stroke","#2a2a31"))
      .call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill","#71717a").attr("font-size","12").attr("font-family","monospace").attr("dy","1.2em"));
  })();

  // ── Player chart (compact) ───────────────────────────────────
  (function() {
    const el = document.getElementById("franchise-player-chart");
    if (!el) return;
    const MONTHS: Record<string,number> = {January:0,February:1,March:2,April:3,May:4,June:5,July:6,August:7,September:8,October:9,November:10,December:11};
    const raw: any[] = JSON.parse(el.dataset.players || "[]");
    const dlc: any[] = JSON.parse(el.dataset.dlc || "[]");
    const data = raw.map(d => ({ date: new Date(d.year, MONTHS[d.month]??0), avg: d.avg_players }));
    const margin = { top: 12, right: 16, bottom: 28, left: 52 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;
    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);
    const x = d3.scaleTime().domain(d3.extent(data,d=>d.date) as [Date,Date]).range([0,W]);
    const y = d3.scaleLinear().domain([0,(d3.max(data,d=>d.avg)??0)*1.1]).range([H,0]);
    svg.append("g").call(d3.axisLeft(y).ticks(4).tickSize(-W).tickFormat(()=>""))
      .call(g=>g.select(".domain").remove())
      .call(g=>g.selectAll(".tick line").attr("stroke","#1e1e23").attr("stroke-dasharray","3,3"));
    dlc.forEach(d => {
      svg.append("line").attr("x1",x(new Date(d.date))).attr("x2",x(new Date(d.date)))
        .attr("y1",0).attr("y2",H).attr("stroke","#27272a").attr("stroke-width",1).attr("stroke-dasharray","2,4");
    });
    const defs = svg.append("defs");
    const grad = defs.append("linearGradient").attr("id","fpc-grad").attr("gradientUnits","userSpaceOnUse").attr("x1",0).attr("y1",0).attr("x2",0).attr("y2",H);
    grad.append("stop").attr("offset","0%").attr("stop-color","#f59e0b").attr("stop-opacity",0.18);
    grad.append("stop").attr("offset","100%").attr("stop-color","#f59e0b").attr("stop-opacity",0.01);
    svg.append("path").datum(data).attr("fill","url(#fpc-grad)")
      .attr("d",d3.area<any>().x(d=>x(d.date)).y0(H).y1(d=>y(d.avg)).curve(d3.curveMonotoneX));
    svg.append("path").datum(data).attr("fill","none").attr("stroke","#f59e0b").attr("stroke-width",1.5)
      .attr("d",d3.line<any>().x(d=>x(d.date)).y(d=>y(d.avg)).curve(d3.curveMonotoneX));
    svg.append("g").attr("transform",`translate(0,${H})`)
      .call(d3.axisBottom(x).ticks(5).tickFormat(d3.timeFormat("%Y") as any))
      .call(g=>g.select(".domain").attr("stroke","#2a2a31"))
      .call(g=>g.selectAll(".tick line").attr("stroke","#2a2a31"))
      .call(g=>g.selectAll("text").attr("fill","#52525b").attr("font-size","10").attr("font-family","monospace"));
    svg.append("g").call(d3.axisLeft(y).ticks(4).tickFormat(d=>`${Math.round(+d/1000)}k`))
      .call(g=>g.select(".domain").attr("stroke","#2a2a31"))
      .call(g=>g.selectAll(".tick line").attr("stroke","#2a2a31"))
      .call(g=>g.selectAll("text").attr("fill","#52525b").attr("font-size","10").attr("font-family","monospace"));
  })();
</script>
