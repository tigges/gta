---
import Base from "../layouts/Base.astro";
import CrossLinks from "../components/CrossLinks.astro";
import GamePill from "../components/GamePill.astro";
import salesData   from "../../data/franchise/sales.json";
import metacriticData from "../../data/franchise/metacritic.json";

const titles = (salesData as any).titles as any[];
const scores = ((metacriticData as any).titles as any[]).filter((t: any) => t.metacritic_score);
const highestRated = scores.sort((a: any, b: any) => b.metacritic_score - a.metacritic_score)[0];
const titleCount = titles.length;
---

<Base
  titleContext="franchise"
  title="GTA Franchise History"
  description="30 years of Grand Theft Auto franchise data — sales history, Metacritic scores, DLC timelines, map size progression, and economic complexity across all 8 titles."
  ogPage="franchise"
>
  <!-- Hero -->
  <section class="relative border-b border-border-dim overflow-hidden" style="min-height:240px">
    <div class="absolute inset-0">
      <img src="/assets/covers/gta-5.jpg" alt="" class="absolute right-0 top-0 h-full w-auto object-cover opacity-8"
           aria-hidden="true" style="filter:saturate(0.3);max-width:40%"
                loading="lazy" />
      <div class="absolute inset-0" style="background:linear-gradient(to right,#0a0a0d 40%,transparent 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,transparent 30%,#0a0a0d 100%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center gap-2 mb-3">
        <GamePill game="franchise" size="xs" />
        <span class="text-[10px] font-mono text-zinc-600">1997–2026 · Rockstar Games</span>
      </div>
      <h1 class="text-4xl font-bold text-white mb-4">Franchise History</h1>
      <p class="text-sm text-zinc-400 max-w-lg mb-8">
        30 years of GTA. Sales data, critic scores, map evolution, and the full economic arc from GTA 1 to GTA VI.
      </p>
      <div class="flex flex-wrap gap-5 text-xs font-mono text-zinc-600">
        <span><span class="text-zinc-200 font-bold text-base">8</span> main titles</span>
        <span><span class="text-zinc-200 font-bold text-base">30</span> years</span>
        {highestRated && <span><span class="text-zinc-200 font-bold text-base">{highestRated.metacritic_score}</span> peak Metacritic ({highestRated.short ?? highestRated.id})</span>}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">

    <!-- Section cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">

      <!-- History & Sales -->
      <a href="/franchise/history"
         class="group rounded-xl border border-border-dim hover:border-zinc-700 p-6 flex flex-col gap-3 transition-all"
         style="background:var(--c-card)">
        <div class="text-2xl">📖</div>
        <div>
          <div class="font-semibold text-zinc-200 text-sm mb-1 group-hover:text-white transition-colors">History & Sales</div>
          <div class="text-[10px] font-mono text-zinc-600">Sales figures · Metacritic scores · release timeline · map size progression</div>
        </div>
        <div class="mt-auto text-[10px] font-mono text-zinc-600 group-hover:text-zinc-400 transition-colors">Explore history →</div>
      </a>

      <!-- Charts -->
      <a href="/franchise/charts"
         class="group rounded-xl border border-border-dim hover:border-gta-gold/40 p-6 flex flex-col gap-3 transition-all hover:bg-gta-gold/[0.03]"
         style="background:var(--c-card)">
        <div class="text-2xl">📈</div>
        <div>
          <div class="font-semibold text-zinc-200 text-sm mb-1 group-hover:text-white transition-colors">Charts</div>
          <div class="text-[10px] font-mono text-zinc-600">Cross-title earnings · complexity evolution · CPI pricing · sales velocity</div>
        </div>
        <div class="mt-auto text-[10px] font-mono text-gta-gold group-hover:text-gta-gold transition-colors">View charts →</div>
      </a>

      <!-- GTA V Story -->
      <a href="/gta-v"
         class="group rounded-xl border border-border-dim hover:border-zinc-700 p-6 flex flex-col gap-3 transition-all"
         style="background:var(--c-card)">
        <div class="flex items-center gap-2 mb-1">
          <img src="/assets/logos/gta-v.png" alt="GTA V" class="h-8 w-auto" loading="lazy" />
        </div>
        <div>
          <div class="font-semibold text-zinc-200 text-sm mb-1 group-hover:text-white transition-colors">GTA V Story Mode</div>
          <div class="text-[10px] font-mono text-zinc-600">Heists · assassination stocks · vehicle benchmarks · $2B strategy</div>
        </div>
        <div class="mt-auto text-[10px] font-mono text-zinc-600 group-hover:text-zinc-400 transition-colors">Story data →</div>
      </a>
    </div>

    <!-- Title cover strip -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <GamePill game="franchise" size="xs" />
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">All Titles</span>
        <div class="flex-1 h-px bg-border-dim"></div>
      </div>
      <div class="flex flex-wrap gap-3">
        {([
          { id: "gta-1",  label: "GTA 1",      year: "1997" },
          { id: "gta-2",  label: "GTA 2",      year: "1999" },
          { id: "gta-3",  label: "GTA III",    year: "2001" },
          { id: "gta-vc", label: "Vice City",  year: "2002" },
          { id: "gta-sa", label: "San Andreas",year: "2004" },
          { id: "gta-4",  label: "GTA IV",     year: "2008" },
          { id: "gta-5",  label: "GTA V",      year: "2013", href: "/gta-v" },
          { id: "gta-6",  label: "GTA VI",     year: "2026", href: "/gta-vi" },
        ] as const).map(t => (
          <a href={t.href ?? "/franchise/history"}
             class="group flex flex-col items-center gap-1.5 hover:opacity-90 transition-opacity">
            <img src={`/assets/covers/${t.id}.jpg`} alt={t.label}
                 class="w-12 h-16 object-cover rounded border border-border-mid group-hover:border-zinc-600 transition-colors" loading="lazy" />
            <div class="text-[10px] font-mono text-zinc-600">{t.year}</div>
          </a>
        ))}
      </div>
    </div>

    <CrossLinks context="franchise" />
  </div>
</Base>
