---
import Base from "../../layouts/Base.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import ShareDropdown from "../../components/ShareDropdown.astro";
import CircularEconomy from "../../components/CircularEconomy.astro";
import ChartComplexityRadar from "../../components/ChartComplexityRadar.astro";
import GamePill from "../../components/GamePill.astro";
import { CATEGORY_BADGE_CLASSES } from "../../config/categoryColors";
import CardFooter from "../../components/CardFooter.astro";
import { getEconomyModel } from "../../config/economyModels";
import economyData from "../../../data/franchise/economy-models.json";
const economy = (economyData as any).economies.find((e: any) => e.title_id === "gta-vc");
const ecoModel = getEconomyModel("gta-vc")!;
---
<Base
  titleContext="gta-vc"
  title={economy.title_name + " — Economy"} description={economy.economy_type + " · " + economy.real_world_analogue + " · GTAVI.AI franchise economic analysis."} ogPage="gta-v">
  <section class="relative border-b border-[#1e1e23] overflow-hidden" style="min-height:200px">
    <div class="absolute inset-0" style="background:#0a0a0d"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-center gap-2 mb-4 flex-wrap">
        <GamePill game="gta-vc" size="xs" />
        <span class="text-[10px] font-mono text-zinc-500">{economy.era_label}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">{economy.title_name} — Economy</h1>
      <p class="text-zinc-300 text-sm leading-relaxed max-w-xl">The franchise's first asset ownership loop: earn → buy business → receive passive income → earn more. The Malibu Club is the conceptual ancestor of the Acid Lab.</p>
    </div>
  </section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">
    <section>
      <div class="flex items-center gap-3 mb-6">
        <GamePill game="gta-vc" size="xs" />
        <span class={CATEGORY_BADGE_CLASSES}>Economy</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Circular Economy Model</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 rounded-xl border border-[#1e1e23] p-5" style="background:#0e0e11">
          <CircularEconomy titleId="gta-vc" mode="full" />
        <CardFooter anchorId={ecoModel.anchorId} sources="Source: curated · GTA Fandom Wiki · franchise economic analysis" shareText={ecoModel.shareText} />
        </div>
        <ChartComplexityRadar titleId="gta-vc" size={260} />
      </div>
    </section>

    <section class="rounded-xl border border-gta-gold/15 px-6 py-5" style="background:var(--c-hero-bloom)">
      <div class="text-[11px] font-mono text-gta-gold/40 uppercase tracking-widest mb-2">GTA VI Lineage</div>
      <p class="text-[11px] font-mono text-zinc-300 leading-relaxed">{economy.gta_vi_lineage}</p>
    </section>
    <div class="flex items-center gap-3 flex-wrap">
      <a href="/franchise/economics" class="px-4 py-2 rounded border border-[#2a2a31] text-zinc-400 text-[11px] font-mono hover:border-zinc-600 hover:text-zinc-200 transition-all">← Ten Economies</a>
      <a href="/gta-sa/economy" class="px-4 py-2 rounded border border-gta-gold/30 text-gta-gold text-[11px] font-mono hover:bg-gta-gold/20 transition-all">San Andreas: Multi-Stream Economy →</a>
    </div>
    <CrossLinks context="franchise" />
  </div>
</Base>
