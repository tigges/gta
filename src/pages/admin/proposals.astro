---
/**
 * /admin/proposals — Prediction proposals review page.
 *
 * Shows pending changes generated by fetch_predictions_auto.py.
 * Read-only on the site itself. Apply changes by editing predictions.json
 * directly in the repo (or via the GitHub edit links on each card).
 *
 * Not in the main nav — accessible at /admin/proposals for those who know it.
 */
import Base from "../../layouts/Base.astro";
import proposalsRaw   from "../../../data/gta-6/predictions-proposals.json";
import predictionsRaw from "../../../data/gta-6/predictions.json";

const proposals = (proposalsRaw as any).proposals ?? [] as any[];
const predictions = (predictionsRaw as any).predictions as any[];
const lastUpdated = (proposalsRaw as any).last_updated;

const pending   = proposals.filter((p: any) => p.status === "pending");
const applied   = proposals.filter((p: any) => p.status === "applied");
const dismissed = proposals.filter((p: any) => p.status === "dismissed");

const GITHUB_BASE =
  "https://github.com/tigges/gta/edit/staging/data/gta-6/predictions.json";

function getPredTitle(id: string): string {
  return predictions.find((p: any) => p.id === id)?.title ?? id;
}
function getProposalType(proposal: any): "modify" | "new" {
  // "new" if the proposal adds a whole new prediction (no matching existing id)
  // "modify" if it changes a field on an existing prediction
  const exists = predictions.some((p: any) => p.id === proposal.id);
  return exists ? "modify" : "new";
}

function getPredCurrent(id: string, field: string): string {
  const p = predictions.find((p: any) => p.id === id);
  if (!p) return "—";
  const val = p[field];
  if (val === null || val === undefined) return "(empty)";
  return typeof val === "string" ? val : JSON.stringify(val);
}
---

<Base title="Prediction Proposals" titleContext="gta-vi">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">

    <!-- Header -->
    <div class="mb-8">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">
        // Admin · Prediction Pipeline
      </div>
      <h1 class="text-2xl font-bold text-white mb-2">Proposal Review</h1>
      <p class="text-sm text-zinc-400 max-w-2xl">
        Changes proposed by <code class="text-zinc-300 bg-zinc-800 px-1 rounded">fetch_predictions_auto.py</code> that require human review before being applied to <code class="text-zinc-300 bg-zinc-800 px-1 rounded">predictions.json</code>.
      </p>
      {lastUpdated && (
        <p class="text-[10px] font-mono text-zinc-600 mt-2">
          Last scraper run: {new Date(lastUpdated).toLocaleString("en-GB")}
        </p>
      )}
    </div>

    <!-- Stats strip -->
    <div class="grid grid-cols-3 gap-3 mb-8">
      {[
        { label: "Pending review", count: pending.length,   color: "text-gta-gold",  border: "border-gta-gold/20" },
        { label: "Applied",        count: applied.length,   color: "text-gta-teal",  border: "border-gta-teal/20" },
        { label: "Dismissed",      count: dismissed.length, color: "text-zinc-500",  border: "border-zinc-700" },
      ].map(s => (
        <div class={`rounded-xl border ${s.border} px-4 py-3`} style="background:var(--c-card)">
          <div class={`text-2xl font-mono font-black ${s.color}`}>{s.count}</div>
          <div class="text-[11px] text-zinc-500 mt-0.5">{s.label}</div>
        </div>
      ))}
    </div>

    <!-- Pending proposals -->
    {pending.length === 0 ? (
      <div class="rounded-xl border border-[#1e1e23] px-6 py-10 text-center" style="background:var(--c-card)">
        <div class="text-2xl mb-2">✓</div>
        <div class="text-zinc-400 text-sm">No pending proposals — predictions are up to date.</div>
        <div class="text-[11px] font-mono text-zinc-600 mt-1">
          Next auto-check: nightly at 03:00 UTC
        </div>
      </div>
    ) : (
      <div class="flex flex-col gap-4">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-1">
          // {pending.length} pending — review each before applying
        </div>

        {pending.map((proposal: any) => {
          const predTitle = getPredTitle(proposal.id);
          const currentFull = getPredCurrent(proposal.id, proposal.field);
          const proposedStr = typeof proposal.proposed === "string"
            ? proposal.proposed
            : JSON.stringify(proposal.proposed, null, 2);
          const proposedAt = proposal.proposed_at
            ? new Date(proposal.proposed_at).toLocaleString("en-GB")
            : "unknown";

          return (
            <div class="rounded-xl border border-gta-gold/20 overflow-hidden" style="background:var(--c-card)">

              <!-- Card header -->
              <div class="px-5 py-3 border-b border-[#1e1e23] flex items-start justify-between gap-4 flex-wrap">
                <div>
                  <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-1 flex items-center gap-2">
                    {getProposalType(proposal) === "modify" ? (
                      <span class="border border-zinc-700 bg-zinc-800/60 text-zinc-400 px-1.5 py-0.5 rounded text-[9px] uppercase tracking-widest">
                        ✏ Modify existing
                      </span>
                    ) : (
                      <span class="border border-gta-teal/30 bg-gta-teal/10 text-gta-teal px-1.5 py-0.5 rounded text-[9px] uppercase tracking-widest">
                        + New prediction
                      </span>
                    )}
                    <span>{proposal.id}</span>
                    {getProposalType(proposal) === "modify" && (
                      <span>· field: <span class="text-gta-gold">{proposal.field}</span></span>
                    )}
                  </div>
                  <div class="text-sm font-semibold text-zinc-200">{predTitle}</div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-[10px] font-mono bg-gta-gold/10 border border-gta-gold/25 text-gta-gold px-2 py-0.5 rounded uppercase tracking-widest">
                    Pending
                  </span>
                  <span class="text-[10px] font-mono text-zinc-600">{proposedAt}</span>
                </div>
              </div>

              <!-- Diff -->
              <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-[#1e1e23]">
                <div class="px-5 py-4">
                  <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-2">Current</div>
                  <p class="text-[11px] text-zinc-400 font-mono leading-relaxed whitespace-pre-wrap">{currentFull}</p>
                </div>
                <div class="px-5 py-4" style="background:rgba(245,158,11,0.03)">
                  <div class="text-[10px] font-mono text-gta-gold uppercase tracking-widest mb-2">Proposed</div>
                  <p class="text-[11px] text-zinc-200 font-mono leading-relaxed whitespace-pre-wrap" id={`proposed-${proposal.id}-${proposal.field}`}>
                    {proposedStr}
                  </p>
                </div>
              </div>

              <!-- Rationale -->
              <div class="px-5 py-3 border-t border-[#1e1e23]">
                <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mr-2">Rationale</span>
                <span class="text-[11px] text-zinc-400">{proposal.rationale}</span>
              </div>

              <!-- Actions -->
              <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center gap-3 flex-wrap">
                <button
                  class="copy-btn text-[11px] font-mono border border-[#2a2a31] hover:border-gta-gold/40 hover:text-gta-gold text-zinc-400 px-3 py-1.5 rounded transition-all"
                  data-copy={proposedStr}
                >
                  Copy proposed value
                </button>
                <a
                  href={GITHUB_BASE}
                  target="_blank" rel="noopener noreferrer"
                  class="text-[11px] font-mono border border-[#2a2a31] hover:border-gta-teal/40 hover:text-gta-teal text-zinc-400 px-3 py-1.5 rounded transition-all"
                >
                  Edit predictions.json ↗
                </a>
                <span class="text-[10px] font-mono text-zinc-700 ml-auto">
                  To apply: paste proposed value into <code class="text-zinc-500">predictions.json → {proposal.id} → {proposal.field}</code>,
                  then change <code class="text-zinc-500">editorial_note</code> to <code class="text-zinc-500">"approved"</code>
                  and delete this entry from <code class="text-zinc-500">predictions-proposals.json</code>.
                </span>
              </div>

            </div>
          );
        })}
      </div>
    )}

    <!-- Applied / dismissed history -->
    {applied.length > 0 && (
      <div class="mt-10">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">// Applied history</div>
        <div class="flex flex-col gap-2">
          {applied.map((p: any) => (
            <div class="rounded-lg border border-gta-teal/15 px-4 py-3 flex items-center justify-between gap-4" style="background:var(--c-card)">
              <div class="text-[11px] font-mono text-zinc-500">
                <span class="text-gta-teal mr-2">✓</span>{p.id} · {p.field}
              </div>
              <span class="text-[10px] font-mono text-zinc-700">{p.proposed_at ? new Date(p.proposed_at).toLocaleDateString("en-GB") : ""}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Footer note -->
    <div class="mt-10 rounded-xl border border-[#1e1e23] px-5 py-4" style="background:var(--c-card)">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-2">// How this works</div>
      <ul class="text-[11px] text-zinc-500 font-mono space-y-1 leading-relaxed list-none">
        <li>1. Nightly at 03:00 UTC, <span class="text-zinc-300">fetch_predictions_auto.py</span> runs after all scrapers.</li>
        <li>2. Confirmed updates (dates, prices from official sources) → applied directly to <span class="text-zinc-300">predictions.json</span>.</li>
        <li>3. Uncertain changes (confidence bumps, basis rewrites) → written here as proposals.</li>
        <li>4. You review each proposal and apply manually. Delete applied entries from <span class="text-zinc-300">predictions-proposals.json</span>.</li>
        <li>5. Set <span class="text-zinc-300">editorial_note: "applied"</span> on the proposal before deleting for audit trail.</li>
      </ul>
    </div>

  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const text = btn.dataset.copy ?? "";
      navigator.clipboard.writeText(text).then(() => {
        const orig = btn.textContent;
        btn.textContent = "Copied ✓";
        btn.style.borderColor = "rgba(245,158,11,0.5)";
        btn.style.color = "#f59e0b";
        setTimeout(() => {
          btn.textContent = orig;
          btn.style.borderColor = "";
          btn.style.color = "";
        }, 1800);
      });
    });
  });
</script>
