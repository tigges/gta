---
/**
 * /admin/proposals — Prediction pipeline (auto-publish model).
 *
 * New prediction drafts now PUBLISH AUTOMATICALLY: fetch_predictions_auto.py
 * runs each pending draft through passes_quality_gate() and writes the ones
 * that clear it straight into predictions.json (editorial_note "auto-published").
 * There is no pre-publication approval step. Moderation is post-publication —
 * low-engagement predictions drift down the stack and you edit/move/remove live
 * entries directly in predictions.json.
 *
 * This page therefore only surfaces two kinds of items that still need a human:
 *
 *  1. HELD (field === "_new") — a draft the quality gate rejected (e.g. missing
 *     value, bad confidence/tier). Shown as a full-object card so it can be
 *     fixed and re-run, or copied in manually.
 *
 *  2. FIELD UPDATES (field ≠ "_new") — an uncertain single-field change on an
 *     existing prediction, shown as a current vs proposed diff.
 *
 * Read-only on the site itself. Apply changes by editing predictions.json
 * directly in the repo (or via the GitHub edit links on each card).
 */
import Base from "../../layouts/Base.astro";
import proposalsRaw   from "../../../data/gta-6/predictions-proposals.json";
import predictionsRaw from "../../../data/gta-6/predictions.json";
import draftsRaw      from "../../../data/gta-6/predictions-drafts.json";

const proposals    = (proposalsRaw as any).proposals ?? [] as any[];
const predictions  = (predictionsRaw as any).predictions as any[];
const lastUpdated  = (proposalsRaw as any).last_updated;
const draftCount   = ((draftsRaw as any).drafts ?? []).filter((d: any) => d.draft_status !== "promoted").length;

const pending   = proposals.filter((p: any) => p.status === "pending");
const applied   = proposals.filter((p: any) => p.status === "applied");
const dismissed = proposals.filter((p: any) => p.status === "dismissed");

// Split pending into new-prediction proposals vs field-update proposals
const pendingNew    = pending.filter((p: any) => p.field === "_new");
const pendingModify = pending.filter((p: any) => p.field !== "_new");

const GITHUB_PREDICTIONS =
  "https://github.com/tigges/gta/edit/staging/data/gta-6/predictions.json";
const GITHUB_DRAFTS =
  "https://github.com/tigges/gta/edit/staging/data/gta-6/predictions-drafts.json";

function getPredTitle(id: string): string {
  return predictions.find((p: any) => p.id === id)?.title ?? id;
}

function getPredCurrent(id: string, field: string): string {
  const p = predictions.find((p: any) => p.id === id);
  if (!p) return "—";
  const val = p[field];
  if (val === null || val === undefined) return "(empty)";
  return typeof val === "string" ? val : JSON.stringify(val);
}

function tierColor(tier: string): string {
  if (tier === "confirmed") return "text-gta-teal";
  if (tier === "reported")  return "text-gta-gold";
  return "text-zinc-500";
}
// Staging-only gate — this page must never render on production
const CF_BRANCH = (typeof process !== "undefined" ? (process.env.CF_PAGES_BRANCH ?? "") : "").toLowerCase();
const IS_STAGING = CF_BRANCH !== "" && CF_BRANCH !== "main";
if (!IS_STAGING) { return Astro.redirect("/404"); }
---

<Base title="Prediction Proposals" titleContext="gta-vi" noindex>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">

    <!-- Header -->
    <div class="mb-8">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">
        // Admin · Prediction Pipeline
      </div>
      <h1 class="text-2xl font-bold text-white mb-2">Prediction Pipeline · Auto-Publish</h1>
      <p class="text-sm text-zinc-400 max-w-2xl">
        New prediction drafts that clear the automated quality gate publish straight to <code class="text-zinc-300 bg-zinc-800 px-1 rounded">predictions.json</code> — no pre-approval. Moderation is <strong class="text-zinc-300">post-publication</strong>: low-engagement predictions drift down the stack, and you edit/move/remove live entries directly. This queue only holds items the gate <strong class="text-zinc-300">held back</strong> (need a fix) and field-update proposals.
      </p>
      {lastUpdated && (
        <p class="text-[10px] font-mono text-zinc-600 mt-2">
          Last scraper run: {new Date(lastUpdated).toLocaleString("en-GB")}
        </p>
      )}
    </div>

    <!-- Stats strip -->
    <div class="grid grid-cols-4 gap-3 mb-8">
      {[
        { label: "Pending review",  count: pending.length,      color: "text-gta-gold",  border: "border-gta-gold/20" },
        { label: "Held by gate",    count: pendingNew.length,   color: "text-gta-teal",  border: "border-gta-teal/20" },
        { label: "Applied",         count: applied.length,      color: "text-zinc-400",  border: "border-zinc-700" },
        { label: "In drafts",       count: draftCount,          color: "text-zinc-500",  border: "border-zinc-800" },
      ].map(s => (
        <div class={`rounded-xl border ${s.border} px-4 py-3`} style="background:var(--c-card)">
          <div class={`text-2xl font-mono font-black ${s.color}`}>{s.count}</div>
          <div class="text-[11px] text-zinc-500 mt-0.5">{s.label}</div>
        </div>
      ))}
    </div>

    <!-- ── NEW PREDICTION proposals ──────────────────────────────────────── -->
    {pendingNew.length > 0 && (
      <div class="mb-10">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">
          // {pendingNew.length} new prediction{pendingNew.length !== 1 ? "s" : ""} — promoted from predictions-drafts.json
        </div>
        <div class="flex flex-col gap-4">
          {pendingNew.map((proposal: any) => {
            const obj = typeof proposal.proposed === "object" ? proposal.proposed : {};
            const proposedJson = JSON.stringify(obj, null, 2);
            const proposedAt = proposal.proposed_at
              ? new Date(proposal.proposed_at).toLocaleString("en-GB") : "unknown";
            const tierCls = tierColor(obj.confidence_tier ?? "");

            return (
              <div class="rounded-xl border border-gta-teal/25 overflow-hidden" style="background:var(--c-card)">

                <!-- Header -->
                <div class="px-5 py-3 border-b border-border-dim flex items-start justify-between gap-4 flex-wrap" style="background:color-mix(in srgb,var(--c-live) 5%,var(--c-bg-deep))">
                  <div>
                    <div class="flex items-center gap-2 flex-wrap mb-1">
                      <span class="border border-gta-teal/30 bg-gta-teal/10 text-gta-teal px-1.5 py-0.5 rounded text-[9px] uppercase tracking-widest font-mono">
                        + New prediction
                      </span>
                      <span class="text-[10px] font-mono text-zinc-600">{proposal.id}</span>
                    </div>
                    <div class="text-sm font-bold text-white">{obj.title ?? proposal.id}</div>
                    {obj.value && (
                      <div class="text-xs font-mono text-zinc-400 mt-0.5">
                        Value: <span class="text-zinc-200">{obj.value}</span>
                        {obj.unit && <span class="text-zinc-600"> · {obj.unit}</span>}
                      </div>
                    )}
                  </div>
                  <div class="flex items-center gap-2 shrink-0 flex-wrap">
                    {obj.confidence_tier && (
                      <span class={`text-[9px] font-mono uppercase tracking-widest border rounded px-2 py-0.5 ${tierCls} border-current`} style="opacity:0.8">
                        {obj.confidence_tier}
                      </span>
                    )}
                    {obj.confidence != null && (
                      <span class="text-[10px] font-mono text-zinc-500">{obj.confidence}% confidence</span>
                    )}
                    <span class="text-[10px] font-mono text-zinc-600">{proposedAt}</span>
                  </div>
                </div>

                <!-- Key fields preview -->
                <div class="px-5 py-4 grid grid-cols-1 sm:grid-cols-2 gap-4 border-b border-border-dim">
                  {obj.basis && (
                    <div>
                      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Basis</div>
                      <p class="text-[11px] text-zinc-400 leading-relaxed">{obj.basis}</p>
                    </div>
                  )}
                  {obj.prediction_range && (
                    <div>
                      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-1">Range</div>
                      <p class="text-[11px] text-zinc-300 font-mono">
                        {obj.prediction_range.low} — {obj.prediction_range.high}
                      </p>
                    </div>
                  )}
                </div>

                <!-- Full JSON -->
                <div class="px-5 py-4 border-b border-border-dim" style="background:rgba(34,197,94,0.02)">
                  <div class="text-[10px] font-mono text-gta-teal uppercase tracking-widest mb-2">Full JSON to add to predictions.json</div>
                  <pre class="text-[10px] text-zinc-300 font-mono leading-relaxed overflow-x-auto whitespace-pre" id={`json-${proposal.id}`}>{proposedJson}</pre>
                </div>

                <!-- Rationale + actions -->
                <div class="px-5 py-3 border-b border-border-dim">
                  <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mr-2">Rationale</span>
                  <span class="text-[11px] text-zinc-400">{proposal.rationale}</span>
                </div>
                <div class="px-5 py-3 flex items-center gap-3 flex-wrap">
                  <button
                    class="copy-btn text-[11px] font-mono border border-border-mid hover:border-gta-teal/40 hover:text-gta-teal text-zinc-400 px-3 py-1.5 rounded transition-all"
                    data-copy={proposedJson}
                  >
                    Copy JSON
                  </button>
                  <a
                    href={GITHUB_PREDICTIONS}
                    target="_blank" rel="noopener noreferrer"
                    class="text-[11px] font-mono border border-border-mid hover:border-gta-teal/40 hover:text-gta-teal text-zinc-400 px-3 py-1.5 rounded transition-all"
                  >
                    Edit predictions.json ↗
                  </a>
                  <a
                    href={GITHUB_DRAFTS}
                    target="_blank" rel="noopener noreferrer"
                    class="text-[11px] font-mono border border-border-mid hover:border-zinc-500 hover:text-zinc-300 text-zinc-600 px-3 py-1.5 rounded transition-all"
                  >
                    Edit drafts.json ↗
                  </a>
                  <span class="text-[10px] font-mono text-zinc-700 ml-auto">
                    To apply: paste JSON into <code class="text-zinc-500">predictions.json → predictions[]</code>,
                    then set <code class="text-zinc-500">draft_status: "promoted"</code> in predictions-drafts.json.
                  </span>
                </div>

              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- ── FIELD UPDATE proposals ────────────────────────────────────────── -->
    {pendingModify.length === 0 && pendingNew.length === 0 ? (
      <div class="rounded-xl border border-border-dim px-6 py-10 text-center" style="background:var(--c-card)">
        <div class="text-2xl mb-2">✓</div>
        <div class="text-zinc-400 text-sm">No pending proposals — predictions are up to date.</div>
        <div class="text-[11px] font-mono text-zinc-600 mt-1">Next auto-check: nightly at 03:00 UTC</div>
      </div>
    ) : pendingModify.length > 0 && (
      <div class="flex flex-col gap-4">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-1">
          // {pendingModify.length} field update{pendingModify.length !== 1 ? "s" : ""} — review before applying
        </div>

        {pendingModify.map((proposal: any) => {
          const predTitle = getPredTitle(proposal.id);
          const currentFull = getPredCurrent(proposal.id, proposal.field);
          const proposedStr = typeof proposal.proposed === "string"
            ? proposal.proposed
            : JSON.stringify(proposal.proposed, null, 2);
          const proposedAt = proposal.proposed_at
            ? new Date(proposal.proposed_at).toLocaleString("en-GB") : "unknown";

          return (
            <div class="rounded-xl border border-gta-gold/20 overflow-hidden" style="background:var(--c-card)">

              <!-- Card header -->
              <div class="px-5 py-3 border-b border-border-dim flex items-start justify-between gap-4 flex-wrap">
                <div>
                  <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-1 flex items-center gap-2">
                    <span class="border border-zinc-700 bg-zinc-800/60 text-zinc-400 px-1.5 py-0.5 rounded text-[9px] uppercase tracking-widest">
                      ✏ Modify existing
                    </span>
                    <span>{proposal.id}</span>
                    <span>· field: <span class="text-gta-gold">{proposal.field}</span></span>
                  </div>
                  <div class="text-sm font-semibold text-zinc-200">{predTitle}</div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-[10px] font-mono bg-gta-gold/10 border border-gta-gold/25 text-gta-gold px-2 py-0.5 rounded uppercase tracking-widest">
                    Pending
                  </span>
                  <span class="text-[10px] font-mono text-zinc-600">{proposedAt}</span>
                </div>
              </div>

              <!-- Diff -->
              <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-border-dim">
                <div class="px-5 py-4">
                  <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-2">Current</div>
                  <p class="text-[11px] text-zinc-400 font-mono leading-relaxed whitespace-pre-wrap">{currentFull}</p>
                </div>
                <div class="px-5 py-4" style="background:rgba(245,158,11,0.03)">
                  <div class="text-[10px] font-mono text-gta-gold uppercase tracking-widest mb-2">Proposed</div>
                  <p class="text-[11px] text-zinc-200 font-mono leading-relaxed whitespace-pre-wrap" id={`proposed-${proposal.id}-${proposal.field}`}>
                    {proposedStr}
                  </p>
                </div>
              </div>

              <!-- Rationale -->
              <div class="px-5 py-3 border-t border-border-dim">
                <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mr-2">Rationale</span>
                <span class="text-[11px] text-zinc-400">{proposal.rationale}</span>
              </div>

              <!-- Actions -->
              <div class="px-5 py-3 border-t border-border-dim flex items-center gap-3 flex-wrap">
                <button
                  class="copy-btn text-[11px] font-mono border border-border-mid hover:border-gta-gold/40 hover:text-gta-gold text-zinc-400 px-3 py-1.5 rounded transition-all"
                  data-copy={proposedStr}
                >
                  Copy proposed value
                </button>
                <a
                  href={GITHUB_PREDICTIONS}
                  target="_blank" rel="noopener noreferrer"
                  class="text-[11px] font-mono border border-border-mid hover:border-gta-teal/40 hover:text-gta-teal text-zinc-400 px-3 py-1.5 rounded transition-all"
                >
                  Edit predictions.json ↗
                </a>
                <span class="text-[10px] font-mono text-zinc-700 ml-auto">
                  To apply: paste into <code class="text-zinc-500">predictions.json → {proposal.id} → {proposal.field}</code>
                  · set <code class="text-zinc-500">editorial_note: "approved"</code>
                  · delete entry from <code class="text-zinc-500">predictions-proposals.json</code>.
                </span>
              </div>

            </div>
          );
        })}
      </div>
    )}

    <!-- Applied / dismissed history -->
    {applied.length > 0 && (
      <div class="mt-10">
        <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">// Applied history</div>
        <div class="flex flex-col gap-2">
          {applied.map((p: any) => (
            <div class="rounded-lg border border-gta-teal/15 px-4 py-3 flex items-center justify-between gap-4" style="background:var(--c-card)">
              <div class="text-[11px] font-mono text-zinc-500">
                <span class="text-gta-teal mr-2">✓</span>
                {p.id}
                {p.field !== "_new" && <span> · {p.field}</span>}
                {p.field === "_new" && <span class="text-gta-teal/70"> · new prediction</span>}
              </div>
              <span class="text-[10px] font-mono text-zinc-700">
                {p.proposed_at ? new Date(p.proposed_at).toLocaleDateString("en-GB") : ""}
              </span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- How this works -->
    <div class="mt-10 rounded-xl border border-border-dim px-5 py-4" style="background:var(--c-card)">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest mb-3">// How new predictions flow through this page</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <div class="text-[10px] font-mono text-gta-teal uppercase tracking-widest mb-2">New predictions</div>
          <ol class="text-[11px] text-zinc-500 font-mono space-y-1 leading-relaxed list-none">
            <li>1. Add to <span class="text-zinc-300">predictions-drafts.json</span> (<code class="text-zinc-400">draft_status: "pending"</code>)</li>
            <li>2. Nightly CI promotes each pending draft to a proposal here</li>
            <li>3. Review the full JSON card above</li>
            <li>4. Copy JSON → paste into <span class="text-zinc-300">predictions.json → predictions[]</span></li>
            <li>5. Set <code class="text-zinc-400">draft_status: "promoted"</code> in drafts file</li>
          </ol>
        </div>
        <div>
          <div class="text-[10px] font-mono text-gta-gold uppercase tracking-widest mb-2">Field updates (existing predictions)</div>
          <ol class="text-[11px] text-zinc-500 font-mono space-y-1 leading-relaxed list-none">
            <li>1. Nightly CI runs <span class="text-zinc-300">fetch_predictions_auto.py</span> at 03:00 UTC</li>
            <li>2. Confirmed data → applied directly to predictions.json</li>
            <li>3. Uncertain changes → appear as field-update proposals here</li>
            <li>4. Review the diff and paste into predictions.json</li>
            <li>5. Delete entry from <span class="text-zinc-300">predictions-proposals.json</span></li>
          </ol>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-border-dim text-[10px] font-mono text-zinc-700">
        Rule: Never add a prediction directly to predictions.json. Always go through predictions-drafts.json → this page.
      </div>
    </div>

  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const text = btn.dataset.copy ?? "";
      navigator.clipboard.writeText(text).then(() => {
        const orig = btn.textContent;
        btn.textContent = "Copied ✓";
        btn.style.borderColor = "color-mix(in srgb,var(--c-brand) 50%,transparent)";
        btn.style.color = "var(--c-brand)";
        setTimeout(() => {
          btn.textContent = orig;
          btn.style.borderColor = "";
          btn.style.color = "";
        }, 1800);
      });
    });
  });
</script>
