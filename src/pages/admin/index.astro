---
import Base from "../../layouts/Base.astro";

const SITE_BASE     = "https://gtavi.ai";
const STAGING_BASE  = "https://staging.gtavi.ai";

const healthChecks = [
  {
    label:   "Production KV",
    url:     `${SITE_BASE}/api/poll/health`,
    env:     "gtavi.ai",
    color:   "var(--c-live)",
  },
  {
    label:   "Staging KV",
    url:     `${STAGING_BASE}/api/poll/health`,
    env:     "staging.gtavi.ai",
    color:   "var(--c-brand)",
  },
];

const tools = [
  {
    href:  "/admin/predictions",
    label: "Prediction Ranks",
    sub:   "Reorder predictions · toggle Home / Hub visibility · copy JSON patch",
    icon:  "intel",
    color: "var(--c-brand)",
  },
  {
    href:  "/admin/proposals",
    label: "Prediction Proposals",
    sub:   "Review nightly auto-update proposals · accept or reject · copy patch",
    icon:  "intel",
    color: "var(--c-live)",
  },
  {
    href:  "/admin/charts",
    label: "Chart Ranks",
    sub:   "Reorder charts page order · filter by game · copy JSON patch",
    icon:  "chart",
    color: "var(--c-economy)",
  },
  {
    href:  "/admin/pipeline",
    label: "Content Pipeline",
    sub:   "Scraper status · GTA VI data readiness · nightly CI tracker",
    icon:  "money",
    color: "var(--c-live)",
  },
  {
    href:  "/admin/structure",
    label: "Site Structure",
    sub:   "Design system reference · GamePill tokens · page inventory · chart registry · live counts",
    icon:  "intel",
    color: "var(--c-text-4)",
  },
  {
    href:  "/admin/cards",
    label: "Card Inventory",
    sub:   "All card templates rendered with sample data · clustered by purpose",
    icon:  "database",
    color: "var(--c-economy)",
  },
  {
    href:  "/admin/pills",
    label: "Badge Inventory",
    sub:   "Badge · FilterPill · ColorLabel — variants, surfaces, tokens, usage",
    icon:  "tag",
    color: "var(--c-brand)",
  },
  {
    href:  "/admin/icons",
    label: "Icon Inventory",
    sub:   "Full HudIcon reference · name, preview, and usage context",
    icon:  "hub",
    color: "var(--c-text-4)",
  },
  {
    href:  "/admin/social",
    label: "Social & Growth Strategy",
    sub:   "n8n pipeline · poll embed distribution · SEO · affiliate · traffic playbook",
    icon:  "money",
    color: "var(--c-gta-dollar)",
  },
  {
    href:  "/admin/resources",
    label: "Art & Asset Resources",
    sub:   "External GTA art sources · local asset locations · licensing notes",
    icon:  "hub",
    color: "var(--c-brand)",
  },
];
// Staging-only gate — this page must never render on production
const CF_BRANCH = (typeof process !== "undefined" ? (process.env.CF_PAGES_BRANCH ?? "") : "").toLowerCase();
const IS_STAGING = CF_BRANCH !== "" && CF_BRANCH !== "main";
if (!IS_STAGING) { return Astro.redirect("/404"); }
---

<Base title="Admin" description="GTAVI.AI admin tools" noindex>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-16">

    <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">// Admin</div>
    <h1 class="text-2xl font-bold text-white mb-1">Admin Tools</h1>
    <p class="text-[11px] font-mono text-zinc-600 mb-10">
      All changes are in-memory only — copy the JSON patch and apply via GitHub editor.
    </p>

    <div class="flex flex-col gap-3">
      {tools.map(t => (
        <a
          href={t.href}
          class="group flex items-start gap-4 rounded-xl border border-border-dim hover:border-border-mid px-5 py-4 transition-colors"
          style="background:var(--c-card)"
        >
          <div class="w-1 self-stretch rounded-full shrink-0 mt-0.5" style={`background:${t.color}`}></div>
          <div class="flex-1 min-w-0">
            <div class="text-sm font-semibold text-zinc-200 group-hover:text-white transition-colors mb-0.5">{t.label}</div>
            <div class="text-[11px] font-mono text-zinc-500 leading-snug">{t.sub}</div>
          </div>
          <span class="text-zinc-600 group-hover:text-zinc-400 transition-colors text-sm shrink-0 self-center">→</span>
        </a>
      ))}
    </div>

    <!-- ── Health checks ──────────────────────────────────────────────── -->
    <div class="mt-10">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">// Infrastructure health</div>
      <div class="flex flex-col gap-2" id="health-checks">
        {healthChecks.map(h => (
          <div
            class="flex items-center justify-between gap-4 rounded-lg border border-border-dim px-4 py-3"
            style="background:var(--c-card)"
            data-health-url={h.url}
          >
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${h.color}`}></div>
              <div>
                <div class="text-[11px] font-mono text-zinc-300 font-semibold">{h.label}</div>
                <div class="text-[10px] font-mono text-zinc-600">{h.env}</div>
              </div>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="health-status text-[10px] font-mono text-zinc-600 uppercase tracking-widest">—</span>
              <a
                href={h.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[10px] font-mono text-zinc-600 hover:text-zinc-300 transition-colors border border-border-dim hover:border-border-mid px-2 py-1 rounded"
              >
                Open ↗
              </a>
            </div>
          </div>
        ))}
      </div>
      <button
        id="run-health-checks"
        class="mt-2 text-[10px] font-mono text-zinc-600 hover:text-zinc-300 transition-colors uppercase tracking-widest"
      >
        Run checks ↺
      </button>
    </div>

    <div class="mt-6 rounded-lg border border-border-dim px-4 py-3" style="background:var(--c-card)">
      <p class="text-[10px] font-mono text-zinc-600">
        Admin pages are public URLs — read-only operations, no server writes.
        Direct URL access only; not linked from the main nav.
      </p>
    </div>

  </div>
</Base>

<script>
  async function runHealthChecks() {
    const btn = document.getElementById("run-health-checks");
    if (btn) btn.textContent = "Checking…";

    const cards = document.querySelectorAll<HTMLElement>("[data-health-url]");

    await Promise.all(Array.from(cards).map(async card => {
      const url    = card.dataset.healthUrl!;
      const status = card.querySelector<HTMLElement>(".health-status")!;

      status.textContent = "…";
      status.style.color = "var(--c-text-5)";

      try {
        const resp = await fetch(url, { cache: "no-store" });
        const data = await resp.json().catch(() => null);

        if (data?.ok === true) {
          status.textContent = "✓ bound";
          status.style.color = "var(--c-live)";
        } else if (data?.kv === "missing") {
          status.textContent = "✗ unbound";
          status.style.color = "var(--c-alert)";
        } else if (data?.ok === false) {
          status.textContent = "✗ error";
          status.style.color = "var(--c-alert)";
        } else {
          status.textContent = resp.ok ? "? unknown" : `✗ ${resp.status}`;
          status.style.color = "var(--c-alert)";
        }
      } catch {
        status.textContent = "✗ unreachable";
        status.style.color = "var(--c-alert)";
      }
    }));

    if (btn) btn.textContent = "Run checks ↺";
  }

  document.getElementById("run-health-checks")?.addEventListener("click", runHealthChecks);

  // Auto-run on page load
  runHealthChecks();
</script>
