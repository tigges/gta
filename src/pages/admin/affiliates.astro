const other = [
  {
    name: "NordVPN",
    network: "Nord Affiliate (NordPartners)",
    commission: "$30–60 per sale",
    cookie: "30 days",
    status: "active",
    signup: "https://affiliates.nordvpn.com",
    id: "150614",
    notes: "offer_id=15, url_id=902. Tiles live on /gta-vi/buy + /gta-online. nordLink() in affiliates.ts.",
  },
  {
    name: "NordPass",
    network: "Nord Affiliate (NordPartners)",
    commission: "$10–20 per sale",
    cookie: "30 days",
    status: "active",
    signup: "https://affiliates.nordvpn.com",
    id: "150614",
    notes: "offer_id=488, url_id=9356. Tiles live on /gta-vi/buy + /gta-online. nordPassLink() in affiliates.ts.",
  },
  {
    name: "Green Man Gaming",
    network: "Impact.com",
    commission: "2–5% per sale, 10% bundles",
    cookie: "30 days",
    status: "denied",
    signup: "https://www.greenmangaming.com/affiliates/",
    id: "",
    notes: "Application denied Jun 2026.",
  },
  {
    name: "PlayStation Direct",
    network: "Partnerize",
    commission: "Variable by category",
    cookie: "30 days",
    status: "pending",
    signup: "https://direct.playstation.com/en-us/playstation-affiliate-programme",
    id: "",
    notes: "Apply via Partnerize → Campaigns → PlayStation Direct",
  },
  {
    name: "PlayStation Plus",
    network: "Impact.com",
    commission: "$5 per new signup",
    cookie: "30 days",
    status: "pending",
    signup: "https://impact.com",
    id: "",
    notes: "Find in Impact.com Marketplace",
  },
  {
    name: "ZAP-Hosting (FiveM)",
    network: "ZAP-Hosting",
    commission: "Recurring %",
    cookie: "—",
    status: "pending",
    signup: "https://zap-hosting.com/en/affiliate/",
    id: "",
    notes: "Check Affiliate tab in ZAP account for link",
  },
  {
    name: "FlexOffers",
    network: "FlexOffers",
    commission: "Varies",
    cookie: "Varies",
    status: "denied",
    signup: "https://www.flexoffers.com",
    id: "",
    notes: "Application denied Jun 2026. Site verification tag (fo-verify) removed from Base.astro.",
  },
  {
    name: "Skimlinks",
    network: "Skimlinks",
    commission: "~75% of affiliate rate across 48k merchants",
    cookie: "Per merchant",
    status: "todo",
    signup: "https://www.skimlinks.com",
    id: "",
    notes: "One JS snippet → auto-tags Amazon all countries + PlayStation + 48k others",
  },
  {
    name: "Amazon Associates Japan",
    network: "Amazon",
    commission: "~1–3%",
    cookie: "24 hours",
    status: "todo",
    signup: "https://affiliate.amazon.co.jp",
    id: "",
    notes: "Top-5 GTA market globally",
  },
  {
    name: "Amazon Associates Australia",
    network: "Amazon",
    commission: "~1–3%",
    cookie: "24 hours",
    status: "todo",
    signup: "https://affiliate-program.amazon.com.au",
    id: "",
    notes: "",
  },
] as const;

type AffiliateKey = keyof typeof AFFILIATE_IDS;

function getTag(key: string): string {
  return (AFFILIATE_IDS as Record<string, string>)[key] ?? "";
}

// Deduplicate amazon rows by key
const amazonUnique = amazon.filter((r, i, arr) => arr.findIndex(x => x.key === r.key) === i);
// Staging-only gate — this page must never render on production
const CF_BRANCH = (typeof process !== "undefined" ? (process.env.CF_PAGES_BRANCH ?? "") : "").toLowerCase();
const IS_STAGING = CF_BRANCH !== "" && CF_BRANCH !== "main";
if (!IS_STAGING) { return Astro.redirect("/404"); }
---

<Base
  title="Affiliate Dashboard — Admin"
  description="Internal affiliate programme tracker for gtavi.ai"
  noindex={true}
  titleContext="gta-v"
  ogPage="gta-v"
  crossLinksContext="gta-v"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-8">
      <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest mb-1">Staging only · not indexed</div>
      <h1 class="text-2xl font-bold text-zinc-100 mb-2">Affiliate Dashboard</h1>
      <p class="text-[13px] text-zinc-500 font-mono">All affiliate programmes, IDs, statuses and sign-up links. Add IDs to <code class="text-zinc-300">src/config/affiliates.ts</code>.</p>
    </div>

    <!-- ── Amazon Associates ───────────────────────────────────────── -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-1.5 h-1.5 rounded-full bg-amber-400"></div>
        <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">// Amazon Associates — {amazonUnique.filter(r => getTag(r.key)).length} / {amazonUnique.length} tagged</span>
      </div>

      <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <table class="w-full text-[11px] font-mono">
          <thead>
            <tr class="border-b border-border-dim text-zinc-500">
              <th class="text-left px-4 py-2.5">Market</th>
              <th class="text-left px-4 py-2.5">Store</th>
              <th class="text-left px-4 py-2.5">Associate ID</th>
              <th class="text-left px-4 py-2.5">Status</th>
              <th class="text-left px-4 py-2.5">Sign-up</th>
            </tr>
          </thead>
          <tbody>
            {amazonUnique.map(row => {
              const tag = getTag(row.key);
              return (
                <tr class="border-b border-border-dim last:border-0 hover:bg-white/[0.02]">
                  <td class="px-4 py-2.5 text-zinc-200">{row.flag} {row.market}</td>
                  <td class="px-4 py-2.5 text-zinc-500">{row.store}</td>
                  <td class="px-4 py-2.5">
                    {tag
                      ? <span class="text-gta-teal">{tag}</span>
                      : <span class="text-zinc-600">—</span>
                    }
                  </td>
                  <td class="px-4 py-2.5">
                    {tag
                      ? <span class="text-[10px] px-1.5 py-0.5 rounded border border-gta-teal/30 text-gta-teal">Active</span>
                      : <span class="text-[10px] px-1.5 py-0.5 rounded border border-zinc-700 text-zinc-500">Untagged</span>
                    }
                  </td>
                  <td class="px-4 py-2.5">
                    {!tag && (
                      <a href={row.signup} target="_blank" rel="noopener noreferrer"
                        class="text-amber-400 hover:text-amber-300 transition-colors">
                        Sign up →
                      </a>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Other Programmes ───────────────────────────────────────── -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-1.5 h-1.5 rounded-full bg-amber-400"></div>
        <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">// Other Programmes</span>
      </div>

      <div class="flex flex-col gap-3">
        {other.map(prog => (
          <div class="rounded-xl border border-border-dim px-5 py-4 flex items-start gap-4" style="background:var(--c-card)">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-zinc-100 font-semibold text-sm">{prog.name}</span>
                <span class="text-[10px] font-mono text-zinc-600">{prog.network}</span>
                {prog.status === "pending" && (
                  <span class="text-[10px] px-1.5 py-0.5 rounded border border-amber-400/30 text-amber-400 font-mono">In Review</span>
                )}
                {prog.status === "denied" && (
                  <span class="text-[10px] px-1.5 py-0.5 rounded border border-red-500/30 text-red-400 font-mono">Denied</span>
                )}
                {prog.status === "todo" && (
                  <span class="text-[10px] px-1.5 py-0.5 rounded border border-zinc-700 text-zinc-500 font-mono">To Do</span>
                )}
                {prog.status === "active" && (
                  <span class="text-[10px] px-1.5 py-0.5 rounded border border-tier-confirmed/30 text-tier-confirmed font-mono">Active</span>
                )}
              </div>
              <div class="flex items-center gap-4 text-[11px] text-zinc-500 font-mono">
                <span>Commission: <span class="text-zinc-300">{prog.commission}</span></span>
                <span>Cookie: <span class="text-zinc-300">{prog.cookie}</span></span>
              </div>
              {prog.notes && (
                <div class="text-[10px] text-zinc-600 font-mono mt-1">{prog.notes}</div>
              )}
            </div>
            <a href={prog.signup} target="_blank" rel="noopener noreferrer"
              class="shrink-0 text-[10px] font-mono px-3 py-1.5 rounded border border-amber-400/30 text-amber-400 hover:bg-amber-400/10 transition-colors uppercase tracking-widest whitespace-nowrap">
              {prog.status === "active" ? "Dashboard →" : "Sign up →"}
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Non-Amazon alternatives ────────────────────────────────── -->
    <section class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-1.5 h-1.5 rounded-full bg-amber-400"></div>
        <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">// No-Amazon Markets — Alternative Networks</span>
      </div>
      <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <table class="w-full text-[11px] font-mono">
          <thead>
            <tr class="border-b border-border-dim text-zinc-500">
              <th class="text-left px-4 py-2.5">Market</th>
              <th class="text-left px-4 py-2.5">Programme</th>
              <th class="text-left px-4 py-2.5">Sign-up</th>
            </tr>
          </thead>
          <tbody>
            {[
              { flag: "🇰🇷", market: "South Korea",    name: "Coupang Partners",          url: "https://partners.coupang.com" },
              { flag: "🇦🇷", market: "Argentina",       name: "Mercado Libre Afiliados",   url: "https://www.mercadolibre.com.ar/afiliados" },
              { flag: "🇿🇦", market: "South Africa",    name: "Admarula (Takealot)",        url: "https://www.admarula.com" },
              { flag: "🇹🇷", market: "Turkey (alt)",    name: "Hepsiburada",               url: "https://www.hepsiburada.com/ortaklik-programi" },
              { flag: "🇨🇭", market: "Switzerland",     name: "No open programme",         url: "" },
              { flag: "🇹🇼", market: "Taiwan",          name: "No open programme",         url: "" },
            ].map(r => (
              <tr class="border-b border-border-dim last:border-0 hover:bg-white/[0.02]">
                <td class="px-4 py-2.5 text-zinc-200">{r.flag} {r.market}</td>
                <td class="px-4 py-2.5 text-zinc-400">{r.name}</td>
                <td class="px-4 py-2.5">
                  {r.url
                    ? <a href={r.url} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:text-amber-300 transition-colors">Sign up →</a>
                    : <span class="text-zinc-600">Convenience links only</span>
                  }
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Wire-in instructions ───────────────────────────────────── -->
    <section>
      <div class="flex items-center gap-2 mb-4">
        <div class="w-1.5 h-1.5 rounded-full bg-amber-400"></div>
        <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">// How to add a new tag</span>
      </div>
      <div class="rounded-xl border border-border-dim px-5 py-4 text-[11px] font-mono text-zinc-400 leading-relaxed" style="background:var(--c-card)">
        <div class="text-zinc-200 mb-2">1. Get your Associate/Affiliate ID from the programme dashboard</div>
        <div class="mb-2">2. Open <span class="text-zinc-200">src/config/affiliates.ts</span></div>
        <div class="mb-2">3. Set the value: <span class="text-gta-teal">amazon_de: "your-tag-here"</span></div>
        <div class="mb-2">4. Rebuild + deploy — all links on the buy page auto-tag via <span class="text-zinc-200">tagAmazonUrl()</span></div>
        <div class="text-zinc-600 mt-3">Non-Amazon programmes (NordVPN, ZAP, PlayStation) need a component update on the relevant page. Tell the agent the ID and target page.</div>
      </div>
    </section>

  </div>
</Base>
