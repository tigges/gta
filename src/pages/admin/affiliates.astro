  { key: "amazon_jp",  flag: "🇯🇵", market: "Japan",           store: "amazon.co.jp",  signup: "https://affiliate.amazon.co.jp" },
  { key: "amazon_au",  flag: "🇦🇺", market: "Australia",       store: "amazon.com.au", signup: "https://affiliate-program.amazon.com.au" },
  { key: "amazon_ca",  flag: "🇨🇦", market: "Canada",          store: "amazon.ca",     signup: "https://associates.amazon.ca" },
  { key: "amazon_in",  flag: "🇮🇳", market: "India",           store: "amazon.in",     signup: "https://affiliate-program.amazon.in" },
  { key: "amazon_br",  flag: "🇧🇷", market: "Brazil",          store: "amazon.com.br", signup: "https://associados.amazon.com.br" },
  { key: "amazon_mx",  flag: "🇲🇽", market: "Mexico",          store: "amazon.com.mx", signup: "https://afiliados.amazon.com.mx" },
  { key: "amazon_tr",  flag: "🇹🇷", market: "Turkey",          store: "amazon.com.tr", signup: "https://gelir-ortakligi.amazon.com.tr" },
  { key: "amazon_sa",  flag: "🇸🇦", market: "Saudi Arabia",    store: "amazon.sa",     signup: "https://affiliate-program.amazon.sa" },
  { key: "amazon_ae",  flag: "🇦🇪", market: "UAE",             store: "amazon.ae",     signup: "https://affiliate-program.amazon.ae" },
  { key: "amazon_za",  flag: "🇿🇦", market: "South Africa",    store: "amazon.co.za",  signup: "https://affiliate-program.amazon.co.za" },
