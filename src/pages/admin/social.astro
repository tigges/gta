---
/**
 * /admin/social — Social, Growth & Monetisation Strategy
 * Full playbook: weekly content rhythm, SEO, affiliate, traffic.
 * Internal admin tool — unlisted from public nav.
 */
import Base from "../../layouts/Base.astro";

const todayStr = new Date().toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" });

// Dev-only gate — admin pages render under `npm run dev` and never in production builds
if (!import.meta.env.DEV) { return Astro.redirect("/404"); }
---

<Base title="Admin — Social & Growth Strategy" description="GTAVI.AI social media strategy, SEO, affiliate and traffic playbook." noindex>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">

    <div>
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// Admin · Internal</div>
      <h1 class="text-2xl font-bold text-white mb-1">Social &amp; Growth Strategy</h1>
      <p class="text-sm text-zinc-500">Weekly content rhythm · SEO · affiliate programme · traffic playbook. Not visible to public users.</p>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         STRATEGY OVERVIEW
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-brand/60 shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Strategy Overview</span>
        <div class="flex-1 h-px bg-border-dim"></div>
      </div>

      <!-- Flywheel -->
      <div class="rounded-xl border border-border-dim p-5 mb-5" style="background:var(--c-card)">
        <div class="text-[11px] font-semibold text-zinc-300 mb-3">Content flywheel — one data drop drives the whole week</div>
        <div class="flex items-center gap-2 flex-wrap text-[11px] font-mono mb-4">
          {([
            { label: "Nightly data refresh",     note: "scrapers → main → deploy",  color: "var(--c-brand)" },
            { label: "→" },
            { label: "Pick the week's story",    note: "prediction · chart · trailer", color: "var(--c-chart-bar)" },
            { label: "→" },
            { label: "Schedule in Publer",       note: "Monday · X + Instagram",   color: "var(--c-gta-vi-coral)" },
            { label: "→" },
            { label: "Auto-fires Tuesday",       note: "Publer · Discord", color: "var(--c-live)" },
            { label: "→" },
            { label: "Traffic → site",           note: "intel + charts",             color: "var(--c-gta-dollar)" },
            { label: "→" },
            { label: "Followers grow",           note: "→ next week's audience",    color: "var(--c-brand)" },
          ] as const).map((s: any) =>
            s.label === "→"
              ? <span class="text-zinc-700 shrink-0">→</span>
              : (
                <div class="rounded border border-border-dim px-2.5 py-1.5 shrink-0" style="background:var(--c-bg-deep)">
                  <div style={`color:${s.color}`}>{s.label}</div>
                  <div class="text-[9px] text-zinc-700 mt-0.5">{s.note}</div>
                </div>
              )
          )}
        </div>
        <p class="text-[11px] text-zinc-600 leading-relaxed">
          Each week one prediction, chart or trailer finding is featured. On Monday, write the X post and Instagram caption, link the relevant /gta-vi/intel or /charts anchor, and schedule both in Publer for Tuesday 09:00 UTC. The Discord nightly digest fires automatically. Reddit and GTAForums are the only live-paste channels (Thursday).
        </p>
      </div>

      <!-- Weekly calendar -->
      <div class="rounded-xl border border-border-dim overflow-hidden mb-5" style="background:var(--c-card)">
        <div class="px-4 py-2.5 border-b border-border-dim">
          <span class="text-[11px] font-semibold text-zinc-300">Weekly publishing calendar</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-[11px] font-mono">
            <thead>
              <tr class="border-b border-border-dim">
                <th class="text-left px-4 py-2 text-zinc-600 font-normal w-24">Day</th>
                <th class="text-left px-4 py-2 text-zinc-600 font-normal">Action</th>
                <th class="text-left px-4 py-2 text-zinc-600 font-normal w-28">Channel</th>
                <th class="text-left px-4 py-2 text-zinc-600 font-normal w-20">Mode</th>
              </tr>
            </thead>
            <tbody>
              {([
                { day: "Monday",    action: "Pick the week's featured prediction or chart. Open Publer: write X post + schedule Tue 09:00. Upload IG screenshot + caption + schedule Tue 09:00.", ch: "Publer prep",    time: "manual · ~15 min" },
                { day: "Tuesday",   action: "X tweet auto-fires via Publer at 09:00 UTC",                             ch: "X / Twitter",   time: "auto · Publer" },
                { day: "Tuesday",   action: "Instagram post auto-fires via Publer at 09:00 UTC",                      ch: "Instagram",     time: "auto · Publer" },
                { day: "Daily",     action: "Discord nightly intel digest fires automatically",                       ch: "Discord",       time: "auto · 03:00 UTC" },
                { day: "Thursday",  action: "Reddit r/GTA6 — data post on the week's featured finding. Peak window 18–21 UTC",    ch: "Reddit",        time: "manual · 18:00 UTC" },
                { day: "Thu–Sun",   action: "GTAForums GTA VI General Discussion — same finding, analysis thread",      ch: "GTAForums",     time: "manual" },
                { day: "On trailer","action": "YouTube video description embed link + community post comment",         ch: "YouTube",       time: "manual · on event" },
              ] as const).map((r: any, i: number) => (
                <tr class={`border-b border-border-dim/40 hover:bg-white/[0.02] transition-colors ${r.day === "Tuesday" || r.day === "Thursday" ? "bg-white/[0.01]" : ""}`}>
                  <td class="px-4 py-2.5 text-zinc-400 font-semibold">{r.day}</td>
                  <td class="px-4 py-2.5 text-zinc-500">{r.action}</td>
                  <td class="px-4 py-2.5 text-zinc-400">{r.ch}</td>
                  <td class="px-4 py-2.5">
                    <span class={`text-[9px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${r.time.startsWith("auto") ? "border-gta-green/30 text-gta-green/70" : "border-zinc-700 text-zinc-600"}`}>
                      {r.time.startsWith("auto") ? "auto" : "manual"}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- What's automated vs manual -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-gta-green/20 p-4" style="background:color-mix(in srgb,var(--c-gta-dollar) 4%,var(--c-card))">
          <div class="text-[11px] font-semibold text-gta-green mb-3">● Fires automatically — nothing to do on publish day</div>
          <ul class="space-y-2">
            {([
              { label: "X / Twitter",              detail: "Tuesday 09:00 UTC — pre-scheduled Monday in Publer" },
              { label: "Instagram",                detail: "Tuesday 09:00 UTC — pre-scheduled Monday in Publer" },
              { label: "Discord nightly digest",   detail: "03:00 UTC daily via CI — post_discord_digest.py" },
              { label: "Data refresh",              detail: "Nightly scrapers commit fresh JSON to main" },
              { label: "Site deploy",               detail: "GitHub Pages rebuild after every push and nightly refresh" },
            ] as const).map((item: any) => (
              <li class="flex gap-2 text-[11px]">
                <span class="text-gta-green/50 shrink-0 mt-0.5">✓</span>
                <span><span class="text-zinc-300">{item.label}</span><span class="text-zinc-600"> — {item.detail}</span></span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-border-dim p-4" style="background:var(--c-card)">
          <div class="text-[11px] font-semibold text-zinc-400 mb-3">○ Manual — your two sessions per week</div>
          <ul class="space-y-2">
            {([
              { label: "Monday ~15 min", detail: "Publer: write X post + schedule Tue 09:00. Upload IG screenshot + caption + schedule Tue 09:00." },
              { label: "Thursday 18:00", detail: "Reddit r/GTA6 — data post at peak window" },
              { label: "Thu–Sun",        detail: "GTAForums — analysis thread on the same finding" },
              { label: "On trailer",     detail: "YouTube — embed link in description + community post" },
            ] as const).map((item: any) => (
              <li class="flex gap-2 text-[11px]">
                <span class="text-zinc-700 shrink-0 mt-0.5">→</span>
                <span><span class="text-zinc-300">{item.label}</span><span class="text-zinc-600"> — {item.detail}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         AUTOMATION STATUS BAR
    ═══════════════════════════════════════════════════════ -->
    <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
      <div class="px-4 py-2.5 border-b border-border-dim flex items-center gap-2">
        <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">Automation Status — {todayStr}</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-border-dim">
        {([
          {
            label:  "Publer · X + Instagram",
            time:   "Tue 09:00 UTC · scheduled Monday",
            status: "running",
            note:   "publer.com — schedule X tweet + Instagram post every Monday in ~5 min",
          },
          {
            label:  "Discord nightly digest",
            time:   "03:00 UTC · every night",
            status: "running",
            note:   "post_discord_digest.py via CI — DISCORD_WEBHOOK_URL needed",
          },
          {
            label:  "Nightly data refresh",
            time:   "03:00 UTC · every night",
            status: "running",
            note:   "fetch-data.yml commits fresh JSON; static.yml redeploys GitHub Pages",
          },
        ] as const).map((item) => (
          <div class="px-4 py-3">
            <div class={`text-[10px] font-mono mb-1.5 uppercase tracking-widest font-semibold ${
              item.status === "running"  ? "text-gta-green" :
              item.status === "broken"  ? "text-gta-vi-coral" :
              item.status === "check"   ? "text-gta-gold" :
              "text-zinc-600"
            }`}>
              {item.status === "running"  ? "● running" :
               item.status === "broken"  ? "✕ not configured" :
               item.status === "check"   ? "? verify key" :
               "○ inactive"}
            </div>
            <div class="text-[11px] font-semibold text-zinc-300 mb-0.5">{item.label}</div>
            <div class="text-[10px] font-mono text-zinc-600 mb-1">{item.time}</div>
            <div class="text-[10px] text-zinc-700 leading-relaxed">{item.note}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         SECTION 1 — SEO STRATEGY
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-gta-vi-coral/60 shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// 01 — SEO Strategy</span>
        <div class="flex-1 h-px bg-border-dim"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5">
        {[
          {
            tier: "Tier 1 — Money pages",
            color: "var(--c-live)",
            pages: ["/gta-vi/intel", "/gta-vi/economy", "/predictions", "/charts", "/buy"],
            strategy: "Target transactional + informational intent. H1 = primary KW. Each page needs unique meta description including 'GTA VI' + intent modifier.",
          },
          {
            tier: "Tier 2 — Hub pages",
            color: "var(--c-brand)",
            pages: ["/gta-vi", "/gta-online", "/franchise/history", "/charts"],
            strategy: "Internal linking hubs. Strong topical authority signals. Aim for featured snippets on 'GTA VI release date', 'GTA VI map size', 'GTA Online income 2026'.",
          },
          {
            tier: "Tier 3 — Long tail",
            color: "var(--c-economy)",
            pages: ["/gta-vi/intel (individual predictions)", "/gta-vi/intel/embed/[id]"],
            strategy: "Individual prediction anchors rank for 'will GTA VI have X?' queries — give each a rich og:title and og:description.",
          },
        ].map(t => (
          <div class="rounded-xl border border-border-dim p-4" style="background:var(--c-card)">
            <div class="text-[11px] font-semibold mb-1" style={`color:${t.color}`}>{t.tier}</div>
            <div class="flex flex-wrap gap-1 mb-3">
              {t.pages.map((pg: string) => (
                <code class="text-[10px] font-mono bg-zinc-800 text-zinc-400 px-1.5 py-0.5 rounded">{pg}</code>
              ))}
            </div>
            <p class="text-[11px] text-zinc-500 leading-relaxed">{t.strategy}</p>
          </div>
        ))}
      </div>

      <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <div class="px-4 py-3 border-b border-border-dim">
          <span class="text-[11px] font-semibold text-zinc-300">Priority SEO Actions</span>
        </div>
        <div class="divide-y divide-border-dim/40">
          {[
            { action: "Add FAQ schema to /gta-vi/intel", priority: "High", status: "pending", note: "Each prediction = a FAQ item. Adds rich snippets to SERPs." },
            { action: "Internal links from /gta-vi to every intel prediction", priority: "High", status: "done", note: "Hub → spoke structure already in place." },
            { action: "Target 'GTA 6 release date 2026' with dedicated section on /gta-vi", priority: "High", status: "done", note: "pred-release-window prominently placed." },
            { action: "Add canonical tags to prediction embed pages pointing to /gta-vi/intel", priority: "Medium", status: "pending", note: "Prevents embed iframe URL from competing with the main intel page." },
            { action: "Build 'GTA VI vs GTA V economy' comparison page", priority: "Medium", status: "pending", note: "High-intent informational query. Maps to franchise/sales + economy data." },
          ].map(r => (
            <div class="flex items-start gap-3 px-4 py-2.5">
              <span class={`text-[10px] font-mono shrink-0 mt-0.5 border px-1.5 py-0.5 rounded uppercase tracking-widest ${r.priority === 'High' ? 'border-gta-vi-coral/40 text-gta-vi-coral' : 'border-zinc-700 text-zinc-500'}`}>{r.priority}</span>
              <div class="flex-1 min-w-0">
                <div class="text-[11px] text-zinc-300">{r.action}</div>
                <div class="text-[10px] text-zinc-600 mt-0.5">{r.note}</div>
              </div>
              <span class={`text-[10px] font-mono shrink-0 ${r.status === 'done' ? 'text-gta-green/70' : 'text-zinc-600'}`}>{r.status === 'done' ? '✓ done' : 'todo'}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         SECTION 2 — AFFILIATE STRATEGY
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-gta-dollar/60 shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// 02 — Affiliate Strategy</span>
        <div class="flex-1 h-px bg-border-dim"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
        {[
          {
            tier: "Active — live on site",
            color: "var(--c-live)",
            partners: [
              { name: "Amazon Associates", rate: "1–3%", note: "US/UK/CA/DE/FR/ES/IT/AU tags wired in affiliates.ts. /buy page physical copy links.", url: "https://affiliate-program.amazon.com" },
              { name: "NordVPN",  rate: "40% CPS", note: "offer_id=15, url_id=902. Tiles live on /gta-vi/buy + /gta-online. nordLink() in affiliates.ts.", url: "https://affiliates.nordvpn.com" },
              { name: "NordPass", rate: "~$15 CPS", note: "offer_id=488, url_id=9356. Tiles live on /gta-vi/buy + /gta-online. nordPassLink() in affiliates.ts.", url: "https://affiliates.nordvpn.com" },
              { name: "ZAP-Hosting", rate: "50% + 10% renewal", note: "FiveM server affiliate. Tile live on /gta-online.", url: "https://zap-hosting.com" },
              { name: "FlexOffers", rate: "varies", note: "Application denied Jun 2026. fo-verify tag removed.", url: "https://www.flexoffers.com" },
            ],
          },
          {
            tier: "Priority — Apply Now",
            color: "var(--c-brand)",
            partners: [
              { name: "CDKeys", rate: "5–8%", note: "Best margin on digital codes. GTA VI key will be a top seller. Apply 3–6 months before launch.", url: "https://www.cdkeys.com/affiliates" },
              { name: "Eneba", rate: "5–8%", note: "EU-strong digital marketplace. Strong for GTA VI pre-orders in UK/DE/FR markets.", url: "https://www.eneba.com/affiliate" },
              { name: "Fanatical", rate: "5–8%", note: "PC game keys. Lower GTA VI volume but good for franchise back-catalogue promos.", url: "https://www.fanatical.com/en/affiliate" },
            ],
          },
          {
            tier: "Activate at Launch",
            color: "var(--c-economy)",
            partners: [
              { name: "Shark Card affiliate (T2)", rate: "TBC", note: "No public programme yet. Monitor Take-Two IR announcements — they ran one for GTA Online 2013–2014.", url: "https://ir.take2games.com" },
              { name: "GreenMan Gaming", rate: "5%", note: "Application denied Jun 2026.", url: "https://www.greenmangaming.com/affiliates" },
              { name: "PlayStation Direct", rate: "TBC", note: "Partnerize — pending approval. Wire PS5 pre-order links on /buy when approved.", url: "https://www.partnerize.com" },
            ],
          },
        ].map(block => (
          <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
            <div class="px-4 py-2.5 border-b border-border-dim">
              <span class="text-[11px] font-semibold" style={`color:${block.color}`}>{block.tier}</span>
            </div>
            <div class="divide-y divide-border-dim/40">
              {block.partners.map((p: any) => (
                <div class="px-4 py-3">
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-[12px] font-semibold text-zinc-200">{p.name}</span>
                    <span class="text-[11px] font-mono text-gta-gold/80">{p.rate}</span>
                  </div>
                  <p class="text-[11px] text-zinc-500 mb-1.5">{p.note}</p>
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-[10px] font-mono text-zinc-600 hover:text-zinc-300 transition-colors">{p.url} ↗</a>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Affiliate page strategy -->
      <div class="rounded-xl border border-border-dim p-4" style="background:var(--c-card)">
        <div class="text-[11px] font-semibold text-zinc-300 mb-3">Placement Strategy — /buy page + inline CTAs</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            { where: "/buy page (primary)", when: "Live now", desc: "Central conversion page. Add CDKeys + Eneba links as 'Best price' options above Amazon. A/B test button copy: 'Best price' vs 'Pre-order now'." },
            { where: "Inline CTAs on /gta-vi/intel", when: "Launch", desc: "Below 'Launch Price $79.99' prediction card — 'Pre-order from $X → CDKeys'. Contextual placement converts at 3–5× vs footer links." },
          ].map(pl => (
            <div>
              <div class="text-[11px] font-semibold text-zinc-400 mb-1">{pl.where}</div>
              <div class="text-[10px] font-mono text-zinc-600 mb-1.5">{pl.when}</div>
              <p class="text-[11px] text-zinc-500 leading-relaxed">{pl.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         SECTION 3 — TRAFFIC PLAYBOOK
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-gta-vi-coral/40 shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// 03 — Traffic Playbook by Channel</span>
        <div class="flex-1 h-px bg-border-dim"></div>
      </div>

      <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <div class="overflow-x-auto">
          <table class="w-full text-[11px] font-mono">
            <thead>
              <tr class="border-b border-border-dim">
                <th class="text-left px-4 py-2.5 text-zinc-500 font-normal">Channel</th>
                <th class="text-left px-4 py-2.5 text-zinc-500 font-normal">Traffic potential</th>
                <th class="text-left px-4 py-2.5 text-zinc-500 font-normal">Content type</th>
                <th class="text-left px-4 py-2.5 text-zinc-500 font-normal">Cadence</th>
                <th class="text-left px-4 py-2.5 text-zinc-500 font-normal">Status</th>
              </tr>
            </thead>
            <tbody>
              {[
                { ch: "Organic Search (Google)", vol: "★★★★★", content: "Prediction pages · intel hub · economy explainers", cadence: "Evergreen", status: "active" },
                { ch: "Reddit r/GTA6", vol: "★★★★☆", content: "Weekly data drops · prediction write-ups", cadence: "Weekly Thurs · manual", status: "ready" },
                { ch: "X / Twitter", vol: "★★★☆☆", content: "Chart screenshots · prediction updates", cadence: "Tue 09:00 · Publer", status: "active" },
                { ch: "GTAForums", vol: "★★★★☆", content: "Data analysis posts · economy discussions", cadence: "Weekly Thu–Sun · manual", status: "ready" },
                { ch: "YouTube (embed)", vol: "★★★☆☆", content: "Data chart embeds on GTA YouTube videos via descriptions", cadence: "On new trailer", status: "pending" },
                { ch: "Discord communities", vol: "★★☆☆☆", content: "Bot digest · data alerts", cadence: "Daily 03:00 UTC · auto", status: "active" },
                { ch: "Instagram / TikTok", vol: "★★★☆☆", content: "Chart screenshot · caption · Stories", cadence: "Tue 09:00 · Publer", status: "active" },
              ].map(r => (
                <tr class="border-b border-border-dim/40 hover:bg-white/[0.02] transition-colors">
                  <td class="px-4 py-2.5 text-zinc-300">{r.ch}</td>
                  <td class="px-4 py-2.5 text-gta-gold/70">{r.vol}</td>
                  <td class="px-4 py-2.5 text-zinc-500">{r.content}</td>
                  <td class="px-4 py-2.5 text-zinc-500">{r.cadence}</td>
                  <td class="px-4 py-2.5">
                    <span class={`text-[10px] font-mono border px-1.5 py-0.5 rounded uppercase tracking-widest ${r.status === 'active' ? 'border-gta-green/40 bg-gta-green/20 text-gta-green' : r.status === 'ready' ? 'border-blue-500/30 bg-blue-500/10 text-blue-400' : r.status === 'configured' ? 'border-gta-gold/30 bg-gta-gold/10 text-gta-gold' : 'border-zinc-700 bg-zinc-800 text-zinc-500'}`}>
                      {r.status === 'ready' ? 'ready to post' : r.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Launch surge plan -->
      <div class="rounded-xl border border-gta-vi-coral/20 p-4 mt-4" style="background:color-mix(in srgb,var(--c-gta-vi-coral) 5%,var(--c-card))">
