---
/**
 * /admin/pills — Pill taxonomy inventory.
 * Internal design-system reference for semantic pills, local pill patterns,
 * representative HudIcon names, and current route examples.
 */
import Base from "../../layouts/Base.astro";
import Badge from "../../components/Badge.astro";
import GamePill from "../../components/GamePill.astro";
import HudIcon from "../../components/HudIcon.astro";

type PillKind = "game" | "badge" | "local";

interface PillRow {
  id: string;
  label: string;
  kind: PillKind;
  variant?: string;
  iconName: string;
  iconNote?: string;
  sampleUrl: string | null;
  sampleLabel?: string;
  usage: string;
}

interface PillCluster {
  title: string;
  note: string;
  rows: PillRow[];
}

const pillClusters: PillCluster[] = [
  {
    title: "Game identity",
    note: "Title identity pills used on cards, heroes, overlays and filters.",
    rows: [
      { id: "gta-vi", label: "GTA VI", kind: "game", variant: "gta-vi", iconName: "hub", sampleUrl: "/gta-vi", usage: "GamePill top-left identity on GTA VI cards and hero rows." },
      { id: "gta-online", label: "GTA Online", kind: "game", variant: "gta-online", iconName: "money", sampleUrl: "/gta-online", usage: "GamePill for GTA Online hub and chart teasers." },
      { id: "gta-v", label: "GTA V", kind: "game", variant: "gta-v", iconName: "car", sampleUrl: "/gta-v", usage: "GamePill on GTA V history cards and chart teasers." },
      { id: "franchise", label: "Franchise", kind: "game", variant: "franchise", iconName: "history", sampleUrl: "/franchise", usage: "Franchise-wide identity pill and chart taxonomy." },
      { id: "gta-sa", label: "GTA SA", kind: "game", variant: "gta-sa", iconName: "map-pin", sampleUrl: "/gta-sa/economy", usage: "Economy page identity pill." },
      { id: "gta-vc", label: "GTA VC", kind: "game", variant: "gta-vc", iconName: "map-pin", sampleUrl: "/gta-vc/economy", usage: "Economy page identity pill." },
      { id: "gta-iv", label: "GTA IV", kind: "game", variant: "gta-iv", iconName: "database", sampleUrl: "/gta-iv/economy", usage: "Economy page identity pill." },
      { id: "gta-iii", label: "GTA III", kind: "game", variant: "gta-iii", iconName: "database", sampleUrl: "/gta-iii/economy", usage: "Economy page identity pill." },
    ],
  },
  {
    title: "Confidence and intelligence",
    note: "Evidence quality pills used on predictions, income cards, polls and cast cards.",
    rows: [
      { id: "confirmed", label: "Confirmed", kind: "badge", variant: "confirmed", iconName: "star", sampleUrl: "/gta-vi/intel", usage: "Official/confirmed facts, cast and feature cards." },
      { id: "reported", label: "Reported", kind: "badge", variant: "reported", iconName: "news", sampleUrl: "/community/polls", usage: "Reported mechanics and externally sourced poll cards." },
      { id: "predicted", label: "Predicted", kind: "badge", variant: "predicted", iconName: "intel", sampleUrl: "/community/polls", usage: "Model-derived predictions and speculative polls." },
      { id: "indexed", label: "Indexed", kind: "badge", variant: "indexed", iconName: "database", sampleUrl: "/database", usage: "Database/indexed entity state; aliases to predicted visual treatment." },
    ],
  },
  {
    title: "Play and activity type",
    note: "Income source activity taxonomy. Some render as pills; some pages render the same semantics as inline labels.",
    rows: [
      { id: "active", label: "Active", kind: "badge", variant: "active", iconName: "mission", sampleUrl: "/database", usage: "Active grind income sources." },
      { id: "passive", label: "Passive", kind: "badge", variant: "passive", iconName: "passive", sampleUrl: "/database", usage: "Passive businesses and automated income." },
      { id: "semi-passive", label: "Semi-passive", kind: "badge", variant: "semi-passive", iconName: "cycle", sampleUrl: "/database", usage: "Setup-driven income with periodic collection." },
      { id: "hybrid", label: "Hybrid", kind: "badge", variant: "hybrid", iconName: "cycle", sampleUrl: "/database", usage: "Mixed active/passive loops." },
      { id: "heist", label: "Heist", kind: "badge", variant: "heist", iconName: "heist", sampleUrl: "/database", usage: "Heist-type income sources." },
      { id: "mission", label: "Mission", kind: "badge", variant: "mission", iconName: "mission", sampleUrl: "/database", usage: "Mission-type income sources." },
      { id: "mc", label: "MC Business", kind: "local", iconName: "briefcase", sampleUrl: "/database", usage: "Semantic play type from semanticTypes.ts; rendered as inline type context." },
      { id: "ceo", label: "CEO/VIP", kind: "local", iconName: "briefcase", sampleUrl: "/database", usage: "Semantic play type from semanticTypes.ts; rendered as inline type context." },
      { id: "contract", label: "Contract", kind: "badge", variant: "contract", iconName: "briefcase", sampleUrl: "/gta-online/cayo-perico", usage: "Contract-style earning loop." },
      { id: "business", label: "Business", kind: "badge", variant: "business", iconName: "briefcase", sampleUrl: "/gta-vi/intel#section-income-predictions", usage: "Business income prediction cards." },
    ],
  },
  {
    title: "Economy flow",
    note: "Circular economy labels for SED/flow concepts.",
    rows: [
      { id: "investment", label: "Investment", kind: "badge", variant: "investment", iconName: "investment", sampleUrl: "/gta-vi/economy", usage: "Capital spend returning to future income." },
      { id: "injection", label: "Injection", kind: "badge", variant: "injection", iconName: "injection", sampleUrl: "/gta-vi/economy", usage: "External money entering the GTA$ loop." },
      { id: "consumption", label: "Consumption", kind: "badge", variant: "consumption", iconName: "buy", sampleUrl: "/gta-vi/economy", usage: "Non-returning player spend." },
    ],
  },
  {
    title: "Chart categories",
    note: "Neutral category pills used in chart teasers and chart navigation.",
    rows: [
      { id: "economy-ig", label: "IG Economy", kind: "badge", variant: "economy-ig", iconName: "economy", sampleUrl: "/charts?title=gta-online", usage: "In-game economy chart category." },
      { id: "economy-rl", label: "RL Economy", kind: "badge", variant: "economy-rl", iconName: "chart", sampleUrl: "/franchise/economics", usage: "Real-world economy/franchise comparison category." },
      { id: "community", label: "Community", kind: "badge", variant: "community", iconName: "users", sampleUrl: "/community/polls", usage: "Community signal/poll grouping." },
      { id: "performance", label: "Performance", kind: "badge", variant: "performance", iconName: "trending", sampleUrl: "/database", usage: "Vehicle/performance chart category." },
      { id: "history", label: "History", kind: "badge", variant: "history", iconName: "history", sampleUrl: "/franchise", usage: "Historical franchise chart category." },
      { id: "promotions", label: "Promotions", kind: "badge", variant: "promotions", iconName: "tag", sampleUrl: "/gta-online", usage: "Weekly event and promotion chart/category context." },
    ],
  },
  {
    title: "Income tiers",
    note: "S-to-D payout/meta ranking pills.",
    rows: [
      { id: "s-plus", label: "S+", kind: "badge", variant: "s-plus", iconName: "money", sampleUrl: "/database", usage: "Best-in-class income source tier." },
      { id: "s-tier", label: "S", kind: "badge", variant: "s-tier", iconName: "money", sampleUrl: "/database", usage: "Top income source tier." },
      { id: "a-tier", label: "A", kind: "badge", variant: "a-tier", iconName: "money", sampleUrl: "/database", usage: "Strong income source tier." },
      { id: "b-tier", label: "B", kind: "badge", variant: "b-tier", iconName: "money", sampleUrl: "/database", usage: "Mid income source tier." },
      { id: "c-tier", label: "C", kind: "badge", variant: "c-tier", iconName: "money", sampleUrl: "/database", usage: "Lower income source tier." },
      { id: "d-tier", label: "D", kind: "badge", variant: "d-tier", iconName: "money", sampleUrl: "/database", usage: "Lowest income source tier." },
    ],
  },
  {
    title: "Status",
    note: "General status pills for official, alert, projected and regression states.",
    rows: [
      { id: "official", label: "Official", kind: "badge", variant: "official", iconName: "star", sampleUrl: "/news", usage: "Official Rockstar/Take-Two/SEC source tags." },
      { id: "alert", label: "Alert", kind: "badge", variant: "alert", iconName: "news", sampleUrl: "/news", usage: "Breaking or risk/alert status." },
      { id: "projected", label: "Projected", kind: "badge", variant: "projected", iconName: "trending", sampleUrl: "/gta-vi/economy", usage: "Pre-launch projected model state." },
      { id: "regression", label: "Regression", kind: "badge", variant: "regression", iconName: "trending", sampleUrl: null, sampleLabel: "Defined; no current page use found", usage: "Negative movement/regression status." },
    ],
  },
  {
    title: "Local UI/action pill patterns",
    note: "Pill-like controls or labels not backed by Badge.astro yet.",
    rows: [
      { id: "chart-category", label: "Chart category", kind: "local", iconName: "chart", sampleUrl: "/charts", usage: "ChartBadgeRow category pill next to GamePill." },
      { id: "section-pill-link", label: "Section link", kind: "local", iconName: "link", sampleUrl: "/gta-vi", usage: "SectionHeader top-right CTA pill." },
      { id: "card-footer-link", label: "Footer analysis link", kind: "local", iconName: "link", sampleUrl: "/gta-vi/intel", usage: "Card footer detail link where top-right is occupied." },
      { id: "community-vote", label: "Community Vote", kind: "local", iconName: "users", sampleUrl: "/community/polls", usage: "VoteCard poll-type pill." },
      { id: "cast-clip", label: "Clip", kind: "local", iconName: "trailer", sampleUrl: "/gta-vi/intel", usage: "CastCard video action pill." },
      { id: "share-trigger", label: "Share", kind: "local", iconName: "share-branch", sampleUrl: "/community/polls", usage: "ShareDropdown trigger pill/button." },
      { id: "staging", label: "staging", kind: "local", iconName: "hub", sampleUrl: "/admin", usage: "Ops bar environment badge." },
    ],
  },
];
---

<Base title="Admin — Pill Inventory" description="GTAVI.AI pill taxonomy, icon names, and usage routes." noindex>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-8">
    <div>
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">Admin · Design System</div>
      <h1 class="text-2xl font-bold text-white mb-1">Pill Inventory</h1>
      <p class="text-sm text-zinc-500 max-w-3xl leading-relaxed">
        Logic-clustered list of defined pills, representative HudIcon names, and current sample routes.
        Icon names are the admin reference icon paired with each pill taxonomy entry.
      </p>
    </div>

    {pillClusters.map((cluster) => (
      <section class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <div class="px-4 py-3 border-b border-border-dim">
          <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-widest">{cluster.title}</div>
          <p class="text-[11px] text-zinc-500 mt-1 leading-relaxed">{cluster.note}</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-[11px] font-mono">
            <thead>
              <tr class="border-b border-border-dim">
                <th class="px-4 py-2 text-zinc-500 font-normal uppercase tracking-widest">Pill</th>
                <th class="px-4 py-2 text-zinc-500 font-normal uppercase tracking-widest">Icon</th>
                <th class="px-4 py-2 text-zinc-500 font-normal uppercase tracking-widest">Icon name</th>
                <th class="px-4 py-2 text-zinc-500 font-normal uppercase tracking-widest">Current sample URL</th>
                <th class="px-4 py-2 text-zinc-500 font-normal uppercase tracking-widest">Usage</th>
              </tr>
            </thead>
            <tbody>
              {cluster.rows.map((row) => (
                <tr class="border-b border-border-dim last:border-b-0">
                  <td class="px-4 py-3 whitespace-nowrap">
                    {row.kind === "game" && row.variant ? (
                      <GamePill game={row.variant as any} size="xs" />
                    ) : row.kind === "badge" && row.variant ? (
                      <Badge variant={row.variant as any} size="xs" />
                    ) : (
                      <span class="inline-flex items-center border rounded font-mono uppercase tracking-widest text-[10px] px-1.5 py-0.5"
                        style="color:var(--c-text-4);border-color:var(--c-border-2);background:color-mix(in srgb,var(--c-text-4) 8%,transparent)">
                        {row.label}
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-3">
                    <span class="inline-flex items-center justify-center w-7 h-7 rounded border border-border-dim" style="color:var(--c-text-3);background:var(--c-bg-deep)">
                      <HudIcon name={row.iconName as any} size={14} />
                    </span>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <code class="text-zinc-300">{row.iconName}</code>
                    {row.iconNote && <span class="text-zinc-600"> · {row.iconNote}</span>}
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    {row.sampleUrl ? (
                      <a href={row.sampleUrl} class="text-gta-gold hover:text-zinc-200 transition-colors">{row.sampleUrl}</a>
                    ) : (
                      <span class="text-zinc-600">{row.sampleLabel ?? "Not currently rendered"}</span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-zinc-500 min-w-[18rem] leading-relaxed">{row.usage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>
</Base>
