---
// SEO landing page: /gta-v/income-calculator
// Target queries: "GTA Online income calculator", "best GTA money method for me", "GTA Online what to buy"
import Base from "../../layouts/Base.astro";
import IncomeAdviser from "../../components/IncomeAdviser.astro";
import ShareDropdown from "../../components/ShareDropdown.astro";
import businessProfiles from "../../../data/gta-5/economy/business-profiles.json";
import weeklyBonuses    from "../../../data/gta-5/economy/weekly-bonuses.json";

const bizProfiles  = (businessProfiles as any).businesses as any[];
const bonuses      = (weeklyBonuses as any).bonuses as any[];
const weekStart    = (weeklyBonuses as any).week_start as string;
---

<Base
  titleContext="gta-v"
  title="GTA Online Income Calculator — Personalised Money Method Guide"
  description="Free GTA Online income calculator. Select what businesses you own, enter your budget — get your personalised $/hr total and the best next purchase ranked by ROI. Updated weekly with live bonus events."
  ogPage="gta-v"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-[10px] font-mono text-zinc-600 mb-6">
      <a href="/gta-v" class="hover:text-zinc-400 transition-colors">GTA V Data</a>
      <span>›</span>
      <span class="text-zinc-400">Income Calculator</span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3">
      GTA Online Income Calculator
    </h1>
    <p class="text-zinc-400 leading-relaxed mb-3 max-w-2xl">
      Not a generic tier list — a <strong class="text-zinc-200">personalised</strong> income stack based on what
      you actually own. Select your businesses, enter your budget, and get your current $/hr total
      with the best next purchase ranked by return on investment.
    </p>

    {bonuses.length > 0 && (
      <div class="flex items-center gap-2 mb-8 text-[10px] font-mono">
        <span class="text-gta-gold border border-gta-gold/25 bg-gta-gold/10 px-2 py-0.5 rounded uppercase tracking-widest">Week of {weekStart}</span>
        {bonuses.slice(0,3).map((b: any) => (
          <span class="text-zinc-500">{b.multiplier}× {b.keyword_found}</span>
        ))}
        <span class="text-zinc-500">— bonuses applied automatically ↓</span>
      </div>
    )}

    <IncomeAdviser businesses={bizProfiles} weeklyBonuses={bonuses} />

    <div class="mt-8 flex items-center justify-between flex-wrap gap-3">
      <a href="/gta-v" class="text-[10px] font-mono text-gta-gold/70 hover:text-gta-gold border border-gta-gold/20 hover:border-gta-gold/40 px-4 py-2 rounded transition-colors uppercase tracking-widest">
        ← Full GTA V Economics
      </a>
      <a href="/database" class="text-[10px] font-mono text-zinc-500 hover:text-zinc-300 border border-border-mid hover:border-zinc-600 px-4 py-2 rounded transition-colors uppercase tracking-widest">
        Database: All Business Profiles →
      </a>
    </div>

  </div>
</Base>
