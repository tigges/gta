---
/**
 * /gta-v/online/[id] — Per-card share page for GTA Online businesses
 *
 * Each business gets a unique URL with its own OG image, title and
 * description. Used as the share target from ProfitCard ShareButton.
 *
 * Behaviour:
 * - On direct visit: renders a full-page card with meta redirect
 * - JavaScript redirects immediately to /database?game=gta-online#profit-{id}
 * - Without JS: meta refresh handles it after 0s
 * - OG crawlers (Discord, Twitter) see card-specific meta tags + image
 */

import Base from "../../../layouts/Base.astro";

import bizProfilesRaw from "../../../../data/gta-5/economy/business-profiles.json";
import revTiersRaw    from "../../../../data/gta-5/economy/revenue-tiers.json";

export function getStaticPaths() {
  const profiles = (bizProfilesRaw as any).businesses as any[];
  return profiles
    .filter((b: any) => b.net_profit_per_hr > 0)
    .map((b: any) => ({ params: { id: b.id } }));
}

const bizProfiles = (bizProfilesRaw as any).businesses as any[];
const tiers       = (revTiersRaw as any).tiers as any[];

const TIER_MAP: Record<string, { tier: string; color: string }> = {};
tiers.forEach((t: any) => {
  t.sources.forEach((s: any) => { TIER_MAP[s.id] = { tier: t.tier, color: t.color }; });
});

const { id } = Astro.params;
const biz     = bizProfiles.find((b: any) => b.id === id);

if (!biz) return Astro.redirect("/database?game=gta-online");

const tierInfo  = TIER_MAP[id!] ?? { tier: "B", color: "#0d9488" };
const khr       = Math.round(biz.net_profit_per_hr / 1000);
const solo      = biz.solo ? " · solo" : "";
const deepLink  = `/database?game=gta-online#profit-${id}`;

const ogTitle   = `${biz.name} — ${tierInfo.tier}-tier · $${khr}K/hr${solo}`;
const ogDesc    = `${biz.name} full profile: $/hr, setup cost, tips, loot tiers, patch history. GTA Online economic intelligence.${biz.solo ? " Fully solo-capable." : ""}`;
const ogImage   = `/og/online/${id}.png`;
---

<Base
  title={ogTitle}
  description={ogDesc}
  ogImage={`https://gtavi.ai${ogImage}`}
>
  <!-- Immediate JS redirect — OG crawlers won't execute this -->
  <script define:vars={{ deepLink }}>
    window.location.replace(deepLink);
  </script>

  <!-- Meta refresh fallback for no-JS environments -->
  <meta http-equiv="refresh" content={`0; url=${deepLink}`} />

  <!-- Graceful fallback content (visible briefly before redirect) -->
  <div class="min-h-screen flex items-center justify-center px-4" style="background:#0e0e11">
    <div class="text-center max-w-md">
      <div class="font-mono font-black text-4xl mb-2" style={`color:${tierInfo.color}`}>{tierInfo.tier}</div>
      <h1 class="text-2xl font-bold text-white mb-2" style="font-family:'Inter',sans-serif">{biz.name}</h1>
      <div class="text-3xl font-mono font-black mb-4" style={`color:${tierInfo.color}`}>
        ${khr}K<span class="text-base font-normal text-zinc-500">/hr</span>
      </div>
      <p class="text-zinc-500 text-sm mb-6" style="font-family:'Inter',sans-serif">Redirecting to full profile…</p>
      <a href={deepLink}
        class="inline-block px-6 py-2.5 rounded border border-[#2a2a31] text-zinc-300 text-sm font-mono hover:border-zinc-500 transition-colors">
        View full profile →
      </a>
    </div>
  </div>
</Base>
