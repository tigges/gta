---
// SEO landing page: /gta-online/assassination-guide
// Target queries: "GTA 5 assassination missions stocks", "GTA V stock market guide", "Lester missions $2 billion"
import Base from "../../layouts/Base.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import StockCalculator from "../../components/StockCalculator.astro";
import ShareDropdown from "../../components/ShareDropdown.astro";
import stocksData from "../../../data/gta-5/economy/assassination-stocks.json";
---

<Base
  titleContext="gta-online"
  title="GTA V Assassination Stock Market Guide — $2B Strategy"
  description="The complete GTA V Lester assassination missions stock guide. 5 missions, optimal order, buy/sell windows visualised. Interactive portfolio calculator shows your projected $2B+ total."
  ogPage="gta-v"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-[10px] font-mono text-zinc-600 mb-6">
      <a href="/gta-online" class="hover:text-zinc-400 transition-colors">GTA Online</a>
      <span>›</span>
      <a href="/gta-online/income" class="hover:text-zinc-400 transition-colors">Income Sources</a>
      <span>›</span>
      <span class="text-zinc-400">Assassination Stock Guide</span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3">
      GTA V Stock Market Guide — The $2 Billion Strategy
    </h1>
    <p class="text-zinc-400 leading-relaxed mb-8 max-w-2xl">
      Lester's 5 assassination missions are the only way to make serious money in GTA V Story Mode.
      Done in the right order, with the right stocks, your $41.6M Big Score becomes
      <strong class="text-gta-gold">$2 billion+</strong> across all three characters.
      Use the calculator below to project your exact total.
    </p>

    <!-- Key rule -->
    <div class="rounded-xl border border-gta-teal/20 bg-gta-teal/5 px-5 py-4 mb-8 flex items-start gap-3">
      <span class="text-gta-teal text-lg shrink-0">⚠</span>
      <div>
        <div class="font-semibold text-gta-teal text-sm mb-1">Critical Rule — Order Matters</div>
        <p class="text-[11px] text-zinc-400 leading-relaxed">
          Do Hotel Assassination <strong class="text-zinc-200">first</strong> (it's forced early in the story).
          Do all other 4 missions <strong class="text-zinc-200">after</strong> The Big Score so you can invest
          your maximum combined fortune. Reinvest between each mission.
        </p>
      </div>
    </div>

    <!-- The calculator -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-zinc-200 mb-5">Interactive Portfolio Calculator</h2>
      <StockCalculator steps={(stocksData as any).guide_order} />
    </section>

    <!-- Quick reference table -->
    <section class="mb-8">
      <h2 class="text-xl font-bold text-zinc-200 mb-4">Quick Reference — All 5 Missions</h2>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <table class="w-full text-xs font-mono">
          <thead><tr class="border-b border-[#1e1e23]">
            <th class="text-left px-5 py-2.5 text-zinc-600 font-normal">#</th>
            <th class="text-left px-4 py-2.5 text-zinc-600 font-normal">Mission</th>
            <th class="text-left px-4 py-2.5 text-zinc-600 font-normal">Buy → Sell</th>
            <th class="text-right px-5 py-2.5 text-zinc-600 font-normal">Combined Return</th>
          </tr></thead>
          <tbody>
            {(stocksData as any).guide_order.map((step: any) => {
              const buyStep = step.strategy?.find((s: any) => s.action === 'buy');
              const sellStep = step.strategy?.find((s: any) => s.expected_return_pct);
              const pct = step.combined_return_pct;
              const color = pct >= 300 ? '#22c55e' : pct >= 100 ? '#f59e0b' : '#0d9488';
              return (
                <tr class="border-b border-[#1e1e23]/50 hover:bg-white/2 transition-colors">
                  <td class="px-5 py-2.5 text-zinc-600">{step.step}</td>
                  <td class="px-4 py-2.5 font-semibold text-zinc-200">{step.title}</td>
                  <td class="px-4 py-2.5 text-zinc-500">{buyStep?.ticker} ({buyStep?.exchange}) → {sellStep?.ticker || buyStep?.ticker}</td>
                  <td class="px-5 py-2.5 text-right font-bold" style={`color:${color}`}>+{pct}%</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between">
          <span class="text-[10px] text-zinc-500 font-mono">Source: GTA Wiki · GTAForums community guides · LCN/BAWSAQ exchange data</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[11px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareDropdown anchorId="assassination-guide" shareText="GTA V assassination missions: Multi-Target + Redwood Cigarettes = +300% return. The interactive $2B calculator at GTAVI.AI." size="sm" /></div>
        </div>
      </div>
    </section>

    <CrossLinks context="gta-online-seo" />

    <div class="flex items-center justify-between flex-wrap gap-3">
      <a href="/gta-online/income" class="text-[10px] font-mono text-gta-gold/70 hover:text-gta-gold border border-gta-gold/20 hover:border-gta-gold/40 px-4 py-2 rounded transition-colors uppercase tracking-widest">
        ← GTA Online Income Sources
      </a>
      <a href="/gta-online/cayo-perico" class="text-[10px] font-mono text-zinc-500 hover:text-zinc-300 border border-[#2a2a31] hover:border-zinc-600 px-4 py-2 rounded transition-colors uppercase tracking-widest">
        Online: Cayo Perico Guide →
      </a>
    </div>

  </div>
</Base>
