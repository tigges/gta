---
import Base from "../../layouts/Base.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import ShareButton from "../../components/ShareButton.astro";
import IncomeAdviser from "../../components/IncomeAdviser.astro";
import SocialClubConnector from "../../components/SocialClubConnector.astro";

import onlineMissions    from "../../../data/gta-5/missions/online-top.json";
import businessProfiles  from "../../../data/gta-5/economy/business-profiles.json";
import onlineHeists      from "../../../data/gta-5/economy/online-heists.json";
import revenueTiers      from "../../../data/gta-5/economy/revenue-tiers.json";
import metaHistory       from "../../../data/gta-5/economy/meta-history.json";
import weeklyBonuses     from "../../../data/gta-5/economy/weekly-bonuses.json";

const topOnline       = (onlineMissions as any).missions as any[];
const bizProfiles     = (businessProfiles as any).businesses as any[];
const onlineHeistList = (onlineHeists as any).heists as any[];
const revTiers        = (revenueTiers as any).tiers as any[];
const starterPath     = (revenueTiers as any).optimal_starter_path as any[];
const maxBizProfitHr  = Math.max(...bizProfiles.map((b: any) => b.net_profit_per_hr));

const PLAY_COLOR: Record<string, string> = {
  active: "#ef4444", "semi-passive": "#f59e0b", passive: "#22c55e", heist: "#818cf8",
};

const totalSources = revTiers.reduce((s: number, t: any) => s + t.sources.length, 0);

// IDs that have a generated /gta-online/income/{id} page
const bizIds   = new Set(bizProfiles.filter((b: any) => b.net_profit_per_hr > 0).map((b: any) => b.id));
const heistIds = new Set((onlineHeistList as any[]).map((h: any) => h.id));
const validPageIds = new Set([...bizIds, ...heistIds, 'full-meta-stack']);
---

<Base
  title="GTA Online Income Sources"
  description="Every GTA Online income source ranked S→C tier by GTA$/hr. Income adviser, contact missions, heist payouts, business ROI, and the optimal path from zero to $500k+/hr."
  ogPage="charts"
>
  <!-- Hero -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden" style="min-height:280px">
    <div class="absolute inset-0"
         style="background:radial-gradient(ellipse at 20% 60%, rgba(34,197,94,0.08) 0%, transparent 55%), #0a0a0d"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-center gap-2 mb-4">
        <img src="/assets/logos/gta-online.svg" alt="GTA Online" class="h-12 w-auto" loading="eager" />
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4" style="font-family:'Inter',sans-serif">
        Income Sources
      </h1>
      <p class="text-zinc-400 text-sm leading-relaxed mb-6 max-w-lg" style="font-family:'Inter',sans-serif">
        {totalSources} income methods ranked by net GTA$/hr. Solo grind, heists, passive businesses — the complete economic picture.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl">
        {[
          { value: `${totalSources}`,        label: "income sources",   sub: "ranked S→C tier" },
          { value: "$340k",                  label: "top solo method",  sub: "Cayo Perico/hr" },
          { value: "$1.24M",                 label: "passive stack",    sub: "full AFK income" },
          { value: `${starterPath.length}`,  label: "step guide",       sub: "zero → $500k+/hr" },
        ].map(s => (
          <div class="rounded-xl border border-[#1e1e23] px-4 py-3" style="background:#131316">
            <div class="text-xl font-mono font-bold text-gta-bright">{s.value}</div>
            <div class="text-[11px] text-zinc-500 mt-0.5" style="font-family:'Inter',sans-serif">{s.label}</div>
            <div class="text-[10px] font-mono text-zinc-700 mt-0.5">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">

    <!-- ═══════════════════════════════════════════════════════
         INCOME STACK ADVISER
    ═══════════════════════════════════════════════════════ -->
    <section id="income-adviser">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[9px] font-mono bg-teal-900/30 text-teal-400 border border-teal-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Adviser</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Personalised Income Stack Builder</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">select what you own → get your $/hr + next best purchase</span>
      </div>
      <IncomeAdviser
        businesses={bizProfiles}
        weeklyBonuses={(weeklyBonuses as any).bonuses ?? []}
        weeklySales={(weeklyBonuses as any).sales ?? []}
      />
    </section>

    <!-- ═══════════════════════════════════════════════════════
         REVENUE TIER CHART
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[9px] font-mono bg-amber-900/30 text-amber-500 border border-amber-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Economy</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA Online Income Tiers — Every Revenue Source Ranked</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{totalSources} income sources</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23] flex items-start justify-between flex-wrap gap-3">
          <div>
            <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">Every GTA Online Income Source — S to C Tier by GTA$/hr</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Net profit per hour after costs. S = meta; A = reliable grind; B = situational; C = Nightclub support only.</div>
          </div>
          <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-500">
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>Passive</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-gta-gold inline-block"></span>Semi-passive</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-red-500 inline-block"></span>Active</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-indigo-400 inline-block"></span>Heist</span>
          </div>
        </div>
        <div class="divide-y divide-[#1e1e23]">
          {revTiers.map((tier: any) => (
            <div class="px-5 py-4">
              <div class="flex items-center gap-3 mb-3">
                <span class="font-mono font-black text-2xl" style={`color:${tier.color}`}>{tier.tier}</span>
                <span class="text-[10px] font-mono text-zinc-500">{tier.label}</span>
              </div>
              <div class="flex flex-col gap-2">
                {tier.sources.map((s: any) => {
                  const barPct = Math.round((s.gta_per_hr / maxBizProfitHr) * 100);
                  const typeColor = PLAY_COLOR[s.type] ?? "#71717a";
                  const hasPage = validPageIds.has(s.id);
                  const rowClasses = "flex items-center gap-3 transition-opacity" + (hasPage ? " hover:opacity-80 group" : " opacity-60");
                  return hasPage ? (
                    <a href={`/gta-online/income/${s.id}`} class={rowClasses}>
                      <div class="w-52 shrink-0">
                        <div class="text-[11px] font-mono text-zinc-300 truncate group-hover:text-white transition-colors">{s.name}</div>
                        <div class="text-[9px] font-mono text-zinc-600">{s.solo ? "Solo" : "2+ players"} · Setup: {s.setup_gta > 0 ? `$${(s.setup_gta/1_000_000).toFixed(1)}M` : "Free"}</div>
                      </div>
                      <div class="flex-1 flex items-center gap-2">
                        <div class="flex-1 h-2 rounded-full bg-[#1e1e23] overflow-hidden">
                          <div class="h-full rounded-full" style={`width:${barPct}%;background:${typeColor};opacity:0.85`}></div>
                        </div>
                        <span class="text-[11px] font-mono font-bold shrink-0 w-20 text-right" style={`color:${typeColor}`}>${(s.gta_per_hr/1000).toFixed(0)}k/hr</span>
                      </div>
                      <span class="text-zinc-700 group-hover:text-zinc-400 text-[10px] font-mono shrink-0">→</span>
                    </a>
                  ) : (
                    <div class={rowClasses}>
                      <div class="w-52 shrink-0">
                        <div class="text-[11px] font-mono text-zinc-500 truncate">{s.name}</div>
                        <div class="text-[9px] font-mono text-zinc-700">{s.solo ? "Solo" : "2+ players"} · Setup: {s.setup_gta > 0 ? `$${(s.setup_gta/1_000_000).toFixed(1)}M` : "Free"}</div>
                      </div>
                      <div class="flex-1 flex items-center gap-2">
                        <div class="flex-1 h-2 rounded-full bg-[#1e1e23] overflow-hidden">
                          <div class="h-full rounded-full" style={`width:${barPct}%;background:${typeColor};opacity:0.5`}></div>
                        </div>
                        <span class="text-[11px] font-mono font-bold shrink-0 w-20 text-right" style={`color:${typeColor};opacity:0.5`}>${(s.gta_per_hr/1000).toFixed(0)}k/hr</span>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Source: GTABase.com · community benchmarks · net after costs · 2024 patches</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA Online income ranked S→C tier. Cayo Perico ($340k/hr) and Acid Lab ($290k/hr) are the clear S-tier meta. Full breakdown." url="https://gtavi.ai/gta-online/income" size="sm" label="Share" /></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         OPTIMAL STARTER PATH
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[9px] font-mono bg-teal-900/30 text-teal-400 border border-teal-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Guide</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Optimal Path to $500k+/hr — Step by Step</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{starterPath.length} steps · new character → $500k/hr</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">From New Character to Maximum Efficiency — The Optimal Route</div>
          <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Total investment: ~$14M GTA. Achievable in 40-60 hours from zero.</div>
        </div>
        <div class="relative p-5">
          <div class="absolute left-[4.5rem] top-5 bottom-5 w-px bg-[#1e1e23]"></div>
          <div class="flex flex-col gap-0">
            {starterPath.map((step: any, i: number) => (
              <div class="relative flex items-start gap-4 pb-6 last:pb-0">
                <div class="w-14 shrink-0 text-right pt-0.5">
                  <span class="text-[11px] font-mono font-bold text-gta-gold">0{step.step}</span>
                </div>
                <div class="relative z-10 mt-1 shrink-0">
                  <div class={`w-2.5 h-2.5 rounded-full border ${step.cost === 0 ? "border-gta-teal bg-gta-teal/20" : "border-gta-gold bg-gta-gold/20"}`}></div>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-semibold text-zinc-200 mb-0.5" style="font-family:'Inter',sans-serif">{step.action}</div>
                  <div class="text-[10px] font-mono text-zinc-500">Unlocks: <span class="text-zinc-400">{step.unlocks}</span></div>
                  {step.cost > 0 && <div class="text-[10px] font-mono text-gta-gold mt-0.5">Cost: ${(step.cost/1_000_000).toFixed(2)}M</div>}
                  {step.cost === 0 && <div class="text-[10px] font-mono text-gta-teal mt-0.5">Free</div>}
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Community-verified optimal path · 2024 patches</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="Optimal GTA Online income path: First Dose (free) → Acid Lab → Kosatka → Nightclub → Bunker → Cocaine. Result: $500k+/hr combined passive+active." url="https://gtavi.ai/gta-online/income" size="sm" label="Share" /></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         BUSINESS PROFILES — ROI BREAKDOWN
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[9px] font-mono bg-amber-900/30 text-amber-500 border border-amber-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Economy</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Business Profiles — Setup Cost, ROI &amp; Break-Even</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{bizProfiles.length} businesses profiled</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">Total Investment vs Return — When Does Each Business Pay Off?</div>
          <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Setup cost (fully upgraded) · net $/hr after resupply · hours to break even</div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-xs font-mono">
            <thead>
              <tr class="border-b border-[#1e1e23]">
                <th class="text-left px-5 py-2.5 text-zinc-600 font-normal">Business</th>
                <th class="text-left px-3 py-2.5 text-zinc-600 font-normal">Type</th>
                <th class="text-right px-3 py-2.5 text-zinc-600 font-normal">Setup Cost</th>
                <th class="text-right px-3 py-2.5 text-zinc-600 font-normal">Net $/hr</th>
                <th class="text-right px-3 py-2.5 text-zinc-600 font-normal">Break-even</th>
                <th class="text-right px-5 py-2.5 text-zinc-600 font-normal">Solo</th>
              </tr>
            </thead>
            <tbody>
              {bizProfiles.sort((a: any, b: any) => b.net_profit_per_hr - a.net_profit_per_hr).map((b: any) => {
                const typeColor = PLAY_COLOR[b.play_type] ?? "#71717a";
                const breakEvenHrs = b.setup_cost_full > 0 ? Math.round(b.setup_cost_full / b.net_profit_per_hr) : 0;
                return (
                  <tr class="border-b border-[#1e1e23]/50 hover:bg-white/2 transition-colors">
                    <td class="px-5 py-3">
                      <a href={`/gta-online/income/${b.id}`} class="font-semibold text-zinc-200 hover:text-white transition-colors">{b.name}</a>
                      <div class="text-[9px] text-zinc-600 mt-0.5">{b.dlc?.split(" (")[0]}</div>
                    </td>
                    <td class="px-3 py-3">
                      <span class="text-[9px] font-mono px-1.5 py-0.5 rounded" style={`color:${typeColor};background:${typeColor}18;border:1px solid ${typeColor}30`}>
                        {b.play_type}
                      </span>
                    </td>
                    <td class="px-3 py-3 text-right text-zinc-400">${(b.setup_cost_full/1_000_000).toFixed(2)}M</td>
                    <td class="px-3 py-3 text-right font-bold" style={`color:${typeColor}`}>${(b.net_profit_per_hr/1000).toFixed(0)}k</td>
                    <td class="px-3 py-3 text-right text-zinc-500">{breakEvenHrs > 0 ? `${breakEvenHrs}h` : "—"}</td>
                    <td class="px-5 py-3 text-right">
                      <span class={b.solo ? "text-gta-teal" : "text-zinc-700"}>{b.solo ? "✓" : "×"}</span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Source: GTA Wiki · GTABase.com · community benchmarks · 2024 patches</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA Online business ROI: Acid Lab breaks even in 10hrs at $290k/hr. Nightclub takes 50hrs but earns passively. Full setup cost vs return breakdown." url="https://gtavi.ai/gta-online/income" size="sm" label="Share" /></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         ONLINE HEISTS
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[9px] font-mono bg-indigo-900/30 text-indigo-400 border border-indigo-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Heists</span>
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// GTA Online Heists — Payout &amp; Optimal Strategy</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-700">{onlineHeistList.length} heists · ranked by $/hr</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-4 border-b border-[#1e1e23]">
          <div class="font-semibold text-zinc-200 text-sm" style="font-family:'Inter',sans-serif">Online Heist Payouts — Player Cut, Run Time &amp; Efficiency</div>
          <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Hard difficulty, 2-player split unless noted. Includes Elite bonus where applicable.</div>
        </div>
        <div class="divide-y divide-[#1e1e23]">
          {onlineHeistList.sort((a: any, b: any) => b.gta_per_hr - a.gta_per_hr).map((h: any) => (
            <div class="px-5 py-4 flex items-start gap-4 flex-wrap sm:flex-nowrap group hover:bg-white/2 transition-colors">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <a href={`/gta-online/income/${h.id}`} class="font-semibold text-zinc-200 text-sm hover:text-white transition-colors" style="font-family:'Inter',sans-serif">{h.title}</a>
                  {h.solo && <span class="text-[8px] font-mono bg-gta-teal/10 text-gta-teal border border-gta-teal/20 px-1.5 py-0.5 rounded uppercase tracking-widest">Solo</span>}
                  <span class="text-[8px] font-mono bg-zinc-800/60 text-zinc-500 border border-zinc-700 px-1.5 py-0.5 rounded uppercase tracking-widest">{h.min_players}–{h.max_players}p</span>
                </div>
                <div class="text-[10px] font-mono text-zinc-600">{h.dlc}</div>
                {h.notes && <div class="text-[10px] text-zinc-500 mt-1.5 leading-snug max-w-lg" style="font-family:'Inter',sans-serif">{h.notes}</div>}
                {h.vault_contents && (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {h.vault_contents.map((v: any) => (
                      <span class="text-[9px] font-mono border border-[#2a2a31] text-zinc-500 px-2 py-0.5 rounded">
                        {v.type}: <span class="text-zinc-300">${(v.value/1_000_000).toFixed(2)}M</span>
                      </span>
                    ))}
                  </div>
                )}
                {h.loot_tiers && (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {h.loot_tiers.slice(0, 4).map((l: any) => (
                      <span class="text-[9px] font-mono border border-[#2a2a31] text-zinc-500 px-2 py-0.5 rounded">
                        {l.loot}: <span class="text-zinc-300">${(l.value/1_000_000).toFixed(2)}M</span>
                      </span>
                    ))}
                  </div>
                )}
              </div>
              <div class="flex items-center gap-6 shrink-0">
                <div class="text-right">
                  <div class="text-lg font-mono font-bold text-gta-gold">${(h.gta_per_hr/1000).toFixed(0)}k</div>
                  <div class="text-[9px] font-mono text-zinc-600">GTA$/hr</div>
                </div>
                <div class="text-right">
                  <div class="text-sm font-mono text-zinc-300">{h.avg_run_time_min}min</div>
                  <div class="text-[9px] font-mono text-zinc-600">avg run</div>
                </div>
                <div class="text-right">
                  <div class="text-sm font-mono text-zinc-400">${((h.player_cut_per_player ?? 0)/1000).toFixed(0)}k</div>
                  <div class="text-[9px] font-mono text-zinc-600">per player</div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-700 font-mono">Source: GTA Wiki (Fandom) · community records · Hard difficulty · 2024 patches</span>
          <div class="flex items-center gap-3 shrink-0"><span class="text-[9px] font-mono text-zinc-600 tracking-widest">GTAVI.AI</span><ShareButton text="GTA Online heists ranked by $/hr. Cayo Perico ($340k/hr solo) dominates. Diamond Casino Heist with Diamonds ($3.62M) is the best multi-player run." url="https://gtavi.ai/gta-online/income" size="sm" label="Share" /></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         TOP CONTACT MISSIONS $/HR
    ═══════════════════════════════════════════════════════ -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[9px] font-mono bg-green-900/30 text-green-500 border border-green-800/40 px-2 py-0.5 rounded uppercase tracking-widest">Missions</span>
