<script>
  import * as d3 from "d3";

  // ── Meta Shift History Chart ─────────────────────────────────
  (function() {
    const el = document.getElementById("meta-shift-chart");
    if (!el) return;
    const history: any[] = JSON.parse(el.dataset.history || "[]");
    const margin = { top:16, right:24, bottom:60, left:80 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;
    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);
    const dates = history.map((d:any) => new Date(d.date));
    const x = d3.scaleTime().domain([dates[0], dates[dates.length-1]]).range([0,W]);
    const y = d3.scaleLinear().domain([0, (d3.max(history,(d:any)=>d.top_gta_per_hr)??2000000)*1.1]).range([H,0]);
    svg.append("g").call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(()=>""))
      .call(g=>g.select(".domain").remove())
      .call(g=>g.selectAll(".tick line").attr("stroke","#1e1e23").attr("stroke-dasharray","3,3"));
    const defs = svg.append("defs");
    const grad = defs.append("linearGradient").attr("id","msh-grad").attr("gradientUnits","userSpaceOnUse").attr("x1",0).attr("y1",0).attr("x2",0).attr("y2",H);
    grad.append("stop").attr("offset","0%").attr("stop-color","#818cf8").attr("stop-opacity",0.2);
    grad.append("stop").attr("offset","100%").attr("stop-color","#818cf8").attr("stop-opacity",0.01);
    svg.append("path").datum(history).attr("fill","url(#msh-grad)")
      .attr("d",d3.area<any>().x((d:any)=>x(new Date(d.date))).y0(H).y1((d:any)=>y(d.top_gta_per_hr)).curve(d3.curveStepAfter));
    svg.append("path").datum(history).attr("fill","none").attr("stroke","#818cf8").attr("stroke-width",2)
      .attr("d",d3.line<any>().x((d:any)=>x(new Date(d.date))).y((d:any)=>y(d.top_gta_per_hr)).curve(d3.curveStepAfter));
    history.forEach((d:any) => {
      const cx = x(new Date(d.date)), cy = y(d.top_gta_per_hr);
      svg.append("circle").attr("cx",cx).attr("cy",cy).attr("r",4)
        .attr("fill","#818cf8").attr("stroke","#131316").attr("stroke-width",2);
      if (history.indexOf(d) % 2 === 0) {
        svg.append("text").attr("x",cx).attr("y",cy-8).attr("text-anchor","middle")
          .attr("fill","#9090a8").attr("font-size","8").attr("font-family","monospace")
          .text(d.patch.split(" ")[0].slice(0,10));
      }
    });
    svg.append("g").attr("transform",`translate(0,${H})`)
      .call(d3.axisBottom(x).ticks(6).tickFormat(d3.timeFormat("%Y") as any))
      .call(g=>g.select(".domain").attr("stroke","#2a2a31"))
      .call(g=>g.selectAll(".tick line").attr("stroke","#2a2a31"))
      .call(g=>g.selectAll("text").attr("fill","#52525b").attr("font-size","9").attr("font-family","monospace"));
    svg.append("g").call(d3.axisLeft(y).ticks(5).tickFormat((d:any)=>`$${Math.round(+d/1000)}k`))
      .call(g=>g.select(".domain").remove()).call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill","#52525b").attr("font-size","9").attr("font-family","monospace"));
    svg.append("text").attr("x",W-4).attr("y",H-6)
      .attr("text-anchor","end").attr("fill","#27272a").attr("font-size","8").attr("font-family","monospace").text("GTAVI.AI");
  })();
</script>
