---
/**
 * /gta-online/income — Income Adviser + Meta Shift History.
 * Page intentionally unlisted (no nav link). Access directly via URL.
 * Retained for the IncomeAdviser tool; meta chart gives historical context.
 * TODO: decide whether to promote as /advisor or fold into another page.
 */
import Base from "../../layouts/Base.astro";
import ShareDropdown from "../../components/ShareDropdown.astro";
import IncomeAdviser from "../../components/IncomeAdviser.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import SectionHeader from "../../components/SectionHeader.astro";

import type { BusinessProfiles, MetaHistoryData, WeeklyBonusesData } from "../../types/gta";

import businessProfiles from "../../../data/gta-5/economy/business-profiles.json";
import metaHistory      from "../../../data/gta-5/economy/meta-history.json";
import weeklyBonuses    from "../../../data/gta-5/economy/weekly-bonuses.json";

const bizData    = businessProfiles as unknown as BusinessProfiles;
const metaData   = metaHistory      as unknown as MetaHistoryData;
const bonusData  = weeklyBonuses    as unknown as WeeklyBonusesData;

const bizProfiles = bizData.businesses;
---

<Base
  titleContext="gta-online"
  title="GTA Online Income Adviser"
  description="Build your personalised GTA Online income stack — select what you own, get your current $/hr total and the best next purchase by ROI."
  ogPage="income-adviser"
>
  <!-- Minimal hero -->
  <section class="relative border-b border-border-dim overflow-hidden" style="min-height:160px">
    <div class="absolute inset-0"
         style="background:radial-gradient(ellipse at 20% 60%, color-mix(in srgb,var(--c-growth) 7%,transparent) 0%, transparent 55%), var(--c-bg-deep)"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-center gap-2 mb-3">
        <img src="/assets/logos/gta-online.svg" alt="GTA Online" class="h-10 w-auto" loading="eager" />
      </div>
      <h1 class="text-3xl font-bold text-white mb-2">Income Adviser</h1>
      <p class="text-zinc-400 text-sm max-w-lg">
        Select your businesses → see your current $/hr stack and the highest-ROI next purchase.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 flex flex-col gap-12">

    <!-- ═══════════════════════════════════════════════════════
         INCOME STACK ADVISER
    ═══════════════════════════════════════════════════════ -->
    <section id="income-adviser">
      <SectionHeader label="// Personalised Income Stack Builder" dotColor="var(--c-live)" pillHref="/database?game=gta-online" pillLabel="Full database →" class="mb-6" />
      <IncomeAdviser
        businesses={bizProfiles}
        weeklyBonuses={bonusData.bonuses ?? []}
        weeklySales={bonusData.sales ?? []}
      />
    </section>

    <!-- ═══════════════════════════════════════════════════════
         META SHIFT HISTORY
    ═══════════════════════════════════════════════════════ -->
    <section>
      <SectionHeader label="// $/hr Meta History — How the Top Earner Changed" dotColor="var(--c-economy)" class="mb-6" />
      <div class="rounded-xl border border-border-dim overflow-hidden" style="background:var(--c-card)">
        <div class="px-5 py-4 border-b border-border-dim">
          <div class="font-semibold text-zinc-200 text-sm">GTA Online Top Earner by DLC — The Economic History</div>
          <div class="text-[11px] text-zinc-500 font-mono mt-0.5">How $/hr for the #1 method changed with each major update. Cayo Perico was nerfed 40% in Jan 2022 — still stayed #1.</div>
        </div>
        <div id="meta-shift-chart" class="w-full" style="height:280px"
          data-history={JSON.stringify(metaData.meta_history)}
        ></div>
        <div class="px-5 py-3 border-t border-border-dim flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-500 font-mono">Source: GTAForums · community archives · manual research · patch notes</span>
          <div class="flex items-center gap-2 shrink-0">
            <span class="text-[10px] font-mono text-zinc-500 tracking-widest">GTAVI.AI</span>
            <ShareDropdown anchorId="meta-shift-chart" shareText="The history of GTA Online money: from $250K Contact Missions (2013) to $1.2M/hr Cayo Perico (2022+). Every meta shift charted. GTAVI.AI" size="sm" />
          </div>
        </div>
      </div>
    </section>

    <CrossLinks context="gta-online-income" />
  </div>
</Base>

<script>
  import * as d3 from "d3";

  (function() {
    const el = document.getElementById("meta-shift-chart");
    if (!el) return;
    const history: any[] = JSON.parse(el.dataset.history || "[]");
    const margin = { top:16, right:24, bottom:60, left:80 };
    const W = el.clientWidth - margin.left - margin.right;
    const H = el.clientHeight - margin.top - margin.bottom;
    const svg = d3.select(el).append("svg").attr("width","100%")
      .attr("viewBox",`0 0 ${el.clientWidth} ${el.clientHeight}`)
      .append("g").attr("transform",`translate(${margin.left},${margin.top})`);
    const dates = history.map((d:any) => new Date(d.date));
    const x = d3.scaleTime().domain([dates[0], dates[dates.length-1]]).range([0,W]);
    const y = d3.scaleLinear().domain([0, (d3.max(history,(d:any)=>d.top_gta_per_hr)??2000000)*1.1]).range([H,0]);
    svg.append("g").call(d3.axisLeft(y).ticks(5).tickSize(-W).tickFormat(()=>""))
      .call(g=>g.select(".domain").remove())
      .call(g=>g.selectAll(".tick line").attr("stroke","var(--c-border-1)").attr("stroke-dasharray","3,3"));
    const defs = svg.append("defs");
    const grad = defs.append("linearGradient").attr("id","msh-grad").attr("gradientUnits","userSpaceOnUse").attr("x1",0).attr("y1",0).attr("x2",0).attr("y2",H);
    const accentColor = getComputedStyle(document.documentElement).getPropertyValue("--c-economy").trim() || "#818cf8";
    grad.append("stop").attr("offset","0%").attr("stop-color",accentColor).attr("stop-opacity",0.2);
    grad.append("stop").attr("offset","100%").attr("stop-color",accentColor).attr("stop-opacity",0.01);
    svg.append("path").datum(history).attr("fill","url(#msh-grad)")
      .attr("d",d3.area<any>().x((d:any)=>x(new Date(d.date))).y0(H).y1((d:any)=>y(d.top_gta_per_hr)).curve(d3.curveStepAfter));
    svg.append("path").datum(history).attr("fill","none").attr("stroke",accentColor).attr("stroke-width",2)
      .attr("d",d3.line<any>().x((d:any)=>x(new Date(d.date))).y((d:any)=>y(d.top_gta_per_hr)).curve(d3.curveStepAfter));
    history.forEach((d:any) => {
      const cx = x(new Date(d.date)), cy = y(d.top_gta_per_hr);
      svg.append("circle").attr("cx",cx).attr("cy",cy).attr("r",4)
        .attr("fill",accentColor).attr("stroke","var(--c-card)").attr("stroke-width",2);
      if (history.indexOf(d) % 2 === 0) {
        svg.append("text").attr("x",cx).attr("y",cy-8).attr("text-anchor","middle")
          .attr("fill","var(--c-text-4)").attr("font-size","8").attr("font-family","monospace")
          .text(d.patch.split(" ")[0].slice(0,10));
      }
    });
    svg.append("g").attr("transform",`translate(0,${H})`)
      .call(d3.axisBottom(x).ticks(6).tickFormat(d3.timeFormat("%Y") as any))
      .call(g=>g.select(".domain").attr("stroke","var(--c-border-2)"))
      .call(g=>g.selectAll(".tick line").attr("stroke","var(--c-border-2)"))
      .call(g=>g.selectAll("text").attr("fill","var(--c-text-6)").attr("font-size","9").attr("font-family","monospace"));
    svg.append("g").call(d3.axisLeft(y).ticks(5).tickFormat((d:any)=>`$${Math.round(+d/1000)}k`))
      .call(g=>g.select(".domain").remove()).call(g=>g.selectAll(".tick line").remove())
      .call(g=>g.selectAll("text").attr("fill","var(--c-text-6)").attr("font-size","9").attr("font-family","monospace"));
    svg.append("text").attr("x",W-4).attr("y",H-6)
      .attr("text-anchor","end").attr("fill","var(--c-text-7)").attr("font-size","8").attr("font-family","monospace").text("GTAVI.AI");
  })();
</script>
