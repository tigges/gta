---
/**
 * /gta-online — GTA Online intelligence hub.
 * Stats strip · weekly bonuses · top income sources · economy model · charts
 */
import Base from "../../layouts/Base.astro";
import GamePill from "../../components/GamePill.astro";
import EconomyCircle from "../../components/EconomyCircle.astro";
import IncomeCard from "../../components/IncomeCard.astro";

import steamRaw       from "../../../data/gta-5/meta/steam-players.json";
import weeklyBonuses  from "../../../data/gta-5/economy/weekly-bonuses.json";
import businessProfs  from "../../../data/gta-5/economy/business-profiles.json";
import bonusHistRaw   from "../../../data/gta-5/economy/bonus-history.json";

// ── Stats ──────────────────────────────────────────────────────────────────
const steamData    = (steamRaw as any).data as { year: number; month: string; avg_players: number; peak_players: number }[];
const latestSteam  = steamData.at(-1);
const bonuses      = (weeklyBonuses as any).bonuses ?? [];
const weekStart    = (weeklyBonuses as any).week_start ?? "";
const historyCount = (bonusHistRaw as any).entry_count ?? 0;

// ── Top income sources ─────────────────────────────────────────────────────
const allBiz = ((businessProfs as any).businesses ?? []) as any[];
const topIncome = allBiz
  .filter((b: any) => b.net_profit_per_hr)
  .sort((a: any, b: any) => b.net_profit_per_hr - a.net_profit_per_hr)
  .slice(0, 4);

const THUMB: Record<string, string> = {
  "cayo-perico":            "/assets/gta5/dlc/cayo-perico.jpg",
  "kosatka-nightclub-stack":"/assets/gta5/dlc/after-hours.jpg",
  "diamond-casino-heist":   "/assets/gta5/dlc/diamond-casino-heist.jpg",
  "agency-vip-contract":    "/assets/gta5/dlc/agency.jpg",
};

const BONUS_LABEL: Record<string, string> = {
  "contact-missions": "Contact Missions",
  "casino-missions":  "Casino Work",
  "vip-work":         "VIP Work",
  "heists":           "Heists",
  "races":            "Races",
  "adversary":        "Adversary Modes",
  "survival":         "Survival",
  "stunt-races":      "Stunt Races",
};
---

<Base
  title="GTA Online"
  titleContext="gta-online"
  description="GTA Online economy intelligence — top income sources ranked, Shark Card inflation tracked, weekly bonuses live, and 10 years of economic data. Follow the GTA$."
>

  <!-- ── HERO ────────────────────────────────────────────────────────── -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden" style="min-height:280px;display:flex;align-items:flex-end">
    <div class="absolute inset-0">
      <img src="/assets/gta6/locations/Vice_City_03.jpg" alt=""
           class="w-full h-full object-cover" style="object-position:center 30%" aria-hidden="true" loading="eager" />
      <div class="absolute inset-0" style="background:linear-gradient(to right,var(--c-bg) 0%,rgba(14,14,17,0.8) 55%,rgba(14,14,17,0.35) 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,transparent 35%,var(--c-bg) 100%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pb-10 pt-20 w-full">
      <div class="flex items-center gap-2 mb-3">
        <GamePill game="gta-online" size="sm" />
        <span class="text-[11px] font-mono text-zinc-500 border border-[#2a2a31] px-2 py-0.5 rounded uppercase tracking-widest">Live since 2013</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">GTA Online</h1>
      <p class="text-zinc-400 text-sm leading-relaxed max-w-md">
        10 years of the live-service economy — ranked, tracked, and explained.
        Follow the GTA$ from mission payouts to Shark Card mechanics.
      </p>
    </div>
  </section>

  <!-- ── STATS STRIP ─────────────────────────────────────────────────── -->
  <section class="border-b border-[#1e1e23]" style="background:#0a0a0d">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-[#1e1e23]">
        <div class="px-5 py-4">
          <div class="text-xl font-mono font-bold" style="color:var(--c-title-online)">
            {latestSteam ? `${latestSteam.avg_players.toLocaleString()}` : "—"}
          </div>
          <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug">GTA V avg players · {latestSteam?.month} {latestSteam?.year}</div>
          <div class="text-[10px] font-mono text-zinc-600 mt-1">via SteamCharts</div>
        </div>
        <div class="px-5 py-4">
          <div class="text-xl font-mono font-bold" style="color:var(--c-brand)">
            {bonuses.length > 0 ? `${bonuses.length}× active` : "Check back Thu"}
          </div>
          <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug">2× bonus events · w/c {weekStart || "—"}</div>
          <div class="text-[10px] font-mono text-zinc-600 mt-1">via Rockstar Newswire</div>
        </div>
        <div class="px-5 py-4">
          <div class="text-xl font-mono font-bold" style="color:var(--c-growth)">$1.2M/hr</div>
          <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug">Cayo Perico Heist · top rate</div>
          <div class="text-[10px] font-mono text-zinc-600 mt-1">via GTAVI.AI income rank</div>
        </div>
        <div class="px-5 py-4">
          <div class="text-xl font-mono font-bold text-zinc-200">{historyCount}</div>
          <div class="text-[11px] text-zinc-500 mt-0.5 leading-snug">weeks of bonus history tracked</div>
          <div class="text-[10px] font-mono text-zinc-600 mt-1">since Oct 2013</div>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 flex flex-col gap-12">

    <!-- ── THIS WEEK'S BONUSES ──────────────────────────────────────── -->
    {bonuses.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-5">
          <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// This Week's Bonuses</span>
          <div class="flex-1 h-px bg-[#1e1e23]"></div>
          <a href="/gta-online/bonuses"
             class="shrink-0 text-[10px] font-mono text-zinc-500 hover:text-zinc-200 border border-[#2a2a31] hover:border-zinc-600 px-3 py-1 rounded transition-colors uppercase tracking-widest">
            Full calendar →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {bonuses.map((b: any) => (
            <div class="rounded-xl border border-[#1e1e23] px-4 py-3 flex items-center gap-3"
                 style="background:color-mix(in srgb,var(--c-brand) 5%,var(--c-card))">
              <span class="text-2xl font-mono font-black shrink-0" style="color:var(--c-brand)">{b.multiplier}×</span>
              <div>
                <div class="text-[11px] font-semibold text-zinc-200 capitalize">
                  {BONUS_LABEL[b.activity_id] ?? b.activity_id.replace(/-/g, " ")}
                </div>
                <div class="text-[10px] font-mono text-zinc-600 mt-0.5">via {b.source_title?.slice(0, 40) ?? "Rockstar Newswire"}</div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ── TOP INCOME SOURCES ───────────────────────────────────────── -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Top Income Sources — GTA$/hr</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/database?game=gta-online"
           class="shrink-0 text-[10px] font-mono text-zinc-500 hover:text-zinc-200 border border-[#2a2a31] hover:border-zinc-600 px-3 py-1 rounded transition-colors uppercase tracking-widest">
          Full database →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {topIncome.map((biz: any, i: number) => {
          const rankTier = i === 0 ? "S+" : i === 1 ? "S+" : i === 2 ? "S" : "A";
          return (
            <IncomeCard
              id={biz.id}
              name={biz.name}
              game="gta-online"
              category={biz.category ?? biz.play_type ?? "active"}
              tier={rankTier as any}
              net_profit_per_hr={biz.net_profit_per_hr}
              max_profit_per_hr={1200000}
              play_type={biz.play_type}
              solo={biz.solo ?? true}
              payout_per_run_max={biz.payout_per_run_max}
              thumbnail={THUMB[biz.id] ?? null}
              compact={true}
            />
          );
        })}
      </div>
    </section>

    <!-- ── ECONOMY MODEL ────────────────────────────────────────────── -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// The GTA Online Economy</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <a href="/gta-online/economy"
           class="shrink-0 text-[10px] font-mono text-zinc-500 hover:text-zinc-200 border border-[#2a2a31] hover:border-zinc-600 px-3 py-1 rounded transition-colors uppercase tracking-widest">
          Full model →
        </a>
      </div>
      <EconomyCircle fullEconomyHref="/gta-online/economy" />
    </section>

    <!-- ── EXPLORE ──────────────────────────────────────────────────── -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Explore the intelligence layer</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {[
          { href: "/database?game=gta-online",  label: "Income Database",    sub: "S→D tier · all methods · profit profiles",      color: "var(--c-live)"    },
          { href: "/gta-online/economy",         label: "Economy Model",      sub: "GTA-PPI · Shark Card inflation · passive stack", color: "var(--c-economy)" },
          { href: "/gta-online/bonuses",         label: "Bonuses & Events",   sub: "This week · sale calendar · bonus history",      color: "var(--c-brand)"   },
          { href: "/charts?title=gta-online",    label: "Charts",             sub: "Income leaderboard · meta · GTA-PPI",            color: "var(--c-text-4)"  },
        ].map(s => (
          <a href={s.href}
             class="group flex items-start gap-3 rounded-xl border border-[#1e1e23] hover:border-[#2a2a31] px-4 py-3.5 transition-colors"
             style="background:var(--c-card)">
            <div class="w-0.5 self-stretch rounded-full shrink-0" style={`background:${s.color}`}></div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-semibold text-zinc-200 group-hover:text-white transition-colors mb-0.5">{s.label}</div>
              <div class="text-[10px] font-mono text-zinc-500 leading-snug">{s.sub}</div>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</Base>
