---
import Base from "../../layouts/Base.astro";
import GamePill from "../../components/GamePill.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import ShareDropdown from "../../components/ShareDropdown.astro";
import CircularEconomy from "../../components/CircularEconomy.astro";
import CardFooter from "../../components/CardFooter.astro";

import type {
  GtaPpiData, MetaHistoryData, RevenueTiersData, SpendingDistributionData,
  SavingsProfileData, PassiveStackData, RevenueSplitData, PriceBasketData,
  WeeklyBonusesData, ItemCatalogueData,
} from "../../types/gta";

import ppiData          from "../../../data/gta-5/economy/gta-ppi.json";
import metaHistory      from "../../../data/gta-5/economy/meta-history.json";
import spendingData     from "../../../data/gta-5/economy/spending-distribution.json";
import savingsData      from "../../../data/gta-5/economy/savings-profile.json";
import passiveData      from "../../../data/gta-5/economy/passive-stack.json";
import revenueData      from "../../../data/franchise/revenue-split.json";
import revenueTiersData from "../../../data/gta-5/economy/revenue-tiers.json";
import priceBasket      from "../../../data/gta-5/economy/price-basket.json";
import weeklyBonuses    from "../../../data/gta-5/economy/weekly-bonuses.json";
import itemCatalogue    from "../../../data/gta-5/economy/item-catalogue.json";

const ppi       = ppiData       as unknown as GtaPpiData;
const meta      = metaHistory   as unknown as MetaHistoryData;
const spending  = spendingData  as unknown as SpendingDistributionData;
const savings   = savingsData   as unknown as SavingsProfileData;
const passive   = passiveData   as unknown as PassiveStackData;
const revenue   = revenueData   as unknown as RevenueSplitData;
const tiers     = revenueTiersData as unknown as RevenueTiersData;
const basket    = priceBasket   as unknown as PriceBasketData;
const bonuses   = weeklyBonuses as unknown as WeeklyBonusesData;
const catalogue = itemCatalogue as unknown as ItemCatalogueData;

const ppiSeries     = ppi.series;
const metaSeries    = meta.meta_history;

// Derive live top yield from revenue-tiers.json — same source as IncomeAdviser
// Extends the historical series with a live current endpoint automatically
const tierSources   = tiers.tiers.flatMap(t => t.sources);
const liveTopYield  = Math.max(...tierSources.map(s => s.gta_per_hr));
const liveTopName   = tierSources.find(s => s.gta_per_hr === liveTopYield)?.name ?? "Current meta stack";
const lastMeta      = [...metaSeries].sort((a, b) => a.date.localeCompare(b.date)).at(-1);
const today         = new Date().toISOString().slice(0,10);
// Append live data point if it differs from the last historical entry
const liveMetaSeries = lastMeta?.date === today
  ? metaSeries
  : [...metaSeries, { date: today, patch: "Current", top_method: liveTopName, top_gta_per_hr: liveTopYield, notes: "Live — from revenue-tiers.json" }];
const spendEras     = spending.eras;
const passiveSeries = passive.series;
const revYears      = revenue.years;
const basketItems   = basket.items;
const basketEras    = basket.era_prices;
const savingsStages = savings.stages;
const savingsRate   = savings.savings_rate_history;

// ── Weekly sales data ─────────────────────────────────────────────────────────
const weeklySales  = bonuses.sales ?? [];
const weekBonuses  = bonuses.bonuses ?? [];
const weekStart    = bonuses.week_start ?? "";
const hasSales     = weeklySales.length > 0;

// Build sale map: catalogue item_id → discount_pct
const saleDiscountMap: Record<string, number> = {};
weeklySales.forEach(s => {
  if (s.item_id) saleDiscountMap[s.item_id] = s.discount_pct;
});

// Live basket cost from catalogue + sale-adjusted basket cost
const catalogueBySlug: Record<string, number> = {};
catalogue.items.forEach(item => {
  if (item.price) catalogueBySlug[item.id] = item.price;
});

let liveBasketCost = 0;
let saleBasketCost = 0;
let liveComplete = true;
basketItems.forEach((item: any) => {
  const livePrice = catalogueBySlug[item.id] ?? item.current_price ?? null;
  if (!livePrice) { liveComplete = false; return; }
  liveBasketCost += livePrice;
  const discount = saleDiscountMap[item.id] ?? 0;
  saleBasketCost += livePrice * (1 - discount / 100);
});
if (!liveComplete) {
  // Fallback to seeded prices
  liveBasketCost = basketItems.reduce((s: number, i: any) => s + (i.current_price ?? 0), 0);
  saleBasketCost = basketItems.reduce((s: number, i: any) => {
    const d = saleDiscountMap[i.id] ?? 0;
    return s + (i.current_price ?? 0) * (1 - d / 100);
  }, 0);
}

const latestYieldValue = liveTopYield;  // from revenue-tiers.json (same as IncomeAdviser)
const livePPI   = Math.round((liveBasketCost / latestYieldValue) * 100) / 10;
const salePPI   = hasSales ? Math.round((saleBasketCost / latestYieldValue) * 100) / 10 : null;
const liveHours = Math.round(liveBasketCost / latestYieldValue * 10) / 10;
const saleHours = salePPI ? Math.round(saleBasketCost / latestYieldValue * 10) / 10 : null;

// ── Derived headline stats ──────────────────────────────────────────────────
const latestPPI     = ppiSeries.at(-1);
const peakPPI       = ppiSeries.reduce((a:any,b:any) => b.ppi > a.ppi ? b : a);
const troughPPI     = ppiSeries.reduce((a:any,b:any) => b.ppi < a.ppi ? b : a);
const latestYield   = { top_gta_per_hr: liveTopYield, top_method: liveTopName };
const latestRecurr  = revYears.filter((y:any) => y.recurrent_bn > 0).at(-1);
const passiveTotal  = passiveSeries.at(-1)?.total ?? 0;
---

<Base
  titleContext="gta-online"
  title="GTA Online Economy Model"
  description="A macroeconomic analysis of GTA Online's in-game circular economy — wages, spending, savings, Shark Card injections, and the GTA-PPI purchasing power index."
>

  <!-- ── Page header ──────────────────────────────────────── -->
  <section class="relative border-b border-border-dim overflow-hidden">
    <div class="absolute inset-0">
      <img src="/assets/gta5/dlc/diamond-casino-heist.jpg" alt="" class="w-full h-full object-cover" style="object-position:center 30%" aria-hidden="true" />
      <div class="absolute inset-0" style="background:linear-gradient(to right,var(--c-bg-deep) 0%,color-mix(in srgb,var(--c-bg-deep) 80%,transparent) 55%,color-mix(in srgb,var(--c-bg-deep) 53%,transparent) 100%)"></div>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,transparent 0%,var(--c-bg-deep) 100%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-start justify-between flex-wrap gap-6">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <GamePill game="gta-online" size="xs" />
            <span class="text-[10px] font-mono text-zinc-500 border border-border-mid px-2 py-0.5 rounded uppercase tracking-widest">Circular Flow · 3-Actor Model</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-black text-white leading-tight mb-1">
            GTA Online<br/>Economic Model
          </h1>
          <p class="text-sm text-zinc-400 max-w-sm mt-3">
            One chart per arrow in the circular flow. GTA Online data 2013–2025. Each chart tracks a single money flow between actors.
          </p>
        </div>
        <!-- Actor selector -->
        <div class="flex flex-col gap-2 shrink-0">
          <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-1">// ACTORS</div>
          <div class="flex items-stretch gap-1.5">
            <button id="actor-businesses" class="actor-btn flex flex-col items-center px-4 py-2.5 rounded-lg border border-gta-gold/50 bg-gta-gold/10 text-gta-gold transition-all" data-actor="businesses">
              <span class="text-[11px] font-black tracking-wider">BUSINESSES</span>
              <span class="text-[11px] font-mono text-gta-gold/60 mt-0.5">produce · contract</span>
              <div class="flex flex-col items-center gap-0.5 mt-2 text-[11px] font-mono">
                <span style="color:var(--c-income)">① Y · INCOME →</span>
                <span class="text-zinc-400">← SPENDING ②</span>
              </div>
            </button>
            <button id="actor-players" class="actor-btn flex flex-col items-center px-4 py-2.5 rounded-lg border border-border-mid text-zinc-400 transition-all hover:border-zinc-600" data-actor="players">
              <span class="text-[11px] font-black tracking-wider">PLAYERS</span>
              <span class="text-[11px] font-mono text-zinc-400 mt-0.5">earn · spend · save</span>
              <div class="flex flex-col items-center gap-0.5 mt-2 text-[11px] font-mono">
                <span class="text-zinc-500">③ SAVINGS →</span>
                <span class="text-zinc-500">← SHARK CARDS ④</span>
              </div>
            </button>
            <button id="actor-mazebank" class="actor-btn flex flex-col items-center px-4 py-2.5 rounded-lg border border-border-mid text-zinc-400 transition-all hover:border-zinc-600" data-actor="mazebank">
              <span class="text-[11px] font-black tracking-wider">MAZE BANK</span>
              <span class="text-[11px] font-mono text-zinc-400 mt-0.5">hold · (no real lend)</span>
              <div class="flex flex-col items-center gap-0.5 mt-2 text-[11px] font-mono">
                <span class="text-zinc-500">decorative</span>
              </div>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>



  <!-- ═══════════════════════════════════════════════════════
       CIRCULAR ECONOMY OVERVIEW (Full MMT Sovereign)
  ═══════════════════════════════════════════════════════ -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-2">
    <div class="flex items-center gap-3 mb-4">
      <GamePill game="gta-online" size="xs" />
      <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// GTA Online Circular Economy</span>
      <div class="flex-1 h-px bg-border-dim"></div>
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-4">
    <div class="rounded-xl border border-border-dim p-5" style="background:var(--c-bg)">
      <CircularEconomy titleId="gta-online" mode="full" />
      <CardFooter anchorId="eco-gta-online" sources="Source: GTAVI.AI Economic Model Analysis · GTA Online 2013–2026 · community benchmarks" shareText="GTA Online's economy is a Full MMT Sovereign: Rockstar controls the money supply, wages, and inflation. 10 years of data modelled across 5 circular flows." />
    </div>
  </div>

  <!-- Key Departures + GTA VI Lineage — full-width band below diagram grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-6 flex flex-col gap-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {[
        {
          label: "Maze Bank ≠ real bank",
          body: "Holds savings but creates no credit. It is NOT equivalent to a commercial bank. The real 'bank' function is Rockstar — they inject GTA$ via Shark Cards."
        },
        {
          label: "Shark Cards = QE, not loans",
          body: "Real GBP/USD enters the system as GTA$ with no repayment obligation. Closer to central bank QE or colonial currency board issuance than consumer credit."
        },
        {
          label: "Inflation is hidden",
          body: "Nominal DLC prices can stay flat while real purchasing power collapses via payout nerfs. The GTA-PPI captures this. Track wage/price ratio, not prices alone."
        },
        {
          label: "Rockstar's incentive",
          body: "Engineering real-terms inflation (via nerfs) increases Shark Card demand → Take-Two revenue. Track as the key political economy dynamic of the Online ecosystem."
        },
      ].map(d => (
        <div class="rounded-lg border border-border-dim p-4" style="background:var(--c-card)">
          <div class="text-[11px] font-bold text-zinc-200 mb-1.5">{d.label}</div>
          <p class="text-[11px] text-zinc-500 leading-relaxed">{d.body}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">



    <!-- ═══════════════════════════════════════════════════════
         SECTION: FOUR FLOWS
    ══════════════════════════════════════════════════════════ -->
    <section id="four-flows" style="scroll-margin-top:80px">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-gta-online-vivid/60 shrink-0"></span>
        <span class="text-[10px] font-mono text-zinc-400 tracking-[0.2em] uppercase">// Money Flows — One chart per money flow between actors</span>
        <div class="flex-1 h-px bg-border-dim"></div>
        <a href="/charts?title=gta-online" class="shrink-0 text-[10px] font-mono text-zinc-500 hover:text-zinc-200 border border-border-mid hover:border-zinc-600 px-3 py-1 rounded transition-colors uppercase tracking-widest">All GTA Online charts →</a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

        <!-- Flow ① — Hourly GTA$ Yield (Wages) -->
        <div class="rounded-xl border border-border-dim overflow-hidden flow-card" data-flow="wages" data-actors="businesses,players" style="background:var(--c-card)">
          <div class="px-5 py-4 border-b border-border-dim">
            <div class="flex items-center justify-between mb-2">
              <div class="text-[11px] font-mono text-gta-gold/60 uppercase tracking-[0.2em] flex items-center gap-1.5">
                <span class="font-black text-[14px] mr-1" style="color:var(--c-income)">①</span>BUSINESSES → PLAYERS</span>
              </div>
              <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest" style="border-color:color-mix(in srgb,var(--c-income) 40%,transparent);background:color-mix(in srgb,var(--c-income) 12%,transparent);color:var(--c-income)">Y · INCOME</span>
            </div>
            <div class="text-lg font-bold text-white">Hourly GTA$ Yield</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Top-tier activity $/hr at each major patch. The in-game "real wage."</div>
          </div>
          <div class="px-5 py-2 border-t border-b border-border-dim flex items-center justify-between" style="background:var(--c-bg)">
            <span class="text-[10px] font-mono text-zinc-600">Wages rose from $250k/hr (2013) → $1.7M/hr (2026) across 12 major patches</span>
            <a href="/charts?title=gta-online#section-eco-wages" class="shrink-0 text-[10px] font-mono text-gta-gold/60 hover:text-gta-gold transition-colors tracking-widest uppercase ml-4">Full chart →</a>
          </div>
          <div class="px-5 py-3 border-t border-border-dim grid grid-cols-2 gap-4">
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">CURRENT</div>
              <div class="text-2xl font-black" style={`color:var(--c-chart-bar);font-family:'Inter',sans-serif`}>${Math.round((latestYield?.top_gta_per_hr ?? 0)/1000)}K/hr</div>
              <div class="text-[10px] font-mono text-zinc-400">{latestYield?.top_method ?? "—"}</div>
            </div>
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">ALL-TIME PEAK</div>
              <div class="text-2xl font-black text-gta-green">$2,000K/hr</div>
              <div class="text-[10px] font-mono text-zinc-400">Cayo Perico launch 2020</div>
            </div>
          </div>
          <div class="px-5 pb-4">
            <div class="border-l-2 border-gta-gold/40 pl-3 py-1 rounded-r" style="background:var(--c-card-raised)">
              <p class="text-[11px] text-zinc-400 leading-relaxed">
                <span class="font-semibold text-zinc-200">Read it:</span> When the line dips after a major DLC, Rockstar has nerfed the previous meta activity to push players toward new content. The 2021 Cayo nerf cut wages 40% in a single patch — prices unchanged.
              </p>
            </div>
          </div>
        </div>

        <!-- Flow ② — Spending Distribution -->
        <div class="rounded-xl border border-border-dim overflow-hidden flow-card" data-flow="spending" data-actors="players,businesses" style="background:var(--c-card)">
          <div class="px-5 py-4 border-b border-border-dim">
            <div class="flex items-center justify-between mb-2">
              <div class="text-[11px] font-mono text-zinc-400/60 uppercase tracking-[0.2em] flex items-center gap-1.5">
                <span class="font-black text-[14px] mr-1" style="color:var(--c-flow-spending)">②</span>PLAYERS → BUSINESSES</span>
              </div>
              <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest" style="border-color:color-mix(in srgb,var(--c-flow-spending) 40%,transparent);background:color-mix(in srgb,var(--c-flow-spending) 12%,transparent);color:var(--c-flow-spending)">C · CONSUMPTION</span>
            </div>
            <div class="text-lg font-bold text-white">Spending Distribution</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Where GTA$ flows after it's earned. Community-estimated by DLC era.</div>
          </div>
          <div class="px-5 py-2 border-t border-b border-border-dim flex items-center justify-between" style="background:var(--c-bg)">
            <span class="text-[10px] font-mono text-zinc-600">Vehicles 44% · Properties/Biz 33% · Weapons/Mods 18% · Other 5% (current era)</span>
            <a href="/charts?title=gta-online#section-eco-spending" class="shrink-0 text-[10px] font-mono text-gta-gold/60 hover:text-gta-gold transition-colors tracking-widest uppercase ml-4">Full chart →</a>
          </div>
          <div class="px-5 py-3 border-t border-border-dim grid grid-cols-3 gap-3">
            {[
              { label:"VEHICLES",       val:`${spendEras.at(-1)?.vehicles_pct ?? 0}%`,  sub:"consumer goods",   color:"var(--c-chart-bar)" },
              { label:"PROPERTIES/BIZ", val:`${spendEras.at(-1)?.properties_pct ?? 0}%`,sub:"capital investment",color:"var(--c-cat-economy)" },
              { label:"WEAPONS/MODS",   val:`${spendEras.at(-1)?.weapons_pct ?? 0}%`,   sub:"recurring costs",  color:"var(--c-chart-teal)" },
            ].map(s => (
              <div>
                <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">{s.label}</div>
                <div class="text-xl font-black" style={`color:${s.color};font-family:'Inter',sans-serif`}>{s.val}</div>
                <div class="text-[10px] font-mono text-zinc-400">{s.sub}</div>
              </div>
            ))}
          </div>
          <div class="px-5 pb-4">
            <div class="border-l-2 border-orange-600/40 pl-3 py-1 rounded-r" style="background:var(--c-card-raised)">
              <p class="text-[11px] text-zinc-400 leading-relaxed">
                <span class="font-semibold text-zinc-200">Read it:</span> Vehicles are the dominant consumer good — equivalent to housing in the real economy. Every DLC that adds desirable cars drives a consumer spending spike. The Oppressor Mk II alone moved the needle in 2018.
              </p>
            </div>
          </div>
        </div>

        <!-- Flow ③ — Savings -->
        <div class="rounded-xl border border-border-dim overflow-hidden flow-card" data-flow="savings" data-actors="players,mazebank" style="background:var(--c-card)">
          <div class="px-5 py-4 border-b border-border-dim">
            <div class="flex items-center justify-between mb-2">
              <div class="text-[11px] font-mono text-gta-green/60 uppercase tracking-[0.2em] flex items-center gap-1.5">
                <span class="font-black text-[14px] mr-1" style="color:var(--c-growth)">③</span>PLAYERS → MAZE BANK</span>
              </div>
              <span class="text-[11px] font-mono border border-gta-green/40 bg-gta-green/20 text-gta-green px-2 py-0.5 rounded uppercase tracking-widest">SAVINGS</span>
            </div>
            <div class="text-lg font-bold text-white">Idle GTA$ Balance</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Estimated held balance by player progression stage.</div>
          </div>
          <div class="px-5 py-2 border-t border-b border-border-dim flex items-center justify-between" style="background:var(--c-bg)">
            <span class="text-[10px] font-mono text-zinc-600">Estimated held balance by player progression — $2.1B transaction ceiling · 8.9% avg savings rate</span>
          </div>
          <div class="px-5 py-3 border-t border-border-dim grid grid-cols-2 gap-4">
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">TOP SAVER CAP</div>
              <div class="text-2xl font-black text-gta-green">$2.1B</div>
              <div class="text-[10px] font-mono text-zinc-400">transaction screen ceiling</div>
            </div>
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">EST. AVG RATE</div>
              <div class="text-2xl font-black text-gta-green">8.9%</div>
              <div class="text-[10px] font-mono text-zinc-400">of earnings held idle</div>
            </div>
          </div>
          <div class="px-5 pb-4">
            <div class="border-l-2 border-gta-green/40 pl-3 py-1 rounded-r" style="background:var(--c-card-raised)">
              <p class="text-[11px] text-zinc-400 leading-relaxed">
                <span class="font-semibold text-zinc-200">Read it:</span> High savings = money not flowing back to businesses. The $2.1B cap on the transaction screen is GTA's version of a savings ceiling. The 2020 Covid spike (29%) was forced saving — Cayo Perico compounded balances with nowhere to spend.
              </p>
            </div>
          </div>
        </div>

        <!-- Flow ④ — Shark Card Injections -->
        <div class="rounded-xl border border-border-dim overflow-hidden flow-card" data-flow="sharkcards" data-actors="mazebank,players" style="background:var(--c-card)">
          <div class="px-5 py-4 border-b border-border-dim">
            <div class="flex items-center justify-between mb-2">
              <div class="text-[11px] font-mono text-blue-400/60 uppercase tracking-[0.2em] flex items-center gap-1.5">
                <span class="font-black text-[14px] mr-1" style="color:var(--c-title-online)">④</span>ROCKSTAR → PLAYERS</span>
              </div>
              <span class="text-[11px] font-mono border px-2 py-0.5 rounded uppercase tracking-widest" style="border-color:color-mix(in srgb,var(--c-title-online) 40%,transparent);background:color-mix(in srgb,var(--c-title-online) 12%,transparent);color:var(--c-title-online)">J · INJECTION</span>
            </div>
            <div class="text-lg font-bold text-white">Shark Card Injections</div>
            <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Take-Two recurrent consumer spending as Shark Card proxy (USD billion).</div>
          </div>
          <div class="px-5 py-2 border-t border-b border-border-dim flex items-center justify-between" style="background:var(--c-bg)">
            <span class="text-[10px] font-mono text-zinc-600">Take-Two recurrent revenue peaked at $1.62B (FY2022) — tracked as Shark Card proxy</span>
            <a href="/charts?title=gta-online#section-eco-sharkcards" class="shrink-0 text-[10px] font-mono text-gta-gold/60 hover:text-gta-gold transition-colors tracking-widest uppercase ml-4">Full chart →</a>
          </div>
          <div class="px-5 py-3 border-t border-border-dim grid grid-cols-2 gap-4">
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">PEAK YEAR</div>
              <div class="text-2xl font-black text-blue-400">$1.62B</div>
              <div class="text-[10px] font-mono text-zinc-400">FY2022 (2021 calendar year)</div>
            </div>
            <div>
              <div class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-0.5">LATEST</div>
