---
import Base from "../../layouts/Base.astro";
import CrossLinks from "../../components/CrossLinks.astro";
---

<Base
  title="GTA Online Charts"
  description="GTA Online economy and promotions charts — GTA-PPI inflation index, passive income stack, meta evolution, heist comparison, spending distribution and bonus calendar."
  ogPage="charts"
>
  <!-- Hero -->
  <section class="border-b border-[#1e1e23]" style="background:#0a0a0d">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">// GTA Online · Data Visualised</div>
      <h1 class="text-3xl font-bold text-white mb-3">GTA Online Charts</h1>
      <p class="text-sm text-zinc-400 max-w-lg">
        Economy-IG and Economy-RL charts — inflation, income sources, passive stack, meta evolution, heist comparison, and promotions calendar.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">

    <!-- Chart category cards — direct deep-links -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
      {[
        { href: "/charts#gta-ppi-chart",               icon: "📊", label: "GTA-PPI Inflation Index",        sub: "Hours to buy standard basket per patch" },
        { href: "/charts#passive-stack-chart",          icon: "💤", label: "Passive Income Stack",           sub: "$0 → $1.24M/hr AFK evolution" },
        { href: "/charts#meta-evolution-chart",         icon: "📈", label: "Meta Ceiling $/hr",              sub: "Top method per DLC 2013→2023" },
        { href: "/charts#heist-comparison-chart",       icon: "🎯", label: "Heist Comparison",               sub: "$/hr vs setup cost vs run time" },
        { href: "/charts#property-daily-fee-chart",     icon: "⚙",  label: "Property Daily Fees",            sub: "Ongoing ownership costs per type" },
        { href: "/charts#spending-distribution-chart",  icon: "💸", label: "Spending Distribution",          sub: "Where GTA$ goes per era" },
        { href: "/charts#shark-card-chart",             icon: "🦈", label: "Shark Card Erosion",             sub: "$18.75 → $437 real-money endgame" },
        { href: "/charts#bonus-heatmap",                icon: "🏷",  label: "Bonus Activity Heatmap",         sub: "42 weeks of promotional calendar" },
        { href: "/charts#income-history-chart",         icon: "⚡", label: "Income Source History",          sub: "Nerfs, buffs, DLC launches" },
      ].map(c => (
        <a href={c.href}
           class="group rounded-xl border border-[#1e1e23] hover:border-zinc-700 p-4 flex items-start gap-3 transition-all"
           style="background:#131316">
          <span class="text-xl shrink-0 mt-0.5">{c.icon}</span>
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5 group-hover:text-white transition-colors">{c.label}</div>
            <div class="text-[10px] font-mono text-zinc-600">{c.sub}</div>
          </div>
          <span class="text-zinc-500 group-hover:text-zinc-400 font-mono text-[10px] ml-auto shrink-0 mt-1 transition-colors">→</span>
        </a>
      ))}
    </div>

    <!-- Link to full charts page -->
    <div class="rounded-xl border border-[#1e1e23] px-5 py-4 flex items-center gap-4 mb-10" style="background:#131316">
      <div class="flex-1">
        <div class="font-semibold text-zinc-200 text-sm mb-1">All Charts — 35+ Visualisations</div>
        <div class="text-[10px] font-mono text-zinc-600">Including franchise history, GTA VI comparisons, community signals, and performance benchmarks.</div>
      </div>
      <a href="/charts" class="shrink-0 px-3 py-2 rounded border border-gta-gold/30 text-gta-gold text-[10px] font-mono hover:bg-gta-gold/20 transition-all">
        All charts →
      </a>
    </div>

    <CrossLinks context="charts" />
  </div>
</Base>
