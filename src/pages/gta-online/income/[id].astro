---
/**
 * gta-online/income/[id].astro
 * Real standalone page for each GTA Online income source.
 */
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import { C_LIVE, C_GROWTH, C_BRAND, C_ALERT, C_CARD_RAISED, C_TEXT_4, C_TEXT_7 } from "../../../config/colors";
import IncomeCard from "../../../components/IncomeCard.astro";
import ShareDropdown from "../../../components/ShareDropdown.astro";
import type {
  BusinessProfiles, Business, OnlineHeistsData, OnlineHeist,
  RevenueTiersData, RevenueTier, TierSource,
  SaleFrequencyData, ActivityBonusFreq,
  PerSourceHistoryData, SourceHistory,
  WeeklyBonusesData, WeeklyBonus,
} from "../../../types/gta";

import businessProfilesRaw  from "../../../../data/gta-5/economy/business-profiles.json";
import onlineHeistsRaw      from "../../../../data/gta-5/economy/online-heists.json";
import revenueTiersRaw      from "../../../../data/gta-5/economy/revenue-tiers.json";
import saleFreqRaw          from "../../../../data/gta-5/economy/sale-frequency.json";
import sourceHistoryRaw     from "../../../../data/gta-5/economy/per-source-history.json";
import weeklyBonusesRaw     from "../../../../data/gta-5/economy/weekly-bonuses.json";

export const getStaticPaths: GetStaticPaths = () => {
  const bp = businessProfilesRaw as unknown as BusinessProfiles;
  const hd = onlineHeistsRaw     as unknown as OnlineHeistsData;
  const bizList   = bp.businesses.filter(b => b.net_profit_per_hr > 0);
  const heistList = hd.heists;
  const merged: (Business | OnlineHeist)[] = [...bizList];
  heistList.forEach(h => { if (!merged.find(b => b.id === h.id)) merged.push(h); });
  return merged.map(biz => ({ params: { id: biz.id }, props: { biz } }));
};

const { id } = Astro.params;
const { biz } = Astro.props as { biz: Business | OnlineHeist };
const bizName = (biz as Business).name ?? (biz as OnlineHeist).title;

const revTiers     = revenueTiersRaw  as unknown as RevenueTiersData;
const saleFreqData = saleFreqRaw      as unknown as SaleFrequencyData;
const srcHistData  = sourceHistoryRaw as unknown as PerSourceHistoryData;
const wkBonuses    = weeklyBonusesRaw as unknown as WeeklyBonusesData;

// ── Tier lookup ────────────────────────────────────────────────────────────
const tiers     = revTiers.tiers;
const tierEntry = tiers.find((t: RevenueTier) => t.sources.some((s: TierSource) => s.id === id));
const srcEntry  = tierEntry?.sources.find((s: TierSource) => s.id === id);
const tier      = (tierEntry?.tier ?? "B") as "S"|"A"|"B"|"C"|"D";
const maxProfitHr = Math.max(...tiers.flatMap((t: RevenueTier) => t.sources.map((s: TierSource) => s.gta_per_hr)));
const netProfitHr = srcEntry?.gta_per_hr ?? (biz as Business).net_profit_per_hr ?? 0;

// ── Bonus cadence ─────────────────────────────────────────────────────────
const bonusFreq    = (saleFreqData.activity_bonuses ?? []).find((a: ActivityBonusFreq) => a.activity_id === id);
const bonusDaysAgo = bonusFreq?.last_bonus_date
  ? Math.round((Date.now() - new Date(bonusFreq.last_bonus_date).getTime()) / (1000*60*60*24))
  : null;

// ── Income history ─────────────────────────────────────────────────────────
const srcHistory = (srcHistData.sources ?? []).find((s: SourceHistory) => s.id === id);
const peakHr = srcHistory ? Math.max(...srcHistory.timeline.map(t => t.gta_per_hr)) : null;

// ── Weekly bonus active ────────────────────────────────────────────────────
const activeBonus = (wkBonuses.bonuses ?? []).find((b: WeeklyBonus) => b.activity_id === id);

// ── Related sources (same tier, first 3 excl. self) ───────────────────────
const related = (tierEntry?.sources ?? []).filter((s: TierSource) => s.id !== id).slice(0, 3);
// ── Thumbnail ─────────────────────────────────────────────────────────────
const BIZ_THUMBS: Record<string,string> = {
  "cayo-perico":          "/assets/gta5/story/blitz-play.jpg",
  "diamond-casino-heist": "/assets/gta5/story/arcade.jpg",
  "nightclub":            "/assets/gta5/dlc/nightclub.jpg",
  "bunker":               "/assets/gta5/dlc/bunker.jpg",
  "acid-lab":             "/assets/gta5/dlc/acid-lab.jpg",
  "agency-vip-contract":  "/assets/gta5/dlc/agency.jpg",
};
const thumbnail = BIZ_THUMBS[id] ?? (biz as Business).thumbnail ?? undefined;

// ── SEO ───────────────────────────────────────────────────────────────────
const title       = `${bizName} — GTA Online Income Guide`;
const khr         = Math.round(netProfitHr / 1000);
const description = `${bizName}: $${khr}k/hr net in GTA Online. Full setup guide, tips, and income analysis. ${"solo" in biz ? "Solo capable." : ""}`;
---

<Base
  title={title}
  description={description}
  ogImage={`https://gtavi.ai/og/online/${id}.png`}
  crossLinksContext="database"
>
  <!-- Breadcrumb -->
  <div class="border-b border-border-dim" style="background:var(--c-bg-deep)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center gap-2 text-[10px] font-mono text-zinc-500">
      <a href="/gta-online" class="hover:text-zinc-400 transition-colors">GTA Online</a>
      <span class="text-zinc-500">›</span>
      <a href="/gta-online/income" class="hover:text-zinc-400 transition-colors">Income Sources</a>
      <span class="text-zinc-500">›</span>
      <span class="text-zinc-500">{bizName}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Left: ProfitCard + income chart -->
      <div class="lg:col-span-1 flex flex-col gap-6">

        <!-- ProfitCard -->
        <IncomeCard
          id={id}
          name={bizName}
          game="gta-online"
          category={biz.category ?? (biz.min_players > 1 ? "heist" : "business")}
          tier={tier}
          net_profit_per_hr={netProfitHr}
          max_profit_per_hr={maxProfitHr}
          setup_cost_full={biz.setup_cost_full ?? undefined}
          break_even_hrs={biz.break_even_hrs ?? (biz.setup_cost_full && netProfitHr > 0 ? Math.round(biz.setup_cost_full / netProfitHr) : undefined)}
          play_type={biz.play_type ?? ((biz as Business).solo !== false ? "active" : "heist")}
          difficulty={biz.risk === "high" ? 4 : biz.risk === "medium" ? 3 : 2}
          min_players={biz.min_players ?? 1}
          max_players={biz.max_players ?? 4}
          solo={biz.solo ?? true}
          dlc={biz.dlc ?? undefined}
          prerequisite={biz.prerequisite ?? undefined}
          payout_per_run_min={biz.payout_per_run_min ?? undefined}
          payout_per_run_max={biz.payout_per_run_max ?? undefined}
          avg_run_time_min={biz.avg_run_time_min ?? undefined}
          loot_tiers={biz.loot_tiers ?? undefined}
          tips={biz.tips ?? undefined}
          thumbnail={thumbnail}
          last_nerfed={biz.last_nerfed ?? undefined}
          last_nerfed_notes={biz.last_nerfed_notes ?? undefined}
          bonus_count={bonusFreq?.bonus_count}
          bonus_last_date={bonusFreq?.last_bonus_date}
          bonus_avg_gap_weeks={bonusFreq?.avg_gap_weeks}
          peak_gta_per_hr={peakHr ?? undefined}
          share_url={`https://gtavi.ai/gta-online/income/${id}`}
        />

        <!-- Active bonus callout -->
        {activeBonus && (
          <div class="rounded-xl border border-gta-green/30 px-4 py-3 flex items-center gap-3" style="background:color-mix(in srgb,var(--c-growth) 6%,transparent)">
            <span class="text-lg shrink-0">🔥</span>
            <div>
              <div class="text-xs font-semibold text-gta-green">ACTIVE BONUS THIS WEEK</div>
              <div class="text-[10px] font-mono text-gta-green">{activeBonus.multiplier}× GTA$ · check the weekly update</div>
            </div>
          </div>
        )}
      </div>

      <!-- Right: Guide content -->
      <div class="lg:col-span-2 flex flex-col gap-6">

        <!-- Full tips -->
        {biz.tips && biz.tips.length > 0 && (
          <div class="rounded-xl border border-border-dim overflow-hidden" style={`background:${C_CARD_RAISED}`}>
            <div class="px-5 py-3 border-b border-border-dim">
              <div class="font-semibold text-zinc-200 text-sm">Strategy & Tips</div>
            </div>
            <div class="divide-y divide-border-dim">
              {(biz.tips as string[]).map((tip: string, i: number) => (
                <div class="px-5 py-3 flex gap-3">
                  <span class="text-gta-gold shrink-0 font-mono text-[10px] mt-0.5">{i + 1}.</span>
                  <p class="text-[11px] text-zinc-400 leading-relaxed">{tip}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Income history timeline (if available) -->
        {srcHistory && srcHistory.timeline.length > 1 && (
          <div class="rounded-xl border border-border-dim overflow-hidden" style={`background:${C_CARD_RAISED}`}>
            <div class="px-5 py-3 border-b border-border-dim flex items-center justify-between">
              <div class="font-semibold text-zinc-200 text-sm">$/hr History</div>
              <span class="text-[10px] font-mono text-zinc-500">{srcHistory.timeline.length} snapshots</span>
            </div>
            <div class="divide-y divide-border-dim">
              {[...srcHistory.timeline].reverse().map((snap: any, ri: number) => {
                const isPeak = snap.gta_per_hr === peakHr;
                const isCurrent = ri === 0; // first in reversed = last in original
                return (
                  <div class="px-5 py-3 flex items-center gap-4">
                    <div class="w-28 shrink-0">
                      <div class="text-[10px] font-mono text-zinc-500">{snap.date?.slice(0,7)}</div>
                      <div class="text-[11px] font-mono text-zinc-500 truncate">{snap.patch}</div>
                    </div>
                    <div class="flex-1">
                      <div class="h-1.5 rounded-full bg-border-dim overflow-hidden">
                        <div class="h-full rounded-full" style={`width:${Math.round((snap.gta_per_hr / (peakHr ?? 1)) * 100)}%;background:${isPeak ? C_GROWTH : isCurrent ? C_BRAND : C_TEXT_7}`}></div>
                      </div>
                    </div>
                    <div class="shrink-0 text-right">
                      <span class="text-[11px] font-mono font-bold" style={`color:${isPeak ? C_GROWTH : isCurrent ? C_BRAND : C_TEXT_4}`}>
                        ${Math.round(snap.gta_per_hr / 1000)}k/hr
                      </span>
                      {isPeak && <span class="text-[10px] font-mono text-gta-green ml-1">peak</span>}
                      {isCurrent && !isPeak && <span class="text-[10px] font-mono text-gta-gold ml-1">now</span>}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        <!-- Notes -->
        {biz.notes && (
          <div class="rounded-xl border border-border-dim px-5 py-4" style={`background:${C_CARD_RAISED}`}>
            <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-2">Notes</div>
            <p class="text-[11px] text-zinc-400 leading-relaxed">{biz.notes}</p>
          </div>
        )}

        <!-- Bonus cadence (full detail) -->
        {bonusFreq && (
          <div class="rounded-xl border border-border-dim overflow-hidden" style={`background:${C_CARD_RAISED}`}>
            <div class="px-5 py-3 border-b border-border-dim flex items-center justify-between">
              <div class="font-semibold text-zinc-200 text-sm">Bonus Calendar Intelligence</div>
              <span class="text-[10px] font-mono text-zinc-500">{bonusFreq.bonus_count} bonus events tracked</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-border-dim">
              <div class="px-5 py-4">
                <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-1">Last bonus</div>
                <div class="text-base font-mono font-bold text-zinc-200">
                  {bonusDaysAgo !== null ? (bonusDaysAgo < 7 ? `${bonusDaysAgo}d ago` : `${Math.round(bonusDaysAgo/7)}wk ago`) : "—"}
                </div>
                <div class="text-[11px] font-mono text-zinc-500 mt-0.5">{bonusFreq.last_bonus_date ?? "no data"}</div>
              </div>
              <div class="px-5 py-4">
                <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-1">Avg gap</div>
                <div class="text-base font-mono font-bold text-zinc-200">
                  {bonusFreq.avg_gap_weeks ? `${bonusFreq.avg_gap_weeks.toFixed(1)} wk` : "—"}
                </div>
                <div class="text-[11px] font-mono text-zinc-500 mt-0.5">between bonus events</div>
              </div>
              <div class="px-5 py-4">
                <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-1">Est. next</div>
                <div class="text-base font-mono font-bold" style={`color:${bonusFreq.estimated_next_bonus && new Date(bonusFreq.estimated_next_bonus) < new Date(Date.now() + 30*24*60*60*1000) ? C_GROWTH : C_TEXT_4}`}>
                  {bonusFreq.estimated_next_bonus ? new Date(bonusFreq.estimated_next_bonus).toLocaleDateString("en-GB", {month:"short", year:"numeric"}) : "—"}
                </div>
                <div class="text-[11px] font-mono text-zinc-500 mt-0.5">estimate only</div>
              </div>
            </div>
            {bonusFreq.bonus_weeks && bonusFreq.bonus_weeks.length > 0 && (
              <div class="px-5 py-3 border-t border-border-dim">
                <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-2">Recent bonus weeks</div>
                <div class="flex flex-wrap gap-1.5">
                  {[...bonusFreq.bonus_weeks].reverse().slice(0, 8).map((w: string) => (
                    <span class="text-[11px] font-mono text-zinc-500 border border-border-mid px-2 py-0.5 rounded">{w.slice(0,7)}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}

        <!-- Patch history (richer than per-source-history) -->
        {biz.patch_history && biz.patch_history.length > 0 && (
          <div class="rounded-xl border border-border-dim overflow-hidden" style={`background:${C_CARD_RAISED}`}>
            <div class="px-5 py-3 border-b border-border-dim flex items-center justify-between">
              <div class="font-semibold text-zinc-200 text-sm">Patch History</div>
              <span class="text-[10px] font-mono text-zinc-500">{biz.patch_history.length} patches tracked</span>
            </div>
            <div class="divide-y divide-border-dim">
              {[...(biz as Business).patch_history].reverse().map((patch, ri: number) => {
                const allVals = (biz as Business).patch_history.map(p => p.net_profit_per_hr);
                const peak = Math.max(...allVals);
                const pct  = Math.round((patch.net_profit_per_hr / peak) * 100);
                const isCurrent = ri === 0;
                const isPeak    = patch.net_profit_per_hr === peak;
                return (
                  <div class="px-5 py-3 flex items-center gap-4">
                    <div class="w-28 shrink-0">
                      <div class="text-[10px] font-mono text-zinc-500">{patch.date?.slice(0,7)}</div>
                      <div class="text-[11px] font-mono text-zinc-500 truncate" title={patch.patch}>{patch.patch}</div>
                    </div>
                    <div class="flex-1">
                      <div class="h-1.5 rounded-full bg-border-dim overflow-hidden">
                        <div class="h-full rounded-full transition-all"
                             style={`width:${pct}%;background:${isPeak ? C_GROWTH : isCurrent ? C_BRAND : C_TEXT_7}`}></div>
                      </div>
                      {patch.notes && (
                        <div class="text-[11px] font-mono text-zinc-500 mt-1 leading-snug">{patch.notes}</div>
                      )}
                    </div>
                    <div class="shrink-0 text-right w-20">
                      <span class="text-[11px] font-mono font-bold"
                            style={`color:${isPeak ? C_GROWTH : isCurrent ? C_BRAND : C_TEXT_4}`}>
                        ${Math.round(patch.net_profit_per_hr / 1000)}k/hr
                      </span>
                      {isCurrent && <div class="text-[10px] font-mono text-gta-gold">current</div>}
                      {isPeak && !isCurrent && <div class="text-[10px] font-mono text-gta-green">peak</div>}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        <!-- Loot tiers (heist-type sources) -->
        {biz.loot_tiers && biz.loot_tiers.length > 0 && (
          <div class="rounded-xl border border-border-dim overflow-hidden" style={`background:${C_CARD_RAISED}`}>
            <div class="px-5 py-3 border-b border-border-dim">
              <div class="font-semibold text-zinc-200 text-sm">Loot Tiers — What to Target</div>
            </div>
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="border-b border-border-dim">
                  <th class="text-left px-5 py-2 text-zinc-500 font-normal">Primary Loot</th>
                  <th class="text-right px-4 py-2 text-zinc-500 font-normal">Value</th>
                  <th class="text-right px-5 py-2 text-zinc-500 font-normal">Frequency</th>
                </tr>
              </thead>
              <tbody>
                {((biz as OnlineHeist).loot_tiers ?? []).map((l, i: number) => (
                  <tr class="border-b border-border-dim/50 hover:bg-white/2 transition-colors">
                    <td class="px-5 py-2.5 font-semibold text-zinc-200">{l.loot}</td>
                    <td class="px-4 py-2.5 text-right font-bold" style={`color:${i === 0 ? C_GROWTH : i === 1 ? C_BRAND : C_TEXT_4}`}>
                      ${(l.value / 1_000_000).toFixed(2)}M
                    </td>
                    <td class="px-5 py-2.5 text-right text-zinc-500">{l.frequency}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="px-5 py-2.5 border-t border-border-dim">
              <span class="text-[11px] font-mono text-zinc-500">Only run for top 2 loot tiers. Abort and restart if primary loot is low-value.</span>
            </div>
          </div>
        )}

        <!-- Related sources -->
        {related.length > 0 && (
          <div class="rounded-xl border border-border-dim overflow-hidden" style={`background:${C_CARD_RAISED}`}>
            <div class="px-5 py-3 border-b border-border-dim">
              <div class="font-semibold text-zinc-200 text-sm">Same Tier — Also Worth Running</div>
            </div>
            <div class="divide-y divide-border-dim">
              {related.map((r: any) => (
                <a href={`/gta-online/income/${r.id}`}
                   class="flex items-center justify-between px-5 py-3 hover:bg-white/[0.02] transition-colors group">
                  <div>
                    <div class="text-[11px] font-semibold text-zinc-300 group-hover:text-white transition-colors">{r.name}</div>
                    <div class="text-[11px] font-mono text-zinc-500">{r.type} · {r.solo ? "solo" : "group"}</div>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="text-[11px] font-mono font-bold text-gta-gold">${Math.round(r.gta_per_hr / 1000)}k/hr</span>
                    <span class="text-zinc-500 group-hover:text-zinc-400 font-mono text-[10px] transition-colors">→</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- CTA to full database -->
        <div class="flex items-center gap-3 flex-wrap">
          <a href="/gta-online/income"
             class="px-4 py-2 rounded border border-border-mid text-zinc-400 text-[11px] font-mono hover:border-zinc-600 hover:text-zinc-200 transition-all">
            ← All income sources
          </a>
          <a href={`/database?game=gta-online#profit-${id}`}
             class="px-4 py-2 rounded border border-gta-teal/30 text-gta-teal text-[11px] font-mono hover:bg-gta-teal/20 transition-all">
            View in Database →
          </a>
          <div class="ml-auto">
            <ShareDropdown anchorId="${id}" shareText={`${bizName} — ${tier}-tier GTA Online income. $${khr}k/hr${(biz as Business).solo !== false ? ' solo' : ''}. Full guide on GTAVI.AI`} size="sm" />
          </div>
        </div>

      </div>
    </div>

    <div class="mt-10">
    </div>
  </div>
</Base>
