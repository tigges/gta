---
import Base from "../../layouts/Base.astro";
import ShareButton from "../../components/ShareButton.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import Ledger from "../../components/Ledger.astro";
import type { LedgerEntry } from "../../components/Ledger.astro";
import type { WeeklyBonusesData, SaleFrequencyData } from "../../types/gta";

import weeklyBonusesRaw from "../../../data/gta-5/economy/weekly-bonuses.json";
import bonusHistoryRaw  from "../../../data/gta-5/economy/bonus-history.json";
import saleFreqRaw      from "../../../data/gta-5/economy/sale-frequency.json";

const weeklyBonuses = weeklyBonusesRaw as unknown as WeeklyBonusesData;
const saleFreqData  = saleFreqRaw      as unknown as SaleFrequencyData;

const bonuses       = weeklyBonuses.bonuses  ?? [];
const sales         = weeklyBonuses.sales    ?? [];
const weekStart     = weeklyBonuses.week_start ?? "";
const historyCount  = (bonusHistoryRaw as { entry_count?: number }).entry_count ?? 0;
const topActivities = (saleFreqData.activity_bonuses ?? []).slice(0, 5);

// Worker URL — community leaderboard backed by Cloudflare KV
const WORKER_URL = "https://api.gtavi.ai";

// Ledger entries: this week's events as signed transaction rows
const bonusLedgerEntries: LedgerEntry[] = [
  ...bonuses.map(b => ({
    date:  weekStart ? weekStart.slice(0, 10) : undefined,
    label: b.activity_id.replace(/-/g, " ").replace(/\b\w/g, c => c.toUpperCase()),
    value: `+${b.multiplier}\u00d7 GTA$`,
    type:  "positive" as const,
    icon:  "money",
    sub:   "bonus multiplier",
  })),
  ...sales.map(s => ({
    date:  weekStart ? weekStart.slice(0, 10) : undefined,
    label: s.item_description ?? s.activity_id,
    value: `-${s.discount_pct}% sale`,
    type:  "positive" as const,
    icon:  "tag",
    sub:   "discount",
  })),
];
---
<Base
  title="GTA Online Bonuses, Promos & Leaderboard"
  description="GTA Online weekly bonus calendar, sale intelligence, promotional history and community income leaderboard. Every Thursday's events tracked since 2013."
  ogPage="leaderboard"
>

  <!-- Hero -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden" style="min-height:180px">
    <div class="absolute inset-0" style="background:radial-gradient(ellipse at 70% 50%, rgba(34,197,94,0.07) 0%, transparent 55%), #0a0a0d"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// GTA Online · Promotions & Community</div>
          <h1 class="text-3xl font-bold text-white mb-2">
            Bonuses, Promos &amp; Leaderboard
          </h1>
          <p class="text-sm text-zinc-400 max-w-lg">
            Weekly bonus calendar · sale intelligence · {historyCount} weeks tracked · community income rankings
          </p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <ShareButton text="GTA Online weekly bonuses, promotions and community income leaderboard — {historyCount} weeks tracked since 2013. GTAVI.AI" url="https://gtavi.ai/gta-online/bonuses" size="sm" label="Share" />
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">

    <!-- This week's bonuses + sales -->
    {(bonuses.length > 0 || sales.length > 0) && (
      <div class="mb-8 rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse shrink-0"></span>
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em]">
              This week{weekStart ? ` · w/c ${weekStart}` : ""}
            </span>
          </div>
          <a href="/charts#bonus-heatmap" class="text-[10px] font-mono text-zinc-500 hover:text-zinc-400 transition-colors tracking-widest uppercase">Full calendar chart →</a>
        </div>
        <div class="grid sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-[#1e1e23]">
          <div class="divide-y divide-[#1e1e23]">
            <div class="px-5 py-2 text-[11px] font-mono text-zinc-500 uppercase tracking-widest">Bonus Events</div>
            {bonuses.length === 0 && <div class="px-5 py-3 text-[10px] font-mono text-zinc-500">No bonuses this week</div>}
            {bonuses.map((b: any) => (
              <div class="px-5 py-3 flex items-center gap-3">
                <span class="text-[11px] font-mono font-bold w-6 shrink-0" style="color:#0d9488">{b.multiplier}×</span>
                <span class="text-xs font-mono text-zinc-300 capitalize flex-1">{(b.activity_id as string).replace(/-/g," ")}</span>
              </div>
            ))}
          </div>
          <div class="divide-y divide-[#1e1e23]">
            <div class="px-5 py-2 text-[11px] font-mono text-zinc-500 uppercase tracking-widest">On Sale</div>
            {sales.length === 0 && <div class="px-5 py-3 text-[10px] font-mono text-zinc-500">No sales this week</div>}
            {sales.map((s: any) => (
              <div class="px-5 py-3 flex items-center gap-3">
                <span class="text-[11px] font-mono font-bold shrink-0" style="color:#22c55e">{s.discount_pct}%</span>
                <span class="text-xs font-mono text-zinc-300 flex-1">{s.item_description}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- Most-bonused activities -->
    {topActivities.length > 0 && (
      <div class="mb-8 rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center justify-between">
          <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em]">// Most Frequently Bonused Activities</span>
          <a href="/charts#bonus-heatmap" class="text-[10px] font-mono text-zinc-500 hover:text-zinc-400 transition-colors tracking-widest uppercase">Heatmap →</a>
        </div>
        <div class="divide-y divide-[#1e1e23]">
          {topActivities.map((a: any) => {
            const daysSince = a.days_since_last_bonus ?? null;
            return (
              <div class="px-5 py-3 flex items-center gap-4 flex-wrap sm:flex-nowrap">
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-semibold text-zinc-300 capitalize">{(a.activity_id as string).replace(/-/g," ")}</div>
                  <div class="text-[10px] font-mono text-zinc-600">{a.bonus_count}× tracked · last {a.last_bonus_date?.slice(0,7)}</div>
                </div>
                <div class="shrink-0">
                  {daysSince !== null && daysSince < 8
                    ? <span class="text-[11px] font-mono px-1.5 py-0.5 rounded" style="color:#22c55e;background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.3)">ACTIVE NOW</span>
                    : <span class="text-[10px] font-mono text-zinc-600">{daysSince}d ago</span>
                  }
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- This week — ledger view -->
    {bonusLedgerEntries.length > 0 && (
      <Ledger
        title={`This Week's Events${weekStart ? ` · w/c ${weekStart.slice(0,10)}` : ""}`}
        entries={bonusLedgerEntries}
        class="mb-8"
      />
    )}

    <!-- Last week's winner banner (populated by JS) -->
    <div id="lb-winner-banner" class="hidden mb-6 rounded-xl border border-gta-gold/30 overflow-hidden" style="background:#131316">
      <div class="px-5 py-3 border-b border-gta-gold/15 flex items-center gap-2">
        <span class="text-[11px] font-mono text-gta-gold/70 uppercase tracking-widest">Last Week's Winner</span>
        <div class="flex-1 h-px bg-gta-gold/10"></div>
        <span id="lb-winner-week" class="text-[11px] font-mono text-zinc-600"></span>
      </div>
      <div class="px-5 py-4 flex items-center gap-5 flex-wrap">
        <div class="flex items-center gap-3">
          <div class="text-4xl font-black text-gta-gold">#1</div>
          <div>
            <div id="lb-winner-name" class="text-base font-bold text-zinc-100"></div>
            <div id="lb-winner-score" class="text-[11px] font-mono text-gta-gold"></div>
          </div>
        </div>
        <div id="lb-winner-stack" class="flex flex-wrap gap-1.5 flex-1"></div>
        <a id="lb-winner-share" href="#" target="_blank" rel="noopener noreferrer"
          class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded border border-gta-gold/30 text-gta-gold text-[10px] font-mono hover:bg-gta-gold/8 transition-colors uppercase tracking-widest">
          Tweet winner
        </a>
      </div>
    </div>

    <!-- Week filter + stats row -->
    <div class="flex items-center gap-3 mb-6 flex-wrap">
      <div class="flex items-center gap-2">
        <span class="text-[11px] font-mono text-zinc-600 uppercase tracking-widest">Week</span>
        <button id="lb-filter-all"  class="lb-week-btn px-2.5 py-1 rounded text-[10px] font-mono border border-gta-gold/40 text-gta-gold bg-gta-gold/8 transition-all" data-week="">All time</button>
        <button id="lb-filter-week" class="lb-week-btn px-2.5 py-1 rounded text-[10px] font-mono border border-[#2a2a31] text-zinc-500 hover:border-zinc-600 transition-all" data-week="current">This week</button>
      </div>
      <div class="flex-1 h-px bg-[#1e1e23]"></div>
      <div id="lb-meta" class="text-[10px] font-mono text-zinc-600"></div>
    </div>

    <!-- Leaderboard table -->
    <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style="background:#131316">

      <!-- Loading state -->
      <div id="lb-loading" class="py-16 text-center">
        <div class="text-zinc-600 font-mono text-sm animate-pulse">Loading leaderboard…</div>
      </div>

      <!-- Error state -->
      <div id="lb-error" class="hidden py-16 text-center">
        <div class="text-zinc-600 font-mono text-sm">Could not load leaderboard. <a href="" class="text-gta-teal" onclick="loadLeaderboard();return false">Retry →</a></div>
      </div>

      <!-- Empty state -->
      <div id="lb-empty" class="hidden py-16 text-center">
        <div class="text-zinc-600 font-mono text-sm mb-2">No submissions yet.</div>
        <a href="/gta-online/income#income-adviser" class="text-[11px] font-mono text-gta-teal hover:text-gta-teal/80 transition-colors">Be the first — submit your stack →</a>
      </div>

      <!-- Leaderboard rows -->
      <div id="lb-rows" class="hidden divide-y divide-[#1e1e23]"></div>

    </div>

    <!-- Pagination -->
    <div id="lb-pagination" class="hidden flex justify-center gap-2 mt-6"></div>

    <!-- Call to action -->
    <div class="mt-8 rounded-xl border border-gta-teal/20 p-5 flex items-center justify-between flex-wrap gap-4" style="background:#131316">
      <div>
        <div class="text-[10px] font-mono text-gta-teal/60 uppercase tracking-widest mb-1">Want to appear here?</div>
        <div class="text-sm font-semibold text-zinc-200">Build your income stack on GTA V → Income Adviser and opt in</div>
        <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Select your businesses → click "Share my stack to the community leaderboard"</div>
      </div>
      <a href="/gta-online/income#income-adviser"
        class="shrink-0 px-4 py-2 rounded border border-gta-teal/30 text-gta-teal text-[11px] font-mono hover:bg-gta-teal/8 transition-colors uppercase tracking-widest">
        Open Adviser →
      </a>
    </div>

    <div class="mt-8">
      <CrossLinks context="gta-online-bonuses" />
    </div>

  </div>
</Base>

<script>
  const WORKER_URL = 'https://api.gtavi.ai';
  const PAGE_SIZE  = 25;
  const LS_KEY     = 'gtaviai_lb_username';

  let currentWeek   = '';
  let currentOffset = 0;
  let totalEntries  = 0;

  // Username saved after submitting from IncomeAdviser
  const myUsername: string = (typeof localStorage !== 'undefined' && localStorage.getItem(LS_KEY)) || '';

  function formatK(n: number): string {
    if (n >= 1e6) return `$${(n / 1e6).toFixed(1)}M`;
    return `$${Math.round(n / 1000)}K`;
  }

  function tierColor(rank: number): string {
    if (rank === 1) return '#f59e0b';
    if (rank <= 3) return '#d4d4d8';
    if (rank <= 10) return '#0d9488';
    return '#3f3f46';
  }

  function tweetShareUrl(rank: number, display: string, total_hr: number): string {
    const score = formatK(total_hr);
    const tier  = rank === 1 ? '🥇' : rank <= 3 ? '🥈' : rank <= 10 ? '🏆' : `#${rank}`;
    const text  = `${tier} Rank #${rank} with ${score}/hr on the GTAVI.AI community income leaderboard. Can you beat me? gtavi.ai/gta-online/bonuses`;
    return `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}`;
  }

  function renderRows(entries: any[]) {
    const container = document.getElementById('lb-rows')!;
    container.innerHTML = entries.map(e => {
      const isMe = myUsername && e.username === myUsername;
      const stackSummary = e.stack.slice(0, 4).map((s: any) =>
        `<span class="text-[11px] font-mono text-zinc-600 border border-[#2a2a31] px-1.5 py-0.5 rounded">${s.name.split(' ')[0]}</span>`
      ).join(' ') + (e.stack.length > 4 ? ` <span class="text-[11px] font-mono text-zinc-500">+${e.stack.length - 4}</span>` : '');

      const rankColor = tierColor(e.rank);
      const date = new Date(e.submitted_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
      const shareBtn = `<a href="${tweetShareUrl(e.rank, e.display, e.total_hr)}" target="_blank" rel="noopener noreferrer"
        class="shrink-0 flex items-center gap-1 px-2 py-1 rounded border border-gta-gold/20 text-gta-gold/70 text-[11px] font-mono hover:border-gta-gold/50 hover:text-gta-gold transition-colors uppercase tracking-widest"
        title="Tweet your rank">
        Tweet rank
      </a>`;

      return `
        <div class="px-4 py-3.5 flex items-center gap-4 hover:bg-white/[0.02] transition-colors flex-wrap sm:flex-nowrap${isMe ? ' ring-1 ring-inset ring-gta-teal/20' : ''}">
          <div class="shrink-0 w-8 text-center font-mono font-black text-lg leading-none" style="color:${rankColor}">${e.rank}</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1 flex-wrap">
              <span class="text-sm font-semibold ${isMe ? 'text-gta-teal' : 'text-zinc-200'}">${e.display}${isMe ? ' <span class="text-[11px] font-mono text-gta-teal/60 border border-gta-teal/20 px-1 rounded">you</span>' : ''}</span>
              <span class="text-[11px] font-mono text-zinc-500">${date}</span>
            </div>
            <div class="flex flex-wrap gap-1">${stackSummary}</div>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            ${isMe ? shareBtn : ''}
            <div class="text-right">
              <div class="text-xl font-mono font-bold text-gta-gold">${formatK(e.total_hr)}<span class="text-[11px] font-normal text-zinc-600">/hr</span></div>
              <div class="text-[11px] font-mono text-zinc-500">${e.stack.length} business${e.stack.length !== 1 ? 'es' : ''}</div>
            </div>
          </div>
        </div>`;
    }).join('');
    container.classList.remove('hidden');
  }

  async function loadLeaderboard(offset = 0) {
    const loading = document.getElementById('lb-loading')!;
    const error   = document.getElementById('lb-error')!;
    const empty   = document.getElementById('lb-empty')!;
    const rows    = document.getElementById('lb-rows')!;
    const meta    = document.getElementById('lb-meta')!;

    loading.classList.remove('hidden');
    error.classList.add('hidden');
    empty.classList.add('hidden');
    rows.classList.add('hidden');

    try {
      const weekParam = currentWeek ? `&week=${currentWeek}` : '';
      const res  = await fetch(`${WORKER_URL}/leaderboard?limit=${PAGE_SIZE}&offset=${offset}${weekParam}`);
      const data = await res.json();

      loading.classList.add('hidden');

      if (!data.entries || data.entries.length === 0) {
        empty.classList.remove('hidden');
        meta.textContent = '';
        return;
      }

      totalEntries  = data.total;
      currentOffset = offset;
      meta.textContent = `${data.total.toLocaleString()} player${data.total !== 1 ? 's' : ''}`;

      renderRows(data.entries);
      renderPagination();

    } catch (e) {
      loading.classList.add('hidden');
      error.classList.remove('hidden');
    }
  }

  function renderPagination() {
    const pager = document.getElementById('lb-pagination')!;
    const pages = Math.ceil(totalEntries / PAGE_SIZE);
    if (pages <= 1) { pager.classList.add('hidden'); return; }
    pager.classList.remove('hidden');
    const current = Math.floor(currentOffset / PAGE_SIZE);
    pager.innerHTML = Array.from({ length: Math.min(pages, 10) }, (_, i) => {
      const active = i === current;
      return `<button onclick="loadLeaderboard(${i * PAGE_SIZE})"
        class="px-3 py-1.5 rounded text-[10px] font-mono border transition-all ${active ? 'border-gta-gold/40 text-gta-gold bg-gta-gold/8' : 'border-[#2a2a31] text-zinc-500 hover:text-zinc-300'}">${i + 1}</button>`;
    }).join('');
  }

  // ── Last week's winner ────────────────────────────────────────────────────
  async function loadWinner() {
    try {
      const res  = await fetch(`${WORKER_URL}/leaderboard/winner`);
      if (!res.ok) return;
      const data = await res.json();
      if (!data.winner) return;

      const w       = data.winner;
      const banner  = document.getElementById('lb-winner-banner')!;
      const nameEl  = document.getElementById('lb-winner-name')!;
      const scoreEl = document.getElementById('lb-winner-score')!;
      const weekEl  = document.getElementById('lb-winner-week')!;
      const stackEl = document.getElementById('lb-winner-stack')!;
      const shareEl = document.getElementById('lb-winner-share') as HTMLAnchorElement;

      nameEl.textContent  = w.display || w.username;
      scoreEl.textContent = `${formatK(w.total_hr)}/hr · ${w.stack?.length ?? 0} businesses`;
      weekEl.textContent  = data.week_key ?? '';
      stackEl.innerHTML   = (w.stack ?? []).slice(0, 5).map((s: any) =>
        `<span class="text-[11px] font-mono text-gta-gold/60 border border-gta-gold/15 px-1.5 py-0.5 rounded">${s.name.split(' ')[0]}</span>`
      ).join('');

      const tweetText = `🥇 Last week's #1 on the GTAVI.AI community income leaderboard: ${w.display || w.username} with ${formatK(w.total_hr)}/hr. Can you top it this week? gtavi.ai/gta-online/bonuses`;
      shareEl.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweetText)}`;

      banner.classList.remove('hidden');
    } catch {
      // winner banner is non-critical — fail silently
    }
  }

  // Week filter buttons
  document.querySelectorAll<HTMLButtonElement>('.lb-week-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const week = btn.dataset.week!;
      currentWeek = week === 'current' ? new Date().toISOString().slice(0, 10) : '';
      document.querySelectorAll<HTMLButtonElement>('.lb-week-btn').forEach(b => {
        const active = b.dataset.week === week;
        b.className = b.className
          .replace(/border-gta-gold\/40|text-gta-gold|bg-gta-gold\/8|border-\[#2a2a31\]|text-zinc-500/g, '').trim();
        b.classList.add(...(active
          ? ['border-gta-gold/40', 'text-gta-gold', 'bg-gta-gold/8']
          : ['border-[#2a2a31]', 'text-zinc-500']));
      });
      loadLeaderboard(0);
    });
  });

  // Initial load
  loadLeaderboard(0);
  loadWinner();

  // Make loadLeaderboard available globally for retry link + pagination
  (window as any).loadLeaderboard = loadLeaderboard;
</script>
