---
import Base from "../../layouts/Base.astro";
import { C_LIVE, C_GROWTH, C_CARD, C_BG_DEEP, C_BRAND } from "../../config/colors";
import ShareDropdown from "../../components/ShareDropdown.astro";
import CrossLinks from "../../components/CrossLinks.astro";
import type { WeeklyBonusesData, SaleFrequencyData } from "../../types/gta";

import weeklyBonusesRaw from "../../../data/gta-5/economy/weekly-bonuses.json";
import bonusHistoryRaw  from "../../../data/gta-5/economy/bonus-history.json";
import saleFreqRaw      from "../../../data/gta-5/economy/sale-frequency.json";

const weeklyBonuses = weeklyBonusesRaw as unknown as WeeklyBonusesData;
const saleFreqData  = saleFreqRaw      as unknown as SaleFrequencyData;

const bonuses     = weeklyBonuses.bonuses  ?? [];
const sales       = weeklyBonuses.sales    ?? [];
const weekStart   = weeklyBonuses.week_start ?? "";
const historyCount = (bonusHistoryRaw as { entry_count?: number }).entry_count ?? 0;
const totalWeeks   = (saleFreqData as any).date_range?.total_weeks_tracked ?? 42;

// Worker URL — community leaderboard backed by Cloudflare KV
const WORKER_URL = "https://api.gtavi.ai";

// Frequency lookup — keyed by activity_id
const freqMap: Record<string, any> = Object.fromEntries(
  ((saleFreqData.activity_bonuses ?? []) as any[]).map((a: any) => [a.activity_id, a])
);

// Activity metadata: proper labels, thumbnails, income card links
interface ActivityMeta {
  label: string;
  thumb: string;
  href?: string;
  description: string;
}
const ACTIVITY_META: Record<string, ActivityMeta> = {
  "contact-missions":   { label: "Contact Missions",    thumb: "/assets/gta5/dlc/freemode-events.jpg",      href: "/gta-online/income",                          description: "Work for contacts — Martin, Simeon, Lester, Gerald. 50+ missions, repeatable for cash." },
  "casino-missions":    { label: "Casino Work",          thumb: "/assets/gta5/dlc/casino-work.jpg",          href: "/gta-online/income/diamond-casino-heist",     description: "Story missions and mini-jobs at the Diamond Casino & Resort." },
  "casino-heist":       { label: "Diamond Casino Heist", thumb: "/assets/gta5/dlc/diamond-casino-heist.jpg", href: "/gta-online/income/diamond-casino-heist",     description: "Multi-stage heist with up to $3.62M payout depending on vault contents." },
  "vip-work":           { label: "VIP / CEO Work",       thumb: "/assets/gta5/dlc/finance-felony.jpg",       href: "/database?game=gta-online",                   description: "Organisation missions as a VIP, CEO or MC President. Includes Sightseer, Headhunter, etc." },
  "heists":             { label: "Heists",                thumb: "/assets/gta5/dlc/cayo-perico.jpg",          href: "/gta-online/income/cayo-perico",               description: "All heist series — includes Cayo Perico, Diamond Casino and the original five." },
  "cayo-perico":        { label: "Cayo Perico Heist",    thumb: "/assets/gta5/dlc/cayo-perico.jpg",          href: "/gta-online/income/cayo-perico",               description: "Solo heist, best $/hr in the game. $1.1–1.9M per run depending on loot." },
  "acid-lab":           { label: "Acid Lab",             thumb: "/assets/gta5/dlc/acid-lab.jpg",             href: "/gta-online/income/acid-lab",                  description: "First Dose story missions unlock a passive acid lab business. S-tier $/hr." },
  "nightclub":          { label: "Nightclub",            thumb: "/assets/gta5/dlc/after-hours.jpg",          href: "/gta-online/income/nightclub",                 description: "Passive business: technicians generate stock from your other operations overnight." },
  "bunker":             { label: "Bunker",               thumb: "/assets/gta5/dlc/gunrunning.jpg",           href: "/gta-online/income/bunker",                    description: "Gunrunning supply chain — buy supplies, staff research, sell for profit." },
  "auto-shop":          { label: "Auto Shop",            thumb: "/assets/gta5/dlc/auto-shop.jpg",            href: "/gta-online/income/auto-shop",                 description: "Vehicle workshop with robbery contracts and mod shop passive income." },
  "agency":             { label: "Agency / VIP Contract",thumb: "/assets/gta5/dlc/agency.jpg",               href: "/gta-online/income/agency-vip-contract",       description: "Dr Dre's security contract is the top agency mission at $1M per run." },
  "robbery-contracts":  { label: "Robbery Contracts",   thumb: "/assets/gta5/dlc/robbery-contracts.jpg",    href: "/gta-online/income/agency-vip-contract",       description: "Short, high-payout contracts available from your auto shop." },
  "races":              { label: "Races",                thumb: "/assets/gta5/dlc/premium-races.jpg",                                                             description: "Standard and premium street, sea and air races. Good with bonus RP/GTA$." },
  "stunt-races":        { label: "Stunt Races",          thumb: "/assets/gta5/dlc/arena-war.jpg",                                                                 description: "Aerial and ground stunt race circuits with premium multiplier events." },
  "adversary":          { label: "Adversary Modes",      thumb: "/assets/gta5/dlc/arena-war.jpg",                                                                 description: "Competitive team-vs-team modes including Motor Wars and Overtime Rumble." },
  "survival":           { label: "Survival",             thumb: "/assets/gta5/dlc/freemode-events.jpg",                                                           description: "Wave-based enemy survival — up to 10 waves, playable solo or in a group." },
  "security-contracts": { label: "Security Contracts",  thumb: "/assets/gta5/dlc/security-contracts.jpg",   href: "/gta-online/income/security-contracts",        description: "Short missions for agency clients. Fast, repeatable, and solo-friendly." },
  "mc-businesses":      { label: "MC Businesses",        thumb: "/assets/gta5/dlc/bikers.jpg",               href: "/database?game=gta-online",                    description: "Cocaine, meth, counterfeit cash, forgeries and document forgery operations." },
};

function getActivityMeta(id: string): ActivityMeta {
  return ACTIVITY_META[id] ?? {
    label:       id.replace(/-/g, " ").replace(/\b\w/g, (c: string) => c.toUpperCase()),
    thumb:       "/assets/gta5/dlc/freemode-events.jpg",
    description: "GTA Online bonus activity.",
  };
}
---
<Base
  title="GTA Online Bonuses, Promos & Leaderboard"
  description="GTA Online weekly bonus calendar, sale intelligence, promotional history and community income leaderboard. Every Thursday's events tracked since 2013."
  ogPage="leaderboard"
>

  <!-- Hero -->
  <section class="relative border-b border-[#1e1e23] overflow-hidden" style="min-height:180px">
    <div class="absolute inset-0" style={`background:radial-gradient(ellipse at 70% 50%, color-mix(in srgb,${C_GROWTH} 7%,transparent) 0%, transparent 55%), ${C_BG_DEEP}`}></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-2">// GTA Online · Promotions & Community</div>
          <h1 class="text-3xl font-bold text-white mb-2">
            Bonuses, Promos &amp; Leaderboard
          </h1>
          <p class="text-sm text-zinc-400 max-w-lg">
            Weekly bonus calendar · sale intelligence · {historyCount} weeks tracked · community income rankings
          </p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <ShareDropdown anchorId="bonuses" shareText="GTA Online weekly bonuses, promotions and community income leaderboard — {historyCount} weeks tracked since 2013. GTAVI.AI" size="sm" />
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">

    <!-- ═══════════════════════════════════════════════════
         ACTIVE BONUS EVENTS — visual card grid
    ═══════════════════════════════════════════════════ -->
    {bonuses.length > 0 && (
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse shrink-0"></span>
          <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-[0.2em]">
            Active bonuses{weekStart ? ` · w/c ${weekStart}` : ""}
          </span>
          <div class="flex-1 h-px bg-[#1e1e23]"></div>
          <a href="/charts?title=gta-online#section-bonus-heatmap"
             class="shrink-0 text-[10px] font-mono text-zinc-500 hover:text-zinc-200 border border-[#2a2a31] hover:border-zinc-600 px-3 py-1 rounded transition-colors uppercase tracking-widest">
            Full history →
          </a>
        </div>

        <div class={`grid gap-4 ${bonuses.length === 1 ? "grid-cols-1 max-w-lg" : bonuses.length === 2 ? "grid-cols-1 sm:grid-cols-2" : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"}`}>
          {bonuses.map((b: any) => {
            const meta  = getActivityMeta(b.activity_id);
            const freq  = freqMap[b.activity_id];
            const count = freq?.bonus_count ?? null;
            const isBig = b.multiplier >= 3;
            const multiplierColor = isBig ? C_BRAND : C_LIVE;

            return (
              <div class="group relative rounded-xl border border-[#1e1e23] hover:border-[#2a2a31] overflow-hidden transition-all"
                   style={`background:${C_CARD};border-left:3px solid color-mix(in srgb,${multiplierColor} 60%,transparent)`}>

                {/* Thumbnail */}
                <div class="relative h-32 overflow-hidden">
                  <img src={meta.thumb} alt={meta.label}
                       class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                       loading="lazy" />
                  <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(0,0,0,0.15) 0%,rgba(0,0,0,0.6) 100%)"></div>

                  {/* Multiplier badge — top-left */}
                  <div class="absolute top-3 left-3 flex items-baseline gap-0.5 px-2.5 py-1 rounded-lg font-mono font-black"
                       style={`background:color-mix(in srgb,${multiplierColor} 18%,rgba(0,0,0,0.7));border:1px solid color-mix(in srgb,${multiplierColor} 50%,transparent);color:${multiplierColor}`}>
                    <span class="text-2xl leading-none">{b.multiplier}</span>
                    <span class="text-sm">×</span>
                    <span class="text-[10px] ml-1 font-normal uppercase tracking-widest opacity-80">GTA$</span>
                  </div>

                  {/* ACTIVE NOW badge — top-right */}
                  <div class="absolute top-3 right-3 flex items-center gap-1 px-2 py-1 rounded font-mono text-[9px] uppercase tracking-widest"
                       style={`background:color-mix(in srgb,${C_GROWTH} 18%,rgba(0,0,0,0.7));border:1px solid color-mix(in srgb,${C_GROWTH} 40%,transparent);color:${C_GROWTH}`}>
                    <span class="w-1 h-1 rounded-full animate-pulse" style={`background:${C_GROWTH}`}></span>
                    Active
                  </div>
                </div>

                {/* Body */}
                <div class="px-4 pt-3 pb-2">
                  <div class="text-base font-semibold text-zinc-100 mb-1 leading-tight">{meta.label}</div>
                  <p class="text-[11px] font-mono text-zinc-500 leading-snug line-clamp-2">{meta.description}</p>
                </div>

                {/* Frequency context */}
                {count !== null && (
                  <div class="px-4 py-2 border-t border-[#1e1e23] flex items-center justify-between gap-2">
                    <span class="text-[10px] font-mono text-zinc-600">
                      Bonused <span class="text-zinc-400">{count}×</span> in {totalWeeks} weeks
                      {freq?.avg_gap_weeks ? <span> · ~{Math.round(freq.avg_gap_weeks)}w avg</span> : null}
                    </span>
                    {meta.href && (
                      <a href={meta.href}
                         class="shrink-0 text-[10px] font-mono uppercase tracking-widest transition-colors"
                         style={`color:color-mix(in srgb,${multiplierColor} 70%,transparent)`}
                         onmouseover={`this.style.color='${multiplierColor}'`}
                         onmouseout={`this.style.color='color-mix(in srgb,${multiplierColor} 70%,transparent)'`}>
                        Income profile →
                      </a>
                    )}
                  </div>
                )}
                {count === null && meta.href && (
                  <div class="px-4 py-2 border-t border-[#1e1e23]">
                    <a href={meta.href}
                       class="text-[10px] font-mono uppercase tracking-widest transition-colors"
                       style={`color:color-mix(in srgb,${multiplierColor} 70%,transparent)`}
                       onmouseover={`this.style.color='${multiplierColor}'`}
                       onmouseout={`this.style.color='color-mix(in srgb,${multiplierColor} 70%,transparent)'`}>
                      Income profile →
                    </a>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- ═══════════════════════════════════════════════════
         ON SALE THIS WEEK
    ═══════════════════════════════════════════════════ -->
    {sales.length > 0 && (
      <div class="mb-8 rounded-xl border border-[#1e1e23] overflow-hidden" style={`background:${C_CARD}`}>
        <div class="px-5 py-3 border-b border-[#1e1e23] flex items-center gap-2">
          <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em]">On Sale This Week</span>
          <div class="flex-1 h-px bg-[#1e1e23]"></div>
        </div>
        <div class="divide-y divide-[#1e1e23]">
          {sales.map((s: any) => (
            <div class="px-5 py-3 flex items-center gap-3">
              <span class="shrink-0 font-mono font-bold text-sm w-12"
                    style={`color:${C_GROWTH};background:color-mix(in srgb,${C_GROWTH} 10%,transparent);border:1px solid color-mix(in srgb,${C_GROWTH} 25%,transparent);padding:2px 6px;border-radius:4px`}>
                {s.discount_pct}%
              </span>
              <span class="text-sm text-zinc-300 flex-1">{s.item_description}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    {bonuses.length === 0 && sales.length === 0 && (
      <div class="mb-8 rounded-xl border border-[#1e1e23] px-6 py-10 text-center" style={`background:${C_CARD}`}>
        <div class="text-zinc-500 font-mono text-sm">No bonus events found for this week. Check back Thursday.</div>
      </div>
    )}

    <!-- Last week's winner banner (populated by JS) -->
    <div id="lb-winner-banner" class="hidden mb-6 rounded-xl border border-gta-gold/30 overflow-hidden" style={`background:${C_CARD}`}>
      <div class="px-5 py-3 border-b border-gta-gold/15 flex items-center gap-2">
        <span class="text-[11px] font-mono text-gta-gold/70 uppercase tracking-widest">Last Week's Winner</span>
        <div class="flex-1 h-px bg-gta-gold/10"></div>
        <span id="lb-winner-week" class="text-[11px] font-mono text-zinc-600"></span>
      </div>
      <div class="px-5 py-4 flex items-center gap-5 flex-wrap">
        <div class="flex items-center gap-3">
          <div class="text-4xl font-black text-gta-gold">#1</div>
          <div>
            <div id="lb-winner-name" class="text-base font-bold text-zinc-100"></div>
            <div id="lb-winner-score" class="text-[11px] font-mono text-gta-gold"></div>
          </div>
        </div>
        <div id="lb-winner-stack" class="flex flex-wrap gap-1.5 flex-1"></div>
        <a id="lb-winner-share" href="#" target="_blank" rel="noopener noreferrer"
          class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded border border-gta-gold/30 text-gta-gold text-[10px] font-mono hover:bg-gta-gold/8 transition-colors uppercase tracking-widest">
          Tweet winner
        </a>
      </div>
    </div>

    <!-- Week filter + stats row -->
    <div class="flex items-center gap-3 mb-6 flex-wrap">
      <div class="flex items-center gap-2">
        <span class="text-[11px] font-mono text-zinc-600 uppercase tracking-widest">Week</span>
        <button id="lb-filter-all"  class="lb-week-btn px-2.5 py-1 rounded text-[10px] font-mono border border-gta-gold/40 text-gta-gold bg-gta-gold/8 transition-all" data-week="">All time</button>
        <button id="lb-filter-week" class="lb-week-btn px-2.5 py-1 rounded text-[10px] font-mono border border-[#2a2a31] text-zinc-500 hover:border-zinc-600 transition-all" data-week="current">This week</button>
      </div>
      <div class="flex-1 h-px bg-[#1e1e23]"></div>
      <div id="lb-meta" class="text-[10px] font-mono text-zinc-600"></div>
    </div>

    <!-- Leaderboard table -->
    <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style={`background:${C_CARD}`}>

      <!-- Loading state -->
      <div id="lb-loading" class="py-16 text-center">
        <div class="text-zinc-600 font-mono text-sm animate-pulse">Loading leaderboard…</div>
      </div>

      <!-- Error state -->
      <div id="lb-error" class="hidden py-16 text-center">
        <div class="text-zinc-600 font-mono text-sm">Could not load leaderboard. <a href="" class="text-gta-teal" onclick="loadLeaderboard();return false">Retry →</a></div>
      </div>

      <!-- Empty state -->
      <div id="lb-empty" class="hidden py-16 text-center">
        <div class="text-zinc-600 font-mono text-sm mb-2">No submissions yet.</div>
        <a href="/gta-online/income#income-adviser" class="text-[11px] font-mono text-gta-teal hover:text-gta-teal/80 transition-colors">Be the first — submit your stack →</a>
      </div>

      <!-- Leaderboard rows -->
      <div id="lb-rows" class="hidden divide-y divide-[#1e1e23]"></div>

    </div>

    <!-- Pagination -->
    <div id="lb-pagination" class="hidden flex justify-center gap-2 mt-6"></div>

    <!-- Call to action -->
    <div class="mt-8 rounded-xl border border-gta-teal/20 p-5 flex items-center justify-between flex-wrap gap-4" style={`background:${C_CARD}`}>
      <div>
        <div class="text-[10px] font-mono text-gta-teal/60 uppercase tracking-widest mb-1">Want to appear here?</div>
        <div class="text-sm font-semibold text-zinc-200">Build your income stack on GTA V → Income Adviser and opt in</div>
        <div class="text-[11px] text-zinc-500 font-mono mt-0.5">Select your businesses → click "Share my stack to the community leaderboard"</div>
      </div>
      <a href="/gta-online/income#income-adviser"
        class="shrink-0 px-4 py-2 rounded border border-gta-teal/30 text-gta-teal text-[11px] font-mono hover:bg-gta-teal/8 transition-colors uppercase tracking-widest">
        Open Adviser →
      </a>
    </div>

    <div class="mt-8">
      <CrossLinks context="gta-online-bonuses" />
    </div>

  </div>
</Base>

<script>
  import { C_BRAND, C_TEXT_2, C_LIVE, C_TEXT_7 } from '../../config/colors';

  const WORKER_URL = 'https://api.gtavi.ai';
  const PAGE_SIZE  = 25;
  const LS_KEY     = 'gtaviai_lb_username';

  let currentWeek   = '';
  let currentOffset = 0;
  let totalEntries  = 0;

  // Username saved after submitting from IncomeAdviser
  const myUsername: string = (typeof localStorage !== 'undefined' && localStorage.getItem(LS_KEY)) || '';

  function formatK(n: number): string {
    if (n >= 1e6) return `$${(n / 1e6).toFixed(1)}M`;
    return `$${Math.round(n / 1000)}K`;
  }

  function tierColor(rank: number): string {
    if (rank === 1) return C_BRAND;
    if (rank <= 3) return C_TEXT_2;
    if (rank <= 10) return C_LIVE;
    return C_TEXT_7;
  }

  function tweetShareUrl(rank: number, display: string, total_hr: number): string {
    const score = formatK(total_hr);
    const tier  = rank === 1 ? '🥇' : rank <= 3 ? '🥈' : rank <= 10 ? '🏆' : `#${rank}`;
    const text  = `${tier} Rank #${rank} with ${score}/hr on the GTAVI.AI community income leaderboard. Can you beat me? gtavi.ai/gta-online/bonuses`;
    return `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}`;
  }

  function renderRows(entries: any[]) {
    const container = document.getElementById('lb-rows')!;
    container.innerHTML = entries.map(e => {
      const isMe = myUsername && e.username === myUsername;
      const stackSummary = e.stack.slice(0, 4).map((s: any) =>
        `<span class="text-[11px] font-mono text-zinc-600 border border-[#2a2a31] px-1.5 py-0.5 rounded">${s.name.split(' ')[0]}</span>`
      ).join(' ') + (e.stack.length > 4 ? ` <span class="text-[11px] font-mono text-zinc-500">+${e.stack.length - 4}</span>` : '');

      const rankColor = tierColor(e.rank);
      const date = new Date(e.submitted_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
      const shareBtn = `<a href="${tweetShareUrl(e.rank, e.display, e.total_hr)}" target="_blank" rel="noopener noreferrer"
        class="shrink-0 flex items-center gap-1 px-2 py-1 rounded border border-gta-gold/20 text-gta-gold/70 text-[11px] font-mono hover:border-gta-gold/50 hover:text-gta-gold transition-colors uppercase tracking-widest"
        title="Tweet your rank">
        Tweet rank
      </a>`;

      return `
        <div class="px-4 py-3.5 flex items-center gap-4 hover:bg-white/[0.02] transition-colors flex-wrap sm:flex-nowrap${isMe ? ' ring-1 ring-inset ring-gta-teal/20' : ''}">
          <div class="shrink-0 w-8 text-center font-mono font-black text-lg leading-none" style="color:${rankColor}">${e.rank}</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1 flex-wrap">
              <span class="text-sm font-semibold ${isMe ? 'text-gta-teal' : 'text-zinc-200'}">${e.display}${isMe ? ' <span class="text-[11px] font-mono text-gta-teal/60 border border-gta-teal/20 px-1 rounded">you</span>' : ''}</span>
              <span class="text-[11px] font-mono text-zinc-500">${date}</span>
            </div>
            <div class="flex flex-wrap gap-1">${stackSummary}</div>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            ${isMe ? shareBtn : ''}
            <div class="text-right">
              <div class="text-xl font-mono font-bold text-gta-gold">${formatK(e.total_hr)}<span class="text-[11px] font-normal text-zinc-600">/hr</span></div>
              <div class="text-[11px] font-mono text-zinc-500">${e.stack.length} business${e.stack.length !== 1 ? 'es' : ''}</div>
            </div>
          </div>
        </div>`;
    }).join('');
    container.classList.remove('hidden');
  }

  async function loadLeaderboard(offset = 0) {
    const loading = document.getElementById('lb-loading')!;
    const error   = document.getElementById('lb-error')!;
    const empty   = document.getElementById('lb-empty')!;
    const rows    = document.getElementById('lb-rows')!;
    const meta    = document.getElementById('lb-meta')!;

    loading.classList.remove('hidden');
    error.classList.add('hidden');
    empty.classList.add('hidden');
    rows.classList.add('hidden');

    try {
      const weekParam = currentWeek ? `&week=${currentWeek}` : '';
      const res  = await fetch(`${WORKER_URL}/leaderboard?limit=${PAGE_SIZE}&offset=${offset}${weekParam}`);
      const data = await res.json();

      loading.classList.add('hidden');

      if (!data.entries || data.entries.length === 0) {
        empty.classList.remove('hidden');
        meta.textContent = '';
        return;
      }

      totalEntries  = data.total;
      currentOffset = offset;
      meta.textContent = `${data.total.toLocaleString()} player${data.total !== 1 ? 's' : ''}`;

      renderRows(data.entries);
      renderPagination();

    } catch (e) {
      loading.classList.add('hidden');
      error.classList.remove('hidden');
    }
  }

  function renderPagination() {
    const pager = document.getElementById('lb-pagination')!;
    const pages = Math.ceil(totalEntries / PAGE_SIZE);
    if (pages <= 1) { pager.classList.add('hidden'); return; }
    pager.classList.remove('hidden');
    const current = Math.floor(currentOffset / PAGE_SIZE);
    pager.innerHTML = Array.from({ length: Math.min(pages, 10) }, (_, i) => {
      const active = i === current;
      return `<button onclick="loadLeaderboard(${i * PAGE_SIZE})"
        class="px-3 py-1.5 rounded text-[10px] font-mono border transition-all ${active ? 'border-gta-gold/40 text-gta-gold bg-gta-gold/8' : 'border-[#2a2a31] text-zinc-500 hover:text-zinc-300'}">${i + 1}</button>`;
    }).join('');
  }

  // ── Last week's winner ────────────────────────────────────────────────────
  async function loadWinner() {
    try {
      const res  = await fetch(`${WORKER_URL}/leaderboard/winner`);
      if (!res.ok) return;
      const data = await res.json();
      if (!data.winner) return;

      const w       = data.winner;
      const banner  = document.getElementById('lb-winner-banner')!;
      const nameEl  = document.getElementById('lb-winner-name')!;
      const scoreEl = document.getElementById('lb-winner-score')!;
      const weekEl  = document.getElementById('lb-winner-week')!;
      const stackEl = document.getElementById('lb-winner-stack')!;
      const shareEl = document.getElementById('lb-winner-share') as HTMLAnchorElement;

      nameEl.textContent  = w.display || w.username;
      scoreEl.textContent = `${formatK(w.total_hr)}/hr · ${w.stack?.length ?? 0} businesses`;
      weekEl.textContent  = data.week_key ?? '';
      stackEl.innerHTML   = (w.stack ?? []).slice(0, 5).map((s: any) =>
        `<span class="text-[11px] font-mono text-gta-gold/60 border border-gta-gold/15 px-1.5 py-0.5 rounded">${s.name.split(' ')[0]}</span>`
      ).join('');

      const tweetText = `🥇 Last week's #1 on the GTAVI.AI community income leaderboard: ${w.display || w.username} with ${formatK(w.total_hr)}/hr. Can you top it this week? gtavi.ai/gta-online/bonuses`;
      shareEl.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweetText)}`;

      banner.classList.remove('hidden');
    } catch {
      // winner banner is non-critical — fail silently
    }
  }

  // Week filter buttons
  document.querySelectorAll<HTMLButtonElement>('.lb-week-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const week = btn.dataset.week!;
      currentWeek = week === 'current' ? new Date().toISOString().slice(0, 10) : '';
      document.querySelectorAll<HTMLButtonElement>('.lb-week-btn').forEach(b => {
        const active = b.dataset.week === week;
        b.className = b.className
          .replace(/border-gta-gold\/40|text-gta-gold|bg-gta-gold\/8|border-\[#2a2a31\]|text-zinc-500/g, '').trim();
        b.classList.add(...(active
          ? ['border-gta-gold/40', 'text-gta-gold', 'bg-gta-gold/8']
          : ['border-[#2a2a31]', 'text-zinc-500']));
      });
      loadLeaderboard(0);
    });
  });

  // Initial load
  loadLeaderboard(0);
  loadWinner();

  // Make loadLeaderboard available globally for retry link + pagination
  (window as any).loadLeaderboard = loadLeaderboard;
</script>
