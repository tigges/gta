---
import Base from "../../layouts/Base.astro";
---

<Base
  titleContext="franchise"
  title="GTA Franchise Charts"
  description="Grand Theft Auto franchise charts — sales velocity, CPI-adjusted pricing, critic vs user score divergence, DLC cadence, cross-title economic complexity and earnings curve."
  ogPage="franchise"
  crossLinksContext="franchise"
>
  <!-- Breadcrumb -->
  <div class="border-b border-border-dim" style="background:var(--c-bg-deep)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center gap-2 text-[10px] font-mono text-zinc-600">
      <a href="/franchise" class="hover:text-zinc-400 transition-colors">Franchise</a>
      <span class="text-zinc-800">›</span>
      <span class="text-zinc-500">Charts</span>
    </div>
  </div>

  <section class="border-b border-border-dim" style="background:var(--c-bg-deep)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">// Grand Theft Auto · Data Visualised</div>
      <h1 class="text-3xl font-bold text-white mb-3">Franchise Charts</h1>
      <p class="text-sm text-zinc-400 max-w-lg">
        Cross-title analysis — 30 years of sales, scores, economic complexity and earnings data visualised.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">

    <!-- Chart deep-links -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
      {[
        { href: "/charts#sales-chart",                icon: "💰", label: "Franchise Sales Velocity",    sub: "All titles · copies sold · GTA V 225M" },
        { href: "/charts#franchise-complexity-chart",  icon: "🧠", label: "Economic Complexity",        sub: "1/10 in 1997 → 10/10 GTA Online" },
        { href: "/charts#franchise-earnings-chart",    icon: "⏱", label: "Cross-Title Earnings Curve", sub: "Hours to endgame per title · Big Mac Index" },
        { href: "/charts#cpi-chart",                   icon: "💵", label: "CPI-Adjusted Pricing",       sub: "Is $79.99 cheap vs GTA III in 2001?" },
        { href: "/charts#divergence-chart",            icon: "⭐", label: "Critic vs User Divergence",   sub: "GTA SA aligned · GTA IV opened 22pts" },
        { href: "/charts#dlc-cadence-chart",           icon: "📅", label: "DLC Cadence",                sub: "38 content drops across 11 years" },
        { href: "/charts#delay-timeline-chart",        icon: "⏰", label: "GTA VI Delay Timeline",      sub: "Full announcement → launch timeline" },
        { href: "/charts#ttwo-stock-chart",            icon: "📊", label: "Take-Two Stock",             sub: "Tracks GTA announcement cycles" },
        { href: "/charts#competitors-chart",           icon: "🏁", label: "Competitor Comparison",      sub: "RDR2 · GTAV · GTA VI projected" },
      ].map(c => (
        <a href={c.href}
           class="group rounded-xl border border-border-dim hover:border-zinc-700 p-4 flex items-start gap-3 transition-all"
           style="background:var(--c-card)">
          <span class="text-xl shrink-0 mt-0.5">{c.icon}</span>
          <div>
            <div class="font-semibold text-zinc-200 text-sm mb-0.5 group-hover:text-white transition-colors">{c.label}</div>
            <div class="text-[10px] font-mono text-zinc-600">{c.sub}</div>
          </div>
          <span class="text-zinc-500 group-hover:text-zinc-400 font-mono text-[10px] ml-auto shrink-0 mt-1 transition-colors">→</span>
        </a>
      ))}
    </div>

    <!-- All charts link -->
    <div class="rounded-xl border border-border-dim px-5 py-4 flex items-center gap-4 mb-10" style="background:var(--c-card)">
      <div class="flex-1">
        <div class="font-semibold text-zinc-200 text-sm mb-1">All 35+ Charts — Including GTA Online & Community Data</div>
        <div class="text-[10px] font-mono text-zinc-600">Filter by Economy, Promotions, Performance, Community or History categories.</div>
      </div>
      <a href="/charts" class="shrink-0 px-3 py-2 rounded border border-gta-gold/30 text-gta-gold text-[10px] font-mono hover:bg-gta-gold/20 transition-all">
        All charts →
      </a>
    </div>

  </div>
</Base>
