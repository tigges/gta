---
import Base from "../../layouts/Base.astro";
import { C_LIVE, C_GROWTH, C_BRAND, C_CARD, C_BG_DEEP } from "../../config/colors";
import CrossLinks from "../../components/CrossLinks.astro";
import ReleaseTimeline from "../../components/ReleaseTimeline.astro";
import GamePill from "../../components/GamePill.astro";
import ShareDropdown from "../../components/ShareDropdown.astro";

import salesData     from "../../../data/franchise/sales.json";
import metacriticData from "../../../data/franchise/metacritic.json";
import releasesData  from "../../../data/shared/releases.json";
import vgchartzData  from "../../../data/franchise/vgchartz.json";

const titles    = (salesData as any).titles as any[];
const scores    = ((metacriticData as any).titles as any[]);
const releases  = (releasesData as any).releases as any[];
const vgTitles  = ((vgchartzData as any).titles as any[]).filter((t: any) => t.total_m);

// Cover images by game id (used in both tables)
const COVERS: Record<string, string> = {
  "gta-1":  "/assets/covers/gta-1.jpg",
  "gta-2":  "/assets/covers/gta-2.jpg",
  "gta-3":  "/assets/covers/gta-3.jpg",
  "gta-vc": "/assets/covers/gta-vc.jpg",
  "gta-sa": "/assets/covers/gta-sa.jpg",
  "gta-4":  "/assets/covers/gta-4.jpg",
  "gta-5":  "/assets/covers/gta-5.jpg",
  "gta-6":  "/assets/covers/gta-6.jpg",
};
---

<Base
  titleContext="franchise"
  title="GTA Franchise History & Sales"
  description="Grand Theft Auto franchise sales history, Metacritic scores, map size progression and DLC timeline across all 8 main titles from 1997 to 2026."
  ogPage="franchise"
>
  <!-- Breadcrumb -->
  <div class="border-b border-[#1e1e23]" style={`background:${C_BG_DEEP}`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center gap-2 text-[10px] font-mono text-zinc-600">
      <a href="/franchise" class="hover:text-zinc-400 transition-colors">Franchise</a>
      <span class="text-zinc-800">›</span>
      <span class="text-zinc-500">History & Sales</span>
    </div>
  </div>

  <section class="border-b border-[#1e1e23]" style={`background:${C_BG_DEEP}`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
      <div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.2em] mb-3">// Grand Theft Auto · Franchise Data</div>
      <h1 class="text-3xl font-bold text-white mb-3">History & Sales</h1>
      <p class="text-sm text-zinc-400 max-w-lg">
        Sales figures, Metacritic scores, and release timeline across all GTA titles — 1997 to 2026.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 flex flex-col gap-10">

    <!-- Metacritic scores table -->
    {scores.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-5">
          <GamePill game="franchise" size="xs" />
          <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Critic & User Scores</span>
          <div class="flex-1 h-px bg-[#1e1e23]"></div>
        </div>
        <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style={`background:${C_CARD}`}>
          <div class="overflow-x-auto">
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="border-b border-[#1e1e23]">
                  <th class="text-left px-5 py-3 text-zinc-600 font-normal">Title</th>
                  <th class="text-right px-3 py-3 text-zinc-600 font-normal">Year</th>
                  <th class="text-right px-3 py-3 text-zinc-600 font-normal">Metacritic</th>
                  <th class="text-right px-5 py-3 text-zinc-600 font-normal">User Score</th>
                </tr>
              </thead>
              <tbody>
                {scores.filter((t: any) => t.critic_score).sort((a: any, b: any) => b.year - a.year).map((t: any) => (
                  <tr class="border-b border-[#1e1e23]/50 hover:bg-white/[0.02] transition-colors">
                    <td class="px-5 py-3">
                      <div class="flex items-center gap-3">
                        {COVERS[t.id] && (
                          <img src={COVERS[t.id]} alt={t.short}
                               class="w-8 h-11 object-cover rounded border border-[#2a2a31] shrink-0"
                               loading="lazy" />
                        )}
                        <div>
                          <div class="font-semibold text-zinc-200">{t.short ?? t.id}</div>
                          <div class="text-[10px] font-mono text-zinc-600">{t.platform ?? ""}</div>
                        </div>
                      </div>
                    </td>
                    <td class="px-3 py-3 text-right text-zinc-500">{t.year}</td>
                    <td class="px-3 py-3 text-right">
                      <span class="font-bold text-sm" style={`color:${t.critic_score >= 95 ? C_GROWTH : t.critic_score >= 85 ? C_BRAND : C_LIVE}`}>
                        {t.critic_score}
                      </span>
                    </td>
                    <td class="px-5 py-3 text-right text-zinc-500">{t.user_score ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
            <span class="text-[10px] text-zinc-600 font-mono">Source: Metacritic.com · scores as at last review</span>
            <ShareDropdown anchorId="metacritic-scores" shareText="GTA franchise Metacritic scores: GTA SA 95, GTA IV 98, GTA V 97. The critical arc of 25 years of Grand Theft Auto." size="sm" />
          </div>
        </div>
      </section>
    )}

    <!-- Release timeline -->
    <section id="metacritic-scores">
      <div class="flex items-center gap-3 mb-5">
        <GamePill game="franchise" size="xs" />
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Release Timeline</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
      </div>
      <ReleaseTimeline releases={releases} />
    </section>

    <!-- VGChartz regional breakdown -->
    {vgTitles.length > 0 && (
    <section>
      <div class="flex items-center gap-3 mb-5">
        <GamePill game="franchise" size="xs" />
        <span class="text-[10px] font-mono text-zinc-600 tracking-[0.2em] uppercase">// Regional Sales Breakdown</span>
        <div class="flex-1 h-px bg-[#1e1e23]"></div>
        <span class="text-[10px] font-mono text-zinc-500">NA · EU · JP · Other · Source: VGChartz</span>
      </div>
      <div class="rounded-xl border border-[#1e1e23] overflow-hidden" style={`background:${C_CARD}`}>
        <table class="w-full text-xs font-mono">
          <thead>
            <tr class="border-b border-[#1e1e23]">
              <th class="text-left px-5 py-2.5 text-zinc-600 font-normal">Title</th>
              <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">
                <span class="text-base leading-none" title="North America">🇺🇸</span>
                <span class="text-[10px] ml-1">NA</span>
              </th>
              <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">
                <span class="text-base leading-none" title="Europe">🇪🇺</span>
                <span class="text-[10px] ml-1">EU</span>
              </th>
              <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">
                <span class="text-base leading-none" title="Japan">🇯🇵</span>
                <span class="text-[10px] ml-1">JP</span>
              </th>
              <th class="text-right px-4 py-2.5 text-zinc-600 font-normal">
                <span class="text-base leading-none" title="Rest of World">🌍</span>
                <span class="text-[10px] ml-1">Other</span>
              </th>
              <th class="text-right px-5 py-2.5 text-zinc-600 font-normal">Total</th>
            </tr>
          </thead>
          <tbody>
            {vgTitles.map((t: any) => {
              const totalMax = Math.max(...vgTitles.map((x: any) => x.total_m));
              const barPct = Math.round((t.total_m / totalMax) * 100);
              return (
                <tr class="border-b border-[#1e1e23]/50 hover:bg-white/[0.02] transition-colors">
                  <td class="px-5 py-3">
                    <div class="flex items-center gap-3">
                      {COVERS[t.id] && (
                        <img src={COVERS[t.id]} alt={t.short}
                             class="w-8 h-11 object-cover rounded border border-[#2a2a31] shrink-0"
                             loading="lazy" />
                      )}
                      <div>
                        <div class="text-zinc-200 font-semibold">{t.short}</div>
                        <div class="h-1 rounded-full bg-[#1e1e23] overflow-hidden w-20 mt-1.5">
                          <div class="h-full rounded-full bg-gta-gold/50" style={`width:${barPct}%`}></div>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-right text-zinc-400">{t.na_m?.toFixed(1) ?? "—"}M</td>
                  <td class="px-4 py-3 text-right text-zinc-400">{t.eu_m?.toFixed(1) ?? "—"}M</td>
                  <td class="px-4 py-3 text-right text-zinc-500">{t.jp_m?.toFixed(1) ?? "—"}M</td>
                  <td class="px-4 py-3 text-right text-zinc-500">{t.other_m?.toFixed(1) ?? "—"}M</td>
                  <td class="px-5 py-3 text-right font-bold text-gta-gold">{t.total_m?.toFixed(2)}M</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div class="px-5 py-3 border-t border-[#1e1e23] flex items-center justify-between gap-3">
          <span class="text-[10px] text-zinc-600 font-mono">Source: VGChartz · regional estimates · may differ from publisher figures</span>
          <ShareDropdown anchorId="regional-sales" shareText="GTA franchise regional sales: GTA V sold 90M in NA, 88M in EU. Total 225M copies — the best-selling franchise of the last decade." size="sm" />
        </div>
      </div>
    </section>
    )}

    <!-- Charts cross-link -->
    <div class="rounded-xl border border-[#1e1e23] px-5 py-4 flex items-center gap-4" style={`background:${C_CARD}`}>
      <div class="flex-1">
        <div class="font-semibold text-zinc-200 text-sm mb-1">Franchise Data Charts</div>
        <div class="text-[10px] font-mono text-zinc-600">Sales velocity, CPI-adjusted pricing, critic divergence, DLC cadence and cross-title economic complexity.</div>
      </div>
      <a href="/franchise/charts" class="shrink-0 px-3 py-2 rounded border border-gta-gold/30 text-gta-gold text-[10px] font-mono hover:bg-gta-gold/20 transition-all">
        View charts →
      </a>
    </div>

    <CrossLinks context="franchise" />
  </div>
</Base>
