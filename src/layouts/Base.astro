---
import { SITE_VERSION_LABEL, SITE_VERSION_DATE } from "../config/version";
import "../styles/tokens.css";
import HudIcon from "../components/HudIcon.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogPage?: string;
  /** Sets data-title-context on <body> — drives --c-identity for the entire page.
   *  Use this prop on every page that belongs to a specific game context. */
  titleContext?:
    | "gta-vi" | "gta-online" | "gta-v" | "gta-iv"
    | "gta-sa" | "gta-vc" | "gta-iii" | "franchise" | "news";
}

const SITE_BASE = import.meta.env.SITE ?? "https://gtavi.ai";

const {
  title = "GTA VI.AI",
  description = "Data-driven intelligence across every GTA generation — live signals, franchise analytics, and what the numbers say about GTA VI.",
  ogImage,
  ogPage,
  titleContext,
} = Astro.props;

const resolvedOgImage =
  ogImage ??
  (ogPage ? `${SITE_BASE}/og/${ogPage}.png` : null) ??
  `https://img.youtube.com/vi/VQRLujxTm3c/maxresdefault.jpg`;

// Nav group definition — icon names map to HudIcon component
interface DropdownItem {
  href: string;
  iconName: string;
  label: string;
  sub: string;
}
interface NavGroup {
  href: string;
  label: string;
  activePaths: string[];
  /** Identity colour for the active-state dot on this nav group */
  identityColor: string;
  dropdown: DropdownItem[] | null;
}

const navGroups: NavGroup[] = [
  {
    href: "/gta-vi",
    label: "GTA VI",
    activePaths: ["/gta-vi", "/gta-vi/intel", "/gta-vi/trailers", "/gta-vi/economy", "/gta-vi/buy"],
    identityColor: "var(--c-title-vi)",
    dropdown: [
      { href: "/gta-vi/intel",    iconName: "intel",   label: "Intel & Predictions", sub: "Predictions · features · cast · locations" },
      { href: "/gta-vi/trailers", iconName: "trailer", label: "Trailers & Analysis",  sub: "2 trailers · view velocity · entity index" },
      { href: "/gta-vi/economy",  iconName: "economy", label: "Economy Preview",      sub: "Day-1 ready · price benchmarks · predictions" },
      { href: "/gta-vi/buy",      iconName: "buy",     label: "Pre-order",            sub: "PS5 · Xbox · editions · retailers" },
    ],
  },
  {
    href: "/gta-online",
    label: "GTA Online",
    activePaths: ["/gta-online", "/gta-online/economy", "/gta-online/income", "/gta-v/income-calculator", "/gta-v/cayo-perico", "/database", "/gta-online/bonuses"],
    identityColor: "var(--c-title-online)",
    dropdown: [
      { href: "/gta-online/economy",       iconName: "chart",    label: "Economy",           sub: "GTA-PPI · inflation · passive stack" },
      { href: "/database?game=gta-online", iconName: "money",    label: "Income Sources",    sub: "S→D tier · 28 methods · ProfitCards" },
      { href: "/charts",                   iconName: "trending", label: "Charts",            sub: "Economy · promotions · meta evolution" },
      { href: "/gta-online/bonuses",       iconName: "tag",      label: "Bonuses & Promos",  sub: "Weekly calendar · sale intelligence" },
    ],
  },
  {
    href: "/franchise",
    label: "Franchise",
    activePaths: ["/franchise", "/franchise/economics", "/gta-iii", "/gta-vc", "/gta-sa", "/gta-iv"],
    identityColor: "var(--c-brand)",
    dropdown: [
      { href: "/franchise/economics", iconName: "economy",  label: "Economic History", sub: "Ten economies · circular flow · 1997–2026" },
      { href: "/franchise/history",   iconName: "history",  label: "History & Sales",  sub: "30 years · 8 titles · sales · scores" },
      { href: "/franchise/charts",    iconName: "trending", label: "Charts",           sub: "Cross-title · complexity · earnings" },
      { href: "/gta-v",               iconName: "briefcase",label: "GTA V Story",      sub: "Heists · assassination guide · vehicles" },
      { href: "/database",            iconName: "database", label: "Data Browser",     sub: "All entities · income · vehicles" },
    ],
  },
  {
    href: "/news",
    label: "News",
    activePaths: ["/news"],
    identityColor: "var(--c-text-4)",
    dropdown: null,
  },
];

function isNavActive(group: NavGroup): boolean {
  return group.activePaths.some(
    p => currentPath === p || currentPath.startsWith(p + "/")
  );
}

const currentPath = Astro.url.pathname;
const fullTitle = title === "GTA VI.AI" ? "GTA VI.AI" : `${title} — GTA VI.AI`;
---

<!doctype html>
<html lang="en" class="scroll-smooth" style="background:#0e0e11;color:#fafafa">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={resolvedOgImage} />
    <meta property="og:type"        content="website" />
    <meta name="twitter:card"       content="summary_large_image" />
    <meta name="twitter:image"      content={resolvedOgImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Inter (body) + JetBrains Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Privacy-friendly analytics — Plausible (no cookies, GDPR-compliant) -->
    <script is:inline async src="https://plausible.io/js/pa-dGk4K5Nh00TNJzDhu11AG.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};
      window.plausible.init=window.plausible.init||function(i){window.plausible.o=i||{}};
      window.plausible.init();
    </script>
  </head>

  <body
    class="min-h-screen flex flex-col font-sans antialiased"
    style="background:#0e0e11"
    data-title-context={titleContext ?? "franchise"}
  >

    <!-- Ops status bar -->
    <div class="border-b border-[#1e1e23] bg-[#0a0a0d]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-7">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse"></span>
            <span class="text-[10px] font-mono text-zinc-600 tracking-widest uppercase">Live intelligence</span>
          </span>
          <span class="hidden sm:block text-[10px] font-mono text-zinc-500">GTA VI · Nov 19 2026</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-mono text-zinc-500 tracking-widest">GTA VI.AI</span>
          <span class="text-[10px] font-mono text-zinc-500 border border-[#2a2a31] rounded px-1">{SITE_VERSION_LABEL}</span>
        </div>
      </div>
    </div>

    <!-- Nav -->
    <header id="main-nav" class="border-b border-[#1e1e23] sticky top-0 z-50 transition-all duration-300" style="background:rgba(14,14,17,0.95);backdrop-filter:blur(12px)">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-12">

        <!-- Wordmark: GTAVI in pink-coral gradient · .AI in amber -->
        <a href="/" class="flex items-center gap-1.5 group" aria-label="GTA VI.AI — home">
          <span class="font-mono font-bold text-lg leading-none tracking-tight select-none text-gradient-vi group-hover:opacity-90 transition-opacity">GTAVI</span>
          <span class="text-xs font-mono text-gta-gold border border-gta-gold/30 rounded px-1.5 py-0.5 tracking-widest group-hover:border-gta-gold/55 group-hover:bg-gta-gold/5 transition-all">.AI</span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden sm:flex items-center gap-0.5">
          {navGroups.map(group => {
            const active = isNavActive(group);
            const baseCls = [
              "relative px-3 py-1.5 rounded text-xs font-mono tracking-wide transition-all duration-150",
              active
                ? "text-white bg-white/5"
                : "text-zinc-400 hover:text-zinc-200 hover:bg-white/4",
            ].join(" ");

            if (!group.dropdown) return (
              <a href={group.href} class={baseCls}>
                {active && (
                  <span
                    class="absolute bottom-0 left-3 right-3 h-px rounded-full"
                    style={`background:${group.identityColor};opacity:0.7`}
                  />
                )}
                {group.label}
              </a>
            );

            return (
              <div class="group relative">
                <a href={group.href} class={baseCls + " flex items-center gap-1"}>
                  {active && (
                    <span
                      class="absolute bottom-0 left-3 right-3 h-px rounded-full"
                      style={`background:${group.identityColor};opacity:0.7`}
                    />
                  )}
                  {group.label}
                  <svg class="w-2.5 h-2.5 opacity-40 group-hover:opacity-80 transition-opacity mt-px shrink-0"
                       viewBox="0 0 10 6" fill="none" stroke="currentColor"
                       stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 1l4 4 4-4"/>
                  </svg>
                </a>
                <!-- Dropdown panel -->
                <div class="absolute left-0 top-full pt-1.5 w-64 z-50
                            invisible opacity-0 pointer-events-none
                            group-hover:visible group-hover:opacity-100 group-hover:pointer-events-auto
                            transition-all duration-150">
                  <div class="rounded-xl border border-[#1e1e23] shadow-2xl shadow-black/60 overflow-hidden"
                       style="background:#0a0a0d">
                    <!-- Identity accent bar at top of dropdown -->
                    <div class="h-0.5 w-full" style={`background:linear-gradient(90deg,${group.identityColor},transparent)`} />
                    {group.dropdown.map((item, i) => (
                      <a href={item.href}
                         class={["group/di flex items-start gap-3 px-4 py-3 hover:bg-white/[0.03] transition-colors",
                                 i > 0 ? "border-t border-[#1e1e23]" : ""].join(" ")}>
                        <HudIcon name={item.iconName as any} size={16} class="text-zinc-600 group-hover/di:text-zinc-400 transition-colors mt-0.5 shrink-0" />
                        <div class="flex-1 min-w-0">
                          <div class="text-[11px] font-semibold text-zinc-300 group-hover/di:text-white transition-colors mb-0.5">{item.label}</div>
                          <div class="text-[10px] font-mono text-zinc-700 leading-snug">{item.sub}</div>
                        </div>
                        <span class="text-zinc-600 group-hover/di:text-zinc-400 font-mono text-[10px] ml-auto shrink-0 mt-1 transition-colors">→</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          })}
        </nav>

        <!-- Pre-order CTA -->
        <a href="/gta-vi/buy"
           class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded border border-gta-vi-coral/30 text-gta-vi-coral text-xs font-mono tracking-wide hover:bg-gta-vi-coral/8 hover:border-gta-vi-coral/50 transition-all ml-2">
          Pre-order <span class="opacity-50 text-[10px]">›</span>
        </a>

        <!-- Mobile hamburger -->
        <button id="mobile-menu-btn"
                class="sm:hidden p-2 rounded text-zinc-500 hover:text-zinc-200 hover:bg-white/4 transition-all"
                aria-label="Open menu">
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h8a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main content area with background grid -->
    <main class="flex-1 bg-grid">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#1e1e23] mt-24" style="background:#0a0a0d">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <!-- Wordmark mirrors nav logo -->
            <div class="font-mono font-bold text-base mb-1 leading-none tracking-tight flex items-center gap-1">
              <span class="text-gradient-vi">GTAVI</span>
              <span class="text-gta-gold text-xs border border-gta-gold/25 rounded px-1.5 py-0.5">.AI</span>
            </div>
            <p class="text-xs text-zinc-700 font-mono max-w-sm mt-2">
              Community data project. Not affiliated with Rockstar Games or Take-Two Interactive.<br />
              All game assets © Rockstar Games / Take-Two Interactive.
            </p>
          </div>
          <div class="flex flex-col items-start sm:items-end gap-1">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-gta-teal"></span>
              <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest">Data refreshed nightly</span>
            </div>
            <span class="text-[10px] font-mono text-zinc-500">GTA VI launches Nov 19, 2026</span>
            <span class="text-[10px] font-mono text-zinc-700">{SITE_VERSION_LABEL} · {SITE_VERSION_DATE}</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile nav drawer -->
    <div id="mobile-nav" class="fixed inset-0 z-[100] hidden" role="dialog" aria-label="Navigation menu">
      <div id="mobile-nav-backdrop" class="absolute inset-0" style="background:rgba(0,0,0,0.72);backdrop-filter:blur(4px)"></div>
      <div class="absolute right-0 top-0 h-full w-72 max-w-[88vw] flex flex-col border-l border-[#1e1e23] shadow-2xl"
           style="background:#0a0a0d">
        <div class="flex items-center justify-between px-5 h-12 border-b border-[#1e1e23] shrink-0">
          <a href="/" class="font-mono font-bold text-base leading-none flex items-center gap-1">
            <span class="text-gradient-vi">GTAVI</span>
            <span class="text-gta-gold text-xs">.AI</span>
          </a>
          <button id="mobile-nav-close" class="text-zinc-600 hover:text-zinc-300 p-1 rounded transition-colors" aria-label="Close menu">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="flex-1 overflow-y-auto py-2">
          {navGroups.map(group => (
            group.dropdown ? (
              <div class="mobile-section">
                <button class="mobile-toggle w-full flex items-center justify-between px-5 py-3 text-[10px] font-mono uppercase tracking-[0.15em] text-zinc-500 hover:text-zinc-200 hover:bg-white/3 transition-colors text-left">
                  <span class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${group.identityColor};opacity:0.6`} />
                    {group.label}
                  </span>
                  <svg class="chevron w-3 h-3 shrink-0 transition-transform" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 1l4 4 4-4"/>
                  </svg>
                </button>
                <div class="mobile-items hidden border-l border-[#1e1e23] ml-5 mb-1">
                  {group.dropdown.map(item => (
                    <a href={item.href}
                       class="flex items-center gap-2.5 px-4 py-2.5 text-[11px] font-mono text-zinc-500 hover:text-zinc-200 hover:bg-white/3 transition-colors">
                      <HudIcon name={item.iconName as any} size={14} class="text-zinc-600 shrink-0" />
                      <span>{item.label}</span>
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={group.href}
                 class="flex items-center gap-2 px-5 py-3 text-[10px] font-mono uppercase tracking-[0.15em] text-zinc-500 hover:text-zinc-200 hover:bg-white/3 transition-colors">
                <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${group.identityColor};opacity:0.5`} />
                {group.label}
              </a>
            )
          ))}
          <div class="mx-5 mt-4 pt-4 border-t border-[#1e1e23]">
            <a href="/gta-vi/buy"
               class="flex items-center justify-center gap-2 py-2.5 rounded border border-gta-vi-coral/25 bg-gta-vi-coral/5 text-gta-vi-coral text-[11px] font-mono hover:bg-gta-vi-coral/10 hover:border-gta-vi-coral/40 transition-all">
              <HudIcon name="buy" size={14} class="text-gta-vi-coral" />
              Pre-order GTA VI
            </a>
          </div>
        </div>
      </div>
    </div>

    <script>
      const mobileNav      = document.getElementById("mobile-nav");
      const mobileBackdrop = document.getElementById("mobile-nav-backdrop");
      const mobileOpenBtn  = document.getElementById("mobile-menu-btn");
      const mobileCloseBtn = document.getElementById("mobile-nav-close");

      function openMobileNav()  { mobileNav?.classList.remove("hidden"); document.body.style.overflow = "hidden"; }
      function closeMobileNav() { mobileNav?.classList.add("hidden");    document.body.style.overflow = "";       }

      mobileOpenBtn?.addEventListener("click", openMobileNav);
      mobileCloseBtn?.addEventListener("click", closeMobileNav);
      mobileBackdrop?.addEventListener("click", closeMobileNav);

      document.querySelectorAll<HTMLButtonElement>(".mobile-toggle").forEach(btn => {
        btn.addEventListener("click", () => {
          const section = btn.closest<HTMLElement>(".mobile-section");
          const items   = section?.querySelector<HTMLElement>(".mobile-items");
          const chevron = btn.querySelector<SVGElement>(".chevron");
          const isOpen  = !items?.classList.contains("hidden");
          items?.classList.toggle("hidden");
          if (chevron) (chevron as HTMLElement).style.transform = isOpen ? "" : "rotate(180deg)";
        });
      });
    </script>

  </body>
</html>
