---
import { SITE_VERSION_LABEL, SITE_VERSION_DATE } from "../config/version";
import "../styles/tokens.css";
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogPage?: string; // slug matching src/pages/og/[page].png.ts config
}

// Derive base URL from SITE env or fall back to canonical domain
const SITE_BASE = import.meta.env.SITE ?? "https://gtavi.ai";

const {
  title = "GTA VI.AI",
  description = "Data-driven intelligence across every GTA generation — live signals, franchise analytics, and what the numbers say about GTA VI.",
  ogImage,
  ogPage,
} = Astro.props;

// OG image resolution order:
//   1. Explicit ogImage prop (remote URL or path)
//   2. Auto-generated per-page PNG via ogPage slug
//   3. Default: GTA VI Trailer 2 YouTube thumbnail
const resolvedOgImage =
  ogImage ??
  (ogPage ? `${SITE_BASE}/og/${ogPage}.png` : null) ??
  `https://img.youtube.com/vi/VQRLujxTm3c/maxresdefault.jpg`;

interface DropdownItem { href: string; icon: string; label: string; sub: string; }
interface NavGroup { href: string; label: string; activePaths: string[]; dropdown: DropdownItem[] | null; }

const navGroups: NavGroup[] = [
  {
    href: "/gta-vi",
    label: "GTA VI",
    activePaths: ["/gta-vi", "/gta-vi/intel", "/gta-vi/trailers", "/gta-vi/economy", "/gta-vi/buy"],
    dropdown: [
      { href: "/gta-vi/intel",    icon: "🎯", label: "Intel & Predictions", sub: "Predictions · features · cast · locations" },
      { href: "/gta-vi/trailers", icon: "🎬", label: "Trailers & Analysis",  sub: "2 trailers · view velocity · entity index" },
      { href: "/gta-vi/economy",  icon: "💹", label: "Economy Preview",      sub: "Day-1 ready · price benchmarks · predictions" },
      { href: "/gta-vi/buy",      icon: "🛒", label: "Pre-order",            sub: "PS5 · Xbox · editions · retailers" },
    ],
  },
  {
    href: "/gta-online",
    label: "GTA Online",
    activePaths: ["/gta-online", "/gta-online/economy", "/gta-online/income", "/gta-v/income-calculator", "/gta-v/cayo-perico", "/database", "/gta-online/bonuses"],
    dropdown: [
      { href: "/gta-online/economy",        icon: "📊", label: "Economy",        sub: "GTA-PPI · inflation · passive stack" },
      { href: "/database?game=gta-online", icon: "💰", label: "Income Sources", sub: "S→D tier · 28 methods · ProfitCards"  },
      { href: "/charts",                   icon: "📈", label: "Charts",         sub: "Economy · promotions · meta evolution" },
      { href: "/gta-online/bonuses",        icon: "🏷", label: "Bonuses & Promos", sub: "Weekly calendar · sale intelligence" },
    ],
  },
  {
    href: "/franchise",
    label: "Franchise",
    activePaths: ["/franchise"],
    dropdown: [
      { href: "/franchise/history", icon: "📖", label: "History & Sales", sub: "30 years · 8 titles · sales · scores" },
      { href: "/franchise/charts",  icon: "📈", label: "Charts",          sub: "Cross-title · complexity · earnings" },
      { href: "/gta-v",     icon: "🎮", label: "GTA V Story",     sub: "Heists · assassination guide · vehicles" },
      { href: "/database",  icon: "🗄", label: "Data Browser",    sub: "All entities · income · vehicles" },
    ],
  },
  {
    href: "/news",
    label: "News",
    activePaths: ["/news"],
    dropdown: null,
  },
];

function isNavActive(group: NavGroup): boolean {
  return group.activePaths.some(
    p => currentPath === p || currentPath.startsWith(p + "/")
  );
}

const currentPath = Astro.url.pathname;
const fullTitle = title === "GTA VI.AI" ? "GTA VI.AI" : `${title} — GTA VI.AI`;
---

<!doctype html>
<html lang="en" class="scroll-smooth" style="background:#0e0e11;color:#fafafa">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={resolvedOgImage} />
    <meta property="og:type"        content="website" />
    <meta name="twitter:card"       content="summary_large_image" />
    <meta name="twitter:image"      content={resolvedOgImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts self-hosted via fontsource npm packages — no Google CDN requests -->
  </head>

  <body class="min-h-screen flex flex-col font-sans antialiased" style="background:#0e0e11">

    <!-- Ops status bar — thin top strip showing data freshness -->
    <div class="border-b border-[#1e1e23] bg-[#0a0a0d]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-7">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse"></span>
            <span class="text-[10px] font-mono text-zinc-600 tracking-widest uppercase">Live intelligence</span>
          </span>
          <span class="hidden sm:block text-[10px] font-mono text-zinc-700">GTA VI · Nov 19 2026</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-mono text-zinc-700 tracking-widest">GTA VI.AI</span>
          <span class="text-[10px] font-mono text-zinc-700 border border-[#2a2a31] rounded px-1">{SITE_VERSION_LABEL}</span>
        </div>
      </div>
    </div>

    <!-- Nav -->
    <header id="main-nav" class="border-b border-[#1e1e23] sticky top-0 z-50 transition-all duration-300" style="background:rgba(14,14,17,0.95);backdrop-filter:blur(12px)">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-12">
        <a href="/" class="flex items-center gap-2 group" aria-label="GTA VI.AI — home">
          <!-- Wordmark: GTA in zinc, VI in gold, tight compound -->
          <span class="font-mono font-bold text-lg leading-none tracking-tight select-none">
            <span class="text-zinc-400 group-hover:text-zinc-300 transition-colors">GTA</span><span class="text-gta-gold">VI</span>
          </span>
          <span class="text-xs font-mono text-zinc-600 border border-[#2a2a31] rounded px-1.5 py-0.5 tracking-widest group-hover:border-zinc-600 group-hover:text-zinc-500 transition-all">.AI</span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden sm:flex items-center gap-0.5">
          {navGroups.map(group => {
            const active = isNavActive(group);
            const baseCls = [
              "relative px-3 py-1.5 rounded text-xs font-mono tracking-wide transition-all duration-150",
              active ? "text-gta-gold bg-gta-gold/8" : "text-zinc-500 hover:text-zinc-200 hover:bg-white/4",
            ].join(" ");

            if (!group.dropdown) return (
              <a href={group.href} class={baseCls}>
                {active && <span class="absolute bottom-0 left-3 right-3 h-px bg-gta-gold/60 rounded-full" />}
                {group.label}
              </a>
            );

            return (
              <div class="group relative">
                <a href={group.href} class={baseCls + " flex items-center gap-1"}>
                  {active && <span class="absolute bottom-0 left-3 right-3 h-px bg-gta-gold/60 rounded-full" />}
                  {group.label}
                  <svg class="w-2.5 h-2.5 opacity-40 group-hover:opacity-80 transition-opacity mt-px shrink-0"
                       viewBox="0 0 10 6" fill="none" stroke="currentColor"
                       stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 1l4 4 4-4"/>
                  </svg>
                </a>
                <!-- Dropdown panel -->
                <div class="absolute left-0 top-full pt-1.5 w-64 z-50
                            invisible opacity-0 pointer-events-none
                            group-hover:visible group-hover:opacity-100 group-hover:pointer-events-auto
                            transition-all duration-150">
                  <div class="rounded-xl border border-[#1e1e23] shadow-2xl shadow-black/60 overflow-hidden"
                       style="background:#0a0a0d">
                    {group.dropdown.map((item, i) => (
                      <a href={item.href}
                         class={["group/di flex items-start gap-3 px-4 py-3 hover:bg-white/[0.03] transition-colors",
                                 i > 0 ? "border-t border-[#1e1e23]" : ""].join(" ")}>
                        <span class="text-base shrink-0 mt-0.5 leading-none">{item.icon}</span>
                        <div class="flex-1 min-w-0">
                          <div class="text-[11px] font-semibold text-zinc-300 group-hover/di:text-white transition-colors mb-0.5"
                               style="font-family:'Inter',sans-serif">{item.label}</div>
                          <div class="text-[10px] font-mono text-zinc-600 leading-snug">{item.sub}</div>
                        </div>
                        <span class="text-zinc-700 group-hover/di:text-zinc-400 font-mono text-[10px] ml-auto shrink-0 mt-1 transition-colors">→</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          })}
        </nav>

        <!-- Pre-order CTA (desktop) -->
        <a href="/gta-vi/buy"
           class="hidden sm:flex items-center gap-1 px-3 py-1.5 rounded border border-gta-gold/25 text-gta-gold text-xs font-mono tracking-wide hover:bg-gta-gold/8 hover:border-gta-gold/45 transition-all ml-2">
          Pre-order <span class="opacity-50 text-[10px]">›</span>
        </a>

        <!-- Mobile hamburger -->
        <button id="mobile-menu-btn"
                class="sm:hidden p-2 rounded text-zinc-500 hover:text-zinc-200 hover:bg-white/4 transition-all"
                aria-label="Open menu">
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h8a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#1e1e23] mt-24" style="background:#0a0a0d">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <div class="font-mono font-bold text-base mb-1 leading-none tracking-tight"><span class="text-zinc-400">GTA</span><span class="text-gta-gold">VI</span><span class="text-zinc-600 text-xs ml-1">.AI</span></div>
            <p class="text-xs text-zinc-600 font-mono max-w-sm">
              Community data project. Not affiliated with Rockstar Games or Take-Two Interactive.<br />
              All game assets © Rockstar Games / Take-Two Interactive.
            </p>
          </div>
          <div class="flex flex-col items-start sm:items-end gap-1">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-gta-teal"></span>
              <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest">Data refreshed nightly</span>
            </div>
            <span class="text-[10px] font-mono text-zinc-700">GTA VI launches Nov 19, 2026</span>
            <span class="text-[10px] font-mono text-zinc-800">{SITE_VERSION_LABEL} · {SITE_VERSION_DATE}</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- ── Mobile nav drawer ──────────────────────────────────────── -->
    <div id="mobile-nav" class="fixed inset-0 z-[100] hidden" role="dialog" aria-label="Navigation menu">
      <!-- Backdrop -->
      <div id="mobile-nav-backdrop" class="absolute inset-0" style="background:rgba(0,0,0,0.72);backdrop-filter:blur(4px)"></div>
      <!-- Drawer panel -->
      <div class="absolute right-0 top-0 h-full w-72 max-w-[88vw] flex flex-col border-l border-[#1e1e23] shadow-2xl"
           style="background:#0a0a0d">
        <!-- Header -->
        <div class="flex items-center justify-between px-5 h-12 border-b border-[#1e1e23] shrink-0">
          <a href="/" class="font-mono font-bold text-base leading-none">
            <span class="text-zinc-400">GTA</span><span class="text-gta-gold">VI</span>
            <span class="text-zinc-600 text-xs ml-0.5">.AI</span>
          </a>
          <button id="mobile-nav-close" class="text-zinc-600 hover:text-zinc-300 p-1 rounded transition-colors" aria-label="Close menu">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <!-- Nav sections -->
        <div class="flex-1 overflow-y-auto py-2">
          {navGroups.map(group => (
            group.dropdown ? (
              <div class="mobile-section">
                <button class="mobile-toggle w-full flex items-center justify-between px-5 py-3 text-[10px] font-mono uppercase tracking-[0.15em] text-zinc-500 hover:text-zinc-200 hover:bg-white/3 transition-colors text-left">
                  {group.label}
                  <svg class="chevron w-3 h-3 shrink-0 transition-transform" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 1l4 4 4-4"/>
                  </svg>
                </button>
                <div class="mobile-items hidden border-l border-[#1e1e23] ml-5 mb-1">
                  {group.dropdown.map(item => (
                    <a href={item.href}
                       class="flex items-center gap-2.5 px-4 py-2.5 text-[11px] font-mono text-zinc-500 hover:text-zinc-200 hover:bg-white/3 transition-colors">
                      <span class="text-sm leading-none shrink-0">{item.icon}</span>
                      <span>{item.label}</span>
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={group.href}
                 class="flex items-center px-5 py-3 text-[10px] font-mono uppercase tracking-[0.15em] text-zinc-500 hover:text-zinc-200 hover:bg-white/3 transition-colors">
                {group.label}
              </a>
            )
          ))}
          <!-- Pre-order CTA -->
          <div class="mx-5 mt-4 pt-4 border-t border-[#1e1e23]">
            <a href="/gta-vi/buy"
               class="flex items-center justify-center gap-2 py-2.5 rounded border border-gta-gold/25 bg-gta-gold/5 text-gta-gold text-[11px] font-mono hover:bg-gta-gold/10 hover:border-gta-gold/40 transition-all">
              🛒 Pre-order GTA VI
            </a>
          </div>
        </div>
      </div>
    </div>

    <script>
      // ── Mobile nav ────────────────────────────────────────────────
      const mobileNav      = document.getElementById("mobile-nav");
      const mobileBackdrop = document.getElementById("mobile-nav-backdrop");
      const mobileOpenBtn  = document.getElementById("mobile-menu-btn");
      const mobileCloseBtn = document.getElementById("mobile-nav-close");

      function openMobileNav()  { mobileNav?.classList.remove("hidden"); document.body.style.overflow = "hidden"; }
      function closeMobileNav() { mobileNav?.classList.add("hidden");    document.body.style.overflow = "";       }

      mobileOpenBtn?.addEventListener("click", openMobileNav);
      mobileCloseBtn?.addEventListener("click", closeMobileNav);
      mobileBackdrop?.addEventListener("click", closeMobileNav);

      // Section accordions
      document.querySelectorAll<HTMLButtonElement>(".mobile-toggle").forEach(btn => {
        btn.addEventListener("click", () => {
          const section = btn.closest<HTMLElement>(".mobile-section");
          const items   = section?.querySelector<HTMLElement>(".mobile-items");
          const chevron = btn.querySelector<SVGElement>(".chevron");
          const isOpen  = !items?.classList.contains("hidden");
          items?.classList.toggle("hidden");
          if (chevron) (chevron as HTMLElement).style.transform = isOpen ? "" : "rotate(180deg)";
        });
      });
    </script>

  </body>
</html>
