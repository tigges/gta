---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "GTAVI.AI",
  description = "Data-driven intelligence across every GTA generation — live signals, franchise analytics, and what the numbers say about GTA VI.",
  ogImage = `https://img.youtube.com/vi/VQRLujxTm3c/maxresdefault.jpg`,
} = Astro.props;

const nav = [
  { href: "/",       label: "Overview" },
  { href: "/gta-v",  label: "GTA V"    },
  { href: "/gta-vi", label: "GTA VI"   },
];

const currentPath = Astro.url.pathname;
const fullTitle = title === "GTAVI.AI" ? "GTAVI.AI" : `${title} — GTAVI.AI`;
---

<!doctype html>
<html lang="en" class="scroll-smooth" style="background:#0e0e11;color:#fafafa">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:type"        content="website" />
    <meta name="twitter:card"       content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Inter (body) + JetBrains Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen flex flex-col font-sans antialiased" style="background:#0e0e11">

    <!-- Ops status bar — thin top strip showing data freshness -->
    <div class="border-b border-[#1e1e23] bg-[#0a0a0d]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-7">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse"></span>
            <span class="text-[10px] font-mono text-zinc-600 tracking-widest uppercase">Live intelligence</span>
          </span>
          <span class="hidden sm:block text-[10px] font-mono text-zinc-700">GTA VI · Nov 19 2026</span>
        </div>
        <span class="text-[10px] font-mono text-zinc-700 tracking-widest">GTAVI.AI — data updated nightly</span>
      </div>
    </div>

    <!-- Nav -->
    <header class="border-b border-[#1e1e23] sticky top-0 z-50" style="background:rgba(14,14,17,0.95);backdrop-filter:blur(12px)">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-12">
        <a href="/" class="flex items-center gap-2.5 group">
          <span class="text-gta-gold font-mono font-bold tracking-[0.18em] text-sm uppercase">GTAVI</span>
          <span class="text-[10px] font-mono text-zinc-600 border border-[#1e1e23] rounded px-1 py-0.5 tracking-widest">.AI</span>
        </a>

        <nav class="flex items-center gap-0.5">
          {nav.map(({ href, label }) => {
            const active = currentPath === href || (href !== "/" && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class={[
                  "relative px-3 py-1.5 rounded text-xs font-mono tracking-wide transition-all duration-150",
                  active
                    ? "text-gta-gold bg-gta-gold/8"
                    : "text-zinc-500 hover:text-zinc-200 hover:bg-white/4",
                ].join(" ")}
              >
                {active && (
                  <span class="absolute bottom-0 left-3 right-3 h-px bg-gta-gold/60 rounded-full"></span>
                )}
                {label}
              </a>
            );
          })}
        </nav>
      </div>
    </header>

    <!-- Main -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#1e1e23] mt-24" style="background:#0a0a0d">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <div class="font-mono font-bold text-gta-gold tracking-[0.18em] text-sm uppercase mb-1">GTAVI.AI</div>
            <p class="text-xs text-zinc-600 font-mono max-w-sm">
              Community data project. Not affiliated with Rockstar Games or Take-Two Interactive.<br />
              All game assets © Rockstar Games / Take-Two Interactive.
            </p>
          </div>
          <div class="flex flex-col items-start sm:items-end gap-1">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-gta-teal"></span>
              <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest">Data refreshed nightly</span>
            </div>
            <span class="text-[10px] font-mono text-zinc-700">GTA VI launches Nov 19, 2026</span>
          </div>
        </div>
      </div>
    </footer>

  </body>
</html>
