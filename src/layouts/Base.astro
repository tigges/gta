---
import { SITE_VERSION_LABEL, SITE_VERSION_DATE } from "../config/version";
import "../styles/tokens.css";
import HudIcon from "../components/HudIcon.astro";
import CrossLinks from "../components/CrossLinks.astro";
import weeklyBonusesRaw from "../../data/gta-5/economy/weekly-bonuses.json";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogPage?: string;
  /** Sets data-title-context on <body> — drives --c-identity for the entire page.
   *  Use this prop on every page that belongs to a specific game context. */
  titleContext?:
    | "gta-vi" | "gta-online" | "gta-v" | "gta-iv"
    | "gta-sa" | "gta-vc" | "gta-iii" | "franchise" | "news";
  /** Admin/internal pages only — prevents search engine indexing. */
  noindex?: boolean;
  /**
   * Context key for the CrossLinks "Related Intelligence" strip rendered
   * above the footer. Omit on admin/legal pages. Matches keys in CrossLinks ALL_LINKS.
   */
  crossLinksContext?: string;
}

const SITE_BASE = import.meta.env.SITE ?? "https://gtavi.ai";

const {
  title = "GTA VI.AI",
  description = "Follow the GTA$ — GTA's dual economy tracked, predicted and explained. In-game income, Shark Card mechanics, and what the numbers say about GTA VI.",
  ogImage,
  ogPage,
  titleContext,
  noindex = false,
  crossLinksContext,
} = Astro.props;

const resolvedOgImage =
  ogImage ??
  (ogPage ? `${SITE_BASE}/og/${ogPage}.png` : null) ??
  `https://img.youtube.com/vi/VQRLujxTm3c/maxresdefault.jpg`;

// Canonical URL — strips trailing slash except for root
const rawPath = Astro.url.pathname;
const canonicalPath = rawPath === "/" ? "/" : rawPath.replace(/\/$/, "");
const canonicalUrl = `${SITE_BASE}${canonicalPath}`;

// Nav group definition — icon names map to HudIcon component
interface DropdownItem {
  href: string;
  iconName: string;
  label: string;
  sub: string;
}
interface NavGroup {
  href: string;
  label: string;
  activePaths: string[];
  /** Identity colour for the active-state dot on this nav group */
  identityColor: string;
  dropdown: DropdownItem[] | null;
}

// ── Nav data ──────────────────────────────────────────────────────────────
// Each section is either a direct link (dropdown: null) or opens a mega-panel.
// Mega-panel tiles: up to 3, each with icon + title + sub-description.
// Direct-link sections navigate in one tap — no panel needed.

const navGroups: NavGroup[] = [
  {
    href: "/gta-vi",
    label: "GTA VI",
    activePaths: ["/gta-vi", "/gta-vi/intel", "/gta-vi/trailers", "/gta-vi/economy", "/gta-vi/buy"],
    identityColor: "var(--c-title-vi)",
    dropdown: [
      { href: "/gta-vi",          iconName: "intel",   label: "GTA VI",         sub: "Hub · predictions · charts · economy · overview" },
      { href: "/gta-vi/intel",    iconName: "intel",   label: "Predictions",    sub: "Confidence-scored signals · confirmed & reported" },
      { href: "/charts?title=gta-vi", iconName: "chart", label: "Charts",       sub: "GTA VI data charts · trends · release analysis" },
      { href: "/gta-vi/economy",  iconName: "economy", label: "Economy",        sub: "Circular model · income sources · Shark Card" },
      { href: "/gta-vi/buy",      iconName: "buy",     label: "Buy",            sub: "PS5 · Xbox Series X|S · edition comparison" },
    ],
  },
  {
    href: "/gta-online",
    label: "GTA Online",
    activePaths: ["/gta-online", "/gta-online/economy", "/gta-online/income", "/database"],
    identityColor: "var(--c-title-online)",
    dropdown: [
      { href: "/gta-online",              iconName: "intel",   label: "GTA Online",        sub: "Hub · economy · income · charts · overview" },
      { href: "/charts?title=gta-online", iconName: "chart",   label: "Charts",            sub: "Meta evolution · Shark Card inflation · income data" },
      { href: "/database?game=gta-online",iconName: "money",   label: "Income",            sub: "S→D tier · all methods ranked · ROI profiles" },
      { href: "/gta-online/economy",      iconName: "economy", label: "Economy",           sub: "GTA-PPI · Shark Card inflation · circular flow" },
    ],
  },
  {
    href: "/gta-v",
    label: "GTA V",
    activePaths: ["/gta-v"],
    identityColor: "var(--c-title-v)",
    dropdown: null,
  },
  {
    href: "/charts",
    label: "Charts",
    activePaths: ["/charts"],
    identityColor: "var(--c-text-4)",
    dropdown: null,
  },
  {
    href: "/database",
    label: "Database",
    activePaths: ["/database"],
    identityColor: "var(--c-text-4)",
    dropdown: null,
  },
  {
    href: "/franchise",
    label: "Franchise",
    activePaths: ["/franchise", "/franchise/economics", "/franchise/history", "/franchise/charts", "/gta-iii", "/gta-vc", "/gta-sa", "/gta-iv"],
    identityColor: "var(--c-brand)",
    dropdown: [
      { href: "/franchise/history",   iconName: "history",  label: "History & Sales",  sub: "30 years · 8 titles · sales · Metacritic" },
      { href: "/franchise/economics", iconName: "economy",  label: "Economic History", sub: "Ten economies · circular flow · 1997–2026" },
    ],
  },
  {
    href: "/community/polls",
    label: "Polls",
    activePaths: ["/community/polls", "/community"],
    identityColor: "var(--c-brand)",
    dropdown: null,
  },
  {
    href: "/news",
    label: "News",
    activePaths: ["/news"],
    identityColor: "var(--c-text-4)",
    dropdown: null,
  },
];

// Live GTA Online bonus strip for the mega-panel
const weeklyBonuses = weeklyBonusesRaw as any;
const topBonus = weeklyBonuses.bonuses?.[0];
const liveStripText = topBonus
  ? `${topBonus.multiplier}x ${String(topBonus.activity_id).replace(/-/g, " ")} - w/c ${weeklyBonuses.week_start ?? ""}`
  : "Updated weekly";

function isNavActive(group: NavGroup): boolean {
  return group.activePaths.some(
    p => currentPath === p || currentPath.startsWith(p + "/")
  );
}

const currentPath = Astro.url.pathname;
const fullTitle = title === "GTA VI.AI" ? "GTA VI.AI" : `${title} — GTA VI.AI`;
---

<!doctype html>
<html lang="en" class="scroll-smooth" style="background:var(--c-bg);color:#fafafa">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={resolvedOgImage} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="GTA VI.AI" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={resolvedOgImage} />

    <link rel="icon" type="image/png" href="/assets/logos/gtavi_ai_logo_transparent.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/assets/logos/GTA_VI_AI_ICON.png" />

    <!-- Fonts: Inter (body) + JetBrains Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Privacy-friendly analytics — Plausible (no cookies, GDPR-compliant) -->
    <script is:inline async src="https://plausible.io/js/pa-dGk4K5Nh00TNJzDhu11AG.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};
      window.plausible.init=window.plausible.init||function(i){window.plausible.o=i||{}};
      window.plausible.init();
    </script>
  </head>

  <body
    class="min-h-screen flex flex-col font-sans antialiased"
    style="background:var(--c-bg)"
    data-title-context={titleContext ?? "franchise"}
  >

    <!-- Ops status bar -->
    <div class="border-b border-border-dim bg-[#0a0a0d]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-7">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse"></span>
            <span class="text-[10px] font-mono text-zinc-400 tracking-widest uppercase">Follow the GTA$</span>
          </span>
          <span class="hidden sm:block text-[10px] font-mono text-zinc-500">GTA VI · Nov 19 2026</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-mono text-zinc-500 tracking-widest">GTA VI.AI</span>
          <span class="text-[10px] font-mono text-zinc-500 border border-border-mid rounded px-1">{SITE_VERSION_LABEL}</span>
          <span id="staging-badge" style="display:none" class="text-[10px] font-mono text-amber-400 border border-amber-500/40 bg-amber-500/10 rounded px-1.5 tracking-widest">staging</span>
          <script is:inline>
            if (location.hostname.includes("staging") || location.hostname.includes("pages.dev")) {
              document.getElementById("staging-badge").style.display = "inline";
            }
          </script>
          {import.meta.env.SITE?.includes("staging") && (
            <span class="text-[10px] font-mono text-amber-400 border border-amber-500/40 bg-amber-500/10 rounded px-1.5 tracking-widest">staging</span>
          )}
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         NAV — MCT + Pause Menu model
         Desktop: 64px bar · all tabs always visible · mega-panel on click
         Mobile:  logo + grid icon → full-screen 2-col tile launcher
    ═══════════════════════════════════════════════════════ -->
    <header id="main-nav" class="border-b border-border-dim sticky top-0 z-50" style="background:rgba(14,14,17,0.97);backdrop-filter:blur(16px)">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center h-16 gap-6">

        <!-- Wordmark -->
        <a href="/" class="flex items-center gap-1 group shrink-0" aria-label="GTA VI.AI — home">
          <span class="font-mono font-bold text-xl leading-none tracking-tight select-none group-hover:opacity-90 transition-opacity">
            <span class="text-white mr-1">GTA</span><span class="text-gta-gold">VI</span>
          </span>
          <span class="text-sm font-mono font-bold text-white border-2 border-zinc-200/70 rounded pl-0.5 pr-1.5 py-0.5 tracking-widest leading-none group-hover:border-zinc-100 group-hover:bg-gta-gold/5 transition-all">.AI</span>
        </a>

        <!-- Desktop nav — all tabs always visible (Pause Menu model) -->
        <nav class="hidden md:flex items-center gap-1 flex-1">
          {navGroups.map(group => {
            const active = isNavActive(group);
            // Direct links (no mega-panel)
            if (!group.dropdown) return (
              <a
                href={group.href}
                class={[
                  "relative px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150",
                  active ? "text-white bg-white/6" : "text-zinc-400 hover:text-zinc-200 hover:bg-white/4",
                ].join(" ")}
              >
                {active && (
                  <span class="absolute bottom-1 left-3 right-3 h-0.5 rounded-full" style={`background:${group.identityColor}`} />
                )}
                {group.label}
              </a>
            );
            // Mega-panel triggers
            return (
              <button
                data-nav-trigger={group.label}
                class={[
                  "relative flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150 cursor-pointer",
                  active ? "text-white bg-white/6" : "text-zinc-400 hover:text-zinc-200 hover:bg-white/4",
                ].join(" ")}
                aria-expanded="false"
                aria-haspopup="true"
              >
                {active && (
                  <span class="absolute bottom-1 left-3 right-3 h-0.5 rounded-full" style={`background:${group.identityColor}`} />
                )}
                {group.label}
                <svg class="w-2.5 h-2.5 opacity-40 mt-px shrink-0 nav-chevron transition-transform duration-200"
                     viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 1l4 4 4-4"/>
                </svg>
              </button>
            );
          })}
        </nav>

        <!-- Pre-order CTA (desktop) -->
        <a href="/gta-vi/buy"
           class="hidden md:flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gta-vi-coral/30 text-gta-vi-coral text-xs font-mono tracking-wide hover:bg-gta-vi-coral/8 hover:border-gta-vi-coral/50 transition-all shrink-0">
          Pre-order
        </a>

        <!-- Mobile grid-icon trigger -->
        <button id="mobile-nav-open"
                class="md:hidden ml-auto p-2 rounded-lg text-zinc-400 hover:text-zinc-200 hover:bg-white/5 transition-all"
                aria-label="Open navigation">
          <!-- 3×3 grid icon — signals app launcher, not hamburger -->
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <rect x="2" y="2" width="5" height="5" rx="1"/>
            <rect x="7.5" y="2" width="5" height="5" rx="1"/>
            <rect x="13" y="2" width="5" height="5" rx="1"/>
            <rect x="2" y="7.5" width="5" height="5" rx="1"/>
            <rect x="7.5" y="7.5" width="5" height="5" rx="1"/>
            <rect x="13" y="7.5" width="5" height="5" rx="1"/>
            <rect x="2" y="13" width="5" height="5" rx="1"/>
            <rect x="7.5" y="13" width="5" height="5" rx="1"/>
            <rect x="13" y="13" width="5" height="5" rx="1"/>
          </svg>
        </button>
      </div>

      <!-- ═══════════════════════════════════════════════════════
           MEGA-PANELS — fixed below sticky header, full viewport width
           MCT model: all destinations visible simultaneously, no drilling
      ═══════════════════════════════════════════════════════ -->

      <!-- GTA VI panel -->
      <div id="nav-panel-GTA VI"
           class="nav-mega-panel hidden fixed left-0 right-0 z-[49] border-b border-border-dim shadow-2xl shadow-black/70"
           style="top:64px;background:rgba(10,10,13,0.98);backdrop-filter:blur(20px)">
        <div class="h-0.5" style="background:linear-gradient(90deg,var(--c-title-vi),transparent)"></div>
        <div class="max-w-7xl mx-auto px-6 py-6">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            {navGroups.find(g => g.label === "GTA VI")?.dropdown?.map(item => (
              <a href={item.href}
                 class="group/pt flex items-start gap-4 p-4 rounded-xl border border-border-dim hover:border-border-mid hover:bg-white/[0.02] transition-all"
                 style="background:var(--c-card)">
                <HudIcon name={item.iconName as any} size={20} class="text-zinc-500 group-hover/pt:text-zinc-300 transition-colors mt-0.5 shrink-0" />
                <div>
                  <div class="text-sm font-semibold text-zinc-200 group-hover/pt:text-white transition-colors mb-1">{item.label}</div>
                  <div class="text-xs font-mono text-zinc-600 leading-snug">{item.sub}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- GTA Online panel -->
      <div id="nav-panel-GTA Online"
           class="nav-mega-panel hidden fixed left-0 right-0 z-[49] border-b border-border-dim shadow-2xl shadow-black/70"
           style="top:64px;background:rgba(10,10,13,0.98);backdrop-filter:blur(20px)">
        <div class="h-0.5" style="background:linear-gradient(90deg,var(--c-title-online),transparent)"></div>
        <div class="max-w-7xl mx-auto px-6 py-6">
          <div class="grid grid-cols-3 gap-4 mb-4">
            {navGroups.find(g => g.label === "GTA Online")?.dropdown?.map(item => (
              <a href={item.href}
                 class="group/pt flex items-start gap-4 p-4 rounded-xl border border-border-dim hover:border-border-mid hover:bg-white/[0.02] transition-all"
                 style="background:var(--c-card)">
                <HudIcon name={item.iconName as any} size={20} class="text-zinc-500 group-hover/pt:text-zinc-300 transition-colors mt-0.5 shrink-0" />
                <div>
                  <div class="text-sm font-semibold text-zinc-200 group-hover/pt:text-white transition-colors mb-1">{item.label}</div>
                  <div class="text-xs font-mono text-zinc-600 leading-snug">{item.sub}</div>
                </div>
              </a>
            ))}
          </div>
          <!-- Live strip (MCT status bar) -->
          <a href="/gta-online"
             class="flex items-center gap-2.5 px-4 py-2.5 rounded-lg border border-border-dim hover:border-gta-teal/30 hover:bg-gta-teal/[0.03] transition-all group/ls"
             style="background:#0e1a0e">
            <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse shrink-0"></span>
            <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest">Live this week</span>
            <span class="text-[11px] font-mono text-gta-teal capitalize">{liveStripText}</span>
            <span class="ml-auto text-[10px] font-mono text-zinc-700 group-hover/ls:text-zinc-500 transition-colors">See all →</span>
          </a>
        </div>
      </div>

      <!-- Franchise panel -->
      <div id="nav-panel-Franchise"
           class="nav-mega-panel hidden fixed left-0 right-0 z-[49] border-b border-border-dim shadow-2xl shadow-black/70"
           style="top:64px;background:rgba(10,10,13,0.98);backdrop-filter:blur(20px)">
        <div class="h-0.5" style="background:linear-gradient(90deg,var(--c-brand),transparent)"></div>
        <div class="max-w-7xl mx-auto px-6 py-6">
          <div class="grid grid-cols-2 gap-4 mb-5">
            {navGroups.find(g => g.label === "Franchise")?.dropdown?.map(item => (
              <a href={item.href}
                 class="group/pt flex items-start gap-4 p-4 rounded-xl border border-border-dim hover:border-border-mid hover:bg-white/[0.02] transition-all"
                 style="background:var(--c-card)">
                <HudIcon name={item.iconName as any} size={20} class="text-zinc-500 group-hover/pt:text-zinc-300 transition-colors mt-0.5 shrink-0" />
                <div>
                  <div class="text-sm font-semibold text-zinc-200 group-hover/pt:text-white transition-colors mb-1">{item.label}</div>
                  <div class="text-xs font-mono text-zinc-600 leading-snug">{item.sub}</div>
                </div>
              </a>
            ))}
          </div>
          <!-- Cover strip — all 8 titles, one tap each -->
          <div class="flex items-center gap-3">
            <span class="text-[10px] font-mono text-zinc-700 uppercase tracking-widest shrink-0">All titles</span>
            {([
              { id: "gta-1",  year: "1997", href: "/franchise" },
              { id: "gta-2",  year: "1999", href: "/franchise" },
              { id: "gta-3",  year: "2001", href: "/gta-iii/economy" },
              { id: "gta-vc", year: "2002", href: "/gta-vc/economy" },
              { id: "gta-sa", year: "2004", href: "/gta-sa/economy" },
              { id: "gta-4",  year: "2008", href: "/gta-iv/economy" },
              { id: "gta-5",  year: "2013", href: "/gta-v" },
              { id: "gta-6",  year: "2026", href: "/gta-vi" },
            ] as const).map(t => (
              <a href={t.href} class="group/cv flex flex-col items-center gap-1">
                <img src={`/assets/covers/${t.id}.jpg`} alt={t.id.toUpperCase()}
                     class="w-9 h-12 object-cover rounded border border-border-mid group-hover/cv:border-gta-gold/40 transition-colors" loading="lazy" />
                <span class="text-[9px] font-mono text-zinc-700 group-hover/cv:text-zinc-500 transition-colors">{t.year}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Shared backdrop — dims page content behind open panel -->
      <div id="nav-panel-backdrop"
           class="hidden fixed inset-0 z-[48]"
           style="top:64px;background:rgba(0,0,0,0.55)"></div>
    </header>

    <!-- Main content area with background grid -->
    <main class="flex-1 bg-grid">
      <slot />
    </main>

    <!-- Related Intelligence cross-link strip (omitted on admin/legal pages) -->
    {crossLinksContext && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4 pb-12">
        <CrossLinks context={crossLinksContext} />
      </div>
    )}

    <!-- Footer -->
    <footer class="border-t border-border-dim mt-24" style="background:var(--c-bg-deep)">

      <!-- Bottom bar -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <!-- Wordmark -->
          <div class="font-mono font-bold text-xl leading-none tracking-tight flex items-center gap-1">
            <span class="text-white mr-1">GTA</span><span class="text-gta-gold">VI</span>
            <span class="text-sm font-mono font-bold text-white border-2 border-zinc-200/70 rounded pl-0.5 pr-1.5 py-0.5 tracking-widest leading-none">.AI</span>
          </div>
          <!-- Legal links — centre -->
          <div class="flex items-center gap-4">
            <a href="/terms"       class="text-[10px] font-mono text-zinc-600 hover:text-zinc-400 transition-colors uppercase tracking-widest">Terms</a>
            <a href="/privacy"     class="text-[10px] font-mono text-zinc-600 hover:text-zinc-400 transition-colors uppercase tracking-widest">Privacy</a>
            <a href="/methodology" class="text-[10px] font-mono text-zinc-600 hover:text-zinc-400 transition-colors uppercase tracking-widest">Scoring</a>
          </div>
          <!-- Data note — right -->
          <div class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-gta-teal"></span>
            <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-widest">Data refreshed nightly</span>
          </div>
        </div>
      </div>

    </footer>

    <!-- ═══════════════════════════════════════════════════════
         MOBILE NAV — Full-screen app launcher (phone grid model)
         Top level: 2-col tile grid — all sections visible at once
         Section tile (with sub-pages): tapping shows sub-list + back
         Direct link tiles: navigate immediately
    ═══════════════════════════════════════════════════════ -->
    <div id="mobile-nav" class="fixed inset-0 z-[100] hidden flex-col" role="dialog" aria-label="Navigation menu"
         style="background:rgba(10,10,13,0.98);backdrop-filter:blur(20px)">

      <!-- Mobile nav header bar -->
      <div class="flex items-center justify-between px-4 h-16 border-b border-border-dim shrink-0">
        <a href="/" class="font-mono font-bold text-xl leading-none flex items-center gap-1">
          <span class="text-white mr-1">GTA</span><span class="text-gta-gold">VI</span>
          <span class="text-sm font-mono font-bold text-white border-2 border-zinc-200/70 rounded pl-0.5 pr-1.5 py-0.5 tracking-widest leading-none">.AI</span>
        </a>
        <button id="mobile-nav-close" class="text-zinc-500 hover:text-zinc-200 p-2 rounded-lg hover:bg-white/5 transition-all" aria-label="Close menu">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Main grid view — all sections at once -->
      <div id="mobile-grid" class="flex-1 overflow-y-auto p-4">
        <div class="grid grid-cols-2 gap-3">
          {navGroups.map(group => {
            // Groups with dropdown → sub-panel button (all sub-pages accessible in one step)
            // Groups without dropdown → direct link tile
            if (group.dropdown) {
              // Determine the sub-labels to preview in the tile
              const firstDropHref = group.dropdown[0]?.href;
              const hasHub = firstDropHref === group.href;
              // hasHub: first item IS the hub → show sub-items from slice(1)
              // no-hub: all items are sub-pages → show all
              const previewLabels = hasHub
                ? group.dropdown.slice(1).map(d => d.label)
                : group.dropdown.map(d => d.label);

              return (
                <button
                  data-mobile-section={group.label}
                  class="flex flex-col gap-2 p-4 rounded-xl border border-border-dim hover:border-border-mid hover:bg-white/[0.02] transition-all active:bg-white/5 text-left w-full"
                  style="background:var(--c-card)">
                  <div class="flex items-center justify-between">
                    <span class="font-semibold text-zinc-200 text-sm">{group.label}</span>
                    <span class="text-zinc-600 text-xs">›</span>
                  </div>
                  <span class="w-8 h-0.5 rounded-full" style={`background:${group.identityColor};opacity:0.6`}></span>
                  <span class="text-[10px] font-mono text-zinc-600 leading-snug line-clamp-2">
                    {previewLabels.join(" · ")}
                  </span>
                </button>
              );
            }

            // Direct-link tile (no dropdown)
            return (
              <a href={group.href}
                 class="flex flex-col gap-2 p-4 rounded-xl border border-border-dim hover:border-border-mid hover:bg-white/[0.02] transition-all active:bg-white/5"
                 style="background:var(--c-card)">
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-zinc-200 text-sm">{group.label}</span>
                  <span class="text-zinc-600 text-xs">→</span>
                </div>
                <span class="w-8 h-0.5 rounded-full" style={`background:${group.identityColor};opacity:0.6`}></span>
              </a>
            );
          })}
        </div>

        <!-- Pre-order CTA -->
        <a href="/gta-vi/buy"
           class="flex items-center justify-center gap-2 mt-4 py-3 rounded-xl border border-gta-vi-coral/30 bg-gta-vi-coral/5 text-gta-vi-coral text-sm font-medium hover:bg-gta-vi-coral/10 transition-all">
          Pre-order GTA VI
        </a>

        <!-- Live strip -->
        <div class="flex items-center gap-2 mt-3 px-2">
          <span class="w-1.5 h-1.5 rounded-full bg-gta-teal animate-pulse shrink-0"></span>
          <span class="text-[10px] font-mono text-zinc-600 capitalize">{liveStripText}</span>
        </div>
      </div>

      <!-- Sub-section views (one per section with dropdown, hidden by default) -->
      {navGroups.filter(g => g.dropdown).map(group => {
        const firstDropHref = group.dropdown![0]?.href;
        const hasHub = firstDropHref === group.href;
        return (
          <div id={`mobile-sub-${group.label}`} class="mobile-sub hidden flex-col flex-1 overflow-y-auto">
            <!-- Sub-header with back button -->
            <div class="flex items-center gap-3 px-4 py-3 border-b border-border-dim shrink-0">
              <button data-mobile-back class="flex items-center gap-1.5 text-zinc-500 hover:text-zinc-200 transition-colors text-sm">
                <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13L5 8l5-5"/>
                </svg>
                All
              </button>
              <span class="text-sm font-semibold text-zinc-200">{group.label}</span>
              <span class="ml-auto w-6 h-0.5 rounded-full" style={`background:${group.identityColor};opacity:0.7`}></span>
            </div>
            <!-- Sub-destination list — flat, one tap each -->
            <div class="flex-1 p-4 flex flex-col gap-3">
              {group.dropdown?.map((item, i) => {
                const isHubLink = hasHub && i === 0;
                return (
                  <a href={item.href}
                     class={`group/ms flex items-start gap-4 p-4 rounded-xl border hover:bg-white/[0.02] transition-all ${isHubLink ? "border-opacity-40" : "border-border-dim hover:border-border-mid"}`}
                     style={isHubLink
                       ? `background:var(--c-card);border-color:color-mix(in srgb,${group.identityColor} 30%,transparent)`
                       : "background:var(--c-card)"}>
                    <HudIcon name={item.iconName as any} size={20} class={`transition-colors mt-0.5 shrink-0 ${isHubLink ? "text-zinc-400 group-hover/ms:text-zinc-200" : "text-zinc-500 group-hover/ms:text-zinc-300"}`} />
                    <div>
                      <div class={`text-sm font-semibold group-hover/ms:text-white transition-colors mb-0.5 ${isHubLink ? "text-zinc-200" : "text-zinc-200"}`}>
                        {item.label}
                        {isHubLink && <span class="text-[10px] font-mono text-zinc-600 ml-2 normal-case tracking-normal">Hub overview</span>}
                      </div>
                      <div class="text-[11px] font-mono text-zinc-600 leading-snug">{item.sub}</div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>

    <script>
      // ── Desktop mega-panel logic ─────────────────────────────────────────────
      const backdrop    = document.getElementById("nav-panel-backdrop");
      const allPanels   = document.querySelectorAll<HTMLElement>(".nav-mega-panel");
      const allTriggers = document.querySelectorAll<HTMLButtonElement>("[data-nav-trigger]");
      let   openPanel: HTMLElement | null = null;

      function closeAllPanels() {
        allPanels.forEach(p => p.classList.add("hidden"));
        backdrop?.classList.add("hidden");
        allTriggers.forEach(t => {
          t.setAttribute("aria-expanded", "false");
          const chevron = t.querySelector<HTMLElement>(".nav-chevron");
          if (chevron) chevron.style.transform = "";
        });
        openPanel = null;
        document.body.style.overflow = "";
      }

      allTriggers.forEach(trigger => {
        trigger.addEventListener("click", (e) => {
          e.stopPropagation();
          const label  = trigger.dataset.navTrigger!;
          const panel  = document.getElementById(`nav-panel-${label}`);
          if (!panel) return;

          if (openPanel === panel) {
            closeAllPanels();
            return;
          }
          closeAllPanels();
          panel.classList.remove("hidden");
          backdrop?.classList.remove("hidden");
          trigger.setAttribute("aria-expanded", "true");
          const chevron = trigger.querySelector<HTMLElement>(".nav-chevron");
          if (chevron) chevron.style.transform = "rotate(180deg)";
          openPanel = panel;
        });
      });

      backdrop?.addEventListener("click", closeAllPanels);

      // Close on Escape
      document.addEventListener("keydown", e => { if (e.key === "Escape") closeAllPanels(); });

      // ── Mobile nav logic ─────────────────────────────────────────────────────
      const mobileNav   = document.getElementById("mobile-nav");
      const mobileGrid  = document.getElementById("mobile-grid");
      const openBtn     = document.getElementById("mobile-nav-open");
      const closeBtn    = document.getElementById("mobile-nav-close");

      function openMobileNav() {
        mobileNav?.classList.remove("hidden");
        mobileNav?.classList.add("flex");
        document.body.style.overflow = "hidden";
        // Always start at top-level grid
        showMobileGrid();
      }
      function closeMobileNav() {
        mobileNav?.classList.add("hidden");
        mobileNav?.classList.remove("flex");
        document.body.style.overflow = "";
      }
      function showMobileGrid() {
        mobileGrid?.classList.remove("hidden");
        document.querySelectorAll<HTMLElement>(".mobile-sub").forEach(s => {
          s.classList.add("hidden");
          s.classList.remove("flex");
        });
      }
      function showMobileSub(label: string) {
        mobileGrid?.classList.add("hidden");
        const sub = document.getElementById(`mobile-sub-${label}`);
        if (sub) { sub.classList.remove("hidden"); sub.classList.add("flex"); }
      }

      openBtn?.addEventListener("click", openMobileNav);
      closeBtn?.addEventListener("click", closeMobileNav);

      // Section tile buttons → show sub-list
      document.querySelectorAll<HTMLButtonElement>("[data-mobile-section]").forEach(btn => {
        btn.addEventListener("click", () => showMobileSub(btn.dataset.mobileSection!));
      });

      // Back buttons → return to grid
      document.querySelectorAll<HTMLButtonElement>("[data-mobile-back]").forEach(btn => {
        btn.addEventListener("click", showMobileGrid);
      });
    </script>

  </body>
</html>
